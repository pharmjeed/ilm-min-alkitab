{"schema":1,"kind":"sunan-chunk","version":"sunan-d4559cab67b4","needId":52,"stateIds":[546,547,548,549,550,551,552,553,554,555,556,557,558,559,560,561,562,563,564,565,566,567],"items":[{"id":"ق-0082","fp":"892162fc11a5","stateId":546,"easy":"الردة والموت على الكفر ← حبوط العمل في الدنيا والآخرة والخلود في النار","cause":"الردة والموت على الكفر","result":"حبوط العمل في الدنيا والآخرة والخلود في النار","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة البقرة: 217","srcLabel":"القرآن الكريم","quran":{"s":2,"from":217,"to":217,"text":"يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ قُلْ قِتَالٌ فِيهِ كَبِيرٌ وَصَدٌّ عَنْ سَبِيلِ اللَّهِ وَكُفْرٌ بِهِ وَالْمَسْجِدِ الْحَرَامِ وَإِخْرَاجُ أَهْلِهِ مِنْهُ أَكْبَرُ عِنْدَ اللَّهِ وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ وَلَا يَزَالُونَ يُقَاتِلُونَكُمْ حَتَّى يَرُدُّوكُمْ عَنْ دِينِكُمْ إِنِ اسْتَطَاعُوا وَمَنْ يَرْتَدِدْ مِنْكُمْ عَنْ دِينِهِ فَيَمُتْ وَهُوَ كَافِرٌ فَأُولَئِكَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (217)","hl":[[326,506,1]]}},{"id":"ق-0140","fp":"b2b8bdd06fce","stateId":546,"easy":"ابتغاء دين غير الإسلام ← لا يُقبل منه والخسران في الآخرة","cause":"ابتغاء دين غير الإسلام","result":"لا يُقبل منه والخسران في الآخرة","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة آل عمران: 85","srcLabel":"القرآن الكريم","quran":{"s":3,"from":85,"to":85,"text":"وَمَنْ يَبْتَغِ غَيْرَ الْإِسْلَامِ دِينًا فَلَنْ يُقْبَلَ مِنْهُ وَهُوَ فِي الْآخِرَةِ مِنَ الْخَاسِرِينَ (85)","hl":[[0,106,1]]}},{"id":"ق-0157","fp":"5f7fea9a5991","stateId":546,"easy":"الإنفاق مع الكفر وظلم النفس ← ذهاب النفقة كزرع أهلكته ريح فيها صِرّ","cause":"الإنفاق مع الكفر وظلم النفس","result":"ذهاب النفقة كزرع أهلكته ريح فيها صِرّ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"star":true,"ref":"سورة آل عمران: 117","srcLabel":"القرآن الكريم","quran":{"s":3,"from":117,"to":117,"text":"مَثَلُ مَا يُنْفِقُونَ فِي هَذِهِ الْحَيَاةِ الدُّنْيَا كَمَثَلِ رِيحٍ فِيهَا صِرٌّ أَصَابَتْ حَرْثَ قَوْمٍ ظَلَمُوا أَنْفُسَهُمْ فَأَهْلَكَتْهُ وَمَا ظَلَمَهُمُ اللَّهُ وَلَكِنْ أَنْفُسَهُمْ يَظْلِمُونَ (117)","hl":[[0,203,1]]}},{"id":"ق-0283","fp":"c4417a78192d","stateId":546,"easy":"الكفر بالإيمان ← حبوط العمل والخسران في الآخرة","cause":"الكفر بالإيمان","result":"حبوط العمل والخسران في الآخرة","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة المائدة: 5","srcLabel":"القرآن الكريم","quran":{"s":5,"from":5,"to":5,"text":"الْيَوْمَ أُحِلَّ لَكُمُ الطَّيِّبَاتُ وَطَعَامُ الَّذِينَ أُوتُوا الْكِتَابَ حِلٌّ لَكُمْ وَطَعَامُكُمْ حِلٌّ لَهُمْ وَالْمُحْصَنَاتُ مِنَ الْمُؤْمِنَاتِ وَالْمُحْصَنَاتُ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ إِذَا آتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ غَيْرَ مُسَافِحِينَ وَلَا مُتَّخِذِي أَخْدَانٍ وَمَنْ يَكْفُرْ بِالْإِيمَانِ فَقَدْ حَبِطَ عَمَلُهُ وَهُوَ فِي الْآخِرَةِ مِنَ الْخَاسِرِينَ (5)","hl":[[316,409,1]]}},{"id":"ق-0314","fp":"ff1eb081e39b","stateId":546,"easy":"النفاق ← حبوط الأعمال والخسران","cause":"النفاق","result":"حبوط الأعمال والخسران","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة المائدة: 53","srcLabel":"القرآن الكريم","quran":{"s":5,"from":53,"to":53,"text":"وَيَقُولُ الَّذِينَ آمَنُوا أَهَؤُلَاءِ الَّذِينَ أَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ إِنَّهُمْ لَمَعَكُمْ حَبِطَتْ أَعْمَالُهُمْ فَأَصْبَحُوا خَاسِرِينَ (53)","hl":[[113,159,1]]}},{"id":"ق-0363","fp":"28b2deba123b","stateId":546,"easy":"الشرك بالله ← حبوط العمل","cause":"الشرك بالله","result":"حبوط العمل","explicit":true,"similar":["ق-0487","ق-1099"],"ref":"سورة الأنعام: 88","srcLabel":"القرآن الكريم","quran":{"s":6,"from":88,"to":88,"text":"ذَلِكَ هُدَى اللَّهِ يَهْدِي بِهِ مَنْ يَشَاءُ مِنْ عِبَادِهِ وَلَوْ أَشْرَكُوا لَحَبِطَ عَنْهُمْ مَا كَانُوا يَعْمَلُونَ (88)","hl":[[62,121,1]]}},{"id":"ق-0427","fp":"948f116a9efc","stateId":546,"easy":"التكذيب بالآيات ولقاء الآخرة ← حبوط الأعمال","cause":"التكذيب بالآيات ولقاء الآخرة","result":"حبوط الأعمال","explicit":true,"ref":"سورة الأعراف: 147","srcLabel":"القرآن الكريم","quran":{"s":7,"from":147,"to":147,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا وَلِقَاءِ الْآخِرَةِ حَبِطَتْ أَعْمَالُهُمْ هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا يَعْمَلُونَ (147)","hl":[[0,124,1]]}},{"id":"ق-0487","fp":"10307f4ba483","stateId":546,"easy":"الشرك بالله ← حبوط الأعمال والخلود في النار","cause":"الشرك بالله","result":"حبوط الأعمال والخلود في النار","explicit":true,"repOf":"ق-0363","otherNeedIds":[69],"ref":"سورة التوبة: 17","quran":{"s":9,"from":17,"to":17,"text":"مَا كَانَ لِلْمُشْرِكِينَ أَنْ يَعْمُرُوا مَسَاجِدَ اللَّهِ شَاهِدِينَ عَلَى أَنْفُسِهِمْ بِالْكُفْرِ أُولَئِكَ حَبِطَتْ أَعْمَالُهُمْ وَفِي النَّارِ هُمْ خَالِدُونَ (17)","hl":[[102,165,1]]}},{"id":"ق-0503","fp":"df042806e8e5","stateId":546,"easy":"الفسق والكفر والكسل في الصلاة والإنفاق كرهاً ← عدم قبول النفقات","cause":"الفسق والكفر والكسل في الصلاة والإنفاق كرهاً","result":"عدم قبول النفقات","explicit":true,"ref":"سورة التوبة: 53–54","srcLabel":"القرآن الكريم","quran":{"s":9,"from":53,"to":54,"text":"قُلْ أَنْفِقُوا طَوْعًا أَوْ كَرْهًا لَنْ يُتَقَبَّلَ مِنْكُمْ إِنَّكُمْ كُنْتُمْ قَوْمًا فَاسِقِينَ (53) وَمَا مَنَعَهُمْ أَنْ تُقْبَلَ مِنْهُمْ نَفَقَاتُهُمْ إِلَّا أَنَّهُمْ كَفَرُوا بِاللَّهِ وَبِرَسُولِهِ وَلَا يَأْتُونَ الصَّلَاةَ إِلَّا وَهُمْ كُسَالَى وَلَا يُنْفِقُونَ إِلَّا وَهُمْ كَارِهُونَ (54)","hl":[[0,302,1]]}},{"id":"ق-0511","fp":"55d6ca01e6fb","stateId":546,"easy":"الاستمتاع بالخلاق والخوض في الباطل ← حبوط الأعمال في الدنيا والآخرة والخسران","cause":"الاستمتاع بالخلاق والخوض في الباطل","result":"حبوط الأعمال في الدنيا والآخرة والخسران","explicit":true,"otherNeedIds":[57],"ref":"سورة التوبة: 69","srcLabel":"القرآن الكريم","quran":{"s":9,"from":69,"to":69,"text":"كَالَّذِينَ مِنْ قَبْلِكُمْ كَانُوا أَشَدَّ مِنْكُمْ قُوَّةً وَأَكْثَرَ أَمْوَالًا وَأَوْلَادًا فَاسْتَمْتَعُوا بِخَلَاقِهِمْ فَاسْتَمْتَعْتُمْ بِخَلَاقِكُمْ كَمَا اسْتَمْتَعَ الَّذِينَ مِنْ قَبْلِكُمْ بِخَلَاقِهِمْ وَخُضْتُمْ كَالَّذِي خَاضُوا أُولَئِكَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَأُولَئِكَ هُمُ الْخَاسِرُونَ (69)","hl":[[126,336,1]]}},{"id":"ق-0642","fp":"8019a3bce23a","stateId":546,"easy":"الكفر ← ضياع الأعمال كرماد اشتدت به الريح","cause":"الكفر","result":"ضياع الأعمال كرماد اشتدت به الريح","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"سورة إبراهيم: 18","srcLabel":"القرآن الكريم","quran":{"s":14,"from":18,"to":18,"text":"مَثَلُ الَّذِينَ كَفَرُوا بِرَبِّهِمْ أَعْمَالُهُمْ كَرَمَادٍ اشْتَدَّتْ بِهِ الرِّيحُ فِي يَوْمٍ عَاصِفٍ لَا يَقْدِرُونَ مِمَّا كَسَبُوا عَلَى شَيْءٍ ذَلِكَ هُوَ الضَّلَالُ الْبَعِيدُ (18)","hl":[[0,184,1]]}},{"id":"ق-0741","fp":"264ebccaf9df","stateId":546,"easy":"ضلال السعي مع حسبان الإحسان والكفر بآيات الله ولقائه ← الأخسرون أعمالاً: حبوط العمل ولا وزن وجهنم","cause":"ضلال السعي مع حسبان الإحسان والكفر بآيات الله ولقائه","result":"الأخسرون أعمالاً: حبوط العمل ولا وزن وجهنم","explicit":true,"otherNeedIds":[69,57],"ref":"سورة الكهف: 103–106","srcLabel":"القرآن الكريم","quran":{"s":18,"from":103,"to":106,"text":"قُلْ هَلْ نُنَبِّئُكُمْ بِالْأَخْسَرِينَ أَعْمَالًا (103) الَّذِينَ ضَلَّ سَعْيُهُمْ فِي الْحَيَاةِ الدُّنْيَا وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا (104) أُولَئِكَ الَّذِينَ كَفَرُوا بِآيَاتِ رَبِّهِمْ وَلِقَائِهِ فَحَبِطَتْ أَعْمَالُهُمْ فَلَا نُقِيمُ لَهُمْ يَوْمَ الْقِيَامَةِ وَزْنًا (105) ذَلِكَ جَزَاؤُهُمْ جَهَنَّمُ بِمَا كَفَرُوا وَاتَّخَذُوا آيَاتِي وَرُسُلِي هُزُوًا (106)","hl":[[0,388,1]]}},{"id":"ق-0861","fp":"d9855bbf3cf1","stateId":546,"easy":"الكفر ← أعمالهم كسراب لا يجدونه شيئاً","cause":"الكفر","result":"أعمالهم كسراب لا يجدونه شيئاً","explicit":true,"ref":"سورة النور: 39","srcLabel":"القرآن الكريم","quran":{"s":24,"from":39,"to":39,"text":"وَالَّذِينَ كَفَرُوا أَعْمَالُهُمْ كَسَرَابٍ بِقِيعَةٍ يَحْسَبُهُ الظَّمْآنُ مَاءً حَتَّى إِذَا جَاءَهُ لَمْ يَجِدْهُ شَيْئًا وَوَجَدَ اللَّهَ عِنْدَهُ فَوَفَّاهُ حِسَابَهُ وَاللَّهُ سَرِيعُ الْحِسَابِ (39)","hl":[[0,201,1]]}},{"id":"ق-0875","fp":"fc54a82938a4","stateId":546,"easy":"الكفر ← جعل أعمالهم هباءً منثوراً","cause":"الكفر","result":"جعل أعمالهم هباءً منثوراً","explicit":true,"ref":"سورة الفرقان: 23","srcLabel":"القرآن الكريم","quran":{"s":25,"from":23,"to":23,"text":"وَقَدِمْنَا إِلَى مَا عَمِلُوا مِنْ عَمَلٍ فَجَعَلْنَاهُ هَبَاءً مَنْثُورًا (23)","hl":[[0,75,1]]}},{"id":"ق-0986","fp":"f00f4b8a3ed0","stateId":546,"easy":"النفاق والشحّ والتعويق ← إحباط الأعمال","cause":"النفاق والشحّ والتعويق","result":"إحباط الأعمال","explicit":true,"ref":"سورة الأحزاب: 19","srcLabel":"القرآن الكريم","quran":{"s":33,"from":19,"to":19,"text":"أَشِحَّةً عَلَيْكُمْ فَإِذَا جَاءَ الْخَوْفُ رَأَيْتَهُمْ يَنْظُرُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَالَّذِي يُغْشَى عَلَيْهِ مِنَ الْمَوْتِ فَإِذَا ذَهَبَ الْخَوْفُ سَلَقُوكُمْ بِأَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى الْخَيْرِ أُولَئِكَ لَمْ يُؤْمِنُوا فَأَحْبَطَ اللَّهُ أَعْمَالَهُمْ وَكَانَ ذَلِكَ عَلَى اللَّهِ يَسِيرًا (19)","hl":[[226,284,1]]}},{"id":"ق-1099","fp":"b7b6c53751af","stateId":546,"easy":"الشرك بالله ← حبوط العمل والخسران","cause":"الشرك بالله","result":"حبوط العمل والخسران","explicit":true,"repOf":"ق-0363","otherNeedIds":[57],"ref":"سورة الزمر: 65","quran":{"s":39,"from":65,"to":65,"text":"وَلَقَدْ أُوحِيَ إِلَيْكَ وَإِلَى الَّذِينَ مِنْ قَبْلِكَ لَئِنْ أَشْرَكْتَ لَيَحْبَطَنَّ عَمَلُكَ وَلَتَكُونَنَّ مِنَ الْخَاسِرِينَ (65)","hl":[[58,132,1]]}},{"id":"ق-1204","fp":"857f08351b8e","stateId":546,"easy":"الكفر والصد عن سبيل الله ← إضلال الأعمال","cause":"الكفر والصد عن سبيل الله","result":"إضلال الأعمال","explicit":true,"ref":"سورة محمد: 1","srcLabel":"القرآن الكريم","quran":{"s":47,"from":1,"to":1,"text":"الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ أَضَلَّ أَعْمَالَهُمْ (1)","hl":[[0,71,1]]}},{"id":"ق-1208","fp":"24baf677e210","stateId":546,"easy":"الكفر وكراهة ما أنزل الله ← التعس وإضلال الأعمال وإحباطها","cause":"الكفر وكراهة ما أنزل الله","result":"التعس وإضلال الأعمال وإحباطها","explicit":true,"otherNeedIds":[57],"ref":"سورة محمد: 8–9","srcLabel":"القرآن الكريم","quran":{"s":47,"from":8,"to":9,"text":"وَالَّذِينَ كَفَرُوا فَتَعْسًا لَهُمْ وَأَضَلَّ أَعْمَالَهُمْ (8) ذَلِكَ بِأَنَّهُمْ كَرِهُوا مَا أَنْزَلَ اللَّهُ فَأَحْبَطَ أَعْمَالَهُمْ (9)","hl":[[0,61,1]]}},{"id":"ق-1222","fp":"5b3fff8747c2","stateId":546,"easy":"الكفر والصد عن سبيل الله ومشاقّة الرسول ← لا يضرون الله شيئاً وإحباط أعمالهم","cause":"الكفر والصد عن سبيل الله ومشاقّة الرسول","result":"لا يضرون الله شيئاً وإحباط أعمالهم","explicit":true,"ref":"سورة محمد: 32","srcLabel":"القرآن الكريم","quran":{"s":47,"from":32,"to":32,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ وَشَاقُّوا الرَّسُولَ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْهُدَى لَنْ يَضُرُّوا اللَّهَ شَيْئًا وَسَيُحْبِطُ أَعْمَالَهُمْ (32)","hl":[[0,177,1]]}},{"id":"س-03184","fp":"a24d9851f08b","stateId":546,"easy":"إذا أشركت بعد إسلامك ← لا يقبل الله منك عملاً حتى تفارق المشركين","cause":"حتَّى يُفارِقَ المُشرِكينَ","result":"لا يقبَلُ اللهُ ممَّن أشرَك بعدَما أسلَم عمَلًا","explicit":true,"similar":["س-02388"],"otherNeedIds":[22],"ref":"الاستيعاب في معرفة الأصحاب 1/420","srcLabel":"ابن عبدالبر","text":["أتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وآلِه وسلَّم، فقُلْتُ: يا رسولَ اللهِ، ما أتَيْتُكَ حتَّى حلَفْتُ أكثَرَ مِن عددِ الأناملِ - وطبَّق بَيْنَ كفَّيْهِ إحداهما على الأخرى - ألَّا آتِيَكَ، ولا آتِيَ دِينَكَ؛ فقد أتَيْتُكَ امرأً لا أعقِلُ شيئًا إلَّا ما علَّمني اللهُ، وإنِّي أسأَلُكَ بوجهِ اللهِ العظيمِ: بِمَ بعَثكَ ربُّنا إلينا؟ قال: بدِينِ الإسلامِ، قال: وما دِينُ الإسلامِ؟ قال: أن تقولَ: أسلَمْتُ وجهيَ للهِ وتخلَّيْتُ، وتُقِيمَ الصَّلاةَ، وتُؤتِيَ الزَّكاةَ، وكلُّ مُسلِمٍ على كلِّ مُسلِمٍ مُحرَّمٌ، أخوَانِ نَصيرانِ، ",["لا يقبَلُ اللهُ ممَّن أشرَك بعدَما أسلَم عمَلًا",2]," ",["حتَّى يُفارِقَ المُشرِكينَ",1],"، ما لي أُمسِكُ بحُجَزِكم عنِ النَّارِ، ألَا وإنَّ ربِّي داعيَّ، وإنَّه سائلي: هل بلَّغْتَ عبادي؟ فأقولُ: ربِّ، قد بلَّغْتُ، ألَا فلْيُبلِّغْ شاهدُكم غائبَكم، ألَا ثُمَّ إنَّكم تُدْعَوْنَ مُفدَّمةً أفواهُكم بالفِدَامِ، ثمَّ إنَّ أوَّلَ شيءٍ يُنبِئُ عن أحدِكم لَفخِذُه وكفُّه، قال: قُلْتُ: يا رسولَ اللهِ، هذا دِينُنا؟ قال: هذا دِينُكَ، وأينما تُحسِنْ يَكْفِكَ!"],"grade":"صحيح","narrator":"معاوية بن حيدة القشيري","muhaddith":"صحيح","takhrij":"أخرجه ابن عبدالبر في ((الاستيعاب)) (1/364)","bab":"إيمان › دعوة الكافر إلى الإسلام","dorar":"250sJPET","merged":3,"otherRefs":["المستدرك على الصحيحين 8999 (صحيح)","صحيح الجامع 7748 (حسن)"]},{"id":"س-03449","fp":"14e32c44a0c3","stateId":546,"easy":"إذا لم تقل «رب اغفر لي خطيئتي يوم الدين» ← لا ينفعك ما عملت","cause":"إنَّهُ لم يَقُلْ: رَبِّ اغفِرْ لي خَطيئَتي يَومَ الدِّينِ","result":"فهل ذلك نافِعُهُ؟ قال: لا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02446","س-01834"],"otherNeedIds":[22],"ref":"تخريج مشكل الآثار 4358","srcLabel":"مسلم","text":["مِثلَهُ، غَيرَ أنَّهُ لم يَقُلْ فيه: يا عائشةُ. وقال فيه زيادةً على ما في حَديثِ أبي أُمَيَّةَ: ويَفُكُّ العانيَ. [يَعْني حَديثَ: قُلتُ: يا رسولَ اللهِ، إنَّ ابنَ جُدعانَ في الجاهليَّةِ كان يَصِلُ الرَّحِمَ ويُطعِمُ المِسكينَ، ",["فهل ذلك نافِعُهُ؟ قال: لا",2]," يا عائشةُ، ",["إنَّهُ لم يَقُلْ: رَبِّ اغفِرْ لي خَطيئَتي يَومَ الدِّينِ",1],"]."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (4358) بلفظه، وأخرجه مسلم (214)، وأحمد (24621) كلاهما بلفظه دون قوله: ((ويفك العاني))","bab":"استغفار › فضل الاستغفار","dorar":"HS2m4hXp","merged":2,"otherRefs":["تخريج المسند لشعيب 24892 (صحيح)"]},{"id":"س-02446","fp":"eb8c63317b7d","stateId":546,"easy":"إذا لم تقل «رب اغفر لي خطيئتي يوم الدين» ← لا ينفعك عملك","cause":"لم يقُلْ يومًا: ربِّ اغفِرْ لي خطيئتي يومَ الدِّينَ","result":"لا ينفَعُه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03449","ref":"تخريج صحيح ابن حبان 331","text":["أنَّها سأَلَته عن قولِه: {يَوْمَ تُبَدَّلُ الْأَرْضُ غَيْرَ الْأَرْضِ وَالسَّمَوَاتُ} [إبراهيم: 48] {وَبَرَزُوا لِلَّهِ الْوَاحِدِ الْقَهَّارِ} [إبراهيم: 48] فأينَ يكونُ النَّاسُ يومَئذٍ ؟ فقال: ( على الصِّراطِ ) قالت: قُلْتُ: يا رسولَ اللهِ، ابنُ جُدْعانَ كان في الجاهليَّةِ يصِلُ الرَّحِمَ ويُطعِمُ المسكينَ فهل ذاك نافِعُه ؟ قال: ( ",["لا ينفَعُه",2]," ",["لم يقُلْ يومًا: ربِّ اغفِرْ لي خطيئتي يومَ الدِّينَ",1]," )"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (331)، ومسلم (214)، وأحمد في (24621) واللفظ لهم جميعا.","bab":"إسلام › فضل الشهادتين","dorar":"KZmztBw2"},{"id":"س-02602","fp":"2295252cb57e","stateId":546,"easy":"إذا مت على الكفر ← لا ينفعك ما فعلت من خير","cause":"كانت في الجاهليَّةِ تَقْري الضَّيفَ، وتَصِلُ الرَّحِمَ","result":"هل يَنفَعُها؟ قال: لا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[22],"ref":"تخريج مشكل الآثار 11/ 154","srcLabel":"مسلم","text":["ذهَبتُ أنا وأَخي إلى رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ، قُلتُ: يا رسولَ اللهِ، إنَّ أُمَّنا ",["كانت في الجاهليَّةِ تَقْري الضَّيفَ، وتَصِلُ الرَّحِمَ",1],"، ",["هل يَنفَعُها؟ قال: لا",2],". قال: فإنَّها وَأدَتْ أُختًا لها -لَفظُ النَّسائيِّ، ولَفظُ أحمَدَ والطَّبرانيِّ: أُختًا لنا- في الجاهليَّةِ لم تَبلُغِ الحِنثَ. فقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: المَوْؤودةُ والوائِدةُ في النَّارِ، إلَّا أنْ تُدرِكَ الوائِدةُ الإِسلامَ."],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"إسناده على شرط مسلم إلا أن\nداود بن أبي هند ق الذيه أبو داود: خولف في غير حديث، وقال أحمد كما في\n\"العلل\" 1/ 125: يختلف عنه، ووصفه الحافظ في \"التقريب\" بأنه كان يهم بأخرة.","takhrij":"أخرجه أحمد (15923) والنسائي في ((السنن الكبرى)) (11585) والطبراني (7/ 39) (6319) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"xrX5YXra"},{"id":"س-05463","fp":"70c86dc5b66a","stateId":546,"easy":"إذا لم تؤمن بالقدر خيره وشره ← لا يقبل الله منك عملك","cause":"حتَّى يُؤْمِنَ بالقدَرِ خيرِهِ وشرِّهِ ويعلمَ أنَّ ما أصابَهُ / لم يَكُن ليُخْطِئَهُ وما أخطأَهُ لم يَكُن ليُصيبَهُ","result":"لا يقبلُهُ اللَّهُ عزَّ وجلَّ منهُ","explicit":true,"similar":["س-07662","س-01559"],"ref":"تخريج كتاب السنة 245","srcLabel":"أبو داود","text":["لَو أنَّ اللَّهَ تعالى عذَّبَ أَهْلَ سماواتِهِ وأرَضيهِ لعذَّبَهُم وَهوَ غيرُ ظالمٍ لَهُم ، ولَو رحمَهُم كانت رحمتُهُ خيرًا لَهُم من أعمالِهِم ولَو كانَ لرجلٍ أُحُدٌ أو مثلُ أحدٍ ذَهَبًا ينفقُهُ في سبيلِ اللَّهِ ",["لا يقبلُهُ اللَّهُ عزَّ وجلَّ منهُ",2]," ",["حتَّى يُؤْمِنَ بالقدَرِ خيرِهِ وشرِّهِ ويعلمَ أنَّ ما أصابَهُ / لم يَكُن ليُخْطِئَهُ وما أخطأَهُ لم يَكُن ليُصيبَهُ",1]," وأنَّكَ إن مِتَّ علَى غيرِ هذا أُدخِلتَ النَّارَ"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4699)، والطبراني (5/ 160) (4940)، والبيهقي (20913) جميعا مطولا وفي أوله قصة.","bab":"رقائق وزهد › الخوف من الله","dorar":"wuGOgmQC"},{"id":"س-07662","fp":"f33722d4ad04","stateId":546,"easy":"إذا لم تؤمن بالقدر ← لو أنفقت مثل أحد ذهباً ما قبله الله منك","cause":"حتَّى يُؤمِنَ بالقدَرِ","result":"لو أنَّ لأحَدِهم مِثلَ أُحُدٍ ذَهَبًا فأنفَقَه ما قَبِلَ اللهُ منه","explicit":true,"repOf":"س-05463","otherNeedIds":[22],"ref":"صحيح مسلم 8","text":["كانَ أوَّلَ مَن قال في القَدَرِ بالبَصرةِ مَعبَدٌ الجُهَنيُّ، فانطَلَقتُ أنا وحُمَيدُ بنُ عبدِ الرَّحمَنِ الحِميَريُّ حاجَّينِ أو مُعتَمِرَينِ، فقُلنا: لو لَقينا أحَدًا مَن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فسَألناه عَمَّا يقولُ هؤلاء في القَدَرِ، فوُفِّقَ لنا عبدُ اللهِ بنُ عُمَرَ بنِ الخَطَّابِ داخِلًا المَسجِدَ، فاكتَنَفتُه أنا وصاحِبي أحَدُنا عن يَمينِه، والآخَرُ عن شِمالِه، فظَنَنتُ أنَّ صاحِبي سَيَكِلُ الكَلامَ إلَيَّ، فقُلتُ: أبا عبدِ الرَّحمَنِ إنَّه قد ظَهَرَ قِبَلَنا ناسٌ يَقرَؤونَ القُرآنَ، ويَتَقَفَّرونَ العِلمَ، وذَكَرَ مِن شَأنِهم، وأنَّهم يَزعُمونَ أنْ لا قدَرَ، وأنَّ الأمرَ أُنُفٌ، قال: فإذا لَقيتَ أولَئِك فأخبِرهُم أنِّي بَريءٌ منهم، وأنَّهم بُرَآءُ مِنِّي، والذي يَحلِفُ به عبدُ اللهِ بنُ عُمَرَ ",["لو أنَّ لأحَدِهم مِثلَ أُحُدٍ ذَهَبًا فأنفَقَه ما قَبِلَ اللهُ منه",2]," ",["حتَّى يُؤمِنَ بالقدَرِ",1],"، ثُمَّ قال: حدَّثَني أبي عُمَرُ بنُ الخَطَّابِ، قال: بينَما نَحنُ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يَومٍ إذ طَلَعَ علينا رَجُلٌ شَديدُ بَياضِ الثِّيابِ، شَديدُ سَوادِ الشَّعَرِ، لا يُرى عليه أثَرُ السَّفَرِ، ولا يَعرِفُه مِنَّا أحَدٌ، حتَّى جَلَسَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فأسنَدَ رُكبَتَيه إلى رُكبَتَيه، ووضَعَ كَفَّيه على فخِذَيه. وقال: يا مُحَمَّدُ أخبِرْني عَنِ الإسلامِ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الإسلامُ أن تَشهَدَ أن لا إلَهَ إلَّا اللهُ وأنَّ مُحَمَّدًا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وتُقيمَ الصَّلاةَ، وتُؤتيَ الزَّكاةَ، وتَصومَ رَمَضانَ، وتَحُجَّ البَيتَ إنِ استَطَعتَ إليه سَبيلًا، قال: صَدَقتَ، قال: فعَجِبنا له يَسألُه، ويُصَدِّقُه، قال: فأخبِرْني عَنِ الإيمانِ، قال: أن تُؤمِنَ باللهِ، ومَلائِكَتِه، وكُتُبِه، ورُسُلِه، واليَومِ الآخِرِ، وتُؤمِنَ بالقدَرِ خَيرِه وشَرِّه، قال: صَدَقتَ، قال: فأخبِرْني عَنِ الإحسانِ، قال: أن تَعبُدَ اللهَ كَأنَّك تَراه، فإن لَم تَكُنْ تَراه فإنَّه يَراك، قال: فأخبِرْني عَنِ السَّاعةِ، قال: ما المَسؤولُ عَنها بأعلَمَ مِنَ السَّائِلِ، قال: فأخبِرْني عن أمارَتِها، قال: أن تَلِدَ الأَمَةُ رَبَّتَها، وأن تَرى الحُفاةَ العُراةَ العالةَ رِعاءَ الشَّاءِ يَتَطاولونَ في البُنيانِ، قال: ثُمَّ انطَلَقَ فلَبِثتُ مَليًّا، ثُمَّ قال لي: يا عُمَرُ أتَدري مَنِ السَّائِلُ؟ قُلتُ: اللهُ ورَسولُه أعلَمُ، قال: فإنَّه جِبريلُ أتاكُم يُعَلِّمُكُم دينَكُم."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (4695)،\nوالترمذي (2610)، وابن حبان (168)، باختلاف يسير.","bab":"قدر › التكذيب بالقدر","dorar":"XNeju5uH"},{"id":"س-07656","fp":"8afaebd810d0","stateId":546,"easy":"إذا كنت عاقاً أو منّاناً أو مكذباً بالقدر ← لا يقبل الله منك يوم القيامة صرفاً ولا عدلاً","cause":"عاقٌّ ، و مَنّانٌ ، و مُكَذِّبٌ بِالقَدَرِ","result":"ثلاثةٌ لا يَقبلُ اللهُ مِنهمْ يوم القِيامةِ صرْفًا و لا عَدْلًا","explicit":true,"ref":"صحيح الجامع 3065","srcLabel":"الطبراني","text":[["ثلاثةٌ لا يَقبلُ اللهُ مِنهمْ يوم القِيامةِ صرْفًا و لا عَدْلًا ",2],":",[" عاقٌّ ، و مَنّانٌ ، و مُكَذِّبٌ بِالقَدَرِ",1]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (323)، والطبراني (8/140) (7547)، وابن عساكر في ((تاريخ دمشق)) (41/218) باختلاف يسير.","bab":"قدر › التكذيب بالقدر","dorar":"uJyTKazl","merged":3,"otherRefs":["تخريج كتاب السنة 323 (حسن)","صحيح الترغيب 2513 (حسن)"]},{"id":"س-01830","fp":"eea2ad0d7881","stateId":546,"easy":"إذا آمنت بلا عمل أو عملت بلا إيمان ← لا يُقبل منك","cause":"إيمانٌ بلا عملٍ، و لا عملٌ بلا إيمانٍ","result":"لا يُقبلُ","explicit":true,"otherNeedIds":[51],"ref":"الجامع الصغير 9962","srcLabel":"الطبراني","text":[["لا يُقبلُ",2]," ",["إيمانٌ بلا عملٍ،  و لا عملٌ بلا إيمانٍ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (13/203) (13918)","bab":"إحسان › إبطال الأعمال","dorar":"PpwHzxnL"},{"id":"س-01834","fp":"e2e90c35b1a4","stateId":546,"easy":"إذا لم تقل يوماً «رب اغفر لي خطيئتي يوم الدين» ← لا ينفعك ما عملت","cause":"ولم يقُلْ يومًا قطُّ ربِّ اغفرْ لي خطيئَتي يومَ الدِّينِ","result":"هل ذلك نافعُه قال لا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03449","otherNeedIds":[22],"ref":"السلسلة الصحيحة 6/1030","text":["عن أمِّ سلمةَ قالتْ قلتُ للنبيِّ صلَّى اللهُ عليهِ وسلَّمَ هشامُ بنُ المغيرةَ كان يَصلُ الرَّحِمَ ويَقري الضيفَ ويَفُكُّ العُناةَ ويُطعِمُ الطعامَ ولو أدرك أسلَمَ ",["هل ذلك نافعُه قال لا",2]," إنه كان يُعطي للدنيا وذِكرِها وحمدِها ",["ولم يقُلْ يومًا قطُّ ربِّ اغفرْ لي خطيئَتي يومَ الدِّينِ",1]],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح رجاله رجال الشيخين","bab":"إحسان › إبطال الأعمال","dorar":"GYBXc7mi"},{"id":"س-04990","fp":"f7aba59873c7","stateId":546,"easy":"إذا مات المرء على الكفر ← لا ينفعه ما عمل","cause":"هلَكَت في الجاهليَّةِ","result":"فَهَل ذلِكَ نافعُها شيئًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02432"],"otherNeedIds":[22],"ref":"الصحيح المسند 452","srcLabel":"الصحيح المسند","text":["انطلَقتُ أَنا وأخي إلى رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ ، قالَ: قُلنا: يا رسولَ اللَّهِ ، إنَّ أمَّنا مُلَيْكةَ كانت تَصِلُ الرَّحمَ ، وتَقري الضَّيفَ ، وتَفعلُ ، وتَفعلُ ",["هلَكَت في الجاهليَّةِ",1]," ، ",["فَهَل ذلِكَ نافعُها شيئًا ؟",2]," قالَ: لا قالَ: قُلنا: فإنَّها كانَت وأدت أختًا لَنا في الجاهليَّةِ ، فَهَل ذلِكَ نافعُها شيئًا ؟ قالَ: الوائدةُ والمؤودةُ في النَّارِ ، إلَّا أن تُدْرِكَ الوائدةُ الإسلامَ ، فيَعفوَ اللَّهُ عنها ."],"grade":"صحيح","narrator":"سلمة بن يزيد الأشجعي","muhaddith":"صحيح ، رجاله رجال الصحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"n6mxc2KE"},{"id":"س-05474","fp":"a3b3f16903c2","stateId":546,"easy":"إذا أشركت ← لا ينفع مع الشرك شيء","cause":"الشركِ","result":"لا ينفعُ مع الشركِ شيءٌ","explicit":true,"otherNeedIds":[22],"ref":"تنزيه الشريعة 1/153","srcLabel":"العقيلي","text":["كما ",["لا ينفعُ مع الشركِ شيءٌ",2]," كذلك لا يضرُّ مع الإيمانِ شيءٌ"],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"له شاهد جيد","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/199)، وابن عدي في ((الكامل في الضعفاء)) (2/232) واللفظ لهما، وأبو نعيم في ((معرفة الصحابة)) (871) باختلاف يسير.","bab":"رقائق وزهد › الرجاء مع الخوف","dorar":"VlT5DYuz"},{"id":"س-02432","fp":"0c0610a525f0","stateId":546,"easy":"إذا مات المرء على الكفر ← لا ينفعه ما عمل من خير","cause":"ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ","result":"فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)","واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04990","otherNeedIds":[22],"ref":"التمهيد 18/119","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أنا وأخي فقلنا يا رسولَ اللهِ إنَّ أُمنا ",["ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ",1]," وتفعلُ وتفعلُ ",["فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ",2]," قال لا قال فقلْنا إنَّ أُمنا ولدتْ أختًا لنا في الجاهليةِ لمْ تبلغْ الحنثَ فهلْ ذلكَ نافعُ أختَنا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أرأيتمُ الوائدةَ والموؤدةَ فإنَّهما في النارِ إلا أنْ تُدركَ الوائدةُ الإسلامَ فيغفرُ اللهُ لها"],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"صحيح من جهة الإسناد","takhrij":"أخرجه أحمد (15965)","bab":"إسلام › فضل الشهادتين","dorar":"fEak09qd","merged":2,"otherRefs":["طريق الهجرتين 327 (حسن)"]},{"id":"س-01559","fp":"3aed6555bb45","stateId":546,"easy":"إذا لم تؤمن بالقدر ← لا يُقبل منك ولو أنفقت مثل أحد ذهباً","cause":"لو أنَّ أحَدَهم أنفَق مِثْلَ أُحُدٍ ذَهَبًا ثمَّ لَمْ يُؤمِنْ بالقدَرِ","result":"لَمْ يُقبَلْ منه ثمَّ قال : حدَّثني عُمَرُ بنُ الخطَّابِ رضِي اللهُ عنه قال : بَيْنما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ جالسًا إذ جاء رجُلٌ شديدُ سوادِ اللِّحيةِ شديدُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-05463","ref":"تخريج صحيح ابن حبان 168","text":["خرَجْتُ أنا وحميدُ بنُ عبدِ الرَّحمنِ الحِمْيَرىُّ حاجَّيْنِ أو مُعتمِرَيْنِ وقُلْنا : لعلَّنا لقينا رجُلًا مِن أصحابِ مُحمَّدٍ صلَّى اللهُ عليه وسلَّم فنسأَلَه عنِ القدَرِ فلقِينا ابنَ عُمَرَ فظنَنْتُ أنَّه يكِلُ الكلامَ إليَّ فقُلْنا : يا أبا عبدِ الرَّحمنِ قد ظهَر عندَنا أناسٌ يقرَؤُونَ القُرآنَ يتقَفَّرونَ العِلمَ تقَفُّرًا يزعُمونَ أنْ لا قدَرَ وأنَّ الأمرَ أُنُفٌ قال : فإنْ لقِيتَهم فأعلِمْهم أنِّي منهم بريءٌ وهم منِّي بُرَآءُ والَّذي يحلِفُ به ابنُ عُمَرَ : ",["لو أنَّ أحَدَهم أنفَق مِثْلَ أُحُدٍ ذَهَبًا ثمَّ لَمْ يُؤمِنْ بالقدَرِ ",1],["لَمْ يُقبَلْ منه ثمَّ قال : حدَّثني عُمَرُ بنُ الخطَّابِ رضِي اللهُ عنه قال : بَيْنما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ جالسًا إذ جاء رجُلٌ شديدُ سوادِ اللِّحيةِ شديدُ",2]," بياضِ الثِّيابِ فوضَع رُكبتَه على رُكبةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا مُحمَّدُ ما الإسلامُ ؟ قال : ( شَهادةُ أنْ لا إلهَ إلَّا اللهُ وإقامُ الصَّلاةِ وإيتاءُ الزَّكاةِ وصومُ رمضانَ وحَجُّ البيتِ ) قال : صدَقْتَ قال : فعجِبْنا مِن سؤالِه إيَّاه وتصديقِه إيَّاه قال : فأخبِرْني : ما الإيمانُ ؟ قال : ( أنْ تُؤمِنَ باللهِ وملائكتِه وكُتبِه ورُسلِه والبعثِ بعدَ الموتِ والقدَرِ خيرِه وشرِّه حُلْوِه ومُرِّه ) قال : صدَقْتَ قال : فعجِبْنا مِن سؤالِه إيَّاه وتصديقِه إيَّاه قال : فأخبِرْني : ما الإحسانُ ؟ قال : ( أنْ تعبُدَ اللهَ كأنَّكَ تراه فإنْ لَمْ تكُنْ تراه فإنَّه يراكَ ) قال : فأخبِرْني متى السَّاعةُ ؟ قال : ( ما المسؤولُ بأعلَمَ مِن السَّائلِ ) قال : فما أمارتُها ؟ قال : ( أنْ تلِدَ الأَمَةُ ربَّتَها وأنْ ترى الحُفاةَ العُراةَ رِعاءَ الشَّاءِ يتطاوَلونَ في البُنيانِ ) قال : فتولَّى وذهَب فقال عُمَرُ : فلقِيني النَّبيُّ صلَّى اللهُ عليه وسلَّم بعدَ ثالثةٍ فقال : ( يا عُمَرُ أتدري مَن الرَّجُلُ ؟ ) قُلْتُ : لا قال : ( ذاكَ جِبريلُ أتاكم يُعلِّمُكم دِينَكم )"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرط الشيخين","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"8kn1NnKs"},{"id":"س-02388","fp":"c2db36b382dc","stateId":546,"easy":"إذا أشركت بعد إسلامك ← لا يقبل الله منك عملاً","cause":"أَشرَك بعدَ إسلامِه","result":"لا يَقبلُ اللهُ مِن مُشركٍ أَشرَك بعدَ إسلامِه عَملًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-03184","otherNeedIds":[22],"ref":"شرح السنة 7/500","text":["أَتيتُ النَّبيَّ صلَّى اللهُ عليهِ وسلَّم، فقُلتُ: واللهِ ما جِئتُك حتَّى حَلفتُ بِعدَدِ أَصابِعي ألَّا أتَّبعَك، ولا أتَّبِعَ دينَك، وإنِّي أَتيتُ أمرًا لا أَعقِلُ شيئًا إلَّا ما عَلَّمَني اللهُ ورَسولُه، وإنِّي أَسألُكَ باللهِ بِما بَعثَك إلينا ربُّنا؟ قال: اجلِسْ. ثُمَّ قال: بِالإسلامِ. فقُلتُ: ما آيةُ الإسلامِ؟ قال: تَشهدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ، وتُقيمُ الصَّلاةَ، وتُؤتي الزَّكاةَ، وتُفارِقُ الشِّركَ، وإنَّ كلَّ مُسلمٍ على مُسلمٍ مُحرَّمٌ، أَخوانِ نَصيرانِ ",["لا يَقبلُ اللهُ مِن مُشركٍ أَشرَك بعدَ إسلامِه عَملًا",2],"، وإن ربِّي داعيَّ وسائِلي: هل بَلَّغتَ عبادَه؟ فلْيُبلِّغْ شاهِدُكم غائِبَكم، وإنَّكُم تُدعونَ مُفدَّمٌ على أَفواهِكُم بالفِدامِ، فأوَّلُ ما يُسألُ عن أَحدِكم فَخِذُه وكفُّه. قال: قُلتُ: يا رَسولَ اللهِ هَذا دينُنا؟ قال: نَعَم. وأينَما تُحسِن يَكفِك، وإنَّكُم تُحشَرونَ عَلى وُجوهِكُم، وعلى أَقدامِكم ورُكبانًا."],"grade":"حسن","narrator":"معاوية بن حيدة القشيري","muhaddith":"حسن","takhrij":"أخرجه النسائي (2568)، وأحمد (20049)","bab":"إسلام › فضل الشهادتين","dorar":"oeYUUhzU"},{"id":"س-07655","fp":"30eea01f8628","stateId":546,"easy":"إذا لم تؤمن بالقدر ← لا يُقبل منك","cause":"حتَّى تؤمِنَ بالقدرِ","result":"ما قبلَ منكَ","explicit":true,"similar":["س-07664"],"otherNeedIds":[69,22],"ref":"صحيح ابن ماجه 62","srcLabel":"أبو داود","text":["عن ابن الديلمي، قال: وقعَ في نفسي شيءٌ من هذا القدرِ خشيتُ أن يُفسِدَ عليَّ ديني وأمري فأتيتُ أبيَّ بنَ كعبٍ فقلتُ أبا المنذرِ إنَّهُ قد وقعَ في نفسي شيءٌ من هذا القدرِ فخشيتُ على ديني وأمري فحدِّثني من ذلكَ بشيءٍ لعلَّ اللَّهَ أن ينفعَني بهِ فقالَ لو أنَّ اللَّهَ عذَّبَ أهلَ سماواتِهِ وأهلَ أرضِهِ لعذَّبَهم وهوَ غيرُ ظالمٍ لهم ولو رحِمهم لكانت رحمتُه خيرًا لهم من أعمالِهم ولو كانَ لكَ مثلُ جبلِ أحدٍ ذهبًا أو مثلُ جبلِ أحدٍ تنفقُهُ في سبيلِ اللَّهِ ",["ما قبلَ منكَ",2]," ",["حتَّى تؤمِنَ بالقدرِ",1]," فتعلمَ أنَّ ما أصابكَ لم يكن ليخطئكَ وأنَّ ما أخطأكَ لم يكن ليصيبَكَ وأنَّكَ إن متَّ على غيرِ هذا دخلتَ النَّار ولا عليكَ أن تأتِيَ أخي عبدَ اللَّهِ بنَ مسعودٍ فتسألَهُ فأتيتُ عبدَ اللَّهِ فسألتُه فذَكرَ مثلَ ما قالَ أبيٌّ وقالَ لي ولا عليكَ أن تأتيَ حذيفةَ فأتيتُ حذيفةَ فسألتُه فقالَ مثلَ ما قالا وقالَ ائتِ زيدَ بنَ ثابتٍ فاسألْهُ فأتيتُ زيدَ بنَ ثابتٍ فسألتُه فقالَ سمعتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ لو أنَّ اللَّهَ عذَّبَ أهلَ سماواتِهِ وأهلَ أرضِهِ لعذَّبَهم وهوَ غيرُ ظالمٍ لهم ولو رحِمهم لكانت رحمتُه خيرًا لهم من أعمالِهم ولو كانَ لكَ مثلُ أحدٍ ذهبًا أو مثلُ جبلِ أحدٍ ذهبًا تنفقُهُ في سبيلِ اللَّهِ ما قَبِلَهُ منكَ حتَّى تؤمِنَ بالقدرِ كلِّهِ فتعلمَ أنَّ ما أصابكَ لم يكن ليخطئَكَ وما أخطأكَ لم يكن ليصيبَكَ وأنَّكَ إن متَّ على غيرِ هذا دخلتَ النَّارَ"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (77) بلفظه، وأبو داود (4699)، وأحمد (21611) باختلاف يسير.","bab":"قدر › التكذيب بالقدر","dorar":"kAuTRNpp","merged":8,"otherRefs":["صحيح ابن حبان 727 (صحيح)","تخريج كتاب السنة 245 (صحيح)","الأحاديث المختارة 8 / 351 (صحيح)","مجمع الزوائد 7/201 (حسن)","تخريج المسند لشعيب 21653 (حسن)","الأحاديث المختارة 8 / 352 (صحيح)","إتحاف الخيرة المهرة 1/173 (صحيح)"]},{"id":"س-07664","fp":"6a1c137d39b3","stateId":546,"easy":"إذا لم تؤمن بالقدر وأن ما أصابك لم يكن ليخطئك ← لا يقبل الله منك ولو أنفقت مثل أحد ذهباً","cause":"من أعمالِهم ولو أنفقتَ مثلَ أُحُدٍ ذهبًا ما","result":"قبلَ اللَّهُ منكَ حتَّى تؤمنَ بالقدَرِ وتعلمَ أنَّ ما أصابَكَ لم يكن ليخطئَكَ وما أخطأكَ لم يكُ ليصيبَكَ ولو متَّ على غيرِ ذلك لكنتَ من أهلِ النَّارِ","explicit":true,"repOf":"س-07655","ref":"شفاء العليل 1/343","text":["عن [ابن] الديلمي قال: أتيت أبي كعب فقلت: في نفسي شيء من القدر فحدثني بشيء لعل الله يذهبه عني من قلبي فقال: إنَّ اللَّهَ لو عذَّبَ أهلَ سماواتِهِ وأهلَ أرضهِ لعذَّبَهم وهوَ غيرُ ظالمٍ لهم ولو رحِمَهم لكانَت رحمتُهُ خيرًا لهم ",["من أعمالِهم ولو أنفقتَ مثلَ أُحُدٍ ذهبًا ما ",1],["قبلَ اللَّهُ منكَ حتَّى تؤمنَ بالقدَرِ وتعلمَ أنَّ ما أصابَكَ لم يكن ليخطئَكَ وما أخطأكَ لم يكُ ليصيبَكَ ولو متَّ على غيرِ ذلك لكنتَ من أهلِ النَّارِ",2],". قالَ فأتيتُ عبدَ اللَّهِ بنَ مسعودٍ وحذيفةَ بنَ اليمانِ وزيدَ بنَ ثابتٍ فكلٌّ منهم حدَّثني بمثلِ ذلكَ عنِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود وحذيفة بن اليمان وزيد بن ثابت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4699) بلفظ مقارب، وابن ماجه (77)، وأحمد (21653)","bab":"قدر › التكذيب بالقدر","dorar":"k78U4Ych"},{"id":"س-03842","fp":"a7ff306ff83e","stateId":546,"easy":"إذا لم تستعذ بالله يوماً من النار ← لا ينفعك ما عملت (الكافر)","cause":"هل قال يَومًا واحِدًا: اللَّهمَّ إنِّي أعوذُ بكَ مِن نارِ جَهنَّمَ","result":"فَلا إذَنْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج مشكل الآثار 4359","srcLabel":"متفق عليه","text":["قُلتُ: يا رسولَ اللهِ، أخبِرْني عنِ ابنِ عَمَّتي ابنِ جُدْعانَ، قال: فقالَ رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ما كان؟ قُلتُ: كانَ يَنحَرُ الكَوْماءَ، وكان يَجلِبُ على الماءِ، وكان يُكرِمُ الجارَ، وكانَ يَقْري الضَّيفَ، وكان يَصدُقُ الحَديثَ، وكان يَصِلُ الرَّحِمَ، ويُوفي بالذِّمَّةِ، ويَفُكُّ العانيَ، ويُطعِمُ الطَّعامَ، ويُؤَدِّي الأمانةَ. قال: ",["هل قال يَومًا واحِدًا: اللَّهمَّ إنِّي أعوذُ بكَ مِن نارِ جَهنَّمَ",1],"؟ قُلتُ: ما كان يَدْري ما نارُ جَهنَّمَ. قال: ",["فَلا إذَنْ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2746) واللفظ له، وأبو يعلى (4870) باختلاف يسير، ومسلم (214) مختصرًا.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"asN7f9wM"},{"id":"س-04750","fp":"2225e08efde2","stateId":547,"easy":"إذا عملت عملاً أشركت فيه غير الله ← فالله منه بريء وهو لمن أشركته","cause":"فمَن عملَ عملًا فأشرَكَ فيهِ غيري","result":"فأَنا منهُ بريءٌ وَهوَ للَّذي أشرَكَ","explicit":true,"star":true,"similar":["س-04697"],"otherNeedIds":[28],"ref":"صحيح ابن خزيمة 2/ 141","srcLabel":"مسلم","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ يَرويهِ عن ربِّهِ قالَ: أَنا خيرُ الشُّرَكاءِ - وقالَ بُندارٌ: أَنا أغنَى الشُّرَكاءِ - عنِ الشِّركِ ",["فمَن عملَ عملًا فأشرَكَ فيهِ غيري",1]," ",["فأَنا منهُ بريءٌ وَهوَ للَّذي أشرَكَ",2]," وقالَ بندارٌ: قالَ: فأَنا منهُ بريءٌ وليلتمِسْ ثوابَهُ منهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2985)، وابن ماجة (4202)، وأحمد (7999) بنحوه.","bab":"رقائق وزهد › الإخلاص","dorar":"ouHDegEN","merged":4,"otherRefs":["الرسالة الوازعة للمعتدين 310 (صحيح)","مسند عمر 2/790 (صحيح)","صحيح الترغيب 34 (صحيح)"]},{"id":"س-04995","fp":"48ce459a58e5","stateId":547,"easy":"إذا أشركت بالله في عملك ← فهو لشريكك، فأخلص عملك لله","cause":"مَن أشْرَكَ بي","result":"فهو لشَريكي، يا أيُّها النَّاسُ أَخْلِصوا أعْمالَكم للهِ؛ فإنَّ اللهَ لا يَقبَلُ مِن العَمَلِ إلَّا ما خَلَصَ، ولا تقولوا: هذا للهِ والرَّحِمِ، فإنَّه للرَّحِمِ وليس للهِ مِنه شيءٌ، ولا تقولوا","explicit":true,"star":true,"similar":["س-04699"],"ref":"الأحاديث المختارة 8 / 90","srcLabel":"متفق عليه","text":["(إنَّ اللهَ تَعالى يَقولُ: «أنا خَيْرُ شَريكٍ، ",["مَن أشْرَكَ بي ",1],["فهو لشَريكي، يا أيُّها النَّاسُ أَخْلِصوا أعْمالَكم للهِ؛ فإنَّ اللهَ لا يَقبَلُ مِن العَمَلِ إلَّا ما خَلَصَ، ولا تقولوا: هذا للهِ والرَّحِمِ، فإنَّه للرَّحِمِ وليس للهِ مِنه شيءٌ، ولا تقولوا:",2]," هذا للهِ ولِوُجوهِكم، فإنَّما هو لوُجوهِكم وليس للهِ فيه شيءٌ»)."],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NBVZPm76"},{"id":"س-04697","fp":"924404588670","stateId":547,"easy":"إذا عملت عملاً أشركت فيه غير الله ← فهو لمن أشركته، والله منه بريء","cause":"من عمِل لي عملًا أشرك فيه غيري","result":"فهو له كلُّه أنا منه بريءٌ","explicit":true,"repOf":"س-04750","otherNeedIds":[28],"ref":"تخريج الإحياء للعراقي 3/361","text":["يقولُ اللهُ عزَّ وجلَّ ",["من عمِل لي عملًا أشرك فيه غيري",1]," ",["فهو له كلُّه أنا منه بريءٌ",2]," وأنا أغنَى الأغنياءِ عن الشِّركِ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2985) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"bgHpRRyN"},{"id":"س-05501","fp":"2c528a44aa6a","stateId":547,"easy":"إذا راءيت ← لا يصعد إلى الله من الرياء شيء","cause":"الرِّياءِ","result":"لا يصعدُ إليَّ منَ الرِّياءِ شيءٌ","explicit":true,"otherNeedIds":[22],"ref":"العرش للذهبي 72","srcLabel":"مسلم","text":["يقولُ اللَّهُ تعالى أنا أغنى الشُّرَكاءِ عنِ الشِّركِ ",["لا يصعدُ إليَّ منَ الرِّياءِ شيءٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"محفوظ من حديث قيس بن الربيع","takhrij":"أخرجه مسلم (2985)، وابن ماجه (4202)، وأحمد (9619) أوله في أثناء حديث، والديلمي في ((الفردوس)) (8037) واللفظ له","bab":"رقائق وزهد › الرياء والسمعة","dorar":"iy79Qf1W"},{"id":"ق-0099","fp":"8b9ac48865e0","stateId":547,"easy":"المنّ والأذى والرياء في الصدقة ← بطلان الصدقة وذهاب ثوابها","cause":"المنّ والأذى والرياء في الصدقة","result":"بطلان الصدقة وذهاب ثوابها","explicit":true,"ref":"سورة البقرة: 264","srcLabel":"القرآن الكريم","quran":{"s":2,"from":264,"to":264,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُبْطِلُوا صَدَقَاتِكُمْ بِالْمَنِّ وَالْأَذَى كَالَّذِي يُنْفِقُ مَالَهُ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ فَمَثَلُهُ كَمَثَلِ صَفْوَانٍ عَلَيْهِ تُرَابٌ فَأَصَابَهُ وَابِلٌ فَتَرَكَهُ صَلْدًا لَا يَقْدِرُونَ عَلَى شَيْءٍ مِمَّا كَسَبُوا وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ (264)","hl":[[31,302,1]]}},{"id":"س-04755","fp":"98ec9704efb7","stateId":547,"easy":"إذا عملت عملاً ← فالله لا يقبل إلا ما كان خالصاً له","cause":"مِن العَمَلِ إلَّا ما كانَ له خالِصًا، وابْتُغِيَ به وَجْهُه","result":"إنَّ اللهَ عَزَّ وجَلَّ لا يَقبَلُ","explicit":true,"otherNeedIds":[51,19],"ref":"الأحكام الوسطى 2/357","srcLabel":"النسائي","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: أَرَأيْتَ رَجُلًا غَزا يَلتَمِسُ الأجْرَ والذِّكْرَ ما له؟ فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: \"لا شيءَ له\"، فأعادَها ثَلاثَ مَرَّاتٍ يَقولُ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"لا شيءَ له\"، ثُمَّ قالَ: \"",["إنَّ اللهَ عَزَّ وجَلَّ لا يَقبَلُ",2],[" مِن العَمَلِ إلَّا ما كانَ له خالِصًا، وابْتُغِيَ به وَجْهُه\"",1],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3140)، والطبراني (8/ 140) (7628) بلفظه.","bab":"رقائق وزهد › الإخلاص","dorar":"7UkVHJcX","merged":2,"otherRefs":["السلسلة الصحيحة 2764 (صحيح)"]},{"id":"س-04699","fp":"624a2a596f51","stateId":547,"easy":"إذا أشركت مع الله شريكاً في عملك ← فهو لشريكك فأخلص عملك لله","cause":"فمن أشرك معي شريكًا","result":"فهو لِشريكي ، يا أيها الناسُ أخلِصوا أعمالَكم ؛ فإنَّ اللهَ تبارك وتعالى لا يَقبلُ من الأعمالِ إلا ما خلُصَ له ، ولا تقولوا : هذه للهِ وللرَّحِمِ ؛ فإنها","explicit":true,"repOf":"س-04995","ref":"صحيح الترغيب 7","text":["إنَّ اللهَ تبارك وتعالى يقول : أنا خيرُ شريكٍ ، ",["فمن أشرك معي شريكًا ",1],["فهو لِشريكي ، يا أيها الناسُ أخلِصوا أعمالَكم ؛ فإنَّ اللهَ تبارك وتعالى لا يَقبلُ من الأعمالِ إلا ما خلُصَ له ، ولا تقولوا : هذه للهِ وللرَّحِمِ ؛ فإنها",2]," للرَّحِمِ ، وليس للهِ منها شيءٌ ، ولا تقولوا : هذه للهِ ولوجوهِكم ؛ فإنها لوجوهِكم ، وليس للهِ منها شيءٌ"],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"صحيح لغيره","takhrij":"أخرجه الدارقطني (133)، وابن قانع في ((معجم الصحابة)) (2/ 32) واللفظ لهما وفيه زيادة، وابن أبي شيبة (35937) بنحوه.","bab":"رقائق وزهد › الإخلاص","dorar":"Squ0sXHU"},{"id":"س-05059","fp":"71e36154d6be","stateId":547,"easy":"إذا راءيت ← يقال لك يوم القيامة: اذهب إلى من كنت تراءيه","cause":"الرياءُ","result":"يقولُ اللهُ عزَّ وجلَّ يومَ القيامةِ للمرائين : اذهبوا إلى ما كنتم تُراءون في الدنيا فانظروا هل تَجدون عندَهم من جزاءٍ","explicit":true,"similar":["س-05514"],"ref":"مجموع فتاوى ابن باز 44/1","srcLabel":"مجموع فتاوى ابن باز","text":["أخوفُ ما أخافُ عليكمُ الشركُ الأصغرُ، فسُئِلَ عنه، فقال : ",["الرياءُ",1]," ",["يقولُ اللهُ عزَّ وجلَّ يومَ القيامةِ للمرائين : اذهبوا إلى ما كنتم تُراءون في الدنيا فانظروا هل تَجدون عندَهم من جزاءٍ",2]],"grade":"صحيح","narrator":"محمود بن لبيد الأنصاري","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qdJcBC96"},{"id":"س-05504","fp":"f3fdec3d6ce1","stateId":547,"easy":"إذا بنيت المساجد رياءً ← فهو لا لك ولا عليك","cause":"من بنَى المساجدَ رياءً","result":"فهو لا عليه ولا له","explicit":true,"ref":"فتح الباري لابن رجب 2/504","srcLabel":"ابن أبي الدنيا","text":["عن قتادةَ أنه قالَ : كلُ بناءِ رياءٍ فهو على صاحبِه لا له ، إلا ",["من بنَى المساجدَ رياءً ",1],["فهو لا عليه ولا له",2]],"grade":"صحيح","narrator":"[الوضاح بن عبدالله اليشكري أبو عوانة]","muhaddith":"عن قتادة بإسناد صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((قصر الأمل)) (287) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"jRf4Ul22"},{"id":"س-05514","fp":"7f80ad908404","stateId":547,"easy":"إذا راءيت في الدنيا ← يقال لك: اذهب إلى من كنت تراءيهم فاطلب جزاءك عندهم","cause":"كُنْتُم تُراؤُونَ في الدُّنيا","result":"اذهَبوا إلى الَّذين كُنْتُم تُراؤُونَ في الدُّنيا فانظُروا هل تجِدونَ عندَهم جزاءً","explicit":true,"repOf":"س-05059","ref":"مجمع الزوائد 1/107","text":["إنَّ أخوفَ ما أخافُ عليكم الشِّركُ الأصغرُ قال : وما الشِّركُ الأصغرُ يا رسولَ اللهِ ؟ قال : الرِّياءُ يقولُ اللهُ عزَّ وجلَّ إذا جزى النَّاسَ بأعمالِهم ",["اذهَبوا إلى الَّذين كُنْتُم تُراؤُونَ في الدُّنيا فانظُروا هل تجِدونَ عندَهم جزاءً",2]],"grade":"صحيح","narrator":"محمود بن لبيد الأنصاري","muhaddith":"رجاله رجال الصحيح","bab":"رقائق وزهد › الرياء والسمعة","dorar":"CyoHx33S"},{"id":"س-07518","fp":"ec96ac02f8f2","stateId":547,"easy":"إذا أشركت أحداً في عمل لله ← فاطلب ثوابه من غير الله، فالله أغنى الشركاء","cause":"مَن كان أشرَكَ في عَمَلٍ عَمِلَه للَّهِ أحَدًا، فليَطلُبْ ثَوابَه مِن عِندِ غَيرِ اللهِ عَزَّ وجَلَّ","result":"فإنَّ اللهَ أغنى الشُّرَكاءِ عنِ الشِّركِ","explicit":true,"ref":"تخريج المسند لشعيب 15838","srcLabel":"أحمد","text":["إذا جَمَعَ اللهُ عَزَّ وجَلَّ الأوَّلينَ والآخِرينَ ليَومٍ لا رَيبَ فيه، نادى مُنادٍ: ",["مَن كان أشرَكَ في عَمَلٍ عَمِلَه للَّهِ أحَدًا، فليَطلُبْ ثَوابَه مِن عِندِ غَيرِ اللهِ عَزَّ وجَلَّ؛ ",1],["فإنَّ اللهَ أغنى الشُّرَكاءِ عنِ الشِّركِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد بن أبي فضالة الأنصاري","muhaddith":"صحيح لغيره","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YWxixUR2"},{"id":"س-04723","fp":"4bae89b27825","stateId":547,"easy":"إذا أحسنت صلاتك أمام الناس وأسأتها خالياً ← فهي استهانة بربك","cause":"مَن أحسنَ صلاتَه حيثُ يراها النَّاسُ ، وأساءَها إذا خَلا","result":"فإنَّما ذلكَ استِهانةٌ يستهينُ بِها ربَّهُ","explicit":true,"ref":"المطالب العالية 3/384","srcLabel":"البيهقي","text":[["مَن أحسنَ صلاتَه حيثُ يراها النَّاسُ ، وأساءَها إذا خَلا ",1],["فإنَّما ذلكَ استِهانةٌ يستهينُ بِها ربَّهُ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه عبدالرزاق في ((المصنف)) (3738)، والمروزي في ((تعظيم قدر الصلاة)) (865)، والبيهقي (3727)","bab":"رقائق وزهد › الإخلاص","dorar":"M0TFRj1A"},{"id":"س-05512","fp":"d59c1dd2c492","stateId":547,"easy":"إذا عملت عملاً لغير الله ← فاطلب ثوابه ممن عملت له","cause":"مَنْ عَمِلَ عملًا لغيرِ اللهِ","result":"فليطلبْ ثوابَهُ ممنْ عَمِلَ لهُ","explicit":true,"ref":"إتقان ما يحسن 1/61","srcLabel":"إتقان ما يحسن","text":["إذا كان يومُ القيامةِ نادى منادٍ ",["مَنْ عَمِلَ عملًا لغيرِ اللهِ",1]," ",["فليطلبْ ثوابَهُ ممنْ عَمِلَ لهُ",2]],"grade":"حسن","narrator":"محمد بن أسد","muhaddith":"رجاله ثقات","takhrij":"لم نقف عليه إلا عند محمد بن محمد الغزي في ((إتقان ما يحسن)) (1/ 61).","bab":"رقائق وزهد › الرياء والسمعة","dorar":"EJg9y2YE"},{"id":"س-06956","fp":"456c9090a80b","stateId":547,"easy":"إذا عملت عملاً لغير الله ← فالتمس ثوابه منه، والله أغنى الشركاء عن الشرك","cause":"من عمِل لغيري عملًا فلْيلتمِسْ","result":"ثوابَه منه أنا أغنى الشركاءِ عن الشركِ","explicit":true,"ref":"الاستغناء 1/320","srcLabel":"الترمذي","text":["عنِ النبيِّ عليهِ السلامُ في الرِّياءِ يحكيه عن ربِّه عَزَّ وَجَلَّ قال ",["من عمِل لغيري عملًا فلْيلتمِسْ ",1],["ثوابَه منه أنا أغنى الشركاءِ عن الشركِ",2]],"grade":"حسن","narrator":"أبو سعد بن أبي فضالة الأنصاري","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3154)، وابن ماجة (4203)، والدولابي في ((الكنى والأسماء)) (209) واللفظ لهم.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"Tvpj81dg"},{"id":"س-08122","fp":"7afcadd2bbe3","stateId":547,"easy":"إذا عملت لغير وجه الله ← تُلقى صحفك ولا تُقبل","cause":"إنَّ العبدَ ليعمَلُ أعمالًا حسَنةً فتصعَدُ الملائكةَ في صحُفٍ مختَّمةٍ فتُلقى بين يدَيِ اللهِ تعالى فيقولُ : ألقوا هذِهِ الصَّحيفةَ","result":"فإنَّهُ لم يرِدْ بما فيها وَجهي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج الإحياء للعراقي 5/87","srcLabel":"الدارقطني","text":[["إنَّ العبدَ ليعمَلُ أعمالًا حسَنةً فتصعَدُ الملائكةَ في صحُفٍ مختَّمةٍ فتُلقى بين يدَيِ اللهِ تعالى فيقولُ : ألقوا هذِهِ الصَّحيفةَ ",1],["فإنَّهُ لم يرِدْ بما فيها وَجهي",2]," ثمَّ ينادي الملائكةَ اكتُبوا له كذا وكذا اكتُبوا له كذا وكذا فيقولونَ : يا ربَّنا إنه لم يعمَل شيئًا من ذلكَ فيقولُ اللَّهُ تعالى : إنه نواهُ ."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارقطني كما في ((تخريج أحاديث الإحياء)) (ص1731) بلفظه.","bab":"ملائكة › أعمال الملائكة","dorar":"3SovSlTU"},{"id":"س-04412","fp":"a17a7900b1ec","stateId":548,"easy":"إذا كانت هجرتك لدنيا أو امرأة ← فهجرتك إلى ما هاجرت إليه","cause":"ومَن كانَت هجرتُهُ إلى دُنْيا يُصيبُها أوِ امرَأةٍ يَتزوَّجُها","result":"فَهِجرتُهُ إلى ما هاجرَ إليهِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/262","srcLabel":"البخاري","text":["إنَّما الأَعمالُ بالنِّيَّةِ وإنَّما لامرئٍ ما نَوَى، فمَن كانَت هِجرتُهُ إلى اللَّهِ وإلى رسولِهِ فَهِجرتُهُ إلى اللَّهِ وإلى رسولِهِ، ",["ومَن كانَت هجرتُهُ إلى دُنْيا يُصيبُها أوِ امرَأةٍ يَتزوَّجُها",1]," ",["فَهِجرتُهُ إلى ما هاجرَ إليهِ",2]," - وفي روايةٍ بدونِ - وإنَّما لامرئٍ ما نَوَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6689)، والترمذي (1647)، والنسائي (75)، وأحمد (168) واللفظ لهم.","bab":"جهاد › النية في القتال والغزو","dorar":"mfMGtcQO","merged":2,"otherRefs":["صحيح الترغيب 10 (صحيح)"]},{"id":"س-04413","fp":"4a5abe20c32a","stateId":548,"easy":"إذا غزوت لا تنوي إلا عقالاً ← فلك ما نويت","cause":"مَن غَزا في سَبيلِ اللهِ تَبارَكَ وتَعالى ولا يَنْوي في غَزاتِه إلَّا عِقالًا","result":"فله ما نَوى","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 356","srcLabel":"متفق عليه","text":["(«",["مَن غَزا في سَبيلِ اللهِ تَبارَكَ وتَعالى ولا يَنْوي في غَزاتِه إلَّا عِقالًا ",1],["فله ما نَوى»)",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › النية في القتال والغزو","dorar":"Sc2jCSI0"},{"id":"ق-0578","fp":"e84dd32b4493","stateId":548,"easy":"إرادة الحياة الدنيا وزينتها بالعمل ← يوفّى فيها ثم ليس له في الآخرة إلا النار وحبوط العمل","cause":"إرادة الحياة الدنيا وزينتها بالعمل","result":"يوفّى فيها ثم ليس له في الآخرة إلا النار وحبوط العمل","explicit":true,"otherNeedIds":[69],"ref":"سورة هود: 15–16","srcLabel":"القرآن الكريم","quran":{"s":11,"from":15,"to":16,"text":"مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ (15) أُولَئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ (16)","hl":[[0,256,1]]}},{"id":"س-04722","fp":"bfbb68dad887","stateId":548,"easy":"إذا عملت عمل الآخرة للدنيا ← فليس لك في الآخرة من نصيب","cause":"فمَن عمِلَ منهُم بعملِ الآخرةِ للدُّنيا","result":"فليسَ لهُ في الآخرةِ مِن نصيبٍ","explicit":true,"otherNeedIds":[71],"ref":"صحيح الترغيب 23","srcLabel":"أحمد","text":["بشِّرْ هذهِ الأُمَّةَ بالتَّيسيرِ ، والسَّناءِ والرِّفعةِ بالدِّينِ ، والتَّمكينِ في البلادِ ، والنَّصرِ ، ",["فمَن عمِلَ منهُم بعملِ الآخرةِ للدُّنيا ، ",1],["فليسَ لهُ في الآخرةِ مِن نصيبٍ",2]],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21258)، والحاكم (7862)، والبيهقي في ((شعب الإيمان)) (6833) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"qcuyGn3e","merged":3,"otherRefs":["صحيح الجامع 2825 (صحيح)","مجمع الزوائد 10/223 (صحيح)"]},{"id":"س-05516","fp":"e80a0acb58fc","stateId":548,"easy":"إذا جاهدت تبتغي عرض الدنيا ← فلا أجر لك","cause":"يُريدُ الجهادَ في سبيلِ اللهِ وهو يبتغي مِن عرَضِ الدُّنيا","result":"لا أجرَ له","explicit":true,"ref":"صحيح ابن حبان 4637","srcLabel":"أبو داود","text":["أنَّ رجلًا قال: يا رسولَ اللهِ رجلٌ ",["يُريدُ الجهادَ في سبيلِ اللهِ وهو يبتغي مِن عرَضِ الدُّنيا",1]," قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["لا أجرَ له",2]," ) فأعظَم ذلك النَّاسُ وقالوا للرَّجلِ: عُدْ لرسولِ اللهِ فلعلَّكَ لم تفهَمْه قال: فقال الرَّجلُ: يا رسولَ اللهِ: رجلٌ يُريدُ الجهادَ في سبيلِ اللهِ وهو يبتغي مِن عرَضِ الدُّنيا ؟ قال: ( لا أجرَ له ) فأعظَم ذلك النَّاسُ وقالوا للرَّجلِ: عُدْ لرسولِ اللهِ فقال له الثَّالثةَ: رجلٌ يُريدُ الجهادَ في سبيلِ اللهِ وهو يبتغي مِن عرَضِ الدُّنيا ؟ قال: ( لا أجرَ له )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (2516)، وأحمد (7900) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"uV7LCIuc","merged":3,"otherRefs":["تخريج المسند لشاكر 15/16 (صحيح)","زاد المعاد 3/80 (صحيح)"]},{"id":"س-06419","fp":"483931b0b321","stateId":548,"easy":"إذا لم تحتسب ← فلا أجر لك","cause":"لِمَن لا حسبةَ لَهُ","result":"ولا أجرَ","explicit":true,"otherNeedIds":[51],"ref":"السنن الكبرى للبيهقي 1/41","srcLabel":"البيهقي","text":["أنَّ رجلًا منَ الأنصارِ مِن بَني عمرو بنِ عوفٍ ، قالَ : يا رسولَ اللَّهِ ، إنَّكَ رَغَّبتَنا في السِّواكِ فَهَل دونَ ذلِكَ مِن شيءٍ ؟ قالَ : أصابعُكَ سواكٌ عندَ وضوئِكَ تُمِرُّهما على أسنانِكَ ، إنَّهُ لا عملَ لمن لا نيَّةَ لَهُ ، ",["ولا أجرَ",2]," ",["لِمَن لا حسبةَ لَهُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"محفوظ","takhrij":"أخرجه البيهقي في ((الكبرى)) (1/ 41) واللفظ له، وفي ((الخلافيات)) (1/299) باختلاف يسير.","bab":"صلاة › النية في الأعمال","dorar":"xff7mn0G","merged":2,"otherRefs":["السلسلة الصحيحة 2415 (صحيح)"]},{"id":"س-00391","fp":"a272468c63c2","stateId":548,"easy":"إذا تصدقت بالرديء (الحشف) ← تأكل الحشف يوم القيامة","cause":"علَّقَ رجُلٌ قَنًا حَشَفًا","result":"إنَّ ربَّ هذه الصَّدَقةِ يأكُلُ الحَشَفَ يومَ القيامةِ","explicit":true,"similar":["س-03035"],"otherNeedIds":[69],"ref":"تخريج سنن أبي داود 1608","srcLabel":"أبو داود","text":["دخَلَ علينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ المَسجِدَ، وبيَدِه عصًا، وقد ",["علَّقَ رجُلٌ قَنًا حَشَفًا",1],"، فطعَنَ بالعَصا في ذلك القِنْوِ، وقال: لو شاءَ ربُّ هذه الصَّدَقةِ تصدَّقَ بأطيَبَ منها وقال: ",["إنَّ ربَّ هذه الصَّدَقةِ يأكُلُ الحَشَفَ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عوف بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (1608)، واللفظ له، والنسائي (2493)، وابن ماجه (1821)، باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"rHZAkjPd"},{"id":"س-04698","fp":"6fba7c6c7bb3","stateId":548,"easy":"إذا هاجرت تبتغي شيئاً ← فهو لك (دون الأجر)","cause":"مَنْ هاجَرَ يَبْتَغِي شيئًا","result":"فهوَ لهُ","explicit":true,"ref":"سير أعلام النبلاء 10/590","srcLabel":"الطبراني","text":["قال عبدُ اللهِ : ",["مَنْ هاجَرَ يَبْتَغِي شيئًا",1]," ، ",["فهوَ لهُ",2]," . قال : هاجَرَ رجلٌ لِيَتَزَوَّجَ امرأةً يقالُ لها : أمُّ قَيْسٍ ، فكَانَ يقالُ لهُ : مُهاجِرَ أُمِّ قَيْسٍ ."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (9/ 103) (8540)، وأبو نعيم في ((معرفة الصحابة)) (8014) بلفظه.","bab":"رقائق وزهد › الإخلاص","dorar":"QFWFP9Jf"},{"id":"س-04717","fp":"f932a1a4c338","stateId":548,"easy":"إذا أتيت المسجد لشيء ← فهو حظك منه","cause":"مَنْ أتَى المسجِدَ لشيءٍ","result":"فهُوَ حَظُّهُ","explicit":true,"ref":"صحيح الجامع 5936","srcLabel":"أبو داود","text":[["مَنْ أتَى المسجِدَ لشيءٍ",1]," ",["فهُوَ حَظُّهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (472)، والبيهقي (4514) واللفظ لهما، وأبو نعيم في ((حلية الأولياء)) (5/159) باختلاف يسير.","bab":"رقائق وزهد › الإخلاص","dorar":"jYIh5mEY"},{"id":"س-06418","fp":"fddf044f1c4e","stateId":548,"easy":"إذا لم تكن لك نية ← فلا عمل لك","cause":"لمن لا نيَّةَ لَهُ","result":"لا عملَ","explicit":true,"ref":"السنن الكبرى للبيهقي 1/41","srcLabel":"البيهقي","text":["أنَّ رجلًا منَ الأنصارِ مِن بَني عمرو بنِ عوفٍ ، قالَ : يا رسولَ اللَّهِ ، إنَّكَ رَغَّبتَنا في السِّواكِ فَهَل دونَ ذلِكَ مِن شيءٍ ؟ قالَ : أصابعُكَ سواكٌ عندَ وضوئِكَ تُمِرُّهما على أسنانِكَ ، إنَّهُ ",["لا عملَ",2]," ",["لمن لا نيَّةَ لَهُ",1]," ، ولا أجرَ لِمَن لا حسبةَ لَهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"محفوظ","takhrij":"أخرجه البيهقي في ((الكبرى)) (1/ 41) واللفظ له، وفي ((الخلافيات)) (1/299) باختلاف يسير.","bab":"صلاة › النية في الأعمال","dorar":"xff7mn0G"},{"id":"س-01641","fp":"6af70940376b","stateId":548,"easy":"إذا عمل الكافر الخير لغير الله ← فقد أدرك ما أراد في الدنيا","cause":"إنَّ أبي كان يصِلُ الرَّحِمَ وكان يفعَلُ ويفعَلُ","result":"إنَّ أباك أراد أمرًا فأدرَكه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-05485","س-01994"],"ref":"صحيح ابن حبان 332","srcLabel":"أبو داود","text":["عن عَديِّ بنِ حاتمٍ قال: قُلْتُ: يا رسولَ اللهِ ",["إنَّ أبي كان يصِلُ الرَّحِمَ وكان يفعَلُ ويفعَلُ",1]," قال: ( ",["إنَّ أباك أراد أمرًا فأدرَكه",2]," - يعني الذِّكْرَ ) قال: قُلْتُ: يا رسولَ اللهِ إنِّي أسأَلُك عن طعامٍ لا أدَعُه إلَّا تحرُّجًا قال: ( لا تدَعْ شيئًا ضارَعْتَ النَّصرانيَّةَ فيه ) قال: قُلْتُ: إنِّي أُرسِلُ كلبي فيأخُذُ صيدًا ولا أجِدُ ما أذبَحُ به إلَّا المروةَ أو العصا ؟ قال: ( أمِرَّ الدَّمَ بما شِئْتَ واذكُرِ اسمَ اللهِ )"],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن الجعد في ((المسند)) (561)، (562) والمزي في ((تهذيب الكمال)) (27/ 414) باختلاف يسير وأخرجه أبو داود (2824) والنسائي (4304) مختصرا.","bab":"أطعمة › ما يحل من الأطعمة","dorar":"D8vFkkwZ","merged":4,"otherRefs":["تخريج مشكل الآثار 4360 (حسن)","مجمع الزوائد 1/124 (حسن)","تخريج المسند لشعيب 19374 (صحيح)"]},{"id":"س-03035","fp":"d74480d0a63b","stateId":548,"easy":"إذا تصدقت بالرديء ← تأكل الحشف يوم القيامة","cause":"وقِنوٌ منها حشَفٌ","result":"إنَّ صاحبَ هذه الصَّدَقةِ يَأكُلُ الحشَفَ يَومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00391","otherNeedIds":[69],"ref":"المستدرك على الصحيحين 8530","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خرَجَ عليهم وأقناءٌ مُعلَّقةٌ، ",["وقِنوٌ منها حشَفٌ",1],"، ومعه عصًا، فطَعَن بالعَصا في القِنْوِ، وقال: لوْ شاء ربُّ هذه الصَّدقةِ تَصدَّقَ بأطيَبَ منها، ",["إنَّ صاحبَ هذه الصَّدَقةِ يَأكُلُ الحشَفَ يَومَ القيامةِ",2],"، ثمَّ أقْبَلَ علينا، فقال: أمَا واللهِ يا أهْلَ المدينةِ، لَتَدَعُنَّها مُذلَّلةً أربعينَ عامًا للعَوافي، قُلنا: اللهُ ورَسولُه أعلَمُ، ثمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أتَدْرُون ما العَوافي؟ قالوا: لا، قال: الطَّيرُ والسِّباعُ."],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (1608)، وابن ماجه (1821)، وأحمد (23976) جميعهم بلفظ قريب.","bab":"إيمان › الوعيد","dorar":"qQZN86ro","merged":4,"otherRefs":["صحيح ابن حبان 6774 (صحيح)","تخريج المسند لشعيب 23976 (حسن)","المستدرك على الصحيحين 3167 (صحيح)"]},{"id":"س-04752","fp":"1b295638b545","stateId":548,"easy":"إذا غزوت لأجل الأجرة ← فليس لك إلا ما سميت","cause":"فسَمَّيتُ له ثلاثةَ دنانيرَ","result":"ما أَجِدُ له في غَزْوتِه هذه في الدُّنيا إلَّا دَنانيرَهُ الَّتي سَمَّى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2566","srcLabel":"أحمد","text":["أَذَّنَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بالغَزْوِ وأنا شَيخٌ كبيرٌ ليس لي خادِمٌ، فالتَمسْتُ أَجيرًا يَكْفيني، وأُجْري له سَهْمَه، فوَجَدْتُ رَجلًا، فلمَّا دَنا الرَّحيلُ، أَتاني، فقالَ: ما أَدْري ما السُّهْمانُ، وما يَبلُغُ سَهْمي، فسَمِّ لي شيئًا كان السَّهمُ أوْ لمْ يَكُنْ، ",["فسَمَّيتُ له ثلاثةَ دنانيرَ",1],"، فلمَّا حضَرَتْ غَنيمةٌ، أَرَدْتُ أنْ أُجرِيَ له سَهْمَه، فذَكَرْتُ الدَّنانيرَ، فجئتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فذَكَرْتُ له أَمْرَهُ، فقالَ: ",["ما أَجِدُ له في غَزْوتِه هذه في الدُّنيا إلَّا دَنانيرَهُ الَّتي سَمَّى",2],"."],"grade":"صحيح","narrator":"يعلى بن منية","muhaddith":"صحيح على شرطهما","takhrij":"أخرجه أبو داوود (2527)، والبيهقي (13036) واللفظ لهما، وأحمد (17957) بلفظ قريب.","bab":"رقائق وزهد › الإخلاص","dorar":"Txib56tg"},{"id":"س-05485","fp":"626cbd93f427","stateId":548,"easy":"إذا عمل الكافر الخير ← فقد طلب أمراً فأصابه في الدنيا","cause":"إنَّ أبي كانَ يصلُ الرَّحمَ ويفعلُ ويفعلُ","result":"إنَّ أباكَ طلبَ أمرًا فأصابَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01641","ref":"عمدة التفسير 1/507","text":["قلتُ : يا رسولَ اللَّهِ ، ",["إنَّ أبي كانَ يصلُ الرَّحمَ ويفعلُ ويفعلُ",1]," ، فهل لَهُ في ذلكَ ، يعني من أجرٍ ؟ قالَ : ",["إنَّ أباكَ طلبَ أمرًا فأصابَهُ",2]],"grade":"صحيح","narrator":"عدي بن حاتم الطائي","muhaddith":"أسانيده صحاح","takhrij":"أخرجه أحمد (19386) بلفظه، وابن الجعد في ((مسنده)) (561)، والطحاوي في ((شرح مشكل الآثار)) (4360)، وابن حبان (332) مطولا، جميعا بلفظ مقارب .","bab":"رقائق وزهد › الرياء والسمعة","dorar":"CjrI7FD1"},{"id":"س-01994","fp":"59809410d724","stateId":548,"easy":"إذا عمل الكافر الخير ← فقد التمس أمراً فأصابه في الدنيا","cause":"إنَّ أبي كان يُطعِمُ المَساكينَ، ويُعتِقُ الرِّقابَ","result":"فإنَّ أباكَ كان يَلتَمِسُ أمرًا، فأصابَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01641","ref":"تخريج مشكل الآثار 4361","text":["قُلتُ للنبيِّ صَلَّى اللهُ عليه وسلَّمَ: ",["إنَّ أبي كان يُطعِمُ المَساكينَ، ويُعتِقُ الرِّقابَ",1],"، فهل له في ذلك مِن أجْرٍ؟ قال: ",["فإنَّ أباكَ كان يَلتَمِسُ أمرًا، فأصابَهُ",2],"."],"grade":"حسن","narrator":"عدي بن حاتم الطائي","muhaddith":"حسن","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (4361) واللفظ له، والطبراني (250) (17/ 104)، والطيالسي (1128) بنحوه، وأحمد (18262) بنحوه مطولًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"XEQCM07g"},{"id":"س-02612","fp":"5492a45002ef","stateId":549,"easy":"إذا لم تذكر اسم الله على الوضوء ← فلا وضوء لك","cause":"لِمَن لم يذكرِ اسمَ اللهِ عليه","result":"ولا وضوءَ","explicit":true,"star":true,"similar":["س-01390"],"ref":"مجمع الزوائد 1/233","srcLabel":"البخاري","text":["لم يؤمنْ باللهِ من لم يؤمنْ بي ولم يؤمنْ بي من لم يحبِّ الأنصارَ ولا صلاةَ لِمَن لا وضوءَ له ",["ولا وضوءَ",2]," ",["لِمَن لم يذكرِ اسمَ اللهِ عليه",1]],"grade":"صحيح","narrator":"جدة رباح بن عبدالرحمن بن حويطب","muhaddith":"فيه أبو ثفال قال البخاري في حديثه نظر وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (27146) واللفظ له، والدارقطني في ((العلل)) (4/436)، والحاكم (6899) باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"CNcOQheW"},{"id":"س-07237","fp":"7963ecd90e76","stateId":549,"easy":"إذا أحدثت ← لا تُقبل صلاتك حتى تتوضأ","cause":"مَن أحدَثَ حتَّى يَتَوضَّأَ","result":"لا تُقبَلُ صَلاةُ","explicit":true,"ref":"صحيح البخاري 135","srcLabel":"مسلم","text":[["لا تُقبَلُ صَلاةُ",2]," ",["مَن أحدَثَ حتَّى يَتَوضَّأَ",1],"، قال رَجُلٌ مِن حَضرَمَوتَ: ما الحَدَثُ يا أبا هُرَيرةَ؟ قال: فُساءٌ أو ضُراطٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (225)، وأبو داود (60)، وابن خزيمة (11) واللفظ لهم.","bab":"علم › سؤال العالم عما لا يعلم","dorar":"6yni4q9k","merged":2,"otherRefs":["صحيح ابن خزيمة 1/ 128 (صحيح)"]},{"id":"س-01377","fp":"ef0f8927310d","stateId":549,"easy":"إذا لم تسبغ الوضوء كما أمر الله ← لا تتم صلاتك","cause":"حتى يُسبِغَ الوُضوءَ كما أمَرَه اللهُ","result":"لا تَتِمُّ صَلاةُ أحدِكم","explicit":true,"similar":["س-06415"],"ref":"تخريج سنن الدارقطني 319","srcLabel":"أبو داود","text":["بيْنَما نحن جُلوسٌ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ -أو رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالسٌ ونحن حَولَه- إذ دخَلَ عليه رَجلٌ فاستقبَلَ القِبلةَ وصَلَّى، فلمَّا قَضى الصَّلاةَ جاء فسَلَّمَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وعلى القَومِ، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ارجِعْ فصَلِّ؛ فإنَّك لم تُصَلِّ، فجَعَلَ الرَّجُلُ يُصلِّي وجَعَلْنا نَرمُقُ صَلاتَه، لا نَدري ما يَعيبُ منها، فلمَّا صَلَّى جاء فسَلَّمَ على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وعلى القَومِ، فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: وعليك، ارجِعْ فصَلِّ؛ فإنَّك لم تُصَلِّ -قال هَمَّامٌ: فلا أدري أمَرَه بذلك مَرَّتَينِ أو ثَلاثًا-، فقال الرَّجلُ: ما ألَوتُ؛ فلا أدري ما عِبتَ عليَّ مِن صَلاتي، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها لا تَتِمُّ صَلاةُ أحدِكم ",["حتى يُسبِغَ الوُضوءَ كما أمَرَه اللهُ",1],"، فيَغسِلَ وَجهَه ويدَيه إلى المِرفَقَينِ، ويَمسَحَ برَأسِه ورِجلَيه إلى الكَعبَينِ، ثُمَّ يُكبِّرَ اللهَ عزَّ وجلَّ ويُثنيَ عليه، ثُمَّ يَقرَأَ أُمَّ القُرآنِ وما أُذِنَ له فيه وتَيَسَّرَ، ثُمَّ يُكبِّرَ فيَركَعَ فيَضَعَ كَفَّيه على رُكبتَيه حتى تَطمئِنَّ مَفاصِلُه وتَستَرخيَ، ويَقولَ: سمِعَ اللهُ لمَن حمِدَه، ويَستَويَ قائمًا حتى يُقيمَ صُلبَه ويَأخُذَ كلُّ عَظمٍ مَأخذَه، ثُمَّ يُكبِّرَ فيَسجُدَ فيُمَكِّنَ وَجهَه -قال هَمَّامٌ: وربَّما قال: جَبهَتَه- من الأرضِ حتى تَطمئِنَّ مَفاصِلُه وتَستَرخيَ، ثُمَّ يُكبِّرَ فيَستويَ قاعدًا على مَقعَدتِه ويُقيمَ صُلبَه، فوصَفَ الصَّلاةَ هكذا أربعَ رَكَعاتٍ حتى فرَغَ، ثُمَّ قال: ",["لا تَتِمُّ صَلاةُ أحدِكم",2]," حتى يَفعَلَ ذلك."],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه الدارمي (1368)، والدارقطني (319) واللفظ لهما، وأبو داود (857)، والترمذي (302)، والنسائي (1136) جميعا باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"ozXWq4VE","merged":7,"otherRefs":["المستدرك على الصحيحين 801 (صحيح)","خلاصة الأحكام للنووي 1/406 (صحيح)","صحيح النسائي 1135 (صحيح)","البحر الزخار 9/178 (حسن)","صحيح الترغيب 223 (صحيح)","صحيح الجامع 2420 (صحيح)"]},{"id":"س-01401","fp":"bc84d7f3b9a6","stateId":549,"easy":"إذا تركت موضع ظفر في الوضوء ← فارجع فأحسن وضوءك","cause":"توضَّأَ لصلاةِ الظُّهرِ ، فترَكَ مَوضعَ ظُفرٍ على ظَهْرِ قدمِهِ","result":"ارجِع فأحسِنْ وُضوءَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 1/90","srcLabel":"مسلم","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رأى رجلًا ",["توضَّأَ لصلاةِ الظُّهرِ ، فترَكَ مَوضعَ ظُفرٍ على ظَهْرِ قدمِهِ",1]," ، فأبصرَهُ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ : ",["ارجِع فأحسِنْ وُضوءَكَ",2]," فرجعَ فتوضَّأَ ، ثمَّ صلَّى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (243)، والبزار (232)، والبيهقي (329) واللفظ لهم.","bab":"وضوء › صفة الوضوء","dorar":"N2Y4w1MI","merged":3,"otherRefs":["صحيح ابن ماجه 545 (صحيح)","الأحاديث المختارة 2416 (صحيح)"]},{"id":"س-06425","fp":"d8ed693cf46a","stateId":549,"easy":"إذا لم تتطهر ← فلا صلاة لك","cause":"لمن لا طُهورَ لَهُ","result":"ولا صَلاةَ","explicit":true,"ref":"الترغيب والترهيب 1/261","srcLabel":"الطبراني","text":["لا إيمانَ لمن لا أمانةَ لَهُ ، ",["ولا صَلاةَ",2]," ",["لمن لا طُهورَ لَهُ",1]," ، ولا دينَ لمن لا صلاةَ لَهُ ، إنَّما موضِعُ الصَّلاةِ مِنَ الدِّينِ كموضعِ الرَّأسِ منَ الجسَدِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2292)، والمخلص في ((المخلصيات)) (2529)","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"hOTNaxzo","merged":3,"otherRefs":["مجمع الزوائد 1/233 (صحيح)","الترغيب والترهيب 1/264 (صحيح)"]},{"id":"س-06415","fp":"9c7a3269edc9","stateId":549,"easy":"إذا لم تضع الوضوء مواضعه ← لا تتم صلاتك","cause":"حتَّى يتوضَّأَ فيَضعَ الوضوءَ يعني مواضعَهُ","result":"إنَّهُ لا تتِمُّ صلاةٌ لأحَدٍ منَ النَّاسِ","explicit":true,"repOf":"س-01377","ref":"صحيح أبي داود 857","text":["أنَّ رجلًا دخلَ المسجدَ . . . فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ ",["إنَّهُ لا تتِمُّ صلاةٌ لأحَدٍ منَ النَّاسِ",2]," ",["حتَّى يتوضَّأَ فيَضعَ الوضوءَ يعني مواضعَهُ",1]," ثمَّ يُكَبِّرُ ويحمَدُ اللَّهَ جلَّ وعزَّ ويُثني علَيهِ ويَقرأُ بما تيسَّرَ منَ القرآنِ ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَركعُ حتَّى تطمَئنَّ مَفاصلُهُ ثمَّ يقولُ سمِعَ اللَّهُ لمن حمدَهُ حتَّى يَستويَ قائمًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجُدُ حتَّى تَطمِئنَّ مَفاصِلُهُ ثمَّ يقولُ اللَّهُ أَكْبرُ ويرفعُ رأسَهُ حتَّى يَستويَ قاعدًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجدُ حتَّى تَطمئنَّ مفاصلُهُ ثمَّ يرفعُ رأسَهُ فيُكَبِّرُ فإذا فعلَ ذلِكَ فقد تمَّت صلاتُهُ"],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (857) واللفظ له، والترمذي (302)، والنسائي (1136) بنحوه.","bab":"صلاة › التكبير عند كل خفض ورفع","dorar":"yz2RfaIg","merged":2,"otherRefs":["أعلام الموقعين 2/215 (صحيح)"]},{"id":"س-01390","fp":"44e30c30304e","stateId":549,"easy":"إذا لم تسمِّ على الوضوء ← فلا وضوء لك","cause":"لمَن لم يُسَمِّ","result":"لا وُضوءَ","explicit":true,"repOf":"س-02612","ref":"تنقيح التحقيق 1/179","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["لا وُضوءَ",2]," ",["لمَن لم يُسَمِّ",1],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"وضوء › التسمية للوضوء","dorar":"Sg37R8bu"},{"id":"س-03577","fp":"365eaea8a158","stateId":549,"easy":"إذا بقيت في قدمك لمعة لم يصبها الماء ← فأعد الوضوء والصلاة","cause":"رجلًا يصَلِّي وفي قَدَمِه لُمْعةٌ لم يُصِبْها الماءُ","result":"فأمره عليه السَّلامُ أن يُعيدَ الوُضوءَ والصَّلاةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المحلى 2/70","srcLabel":"أبو داود","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم رأى ",["رجلًا يصَلِّي وفي قَدَمِه لُمْعةٌ لم يُصِبْها الماءُ",1],"، ",["فأمره عليه السَّلامُ أن يُعيدَ الوُضوءَ والصَّلاةَ",2],"، [ورُوِيَ] من حديثِ أَنَسٍ بلَفظِ: ارجِعْ فأحسِنْ وُضوءَك."],"grade":"صحيح","narrator":"بعض أصحاب النبي صلى الله عليه وسلم","muhaddith":"صحيح من الطريقين كل منهما شاهد للآخر يقويه","takhrij":"أخرجه أبو داود (175)، وأحمد (15495) بلفظه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"YcSOS6Fv","merged":4,"otherRefs":["تخريج سنن الدارقطني 383 (صحيح)","مجموع الشروح الفقهية. 53/31 (صحيح)","مجموع الشروح الفقهية. 137/24 (حسن)"]},{"id":"س-01382","fp":"0f8e1e144d11","stateId":549,"easy":"إذا أتيت الصلاة بغير طهارة كاملة ← يلبّس الشيطان على المصلين","cause":"أقوامٍ يأتونَ الصَّلاةَ بغيرِ وُضوءٍ","result":"إنَّما لَبَّسَ علينا الشَّيطانُ القراءةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[34],"ref":"الزواجر عن اقتراف الكبائر 1/127","srcLabel":"أحمد","text":["أنَّهُ صلَّى اللَّهُ عليهِ وسلَّمَ قرأَ في صلاته بسورةِ الرُّومِ فلُبِّسَ بعضُها فقالَ: ",["إنَّما لَبَّسَ علينا الشَّيطانُ القراءةَ",2]," من أجلِ ",["أقوامٍ يأتونَ الصَّلاةَ بغيرِ وُضوءٍ",1],"، فإذا أتيتُمِ الصَّلاةَ فأحسِنوا الوضوءَ"],"grade":"صحيح","narrator":"[شبيب بن نعيم أبو روح الكلاعي]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15872) بلفظه، وابن أبي شيبة في ((مصنفه)) (34)، والمحاملي في ((أماليه)) (ص100) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"joLQVAHw"},{"id":"س-01385","fp":"dd3bdc68103a","stateId":549,"easy":"إذا تركت من رجلك موضع ظفر في الوضوء ← فأعد الوضوء والصلاة","cause":"يصَلِّي وقد تَرَك مِن رِجْلِه مَوضِعَ ظُفُرٍ","result":"فأمَرَه أن يعُيدَ الوُضوءَ والصَّلاةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المحلى 2/71","srcLabel":"ابن أبي شيبة","text":["عن عُمَرَ بنِ الخَطَّابِ أنَّه رأى رجلًا ",["يصَلِّي وقد تَرَك مِن رِجْلِه مَوضِعَ ظُفُرٍ",1],"، ",["فأمَرَه أن يعُيدَ الوُضوءَ والصَّلاةَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[له شاهد قوي مرفوع من طريق صحيحة]","takhrij":"أخرجه ابن أبي شيبة (457)، وابن حزم معلقا في ((المحلى)) (1/314) واللفظ له","bab":"وضوء › إسباغ الوضوء","dorar":"WGCncoZc"},{"id":"س-01425","fp":"5a9e786667de","stateId":549,"easy":"إذا صليت بغير طهور ← لا تُقبل صلاتك","cause":"إلا بطهورٍ وبالصلاةِ عليّ","result":"لا تُقبلُ صلاةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"عارضة الأحوذي 2/397","srcLabel":"الدارقطني","text":["لا صلاةَ إلا بطَهورٍ [يعني حديث: ",["لا تُقبلُ صلاةٌ",2]," ",["إلا بطهورٍ وبالصلاةِ عليّ",1],"]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"صحيح","takhrij":"أخرجه الدارقطني في ((سننه)) (1341)، والديلمي في ((الفردوس)) (7722) واللفظ لهم.","bab":"وضوء › فضل الوضوء","dorar":"HkM6JnvA"},{"id":"س-03651","fp":"cf9aced4b234","stateId":550,"easy":"إذا صليت صلاة لم تقرأ فيها بأم القرآن ← فهي خداج غير تمام","cause":"مَن صلَّى صلاةً لم يقرَأْ فيها بأُمِّ القرآنِ","result":"فهي خِداجٌ، فهي خِداجٌ، فهي خِداجٌ غيرُ تمامٍ","explicit":true,"star":true,"ref":"صحيح أبي داود 821","srcLabel":"مسلم","text":[["مَن صلَّى صلاةً لم يقرَأْ فيها بأُمِّ القرآنِ ",1],["فهي خِداجٌ، فهي خِداجٌ، فهي خِداجٌ غيرُ تمامٍ",2],"، قال: فقلتُ يا أبا هُريرةَ، إنِّي أكونُ أحيانًا وراءَ الإمامِ، قال: فغمَزَ ذِراعي، وقال: اقرأْ بها يا فارسيُّ في نفْسِك؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: قال اللهُ تعالى: قسَمْتُ الصَّلاةَ بَيْني وبينَ عبدي نصفَيْنِ؛ فنِصْفُها لي، ونِصْفُها لعبدي، ولِعبدي ما سألَ، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: اقرؤوا، يقولُ العبدُ: {الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ} [الفاتحة: 2]، يقولُ اللهُ عزَّ وجلَّ: حَمِدَني عبدي، يقولُ: {الرَّحْمَنِ الرَّحِيمِ} [الفاتحة: 3]، يقولُ اللهُ عزَّ وجلَّ: أثنى عليَّ عبدي، يقولُ العبدُ: {مَالِكِ يَوْمِ الدِّينِ} [الفاتحة: 4]، يقولُ اللهُ عزَّ وجلَّ: مجَّدَني عبدي، يقولُ العبدُ: {إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ} [الفاتحة: 5]، يقولُ اللهُ: وهذه بَيْني وبينَ عبدي، ولِعبدي ما سألَ، يقولُ العبدُ: {اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ (6) صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ} [الفاتحة: 6، 7]، يقولُ اللهُ: فهؤلاءِ لِعبدي، ولِعبدي ما سألَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (395)، وأبو داود (821) واللفظ له، والترمذي (2953)، والنسائي (909)، وابن ماجه (838)، وأحمد (7291)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"07Zj3UP5","merged":3,"otherRefs":["صحيح الجامع 4535 (صحيح)","صحيح مسلم 395 (صحيح)"]},{"id":"س-01372","fp":"d10f6542d2d9","stateId":550,"easy":"إذا انتقصت من صلاتك شيئاً ← فإنما تنتقص من صلاتك","cause":"وما انتَقَصتَ مِن هذا شيئًا","result":"فإنَّما انتقَصتَهُ مِن صلاتِكَ","explicit":true,"star":true,"similar":["س-06697"],"ref":"صحيح أبي داود 856","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- دخلَ المسجِدَ فدخلَ رجلٌ فصلَّى ثمَّ جاءَ فسلَّمَ علَى رسولِ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- فردَّ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- عليهِ السَّلامَ وقالَ ارجِع فصلِّ فإنَّكَ لم تُصلِّ فرجعَ الرَّجلُ فصلَّى كما كانَ صلَّى ثمَّ جاءَ إلى النَّبيِّ -صلَّى اللَّهُ علَيهِ وسلَّمَ- فسلَّمَ عليهِ فقالَ لهُ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- وعليكَ السَّلامُ ثمَّ قالَ ارجِع فصلِّ فإنَّكَ لم تصلِّ حتَّى فعلَ ذلِكَ ثلاثَ مِرارٍ فقالَ الرَّجلُ والَّذي بعثَكَ بالحقِّ ما أُحسِنُ غيرَ هذا فعلِّمني قالَ إذا قُمتَ إلى الصَّلاةِ فكبِّر ثمَّ اقرَأ ما تيسَّرَ معَكَ منَ القرآنِ ثمَّ اركَع حتَّى تطمئنَّ راكعًا ثمَّ ارفَع حتَّى تعتدلَ قائمًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا ثمَّ اجلِس حتَّى تَطمئنَّ جالسًا ثمَّ افعَل ذلِكَ في صلاتِكَ كُلِّها فإذا فعلتَ هذا فقد تمَّت صلاتُكَ ",["وما انتَقَصتَ مِن هذا شيئًا",1]," ",["فإنَّما انتقَصتَهُ مِن صلاتِكَ",2]," وقالَ فيهِ إذا قُمتَ إلى الصَّلاةِ فأسبِغ الوُضوءَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (856) واللفظ له، وأخرجه البخاري (6251)، ومسلم (397) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"mUZnJ0NE"},{"id":"س-06446","fp":"7caae9773136","stateId":550,"easy":"إذا صليت بلا قراءة ← فلا صلاة لك","cause":"إلَّا بِقِراءةٍ","result":"لا صَلاةَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8076","srcLabel":"متفق عليه","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَؤُمُّنا في الصَّلاةِ، فيَجهَرُ ويُخافِتُ، فجهَرْنا فيما جهَرَ فيه، وخافَتْنا فيما خافَتَ فيه، وسمِعْتُه يَقولُ: ",["لا صَلاةَ",2]," ",["إلَّا بِقِراءةٍ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (772)، ومسلم (396)، وأحمد (8076) واللفظ له","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"VxvUOtqK"},{"id":"س-06449","fp":"f2014f198903","stateId":550,"easy":"إذا صليت بلا أم القرآن ← فهي خداج (ناقصة)","cause":"مَن صلَّى صلاةً لَمْ يقرَأْ فيها بأُمِّ القُرآنِ","result":"فهي خِداجٌ قُلْتُ : يا أبا هُرَيْرَةَ إنِّي أحيانًا أكونُ وراءَ الإمامِ قال : يا ابنَ الفارسيِّ اقرَأْ بها في نفسِكَ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم","explicit":true,"similar":["س-06681"],"ref":"تخريج صحيح ابن حبان 1795","srcLabel":"مسلم","text":[["مَن صلَّى صلاةً لَمْ يقرَأْ فيها بأُمِّ القُرآنِ ",1],["فهي خِداجٌ ) قُلْتُ : يا أبا هُرَيْرَةَ إنِّي أحيانًا أكونُ وراءَ الإمامِ قال : يا ابنَ الفارسيِّ اقرَأْ بها في نفسِكَ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم",2]," يقولُ : ( قال اللهُ تبارَك وتعالى : قسَمْتُ الصَّلاةَ بَيْني وبَيْنَ عبدي نِصفَيْنِ فنِصفُها لي ونِصفُها لِعبدي ولِعبدي ما شاء يقومُ عبدي فيقولُ : { الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ } يقولُ اللهُ : حمِدني عبدي فيقولُ : { الرَّحْمَنِ الرَّحِيمِ } فيقولُ اللهُ : أثنى علَيَّ عبدي فيقولُ : { مَالِكِ يَوْمِ الدِّينِ } فيقولُ : مجَّدني عبدي فهذا بَيْني وبَيْن عبدي { إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ } إلى آخِرِ السُّورةِ - فهؤلاءِ لِعبدي ولِعبدي ما سأَل )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (395) باختلاف يسير دون قوله: \"يا ابن الفارسي\"","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"3PeeMHvS"},{"id":"س-06681","fp":"11c0a9b5f584","stateId":550,"easy":"إذا صليت بلا قراءة ← فهي خداج","cause":"كلُّ صلاةٍ ليست فيها قراءةٌ","result":"فهي خِداجٌ","explicit":true,"repOf":"س-06449","ref":"معجم الشيوخ 2/691","text":[["كلُّ صلاةٍ ليست فيها قراءةٌ",1]," ",["فهي خِداجٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه مسلم (395) باختلاف يسير","bab":"صلاة الجماعة والإمامة › الإمام","dorar":"36VlejPM"},{"id":"س-06697","fp":"88e71592adc3","stateId":550,"easy":"إذا انتقصت من صلاتك شيئاً ← فإنما تنقصه من صلاتك","cause":"وما انتقصتَ من ذلِكَ","result":"فإنَّما تنقصُهُ من صلاتِكَ","explicit":true,"repOf":"س-01372","ref":"مختصر الصواعق المرسلة 610","text":["أحاديثُ فرضِ الطُّمأنينةِ [حديث أبي هريرة: أنَّ رَجُلًا دَخَلَ المَسْجِدَ فَصَلَّى، ورَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ في نَاحِيَةِ المَسْجِدِ، فَجَاءَ فَسَلَّمَ عليه، فَقَالَ له: ارْجِعْ فَصَلِّ فإنَّكَ لَمْ تُصَلِّ فَرَجَعَ فَصَلَّى ثُمَّ سَلَّمَ، فَقَالَ: وعَلَيْكَ، ارْجِعْ فَصَلِّ فإنَّكَ لَمْ تُصَلِّ قَالَ في الثَّالِثَةِ: فأعْلِمْنِي، قَالَ: إذَا قُمْتَ إلى الصَّلَاةِ، فأسْبِغِ الوُضُوءَ، ثُمَّ اسْتَقْبِلِ القِبْلَةَ، فَكَبِّرْ واقْرَأْ بما تَيَسَّرَ معكَ مِنَ القُرْآنِ، ثُمَّ ارْكَعْ حتَّى تَطْمَئِنَّ رَاكِعًا، ثُمَّ ارْفَعْ رَأْسَكَ حتَّى تَعْتَدِلَ قَائِمًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ وتَطْمَئِنَّ جَالِسًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ قَائِمًا، ثُمَّ افْعَلْ ذلكَ في صَلَاتِكَ كُلِّهَا.] [وحديث رفاعة بن رافع:كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ إذ دخلَ رجلٌ المسجدَ فصلَّى ورسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ يرمقُهُ ولا يشعرُ ثمَّ انصرفَ فأتى رسولَ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ فسلَّمَ عليْهِ فردَّ عليْهِ السَّلامَ ثمَّ قالَ ارجع فصَلِّ فإنَّكَ لم تُصلِّ قالَ لا أدري في الثَّانيةِ أو في الثَّالثةِ قالَ والَّذي أنزلَ عليْكَ الْكتابَ لقد جَهِدتُ فعلِّمني وأرِني قالَ إذا أردتَ الصَّلاةَ فتوضَّأ فأحسنِ الوضوءَ ثمَّ قم فاستقبلِ القبلةَ ثمَّ كبِّر ثمَّ اقرأ ثمَّ ارْكع حتَّى تطمئنَّ راكعًا ثمَّ ارفَع حتَّى تعتدلَ قائمًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا ثمَّ ارفع رأسَكَ حتَّى تطمئنَّ قاعدًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا فإذا صنعتَ ذلِكَ فقد قضَيتَ صلاتَكَ ",["وما انتقصتَ من ذلِكَ",1]," ",["فإنَّما تنقصُهُ من صلاتِكَ",2],"]"],"grade":"صحيح","narrator":"[أبو هريرة ورفاعة بن رافع]","muhaddith":"رواية صحيحة","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"ZWo1inuD","merged":7,"otherRefs":["تخريج المسند لشعيب 18997 (صحيح)","صحيح الجامع 740 (صحيح)","صحيح الترمذي 302 (صحيح)","صحيح النسائي 1313 (صحيح)","نخب الافكار 4/232 (صحيح)","نصب الراية 1/378 (صحيح)"]},{"id":"س-00576","fp":"41104d47a060","stateId":550,"easy":"إذا نقرت صلاتك ← لو مت مت على غير الفطرة (أثر حذيفة)","cause":"رجُلًا عندَ أبوابِ كِنْدَةَ ينقُرُ","result":"لو مِتَّ مِتَّ على غيرِ الفِطرةِ الَّتي فُطِر عليها مُحمَّدٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[64],"ref":"تخريج صحيح ابن حبان 1894","srcLabel":"البخاري","text":["رأى حُذيفةُ ",["رجُلًا عندَ أبوابِ كِنْدَةَ ينقُرُ",1]," فقال : مُذْ كم صلَّيْتَ هذه الصَّلاةَ ؟ قال : منذُ أربعينَ سَنةً قال : ",["لو مِتَّ مِتَّ على غيرِ الفِطرةِ الَّتي فُطِر عليها مُحمَّدٌ",2]," صلَّى اللهُ عليه وسلَّم إنَّ الرَّجُلَ لَيُخفِّفُ ويُتِمُّ الرُّكوعَ والسُّجودَ"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (1894) واللفظ له، والنسائي (1312) بنحوه، والبخاري (389) بمعناه مختصرا","bab":"آداب عامة › ضرب الأمثال","dorar":"Bco7NT98"},{"id":"س-01838","fp":"16457a1c9b6b","stateId":550,"easy":"إذا طففت في صلاتك ← فكأنك لم تصلّ، ولو مت عليها مت على غير الفطرة","cause":"يصلِّي فطفَّفَ","result":"ما صلَّيتَ منذُ أربعينَ سنةً ، ولو متَّ وأنتَ تصلِّي هذِهِ الصَّلاةَ لمتَّ على غيرِ فطرةِ محمَّدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[64],"ref":"صحيح النسائي 1311","srcLabel":"البخاري","text":["أنَّهُ رأى رجلاً ",["يصلِّي فطفَّفَ",1]," ، فقالَ لَهُ حذيفةُ : منذُ كم تصلِّي هذِهِ الصَّلاةَ ؟ قالَ : منذُ أربعينَ عامًا ، قالَ : ",["ما صلَّيتَ منذُ أربعينَ سنةً ، ولو متَّ وأنتَ تصلِّي هذِهِ الصَّلاةَ لمتَّ على غيرِ فطرةِ محمَّدٍ",2]," صلَّى اللَّهُ عليْهِ وسلَّمَ ثمَّ قالَ : إنَّ الرَّجلَ ليخففُّ ، ويتمُّ ويحسن."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (1312) واللفظ له، وأحمد (23258) بنحوه، والبخاري (389) بنحوه مختصرا","bab":"إحسان › إبطال الأعمال","dorar":"FtaU8d1I"},{"id":"س-06458","fp":"4131ea88c5cd","stateId":550,"easy":"إذا لم تقرأ بالفاتحة ← فلا صلاة لك","cause":"لمَن لم يَقرَأْ بها","result":"فإنَّه لا صَلاةَ","explicit":true,"similar":["س-06414"],"ref":"القراءة خلف الإمام 121","srcLabel":"أبو داود","text":["عن نافِعِ بنِ مَحمودِ بنِ الرَّبيعِ الأنصاريِّ، قال: كُنتُ أغدو إلى المَسجِدِ مَعَ عُبادةَ بنِ الصَّامِتِ فأبطَأَ عُبادةُ ذاتَ يَومٍ، قال: فجِئنا وأبو نُعَيمٍ يُصَلِّي بالنَّاسِ الصُّبحَ، قال: فصَفَفنا خَلفَه، فسَمِعتُ عُبادةَ يَقرَأُ بفاتِحةِ الكِتابِ، فلمَّا انصَرَف أبو نُعَيمٍ قُلتُ: يا أبا الوليدِ، رَأيتُك تَقرَأُ مَعَ الإمامِ ولا أدري تَعَمَّدتَه أم سَهَوتَ، قال: لم أنسَه ولكِنْ تَعَمَّدتُه، صَلَّى بنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بَعضَ الصَّلواتِ التي يَجهَرُ فيها بالقِراءةِ، قال: فالتَبَسَت عليه القِراءةُ، فلمَّا انصَرَف قال: \"هَل تقرؤون مَعي؟ قالوا: نَعَم، قال: لا تَفعَلوا إلَّا بأُمِّ القُرآنِ؛ ",["فإنَّه لا صَلاةَ",2]," ",["لمَن لم يَقرَأْ بها",1],"\""],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (823)، والترمذي (311)، وابن خزيمة (1581) بنحوه.","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"fbQRsEbK","merged":3,"otherRefs":["مجموع فتاوى ابن باز 223/11 (صحيح)","نتائج الأفكار 1/425 (حسن)"]},{"id":"س-01379","fp":"9e1d61ebd0f8","stateId":550,"easy":"إذا لم تطمئن في ركوعك ← لا تتم صلاتك","cause":"ثمَّ يُكبِّرُ، فيَركَعُ، ويَضَعُ كَفَّيهِ على رُكبَتَيهِ حتَّى تَطمَئنَّ مَفاصِلُه ويَستَوِيَ، ثمَّ يَقولُ: سَمِعَ اللهُ لِمَن حَمِدَه، ويَستَوي قائمًا حتَّى يَأخُذَ كلُّ عَظمٍ مَأْخَذَه، ثمَّ يُقيمُ صُلبَهُ، ثمَّ يُكبِّرُ فيَسجُدُ فيُمَكِّنُ جَبهَتَه منَ الأرضِ حتَّى تَطمَئنَّ مَفاصِلُه ويَستوِيَ، ثمَّ يُكبِّرُ فيَرفَعُ رَأسَهُ، ويَستَوي قاعِدًا على مَقعَدَتِه ويُقيمُ صُلبَه","result":"لا تَتِمُّ صَلاةُ أحَدِكُم حتَّى يَفعَلَ ذلكَ","explicit":true,"similar":["س-01395"],"ref":"المستدرك على الصحيحين 801","srcLabel":"البيهقي","text":["عنْ رِفاعةَ بنِ رافِعٍ: أنَّه كان جالِسًا عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، إذ جاء رَجُلٌ فدَخَل المَسجِدَ فصَلَّى، فلمَّا قَضى صَلاتَه جاء فسَلَّم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وعلى القَومِ، فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وعَلَيكَ، ارجِعْ فصَلِّ فإنَّكَ لم تُصَلِّ قالَ: فرَجَع فصَلَّى، فجَعَلْنا نَرمُقُ صَلاتَه لا نَدري ما يَعيبُ منها، فلمَّا قَضى صَلاتَه جاء فسَلَّم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وعلى القَومِ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وعَلَيكَ، ارجِعْ فصَلِّ فإنَّكَ لم تُصَلِّ وذَكَر ذلكَ إمَّا مَرَّتَينِ وإمَّا ثَلاثةً، فقالَ الرَّجُلُ: ما أدري ما عِبتَ عَلَيَّ من صَلاتي، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها لا تَتِمُّ صَلاةُ أحَدِكُم حتَّى يُسبِغَ الوُضوءَ كما أمَرَه اللهُ عزَّ وجلَّ؛ يَغسِلُ وَجهَهُ ويَدَيهِ إلى المِرفَقَينِ، ويَمسَحُ رَأسَهُ ورِجلَيهِ إلى الكَعبَينِ، ثمَّ يُكبِّرُ ويَحمَدُ اللهَ ويُمَجِّده، ويَقرَأُ منَ القُرآنِ ما أَذِنَ اللهُ له فيه، ",["ثمَّ يُكبِّرُ، فيَركَعُ، ويَضَعُ كَفَّيهِ على رُكبَتَيهِ حتَّى تَطمَئنَّ مَفاصِلُه ويَستَوِيَ، ثمَّ يَقولُ: سَمِعَ اللهُ لِمَن حَمِدَه، ويَستَوي قائمًا حتَّى يَأخُذَ كلُّ عَظمٍ مَأْخَذَه، ثمَّ يُقيمُ صُلبَهُ، ثمَّ يُكبِّرُ فيَسجُدُ فيُمَكِّنُ جَبهَتَه منَ الأرضِ حتَّى تَطمَئنَّ مَفاصِلُه ويَستوِيَ، ثمَّ يُكبِّرُ فيَرفَعُ رَأسَهُ، ويَستَوي قاعِدًا على مَقعَدَتِه ويُقيمُ صُلبَه",1]," فوَصَف الصَّلاةَ هكذا حتَّى فَرَغ، ثمَّ قالَ: ",["لا تَتِمُّ صَلاةُ أحَدِكُم حتَّى يَفعَلَ ذلكَ",2],"."],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن الجارود (217)، والبيهقي (3914) بلفظه.","bab":"وضوء › إسباغ الوضوء","dorar":"3DKG1jgw","merged":2,"otherRefs":["صحيح الجامع 2420 (صحيح)"]},{"id":"س-01395","fp":"d7de0278eb71","stateId":550,"easy":"إذا لم تطمئن في الركوع والرفع منه ← لم تتم صلاتك","cause":"ثمَّ يُكبِّرَ ويرْكعَ حتَّى تطمئنَّ مفاصلُهُ وتسترخيَ ثمَّ يقولَ سمعَ اللَّهُ لمن حمدَهُ ثمَّ يستويَ قائمًا حتَّى يقيمَ صلبَهُ ثمَّ يُكبِّرَ ويسجدَ حتَّى يمَكِّنَ وجْهَهُ وقد سمعتُهُ يقولُ جبْهتَهُ حتَّى تطمئنَّ مفاصلُهُ وتسترخيَ ويُكبِّرَ فيرفعَ حتَّى يستويَ قاعدًا على مقعدتِهِ ويقيمَ صلبَهُ ثمَّ يُكبِّرَ فيسجدَ حتَّى يمَكِّنَ وجْهَهُ ويسترخيَ","result":"فإذا لم يفعل هَكذا لم تتمَّ صلاتُهُ","explicit":true,"repOf":"س-01379","ref":"صحيح النسائي 1135","text":["بينما رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ جالسٌ ونحنُ حولَهُ إذ دخلَ رجلٌ فأتى القبلةَ فصلَّى فلمَّا قضى صلاتَهُ جاءَ فسلَّمَ على رسولِ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ وعلى القومِ فقالَ لَهُ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ وعليْكَ اذْهب فصلِّ فإنَّكَ لم تصلِّ فذَهبَ فصلَّى فجعلَ رسولُ اللَّهِ يرمقُ صلاتَهُ ولا يدري ما يعيبُ منْها فلمَّا قضى صلاتَهُ جاءَ فسلَّمَ على رسولِ اللَّهِ وعلى القومِ فقالَ لَهُ رسولُ اللَّهِ وعليْكَ اذْهب فصلِّ فإنَّكَ لم تصلِّ فأعادَها مرَّتينِ أو ثلاثًا فقالَ الرَّجلُ يا رسولَ اللَّهِ ما عبتَ من صلاتي فقالَ رسولُ اللَّهِ إنَّها لَم تتمَّ صلاةُ أحدِكم حتَّى يسبغَ الوضوءَ كما أمرَهُ اللَّهُ عزَّ وجلَّ فيغسلَ وجْهَهُ ويديْهِ إلى المرفقينِ ويمسحَ برأسِهِ ورجليْهِ إلى الْكعبينِ ثمَّ يُكبِّرَ اللَّهَ عزَّ وجلَّ ويحمدَهُ ويمجِّدَهُ ـ قالَ همَّامٌ وسمعتُهُ يقولُ ويحمدَ اللَّهَ ويمجِّدَهُ ويُكبِّرَهُ قالَ فَكلاهما قد سمعتُهُ يقولُ ـ قالَ ويقرأَ ما تيسَّرَ منَ القرآنِ مِمَّا علَّمَهُ اللَّهُ وأذنَ لَهُ فيهِ ",["ثمَّ يُكبِّرَ ويرْكعَ حتَّى تطمئنَّ مفاصلُهُ وتسترخيَ ثمَّ يقولَ سمعَ اللَّهُ لمن حمدَهُ ثمَّ يستويَ قائمًا حتَّى يقيمَ صلبَهُ ثمَّ يُكبِّرَ ويسجدَ حتَّى يمَكِّنَ وجْهَهُ وقد سمعتُهُ يقولُ جبْهتَهُ حتَّى تطمئنَّ مفاصلُهُ وتسترخيَ ويُكبِّرَ فيرفعَ حتَّى يستويَ قاعدًا على مقعدتِهِ ويقيمَ صلبَهُ ثمَّ يُكبِّرَ فيسجدَ حتَّى يمَكِّنَ وجْهَهُ ويسترخيَ",1]," ",["فإذا لم يفعل هَكذا لم تتمَّ صلاتُهُ",2]],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (858، 859)، والترمذي (302)، والنسائي (1136) واللفظ له، وابن ماجه (460) مختصراً، وأحمد (19017)","bab":"وضوء › صفة الوضوء","dorar":"dFsG9DTp","merged":2,"otherRefs":["البحر الزخار 9/178 (حسن)"]},{"id":"س-02358","fp":"b9dd527d18ff","stateId":550,"easy":"إذا لم تُقم صلبك في الركوع والسجود ← فلا صلاة لك","cause":"لمن لا يقيمُ صلبَهُ في الرُّكوعِ والسُّجودِ","result":"لا صلاةَ","explicit":true,"similar":["س-06701"],"ref":"صحيح ابن ماجه 718","srcLabel":"ابن ماجه","text":["خرَجنا حتى قدِمنا على رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فبايَعناهُ وصلَّينا خلفَهُ ، فلَمحَ بمؤخَّرِ عينِهِ رجلًا ، لا يقيمُ صلاتَهُ ، - يعني صلبَهُ - في الرُّكوعِ والسُّجودِ ، فلمَّا قضى النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ الصَّلاةَ ، قالَ : يا معشرَ المسلِمينَ ",["لا صلاةَ",2]," ",["لمن لا يقيمُ صلبَهُ في الرُّكوعِ والسُّجودِ",1]],"grade":"صحيح","narrator":"علي بن شيبان","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (871)، وأحمد (16297)، وابن حبان (1891) جميعهم باختلاف يسير.","bab":"إسلام › البيعة على الإسلام","dorar":"q4CBGp8R","merged":2,"otherRefs":["تخريج مشكل الآثار 3901 (صحيح)"]},{"id":"س-06455","fp":"6e3113059e86","stateId":550,"easy":"إذا لم تقرأ فيها بفاتحة الكتاب ← لا تجزئ صلاتك","cause":"لا يُقرأُ فيها بفاتحةِ الكتابِ","result":"لا يجزئُ صلاةٌ","explicit":true,"ref":"كشف المناهج والتناقيح 1/347","srcLabel":"ابن حبان","text":[["لا يجزئُ صلاةٌ",2]," ",["لا يُقرأُ فيها بفاتحةِ الكتابِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن خزيمة (490)، وابن حبان (1789)، وابن المنذر في ((الأوسط)) (1294) بلفظه.","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"iXlot5ag","merged":2,"otherRefs":["الخلافيات للبيهقي 1951 (حسن)"]},{"id":"س-06548","fp":"e1f999da1334","stateId":550,"easy":"إذا لم تقرأ بالفاتحة ← فصلاتك خداج","cause":"فمَن لم يَفعَلْ ذلك","result":"كَذا وكَذا، يَعْني خِداج","explicit":true,"ref":"الأحكام الوسطى 1/ 359","srcLabel":"الترمذي","text":["الصَّلاةُ مَثْنى مَثْنى، تَشَهَّدُ في كلَّ رَكْعتَينِ، وتَضَرَّعُ، وتَخشَّعُ، وتَمَسْكَنُ، وتُقنِعُ يَدَيك -يقول: تَرفَعُهما إلى رَبِّك- مُسْتقبِلًا ببُطونِهما وَجْهَك، وتَقولُ: يا رَبِّ يا رَبِّ، ",["فمَن لم يَفعَلْ ذلك",1]," ",["كَذا وكَذا، يَعْني خِداج",2],"."],"grade":"صحيح","narrator":"الفضل بن عباس","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (385)، واللفظ له وأحمد (1799)، والبزار (2169) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"YguQKqjA","merged":2,"otherRefs":["الجامع الصغير 5073 (حسن)"]},{"id":"س-06837","fp":"e0174f49229d","stateId":550,"easy":"إذا لم تقم صلبك بين ركوعك وسجودك ← لا ينظر الله إلى صلاتك","cause":"صلاةِ عبدٍ لا يُقيمُ فيها صُلبَه بين ركوعِها وسجودِها","result":"لا يَنْظُرُ اللهُ – عز وجل – إلى","explicit":true,"similar":["س-06452"],"otherNeedIds":[28],"ref":"هداية الرواة 865","srcLabel":"أحمد","text":["قال رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّم - ",["لا يَنْظُرُ اللهُ – عز وجل – إلى",2]," ",["صلاةِ عبدٍ لا يُقيمُ فيها صُلبَه بين ركوعِها وسجودِها",1]],"grade":"صحيح","narrator":"طلق بن علي الحنفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16283) بلفظه، والطبراني في ((المعجم الكبير)) (8/ 338) (8261) وابن قانع في ((معجم الصحابة)) (2/ 40) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"XXUhcTYB","merged":2,"otherRefs":["تخريج الإحياء للعراقي 1/202 (صحيح)"]},{"id":"س-06414","fp":"2cd0163c9139","stateId":550,"easy":"إذا لم تقرأ بالحمد وسورة ← فلا صلاة لك","cause":"لمن لَم يَقرأ بالحمدُ وسورةٍ ، في فريضةٍ أو غيرِها","result":"ولا صلاةَ","explicit":true,"repOf":"س-06458","ref":"صحيح الترمذي 238","text":["مِفتاحُ الصَّلاةِ الطُّهورُ ، وتحريمُها التَّكبيرُ ، وتحليلُها التَّسليمُ ، ",["ولا صلاةَ",2]," ",["لمن لَم يَقرأ بالحمدُ وسورةٍ ، في فريضةٍ أو غيرِها",1]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (238) واللفظ له، وابن ماجه (276) مختصراً","bab":"صلاة › التسليم وكيفياته وما يتعلق به","dorar":"Dlh6Y0fZ"},{"id":"س-06452","fp":"da5a125905db","stateId":550,"easy":"إذا لم تُقم ظهرك في الركوع والسجود ← لا تجزئ صلاتك","cause":"لا يُقيمُ فيها ظَهْرَهُ في الرُّكوعِ والسُّجودِ","result":"لا تُجزِئُ صَلاةٌ لأحَدٍ","explicit":true,"repOf":"س-06837","ref":"تخريج المسند لشعيب 17105","text":["حدَّثَنا وَكيعٌ، عن سُفْيانَ، عن سَلَمةَ بنِ كُهَيلٍ، نَحوَه. [أي نَحوَ حَديثِ: ",["لا تُجزِئُ صَلاةٌ لأحَدٍ",2]," ",["لا يُقيمُ فيها ظَهْرَهُ في الرُّكوعِ والسُّجودِ",1],"]"],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (855)، والترمذي (265)، والنسائي (1027)، وأحمد (17105) واللفظ له","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"ZGCd2RsJ"},{"id":"س-06519","fp":"1c34c703fdd4","stateId":550,"easy":"إذا أسأت الصلاة فلم تتم ركوعها وسجودها ← تقول: ضيعك الله كما ضيعتني وتُلف ويُضرب بها وجهك","cause":"وإذا أساءَ الصلاةَ ، فلمْ يُتِمَّ ركوعَها وسجودَها","result":"قالت الصلاةُ: ضيَّعَكَ اللهُ كما ضيعتَني: فَتُلَفُّ كمَا يُلَفُّ الثوبُ الخَلَقُ فيضربُ بها وجهُهُ","explicit":true,"ref":"الجامع الصغير 363","srcLabel":"الطبراني","text":["إذا أحسنَ الرجلُ الصلاةَ فأتمَّ ركوعَها وسجودَها قالتْ الصلاةُ: حفِظَكَ اللهُ كما حفظْتَنِي ، فتُرفعُ ، ",["وإذا أساءَ الصلاةَ ، فلمْ يُتِمَّ ركوعَها وسجودَها",1]," ، ",["قالت الصلاةُ: ضيَّعَكَ اللهُ كما ضيعتَني: فَتُلَفُّ كمَا يُلَفُّ الثوبُ الخَلَقُ فيضربُ بها وجهُهُ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (586) واللفظ له، والطبراني كما في ((مجمع الزوائد)) للهيثمي (2/125)، والبيهقي في ((شعب الإيمان)) (3140) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"TX692F6L"},{"id":"س-06701","fp":"772fb2e49d8d","stateId":550,"easy":"إذا لم تقم صلبك في الركوع والسجود ← فلا صلاة لك","cause":"رَجُلٍ لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ","result":"إنَّه لا صَلاةَ لِمَن لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02358","ref":"الصحيح المسند 981","text":["عن علِيِّ بنِ شَيْبانَ: أنَّه خَرَجَ وافِدًا إلى رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: فصَلَّيْنا خَلْفَ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فلَمَحَ بمُؤْخِرِ عَيْنيه إلى ",["رَجُلٍ لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ",1],"، فلمَّا انْصَرَفَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «يا مَعشَرَ المُسلِمينَ، ",["إنَّه لا صَلاةَ لِمَن لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ",2],"»، قالَ: ورأى رَجُلًا يُصَلِّي خَلْفَ الصَّفِّ، فوَقَفَ حتَّى انْصَرَفَ الرَّجُلُ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: «اسْتَقبِلْ صَلاتَك، فلا صَلاةَ لرَجُلٍ فَرْدٍ خَلْفَ الصَّفِّ».\nقالَ عَبْدُ الصَّمَدِ: «فَرْدًا خَلْفَ الصَّفِّ»."],"grade":"صحيح","narrator":"علي بن شيبان","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16297)، وابن أبي شيبة (2957)، وابن خزيمة (593) واللفظ لهم.","bab":"صلاة الجماعة والإمامة › صلاة الفذ وحده خلف الصف","dorar":"62FTg3lR","merged":2,"otherRefs":["المهذب في اختصار السنن 2/1036 (حسن)"]},{"id":"س-05055","fp":"b79985919d05","stateId":550,"easy":"إذا لم تلصق أنفك مع جبهتك بالأرض في السجود ← لم تجز صلاتك","cause":"منْ لم يلزِقْ أنفَه مع جبهتهِ بالأرضِ إذا سجد","result":"لم تجُزْ صلاتُه","explicit":true,"ref":"أصل صفة الصلاة 2/734","srcLabel":"الطبراني","text":[["منْ لم يلزِقْ أنفَه مع جبهتهِ بالأرضِ إذا سجد ",1],["لم تجُزْ صلاتُه",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن لا بأس به في المتابعات","takhrij":"أخرجه الطبراني (11/333) (11917) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/98)، وابن الجوزي في ((العلل المتناهية)) (745)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RjWbtPtr"},{"id":"س-00503","fp":"761efd19fa81","stateId":550,"easy":"إذا نقرت في سجودك ← فمثلك كالجائع يأكل التمرة والتمرتين لا تغنيان عنه","cause":"ينقرْ في سجودِه","result":"فإنَّما مثلُ ذلك كمثلِ الجائعِ ، يأكلُ التمرةَ والتمرتينِ ، فماذا يُغنيانِ عنه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 649","srcLabel":"الطبراني","text":["إذا صلَّى أحدُكم فلْيتمَّ ركوعَه ، و لا ",["ينقرْ في سجودِه",1]," ، ",["فإنَّما مثلُ ذلك كمثلِ الجائعِ ، يأكلُ التمرةَ والتمرتينِ ، فماذا يُغنيانِ عنه",2]," ؟"],"grade":"حسن","narrator":"أبو عبدالله الأشعري","muhaddith":"حسن","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (635)، وأبو الشيخ في ((أمثال الحديث)) (278)، والطبراني في ((مسند الشاميين)) (1624) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"xfpU2iBD"},{"id":"س-02513","fp":"ec2817908374","stateId":551,"easy":"إذا التفتّ في الصلاة ← فهو اختلاس يختلسه الشيطان من صلاتك","cause":"التِفاتِ الرَّجُلِ في الصَّلاةِ","result":"هوَ اختلاسٌ يختَلِسُهُ الشَّيطانُ مِن صلاةِ العَبدِ","explicit":true,"star":true,"otherNeedIds":[34],"ref":"صحيح ابن خزيمة 2/ 135","srcLabel":"البخاري","text":["سأَلتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عنِ ",["التِفاتِ الرَّجُلِ في الصَّلاةِ",1],"، فقالَ: ",["هوَ اختلاسٌ يختَلِسُهُ الشَّيطانُ مِن صلاةِ العَبدِ",2]," [وفي روايةٍ:] عنِ الالتِفاتِ في الصَّلاةِ"],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (718)، وأبو داود (910)، والترمذي (590) بلفظه","bab":"إيمان › أعمال الجن والشياطين","dorar":"WH83kil5"},{"id":"س-06694","fp":"635ccfbbf54c","stateId":551,"easy":"إذا صليت في ثوب له أعلام ← تلهيك عن صلاتك","cause":"في خَميصةٍ له لَها أعلامٌ، فنَظَرَ إلى أعلامِها نَظرةً","result":"فإنَّها ألهَتني آنِفًا عن صَلاتي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح البخاري 5817","srcLabel":"متفق عليه","text":["صَلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["في خَميصةٍ له لَها أعلامٌ، فنَظَرَ إلى أعلامِها نَظرةً",1],"، فلَمَّا سَلَّمَ قال: اذهَبوا بخَميصَتي هذه إلى أبي جَهمٍ؛ ",["فإنَّها ألهَتني آنِفًا عن صَلاتي",2],"، وأْتوني بأنبِجانيَّةِ أبي جَهمِ بنِ حُذَيفةَ بنِ غانِمٍ، مِن بَني عَديِّ بنِ كَعبٍ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5817)، ومسلم (556)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"tt99dM5S","merged":5,"otherRefs":["صحيح مسلم 556 (صحيح)","تخريج صحيح ابن حبان 2337 (صحيح)","صحيح النسائي 770 (صحيح)"]},{"id":"س-06528","fp":"d7680efcc1b5","stateId":551,"easy":"إذا صليت بلا حضور ← قد لا يُكتب لك منها إلا عشرها أو أقل","cause":"إنَّ العَبدَ لَيُصَلِّي الصَّلاةَ ما","result":"يُكتَبُ له منها إلَّا عُشرُها، تُسْعُها، ثُمُنُها، سُبُعُها، سُدُسُها، خُمُسُها، رُبُعُها، ثُلُثُها، نِصفُها","explicit":true,"ref":"تخريج المسند لشعيب 18894","srcLabel":"النسائي","text":["رَأيتُ عمَّارَ بنَ ياسِرٍ دخَلَ المَسجِدَ فصلَّى، فأخَفَّ الصَّلاةَ، قال: فلمَّا خرَجَ قُمتُ إليه، فقُلتُ: يا أبا اليَقظانِ، لقد خفَّفتَ. قال: فهل رَأيتَني انتَقَصتُ مِن حُدودِها شَيئًا؟ قُلتُ: لا. قال: فإنِّي بادَرتُ بها سَهوةَ الشَّيطانِ، سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إنَّ العَبدَ لَيُصَلِّي الصَّلاةَ ما ",1],["يُكتَبُ له منها إلَّا عُشرُها، تُسْعُها، ثُمُنُها، سُبُعُها، سُدُسُها، خُمُسُها، رُبُعُها، ثُلُثُها، نِصفُها",2],"."],"grade":"صحيح","narrator":"عمار بن ياسر","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (611)، وأحمد (18894) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"24qimRuw","merged":8,"otherRefs":["تخريج الإحياء للعراقي 1/233 (صحيح)","الإيمان لابن تيمية 28 (حسن)","تحفة المحتاج 1/332 (صحيح)","تخريج المسند لشعيب 18879 (صحيح)","فيض القدير 2/ 334 (صحيح)","الفروع لابن مفلح 2/ 293 (حسن)","تخريج مشكل الآثار 1103 (صحيح)"]},{"id":"س-01832","fp":"d46cdf85e085","stateId":551,"easy":"إذا التفتّ في صلاتك ← فلا صلاة لمتلفت","cause":"لا تَلْتَفِتُوا في صلاتِكُم","result":"فإنَّه لَا صلاةَ لِمُتَلَفِّتٍ","explicit":true,"ref":"الأحكام الوسطى 2/14","srcLabel":"الأحكام الوسطى","text":["لا صلاةَ لِمُلْتَفِتٍ [يعني حديث: ",["لا تَلْتَفِتُوا في صلاتِكُم ",1],["فإنَّه لَا صلاةَ لِمُتَلَفِّتٍ",2],"]"],"grade":"صحيح","narrator":"عبد الله بن سلام","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"إحسان › إبطال الأعمال","dorar":"KjAPVlLt"},{"id":"س-04846","fp":"9657135a23cd","stateId":551,"easy":"إذا التفتّ في الصلاة ← فالالتفات فيها هلكة","cause":"إيَّاكَ والالتِفاتَ في الصَّلاةِ","result":"فإنَّ الالتفاتَ في الصَّلاةِ هلَكَةٌ","explicit":true,"ref":"تحفة المحتاج 1/362","srcLabel":"الترمذي","text":[["إيَّاكَ والالتِفاتَ في الصَّلاةِ ، ",1],["فإنَّ الالتفاتَ في الصَّلاةِ هلَكَةٌ",2]," ، فإن كانَ لا بدَّ ففي التَّطوُّعِ لا في الفريضةِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (589)، والبغوي في ((شرح السنة)) (735)، ومجاعة بن الزبير في ((حديثه)) (73) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"tiXtrAPE"},{"id":"س-06622","fp":"828b5fb3d758","stateId":551,"easy":"إذا لم تأمرك صلاتك بالمعروف وتنهك عن المنكر ← لم تزدد من الله إلا بعداً","cause":"مَنْ لَمْ تَأْمُرْهُ صلاتُهُ بالمعروفِ وتنهاه عنِ المنكرِ","result":"لم يزْدَدْ مِنَ اللهِ إلَّا بُعْدًا","explicit":true,"similar":["س-05057"],"otherNeedIds":[28],"ref":"مجمع الزوائد 2/261","srcLabel":"الطبراني","text":["عنْ عبدِ اللهِ بنِ مسعودٍ قال ",["مَنْ لَمْ تَأْمُرْهُ صلاتُهُ بالمعروفِ وتنهاه عنِ المنكرِ ",1],["لم يزْدَدْ مِنَ اللهِ إلَّا بُعْدًا",2]],"grade":"صحيح","narrator":"[عبدالرحمن بن يزيد]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (9/ 220) (8543)، والبيهقي في ((الشعب)) (4/ 546)، وأبو داوود في ((الزهد)) (126) جميعا بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"RNr1IGyS"},{"id":"س-06943","fp":"c470b6e65039","stateId":551,"easy":"إذا التفتّ في صلاتك ← يقول الله: إلى من تلتفت؟ أإلى خير لك مني؟","cause":"فإذا التفتَ","result":"قال له: ابنَ آدمَ إلى من تلتفتُ؟ إلى خيرٍ لك منِّي تلتفتُ","explicit":true,"otherNeedIds":[26],"ref":"مختصر الصواعق المرسلة 419","srcLabel":"البزار","text":["إنَّ العبدَ إذا قامَ إلى الصَّلاةِ فإنه بين عينَيِ الرحمنِ، ",["فإذا التفتَ",1]," ",["قال له: ابنَ آدمَ إلى من تلتفتُ؟ إلى خيرٍ لك منِّي تلتفتُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البزار (9332) بلفظ: \"بين يدي الرحمن\"، وأخرجه محمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (128)، والعقيلي في ((الضعفاء الكبير)) (1/70) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"WB3Z5Qlz"},{"id":"س-07012","fp":"a4a3db4b8114","stateId":551,"easy":"إذا صليت وقد غرزت ضفيرتك في قفاك ← فهو كفل الشيطان","cause":"قد غَرَز ضَفْرَه في قَفاه","result":"يَقولُ: ذلكَ كِفْلُ الشَّيطانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[34],"ref":"المستدرك على الصحيحين 979","srcLabel":"أبو داود","text":["عن أَبِي سَعِيدٍ الْمَقْبُرِيِّ أنَّه رَأى أبا رافِعٍ مَولَى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مرَّ بالحَسَنِ بنِ عَليٍّ وهو يُصَلِّي قائمًا، و",["قد غَرَز ضَفْرَه في قَفاه",1],"، فحَلَّها أبو رافِعٍ؛ فالْتَفَت الحَسَنُ إليه مُغضَبًا، فقالَ أبو رافِعٍ: أقبِلْ على صَلاتِكَ ولا تَغضَبْ؛ فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["يَقولُ: ذلكَ كِفْلُ الشَّيطانِ",2]," يعني: مَقْعَدَ الشَّيطانِ يَقِي مَغْرَزَ ضَفْرِه."],"grade":"صحيح","narrator":"أبو رافع","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (646) باختلاف يسير، والترمذي (384)، وابن ماجه (1042) كلاهما بلفظ مقارب.","bab":"علم › الحث على الأخذ بالسنة","dorar":"qjLmZX7q","merged":5,"otherRefs":["صفة الصلاة 144 (صحيح)","شرح البخاري لابن الملقن 7/233 (حسن)","عمدة القاري 6/131 (حسن)","فتح الباري لابن حجر 2/348 (حسن)"]},{"id":"س-05057","fp":"ad293abe3bf4","stateId":551,"easy":"إذا لم تنهك صلاتك عن الفحشاء والمنكر ← لم تزدد بها من الله إلا بعداً","cause":"من لم تنهَهُ صلاتُهُ عن الفحشاءِ والمنكَرِ","result":"لم يزدَدْ بها من اللهِ إلَّا بُعْدًا","explicit":true,"repOf":"س-06622","otherNeedIds":[27],"ref":"شرح كتاب الشهاب 90","text":[["من لم تنهَهُ صلاتُهُ عن الفحشاءِ والمنكَرِ",1]," ",["لم يزدَدْ بها من اللهِ إلَّا بُعْدًا",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبري في ((التفسير)) (20/41)، والطبراني (11/54) (11025)، والقضاعي في ((مسند الشهاب)) (509) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"xf5iyGWM"},{"id":"س-06448","fp":"ab2bcb6cabb2","stateId":551,"easy":"إذا وضعت في مصلاك تصاوير ← تعرض لك في صلاتك وتشغلك","cause":"قِرامَكِ هذا","result":"فإنَّه لا تَزالُ تَصاويرُه تَعرِضُ في صَلاتي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح البخاري 374","srcLabel":"أحمد","text":["كان قِرامٌ لعائِشةَ سَتَرَت به جانِبَ بَيتِها، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: أميطي عَنَّا ",["قِرامَكِ هذا",1],"؛ ",["فإنَّه لا تَزالُ تَصاويرُه تَعرِضُ في صَلاتي",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (14022)، وأبو عوانة في ((مستخرج أبي عوانة)) (1519)، وأبو طاهر المخلص في ((المخلصيات)) (2466)، باختلاف يسير.","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"hzXh2kGy"},{"id":"س-06704","fp":"d71b6d3c188e","stateId":551,"easy":"إذا خفضت ورفعت قبل الإمام ← فناصيتك بيد الشيطان","cause":"الَّذي يخفِضُ ويرفعُ قبلَ الإمامِ","result":"إنَّما ناصيتُهُ بيدِ الشَّيطانِ","explicit":true,"otherNeedIds":[34],"ref":"الزواجر عن اقتراف الكبائر 1/146","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["الَّذي يخفِضُ ويرفعُ قبلَ الإمامِ",1]," ",["إنَّما ناصيتُهُ بيدِ الشَّيطانِ",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"صلاة الجماعة والإمامة › فضل الأئمة","dorar":"ubJodiRI"},{"id":"س-03679","fp":"b8e50a7a6ff9","stateId":551,"easy":"إذا صليت ورأسك معقوص ← فمثلك كمن يصلي مكتوفاً","cause":"يصلِّي ، ورأسُهُ مَعقوصٌ مِن ورائِهِ","result":"إنَّما مثَلُ هذا مثَلُ الَّذي يصلِّي وَهوَ مَكْتوفٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح أبي داود 647","srcLabel":"مسلم","text":["أنَّ عبدَ اللَّهِ بنَ عبَّاسٍ رأَى عبدَ اللَّهِ بنَ الحارِثِ ",["يصلِّي ، ورأسُهُ مَعقوصٌ مِن ورائِهِ",1]," ، فقامَ وراءَهُ ، فجعلَ يحلُّهُ وأقرَّ لَهُ الآخرُ فلمَّا انصرفَ أقبلَ إلى ابنِ عبَّاسٍ ، فقالَ : ما لَكَ ورَأسي ، قالَ : إنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، يقولُ : ",["إنَّما مثَلُ هذا مثَلُ الَّذي يصلِّي وَهوَ مَكْتوفٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (647) واللفظ له، وأخرجه مسلم (492) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"PtHXjfvS","merged":2,"otherRefs":["صحيح الجامع 2369 (صحيح)"]},{"id":"س-01374","fp":"238ae185c503","stateId":551,"easy":"إذا نقصت صلاتك في وضوئها والتفاتك ← تُدعى يوم القيامة من المنقوصين (أثر)","cause":"الذي ينقصُ أحدُهم صلاتَه في وضوئِه والتفاتِه","result":"يُدعى الناسُ يومَ القيامةِ المنقوصين","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[44],"ref":"فتح الباري لابن رجب 4/401","srcLabel":"فتح الباري لابن رجب","text":["عن ابنِ عمرَ قال : ",["يُدعى الناسُ يومَ القيامةِ المنقوصين",2]," . قيل : وما المنقوصون ؟ قال : ",["الذي ينقصُ أحدُهم صلاتَه في وضوئِه والتفاتِه",1]],"grade":"حسن","muhaddith":"إسناده جيد","bab":"وضوء › إسباغ الوضوء","dorar":"eZWTpH1j"},{"id":"س-08130","fp":"92d07c3e9fff","stateId":552,"easy":"إذا لم تدرك الخطبة وأدركت الصلاة ← فلم تدرك فضل الجمعة كاملاً","cause":"إذا لم يدرِكِ الخطبةَ","result":"فأدرَكَ الصَّلاةَ ولم يدرِكِ الجمعةَ","explicit":true,"ref":"تخريج المسند لشاكر 16/218","srcLabel":"أبو داود","text":["إنَّ الملائِكَةَ يومَ الجمعةِ على أبوابِ المساجدِ ، يَكْتُبونَ النَّاسَ على مَنازلِهِم ، جاءَ فلانٌ من ساعةِ كذا ، جاءَ فلانٌ من ساعةِ كذا ، جاءَ فلانٌ والإمامُ يخطبُ ، جاءَ فلانٌ ",["فأدرَكَ الصَّلاةَ ولم يدرِكِ الجمعةَ",2]," ، ",["إذا لم يدرِكِ الخطبةَ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (8523) بلفظه، وأبو داود الطيالسي (2688)، وابن أبي شيبة (5521) كلاهما دون قوله:(( إذا لم يدرك الخطبة)) .","bab":"ملائكة › أعمال الملائكة","dorar":"HtxHVoMh"},{"id":"س-01448","fp":"400fb310153e","stateId":552,"easy":"إذا مسست الحصى في الخطبة ← فقد لغوت","cause":"ومَن مسَّ الحصَى","result":"فقَد لَغا","explicit":true,"star":true,"similar":["س-03406"],"ref":"صحيح ابن خزيمة 3/ 285","srcLabel":"مسلم","text":["مَن تَوضَّأَ يومَ الجمعةِ فأحسنَ الوُضوءَ ثمَّ أتى الجمُعةَ فدَنا وأنصَتَ واستَمعَ، غُفِرَ لَهُ ما بينَهُ وبينَ الجمعةِ وزيادةُ ثلاثةِ أيَّامٍ، ",["ومَن مسَّ الحصَى ",1],["فقَد لَغا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (857)، وأبو داود (1050)، وابن ماجة (1090) باختلاف يسير.","bab":"وضوء › فضل الوضوء","dorar":"1ghzXJva"},{"id":"س-03517","fp":"39b5bf9fb603","stateId":552,"easy":"إذا حضرت الجمعة تلغو ← فذلك حظك منها","cause":"رجلٌ يَحضرُها يَلغو","result":"فَهوَ حظُّهُ منها","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 3/ 283","srcLabel":"أبو داود","text":["يَحضُرُ الجمُعةَ ثلاثةٌ: ",["رجلٌ يَحضرُها يَلغو",1],"، ",["فَهوَ حظُّهُ منها",2],"، ورجلٌ حضرَها بدُعاءٍ، فَهوَ رجلٌ دعا اللَّهَ، فإن شاءَ اللَّهُ أعطاهُ، وإن شاءَ مَنعَهُ، ورجلٌ حَضرَها بوقارٍ وإنصاتٍ وسُكونٍ، ولم يتخطَّ رقبةَ مسلِمٍ، ولم يؤذِ أحدًا، فَهوَ كفَّارةٌ لَهُ إلى الجمعةِ الَّتي تَليها، وزيادةُ ثلاثةِ أيَّامٍ ؛ لأنَّ اللَّهَ يقولُ: {مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعامُ: 160]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (1113)، وأحمد (7002)، والبيهقي (5897) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"I9wWla72","merged":4,"otherRefs":["صحيح الترغيب 723 (صحيح)","تخريج زاد المعاد 1/417 (حسن)","تخريج المسند لشاكر 10/174 (صحيح)"]},{"id":"س-00532","fp":"f2c17a9c668d","stateId":552,"easy":"إذا تكلمت يوم الجمعة والإمام يخطب ← فمثلك كالحمار يحمل أسفاراً","cause":"مَن يتكلمُ يومَ الجمعةِ والإمامُ يخطبُ","result":"كمثلِ الحمارِ يحملُ أسفارًا","explicit":true,"ref":"شرح رياض الصالحين لابن عثيمين 2/179","srcLabel":"شرح رياض الصالحين لابن عثيمين","text":[["مَن يتكلمُ يومَ الجمعةِ والإمامُ يخطبُ، ",1],["كمثلِ الحمارِ يحملُ أسفارًا",2],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"آداب عامة › ضرب الأمثال","dorar":"PZGmwQyx","merged":2,"otherRefs":["الجامع الصغير 8121 (حسن)"]},{"id":"س-03322","fp":"f1e0216ab1ac","stateId":552,"easy":"إذا لغوت وتخطيت رقاب الناس يوم الجمعة ← كانت لك ظهراً (لا جمعة)","cause":"ومَنْ لَغَا ، وتَخَطَّى رِقَابَ الناسِ","result":"كانَتْ لَهُ ظُهْرًا","explicit":true,"ref":"صحيح الجامع 6067","srcLabel":"أبو داود","text":["مَنِ اغتسلَ يومَ الجمعةِ ، ومسَّ مِنْ طيبِ امرأتِهِ إِنْ كان لها ، ولبِسَ مِنْ صالِحِ ثيابِهِ ، ثُمَّ لم يتخَطَّ رِقابَ الناسِ ، ولم يلْغُ عندَ الموعِظَةِ ، كانَتْ كفَّارَةً لما بينَها ، ",["ومَنْ لَغَا ، وتَخَطَّى رِقَابَ الناسِ ، ",1],["كانَتْ لَهُ ظُهْرًا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (347) واللفظ له، وابن خزيمة (1810)، والطحاوي في ((شرح معاني الآثار)) (2166) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"Nq2jmg1M","merged":2,"otherRefs":["صحيح الترغيب 721 (صحيح)"]},{"id":"س-01057","fp":"bf751e95163e","stateId":552,"easy":"إذا تباعدت عن الإمام في الخطبة ← لا تزال تتأخر حتى تؤخَّر في الجنة","cause":"احضُروا الذِّكرَ، وادْنُوا مِن الإمامِ","result":"فإنَّ الرَّجُلَ لا يَزالُ يَتباعَدُ حتى يُؤخَّرَ في الجنَّةِ، وإنْ دَخَلَها","explicit":true,"otherNeedIds":[68],"ref":"تخريج المسند لشعيب 20118","srcLabel":"أبو داود","text":["وَجَدتُ في كِتابِ أبي بخَطِّ يدِه، وأكبرُ ظَنِّي أنِّي قد سَمِعتُه منه، قال: حَدَّثَنا عليُّ بنُ عبدِ اللهِ، حَدَّثَنا مُعاذٌ، قال: وَجَدتُ في كِتابِ أبي بخَطِّ يدِه، ولم أسَمِعْه منه، حَدَّثَنا قَتادةُ، عن يَحيى بنِ مالكٍ، عن سَمُرةَ بنِ جُندُبٍ، أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["احضُروا الذِّكرَ، وادْنُوا مِن الإمامِ",1],"؛ ",["فإنَّ الرَّجُلَ لا يَزالُ يَتباعَدُ حتى يُؤخَّرَ في الجنَّةِ، وإنْ دَخَلَها",2],"."],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1108)، وعبدالله بن أحمد وجادة عن أبيه في ((المسند)) (20118)","bab":"أدعية وأذكار › فضل الذكر","dorar":"UGtytMcL"},{"id":"س-03406","fp":"4202665927c2","stateId":552,"easy":"إذا مسست الحصى في الخطبة ← فقد لغوت","cause":"ومَنْ مسَّ الحصا","result":"فقد لغا","explicit":true,"repOf":"س-01448","ref":"السنن الكبرى للبيهقي 3/227","text":["قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ وذَكَر يومَ الجُمُعةِ : مَنْ غسَّل واغتسل ، وبكَّر وابتكر ، ودنا وأنصت واستمع غُفر له ما بينَ الجُمُعةِ إلى الجُمُعةِ ، وزيادةُ ثلاثةِ أيامٍ ، ",["ومَنْ مسَّ الحصا ",1],["فقد لغا",2]],"grade":"صحيح","narrator":"أوس بن أبي أوس وقيل أوس بن أوس والد عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (345)، وابن أبي شيبة (4990)، وابن حبان (116) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"UVAN0tG2"},{"id":"س-03649","fp":"0dda2cb2cabf","stateId":552,"easy":"إذا لغوت يوم الجمعة ← فليس لك من صلاتك إلا ما لغوت","cause":"فقُلتُ لِأُبَيٍّ: مَتى نَزَلتْ هذه السُّورةُ","result":"ما لكَ مِن صَلاتِكَ إلَّا ما لَغَوتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الترغيب والترهيب 1/348","srcLabel":"الحاكم","text":["دَخَلتُ المَسجِدَ يَومَ الجُمُعةِ والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَخطُبُ، فجَلَستُ قَريبًا مِن أُبَيِّ بنِ كَعبٍ، فقَرَأ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ سُورةَ بَراءةٌ، ",["فقُلتُ لِأُبَيٍّ: مَتى نَزَلتْ هذه السُّورةُ",1],"؟ قال: فتَجَهَّمَني ولم يُكَلِّمْني، ثم مَكَثَ ساعةً، ثم سألتُه فتَجَهَّمَني ولم يُكَلِّمْني، ثم مَكَثَ ساعةً ثم سألتُه فتَجَهَّمَني ولم يُكَلِّمْني، فلَمَّا صلَّى النَّبيُّ صلَّى اللهُ عليه وسلَّمَ قُلتُ لِأُبَيٍّ: سألتُكَ فتَجَهَّمتَني ولم تُكَلِّمْني. قال أُبَيٌّ: ",["ما لكَ مِن صَلاتِكَ إلَّا ما لَغَوتَ",2],". فذَهَبتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقُلتُ: يا نَبيَّ اللهِ، كُنتُ بجَنبِ أُبَيٍّ وأنتَ تَقرَأُ بَراءةٌ، فسألتُه مَتى نَزَلتْ هذه السُّورةُ؟ فتَجَهَّمَني ولم يُكَلِّمْني، ثم قال: ما لكَ مِن صَلاتِكَ إلَّا ما لَغَوتَ. قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: صَدَقَ أُبَيٌّ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن خزيمة (1807)، والحاكم (2902)، والبيهقي (6043) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"tJENZvOK","merged":8,"otherRefs":["المجموع للنووي 4/525 (صحيح)","صحيح ابن ماجه 919 (صحيح)","الصحيح المسند 1270 (حسن)","مجمع الزوائد 2/188 (صحيح)","الأحاديث المختارة 1139 (صحيح)","المحلى 5/63 (صحيح)","إتحاف الخيرة المهرة 2/284 (حسن)"]},{"id":"س-04069","fp":"577c7a78c17a","stateId":552,"easy":"إذا قلت لصاحبك «أنصت» والإمام يخطب ← فقد لغوت","cause":"أن تقولَ لصاحبِكَ : أنصِت إذا خرجَ الإمامُ في الجمعةِ","result":"كفَى لغوًا","explicit":true,"ref":"الترغيب والترهيب 1/349","srcLabel":"الطبراني","text":["عن عبدِ اللَّهِ بنِ مسعودٍ رضي اللَّه عنه قالَ : ",["كفَى لغوًا",2]," ",["أن تقولَ لصاحبِكَ : أنصِت إذا خرجَ الإمامُ في الجمعةِ",1]],"grade":"صحيح","narrator":"[الربيع الفزاري]","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (9/357) (9543)","bab":"جمعة › فرض الجمعة","dorar":"dgnL6GKb"},{"id":"س-04894","fp":"25eff1d72757","stateId":552,"easy":"إذا قلت لغيرك «أنصت» في الخطبة ← فلا جمعة لك","cause":"يقولُ لهُ : انصتْ","result":"لا جمعةَ لهُ","explicit":true,"ref":"الجامع الصغير 8121","srcLabel":"أحمد","text":["مثلُ الذي يتكلمُ يومَ الجمعةِ،  و الإمامُ يخطبُ،  مثلُ الحمارِ يحملُ أسفارًا،  والذيِ ",["يقولُ لهُ : انصتْ",1],"،  ",["لا جمعةَ لهُ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أحمد (2033)، والبزار (4725)، والطبراني (12/90) (12563) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jIqHkn7k"},{"id":"س-01827","fp":"93ccd84f0b9d","stateId":552,"easy":"إذا تكلمت والإمام يخطب ← فلا جمعة لك","cause":"تكلَّمَ وأنتَ تخطبُ","result":"لا جمعةَ لكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المطالب العالية 1/292","srcLabel":"ابن أبي شيبة","text":["قال سعدُ بنُ أبي وقاصٍ رضيَ اللهُ عنهُ لرجلٍ في يومِ جمعةٍ : ",["لا جمعةَ لكَ",2]," . قال : فذكرَ الرَّجلُ ذلكَ للنَّبيِّ صلَّى اللهُ عليْهِ وسلَّمَ فقال : يا رسولَ اللهِ ، إنَّ سعدًا قال لي : لا جمعةَ لكَ . فقال النَّبيُّ صلَّى اللهُ عليْهِ وسلَّمَ : لِمَ يا سعدُ ؟ فقال : إنَّه ",["تكلَّمَ وأنتَ تخطبُ",1]," . فقال : صدقَ سعدٌ"],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"إسناده مقارب","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (5349)، وعبد بن حميد في ((المسند)) (1140)، والبزار كما في ((الترغيب والترهيب)) للمنذري (1/293)","bab":"إحسان › إبطال الأعمال","dorar":"2KIyJWyW"},{"id":"س-08199","fp":"18b2d4356f08","stateId":552,"easy":"إذا تأخرت عن الجمعة حتى يجلس الإمام ← تطوي الملائكة الصحف","cause":"فإذا أذَّنَ المؤذِّنُ ، وجلس الإمامُ على المنبرِ","result":"طووا الصحفَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 774","srcLabel":"أحمد","text":["إذا كان يومُ الجمعةِ قعدَتِ الملائكةُ على أبوابِ المسجدِ ، يكتبون من جاء من الناسِ على قدْرِ منازلِهم ؛ فرجلٌ قدَّم جزورًا ، ورجلٌ قدَّم بقرةً ، ورجلٌ قدَّم شاةً ، ورجلٌ قدَّم دجاجةً ، ورجلٌ قدَّم عصفورًا ، ورجلٌ قدَّم بيضةً ، ",["فإذا أذَّنَ المؤذِّنُ ، وجلس الإمامُ على المنبرِ",1]," ",["طووا الصحفَ",2]," ، ودخلوا المسجدَ يستمعون الذكرَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11786) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"uHnnIs7e"},{"id":"س-06485","fp":"f313f4043e53","stateId":553,"easy":"إذا تركت صلاة العصر ← فقد حبط عملك","cause":"مَن تَرَكَ صَلَاةَ العَصْرِ","result":"فقَدْ حَبِطَ عَمَلُهُ","explicit":true,"ref":"لسان الميزان 5/514","srcLabel":"لسان الميزان","text":["بَكِّروا لصَلاةِ العَصْرِ [يعني حديث: كُنَّا مع بُرَيْدَةَ في غَزْوَةٍ في يَومٍ ذِي غَيْمٍ، فَقَالَ: بَكِّرُوا بصَلَاةِ العَصْرِ؛ فإنَّ النبيَّ صَلَّى اللهُ عليه وسلَّمَ قَالَ: ",["مَن تَرَكَ صَلَاةَ العَصْرِ ",1],["فقَدْ حَبِطَ عَمَلُهُ",2],".]"],"grade":"صحيح","narrator":"بريدة بن الحصيب","muhaddith":"محفوظ","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"xMfKryFQ","merged":5,"otherRefs":["فتح الباري لابن رجب 1/182 (صحيح)","تخريج المسند لشعيب 27492 (صحيح)","صحيح ابن خزيمة 1/ 433 (صحيح)","فتح الغفار 194/1 (صحيح)"]},{"id":"س-06221","fp":"c2afa90a6899","stateId":553,"easy":"إذا صلّت المرأة البالغة بلا خمار ← لا يقبل الله صلاتها","cause":"إلَّا بخمارٍ","result":"لا يقبلُ اللَّهُ صلاةَ امرأةٍ قد حاضَت","explicit":true,"ref":"صحيح ابن خزيمة 2/ 14","srcLabel":"أبو داود","text":[["لا يقبلُ اللَّهُ صلاةَ امرأةٍ قد حاضَت",2]," ",["إلَّا بخمارٍ",1],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن حبان (1864) بلفظه، وأبو داود (641)، والترمذي (377) باختلاف يسير","bab":"ستر العورة › وجوب سترها","dorar":"LpBsSuPD"},{"id":"س-06702","fp":"34afd333af3a","stateId":553,"easy":"إذا صليت فرداً خلف الصف ← فأعد صلاتك","cause":"رَجُلًا يُصَلِّي خَلْفَ الصَّفِّ","result":"اسْتَقبِلْ صَلاتَك، فلا صَلاةَ لرَجُلٍ فَرْدٍ خَلْفَ الصَّفِّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 981","srcLabel":"أحمد","text":["عن علِيِّ بنِ شَيْبانَ: أنَّه خَرَجَ وافِدًا إلى رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: فصَلَّيْنا خَلْفَ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فلَمَحَ بمُؤْخِرِ عَيْنيه إلى رَجُلٍ لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ، فلمَّا انْصَرَفَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «يا مَعشَرَ المُسلِمينَ، إنَّه لا صَلاةَ لِمَن لا يُقيمُ صُلْبَه في الرُّكوعِ والسُّجودِ»، قالَ: ورأى ",["رَجُلًا يُصَلِّي خَلْفَ الصَّفِّ",1],"، فوَقَفَ حتَّى انْصَرَفَ الرَّجُلُ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ: «",["اسْتَقبِلْ صَلاتَك، فلا صَلاةَ لرَجُلٍ فَرْدٍ خَلْفَ الصَّفِّ",2],"».\nقالَ عَبْدُ الصَّمَدِ: «فَرْدًا خَلْفَ الصَّفِّ»."],"grade":"صحيح","narrator":"علي بن شيبان","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16297)، وابن أبي شيبة (2957)، وابن خزيمة (593) واللفظ لهم.","bab":"صلاة الجماعة والإمامة › صلاة الفذ وحده خلف الصف","dorar":"62FTg3lR","merged":13,"otherRefs":["صحيح ابن خزيمة 3/ 82 (صحيح)","إرواء الغليل 2/329 (صحيح)","الحديث لابن عبدالوهاب 2/67 (حسن)","نخب الافكار 6/191 (صحيح)","تخريج صحيح ابن حبان 2203 (صحيح)","صحيح ابن ماجه 829 (صحيح)","المهذب في اختصار السنن 2/1036 (حسن)","صحيح الجامع 949 (صحيح)","تنقيح التحقيق 2/498 (حسن)","النفح الشذي 4/228 (حسن)","الجامع الصغير 3002 (صحيح)","أعلام الموقعين 2/259 (صحيح)"]},{"id":"س-08273","fp":"cfe606a771ca","stateId":553,"easy":"إذا أممت قوماً وهم لك كارهون ← لم تجز صلاتك أذنك","cause":"أيُّما رَجُلٍ أَمَّ قَوْمًا وهُمْ له كارِهونَ","result":"لم تَجُزْ صَلاتُه أُذُنَه","explicit":true,"star":true,"ref":"الأحاديث المختارة 846","srcLabel":"البخاري","text":["«صلَّى بقَوْمٍ، فلمَّا انْصَرَفَ قالَ: إنِّي نَسيْتُ أن أسْتَأمِرَكم قَبْلَ أن أَتَقَدَّمَكم، أَفَرَضيتُم بصَلاتي؟ قالوا: نَعمْ، ومَن يَكرَهُ ذلك يا حَواريَّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قالَ: إنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["أيُّما رَجُلٍ أَمَّ قَوْمًا وهُمْ له كارِهونَ ",1],["لم تَجُزْ صَلاتُه أُذُنَه»",2],"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مناقب وفضائل › الزبير بن العوام","dorar":"Gec6HYmH"},{"id":"س-01828","fp":"3d99905094cf","stateId":553,"easy":"إذا كان في جسدك شيء من الخلوق (طيب النساء) ← لا يقبل الله صلاتك","cause":"صلاةَ رجلٍ في جسدِهِ شيءٌ من خَلوقٍ","result":"لا يقبلُ اللهُ","explicit":true,"star":true,"ref":"المحلى 4/76","srcLabel":"البخاري","text":[["لا يقبلُ اللهُ",2]," ",["صلاةَ رجلٍ في جسدِهِ شيءٌ من خَلوقٍ",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه أبو داود (4178)، والبخاري في ((التاريخ الكبير)) (3/ 353)، والطحاوي في ((شرح معاني الآثار)) (3585) واللفظ لهم.","bab":"إحسان › إبطال الأعمال","dorar":"cHNvXnBF"},{"id":"س-05276","fp":"122b7a794b5c","stateId":553,"easy":"إذا أممت قوماً كارهين أو باتت المرأة وزوجها ساخط أو أبق العبد ← لا يقبل الله لهم صلاة","cause":"رَجُلٌ أَمَّ قَوْمًا وهُمْ له كارِهونَ، وامْرَأةٌ باتَت وزَوْجُها ساخِطٌ عليها، وعَبْدٌ أَبَقَ مِن مَواليه","result":"ثَلاثةٌ لا يَقبَلُ اللهُ لهم صَلاةً","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 374","srcLabel":"متفق عليه","text":["«",["ثَلاثةٌ لا يَقبَلُ اللهُ لهم صَلاةً",2],"؛",[" رَجُلٌ أَمَّ قَوْمًا وهُمْ له كارِهونَ، وامْرَأةٌ باتَت وزَوْجُها ساخِطٌ عليها، وعَبْدٌ أَبَقَ مِن مَواليه».",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m1HOXWbF"},{"id":"س-04982","fp":"d99a8163b8bf","stateId":553,"easy":"إذا أبق العبد ← لم تُقبل له صلاة","cause":"إذا أَبَقَ العَبْدُ","result":"لم تُقبَلْ له صَلاةٌ، وإن ماتَ ماتَ كافِرًا","explicit":true,"star":true,"otherNeedIds":[22],"ref":"الأحكام الوسطى 4/27","srcLabel":"مسلم","text":["\"",["إذا أَبَقَ العَبْدُ",1]," ",["لم تُقبَلْ له صَلاةٌ، وإن ماتَ ماتَ كافِرًا",2],"\"، قالَ: فأَبَقَ غُلامٌ لجَريرٍ، فأخَذَه فضَرَبَ عُنُقَه."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه مسلم (70)، والنسائي (4050)، والطبراني (2357) واللفظ لهم","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jtU9pB4j"},{"id":"س-01308","fp":"2c827426fd2c","stateId":553,"easy":"إذا أبق العبد أو باتت المرأة وزوجها ساخط أو أمّ قوماً وهم كارهون ← لا تجاوز صلاتهم آذانهم","cause":"العَبدُ الآبقُ حتَّى يرجِعَ ، وامرأةٌ باتَت وزوجُها عليها ساخِطٌ ، وإمامُ قومٍ وَهُم لَه كارِهونَ","result":"ثلاثةٌ لا تجاوِزُ صلاتُهُم آذانَهُم","explicit":true,"star":true,"similar":["س-01314"],"otherNeedIds":[60],"ref":"تخريج سنن الترمذي 2/193","srcLabel":"الترمذي","text":[["ثلاثةٌ لا تجاوِزُ صلاتُهُم آذانَهُم ",2],":",[" العَبدُ الآبقُ حتَّى يرجِعَ ، وامرأةٌ باتَت وزوجُها عليها ساخِطٌ ، وإمامُ قومٍ وَهُم لَه كارِهونَ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (360) واللفظ له، وابن أبي شيبة في ((المصنف)) (17423)، والطبراني (8/341) (8090) باختلاف يسير.","bab":"نكاح › حق الزوج على المرأة","dorar":"B7dGsZYX","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 2/42 (صحيح)"]},{"id":"س-01330","fp":"5e9ec400d517","stateId":553,"easy":"إذا أبق العبد أو سخط الزوج على زوجته ← لا يقبل الله لهما صلاة ولا يرفع لهما حسنة","cause":"العبدُ الآبِقُ حتَّى يرجِعَ إلى مواليه فيضَعَ يدَه في أيديهم والمرأةُ السَّاخطُ عليها زوجُها حتَّى يرضى والسَّكرانُ حتَّى يصحوَ","result":"ثلاثةٌ لا يقبَلُ اللهُ لهم صلاةً ولا يرفَعُ لهم إلى السَّماءِ حسنةً","explicit":true,"ref":"صحيح ابن حبان 5355","srcLabel":"الطبراني","text":[["ثلاثةٌ لا يقبَلُ اللهُ لهم صلاةً ولا يرفَعُ لهم إلى السَّماءِ حسنةً",2],":",[" العبدُ الآبِقُ حتَّى يرجِعَ إلى مواليه فيضَعَ يدَه في أيديهم والمرأةُ السَّاخطُ عليها زوجُها حتَّى يرضى والسَّكرانُ حتَّى يصحوَ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (7360)،  والبيهقي في ((شعب الإيمان)) (5202) كلاهما بلفظه،  الطبراني في ((المعجم الأوسط)) (9231) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"zoGVkFox","merged":2,"otherRefs":["الزواجر عن اقتراف الكبائر 2/83 (صحيح)"]},{"id":"س-01537","fp":"e5aa32e4e757","stateId":553,"easy":"إذا سمعت النداء وأنت فارغ صحيح فلم تجب ← فلا صلاة لك (كاملة)","cause":"مَن سَمِعَ النِّداءَ فارغًا صَحيحًا فلم يُجِبْ","result":"فلا صَلاة َله","explicit":true,"similar":["س-01542","س-06569"],"ref":"المستدرك على الصحيحين 819","srcLabel":"البيهقي","text":[["مَن سَمِعَ النِّداءَ فارغًا صَحيحًا فلم يُجِبْ ",1],["فلا صَلاة َله",2],"."],"grade":"صحيح","narrator":"أبو موسى","muhaddith":"[صحيح]","takhrij":"أخرجه البزار (3157)، وابن الأعرابي في ((المعجم)) (1056)، والبيهقي (5656) جميعهم بلفظ مقارب.","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"kKxOzQLE","merged":2,"otherRefs":["حقيقة الإسلام و الإيمان 85 (صحيح)"]},{"id":"س-03604","fp":"ee4fde170d72","stateId":553,"easy":"إذا أسبلت ← لا يقبل الله صلاتك","cause":"صلاةَ رجلٍ مسبلٍ","result":"وإنَّ اللَّهَ لا يقبلُ","explicit":true,"ref":"الآداب الشرعية 3/514","srcLabel":"أبو داود","text":["أمر صلَّى اللَّهُ عليهِ وسلَّمَ رجلًا يصلي وهو مسبلٌ إزارَه بالوضوءِ فتَوضَّأ ثمَّ جاءَ فقالَ لَه رجلٌ يا رسولَ اللَّهِ ما لَك أمرتَه أن يتَوضَّأ ثمَّ سَكتَّ عنهُ فقالَ إنَّهُ كانَ يصلِّي وَهوَ مسبلٌ إزارَه ",["وإنَّ اللَّهَ لا يقبلُ",2]," ",["صلاةَ رجلٍ مسبلٍ",1]],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4086)، والبزار (8762)، والبيهقي في ((الشعب)) (5718) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"czhO5Uf4","merged":2,"otherRefs":["فنون اللباس 95 (صحيح)"]},{"id":"س-06688","fp":"2eb030d802dd","stateId":553,"easy":"إذا كنت جار المسجد فصليت في غيره ← فلا صلاة لك (كاملة)","cause":"لجارِ المسجِدِ إلَّا في المسجِدِ","result":"لا صلاةَ","explicit":true,"ref":"تخريج المحلى 4/195","srcLabel":"البيهقي","text":["عن علِيِّ بنِ أبي طالبٍ ",["لا صلاةَ",2]," ",["لجارِ المسجِدِ إلَّا في المسجِدِ",1],"، فقيل له: يا أميرَ المُؤمِنينَ، ومَن جارُ المسجِدِ؟ قال: مَن سَمِعَ الأذانَ."],"grade":"صحيح","narrator":"سعيد التيمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالرزاق (1915)، وابن أبي شيبة (3488) باختلاف يسير، والبيهقي (5139) مختصراً باختلاف يسير","bab":"صلاة الجماعة والإمامة › الحرص على حضور الجماعة","dorar":"2N0nBw8v","merged":2,"otherRefs":["فيض القدير 6/ 431 (حسن)"]},{"id":"س-06700","fp":"172e0e2f9792","stateId":553,"easy":"إذا أممت قوماً وهم لك كارهون ← لا تجاوز صلاتك ترقوتك","cause":"من أمَّ قومًا و هم له كارهون","result":"فإنَّ صلاتَه لا تجاوِزُ تَرْقُوَتَه","explicit":true,"similar":["س-02567"],"ref":"السلسلة الصحيحة 2325","srcLabel":"الطبراني","text":[["من أمَّ قومًا و هم له كارهون ، ",1],["فإنَّ صلاتَه لا تجاوِزُ تَرْقُوَتَه",2]],"grade":"صحيح","narrator":"جنادة بن أبي أمية","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه الطبراني (2/ 282) (2177)، وأبو نعيم في ((معرفة الصحابة)) (1669)، وابن عساكر في ((تاريخ دمشق)) (11/ 292) بلفظه.","bab":"صلاة الجماعة والإمامة › صفات الإمام وآدابه","dorar":"0BDaFLW9","merged":2,"otherRefs":["صحيح الترغيب 484 (حسن)"]},{"id":"س-01310","fp":"07c7d70885aa","stateId":553,"easy":"إذا أممت قوماً وهم لك كارهون أو بتّ وزوجك ساخط أو تصارمت مع أخيك ← لا ترتفع صلاتك فوق رأسك شبراً","cause":"رجلٌ أمَّ قومًا وَهُم لَهُ كارِهونَ ، وامرأةٌ باتَت وزوجُها عليها ساخِطٌ وأخَوانِ مُتصارمانِ","result":"ثلاثةٌ لا تَرتَفِعُ صلاتُهُم فوقَ رءوسِهِم شِبرًا","explicit":true,"ref":"الترغيب والترهيب 1/229","srcLabel":"ابن ماجه","text":[["ثلاثةٌ لا تَرتَفِعُ صلاتُهُم فوقَ رءوسِهِم شِبرًا",2]," ",["رجلٌ أمَّ قومًا وَهُم لَهُ كارِهونَ ، وامرأةٌ باتَت وزوجُها عليها ساخِطٌ وأخَوانِ مُتصارمانِ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (971) واللفظ له، وابن حبان (1757)، والطبراني (11/449) (12275) باختلاف يسير","bab":"نكاح › حق الزوج على المرأة","dorar":"mp6Ct9EF"},{"id":"س-01314","fp":"8ea92c6fda2a","stateId":553,"easy":"إذا أبق العبد أو عصت المرأة زوجها ← لا تجاوز صلاتهما رأسيهما حتى يرجعا","cause":"عَبدٌ أبَقَ من مَواليه حتَّى يرجعَ ، وامرأةٌ عصَت زوجَها حتَّى ترجِعَ","result":"اثنانِ لا تُجَاوِزُ صلاتُهما رؤوسَهُما","explicit":true,"repOf":"س-01308","ref":"صحيح الترغيب 1888","text":[["اثنانِ لا تُجَاوِزُ صلاتُهما رؤوسَهُما ",2],":",[" عَبدٌ أبَقَ من مَواليه حتَّى يرجعَ ، وامرأةٌ عصَت زوجَها حتَّى ترجِعَ .",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3628)، والحاكم (7330)","bab":"نكاح › حق الزوج على المرأة","dorar":"CtTsZCwT"},{"id":"س-01538","fp":"a273d38d0f13","stateId":553,"easy":"إذا سمعت المنادي ولم يمنعك عذر ← لم تُقبل صلاتك التي صليت","cause":"مَن سمعَ المُناديَ فلَم يمنعهُ منَ اتِّباعِهِ ، عُذرٌ","result":"لم تُقبَلْ منهُ الصَّلاةُ الَّتي صلَّى","explicit":true,"ref":"ضعيف أبي داود 551","srcLabel":"أبو داود","text":[["مَن سمعَ المُناديَ فلَم يمنعهُ منَ اتِّباعِهِ ، عُذرٌ",1]," ، قالوا: وما العُذرُ  ؟ ، قالَ: خَوفٌ أو مَرَضٌ ، ",["لم تُقبَلْ منهُ الصَّلاةُ الَّتي صلَّى",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح دون جملة العذر وبلفظ: \"فلا صلاة له\"","takhrij":"أخرجه أبو داود (551) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/213)، والدارقطني (1/420).","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"FOJmGugy"},{"id":"س-01542","fp":"874935b8d604","stateId":553,"easy":"إذا سمعت النداء فلم تأتِ بلا عذر ← فلا صلاة لك","cause":"من سمع النداءَ فلم يأتِ","result":"فلا صلاةَ له إلا من عذرٍ","explicit":true,"repOf":"س-01537","ref":"مجموع فتاوى ابن باز 23/6","text":[["من سمع النداءَ فلم يأتِ ",1],["فلا صلاةَ له إلا من عذرٍ",2],"، قيل لابنِ عباسٍ رضِيَ اللهُ عنهما ما هو العذرُ؟ قال : خوفٌ أو مرضٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (551) مطولاً، وابن ماجه (793) باختلاف يسير.","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"NKTDjOMW"},{"id":"س-01829","fp":"f7f6b0d984e2","stateId":553,"easy":"إذا تطيبت المرأة ثم خرجت إلى المسجد ← لم تُقبل صلاتها حتى تغتسل","cause":"أيُّما امرأةٍ تطيَّبَتْ ثُمَّ خَرَجَتْ إلى المسْجِدِ","result":"لم تُقْبَلْ لَها صلاةٌ حتى تغتسلَ","explicit":true,"similar":["س-05231"],"ref":"صحيح الجامع 2703","srcLabel":"أبو داود","text":[["أيُّما امرأةٍ تطيَّبَتْ ثُمَّ خَرَجَتْ إلى المسْجِدِ ، ",1],["لم تُقْبَلْ لَها صلاةٌ حتى تغتسلَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4174)، والنسائي (5127)، وابن ماجة (4002) بنحوه.","bab":"إحسان › إبطال الأعمال","dorar":"fVnuGeRW"},{"id":"س-02567","fp":"199863adcfb1","stateId":553,"easy":"إذا تقدمت قوماً وهم لك كارهون ← لا يقبل الله صلاتك","cause":"من تقدَّم قومًا وهم له كارهونَ","result":"ثلاثةٌ لا يقبلُ اللهُ منهم صلاةً","explicit":true,"repOf":"س-06700","ref":"فتاوى نور على الدرب لابن باز 12/55","text":[["ثلاثةٌ لا يقبلُ اللهُ منهم صلاةً",2]," وذكر منهم: ",["من تقدَّم قومًا وهم له كارهونَ",1],"."],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (593)، وابن ماجة (970)، والبيهقي في ((الصغير)) (534) بنحوه تامًا.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"S8l6d2gs"},{"id":"س-00610","fp":"b2159ecb20ed","stateId":553,"easy":"إذا أبق العبد من سيده ← فلا تُقبل صلاته حتى يرجع","cause":"أذنتْ لك سيدتُك ؟ قال : لا","result":"فإنَّ مثلَك مثلُ عبٍد لا يُصلِّي إن متَّ قبل أن ترجعَ إليها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الإلمام بأحاديث الأحكام 2/456","srcLabel":"الحاكم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ كان في بعضِ مَغازيه مرَّ بأناسٍ من مُزينةَ فأتبعَه عبدٌ لامرأةٍ منهم ، فلما كان في بعضِ الطُّرقِ سلَّم عليه ، فقال : فلانٌ ؟ قال : نعم . قال : ما شأنُك ؟ قال : أجاهدُ معك . فقال : ",["أذنتْ لك سيدتُك ؟ قال : لا",1]," . قال : ارجعْ إليها ",["فإنَّ مثلَك مثلُ عبٍد لا يُصلِّي إن متَّ قبل أن ترجعَ إليها",2]," ، واقرأْ عليها السَّلامَ ، فرجع إليها فأخبرها الخبرَ ، قالتْ : آللهِ هو أمرك أن تقرأَ عليَّ السَّلامَ ؟ قال : نعم . قالت : فارجعْ فجاهِدْ معه"],"grade":"صحيح","narrator":"عبدالله بن أبي ربيعة","muhaddith":"[اشترط في المقدمة أنه] صحيح على طريقة بعض أهل الحديث","takhrij":"أخرجه ابن أبي أسامة في ((مسند الحارث)) (662)، والحاكم (2553)، والبيهقي (17871) واللفظ لهم جميعا.","bab":"آداب عامة › ضرب الأمثال","dorar":"JYXLvZhE"},{"id":"س-05231","fp":"d248e9490e7e","stateId":553,"easy":"إذا خرجت المرأة إلى المسجد متعطرة ← لا يقبل الله صلاتها","cause":"من امرأةٍ صلاةً خرجت إلى المسجدِ وريحُها تعصِفُ","result":"لا يقبلُ اللهُ","explicit":true,"repOf":"س-01829","ref":"الترغيب والترهيب 3/126","text":[["لا يقبلُ اللهُ",2]," ",["من امرأةٍ صلاةً خرجت إلى المسجدِ وريحُها تعصِفُ",1]," حتَّى ترجعَ فتغتسِلَ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده متصل ورواته ثقات","takhrij":"أخرجه ابن خزيمة (1682) بلفظه، والبيهقي (5441)، وأبو يعلى (6385) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"upN8GNBX"},{"id":"س-05241","fp":"b59fa750a2e3","stateId":553,"easy":"إذا خرجت المرأة بغير إذن زوجها أو أبق العبد أو أمّ رجل قوماً كارهين ← لا تُقبل صلاتهم","cause":"المرأةُ تخرُجُ مِن بَيتِها بغيرِ إذنِ زوجِها، والعبدُ الآبِقُ، والرَّجلُ يؤُمُّ القومَ وهم له كارِهونَ","result":"ثلاثةٌ لا تُقْبَلُ صَلاتُهم","explicit":true,"ref":"إتحاف الخيرة المهرة 2/92","srcLabel":"ابن أبي شيبة","text":["أنَّ سلمانَ قدَّمَه قومٌ يُصلِّي بهم، فأبى حتَّى دَفَعوه، فلمَّا صَلَّى بهم، قال: أكلُّكم راضٍ؟ قالوا: نعم. قال: الحمدُ للهِ، إنِّي سمِعْتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ثلاثةٌ لا تُقْبَلُ صَلاتُهم",2],":",[" المرأةُ تخرُجُ مِن بَيتِها بغيرِ إذنِ زوجِها، والعبدُ الآبِقُ، والرَّجلُ يؤُمُّ القومَ وهم له كارِهونَ.",1]],"grade":"حسن","narrator":"سلمان الفارسي","muhaddith":"إسناده رجاله ثقات، وله شاهد","takhrij":"أخرجه ابن أبي شيبة في (( المسند)) (453) وفي المصنف (4135) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qQRPba8t"},{"id":"س-06569","fp":"9611542121ea","stateId":553,"easy":"إذا سمعت النداء ثم لم تأتِ إلا من علة ← فلا صلاة لك","cause":"لمَن سَمِعَ النِّداءَ ثمَّ لا يأتي إلَّا مِن عِلَّةٍ","result":"لا صلاةَ","explicit":true,"repOf":"س-01537","ref":"الضعفاء الكبير 4/81","text":[["لا صلاةَ",2]," ",["لمَن سَمِعَ النِّداءَ ثمَّ لا يأتي إلَّا مِن عِلَّةٍ",1],"."],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"يروى بغير هذا الإسناد من وجه صالح","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (1093)، وأبو أحمد الحاكم في ((الأسامي والكنى)) (2/611)، والدارقطني (1/419) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"L9eF03W3"},{"id":"س-03970","fp":"e32df1958459","stateId":554,"easy":"إذا شربت الخمر وسكرت ← لا تُقبل لك صلاة أربعين صباحاً","cause":"مَن شرِبَ الخمرَ وسَكِرَ","result":"لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا ، وإن ماتَ دخلَ النَّارَ ، فإن تابَ تابَ اللَّهُ علَيهِ ، وإن عادَ ، فشَربَ ، فسَكِرَ ، لم تُقبَلْ لَهُ صلاةٌ أربَعينَ صباحًا ، فإن ماتَ دخلَ النَّارَ ، فإن تابَ ، تابَ اللَّهُ علَيهِ ، وإن عادَ ، فشربَ ، فسَكِرَ ، لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا ، فإن ماتَ دخلَ النَّارَ ، فإن تابَ تابَ اللَّهُ علَيهِ ، وإن عادَ ، كانَ حقًّا على اللَّهِ ، أن يسقيَهُ من ردغةِ الخبالِ ، يومَ القيامة","explicit":true,"similar":["س-03965","س-07153","س-04006","س-04218"],"otherNeedIds":[69],"ref":"صحيح ابن ماجه 2738","srcLabel":"ابن ماجه","text":[["مَن شرِبَ الخمرَ وسَكِرَ ، ",1],["لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا ، وإن ماتَ دخلَ النَّارَ ، فإن تابَ تابَ اللَّهُ علَيهِ ، وإن عادَ ، فشَربَ ، فسَكِرَ ، لم تُقبَلْ لَهُ صلاةٌ أربَعينَ صباحًا ، فإن ماتَ دخلَ النَّارَ ، فإن تابَ ، تابَ اللَّهُ علَيهِ ، وإن عادَ ، فشربَ ، فسَكِرَ ، لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا ، فإن ماتَ دخلَ النَّارَ ، فإن تابَ تابَ اللَّهُ علَيهِ ، وإن عادَ ، كانَ حقًّا على اللَّهِ ، أن يسقيَهُ من ردغةِ الخبالِ ، يومَ القيامة",2]," قالوا : يا رسولَ اللَّهِ وما ردغةُ الخبالِ ؟ قالَ : عُصارةُ أَهْلِ النَّارِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3377) واللفظ له، وأحمد (6773)","bab":"توبة › الحض على التوبة","dorar":"6vGDHB4L","merged":4,"otherRefs":["تخريج المسند لشعيب 6773 (صحيح)","المصابيح في الأحاديث المتواترة 620 (صحيح)","المستدرك على الصحيحين 7437 (صحيح)"]},{"id":"س-03965","fp":"c87094169a34","stateId":554,"easy":"إذا شربت الخمر ← لا تُقبل لك صلاة أربعين صباحاً، فإن تبت تاب الله عليك","cause":"مَن شربَ منَ الخمرِ شَربةً","result":"لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ","explicit":true,"repOf":"س-03970","otherNeedIds":[69],"ref":"تخريج المسند لشاكر 10/128","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه مَن شَرِبَ شَرْبةَ خَمْرٍ لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه، فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: ",["مَن شربَ منَ الخمرِ شَربةً ",1],["لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ",2]," قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No","merged":2,"otherRefs":["صحيح الترغيب 2383 (صحيح)"]},{"id":"س-07153","fp":"117276e36ed1","stateId":554,"easy":"إذا شربت الخمر ← لا تُقبل لك صلاة أربعين صباحاً","cause":"لا يَشرَبُ الخَمْرَ رَجُلٌ من أُمَّتي","result":"فتُقبَلُ له صَلاةٌ أربَعين صَباحًا","explicit":true,"repOf":"س-03970","ref":"المستدرك على الصحيحين 960","text":["عنِ ابنِ الدَّيلَمِيِّ الَّذي كان يَسكُنُ بَيتَ المَقدِسِ: أنَّه رَكِب في طَلَبِ عَبدِ اللهِ بنِ عَمرِو بنِ العاصي بالمَدينةِ، فسَأل عنه فقالوا: قد سار إلى مَكَّةَ، فاتَّبَعَه فوَجَدَه قد سار إلى الطَّائفِ، فاتَّبَعَه فوَجَدَه في زَرعِه الَّذي يُسَمَّى الوَهْطَ، قالَ ابنُ الدَّيلَميِّ: فدَخَلتُ عليه فوَجَدتُه يَمشي مُخاصِرًا رَجُلًا من قُرَيشٍ، والقُرَشِيُّ يُزَنُّ بالخَمرِ، فلَمَّا لَقِيتُه سَلَّمتُ عليه وسَلَّم عَلَيَّ، فقالَ: ما غَدَا بكَ، ومن أين أقبَلْتَ؟ وأخبَرتُه ثمَّ سَألتُه: هل سَمِعتَ -يا عَبدَ اللهِ بنَ عَمرٍو- رَسولَ الله صلَّى اللهُ عليه وسلَّمَ ذَكَر شَرابَكَ الخَمرَ بشَيءٍ؟ قالَ: نَعَم، فانتَزَع القُرَشيُّ يَدَه ثمَّ ذَهَب، فقالَ: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["لا يَشرَبُ الخَمْرَ رَجُلٌ من أُمَّتي",1]," ",["فتُقبَلُ له صَلاةٌ أربَعين صَباحًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (3377)، وأحمد (6644)، والدارمي (2136) جميعهم بلفظ مقارب.","bab":"علم › حسن السؤال ونصح العالم","dorar":"kcUaT8PE","merged":2,"otherRefs":["تخريج المسند لشعيب 6854 (صحيح)"]},{"id":"س-01833","fp":"80d2f17afe59","stateId":554,"easy":"إذا أتيت عرافاً فسألته فصدقته ← لم تُقبل لك صلاة أربعين يوماً","cause":"مَن أَتَى عَرَّافًا فسأله عن شيءٍ فصَدَّقَهُ بما قال","result":"لم تُقْبَلْ له صلاةٌ أَرْبَعِينَ يومًا","explicit":true,"ref":"غاية المرام 284","srcLabel":"غاية المرام","text":[["مَن أَتَى عَرَّافًا فسأله عن شيءٍ فصَدَّقَهُ بما قال ",1],["لم تُقْبَلْ له صلاةٌ أَرْبَعِينَ يومًا",2]],"grade":"صحيح","narrator":"بعض أزواج النبي صلى الله عليه وسلم","muhaddith":"صحيح","bab":"إحسان › إبطال الأعمال","dorar":"d00r0dp9"},{"id":"س-03963","fp":"e6853a551baf","stateId":554,"easy":"إذا شربت شربة خمر ← لا يقبل الله لك توبة أربعين صباحاً","cause":"مَن شَرِبَ شَرْبةَ خَمْرٍ","result":"لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه","explicit":true,"similar":["س-03989","س-04954"],"ref":"تخريج المسند لشاكر 10/128","srcLabel":"النسائي","text":["دَخَلْتُ على عبْدِ اللهِ بنِ عمْرٍو وهوَ في حائِطٍ له بالطَّائفِ يُقالُ لهُ: الوَهْطُ، وهوَ مُخاصِرٌ فتًى مِن قُرَيشٍ يُزَنُّ بشُرْبِ الخَمْرِ، فقُلْتُ: بَلَغَني عنْكَ حَديثٌ: أنَّه ",["مَن شَرِبَ شَرْبةَ خَمْرٍ ",1],["لمْ يَقْبَلِ اللهُ له تَوْبةً أرْبَعينَ صَباحًا، وأنَّ الشَّقِيَّ مَن شَقِيَ في بَطْنِ أُمِّه ، وأنَّه ",2],"مَن أتَى بَيتَ المَقْدِسِ لا يَنْهَزُه إلَّا الصَّلاةُ فيهِ، خَرَجَ مِن خَطِيئَتِه مِثْلَ يَوْمِ وَلَدَتْه أُمُّه، فلمَّا سَمِعَ الفَتَى ذِكْرَ الْخَمْرِ، اجْتَذَب يَدَهُ مِن يَدِه، ثمَّ انطَلَقَ، ثمَّ قال عَبدُ اللهِ بنُ عَمْرٍو: إنِّي لا أُحِلُّ لأحَدٍ أنْ يَقولَ علَيَّ ما لمْ أقُلْ؛ سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يَقولُ: مَن شربَ منَ الخمرِ شَربةً لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ لم تُقبَلْ لَهُ صلاةٌ أربعينَ صباحًا، فإن تابَ تابَ اللَّهُ عليهِ ، فإن عادَ قالَ : فلا أدري في الثَّالثةِ أو في الرَّابعةِ - فإن عادَ كانَ حقًّا على اللَّهِ أن يُسقيَهُ من رَدغةِ الخبالِ يومَ القيامةِ قالَ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ اللَّهَ عزَّ وجلَّ خلقَ خلقَهُ في ظلمةٍ، ثمَّ ألقَى عليهِم من نورِهِ يومئذٍ، فمَن أصابَهُ من نورِهِ يومئذٍ، اهتَدى، ومَن أخطأَهُ، ضلَّ فلذلِكَ أقولُ : جفَّ القلمُ على علمِ اللَّهِ عزَّ وجلَّ وسَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : إنَّ سُلَيْمانَ بنَ داودَ عليهِ السَّلامُ سألَ اللَّهَ ثلاثًا، فأعطاهُ اثنتَينِ، ونحنُ نرجو أن تَكونَ لَهُ الثَّالثةُ : فسألَهُ حُكْمًا يصادِفُ حُكْمَهُ، فأعطاهُ اللَّهُ إيَّاهُ، وسألَهُ مُلكًا لا ينبَغي لأحَدٍ من بَعدِهِ، فأعطاهُ إيَّاهُ، وسألَهُ أيُّما رجلٍ خَرجَ من بيتِهِ لا يريدُ إلَّا الصَّلاةَ في هذا المسجدِ خرجَ من خَطيئتِهِ مثلَ يومِ ولدتهُ أمُّهُ، فَنحنُ نرجو أن يَكونَ اللَّهُ عزَّ وجلَّ قد أَعطاهُ إيَّاهُ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (693، 5664) مفرقاً مختصراً باختلاف يسير، وابن ماجه (1408، 3377) مفرقاً مختصراً باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"ktDNR7No"},{"id":"س-03989","fp":"6c30664fcf08","stateId":554,"easy":"إذا شربت الخمر ← لا يقبل الله لك صلاة أربعين ليلة","cause":"مَن شرِبَ الخَمرَ","result":"لم يَقبَلِ اللهُ له صلاةً أربعينَ ليلةً، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ كان مِثلَ ذلك، فما أَدْري أفي الثالثةِ أَمْ في الرابعةِ","explicit":true,"repOf":"س-03963","otherNeedIds":[69],"ref":"تخريج المسند لشعيب 21502","text":[["مَن شرِبَ الخَمرَ ",1],["لم يَقبَلِ اللهُ له صلاةً أربعينَ ليلةً، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ كان مِثلَ ذلك، فما أَدْري أفي الثالثةِ أَمْ في الرابعةِ",2]," قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: فإنْ عادَ كان حَتْمًا على اللهِ أنْ يَسقيَه من طينةِ الخَبالِ، قالوا: يا رسولَ اللهِ، وما طينةُ الخَبالِ؟ قال: عُصارةُ أهلِ النارِ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (21502) واللفظ له، والبزار (4074)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (5/71)","bab":"توبة › الحض على التوبة","dorar":"SzWBGUi3"},{"id":"س-04006","fp":"830024ee0816","stateId":554,"easy":"إذا شربت الخمر ← لا تُقبل لك صلاة أربعين يوماً","cause":"مَن شرِب الخمرَ","result":"لم تُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الثانيةَ لم تُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الثالثةَ لم يُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الرابعةَ لم يُقبَلْ له توبةٌ ، وكان حقًّا على اللهِ عزَّ وجلَّ أن يسقيَه مِن طينةِ الخبالِ ، قيل : ما طينةُ الخبالِ","explicit":true,"repOf":"س-03970","otherNeedIds":[69],"ref":"إتحاف الخيرة المهرة 4/ 380","text":[["مَن شرِب الخمرَ ",1],["لم تُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الثانيةَ لم تُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الثالثةَ لم يُقبَلْ له صلاةٌ أربعينَ يومًا ، فإن تاب تاب اللهُ عليه ، فإن عاد الرابعةَ لم يُقبَلْ له توبةٌ ، وكان حقًّا على اللهِ عزَّ وجلَّ أن يسقيَه مِن طينةِ الخبالِ ، قيل : ما طينةُ الخبالِ ؟",2]," قال : ما يخرُجُ مِن صديدِ أهلِ النارِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3377) وأحمد (6773) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"AULOS1Bl"},{"id":"س-04205","fp":"00fb7f4f2e91","stateId":554,"easy":"إذا شربت مسكراً ← تُبخس صلاتك أربعين صباحاً","cause":"ومَن شَرِبَ مُسكِرًا","result":"بُخِسَتْ صَلاتُه أربَعينَ صَباحًا، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ الرَّابِعةَ كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ. قيل: وما طينةُ الخَبالِ يا رَسولَ اللَّهِ","explicit":true,"otherNeedIds":[69],"ref":"تخريج سنن أبي داود 3680","srcLabel":"البيهقي","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ قال: كُلُّ مُخمَّرٍ خَمرٌ، وكُلُّ مُسكِرٍ حَرامٌ، ",["ومَن شَرِبَ مُسكِرًا ",1],["بُخِسَتْ صَلاتُه أربَعينَ صَباحًا، فإنْ تابَ تابَ اللهُ عليه، فإنْ عادَ الرَّابِعةَ كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ. قيل: وما طينةُ الخَبالِ يا رَسولَ اللَّهِ؟",2]," قال: صَديدُ أهلِ النارِ، ومَن سَقاهُ صَغيرًا لا يَعرِفُ حَلالَه مِن حَرامِه، كان حَقًّا على اللهِ أنْ يَسقيَه مِن طينةِ الخَبالِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (17807)","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"4Br3CQG3"},{"id":"س-04218","fp":"b111a7cf1690","stateId":554,"easy":"إذا شربت الخمر ← لا تُقبل لك صلاة أربعين ليلة","cause":"ما من أحدٍ يشربُها","result":"فتُقبَلُ له صلاةٌ أربعينَ ليلةً ، ولايموتُ وفي مَثْناتِه منه شيءٌ إلاحَرَّمتُ بها عليه الجنَّةَ ، فإن مات في أربعينَ ليلةٍ ؛ مات مِيتَةً جاهليَّةً","explicit":true,"repOf":"س-03970","otherNeedIds":[71],"ref":"صحيح الترغيب 2370","text":["إنَّ ملِكًا  من ملوكِ بني إسرائيلَ أخذ رجلًا فخيَّره بين أن يشربَ الخمرَ ، أويقتل نفسًا ، أويزني ، أويأكلَ لحمَ خِنزيرٍ ، أو يقتلوه [ إن أبى ] . فاختار الخمرَ ، وإنه لما شرب الخمرَ لم يمتنعْ من شيءٍ أرادوه منه وإنَّ رسولَ اللهِ قال لنا [ حينئذٍ ] : ",["ما من أحدٍ يشربُها",1]," ",["فتُقبَلُ له صلاةٌ أربعينَ ليلةً ، ولايموتُ وفي مَثْناتِه منه شيءٌ إلاحَرَّمتُ بها عليه الجنَّةَ ، فإن مات في أربعينَ ليلةٍ ؛ مات مِيتَةً جاهليَّةً",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (363)، والحاكم (7236) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"xRIQLCop"},{"id":"س-04954","fp":"73e2a5068e82","stateId":554,"easy":"إذا شربت الخمر ← لا يقبل الله منك صلاة أربعين يوماً","cause":"ومَن شَرِبَها","result":"لم يَقبَلِ اللهُ منه صَلاةً أربَعينَ يَومًا، فإنْ ماتَ وهي في بَطنِه ماتَ مِيتةً جاهِليَّةً","explicit":true,"repOf":"س-03963","otherNeedIds":[22],"ref":"تخريج سنن الدارقطني 4610","text":["الخَمرُ أُمُّ الخَبائِثِ، ",["ومَن شَرِبَها ",1],["لم يَقبَلِ اللهُ منه صَلاةً أربَعينَ يَومًا، فإنْ ماتَ وهي في بَطنِه ماتَ مِيتةً جاهِليَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3667)، والواحدي في ((التفسير الوسيط)) (309) باختلاف يسير، والحاكم (7236) مطولاً بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"qE4lVPVl"},{"id":"س-07667","fp":"ed06b13d8541","stateId":554,"easy":"إذا شربت الخمر فجعلتها في بطنك ← لم تُقبل منك صلاة سبعاً","cause":"من شرِب الخمرَ فجعلها في بطنِه","result":"لم تُقبلْ منه صلاةٌ سبعًا وإن مات فيها مات كافرًا فإن أذهبت عقلَه عن كلِّ شيءٍ من الفرائضِ","explicit":true,"ref":"الترغيب والترهيب 3/257","srcLabel":"النسائي","text":[["من شرِب الخمرَ فجعلها في بطنِه ",1],["لم تُقبلْ منه صلاةٌ سبعًا وإن مات فيها مات كافرًا فإن أذهبت عقلَه عن كلِّ شيءٍ من الفرائضِ",2]," وفي روايةٍ عن القرآنِ لم تُقبلْ منه صلاةٌ أربعين يومًا وإن مات فيها مات كافرًا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي (5669)، والبزار (2378) باختلاف يسير، وابن حبان في ((المجروحين)) (2/451) باختلاف يسير.","bab":"قدر › العمل بالخواتيم","dorar":"TyccTGIc"},{"id":"س-07670","fp":"defd52aa7d37","stateId":554,"easy":"إذا شربت الخمر ولو لم تسكر ← لا تُقبل لك صلاة ما دام في جوفك منها شيء","cause":"من شرب الخمرَ فلم ينتشِ","result":"لم تقبلْ له صلاةٌ ما دام في جوفِه أو عروقِه منها شيءٌ ، وإن مات مات كافرًا ، وإن انتشى ؛ لم تُقبلْ له صلاةٌ أربعين يومًا","explicit":true,"ref":"صحيح الترغيب 2383","srcLabel":"صحيح الترغيب","text":["عن ابنِ عمرَ قال : ",["من شرب الخمرَ فلم ينتشِ ؛ ",1],["لم تقبلْ له صلاةٌ ما دام في جوفِه أو عروقِه منها شيءٌ ، وإن مات مات كافرًا ، وإن انتشى ؛ لم تُقبلْ له صلاةٌ أربعين يومًا",2]," ، وإن مات فيها ؛ مات كافرًا"],"grade":"صحيح","muhaddith":"صحيح","bab":"قدر › العمل بالخواتيم","dorar":"R9Dyw5gW"},{"id":"س-04338","fp":"4d6c15dfeabd","stateId":554,"easy":"إذا شربت مسكراً أو بهت مؤمناً أو عملت خطيئة في رمضان ← يحبط الله عملك سنة","cause":"ومن شربَ فيهِ مسكرًا أو رمى فيهِ مؤمنًا ببهتانٍ وعملَ فيهِ خطيئةً","result":"أحبطَ اللَّهُ عملَهُ سنةً","explicit":true,"ref":"مجمع الزوائد 3/147","srcLabel":"أحمد","text":["إنَّ الجنَّةَ لتزيَّنُ منَ السَّنةِ إلى السَّنةِ لشهرَ رمضانَ فإذا دخلَ شهرُ رمضانُ قالتِ الجنَّةُ اللَّهمَّ اجعل لنا في هذا الشَّهرِ من عبادِكَ سكَّانًا ويقلنَ الحورُ العينُ اللَّهمَّ اجعل لنا من عبادِكَ في هذا الشَّهرِ أزواجًا قالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ فمن صانَ نفسَهُ في شهرِ رمضانَ فلم يشرب فيهِ مسكرًا ولم يرمِ فيهِ مؤمنًا بالبهتانِ ولم يعمل [فيهِ] خطيئةً زوَّجَهُ اللَّهُ كلَّ ليلةٍ مائةً حوراءَ وبنى لهُ قصرًا في الجنَّةِ من ذهبٍ وفضَّةٍ وياقوتٍ وزبرجدٍ لو أنَّ الدُّنيا جمعت فجعلت في ذلكَ القصرِ لم تكن فيهِ إلَّا كمربطِ عنزٍ في الدُّنيا ",["ومن شربَ فيهِ مسكرًا أو رمى فيهِ مؤمنًا ببهتانٍ وعملَ فيهِ خطيئةً",1]," ",["أحبطَ اللَّهُ عملَهُ سنةً",2]," فاتَّقوا شهرَ رمضانَ فإنَّهُ شهرُ اللَّهِ أن تفرِّطوا فيهِ فقد جعلَ اللَّهُ لكم أحدَ عشرَ شهرًا تنعمونَ فيها [وتلذُّونَ] وجعلَ لنفسِهِ شهرَ رمضانَ فاحذروا شهرَ رمضان"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"[فيه] أحمد بن أبيض  ولم أجد من ترجمه وبقية رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3688) واللفظ له، وتمام في ((الفوائد)) (1127)، وابن عساكر في ((تاريخ دمشق)) (51/225)","bab":"جنة › نساء الجنة","dorar":"nYlUe9Rr"},{"id":"س-08371","fp":"cff1a753f37b","stateId":555,"easy":"إذا آذيت السابقين الأولين وأبناءهم ← لا يُقبل منك صرف ولا عدل","cause":"أُوصيكم بالسَّابِقينَ الأوَّلينَ من المُهاجِرينَ وبأبنائِهم مِن بَعدِهم، إلَّا تَفعَلوا","result":"لا يُقبَلُ منكم صَرْفٌ ولا عَدْلٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"در السحابة 39","srcLabel":"الطبراني","text":["لمَّا حَضَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم قالوا: يا رسولَ اللهِ، أوْصِنا، قال: ",["أُوصيكم بالسَّابِقينَ الأوَّلينَ من المُهاجِرينَ وبأبنائِهم مِن بَعدِهم، إلَّا تَفعَلوا",1]," ",["لا يُقبَلُ منكم صَرْفٌ ولا عَدْلٌ",2],"."],"grade":"حسن","narrator":"عبدالرحمن بن عوف","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (874)، واللفظ له، والبزار في ((البحر الزخار)) (1022)، والمحاملي -رواية ابن يحيى البيع-(397)، باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"BoeCz5no"},{"id":"س-00416","fp":"54a4c782335f","stateId":555,"easy":"إذا خلفت مجاهداً في أهله بسوء ← يُقام لك يوم القيامة فيأخذ من حسناتك ما شاء","cause":"وما مِن قاعدٍ يخلُفُ مجاهدًا في أهلِه بسوءٍ","result":"إلَّا أُقيم له يومَ القيامةِ فيُقالُ له: هذا خلَفك في أهلِكَ بسوءٍ فخُذْ مِن حسناتِه","explicit":true,"star":true,"otherNeedIds":[70],"ref":"تخريج صحيح ابن حبان 4635","srcLabel":"مسلم","text":["حرمةُ نساءِ المجاهدينَ على القاعدينَ كحُرمةِ أمَّهاتِهم ",["وما مِن قاعدٍ يخلُفُ مجاهدًا في أهلِه بسوءٍ",1]," ",["إلَّا أُقيم له يومَ القيامةِ فيُقالُ له: هذا خلَفك في أهلِكَ بسوءٍ فخُذْ مِن حسناتِه",2]],"grade":"صحيح","narrator":"بريدة","muhaddith":"إسناده صحيح على شرط مسلم","bab":"آداب عامة › الأخلاق المذمومة","dorar":"UN18ljDt"},{"id":"س-07859","fp":"ff1d24c66521","stateId":555,"easy":"إذا خلفت غازياً في أهله فخنته ← يقال يوم القيامة: خذ من حسناته ما شئت","cause":"وإذا خلَّفَه في أَهلِهِ فخانَه","result":"قيلَ لَه يومَ القيامةِ : هذا خانَك في أَهلِك فخُذْ من حسناتِه ما شئتَ","explicit":true,"otherNeedIds":[70],"ref":"صحيح النسائي 3190","srcLabel":"مسلم","text":["حُرمةُ نساءِ المجاهدينَ على القاعدينَ كحرمةِ أمَّهاتِهم ، ",["وإذا خلَّفَه في أَهلِهِ فخانَه",1]," ",["قيلَ لَه يومَ القيامةِ : هذا خانَك في أَهلِك فخُذْ من حسناتِه ما شئتَ",2]," فما ظنُّكُم"],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3190) واللفظ له، ومسلم (1897)، وأبو داود (2496) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"zO5mlOQZ"},{"id":"س-08455","fp":"7908d9c87fdc","stateId":555,"easy":"إذا أعطيت خصمك من الدنيا ← أحب من أن يأخذ من حسناتك يوم القيامة","cause":"إن أعطيتُهُ مِن متاعِ الدُّنيا","result":"أحبُّ إليَّ من أن يأخُذَ مِن حسَناتي يومَ القِيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[70],"ref":"نخب الافكار 16/480","srcLabel":"متفق عليه","text":["عنْ عُبادةَ بنِ الوَليدِ بنِ عُبادةَ بن الصَّامتِ قالَ: خرَجتُ أَنا وأبي، نَطلبُ هذا العِلمَ في هذا الحيِّ منَ الأنصارِ، قبلَ أن يَهْلِكوا فَكانَ أوَّلَ مَن لَقينا، أبو اليَسَرِ صاحبُ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ومعَهُ غلامٌ لَهُ، وعَليهِ بُردةُ معافريٍّ، وعلى غلامِهِ بردةُ معافريٍّ . قالَ: فقلتُ لَهُ: يا عمُّ، لو أخذتَ بردةَ غلامِكَ، فأعطيتَهُ معافريَّكَ، أو أخَذتَ معافريَّهُ، وأعطيتَهُ بُردَكَ، فَكانت عليكَ حلَّةٌ، وعليهِ حلَّةٌ . قالَ: فَمسحَ رَأسي وقالَ: اللَّهمَّ بارِكْ فيهِ . ثمَّ قالَ: يا ابنَ أَخي أبصَرَتْ عَينايَ هاتانِ، وسَمِعَتْ أذُنايَ هاتانِ، ووَعاهُ قَلبي مِن رَسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ وَهوَ يقولُ: أطعِموهم مِمَّا تأكُلونَ، واكسوهُم مِمَّا تَلبَسون فَكانَ ",["إن أعطيتُهُ مِن متاعِ الدُّنيا",1]," ",["أحبُّ إليَّ من أن يأخُذَ مِن حسَناتي يومَ القِيامةِ",2]],"grade":"صحيح","narrator":"أبو اليسر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (7312) بلفظه، ومسلم (300) مطولا باختلاف يسير، والبخاري في ((الأدب المفرد)) (187) مختصرا.","bab":"نفقة › نفقة الرقيق والرفق بهم والإحسان إليهم","dorar":"xAWvMnKf","merged":2,"otherRefs":["صحيح مسلم 3007 (صحيح)"]},{"id":"س-04983","fp":"2571df3a0208","stateId":555,"easy":"إذا ضيّقت المنزل وقطعت الطريق في الغزو ← فلا جهاد لك","cause":"مَن ضَيَّقَ مَنزِلًا، وقَطَعَ طَريقًا","result":"فلا جِهادَ له","explicit":true,"ref":"الأحكام الوسطى 3/ 35","srcLabel":"أبو داود","text":["غَزَوْنا معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ غَزْوةَ كَذا وكَذا، فضَيَّقَ النَّاسُ المَنازِلَ، وقَطَعوا الطَّريقَ، فبَعَثَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مُنادِيًا يُنادي في النَّاسِ: أنَّ ",["مَن ضَيَّقَ مَنزِلًا، وقَطَعَ طَريقًا",1],"، ",["فلا جِهادَ له",2],"."],"grade":"صحيح","narrator":"معاذ الجهني","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2629) واللفظ له، وأحمد (15648)، وأبو يعلى (1483) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sTIKjRPa","merged":4,"otherRefs":["تخريج مشكل الآثار 44 (صحيح)","هداية الرواة 3843 (صحيح)","الأحكام الشرعية الصغرى 526 (صحيح)"]},{"id":"س-01192","fp":"28006aecf83e","stateId":555,"easy":"إذا مت وعليك دين ← يُؤخذ لصاحبه من حسناتك","cause":"ومن ماتَ وعليهِ دَيْنٌ","result":"أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ","explicit":true,"otherNeedIds":[70],"ref":"تخريج المسند لشاكر 7/255","srcLabel":"أحمد","text":["عن أيوب بن سلمان رجل من أهل صنعاء قال: كنَّا بمكةَ فجلسنا إلى عطاءٍ الخراسانيِّ إلى جنبِ جدارِ المسجدِ فلم نسألْه ولم يُحدِّثْنا قال ثم جلسنا إلى ابنِ عمرَ مثلَ مجلسِكم هذا فلمْ نسألْه ولم يُحدِّثْنا قال فقال ما بالُكم لا تتكلَّمونَ ولا تذكرونَ اللهَ قولوا اللهُ أكبرُ والحمدُ للهِ وسبحانَ اللهِ وبحمدِهِ بواحدةٍ عشرًا وبعشرٍ مائةً من زادَ زادهُ اللهُ ومن سكتَ غُفِرَ لهُ ألا أُخبرُكم بخمسٍ سمعتهنَّ من رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ؟ قالوا : بَلَى قال من حالتْ شفاعتُهُ دونَ حَدٍّ من حدودِ اللهِ فهو مُضَادُّ اللهِ في أمرِهِ ومن أعانَ على خصومةٍ بغيرِ حقٍّ فهو مُستظلٌّ في سخطِ اللهِ حتى يتركَ ومن قَفَا مؤمنًا أو مؤمنةً حبسهُ اللهُ في رَدْغَةِ الخَبَالِ عصارةِ أهلِ النارِ ",["ومن ماتَ وعليهِ دَيْنٌ",1]," ",["أُخِذَ لصاحبِه من حسناتِه لا دينارَ ثَمَّ ولا درهمَ",2]," وركعتا الفجرِ، حافظوا عليهما فإنَّهما من الفضائلِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5544)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2sGjBDac"},{"id":"س-03769","fp":"469479ac5724","stateId":555,"easy":"إذا قتلت مؤمناً فاغتبطت بقتله ← لا يقبل الله منك صرفاً ولا عدلاً","cause":"مَن قتَل مؤمنًا؛ فاغتبَطَ بقتلِهِ","result":"لم يقبَلِ اللهُ منه صرْفًا ولا عدلًا","explicit":true,"ref":"صحيح أبي داود 4270","srcLabel":"أبو داود","text":["كلُّ ذنْبٍ عسى اللهُ أن يغفِرَه، إلَّا مَن مات مُشركًا، أو مؤمِنٌ قتل مؤمِنًا مُتعمِّدًا. وعن عبادةَ بنِ الصامتِ رَضِيَ اللهُ عنه، عن رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ، أنه قال: ",["مَن قتَل مؤمنًا؛ فاغتبَطَ بقتلِهِ، ",1],["لم يقبَلِ اللهُ منه صرْفًا ولا عدلًا",2],". وعن أبي الدرداءِ رَضِيَ اللهُ عنه، عن رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ، أنه قال: لا يَزالُ المؤمِنُ مُعْنِقًا صالحًا ما لم يُصِبْ دمًا حرامًا، فإذا أصابَ دمًا حرامًا بَلَّحَ."],"grade":"صحيح","narrator":"أبو الدرداء وعبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4270)، وعبد الغني المقدسي في ((تحريم القتل)) (701) واللفظ لهما، والطبراني في ((الشاميين)) (1309) عن أبي الدرداء وحده، واللفظ لهم.","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"FUs9boL5"},{"id":"س-05002","fp":"413181b56a8f","stateId":555,"easy":"إذا ظلمت أحداً ← تُؤخذ من حسناتك فيُعطاها المظلوم","cause":"قد ظلَمه بمَظلَمةٍ","result":"فتُؤخَذُ من حسَناتِه، فيُعطى المظلومُ حتَّى لا يبقى له حسَنةٌ، ثمَّ يجيءُ من يطلُبه ولم يَبقَ من حسَناتِه شيءٌ، فيُؤخَذُ من سيِّئاتِ المظلومِ فتُوضَعُ على سيِّئاتِه","explicit":true,"otherNeedIds":[70],"ref":"المصابيح في الأحاديث المتواترة 627","srcLabel":"المصابيح في الأحاديث المتواترة","text":["يجيءُ الرَّجُلُ يومَ القيامةِ من الحَسَناتِ ما يَظُنُّ أنَّه ينجو بها، فلا يزالُ رجُلٌ يجيءُ ",["قد ظلَمه بمَظلَمةٍ",1]," ",["فتُؤخَذُ من حسَناتِه، فيُعطى المظلومُ حتَّى لا يبقى له حسَنةٌ، ثمَّ يجيءُ من يطلُبه ولم يَبقَ من حسَناتِه شيءٌ، فيُؤخَذُ من سيِّئاتِ المظلومِ فتُوضَعُ على سيِّئاتِه",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"9x3ydmpw"},{"id":"س-02546","fp":"35c3f43d8f45","stateId":555,"easy":"إذا ظلمت الناس ← تُمحى حسناتك حتى لا تبقى لك حسنة","cause":"إنَّ فلانًا ظَلَمَني مَظْلمَةً","result":"امْحوا مِن حسناتِهِ، حتَّى لا يَبْقى له حسنةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[70],"ref":"المستدرك على الصحيحين 2255","srcLabel":"أحمد","text":["إنَّ إبليسَ يَئسَ أنْ تُعبَدَ الأصنامُ بأرضِ العربِ، ولكنَّه سيَرْضى بدونِ ذلك منكم بالمُحَقِّراتِ مِن أَعمالِكُم، وهي المُوبقاتُ، فاتَّقوا المَظالِمَ ما استَطَعْتُم؛ فإنَّ العبدَ يَجيءُ يومَ القيامةِ، وله مِنَ الحسناتِ ما يَرى أنَّه يُنَجِّيهِ، فلا يَزالُ عَبدٌ يقومُ، فيقولُ: يا ربِّ، ",["إنَّ فلانًا ظَلَمَني مَظْلمَةً",1],"، فيقالُ: ",["امْحوا مِن حسناتِهِ، حتَّى لا يَبْقى له حسنةٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7067) بلفظه، وأحمد (3818)، والحميدي (98) كلاهما بلفظ مقارب.","bab":"إيمان › أعمال الجن والشياطين","dorar":"hPUAcThG"},{"id":"س-07915","fp":"b4a6fe75ab34","stateId":556,"easy":"إذا صليت بغير طهور أو تصدقت من غلول ← لا يُقبل منك","cause":"صَلاةٌ بغيرِ طُهورٍ، ولا صَدَقةٌ مِن غُلولٍ","result":"لا تُقبَلُ","explicit":true,"star":true,"ref":"صحيح مسلم 224","srcLabel":"متفق عليه","text":["دَخَلَ عبدُ اللهِ بنُ عُمَرَ على ابنِ عامِرٍ يَعودُه وهو مَريضٌ، فقال: ألا تَدعو اللهَ لي يا ابنَ عُمَرَ؟ قال: إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["لا تُقبَلُ",2]," ",["صَلاةٌ بغيرِ طُهورٍ، ولا صَدَقةٌ مِن غُلولٍ",1],". وكُنتَ على البَصرةِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"zcRG5WUI","merged":6,"otherRefs":["شرح ابن ماجه لمغلطاي 1/45 (صحيح)","تخريج المسند لشعيب 4700 (صحيح)","صحيح ابن خزيمة 1/ 126 (صحيح)","تخريج المسند لشاكر 7/217 (صحيح)","تخريج صحيح ابن حبان 3366 (صحيح)"]},{"id":"س-05148","fp":"ef2a25259062","stateId":556,"easy":"إذا كسبت مالاً حراماً فتصدقت منه ← لا يُقبل منك وما بقي زادك إلى النار","cause":"إنْ تَصدَّقَ","result":"لمْ يُقبَلْ منه، وما بَقِي كان زادَهُ إلى النَّارِ","explicit":true,"otherNeedIds":[70],"ref":"المستدرك على الصحيحين 2169","srcLabel":"البيهقي","text":["لا يُغبَطَنَّ جامِعُ المالِ مِن غيرِ حِلِّه -أوْ قالَ: مِن غيرِ حقِّهِ-؛ فإنَّه ",["إنْ تَصدَّقَ ",1],["لمْ يُقبَلْ منه، وما بَقِي كان زادَهُ إلى النَّارِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو العباس السراج في ((حديثه)) (2612)، والبيهقي في ((شعب الإيمان)) (5138) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bSVrBA9V"},{"id":"س-06182","fp":"7b9f2f814556","stateId":556,"easy":"إذا جمعت مالاً حراماً ثم تصدقت به ← لا أجر لك وكان إثمه عليك","cause":"ومَن جمعَ مالًا حرامًا، ثمَّ تَصدَّقَ بِهِ","result":"لم يَكُن لَهُ فيهِ أجرٌ، وَكانَ أجرُهُ علَيهِ","explicit":true,"ref":"صحيح ابن خزيمة 4/ 186","srcLabel":"ابن حبان","text":["إذا أدَّيتَ زَكاةَ مالِكَ، فقد قضَيتَ ما عليكَ، ",["ومَن جمعَ مالًا حرامًا، ثمَّ تَصدَّقَ بِهِ ",1],["لم يَكُن لَهُ فيهِ أجرٌ، وَكانَ أجرُهُ علَيهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن حبان (3216)، والحاكم (1440)، وابن الجارود في ((المنتقى)) (336) باختلاف يسير.","bab":"زكاة › فرض الزكاة","dorar":"Hf8Wo0hz"},{"id":"س-01835","fp":"9f2ffa765b21","stateId":556,"easy":"إذا كسبت مالاً حراماً فأعتقت منه ووصلت رحمك ← كان ذلك إصراً عليك","cause":"مَنْ كَسَبَ مالًا حَرَامًا فَأعتقَ مِنْهُ ، ووَصَلَ رحمَهُ","result":"كان ذلكَ إصْرًا عليهِ","explicit":true,"ref":"صحيح الترغيب 1720","srcLabel":"قاضي","text":[["مَنْ كَسَبَ مالًا حَرَامًا فَأعتقَ مِنْهُ ، ووَصَلَ رحمَهُ ؛ ",1],["كان ذلكَ إصْرًا عليهِ ",2],"."],"grade":"حسن","narrator":"عامر بن واثلة أبو الطفيل","muhaddith":"حسن لغيره","takhrij":"أخرجه قاضي المارستان في ((مشيخته)) (445) واللفظ له.","bab":"إحسان › إبطال الأعمال","dorar":"6qeS688D"},{"id":"س-07074","fp":"1e225b7d6df8","stateId":556,"easy":"إذا كسبت من حرام فتزوجت وحججت منه ← فكسبك خبيث وحجك خبيث (أثر ابن عمر)","cause":"أكنِسُ حتى تَزَوَّجْتُ وعتَقْتُ وحجَجْتُ","result":"أنتَ خَبِيثٌ وعِتْقُكَ خَبِيثٌ وحَجُّكَ خَبِيثٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إرشاد الفقيه 2/416","srcLabel":"البيهقي","text":["سمعتُ ابنَ عمرَ وأتاه رجلٌ فقال : إني كنتُ ",["أكنِسُ حتى تَزَوَّجْتُ وعتَقْتُ وحجَجْتُ",1]," قال : ما كنتَ تكنِسُ ؟ قال : العذِرَةُ قال : ",["أنتَ خَبِيثٌ وعِتْقُكَ خَبِيثٌ وحَجُّكَ خَبِيثٌ",2]," اخرجْ مِنْهُ كَمَا دَخَلْتَ فِيهِ"],"grade":"صحيح","narrator":"أسيد بن أبي أسيد الساعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (12098)","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"ZQ86EiCi"},{"id":"س-01839","fp":"257cbc916b83","stateId":556,"easy":"إذا تعاملت بالربا ← يبطل عملك (من واقعة)","cause":"بثمانِمائةٍ نَسِيئةً، واشترَتْهُ منه بسِتِّمائةٍ نقدًا","result":"قد بطَل جهادُهُ مع رسولِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج زاد المعاد 3/373","srcLabel":"البيهقي","text":["أنَّ امرأةً أتَتْ عائشةَ، فسأَلَتْها عن عبدٍ باعَتْهُ مِن زيدِ بنِ أرقَمَ ",["بثمانِمائةٍ نَسِيئةً، واشترَتْهُ منه بسِتِّمائةٍ نقدًا",1],"، فقالت عائشةُ رضي اللهُ عنها: بئسَ ما اشترَيْتَ، وبئسَ ما ابتَعْتِ، أبلِغي زيدًا أنَّه ",["قد بطَل جهادُهُ مع رسولِ اللهِ",2]," صلَّى اللهُ عليه وسلَّمَ، إلا أن يتوبَ."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله ثقات","takhrij":"أخرجه البيهقي (10900) بلفظه، وعبد الرزاق (14812)، والدارقطني (3002) كلاهما بمعناه.","bab":"إحسان › إبطال الأعمال","dorar":"QPVSoAbi"},{"id":"س-06457","fp":"3ad56f087e59","stateId":557,"easy":"إذا حسدت ← يطفئ الحسد نور حسناتك","cause":"إنَّ الحَسَدَ","result":"يُطفِئُ نورَ الحَسَناتِ","explicit":true,"star":true,"similar":["س-05584"],"ref":"الأحاديث المختارة 2178","srcLabel":"البخاري","text":["«أنَّه دخل هو وأبوه على أنَسِ بنِ مالِكٍ بالمدينةِ زَمانَ عُمَرَ بنِ عَبدِ العزيزِ وهو أميرٌ، وهو يُصَلِّي صلاةً خَفيفةً [دفيفةً] كأنهَّا صلاةُ مُسافِرٍ، أو قريبًا منها، فلمَّا سَلَّم قال: يَرْحمُك اللهُ، أرأيتَ هذه الصَّلاةُ المكتوبةُ أم شَيءٌ تنَفَّلْتَه؟ قال: إنَّها المكتوبةُ، وإنَّها صلاةُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ما أخطَأْتُ إلَّا شيئًا سَهَوتُ عنه، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَقولُ: لا تُشَدِّدوا على أنفُسِكم فيُشَدَّدَ عليكم؛ فإنَّ قَومًا شَدَّدوا على أنفُسِهم فشُدِّد عليهم، فتلك بقاياهم في الصَّوامِعِ والدِّياراتِ، {وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ}.\nثمَّ غَدَوا مِنَ الغَدِ فقالوا: نركَبُ فنَنظُرُ ونعتَبِرُ، قال: نَعَم، فرَكِبوا جميعًا فإذا هم بديارٍ قَفرٍ قد باد أهْلُها وانقَرَضوا وفَنُوا خاويةً على عُروشِها، قالوا: أتعرِفُ هذه الدِّيارَ؟ قال: ما أعرَفَني بها وبأهْلِها! هؤلاء أهلُ الدِّيارِ، أهلَكَهم البَغْيُ والحَسَدُ، ",["إنَّ الحَسَدَ",1]," ",["يُطفِئُ نورَ الحَسَناتِ",2],"، والبَغْيَ يُصَدِّقُ ذلك أو يُكَذِّبُه، والعَينُ تَزْني والكَفُّ والقَدَمُ والجسَدُ واللِّسانُ، والفَرْجُ يُصَدِّقُ ذلك أو يُكَذِّبُه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"ZSzCyCiM"},{"id":"س-07424","fp":"c742e50be1a4","stateId":557,"easy":"إذا قطعت رحمك ← لا يُقبل عملك","cause":"تُعْرَضُ علَى اللهِ","result":"فلا يُقْبَلُ عملُ قاطِعِ رحِمِ","explicit":true,"star":true,"ref":"الجامع الصغير 2203","srcLabel":"البخاري","text":["إِنَّ أعمالَ بني آدمَ ",["تُعْرَضُ علَى اللهِ",1]," تعالى عَشِيَّةَ كُلِّ خميسٍ ليْلَةَ الجمعَةِ ، ",["فلا يُقْبَلُ عملُ قاطِعِ رحِمِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (61) واللفظ له بزيادة قصة في أوله، وأخرجه أحمد (10272) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (7966) باختلاف يسير بزيادة قصة في أوله","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"RF6MkLTV"},{"id":"س-05584","fp":"a9e468508774","stateId":557,"easy":"إذا حسدت ← يأكل الحسد حسناتك كما تأكل النار الحطب","cause":"وإنَّ الحسدَ","result":"ليأكُلُ الحسناتِ كما تأكُلُ النَّارُ الحطَبَ","explicit":true,"repOf":"س-06457","ref":"الترغيب والترهيب 4/31","text":["ما ذئبان جائعان أُرسِلا في زَريبةِ غنَمٍ بأفسدَ لها من الحرصِ على المالِ والحسَدِ في دينِ المسلمِ ، ",["وإنَّ الحسدَ",1]," ",["ليأكُلُ الحسناتِ كما تأكُلُ النَّارُ الحطَبَ",2]],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2376)، وأحمد (15794) باختلاف يسير، وابن أبي الدنيا في ((إصلاح المال)) (14) واللفظ له","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"ydq4kIW9","merged":2,"otherRefs":["الأحكام الوسطى 4/ 267 (صحيح)"]},{"id":"س-01617","fp":"e86cefdc7cd6","stateId":557,"easy":"إذا ساء خلقك ← يفسد عملك كما يفسد الخل العسل","cause":"و إِنَّ سُوءَ الخُلُقِ","result":"يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ","explicit":true,"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [",["و إِنَّ سُوءَ الخُلُقِ",1]," ",["يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ",2],"]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-07353","fp":"687423f43e91","stateId":557,"easy":"إذا ماريت ← يورث المراء الشك ويحبط العمل","cause":"ذروا المراءَ","result":"فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ","explicit":true,"otherNeedIds":[21],"ref":"النوافح العطرة 148","srcLabel":"النوافح العطرة","text":["ذَروا المِراءَ [يعني حديث: خرج علينا رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ونحن نتمارى في شيءٍ منَ الدِّينِ فغضب غضبًا شديدًا لم يغضبْ مثلَه ثم انتهرَنا فقال يا أمةَ محمدٍ لا تُهيِّجوا على أنفسِكم وهجَ النارِ ثم قال بهذا أمرتُكم أو ليس عن هذا نهيتُكم أليس قد كان هلك من كان قبلكم بهذا ثم قال ",["ذروا المراءَ",1]," لقلةِ خيرِه ذروا المراءَ فإنَّ نفعَه قليلٌ ويُهيِّجُ العداءَ بينَ الإخوانِ ذروا المراءَ فإنَّ المراءَ لا تؤمنُ فتنتُه ذروا المراءَ ",["فإنَّ المراءَ يورثُ الشكَّ ويحبطُ العملَ",2]," ذروا المراءَ فإنَّ المؤمنَ لا يُماري ذروا المِراءِ فإنَّ المُماريَ قد تمت خسارتُه ذروا المراءَ فكفاك إثمًا أن لا تزال مُماريًا ذروا المراءَ فإنَّ المُماريَ لا أشفعُ له يومَ القيامةِ ذروا المراءَ فأنا زعيمٌ بثلاثةِ أبياتٍ في الجنةِ في وسَطِها ورياضِها وأعلاها لمن يتركُ المراءَ وهو صادقٌ ذروا المراءَ فإنَّ أولَ ما نهاني عنه ربي عَزَّ وَجَلَّ بعد عبادةِ الأوثانِ وشربِ الخمرِ المراءُ ذروا المراءَ فإنَّ الشيطانَ قد أَيِسَ أن يُعبدَ ولكنه رضيَ منكم بالتَّحريشِ وهو المراءُ في الدِّينِ ذروا المراءَ فإنَّ بني إسرائيلَ افترقوا على إحدى وسبعين فرقةً والنصارى على اثنتين وسبيعن فرقةً وإنَّ أمتي ستفترقُ على ثلاثةٍ وسبعين فرقةً كلِّهم على الضلالةِ إلا السوادَ الأعظمَ قالوا يا رسولَ اللهِ وما السوادُ الأعظمُ قال ما أنا عليه وأصحابي مَنْ لم يمارِ في دينِ اللهِ ولم يكفِّرْ أحدًا من أهلِ التوحيدِ بذنبٍ ثم قال إنَّ الإسلامَ بدأ غريبًا وسيعودُ كما بدأ فطُوبى للغرباءِ قالوا يا رسولَ اللهِ ومَنِ الغرباءُ قال الذين يَصلُحون إذا فسد الناسُ ولا يمارون في دينِ اللهِ ولا يكفِّرون أحدًا مِنْ أهلِ التوحيدِ بذنبٍ]"],"grade":"صحيح","narrator":"[أبو الدرداء وأبو أمامة الباهلي وأنس بن مالك وواثلة بن الأسقع]","muhaddith":"صحيح","bab":"فتن › كراهية الاختلاف","dorar":"TMkPFVlz"},{"id":"س-04762","fp":"2523dd4b835f","stateId":558,"easy":"إذا لم تدع قول الزور والعمل به في صومك ← فليس لله حاجة في ترك طعامك وشرابك","cause":"من لم يدَع قولَ الزُّورِ ، والعملَ بِهِ","result":"فلَيسَ للَّهِ حاجةٌ أن يدعَ طعامَهُ وشرابَهُ","explicit":true,"star":true,"similar":["س-04776"],"ref":"صحيح أبي داود 2362","srcLabel":"البخاري","text":[["من لم يدَع قولَ الزُّورِ ، والعملَ بِهِ ، ",1],["فلَيسَ للَّهِ حاجةٌ أن يدعَ طعامَهُ وشرابَهُ ",2],"، وقالَ أحمدُ : فَهِمْتُ إسنادَهُ من ابنِ أبي ذئبٍ ، وأفهَمَني الحديثَ رجلٌ إلى جنبِهِ أراهُ ابنَ أخيهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1903)، وأبو داود (2362) واللفظ له، والترمذي (707)، والنسائي في ((السنن الكبرى)) (3246)، وابن ماجه (1689)، وأحمد (10562)","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"ufGesHnW","merged":4,"otherRefs":["صحيح الجامع 6539 (صحيح)","الأحكام الشرعية الصغرى 390 (صحيح)","صحيح ابن ماجه 1379 (صحيح)"]},{"id":"ق-0565","fp":"f81743e05b93","stateId":558,"easy":"الإفساد ← لا يصلح الله عملهم","cause":"الإفساد","result":"لا يصلح الله عملهم","explicit":true,"ref":"سورة يونس: 81","srcLabel":"القرآن الكريم","quran":{"s":10,"from":81,"to":81,"text":"فَلَمَّا أَلْقَوْا قَالَ مُوسَى مَا جِئْتُمْ بِهِ السِّحْرُ إِنَّ اللَّهَ سَيُبْطِلُهُ إِنَّ اللَّهَ لَا يُصْلِحُ عَمَلَ الْمُفْسِدِينَ (81)","hl":[[87,135,1]]}},{"id":"ق-1223","fp":"af16c671361f","stateId":558,"easy":"معصية الله ورسوله ← إبطال الأعمال","cause":"معصية الله ورسوله","result":"إبطال الأعمال","explicit":true,"ref":"سورة محمد: 33","srcLabel":"القرآن الكريم","quran":{"s":47,"from":33,"to":33,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ وَلَا تُبْطِلُوا أَعْمَالَكُمْ (33)","hl":[[31,102,1]]}},{"id":"ق-1243","fp":"a9248f312747","stateId":558,"easy":"رفع الصوت فوق صوت النبي ﷺ والجهر له بالقول ← حبوط العمل دون شعور","cause":"رفع الصوت فوق صوت النبي ﷺ والجهر له بالقول","result":"حبوط العمل دون شعور","explicit":true,"ref":"سورة الحجرات: 2","srcLabel":"القرآن الكريم","quran":{"s":49,"from":2,"to":2,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَرْفَعُوا أَصْوَاتَكُمْ فَوْقَ صَوْتِ النَّبِيِّ وَلَا تَجْهَرُوا لَهُ بِالْقَوْلِ كَجَهْرِ بَعْضِكُمْ لِبَعْضٍ أَنْ تَحْبَطَ أَعْمَالُكُمْ وَأَنْتُمْ لَا تَشْعُرُونَ (2)","hl":[[31,202,1]]}},{"id":"س-07798","fp":"d939cdc991f5","stateId":558,"easy":"إذا لم تجب الدعوة ← فلا شيء لك","cause":"ومَن لم يُجِبْ","result":"فلا شيءَ له","explicit":true,"ref":"مجمع الزوائد 8/39","srcLabel":"أحمد","text":["تعلَّموا القرآنَ فإذا علِمْتُموه فلا تغلُوا فيه ولا تجفُوا عنه ولا تأكُلوا به ولا تستكثِروا به ثُمَّ قال إنَّ التُّجَّارَ همُ الفُجَّارُ قالوا يا رسولَ اللهِ أليس قد أحلَّ اللهُ البيعَ وحرَّم الرِّبا قال بلى ولكنَّهم يحلِفونَ ويأثَمونَ ثُمَّ قال إنَّ الفُسَّاقَ هم أهلُ النَّارِ قالوا يا رسولَ اللهِ مَن الفُسَّاقُ قال النِّساءُ قالوا أو ليس أمَّهاتِنا وبناتِنا وأخواتِنا قال بلى ولكنَّهنَّ إذا أُعطِينَ لم يشكُرْنَ وإن ابتُلِينَ لم يصبِرْنَ ثُمَّ قال يُسلِّمُ الرِّاكبُ على الرَّاجلِ والرَّاجلُ على الجالسِ والأقلُّ على الأكثرِ فمَن أجاب السَّلامَ كان له ",["ومَن لم يُجِبْ",1]," ",["فلا شيءَ له",2]],"grade":"صحيح","narrator":"عبدالرحمن بن شبل","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15704)، وعبد بن حميد في ((مسنده)) (314)، والبيهقي (2362)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"1qQvD5R8","merged":2,"otherRefs":["صحيح الأدب المفرد 763 (صحيح)"]},{"id":"س-02679","fp":"7516d78d5bad","stateId":558,"easy":"إذا حكمت بغير ما أنزل الله وأنت إمام ← لا يقبل الله صلاتك","cause":"صَلاةَ إمامٍ حَكَمَ بغَيرِ ما أنْزَلَ اللهُ تعالَى","result":"لا يَقبَلُ اللهُ","explicit":true,"ref":"المستدرك على الصحيحين 7203","srcLabel":"الحاكم","text":["ألَا أَيُّها النَّاسُ، ",["لا يَقبَلُ اللهُ",2]," ",["صَلاةَ إمامٍ حَكَمَ بغَيرِ ما أنْزَلَ اللهُ تعالَى",1],"."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"صحيح الإسناد","bab":"إيمان › الحكم بما أنزل الله","dorar":"1lqLs1x0"},{"id":"س-04832","fp":"b92831196cdd","stateId":558,"easy":"إذا خلوت بمحارم الله فانتهكتها ← تأتي بحسنات كالجبال فيجعلها الله هباءً","cause":"إذا خَلَوْا بمحارمِ اللهِ انتهَكوها","result":"يأتونَ يومَ القيامةِ بحسناتٍ أمثالِ جبالِ تِهامةَ بيضاءَ، فيجعلُها اللهُ هباءً منثورًا","explicit":true,"ref":"السلسلة الصحيحة 505","srcLabel":"السلسلة الصحيحة","text":["لَأعلَمنَّ أقوامًا من أمَّتي ",["يأتونَ يومَ القيامةِ بحسناتٍ أمثالِ جبالِ تِهامةَ بيضاءَ، فيجعلُها اللهُ هباءً منثورًا",2],"، قال ثَوْبانُ رَضِيَ اللهُ عنه: يا رسولَ اللهِ، صِفْهم لنا، جَلِّهم لنا ألَّا نكونَ منهم، ونحنُ لا نعلَمُ، قال: أَمَا إنَّهم إخوانُكم، ومِن جِلْدَتِكم، ويأخُذونَ منَ اللَّيلِ كما تأخُذونَ، ولَكِنَّهم أقوامٌ ",["إذا خَلَوْا بمحارمِ اللهِ انتهَكوها",1],"."],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Tpn7hxZY"},{"id":"س-01842","fp":"f88bcd8843f3","stateId":558,"easy":"إذا عملت بالمعاصي بعد الطاعة ← تغرق أعمالك كلها","cause":"فعمِلَ بالمَعاصي","result":"حتَّى أغرَقَ أعْمالَه كلَّها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 6453","srcLabel":"الحاكم","text":["أنَّ عُمَرَ بنَ الخطَّابِ رَضيَ اللهُ عنه تَلا هذه الآيةَ {أَيَوَدُّ أَحَدُكُمْ أَنْ تَكُونَ لَهُ جَنَّةٌ مِنْ نَخِيلٍ وَأَعْنَابٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ لَهُ فِيهَا مِنْ كُلِّ الثَّمَرَاتِ} [البقرة: 266] إلى {فَأَصَابَهَا إِعْصَارٌ فِيهِ نَارٌ فَاحْتَرَقَتْ} [البقرة: 266] فسألَ عنها القَومَ، وقالَ: فيما ترَوْنَ أُنزِلَتْ {أَيَوَدُّ أَحَدُكُمْ أَنْ تَكُونَ لَهُ جَنَّةٌ} [البقرة: 266]؟ فقالوا: اللهُ ورَسولُه أعلَمُ، فغضِبَ عُمَرُ وقالَ: قولوا: نَعلَمُ أو لا نَعلَمُ، فقالَ ابنُ عبَّاسٍ: في نَفْسي شَيءٌ منها يا أميرَ المُؤمِنينَ، قالَ: يا ابنَ أخي قُلْ، ولا تَحقِرْ نفْسَكَ، قالَ ابنُ عبَّاسٍ: ضُرِبَتْ مثلًا لعمَلٍ، فقالَ عُمَرُ: رَجُلٌ غَنيٌّ يَعمَلُ الحَسَناتِ، ثمَّ بعَثَ اللهُ له الشَّياطينَ ",["فعمِلَ بالمَعاصي",1]," ",["حتَّى أغرَقَ أعْمالَه كلَّها",2],"، وكانتْ له جنَّةٌ فاحتَرَقَتْ عندَ أحْوَجِ ما كانَ إليها حينَ كثُرَ الولَدُ، وبلَغَ هو الكِبَرَ، قالَ: أوَنَسِيَ أحَدُكم أنْ يوافيَ يومَ القيامةِ عَبدٌ أفقَرُ ما كانَ إلى عمَلِه فلا يوافي له شَيءٌ."],"grade":"صحيح","narrator":"ابن أبي مليكة","muhaddith":"صحيح على شرط الشيخين","bab":"إحسان › إبطال الأعمال","dorar":"Wsabvb6y","merged":2,"otherRefs":["صحيح البخاري 4538 (صحيح)"]},{"id":"س-00637","fp":"1a3363716d6f","stateId":558,"easy":"إذا صمت واغتبت الناس ← فقد صمت عن الحلال وأفطرت على الحرام","cause":"امرأتيْنِ صائمتيْنِ تغتابانِ الناسُ","result":"صامتا عنِ الحلالِ وأفطرتا على الحرامِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[13],"ref":"المحلى 6/178","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ أتى على ",["امرأتيْنِ صائمتيْنِ تغتابانِ الناسُ",1]," ، فقال لهما : قِيئا ، فقاءَتا قيحًا ودمًا ولحمًا عبيطًا ، ثم قال عليْهِ السلامُ : ها إنَّ هاتيْنِ ",["صامتا عنِ الحلالِ وأفطرتا على الحرامِ",2]],"grade":"صحيح","narrator":"عبيد مولى رسول الله صلى الله عليه وسلم","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه أبو يعلى (1576) بنحوه، وأحمد (23653)، وابن شيبة (662) بنحوه وزيادة","bab":"آداب عامة › ضرب الأمثال","dorar":"LG6InNqH"},{"id":"س-01840","fp":"0a249435bc64","stateId":558,"easy":"إذا قذفت محصنة ← يهدم عمل مئة سنة","cause":"قَذْفَ المُحصَنةِ","result":"لَيَهدِمُ عمَلَ مائةِ سنَةٍ","explicit":true,"ref":"التنوير شرح الجامع الصغير 4/31","srcLabel":"الحاكم","text":["إنَّ ",["قَذْفَ المُحصَنةِ",1]," ",["لَيَهدِمُ عمَلَ مائةِ سنَةٍ",2],"."],"grade":"حسن","narrator":"حذيفة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (2929) بلفظه، والحاكم (8712) بلفظه وفي أوله زيادة.","bab":"إحسان › إبطال الأعمال","dorar":"gJSaZXst"},{"id":"س-02485","fp":"c29536b89683","stateId":558,"easy":"إذا أمرت بالحق وعملت بالباطل ← يوشك أن يحبط عملك","cause":"فمن أمرَ بالحقِّ وعمل بالباطلِ وأمر بالمعروفِ وعمل بالمنكرِ","result":"يوشكُ أن تنقطعَ منيَّتُه و أن يحبطَ به عملُه","explicit":true,"ref":"مجمع الزوائد 5/200","srcLabel":"الطبراني","text":["لما أراد أبو بكرٍ أن يستخلفَ عمرَ بعث إليه فدعاه فأتاه فقال إني أدعوك إلى أمرٍ متعِبٍ لِمَن وَلِيَه فاتقِ اللهَ يا عمرُ بطاعتِه وأطِعْه بتقواه فإن التقَى أمرٌ محفوظٌ ثم إن الأمرَ معروضٌ لا يستوجِبُه إلا مَن عمِل به ",["فمن أمرَ بالحقِّ وعمل بالباطلِ وأمر بالمعروفِ وعمل بالمنكرِ",1]," ",["يوشكُ أن تنقطعَ منيَّتُه و أن يحبطَ به عملُه",2]," فإنْ أنت وُلِّيت عليهم أمرَهم فإن استطعت أن تَجِفَّ يدَيك من دمائِهم وأن تُضمِرَ بطنَك من أموالِهم وأن تَجِفَّ لسانَك عن أعراضِهم فافعلْ ولا قوةَ إلا باللهِ"],"grade":"حسن","narrator":"الأغر المزني أبو مالك","muhaddith":"الأغر لم يدرك أبا بكر ، وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (1/59) (37)، وابن عساكر في ((تاريخ دمشق)) (30/412)","bab":"إمامة وخلافة › الاستخلاف","dorar":"UM7q78Sk"},{"id":"س-02939","fp":"3557ebe826b1","stateId":558,"easy":"إذا تعلمت صرف الكلام لتسبي به قلوب الناس ← لا يقبل الله منك يوم القيامة صرفاً ولا عدلاً","cause":"من تعلَّمَ صرفَ الكلامِ ليسبِيَ بِه قلوبَ الرِّجالِ أوِ النَّاسِ","result":"لم يقبلِ اللَّهُ منهُ يومَ القيامةِ صرفًا ولا عدلًا","explicit":true,"ref":"هداية الرواة 4/370","srcLabel":"أبو داود","text":[["من تعلَّمَ صرفَ الكلامِ ليسبِيَ بِه قلوبَ الرِّجالِ أوِ النَّاسِ ",1],["لم يقبلِ اللَّهُ منهُ يومَ القيامةِ صرفًا ولا عدلًا",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5006)، والبيهقي في ((شعب الإيمان)) (4974)","bab":"إيمان › الوعيد","dorar":"WmhBEqAY"},{"id":"س-04776","fp":"26b301a78d7e","stateId":558,"easy":"إذا لم تدع الفحش والكذب في صومك ← فلا حاجة لله في ترك طعامك","cause":"من لم يدعِ الخنا والْكذبَ","result":"فلا حاجةَ للَّهِ أن يدعَ طعامَهُ وشرابَهُ","explicit":true,"repOf":"س-04762","ref":"فتح الباري لابن حجر 4/140","text":[["من لم يدعِ الخنا والْكذبَ",1]," [",["فلا حاجةَ للَّهِ أن يدعَ طعامَهُ وشرابَهُ",2],"]"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3622)، وابن عدي في ((الكامل في الضعفاء)) (5/345)، والشجري في ((ترتيب الأمالي)) (1530) مطولاً","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"TasxxNIY"},{"id":"س-03722","fp":"6772e65a60fa","stateId":559,"easy":"إذا عملت عملاً ليس عليه أمر النبي ﷺ ← فهو رد","cause":"مَن عمِلَ عَمَلًا ليس عليه أمْرُنا","result":"فهو رَدٌّ","explicit":true,"star":true,"similar":["س-03683"],"ref":"تخريج المسند لشعيب 26191","srcLabel":"متفق عليه","text":["عن القاسِمِ بنِ مُحمَّدٍ، سُئِلَ عن رَجُلٍ أوْصى بثَلاثِ مَساكِنَ له، فقال القاسِمُ: يُخرَجُ ذاك حتى يُجعَلَ في مَسكَنٍ واحِدٍ، وقد سَمِعتُ عائِشةَ تقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن عمِلَ عَمَلًا ليس عليه أمْرُنا ",1],["فهو رَدٌّ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (2697) بنحوه، ومسلم (1718) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"GX9CJFfz","merged":3,"otherRefs":["صحيح ابن حبان 26 (صحيح)","صحيح أبي داود 4606 (صحيح)"]},{"id":"س-01852","fp":"c685011e1671","stateId":559,"easy":"إذا ذبحت قبل صلاة العيد ← فإنما تذبح لنفسك (لا أضحية)","cause":"مَن ذَبَحَ قَبلَ الصَّلاةِ","result":"فإنَّما يَذبَحُ لنَفسِه","explicit":true,"star":true,"ref":"صحيح البخاري 5556","srcLabel":"متفق عليه","text":["ضَحَّى خالٌ لي يُقالُ له أبو بُردةَ، قَبلَ الصَّلاةِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: شاتُكَ شاةُ لَحمٍ، فقال: يا رَسولَ اللهِ، إنَّ عِندي داجِنًا جَذَعةً مِنَ المعزِ، قال: اذبَحْها، ولَن تَصلُحَ لغَيرِكَ، ثُمَّ قال: ",["مَن ذَبَحَ قَبلَ الصَّلاةِ",1]," ",["فإنَّما يَذبَحُ لنَفسِه",2],"، ومَن ذَبَحَ بَعدَ الصَّلاةِ فقد تَمَّ نُسُكُه وأصابَ سُنَّةَ المُسلِمينَ، تابَعَه عُبَيدةُ، عَنِ الشَّعبيِّ، وإبراهيمَ، وتابَعَه وكيعٌ، عن حُرَيثٍ، عَنِ الشَّعبيِّ، وقال عاصِمٌ، وداوُدُ، عَنِ الشَّعبيِّ: عِندي عَناقُ لَبَنٍ، وقال زُبَيدٌ، وفِراسٌ، عَنِ الشَّعبيِّ: عِندي جَذَعةٌ، وقال أبو الأحوصِ: حَدَّثَنا مَنصورٌ: عَناقٌ جَذَعةٌ، وقال ابنُ عَونٍ: عَناقٌ جَذَعٌ، عَناقُ لَبَنٍ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري(5556)، ومسلم (1961)","bab":"إحسان › الأخذ بالرخصة","dorar":"VRPKck0I","merged":2,"otherRefs":["صحيح مسلم 1961 (صحيح)"]},{"id":"س-03683","fp":"3c091ec9adfc","stateId":559,"easy":"إذا فعلت شيئاً ليس عليه أمر النبي ﷺ ← فهو مردود","cause":"من فعل شيئًا ليس عليه أمرُنا","result":"فهو مردودٌ","explicit":true,"repOf":"س-03722","ref":"حلية الأولياء 3/202","text":[["من فعل شيئًا ليس عليه أمرُنا ",1],["فهو مردودٌ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح ثابت من حديث سعد عن القاسم متفق عليه [أي:بين العلماء] غريب من حديث عبد الواحد بن أبي عون","takhrij":"أخرجه البخاري (2697)، ومسلم (1718) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"A97K2cCx"},{"id":"س-03735","fp":"ba5f1ed46a08","stateId":559,"easy":"إذا صنعت أمراً على غير أمرنا ← فهو رد","cause":"من صَنع أمرًا على غيرِ أمرِنا","result":"فهوَ ردٌّ","explicit":true,"ref":"صحيح أبي داود 4606","srcLabel":"متفق عليه","text":["مَن أحدَث في أمرِنا ما ليسَ فيهِ فهوَ ردٌّ . وفي لفظٍ : قال النَّبيُّ صلَّى اللهُ عليْهِ وسلَّمَ : ",["من صَنع أمرًا على غيرِ أمرِنا ",1],["فهوَ ردٌّ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2697)، ومسلم (1718)، وأبو داود (4606) واللفظ له، وابن ماجه (14)، وأحمد (26033)","bab":"اعتصام بالسنة › لزوم السنة","dorar":"2bDBPwia"},{"id":"س-01841","fp":"0154054efeed","stateId":559,"easy":"إذا بعت جلد أضحيتك ← فلا أضحية لك","cause":"مَنْ باعَ جِلدَ أُضحيَّتِهِ","result":"فلا أُضحيَّةَ له","explicit":true,"ref":"المستدرك على الصحيحين 3514","srcLabel":"البيهقي","text":["«",["مَنْ باعَ جِلدَ أُضحيَّتِهِ",1]," ",["فلا أُضحيَّةَ له",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (19259)، والديلمي في ((الفردوس)) (5509) واللفظ لهما","bab":"إحسان › إبطال الأعمال","dorar":"7IuJYRxy"},{"id":"س-01585","fp":"81152229961e","stateId":559,"easy":"إذا ذبحت قبل صلاة العيد ← فهو لحم لأهلك وليس نسكاً","cause":"من ذبحَ قبلَ الصَّلاةِ","result":"فإنَّما هوَ لحمٌ قدَّمَه لأَهلِه ليسَ منَ النُّسُك في شيءٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"حلية الأولياء 7/215","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ خطبَ يومَ النَّحرِ فقال إنَّ أوَّلَ ما نبدأُ بهِ في يومِنا هذا أن نصلِّيَ ثمَّ نرجعَ فننحرَ فمن فعلَ ذلِك فقد أصابَ سنَّتَنا و",["من ذبحَ قبلَ الصَّلاةِ",1]," ",["فإنَّما هوَ لحمٌ قدَّمَه لأَهلِه ليسَ منَ النُّسُك في شيءٍ",2]," فقامَ خالي أبو بردةَ بنُ نيَّارٍ - وَكانَ قد ذَبحَ قبلَ الصَّلاةِ - فقال يا رسولَ اللَّهِ عندي جذَعةٌ أحبُّ إليَّ من مُسنَّةٍ فقال ضحِّ بهِ ولن توفىَ - أو تجزِيَ - عن أحدٍ بعدَك"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح ثابت من حديث شعبة وحديث زبيد مشهور","takhrij":"أخرجه البخاري (965)، ومسلم (1961)، والنسائي (1563) باختلاف يسير.","bab":"أضاحي › سنة الأضحية","dorar":"ZBxpU2gL"},{"id":"س-08090","fp":"1247262f0e50","stateId":560,"easy":"إذا صمت في السفر (مع المشقة) ← فليس من البر","cause":"أنْ تصوموا في السَّفرِ","result":"ليس البِرُّ","explicit":true,"star":true,"ref":"صحيح ابن حبان 3553","srcLabel":"متفق عليه","text":["خرَجْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزاةِ تبوكَ وكانت تُدعى غزوةَ العُسرةِ فبينما نسيرُ بعدَما أضحى النَّهارُ فإذا هو بجماعةٍ تحتَ ظلِّ شجرةٍ فقالوا: يا رسولَ اللهِ رجلٌ صائمٌ فجهَده الصَّومُ فقال صلَّى اللهُ عليه وسلَّم: ( ",["ليس البِرُّ",2]," ",["أنْ تصوموا في السَّفرِ",1]," )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1946)، ومسلم (1115)، وأبو داود (2407) باختلاف يسير.","bab":"مغازي › غزوة تبوك","dorar":"rLprLJjI","merged":10,"otherRefs":["صحيح الترغيب 615 (صحيح)","صحيح أبي داود 2407 (صحيح)","صحيح مسلم 1115 (صحيح)","صحيح النسائي 2257 (صحيح)","الترغيب والترهيب 2/146 (صحيح)","حلية الأولياء 7/182 (صحيح)","تخريج المسند لشعيب 14794 (صحيح)","تخريج المسند لشعيب 15282 (صحيح)","تخريج المسند لشعيب 14410 (صحيح)"]},{"id":"س-04394","fp":"88f738161bb6","stateId":560,"easy":"إذا صمت الأبد ← فلا صمت","cause":"من صامَ الأبدَ","result":"لا صامَ","explicit":true,"star":true,"similar":["س-03688"],"ref":"صحيح ابن خزيمة 3/ 514","srcLabel":"مسلم","text":["بلغَ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ أنِّي أسرُدُ، وأصلِّي اللَّيلَ قالَ: وإمَّا أَرسلَ إليهِ، وإمَّا لقيَهُ، فقالَ: ألم أُخبَرْ أنَّكَ تَصومُ ولا تُفطرُ، وتصلِّي اللَّيلَ؟ فلا تفعَل ؛ فإنَّ لِعَينَيكَ حظًّا، ولنَفسِكَ حظًّا، ولأَهْلِكَ حظًّا، فصُم وأفطِر، وصلِّ ونَم، وصُم كلَّ عَشرةِ أيَّامٍ يومًا، ولَكَ أجرُ تِسعةٍ قالَ: فإنِّي أجِدُني أقوَى لذلِكَ يا رَسولَ اللَّهِ قالَ: فصُم صيامَ داودَ قالَ: وَكَيفَ كانَ داودُ يَصومُ يا رسولَ اللَّهِ؟ قالَ: كانَ يَصومُ يومًا، ويُفطِرُ يومًا، ولا يَفرُّ إذا لاقَى قالَ: مَن لي بِهَذِهِ يا نبيَّ اللَّهِ؟ قالَ عطاءٌ: فلا أدري كيفَ ذَكَرَ صيامَ الأبَدِ؟ فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["لا صامَ",2]," ",["من صامَ الأبدَ",1]," [وفي روايةٍ] قالَ: إنِّي أصومُ، أسردُ، وقالَ: فإمَّا أرسلَ إليَّ، وقالَ: إنِّي أجدُني أقوَى من ذلِكَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1159)، وأحمد (6874) النسائي (2401) باختلاف يسير","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"k5GsFwTs","merged":7,"otherRefs":["صحيح ابن خزيمة 3/ 445 (صحيح)","تخريج المسند لشعيب 27576 (صحيح)","الفتاوى الكبرى 2/ 139 (صحيح)","تخريج صحيح ابن حبان 6226 (صحيح)","صحيح النسائي 2382 (صحيح)","صحيح مسلم 1159 (صحيح)"]},{"id":"س-01851","fp":"ee882e2c8a78","stateId":560,"easy":"إذا صمت في السفر (مع المشقة) ← فليس من البر","cause":"الصَّومُ في السَّفَرِ","result":"ليس مِنَ البِرِّ","explicit":true,"star":true,"similar":["س-02684","س-01845"],"ref":"صحيح البخاري 1946","srcLabel":"متفق عليه","text":["كان رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في سَفَرٍ، فرَأى زِحامًا ورَجُلًا قد ظُلِّلَ عليه، فقال: ما هذا؟ فقالوا: صائِمٌ، فقال: ",["ليس مِنَ البِرِّ",2]," ",["الصَّومُ في السَّفَرِ",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1946)، ومسلم (1115)","bab":"إحسان › الأخذ بالرخصة","dorar":"CM68719a"},{"id":"س-02684","fp":"202ab09a0a43","stateId":560,"easy":"إذا صمت في السفر (مع المشقة) ← فليس من البر","cause":"امصيامُ في امسفَرِ","result":"ليس منَ امبِرِّ","explicit":true,"repOf":"س-01851","ref":"الإلزامات والتتبع 109","text":[["ليس منَ امبِرِّ",2]," ",["امصيامُ في امسفَرِ",1]],"grade":"صحيح","narrator":"كعب بن عاصم الأشعري","muhaddith":"[ يلزمهما إخراجه ] البخاري ومسلم","takhrij":"أخرجه النسائي (2255)، وابن ماجه (1664)، وأحمد (23679) واللفظ له","bab":"إيمان › الدين يسر","dorar":"EcbLBuvC"},{"id":"س-00820","fp":"8627fb2a84cb","stateId":560,"easy":"إذا صمت الدهر كله ← فلا صمت ولا أفطرت","cause":"يَصومُ الدَّهرَ","result":"لا صامَ، ولا أفطَرَ","explicit":true,"ref":"تخريج المسند لشعيب 16320","srcLabel":"مسلم","text":["أنَّهُ سألَ النَّبيَّ صَلَّى اللهُ عليه وسلَّمَ، أو سُئِلَ نَبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ عن رَجُلٍ ",["يَصومُ الدَّهرَ",1],"، فقال: ",["لا صامَ، ولا أفطَرَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن الشخير","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (2381)، وابن ماجه (1705)، وأحمد (16320) واللفظ له","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"i8sQT8Mz","merged":2,"otherRefs":["الأحاديث المختارة 9 / 471 (صحيح)"]},{"id":"س-03582","fp":"f85c0241d282","stateId":560,"easy":"إذا نذرت المشي الشاق ← فالله غني عن تعذيبك نفسك","cause":"نذَر أنْ يمشيَ","result":"إنَّ اللهَ لَغنيٌّ عن تعذيبِ هذا نفسَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-03116"],"ref":"صحيح ابن حبان 4382","srcLabel":"متفق عليه","text":["مرَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم برجلٍ يُهادى بينَ اثنينِ فسأَل عنه فقالوا: ",["نذَر أنْ يمشيَ",1]," ـ يعني إلى الكعبةِ ـ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["إنَّ اللهَ لَغنيٌّ عن تعذيبِ هذا نفسَه",2]," ) وأمَره أنْ يركَبَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1865)، ومسلم (1642) دون ذكر الكعبة","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"FagwPgiT","merged":5,"otherRefs":["صحيح البخاري 6701 (صحيح)","صحيح النسائي 3863 (صحيح)","صحيح النسائي 3861 (صحيح)","صحيح النسائي 3862 (صحيح)"]},{"id":"س-01845","fp":"ea3e1bf3e702","stateId":560,"easy":"إذا صمت في السفر (مع المشقة) ← فليس من البر","cause":"أن يُصامَ في سفرٍ","result":"لا برَّ","explicit":true,"repOf":"س-01851","ref":"صحيح الترغيب 1056","text":["لا بِرَّ ",["أن يُصامَ في سفرٍ",1]," [يعني حديث: سافرَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فنزلَ بأصحابِهِ وإذا ناسٌ قد جعلوا عريشًا على صاحبِهم وهوَ صائمٌ فمرَّ بهم رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ ما شأنُ صاحبِكم أوجِعٌ قالوا لا يا رسولَ اللَّهِ ولكنَّهُ صائمٌ وذلكَ في يومٍ حرورٍ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ",["لا برَّ",2]," أن يصامَ في سفرٍ]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الطبراني (14/83) (14693) مطولاً","bab":"إحسان › الأخذ بالرخصة","dorar":"4wkMHsEw"},{"id":"س-01854","fp":"ab666662bd77","stateId":560,"easy":"إذا صمت في السفر (مع المشقة) ← فأنت كالمفطر في الحضر","cause":"الصائمُ في السفَرِ","result":"كالمُفطِرِ في الحضَرِ","explicit":true,"similar":["س-02681"],"ref":"المحلى 6/257","srcLabel":"النسائي","text":["عن حُمَيدِ بنِ عبدِ الرحمنِ بنِ عَوفٍ عن أبيه قال: ",["الصائمُ في السفَرِ",1]," ",["كالمُفطِرِ في الحضَرِ",2]],"grade":"صحيح","narrator":"محمد بن مسلم بن شهاب الزهري","muhaddith":"إسناده في غاية الصحة","takhrij":"أخرجه النسائي (2286)، والطبري في ((جامع البيان)) (3/ 207) بلفظه.","bab":"إحسان › الأخذ بالرخصة","dorar":"f2HkCaUU"},{"id":"س-03688","fp":"aeb443f80030","stateId":560,"easy":"إذا صمت الأبد ← فلا صمت ولا أفطرت","cause":"منْ صامَ الأبدَ","result":"فلا صامَ و لا أفطرَ","explicit":true,"repOf":"س-04394","ref":"الجامع الصغير 8766","text":[["منْ صامَ الأبدَ،  ",1],["فلا صامَ و لا أفطرَ",2]],"grade":"صحيح","narrator":"عبدالله بن الشخير وعبدالله بن عمر وعمران وأبو قتادة","muhaddith":"صحيح","bab":"اعتصام بالسنة › لزوم السنة","dorar":"GTKVSYmv"},{"id":"س-03116","fp":"ab9cc6e07748","stateId":560,"easy":"إذا نذرت المشي الشاق ← فالله غني عن تعذيبك نفسك","cause":"نذَرَتْ أنْ تَحُجَّ ماشيةً","result":"فإنَّ اللهَ عزَّ وجلَّ عن تَعذيبِ أُختِكَ نفْسَها لَغَنيٌّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03582","ref":"تخريج المسند لشعيب 17291","text":["عن عبدِ اللهِ بنِ مالكٍ: أنَّ أختَ عُقْبةَ بنِ عامِرٍ ",["نذَرَتْ أنْ تَحُجَّ ماشيةً",1],"، فسَأل عُقْبةُ عن ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: مُرْها فلْتَرْكَبْ. فظَنَّ أنَّه لم يَفهَمْ عنه، فلمَّا خَلَا مَن كان عِندَه عاد فسألَه، فقال: مُرْها فلْتَرْكَبْ؛ ",["فإنَّ اللهَ عزَّ وجلَّ عن تَعذيبِ أُختِكَ نفْسَها لَغَنيٌّ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2134)، وأحمد (17291) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"WDkM1RFN","merged":5,"otherRefs":["تخريج المسند لشعيب 13866 (صحيح)","الأحاديث المختارة 11 / 351 (صحيح)","نخب الافكار 15/57 (صحيح)","مجموع الشروح الفقهية. 26/30 (حسن)"]},{"id":"س-02692","fp":"963ea973e083","stateId":560,"easy":"إذا حلفت أن تشق على نفسك ← فالله غني عن مشقتك","cause":"حَلَفت أنْ تَمشِيَ إلى البَيتِ","result":"فما أغنَى اللهُ أن يَشُقَّ على أُختِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8039","srcLabel":"الطبراني","text":["جاءَ رَجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فقالَ: إنَّ أُختي ",["حَلَفت أنْ تَمشِيَ إلى البَيتِ",1],"، وإنَّه يَشُقُّ عليها المَشيُ، قالَ: مُرْها فلْتَركَبْ؛ إذ لم تَستَطِعْ أنْ تَمشِيَ، ",["فما أغنَى اللهُ أن يَشُقَّ على أُختِكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (580)، والطبراني (11705) (11/  271)، وأبو بكر الإسماعيلي  (2/  641)","bab":"إيمان › الدين يسر","dorar":"VJt82tES"},{"id":"س-02681","fp":"d476b7358c95","stateId":560,"easy":"إذا صمت في السفر مع المشقة ← فهو كالإفطار في الحضر","cause":"الصِّيامُ في السَّفرِ","result":"كالإفطارِ في الحضَرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-01854","ref":"المحلى 6/257","text":["عن أبي سلمةَ بنِ عبدِ الرَّحمنِ بنِ عوفٍ عن أبيهِ قالَ : يقالُ : ",["الصِّيامُ في السَّفرِ",1]," ",["كالإفطارِ في الحضَرِ",2]],"grade":"صحيح","narrator":"محمد بن مسلم بن شهاب الزهري","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي (2284) واللفظ له، وابن ماجه (1666)، وابن أبي شيبة (8962) باختلاف يسير.","bab":"إيمان › الدين يسر","dorar":"2HvvjZDu"},{"id":"س-02688","fp":"317e3efef88e","stateId":560,"easy":"إذا نذرت ما يشق عليك ← فالله غني عن تعذيبك نفسك","cause":"نذرِ أُختكَ","result":"إنَّ اللهَ لَغنيٌّ عن","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)","واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 6/1038","srcLabel":"الترمذي","text":[". . . . ",["إنَّ اللهَ لَغنيٌّ عن",2]," ",["نذرِ أُختكَ",1]," . . . . ولْتَصُمْ ثلاثةَ أيامٍ"],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده [بغيره] جيد","takhrij":"أخرجه أبو داوود (3293) ، والنسائي (3815) والترمذي (1544) ، وابن ماجه (2134) جميعا بنحوه .","bab":"إيمان › الدين يسر","dorar":"wXGSW24S"},{"id":"س-00482","fp":"b90a9564dbc5","stateId":561,"easy":"إذا اقتنيت كلباً ليس للزرع أو الصيد أو الماشية ← ينقص من أجرك كل يوم قيراط","cause":"مَنِ اتَّخذَ كلبًا ، لَيسَ بِكَلبِ زَرعٍ ، ولا صَيدٍ ، ولا ماشيةٍ","result":"فإنَّهُ ينقصُ مِن أجرِهِ كلَّ يومٍ قيراطٌ","explicit":true,"star":true,"similar":["س-01847","س-00474","س-01848","س-03608","س-05030","س-03622"],"ref":"تخريج المسند لشاكر 16/227","srcLabel":"متفق عليه","text":[["مَنِ اتَّخذَ كلبًا ، لَيسَ بِكَلبِ زَرعٍ ، ولا صَيدٍ ، ولا ماشيةٍ ، ",1],["فإنَّهُ ينقصُ مِن أجرِهِ كلَّ يومٍ قيراطٌ ",2],"، قالَ سُلَيْمٌ : وأحسبُهُ قد قالَ : والقيراطُ مثلُ أُحُدٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (3324)، ومسلم (1575)، وأبو داود (2844)، والترمذي (1490)، والنسائي (4289)، وابن ماجه (3204)، وأحمد (8547) واللفظ له","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"Q0GbAMRS","merged":3,"otherRefs":["تخريج المسند لشاكر 7/245 (صحيح)","صحيح الجامع 6078 (صحيح)"]},{"id":"س-01847","fp":"2af84ee17c4a","stateId":561,"easy":"إذا اقتنيت كلباً لغير صيد أو ماشية ← ينقص من أجرك كل يوم قيراطان","cause":"مَنِ اقتنى كلبًا - إلَّا كلبًا ضاريًا بصَيدٍ، أو كَلبَ ماشيةٍ","result":"فإنَّهُ ينقُصُ مِن أجرِهِ كلَّ يومٍ قيراطانِ","explicit":true,"repOf":"س-00482","ref":"نخب الافكار 12/89","text":[["مَنِ اقتنى كلبًا - إلَّا كلبًا ضاريًا بصَيدٍ، أو كَلبَ ماشيةٍ - ",1],["فإنَّهُ ينقُصُ مِن أجرِهِ كلَّ يومٍ قيراطانِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[ورد] من عشر طرق صحاح","takhrij":"أخرجه البخاري (5480)، ومسلم (1574) باختلاف يسير","bab":"إحسان › الأخذ بالرخصة","dorar":"Cafjkz5J","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5653 (صحيح)"]},{"id":"س-05108","fp":"0614b81f9fd7","stateId":561,"easy":"إذا اتخذت كلباً لغير زرع أو ضرع أو صيد ← ينقص من عملك كل يوم قيراط","cause":"مَنِ اتَّخَذَ كَلْبًا غيرَ كَلْبِ زَرْعٍ أو ضَرْعٍ أو صَيدٍ","result":"نَقَصَ من عَمَلِه كُلَّ يَومٍ قيراطٌ","explicit":true,"similar":["س-01806","س-00484"],"ref":"تخريج المسند لشعيب 4813","srcLabel":"متفق عليه","text":[["مَنِ اتَّخَذَ كَلْبًا غيرَ كَلْبِ زَرْعٍ أو ضَرْعٍ أو صَيدٍ",1]," ",["نَقَصَ من عَمَلِه كُلَّ يَومٍ قيراطٌ",2],"، فقُلتُ لابن عُمَرَ: إنْ كان في دارٍ وأنا له كارِهٌ؟ قال: هو على رَبِّ الدَّارِ الذي يَملِكُها."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5481)، ومسلم (1574) بلفظ مقارب دون ذكر قول ابن عمر","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jgiU4iIE","merged":2,"otherRefs":["تخريج المسند لشعيب 20568 (صحيح)"]},{"id":"س-00474","fp":"32add70a73d8","stateId":561,"easy":"إذا اقتنيت كلباً لغير صيد أو ماشية أو زرع ← ينقص من أجرك كل يوم قيراط","cause":"مَن اتخَذَ كلبًا","result":"إلا كلبَ صيدٍ ، أو ماشيةٍ ، أو زَرْعٍ ، نَقَصَ مِن أجرِه كلَّ يومٍ قيراطٌ","explicit":true,"repOf":"س-00482","ref":"صحيح النسائي 4299","text":[["مَن اتخَذَ كلبًا ، ",1],["إلا كلبَ صيدٍ ، أو ماشيةٍ ، أو زَرْعٍ ، نَقَصَ مِن أجرِه كلَّ يومٍ قيراطٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (4289) واللفظ له، وأخرجه البخاري (3324)، ومسلم (1575) باختلاف يسير.","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"W8Od6zqR"},{"id":"س-01806","fp":"1a540be0f435","stateId":561,"easy":"إذا اقتنيت كلباً لا يغني في ضرع ولا زرع ← ينقص من عملك كل يوم قيراط","cause":"منِ اقتَنى كلبًا","result":"لا يُغني عنهُ في ضَرعٍ، ولا في زَرعٍ، نقَصَ مِن عملِهِ كلَّ يومٍ قيراطٌ","explicit":true,"repOf":"س-05108","ref":"نخب الافكار 12/92","text":[["منِ اقتَنى كلبًا، ",1],["لا يُغني عنهُ في ضَرعٍ، ولا في زَرعٍ، نقَصَ مِن عملِهِ كلَّ يومٍ قيراطٌ ",2],". قالَ: فَقالَ السَّائبُ: أأَنتَ سَمِعتَ هذا مِن رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ فقالَ: إي وَرَبِّ القِبلةِ"],"grade":"صحيح","narrator":"سفيان بن أبي زهير","muhaddith":"[ورد] من ثلاث طرق صحاح","takhrij":"أخرجه البخاري (2198)، ومسلم (1576)، ومالك (2/ 969) باختلاف يسير.","bab":"أيمان › لفظ اليمين وما يحلف به","dorar":"RSACf0bM"},{"id":"س-01848","fp":"95a34f26348e","stateId":561,"easy":"إذا اقتنيت كلباً إلا لصيد أو ماشية ← ينقص من عملك كل يوم قيراطان","cause":"مَنِ اقتَنَى كلْبًا","result":"إلَّا كلْبَ صَيدٍ أو ماشيةٍ، نَقَصَ مِن عمَلِه كلَّ يَومٍ قِيراطانِ","explicit":true,"repOf":"س-00482","ref":"تخريج المسند لشعيب 5254","text":[["مَنِ اقتَنَى كلْبًا، ",1],["إلَّا كلْبَ صَيدٍ أو ماشيةٍ، نَقَصَ مِن عمَلِه كلَّ يَومٍ قِيراطانِ",2],". قال عبدُ الرَّحمنِ: نُقِصَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5481)، ومسلم (1574) باختلاف يسير","bab":"إحسان › الأخذ بالرخصة","dorar":"u8RReRqG"},{"id":"س-01849","fp":"e3bee236d4a9","stateId":561,"easy":"إذا أمسكت كلباً (بلا حاجة) ← ينقص من عملك كل يوم قيراط","cause":"مَن أمْسَكَ كَلبًا","result":"نقَصَ مِن عَمَلِهِ كُلَّ يَومٍ قيراطٌ","explicit":true,"ref":"تخريج المسند لشعيب 10115","srcLabel":"متفق عليه","text":[["مَن أمْسَكَ كَلبًا",1],"، ",["نقَصَ مِن عَمَلِهِ كُلَّ يَومٍ قيراطٌ",2],"، إلَّا كَلبَ حَرْثٍ أو ماشيةٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2322)، ومسلم (1575) باختلاف يسير","bab":"إحسان › الأخذ بالرخصة","dorar":"n3PReWwZ"},{"id":"س-03608","fp":"e77ef7b137a6","stateId":561,"easy":"إذا اقتنيت كلباً إلا لماشية أو صيد ← ينقص من عملك كل يوم قيراطان","cause":"من اقْتَنَى كلبًا إلا كلبَ ماشيةٍ أو ضاريةٍ","result":"نَقُصَ من عملِهِ كلَّ يومٍ قيراطانِ","explicit":true,"repOf":"س-00482","ref":"تخريج المسند لشاكر 8/163","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أمرَ بقتلِ الكلابِ وقال : ",["من اقْتَنَى كلبًا إلا كلبَ ماشيةٍ أو ضاريةٍ",1]," ",["نَقُصَ من عملِهِ كلَّ يومٍ قيراطانِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (3323، 5480)، ومسلم (1571، 1574) مفرقاً باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"91rOVTjl"},{"id":"س-05030","fp":"954907e05215","stateId":561,"easy":"إذا أمسكت كلباً إلا لصيد أو ماشية ← ينقص من أجرك كل يوم قيراطان","cause":"مَن أمسكَ كلبًا","result":"إلا كلبًا ضاريًا ، أو كلبَ ماشيةٍ ، نَقَصَ مِن أجرِه كلَّ يومٍ قيراطان","explicit":true,"repOf":"س-00482","ref":"صحيح النسائي 4297","text":[["مَن أمسكَ كلبًا ، ",1],["إلا كلبًا ضاريًا ، أو كلبَ ماشيةٍ ، نَقَصَ مِن أجرِه كلَّ يومٍ قيراطان",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5481)، ومسلم (1574)، والترمذي (1487)، والنسائي (4286) واللفظ له، وأحمد (5171)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"h36vKSFs"},{"id":"س-00484","fp":"283f20b8c4ae","stateId":561,"easy":"إذا اقتنيت كلباً لا يُغني عنك زرعاً ولا ضرعاً ← ينقص من عملك كل يوم قيراط","cause":"مَنِ اقتَنى كَلبًا لا يُغني عنه زَرعًا ولا ضَرعًا","result":"نَقَصَ مِن عَمَلِه كُلَّ يَومٍ قيراطٌ","explicit":true,"repOf":"س-05108","ref":"صحيح البخاري 3325","text":[["مَنِ اقتَنى كَلبًا لا يُغني عنه زَرعًا ولا ضَرعًا، ",1],["نَقَصَ مِن عَمَلِه كُلَّ يَومٍ قيراطٌ",2],"، فقال السَّائِبُ: أنتَ سَمِعتَ هذا مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، قال: إي ورَبِّ هذه القِبلةِ."],"grade":"صحيح","narrator":"سفيان بن أبي زهير الأزدي","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1576)","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"Jure1alc"},{"id":"س-03622","fp":"783e97d5a645","stateId":561,"easy":"إذا اتخذ قوم كلباً ليس لصيد أو زرع أو ماشية ← ينقص من أجورهم كل يوم قيراط","cause":"وَأيُّما قَومٍ اتَّخَذوا كَلبًا ليس بِكَلبِ صَيدٍ، أو زَرعٍ، أو ماشِيةٍ","result":"نَقَصَ مِن أُجورِهم كُلَّ يَومٍ قيراطٌ","explicit":true,"repOf":"س-00482","ref":"تخريج المسند لشعيب 20571","text":["لَولا أنَّ الكِلابَ أُمَّةٌ مِنَ الأُمَمِ، لَأمَرتُ بِقَتْلِها، فاقتُلوا الأسوَدَ البَهيمَ، ",["وَأيُّما قَومٍ اتَّخَذوا كَلبًا ليس بِكَلبِ صَيدٍ، أو زَرعٍ، أو ماشِيةٍ؛ ",1],["نَقَصَ مِن أُجورِهم كُلَّ يَومٍ قيراطٌ",2],". \nوقالَ رَسولُ اللهِ صلَّى اللهُ عليهِ وسَلَّمَ: صَلُّوا في مَرابِضِ الغَنَمِ، وَلَا تُصَلُّوا في مَبارِكِ الإبِلِ؛ فإنَّها خُلِقَتْ مِنَ الشَّياطينِ."],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2845) مختصراً، والترمذي (1489)، والنسائي (4280) باختلاف يسير، وابن ماجه (3205، 769) مفرقاً، وأحمد (20571) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"XZcsRttF","merged":2,"otherRefs":["صحيح الترغيب 3102 (صحيح)"]},{"id":"س-07689","fp":"45e18bb9fff8","stateId":562,"easy":"إذا قرأت القرآن نثراً سريعاً بلا تدبر ← لا يجاوز ترقوتك","cause":"يَقْرَأونه يَنْثِرونه نَثْرَ الدَّقَلِ","result":"لا يُجاوِزُ تراقيهم","explicit":true,"ref":"صحيح الترمذي 602","srcLabel":"الترمذي","text":["عن  أبي وائلٍ قال : سأَلَ رجلٌ عبدَ اللهِ عن هذا الحرفِ  غير آسن  أو  ياسن    قال : كلَّ القرآنِ قرأتَ غيرَ هذا ؟ قال : نعم . قال : إن قومًا ",["يَقْرَأونه يَنْثِرونه نَثْرَ الدَّقَلِ",1]," ، ",["لا يُجاوِزُ تراقيهم",2]," ، إني لأَعْرِفُ السورَ النَّظائرَ التي كان رسولُ اللهِ صلى الله عليه وسلم يَقْرُنُ بينهنَّ."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (602) واللفظ له، والطيالسي في ((المسند)) (257)","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"sZwlGBFC"},{"id":"س-07029","fp":"e8f5dbc4ae47","stateId":562,"easy":"إذا عملت مع الجهل ← فكثير العمل لا ينفع","cause":"مع الجهلِ","result":"وإنَّ كثيرَ العملِ لا ينفعُ","explicit":true,"ref":"جامع بيان العلم 1/203","srcLabel":"ابن منده","text":["جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلم فقال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال :  العلمُ باللهِ عزَّ وجلَّ  قال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال :  العلمُ باللهِ  . قال : يا رسولَ اللهِ أسألُكَ عن العملِ وتخبِرني عن العلمِ ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلم :  إنَّ قليلَ العملِ ينفعُ مع العلمِ ، ",["وإنَّ كثيرَ العملِ لا ينفعُ",2]," ",["مع الجهلِ",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"روى مثل هذا عن عبد الله بن مسعود أيضاً بإسناد صالح","takhrij":"أخرجه ابن منده في ((مجالس من أماليه)) (418)، والديلمي في الفردوس كما في ((جامع الأحاديث)) للسيوطي(4050).","bab":"علم › الحث على طلب العلم","dorar":"b5YRQyKO"},{"id":"س-00552","fp":"9cb59a5ea986","stateId":562,"easy":"إذا تعلمت القرآن ثم رقدت عنه ← فمثلك كجراب أوكي على مسك","cause":"ومن تعلَّمَهُ فرقدَ وَهوَ في جوفِهِ","result":"كمَثلِ جرابٍ أوكيَ على مسكٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح ابن خزيمة 3/ 39","srcLabel":"الترمذي","text":["بعثَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بعثًا وَهُم نفرٌ، فدَعاهم رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ماذا معَكَ منَ القرآنِ؟ فاستَقرأَهُم حتَّى مرَّ على رجلٍ منهُم وَهوَ مِن أحدثِهِم سنًّا قالَ: ماذا معَكَ يا فلانُ؟ قالَ: معي كذا وَكَذا، وسورَةُ البقرةِ قالَ: معَكَ سورَةُ البقَرةِ؟ قالَ: نعَم قالَ: اذهَب، فأنتَ أميرُهُم، فقالَ رجلٌ هوَ مِن أشرفِهِم: والَّذي كذا وَكَذا، يا رسولَ اللَّهِ، ما مَنعَني أن أتعلَّمَ القرآنَ إلَّا خشيةَ أن لا أقومَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: تعلَّمِ القرآنَ فاقرأهُ، وارقُد؛ فإنَّ مَثلَ القُرآنِ لمن تعلَّمَهُ فقَرأَهُ وقامَ بِهِ كمَثلِ جِرابٍ محشوٍّ مسكًا، يفوحُ ريحُهُ على كلِّ مَكانٍ، ",["ومن تعلَّمَهُ فرقدَ وَهوَ في جوفِهِ",1]," ",["كمَثلِ جرابٍ أوكيَ على مسكٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2876)، والنسائي في ((الكبرى)) (8696)، وابن حبان (2126) بلفظه مطولًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"MohT6osX","merged":2,"otherRefs":["الترغيب والترهيب 2/300 (صحيح)"]},{"id":"س-02389","fp":"f8a84f9b9a04","stateId":562,"easy":"إذا خطبت خطبة ليس فيها شهادة ← فهي كاليد الجذماء","cause":"الخطبةُ التي ليس فيها شهادةٌ","result":"كاليدِ الجذماءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تمام المنة 334","srcLabel":"تمام المنة","text":[["الخطبةُ التي ليس فيها شهادةٌ",1]," ",["كاليدِ الجذماءِ",2]," . رواه أحمد وأبو داود والترمذي وقال : تشهد بدل شهادةٍ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إسلام › فضل الشهادتين","dorar":"OOLJAMxb","merged":2,"otherRefs":["صحيح الجامع 4520 (صحيح)"]},{"id":"س-06167","fp":"67bad7dd40f3","stateId":563,"easy":"إذا لم تزكِّ ← فلا صلاة لك (مقبولة)","cause":"ومن لم يزكِّ","result":"فلا صلاةَ له","explicit":true,"star":true,"ref":"الترغيب والترهيب 2/13","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بنِ مسعودٍ رضِي اللهُ عنه قال أُمرْنا بإقامِ الصَّلاةِ وإيتاءِ الزَّكاةِ ",["ومن لم يزكِّ ",1],["فلا صلاةَ له",2]],"grade":"صحيح","narrator":"[عوف بن مالك بن نضلة أبو الأحوص]","muhaddith":"[روي] بأسانيد أحدها صحيح","takhrij":"أخرجه الطبراني في ((الكبير)) (10/ 103) (10095)، وقوام السنة في ((الترغيب والترهيب)) (1476)، والطبري في ((تفسيره)) (11/ 362) واللفظ لهم.","bab":"زكاة › فرض الزكاة","dorar":"JCGoPreU"},{"id":"س-06764","fp":"4750971bc11f","stateId":563,"easy":"إذا أدركت رمضان وعليك قضاء رمضان سابق ← لم يُتقبل منك","cause":"مَن أدرَكَ رمضانَ وعليهِ من رمضانَ شيءٌ لم يَقضِهِ","result":"لم يتقبَّل مِنهُ","explicit":true,"ref":"تخريج المسند لشاكر 16/255","srcLabel":"أحمد","text":[["مَن أدرَكَ رمضانَ وعليهِ من رمضانَ شيءٌ لم يَقضِهِ ، ",1],["لم يتقبَّل مِنهُ ، ",2],"ومَن صامَ تطوُّعًا وعليهِ من رمضانَ شيءٌ لم يقضِهِ ، فإنَّهُ لا يتقبَّلُ منهُ حتَّى يَصومَهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8621) واللفظ له، والطبراني في ((المعجم الأوسط)) (3284) مختصراً","bab":"صيام › قضاء الصيام لمن أفطر في رمضان","dorar":"P17ezrDL"},{"id":"س-06765","fp":"7b7930d899fd","stateId":563,"easy":"إذا صمت تطوعاً وعليك قضاء من رمضان ← لا يُتقبل منك حتى تقضيه","cause":"ومَن صامَ تطوُّعًا وعليهِ من رمضانَ شيءٌ لم يقضِهِ","result":"فإنَّهُ لا يتقبَّلُ منهُ حتَّى يَصومَهُ","explicit":true,"ref":"تخريج المسند لشاكر 16/255","srcLabel":"أحمد","text":["مَن أدرَكَ رمضانَ وعليهِ من رمضانَ شيءٌ لم يَقضِهِ ، لم يتقبَّل مِنهُ ، ",["ومَن صامَ تطوُّعًا وعليهِ من رمضانَ شيءٌ لم يقضِهِ ، ",1],["فإنَّهُ لا يتقبَّلُ منهُ حتَّى يَصومَهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8621) واللفظ له، والطبراني في ((المعجم الأوسط)) (3284) مختصراً","bab":"صيام › قضاء الصيام لمن أفطر في رمضان","dorar":"P17ezrDL"},{"id":"س-01366","fp":"59d6f3cc1c29","stateId":563,"easy":"إذا لم تبيّت نية الصيام قبل الفجر (في الفرض) ← فلا صيام لك","cause":"مَن لم يُجمِعِ الصِّيامَ معَ الفَجْرِ","result":"فلا صِيامَ له","explicit":true,"ref":"الخلافيات للبيهقي 3464","srcLabel":"الخلافيات للبيهقي","text":["بمَعْنى حَديثِ: [",["مَن لم يُجمِعِ الصِّيامَ معَ الفَجْرِ",1]," ",["فلا صِيامَ له",2],"]."],"grade":"حسن","narrator":"حفصة زوج النبي - صلى الله عليه وسلم","muhaddith":"رواته ثقات","bab":"نية › النية في العبادات","dorar":"uq2ImR7p"},{"id":"س-05256","fp":"826e4300fd9f","stateId":563,"easy":"إذا أفطرت يوماً من رمضان بلا عذر ← لا يقضيه صيام الدهر وإن صمته","cause":"مَن أَفطَرَ يَوْمًا مِن شَهْرِ رَمَضانَ مِن غَيْرِ عُذْرٍ","result":"لم يَقْضِه صِيامُ الدَّهْرِ وإن صامَه","explicit":true,"otherNeedIds":[13,57],"ref":"علل ابن أبي حاتم 720","srcLabel":"أبو داود","text":["حَديثٌ رَواه المُسَيَّبُ بنُ واضِحٍ، عن يوسُفَ بنِ أسْباطٍ، عن سُفْيانَ الثَّوْريِّ، عن عَمْرِو بنِ دينارٍ، عن أبي المُطَوِّسِ، عن أبيه، عن أبي هُرَيْرةَ، قالَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّم: ",["مَن أَفطَرَ يَوْمًا مِن شَهْرِ رَمَضانَ مِن غَيْرِ عُذْرٍ",1]," ",["لم يَقْضِه صِيامُ الدَّهْرِ وإن صامَه",2],"؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إنَّما هو: سُفْيانُ، عن حَبيبٍ، عن أبي المُطَوِّسِ. وشُعْبةُ يقولُ: عن حَبيبٍ، عن عُمارةَ، عن أبي المُطَوِّسِ، عن أبيه، عن أبي هُرَيْرةَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم.\nقالَ [ابنُ أبي حاتِمٍ]: إنَّما أَنكَرَ: «عَمْرَو بنَ دينارٍ» بَدَلَ: «حَبيبِ بنِ أبي ثابِتٍ».","takhrij":"أخرجه أبو داود (2396)، وابن ماجه (1672)، وأحمد (9706) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"GSnhh87K","merged":3,"otherRefs":["تغليق التعليق 3/172 (صحيح)","القبس 2/501 (صحيح)"]},{"id":"س-00595","fp":"1e31d9451332","stateId":564,"easy":"إذا أعتقت عند الموت ← فمثلك كمن يهدي إذا شبع","cause":"الَّذي يُعتِقُ عندَ الموتِ","result":"كمَثَلِ الَّذي يُهدِي إذا شَبِعَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"star":true,"similar":["س-04906"],"ref":"المستدرك على الصحيحين 2885","srcLabel":"أبو داود","text":["عنْ أَبي حَبيبةَ الطَّائيِّ، قالَ: أَوْصى إلَيَّ أَخي بطائفةٍ مِن مالِه، فلَقيتُ أبا الدَّرْداءِ، فقلتُ: إنَّ أخي قد أَوْصى إليَّ بطائفةٍ مِن مالِه، فأين أَضَعُه؟ في الفقراءِ أوِ المجاهدينَ أوِ المساكينِ؟ فقالَ: أمَّا أنا، فلو كنتُ لمْ أَعدِلْ بالمجاهدينَ، فإنِّي سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَثَلُ ",["الَّذي يُعتِقُ عندَ الموتِ",1]," ",["كمَثَلِ الَّذي يُهدِي إذا شَبِعَ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (3968)، والنسائي في ((الكبرى)) (4873)، والدارمي (3269) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"E2THOcid","merged":3,"otherRefs":["هداية الرواة 2/279 (حسن)","الأحكام الوسطى 3/ 321 (صحيح)"]},{"id":"س-04906","fp":"a03ea26e636d","stateId":564,"easy":"إذا تصدقت عند الموت ← فمثلك كمن يهدي بعدما يشبع","cause":"يتصدَّقُ عندَ الموتِ","result":"مَثَلُ الَّذي يُهدي بعدَما يشبَعُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00595","ref":"صحيح ابن حبان 3336","text":["مَثَلُ الَّذي ",["يتصدَّقُ عندَ الموتِ",1]," ",["مَثَلُ الَّذي يُهدي بعدَما يشبَعُ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (3968) باختلاف يسير، وأخرجه الترمذي (2123)، والنسائي (3614) باختلاف يسير بزيادة قصة في أوله","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0rtQUDJX"},{"id":"س-05724","fp":"37452d2781bb","stateId":564,"easy":"إذا جمعت المال ومنعت حتى بلغت التراقي ← فقد فات أوان الصدقة","cause":"فجمَعْتَ ومنَعْتَ حتَّى إذا بلَغَتِ التَّراقيَ فقُلتَ: أَتصدَّقُ","result":"وأنَّى أوانُ الصَّدقةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 3901","srcLabel":"الحاكم","text":["تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذه الآيةَ: {فَمَالِ الَّذِينَ كَفَرُوا قِبَلَكَ مُهْطِعِينَ (36) عَنِ الْيَمِينِ وَعَنِ الشِّمَالِ عِزِينَ (37) أَيَطْمَعُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُدْخَلَ جَنَّةَ نَعِيمٍ (38) كَلَّا إِنَّا خَلَقْنَاهُمْ مِمَّا يَعْلَمُونَ} [المعارج: 36 - 39]، ثُمَّ بَزَقَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على كفِّهِ، فقالَ: «يقولُ اللهُ: يا ابنَ آدمَ أَنَّى تُعجِزُني وقد خَلقتُكَ مِن مِثلِ هذه حتَّى إذا سوَّيتُكَ وعدَلتُكَ مَشيْتَ بيْنَ بُردَيْنِ وللأرضِ مِنكَ وَئيدٌ -يعني شكوى- ",["فجمَعْتَ ومنَعْتَ حتَّى إذا بلَغَتِ التَّراقيَ فقُلتَ: أَتصدَّقُ",1],"، ",["وأنَّى أوانُ الصَّدقةِ",2],"؟»."],"grade":"صحيح","narrator":"بسر بن جحاش القرشي","muhaddith":"صحيح الإسناد","bab":"رقائق وزهد › الكبر والتواضع","dorar":"4tAqi0Xx"},{"id":"س-00499","fp":"e7dd6ee00ffa","stateId":564,"easy":"إذا أخّرت الصدقة حتى بلغت روحك الحلقوم ← فقد فات أوانها","cause":"فإذا بلغت نفسُكَ هذِهِ وأشارَ إلى حلقِهِ قلتَ: أتصدَّقُ","result":"وأنَّى أوانُ الصَّدقةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن ماجه 2205","srcLabel":"أحمد","text":["بزقَ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّمَ في كفِّه، ثمَّ وضعَ أصبعَهُ السَّبَّابةَ وقال: \" يقولُ اللَّهُ عزَّ وجلَّ: أنَّى تُعجِزُني ابنَ آدمَ وقد خلقتُكَ من مثلِ هذِهِ، ",["فإذا بلغت نفسُكَ هذِهِ وأشارَ إلى حلقِهِ قلتَ: أتصدَّقُ",1],"، ",["وأنَّى أوانُ الصَّدقةِ",2]],"grade":"حسن","narrator":"بسر بن جحاش القرشي","muhaddith":"حسن","takhrij":"أخرجه ابن ماجة (2707) واللفظ له، وأحمد (17844)، والحاكم (3855) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"eHdKniC9"},{"id":"س-07310","fp":"519fb8fb032a","stateId":565,"easy":"إذا وقعت في نهر الدجال ← وجب وزرك وحُط أجرك","cause":"فمَن وقَع في نهرِه","result":"وجَب وِزرُه وحُطَّ أجرُه","explicit":true,"star":true,"otherNeedIds":[13],"ref":"شرح مشكل الآثار 14/377","srcLabel":"متفق عليه","text":["ثم يَخرُجُ الدجَّالُ معَه نهرُ ماءٍ باردٍ ",["فمَن وقَع في نهرِه",1]," ",["وجَب وِزرُه وحُطَّ أجرُه",2]," ومَن وقَع في نارِه وجَب أجرُه وحُطَّ وِزرُه"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4244) وأحمد (23429) بنحوه مطولا، وأصله في البخاري (3450) ومسلم (2935)","bab":"فتن › فتنة الدجال","dorar":"9HPlLMJA"},{"id":"س-01844","fp":"3152b91f2238","stateId":565,"easy":"إذا صليت قاعداً (في النافلة) ← فلك نصف أجر القائم","cause":"صلاةُ القاعِدِ","result":"نِصفُ صلاةِ القائمِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 12395","srcLabel":"النسائي","text":["أَخبَرَني أَنَسُ بنُ مالِكٍ قال: قدِمَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ المدينةَ وهي مُحَمَّةٌ، فَحُمَّ النَّاسُ، فدخَلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ المسجِدَ، والنَّاسُ قُعودٌ يُصلُّونَ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["صلاةُ القاعِدِ",1]," ",["نِصفُ صلاةِ القائمِ",2],"، فتجَشَّمَ النَّاسُ الصلاةَ قيامًا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (1364) باختلاف يسير، وابن ماجه (1230) مختصراً، وأحمد (12395) واللفظ له","bab":"إحسان › الأخذ بالرخصة","dorar":"a92tDoOT","merged":3,"otherRefs":["تخريج المسند لشاكر 11/120 (صحيح)","صحيح ابن ماجه 1022 (صحيح)"]},{"id":"س-07152","fp":"996e147f3462","stateId":565,"easy":"إذا صليت جالساً ← فلك نصف صلاة القائم","cause":"صلاةَ الجالسِ","result":"على النِّصفِ من صلاةَ القائمِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 2/ 398","srcLabel":"مسلم","text":["رأيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يصلِّي جالسًا قلتُ حُدِّثتُ أنَّكَ تقولُ: إنَّ ",["صلاةَ الجالسِ",1]," ",["على النِّصفِ من صلاةَ القائمِ",2]," قالَ: أجَل، ولَكِنِّي لستُ كأحدٍ منكم [وفي روايةٍ] لَم يقُل: أجَلْ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (735)، وأبو داود (950)، والدارمي (1424) بنحوه","bab":"علم › حسن السؤال ونصح العالم","dorar":"OQYSlmnS"},{"id":"س-07306","fp":"bb8965bd121b","stateId":565,"easy":"إذا دخلت نهر الدجال ← حُط أجرك ووجب وزرك","cause":"فمَن دَخَلَ نَهَرَه","result":"حُطَّ أجْرُه ووَجَبَ وِزْرُه","explicit":true,"star":true,"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 23425","srcLabel":"متفق عليه","text":["سَمِعتُ صَخْرًا يُحدِّثُ عن سُبَيعٍ قال: أرسَلوني مِن ماهَ إلى الكُوفةِ أشْتَري الدَّوابَّ، فأتَيْنا الكُناسةَ، فإذا رَجُلٌ عليه جَمْعٌ، قال: فأمَّا صاحبي فانطَلَقَ إلى الدَّوابِّ، وأمَّا أنا فأتَيْتُه، فإذا هو حُذَيفةُ، فسَمِعتُه يقولُ: كان أصحابُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَسأَلونَه عن الخَيرِ وأسأَلُه عن الشَّرِّ، فقُلتُ: يا رسولَ اللهِ، هل بعدَ هذا الخَيرِ شَرٌّ كما كان قَبلَه شَرٌّ؟ قال: نَعَمْ، قُلتُ: فما العِصْمةُ منه؟ قال: السَّيفُ -أحسَبُ أبو التَّيَّاحِ يقولُ: السَّيفُ، أحسَبُ- قال: قُلتُ: ثم ماذا؟ قال: ثم تكونُ هُدْنةٌ على دَخَنٍ، قال: قُلتُ: ثم ماذا؟ قال: ثم تكونُ دُعاةُ الضَّلالةِ، فإنْ رَأيتَ يَومَئذٍ خَليفةَ اللهِ في الأرضِ فالْزَمْه، وإنْ نَهَكَ جِسمَكَ وأخَذَ مالَك، فإنْ لم تَرَهُ فاهْرُبْ في الأرضِ، ولو أنْ تَموتَ وأنتَ عاضٌّ بجِذْلِ شَجَرةٍ، قال: قُلتُ: ثم ماذا؟ قال: ثم يَخْرُجُ الدَّجَّالُ، قال: قُلتُ: فبِمَ يَجيءُ به معه؟ قال: بنَهَرٍ -أو قال: ماءٍ- ونارٍ، ",["فمَن دَخَلَ نَهَرَه",1]," ",["حُطَّ أجْرُه ووَجَبَ وِزْرُه",2],"، ومَن دَخَلَ نارَه وَجَبَ أجْرُه وحُطَّ وِزْرُه، قال: قُلتُ: ثم ماذا؟ قال: لو أنتَجْتَ فَرَسًا لم تَركَبْ فَلُوَّها حتى تقومَ السَّاعةُ."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن دون قوله: \"لو أنتجت فرسا لم تركب فلوها حتى تقوم الساعة\"،","takhrij":"أخرجه أبو داود (4246) باختلاف يسير، وأصله في صحيح البخاري (3606)، ومسلم (1847)","bab":"فتن › فتنة الدجال","dorar":"Fqj19nsr"},{"id":"س-03645","fp":"d06d1de14c9c","stateId":565,"easy":"إذا اتبعت النساء الجنائز ← فليس لهن في ذلك أجر","cause":"اتباعِ النساءِ الجنائزَ","result":"ليس لهنَّ في ذلك أجرٌ","explicit":true,"ref":"السلسلة الصحيحة 3012","srcLabel":"أبو داود","text":["نهى عن ",["اتباعِ النساءِ الجنائزَ",1]," ، وقال : ",["ليس لهنَّ في ذلك أجرٌ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الدعاء)) (2161) واللفظ له وفي أوله زيادة، وأبو داود (4164)، والنسائي (5090)، وأحمد (25760) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"ukLkmPYg"},{"id":"س-05068","fp":"ba81384fb4f4","stateId":565,"easy":"إذا صليت على جنازة في المسجد ← فلا شيء لك (على رواية)","cause":"مَن صلَّى على جنازةٍ في مَسجدٍ","result":"فلا شيءَ لَهُ","explicit":true,"ref":"نخب الافكار 7/317","srcLabel":"أبو داود","text":[["مَن صلَّى على جنازةٍ في مَسجدٍ",1]," ",["فلا شيءَ لَهُ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (2824) واللفظ له، وأخرجه أبو داود (3191)، وابن ماجه (1517) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"YTIFONyj"},{"id":"س-05627","fp":"6b66cc687964","stateId":566,"easy":"إذا أصبت من الدنيا شيئاً ← ينقص من درجاتك عند الله وإن كنت عليه كريماً","cause":"لا يُصيبُ عبدٌ مِن الدُّنيا شيئًا","result":"إلَّا نَقصَ مِن درجاتِهِ عندَ اللَّهِ ، وإن كانَ علَيهِ كريمًا","explicit":true,"star":true,"ref":"البدور السافرة 391","srcLabel":"البدور السافرة","text":["عنِ ابنِ عُمرَ قالَ : ",["لا يُصيبُ عبدٌ مِن الدُّنيا شيئًا",1]," ",["إلَّا نَقصَ مِن درجاتِهِ عندَ اللَّهِ ، وإن كانَ علَيهِ كريمًا",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"iXSMQUq6"},{"id":"س-07785","fp":"091eaa93d071","stateId":566,"easy":"إذا أقمت حروف القرآن للدنيا ← تتعجل أجره ولا تؤجله للآخرة","cause":"يقُيمونَهُ كما يقوَّمُ السَّهمُ","result":"يَتعجَّلُ أجرُهُ ولا يتأجَّلُهُ","explicit":true,"ref":"صحيح أبي داود 831","srcLabel":"أبو داود","text":["خرجَ علَينا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يومًا ونحنُ نَقتَرِئُ، فقالَ: الحمدُ للَّهِ كتابُ اللَّهِ واحدٌ، وفيكُمُ الأحمرُ وفيكُمُ الأبيضُ وفيكم الأسوَدُ، اقرءوهُ قبلَ أن يَقرأَهُ أقوامٌ ",["يقُيمونَهُ كما يقوَّمُ السَّهمُ",1]," ",["يَتعجَّلُ أجرُهُ ولا يتأجَّلُهُ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (831) واللفظ له، وأحمد (22865) باختلاف يسير","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"SexoK1Zv"},{"id":"س-04860","fp":"64a8e54f8add","stateId":566,"easy":"إذا أخذت أرضاً بجزيتها ← فقد استقلت هجرتك","cause":"من أخذَ أرضًا بجزيتِها","result":"فقدِ استقالَ هجرتَهُ","explicit":true,"ref":"هداية الرواة 3/407","srcLabel":"أبو داود","text":[["من أخذَ أرضًا بجزيتِها",1]," ",["فقدِ استقالَ هجرتَهُ",2]," ومن نزعَ صغارَ كافرٍ من عنقِهِ فجعلَهُ في عنقِهِ ولَّى الإسلامَ ظهرَهُ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (3082)، والطبراني في ((المعجم الأوسط)) (8244)، والبيهقي (18859) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fM0BSv4B"},{"id":"س-02014","fp":"4ebc72fef5cd","stateId":566,"easy":"إذا غزوت فغنمت ← تعجلت ثلثي أجرك","cause":"فيُصيبونَ غَنيمةً","result":"إلَّا تَعَجَّلوا ثُلُثي أَجرِهم مِنَ الآخرةِ، ويَبْقى لهُم الثُّلثُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 2449","srcLabel":"مسلم","text":["ما مِن غازِيةٍ تَغْزو في سَبيلِ اللهِ، ",["فيُصيبونَ غَنيمةً",1],"؛ ",["إلَّا تَعَجَّلوا ثُلُثي أَجرِهم مِنَ الآخرةِ، ويَبْقى لهُم الثُّلثُ",2],"، فإنْ لمْ يُصيبوا غَنيمةً؛ تَمَّ لهم أَجرُهُم."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1906)، وأبو داود (2497)، وأحمد (3125) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fEHlgtHz"},{"id":"س-00871","fp":"931c2388189d","stateId":567,"easy":"إذا تكلمت بغير أمر بمعروف أو نهي عن منكر أو ذكر الله ← فكلامك عليك لا لك","cause":"أمرٌ بمعروفٍ ، أو نهيٍ عن منكرٍ ، أو ذكرُ اللهِ","result":"كلُّ كلامِ ابنِ آدمَ عليهِ لا لهُ ، إلَّا","explicit":true,"otherNeedIds":[45],"ref":"سنن الترمذي 2412","srcLabel":"الترمذي","text":[["كلُّ كلامِ ابنِ آدمَ عليهِ لا لهُ ، إلَّا",2]," ",["أمرٌ بمعروفٍ ، أو نهيٍ عن منكرٍ ، أو ذكرُ اللهِ",1]],"grade":"حسن","narrator":"أم حبيبة أم المؤمنين","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (2412) واللفظ له، وابن ماجه (3974)","bab":"أدعية وأذكار › فضل الذكر","dorar":"dxnWVweW"},{"id":"س-00931","fp":"a46062b3a83b","stateId":567,"easy":"إذا تكلمت ← فكلامك كله عليك إلا أمراً بمعروف أو نهياً عن منكر أو ذكر الله","cause":"أمرًا بمعروفٍ ، أو نَهْيًا عن مُنْكَرٍ ، أو ذِكْرَ اللهِ عَزَّ وجَلَّ","result":"كلامُ ابنِ آدمَ كلُّه عليه لا له ، إلا","explicit":true,"star":true,"otherNeedIds":[45],"ref":"الجامع الصغير 6417","srcLabel":"الترمذي","text":[["كلامُ ابنِ آدمَ كلُّه عليه لا له ، إلا",2]," ",["أمرًا بمعروفٍ ، أو نَهْيًا عن مُنْكَرٍ ، أو ذِكْرَ اللهِ عَزَّ وجَلَّ",1]],"grade":"صحيح","narrator":"أم حبيبة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4603) واللفظ له، وأخرجه الترمذي (2412)، وابن ماجه (3974) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"hEcHBGyl"},{"id":"س-07551","fp":"4ad752d671e3","stateId":567,"easy":"إذا اقتصصت مع إمكان العفو ← فأنت مثله","cause":"اعفُ فأبَى. فقالَ: خُذ أرشَكَ فأبَى. قالَ : اذهب فاقتلهُ","result":"فإنَّكَ مثلُهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 28","srcLabel":"ابن ماجه","text":["أتى رجلٌ بقاتلِ وليِّهِ إلى رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وعلَى آلِهِ وصَحبِهِ وسلَّمَ - فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وعلى آلِهِ وصحبِهِ وسلَّمَ: ",["اعفُ فأبَى. فقالَ: خُذ أرشَكَ فأبَى. قالَ : اذهب فاقتلهُ",1]," ",["فإنَّكَ مثلُهُ",2]," قالَ: فلُحِقَ بِهِ فقيلَ لَهُ: إنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وعلَى آلِهِ وصحبِهِ وسلَّمَ قد قالَ: اقتُلهُ فإنَّكَ مثلُهُ فخلَّى سبيلَهُ. قالَ: فرُؤِيَ يجرُّ نِسعتَهُ ذاهبًا إلى أَهْلِهِ ، قالَ: كأنَّهُ قد كانَ أوثقَهُ. قالَ أبو عُمَيْرٍ في حديثِهِ: قالَ: ابنُ شَوذبٍ ، عَن عبدِ الرَّحمنِ بنِ القاسِمِ: فلَيسَ لأحدٍ بعدَ النَّبيِّ صلَّى اللَّهُ عليهِ وعلَى آلِهِ وصَحبِهِ وسلَّمَ أن يقولَ: اقتُلهُ فإنَّكَ مثلُهُ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2691)","bab":"فضائل النبي وصفته ودلائل النبوة › خصائصه صلى الله عليه وسلم","dorar":"2K9epicK","merged":4,"otherRefs":["الأحاديث المختارة 1746 (صحيح)","صحيح النسائي 4744 (صحيح)","الأحاديث المختارة 1747 (صحيح)"]},{"id":"س-05686","fp":"58e9a74a59c4","stateId":567,"easy":"إذا جزعت عند المصيبة ← يحبط جزعك أجرك فتندم","cause":"جزَعُكَ","result":"يُحبِطُ جزَعُكَ أجْرَكَ فتَندَمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[9],"ref":"المستدرك على الصحيحين 5281","srcLabel":"الطبراني","text":["أنَّه ماتَ له ابنٌ، فكتَبَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُعزِّيه عليه: «بسمِ اللهِ الرَّحمَنِ الرَّحيمِ، من محمَّدٍ رَسولِ اللهِ إلى مُعاذِ بنِ جَبلٍ، سَلامٌ عليكَ، فإنِّي أحمَدُ إليكَ اللهَ الَّذي لا إلَهَ إلَّا هو، أمَّا بعدُ، فأعظَمَ اللهُ لكَ الأجْرَ، وألهَمَكَ الصَّبرَ، ورزَقَنا وإيَّاكَ الشُّكرَ، فإنَّ أنفُسَنا وأمْوالَنا وأهْلينا وأوْلادَنا من مَواهِبِ اللهِ عزَّ وجلَّ الهَنيئةِ وعَواريهِ المُستَودَعةِ، متَّعَكَ به في غِبْطةٍ وسُرورٍ، وقبَضَه منكَ بأجْرٍ كَبيرٍ، الصَّلاةُ والرَّحمةُ والهُدى، إنِ احتَسَبْتَه، فاصْبِرْ، ولا ",["يُحبِطُ جزَعُكَ أجْرَكَ فتَندَمَ",2],"، واعلَمْ أنَّ الجَزعَ لا يرُدُّ شَيئًا، ولا يَدفَعُ حُزنًا، وما هو نازِلٌ فكانَ قدْ، والسَّلامُ»."],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"غريب حسن إلا أن مجاشع بن عمرو ليس من شرط هذا الكتاب","takhrij":"أخرجه الطبراني (20/ 155) (324)، وابن الأعرابي في ((معجم شيوخه)) (646)، وأبو نعيم في ((الحلية)) (1/ 242) بلفظ قريب.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"Wa9l8qsN"}]}