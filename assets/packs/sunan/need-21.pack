َّهِ فَقَدْ ضَلَّ ضَلَالًا بَعِيدًا (116)","hl":[[0,145,1]]}},{"id":"ق-0260","fp":"3fdd4dc9b31c","stateId":190,"easy":"الكفر بالله وملائكته وكتبه ورسله واليوم الآخر ← ضلال بعيد","cause":"الكفر بالله وملائكته وكتبه ورسله واليوم الآخر","result":"ضلال بعيد","explicit":true,"ref":"سورة النساء: 136","srcLabel":"القرآن الكريم","quran":{"s":4,"from":136,"to":136,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا آمِنُوا بِاللَّهِ وَرَسُولِهِ وَالْكِتَابِ الَّذِي نَزَّلَ عَلَى رَسُولِهِ وَالْكِتَابِ الَّذِي أَنْزَلَ مِنْ قَبْلُ وَمَنْ يَكْفُرْ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ وَالْيَوْمِ الْآخِرِ فَقَدْ ضَلَّ ضَلَالًا بَعِيدًا (136)","hl":[[148,263,1]]}},{"id":"ق-0261","fp":"cb358a304f94","stateId":190,"easy":"التردد بين الإيمان والكفر ثم ازدياد الكفر ← لا يغفر الله لهم ولا يهديهم","cause":"التردد بين الإيمان والكفر ثم ازدياد الكفر","result":"لا يغفر الله لهم ولا يهديهم","explicit":true,"ref":"سورة النساء: 137","srcLabel":"القرآن الكريم","quran":{"s":4,"from":137,"to":137,"text":"إِنَّ الَّذِينَ آمَنُوا ثُمَّ كَفَرُوا ثُمَّ آمَنُوا ثُمَّ كَفَرُوا ثُمَّ ازْدَادُوا كُفْرًا لَمْ يَكُنِ اللَّهُ لِيَغْفِرَ لَهُمْ وَلَا لِيَهْدِيَهُمْ سَبِيلًا (137)","hl":[[0,160,1]]}},{"id":"ق-0275","fp":"abf448568823","stateId":190,"easy":"نقض الميثاق والكفر بآيات الله وقتل الأنبياء ← الطبع على القلوب","cause":"نقض الميثاق والكفر بآيات الله وقتل الأنبياء","result":"الطبع على القلوب","explicit":true,"ref":"سورة النساء: 155","srcLabel":"القرآن الكريم","quran":{"s":4,"from":155,"to":155,"text":"فَبِمَا نَقْضِهِمْ مِيثَاقَهُمْ وَكُفْرِهِمْ بِآيَاتِ اللَّهِ وَقَتْلِهِمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَقَوْلِهِمْ قُلُوبُنَا غُلْفٌ بَلْ طَبَعَ اللَّهُ عَلَيْهَا بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا (155)","hl":[[0,212,1]]}},{"id":"ق-0278","fp":"97fb96556fd0","stateId":190,"easy":"الكفر والصد عن سبيل الله ← ضلال بعيد","cause":"الكفر والصد عن سبيل الله","result":"ضلال بعيد","explicit":true,"ref":"سورة النساء: 167","srcLabel":"القرآن الكريم","quran":{"s":4,"from":167,"to":167,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ قَدْ ضَلُّوا ضَلَالًا بَعِيدًا (167)","hl":[[0,86,1]]}},{"id":"ق-0279","fp":"72c4e9b74b0e","stateId":190,"easy":"الكفر والظلم ← لا مغفرة ولا هداية إلا طريق جهنم","cause":"الكفر والظلم","result":"لا مغفرة ولا هداية إلا طريق جهنم","explicit":true,"otherNeedIds":[69],"ref":"سورة النساء: 168","srcLabel":"القرآن الكريم","quran":{"s":4,"from":168,"to":168,"text":"إِنَّ الَّذِينَ كَفَرُوا وَظَلَمُوا لَمْ يَكُنِ اللَّهُ لِيَغْفِرَ لَهُمْ وَلَا لِيَهْدِيَهُمْ طَرِيقًا (168)","hl":[[0,103,1]]}},{"id":"ق-0289","fp":"8e06aa0552db","stateId":190,"easy":"الكفر بعد الميثاق ← ضلال سواء السبيل","cause":"الكفر بعد الميثاق","result":"ضلال سواء السبيل","explicit":true,"ref":"سورة المائدة: 12","srcLabel":"القرآن الكريم","quran":{"s":5,"from":12,"to":12,"text":"وَلَقَدْ أَخَذَ اللَّهُ مِيثَاقَ بَنِي إِسْرَائِيلَ وَبَعَثْنَا مِنْهُمُ اثْنَيْ عَشَرَ نَقِيبًا وَقَالَ اللَّهُ إِنِّي مَعَكُمْ لَئِنْ أَقَمْتُمُ الصَّلَاةَ وَآتَيْتُمُ الزَّكَاةَ وَآمَنْتُمْ بِرُسُلِي وَعَزَّرْتُمُوهُمْ وَأَقْرَضْتُمُ اللَّهَ قَرْضًا حَسَنًا لَأُكَفِّرَنَّ عَنْكُمْ سَيِّئَاتِكُمْ وَلَأُدْخِلَنَّكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ فَمَنْ كَفَرَ بَعْدَ ذَلِكَ مِنْكُمْ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ (12)","hl":[[365,433,1]]}},{"id":"ق-0306","fp":"542a1ebf6bb8","stateId":190,"easy":"المسارعة في الكفر وسماع الكذب وتحريف الكلم ← لا يطهّر الله قلوبهم وخزي في الدنيا وعذاب عظيم","cause":"المسارعة في الكفر وسماع الكذب وتحريف الكلم","result":"لا يطهّر الله قلوبهم وخزي في الدنيا وعذاب عظيم","explicit":true,"otherNeedIds":[60,69],"ref":"سورة المائدة: 41","srcLabel":"القرآن الكريم","quran":{"s":5,"from":41,"to":41,"text":"يَا أَيُّهَا الرَّسُولُ لَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ مِنَ الَّذِينَ قَالُوا آمَنَّا بِأَفْوَاهِهِمْ وَلَمْ تُؤْمِنْ قُلُوبُهُمْ وَمِنَ الَّذِينَ هَادُوا سَمَّاعُونَ لِلْكَذِبِ سَمَّاعُونَ لِقَوْمٍ آخَرِينَ لَمْ يَأْتُوكَ يُحَرِّفُونَ الْكَلِمَ مِنْ بَعْدِ مَوَاضِعِهِ يَقُولُونَ إِنْ أُوتِيتُمْ هَذَا فَخُذُوهُ وَإِنْ لَمْ تُؤْتَوْهُ فَاحْذَرُوا وَمَنْ يُرِدِ اللَّهُ فِتْنَتَهُ فَلَنْ تَمْلِكَ لَهُ مِنَ اللَّهِ شَيْئًا أُولَئِكَ الَّذِينَ لَمْ يُرِدِ اللَّهُ أَنْ يُطَهِّرَ قُلُوبَهُمْ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ (41)","hl":[[369,579,1]]}},{"id":"ق-0323","fp":"a79ffc597db9","stateId":190,"easy":"الكفر ← لا يهديهم الله","cause":"الكفر","result":"لا يهديهم الله","explicit":true,"ref":"سورة المائدة: 67","srcLabel":"القرآن الكريم","quran":{"s":5,"from":67,"to":67,"text":"يَا أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ (67)","hl":[[151,200,1]]}},{"id":"ق-0352","fp":"9e491ad4111b","stateId":190,"easy":"التكذيب بآيات الله ← الصمم والبكم في الظلمات","cause":"التكذيب بآيات الله","result":"الصمم والبكم في الظلمات","explicit":true,"ref":"سورة الأنعام: 39","srcLabel":"القرآن الكريم","quran":{"s":6,"from":39,"to":39,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا صُمٌّ وَبُكْمٌ فِي الظُّلُمَاتِ مَنْ يَشَإِ اللَّهُ يُضْلِلْهُ وَمَنْ يَشَأْ يَجْعَلْهُ عَلَى صِرَاطٍ مُسْتَقِيمٍ (39)","hl":[[0,65,1]]}},{"id":"ق-0367","fp":"648dea628d0d","stateId":190,"easy":"ردّ الحق أول مرة ← تقليب الأفئدة والأبصار والترك في الطغيان","cause":"ردّ الحق أول مرة","result":"تقليب الأفئدة والأبصار والترك في الطغيان","explicit":true,"ref":"سورة الأنعام: 110","srcLabel":"القرآن الكريم","quran":{"s":6,"from":110,"to":110,"text":"وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ كَمَا لَمْ يُؤْمِنُوا بِهِ أَوَّلَ مَرَّةٍ وَنَذَرُهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ (110)","hl":[[0,128,1]]}},{"id":"ق-0372","fp":"aed47f36cad0","stateId":190,"easy":"الكفر ← تزيين سوء العمل","cause":"الكفر","result":"تزيين سوء العمل","explicit":true,"ref":"سورة الأنعام: 122","srcLabel":"القرآن الكريم","quran":{"s":6,"from":122,"to":122,"text":"أَوَمَنْ كَانَ مَيْتًا فَأَحْيَيْنَاهُ وَجَعَلْنَا لَهُ نُورًا يَمْشِي بِهِ فِي النَّاسِ كَمَنْ مَثَلُهُ فِي الظُّلُمَاتِ لَيْسَ بِخَارِجٍ مِنْهَا كَذَلِكَ زُيِّنَ لِلْكَافِرِينَ مَا كَانُوا يَعْمَلُونَ (122)","hl":[[147,202,1]]}},{"id":"ق-0382","fp":"8c3565bc4b94","stateId":190,"easy":"افتراء الكذب على الله لإضلال الناس ← لا يهديه الله","cause":"افتراء الكذب على الله لإضلال الناس","result":"لا يهديه الله","explicit":true,"similar":["ق-1329"],"ref":"سورة الأنعام: 144","srcLabel":"القرآن الكريم","quran":{"s":6,"from":144,"to":144,"text":"وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ قُلْ آلذَّكَرَيْنِ حَرَّمَ أَمِ الْأُنْثَيَيْنِ أَمَّا اشْتَمَلَتْ عَلَيْهِ أَرْحَامُ الْأُنْثَيَيْنِ أَمْ كُنْتُمْ شُهَدَاءَ إِذْ وَصَّاكُمُ اللَّهُ بِهَذَا فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ كَذِبًا لِيُضِلَّ النَّاسَ بِغَيْرِ عِلْمٍ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (144)","hl":[[212,351,1]]}},{"id":"ق-0397","fp":"e17fba17703c","stateId":190,"easy":"اتخاذ الشياطين أولياء من دون الله ← حقّت الضلالة","cause":"اتخاذ الشياطين أولياء من دون الله","result":"حقّت الضلالة","explicit":true,"ref":"سورة الأعراف: 30","srcLabel":"القرآن الكريم","quran":{"s":7,"from":30,"to":30,"text":"فَرِيقًا هَدَى وَفَرِيقًا حَقَّ عَلَيْهِمُ الضَّلَالَةُ إِنَّهُمُ اتَّخَذُوا الشَّيَاطِينَ أَوْلِيَاءَ مِنْ دُونِ اللَّهِ وَيَحْسَبُونَ أَنَّهُمْ مُهْتَدُونَ (30)","hl":[[15,157,1]]}},{"id":"ق-0420","fp":"919fd5741453","stateId":190,"easy":"التكذيب السابق بالحق ← الطبع على القلوب","cause":"التكذيب السابق بالحق","result":"الطبع على القلوب","explicit":true,"ref":"سورة الأعراف: 101","srcLabel":"القرآن الكريم","quran":{"s":7,"from":101,"to":101,"text":"تِلْكَ الْقُرَى نَقُصُّ عَلَيْكَ مِنْ أَنْبَائِهَا وَلَقَدْ جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَمَا كَانُوا لِيُؤْمِنُوا بِمَا كَذَّبُوا مِنْ قَبْلُ كَذَلِكَ يَطْبَعُ اللَّهُ عَلَى قُلُوبِ الْكَافِرِينَ (101)","hl":[[99,207,1]]}},{"id":"ق-0518","fp":"e390e0d8026d","stateId":190,"easy":"الكفر بالله ورسوله ← لا مغفرة ولو استُغفر لهم سبعين مرة","cause":"الكفر بالله ورسوله","result":"لا مغفرة ولو استُغفر لهم سبعين مرة","explicit":true,"ref":"سورة التوبة: 80","srcLabel":"القرآن الكريم","quran":{"s":9,"from":80,"to":80,"text":"اسْتَغْفِرْ لَهُمْ أَوْ لَا تَسْتَغْفِرْ لَهُمْ إِنْ تَسْتَغْفِرْ لَهُمْ سَبْعِينَ مَرَّةً فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ ذَلِكَ بِأَنَّهُمْ كَفَرُوا بِاللَّهِ وَرَسُولِهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (80)","hl":[[0,217,1]]}},{"id":"ق-0632","fp":"f2bdf1b0e332","stateId":190,"easy":"المكر والصد عن السبيل ← الإضلال وعذاب في الحياة الدنيا وعذاب الآخرة أشق","cause":"المكر والصد عن السبيل","result":"الإضلال وعذاب في الحياة الدنيا وعذاب الآخرة أشق","explicit":true,"otherNeedIds":[61,69],"ref":"سورة الرعد: 33–34","srcLabel":"القرآن الكريم","quran":{"s":13,"from":33,"to":34,"text":"أَفَمَنْ هُوَ قَائِمٌ عَلَى كُلِّ نَفْسٍ بِمَا كَسَبَتْ وَجَعَلُوا لِلَّهِ شُرَكَاءَ قُلْ سَمُّوهُمْ أَمْ تُنَبِّئُونَهُ بِمَا لَا يَعْلَمُ فِي الْأَرْضِ أَمْ بِظَاهِرٍ مِنَ الْقَوْلِ بَلْ زُيِّنَ لِلَّذِينَ كَفَرُوا مَكْرُهُمْ وَصُدُّوا عَنِ السَّبِيلِ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ (33) لَهُمْ عَذَابٌ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَشَقُّ وَمَا لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ (34)","hl":[[184,413,1]]}},{"id":"ق-0653","fp":"29342d11f1ab","stateId":190,"easy":"الاستهزاء بالرسل ← سلوك التكذيب في قلوب المجرمين فلا يؤمنون","cause":"الاستهزاء بالرسل","result":"سلوك التكذيب في قلوب المجرمين فلا يؤمنون","explicit":true,"ref":"سورة الحجر: 11–13","srcLabel":"القرآن الكريم","quran":{"s":15,"from":11,"to":13,"text":"وَمَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ (11) كَذَلِكَ نَسْلُكُهُ فِي قُلُوبِ الْمُجْرِمِينَ (12) لَا يُؤْمِنُونَ بِهِ وَقَدْ خَلَتْ سُنَّةُ الْأَوَّلِينَ (13)","hl":[[0,144,1]]}},{"id":"ق-0682","fp":"2908b38cb12c","stateId":190,"easy":"عدم الإيمان بآيات الله ← لا يهديهم الله وعذاب أليم","cause":"عدم الإيمان بآيات الله","result":"لا يهديهم الله وعذاب أليم","explicit":true,"otherNeedIds":[69],"ref":"سورة النحل: 104","srcLabel":"القرآن الكريم","quran":{"s":16,"from":104,"to":104,"text":"إِنَّ الَّذِينَ لَا يُؤْمِنُونَ بِآيَاتِ اللَّهِ لَا يَهْدِيهِمُ اللَّهُ وَلَهُمْ عَذَابٌ أَلِيمٌ (104)","hl":[[0,97,1]]}},{"id":"ق-0710","fp":"f4fee465d3c4","stateId":190,"easy":"عدم الإيمان بالآخرة ← حجاب عن القرآن وأكنّة على القلوب ووقر في الآذان","cause":"عدم الإيمان بالآخرة","result":"حجاب عن القرآن وأكنّة على القلوب ووقر في الآذان","explicit":true,"ref":"سورة الإسراء: 45–46","srcLabel":"القرآن الكريم","quran":{"s":17,"from":45,"to":46,"text":"وَإِذَا قَرَأْتَ الْقُرْآنَ جَعَلْنَا بَيْنَكَ وَبَيْنَ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ حِجَابًا مَسْتُورًا (45) وَجَعَلْنَا عَلَى قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا وَإِذَا ذَكَرْتَ رَبَّكَ فِي الْقُرْآنِ وَحْدَهُ وَلَّوْا عَلَى أَدْبَارِهِمْ نُفُورًا (46)","hl":[[0,201,1]]}},{"id":"ق-0839","fp":"c6ecc7ac8358","stateId":190,"easy":"عدم الإيمان بالآخرة ← النكوب عن الصراط","cause":"عدم الإيمان بالآخرة","result":"النكوب عن الصراط","explicit":true,"ref":"سورة المؤمنون: 74","srcLabel":"القرآن الكريم","quran":{"s":23,"from":74,"to":74,"text":"وَإِنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ عَنِ الصِّرَاطِ لَنَاكِبُونَ (74)","hl":[[0,75,1]]}},{"id":"ق-0862","fp":"b4205983da63","stateId":190,"easy":"الحرمان من نور الله (الكفر) ← لا نور له","cause":"الحرمان من نور الله (الكفر)","result":"لا نور له","explicit":true,"ref":"سورة النور: 40","srcLabel":"القرآن الكريم","quran":{"s":24,"from":40,"to":40,"text":"أَوْ كَظُلُمَاتٍ فِي بَحْرٍ لُجِّيٍّ يَغْشَاهُ مَوْجٌ مِنْ فَوْقِهِ مَوْجٌ مِنْ فَوْقِهِ سَحَابٌ ظُلُمَاتٌ بَعْضُهَا فَوْقَ بَعْضٍ إِذَا أَخْرَجَ يَدَهُ لَمْ يَكَدْ يَرَاهَا وَمَنْ لَمْ يَجْعَلِ اللَّهُ لَهُ نُورًا فَمَا لَهُ مِنْ نُورٍ (40)","hl":[[174,236,1]]}},{"id":"ق-0898","fp":"6ff8dc98299a","stateId":190,"easy":"عدم الإيمان بالآخرة ← تزيين الأعمال والعَمَه وسوء العذاب والأخسرون في الآخرة","cause":"عدم الإيمان بالآخرة","result":"تزيين الأعمال والعَمَه وسوء العذاب والأخسرون في الآخرة","explicit":true,"otherNeedIds":[69,57],"ref":"سورة النمل: 4–5","srcLabel":"القرآن الكريم","quran":{"s":27,"from":4,"to":5,"text":"إِنَّ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ زَيَّنَّا لَهُمْ أَعْمَالَهُمْ فَهُمْ يَعْمَهُونَ (4) أُولَئِكَ الَّذِينَ لَهُمْ سُوءُ الْعَذَابِ وَهُمْ فِي الْآخِرَةِ هُمُ الْأَخْسَرُونَ (5)","hl":[[0,184,1]]}},{"id":"ق-0953","fp":"af4107ec70f8","stateId":190,"easy":"الإساءة ← السوأى: التكذيب بآيات الله والاستهزاء بها","cause":"الإساءة","result":"السوأى: التكذيب بآيات الله والاستهزاء بها","explicit":true,"otherNeedIds":[61],"ref":"سورة الروم: 10","srcLabel":"القرآن الكريم","quran":{"s":30,"from":10,"to":10,"text":"ثُمَّ كَانَ عَاقِبَةَ الَّذِينَ أَسَاءُوا السُّوأَى أَنْ كَذَّبُوا بِآيَاتِ اللَّهِ وَكَانُوا بِهَا يَسْتَهْزِئُونَ (10)","hl":[[0,115,1]]}},{"id":"ق-1007","fp":"3dca2b6bdcee","stateId":190,"easy":"عدم الإيمان بالآخرة ← العذاب والضلال البعيد","cause":"عدم الإيمان بالآخرة","result":"العذاب والضلال البعيد","explicit":true,"otherNeedIds":[69],"ref":"سورة سبأ: 8","srcLabel":"القرآن الكريم","quran":{"s":34,"from":8,"to":8,"text":"أَفْتَرَى عَلَى اللَّهِ كَذِبًا أَمْ بِهِ جِنَّةٌ بَلِ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ فِي الْعَذَابِ وَالضَّلَالِ الْبَعِيدِ (8)","hl":[[50,132,1]]}},{"id":"ق-1122","fp":"925ae2ccd2da","stateId":190,"easy":"جحود آيات الله ← الصرف عن الحق (الإفك)","cause":"جحود آيات الله","result":"الصرف عن الحق (الإفك)","explicit":true,"ref":"سورة غافر: 63","srcLabel":"القرآن الكريم","quran":{"s":40,"from":63,"to":63,"text":"كَذَلِكَ يُؤْفَكُ الَّذِينَ كَانُوا بِآيَاتِ اللَّهِ يَجْحَدُونَ (63)","hl":[[0,64,1]]}},{"id":"ق-1140","fp":"58e0287ad910","stateId":190,"easy":"عدم الإيمان ← وقر في الآذان وعمى","cause":"عدم الإيمان","result":"وقر في الآذان وعمى","explicit":true,"ref":"سورة فصلت: 44","srcLabel":"القرآن الكريم","quran":{"s":41,"from":44,"to":44,"text":"وَلَوْ جَعَلْنَاهُ قُرْآنًا أَعْجَمِيًّا لَقَالُوا لَوْلَا فُصِّلَتْ آيَاتُهُ أَأَعْجَمِيٌّ وَعَرَبِيٌّ قُلْ هُوَ لِلَّذِينَ آمَنُوا هُدًى وَشِفَاءٌ وَالَّذِينَ لَا يُؤْمِنُونَ فِي آذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى أُولَئِكَ يُنَادَوْنَ مِنْ مَكَانٍ بَعِيدٍ (44)","hl":[[149,265,1]]}},{"id":"ق-1202","fp":"5bdc0770c90f","stateId":190,"easy":"عدم إجابة داعي الله ← لا يعجز الله ولا أولياء له وضلال مبين","cause":"عدم إجابة داعي الله","result":"لا يعجز الله ولا أولياء له وضلال مبين","explicit":true,"otherNeedIds":[60],"ref":"سورة الأحقاف: 32","srcLabel":"القرآن الكريم","quran":{"s":46,"from":32,"to":32,"text":"وَمَنْ لَا يُجِبْ دَاعِيَ اللَّهِ فَلَيْسَ بِمُعْجِزٍ فِي الْأَرْضِ وَلَيْسَ لَهُ مِنْ دُونِهِ أَوْلِيَاءُ أُولَئِكَ فِي ضَلَالٍ مُبِينٍ (32)","hl":[[0,136,1]]}},{"id":"ق-1253","fp":"f4fe0b483a0c","stateId":190,"easy":"التكذيب بالحق ← أمر مريج (اضطراب)","cause":"التكذيب بالحق","result":"أمر مريج (اضطراب)","explicit":true,"otherNeedIds":[10],"ref":"سورة ق: 5","srcLabel":"القرآن الكريم","quran":{"s":50,"from":5,"to":5,"text":"بَلْ كَذَّبُوا بِالْحَقِّ لَمَّا جَاءَهُمْ فَهُمْ فِي أَمْرٍ مَرِيجٍ (5)","hl":[[0,68,1]]}},{"id":"ق-1323","fp":"ba634c060193","stateId":190,"easy":"موالاة أعداء الله وإلقاء المودة إليهم ← ضلال سواء السبيل","cause":"موالاة أعداء الله وإلقاء المودة إليهم","result":"ضلال سواء السبيل","explicit":true,"ref":"سورة الممتحنة: 1","srcLabel":"القرآن الكريم","quran":{"s":60,"from":1,"to":1,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا عَدُوِّي وَعَدُوَّكُمْ أَوْلِيَاءَ تُلْقُونَ إِلَيْهِمْ بِالْمَوَدَّةِ وَقَدْ كَفَرُوا بِمَا جَاءَكُمْ مِنَ الْحَقِّ يُخْرِجُونَ الرَّسُولَ وَإِيَّاكُمْ أَنْ تُؤْمِنُوا بِاللَّهِ رَبِّكُمْ إِنْ كُنْتُمْ خَرَجْتُمْ جِهَادًا فِي سَبِيلِي وَابْتِغَاءَ مَرْضَاتِي تُسِرُّونَ إِلَيْهِمْ بِالْمَوَدَّةِ وَأَنَا أَعْلَمُ بِمَا أَخْفَيْتُمْ وَمَا أَعْلَنْتُمْ وَمَنْ يَفْعَلْهُ مِنْكُمْ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ (1)","hl":[[399,457,1]]}},{"id":"ق-1329","fp":"d1427c4758d9","stateId":190,"easy":"افتراء الكذب على الله عند الدعوة إلى الإسلام ← لا يهديه الله","cause":"افتراء الكذب على الله عند الدعوة إلى الإسلام","result":"لا يهديه الله","explicit":true,"repOf":"ق-0382","ref":"سورة الصف: 7","quran":{"s":61,"from":7,"to":7,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَى عَلَى اللَّهِ الْكَذِبَ وَهُوَ يُدْعَى إِلَى الْإِسْلَامِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (7)","hl":[[0,136,1]]}},{"id":"س-00571","fp":"a11beefa5eab","stateId":190,"easy":"إذا لم تُعطَ القرآن ولا الإيمان ← فمثلك كالحنظلة مُرّة لا ريح لها","cause":"مَن لم يُعطَ القرآنَ ولم يُعطَ الإيمانَ","result":"كمَثَلِ الحنظلةِ مُرَّةِ الطَّعمِ لا ريحَ لها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج صحيح ابن حبان 121","srcLabel":"متفق عليه","text":["مَثَلُ مَن أُعطي القرآنَ والإيمانَ كمثَلِ أُترُجَّةٍ طيِّبِ الطَّعمِ طيِّبِ الرِّيحِ ومَثَلُ ",["مَن لم يُعطَ القرآنَ ولم يُعطَ الإيمانَ",1]," ",["كمَثَلِ الحنظلةِ مُرَّةِ الطَّعمِ لا ريحَ لها",2]," ومَثلُ مَن أُعطي الإيمانَ ولم يُعطَ القرآنَ كمَثَلِ التَّمرةِ طيِّبةِ الطَّعمِ ولا ريحَ لها ومَثَلُ مَن أُعطي القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الرَّيحانةِ مُرَّةِ الطَّعمِ طيِّبةِ الرِّيحِ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5020)، ومسلم (797)، والترمذي (2865)، والنسائي (5038)، وابن حبان (403) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"EfJmTtpI"},{"id":"ق-0009","fp":"4d024e5c8f8e","stateId":190,"easy":"الفسق: نقض عهد الله وقطع ما أمر بوصله والإفساد في الأرض ← الإضلال والخسران","cause":"الفسق: نقض عهد الله وقطع ما أمر بوصله والإفساد في الأرض","result":"الإضلال والخسران","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة البقرة: 26–27","srcLabel":"القرآن الكريم","quran":{"s":2,"from":26,"to":27,"text":"إِنَّ اللَّهَ لَا يَسْتَحْيِي أَنْ يَضْرِبَ مَثَلًا مَا بَعُوضَةً فَمَا فَوْقَهَا فَأَمَّا الَّذِينَ آمَنُوا فَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ وَأَمَّا الَّذِينَ كَفَرُوا فَيَقُولُونَ مَاذَا أَرَادَ اللَّهُ بِهَذَا مَثَلًا يُضِلُّ بِهِ كَثِيرًا وَيَهْدِي بِهِ كَثِيرًا وَمَا يُضِلُّ بِهِ إِلَّا الْفَاسِقِينَ (26) الَّذِينَ يَنْقُضُونَ عَهْدَ اللَّهِ مِنْ بَعْدِ مِيثَاقِهِ وَيَقْطَعُونَ مَا أَمَرَ اللَّهُ بِهِ أَنْ يُوصَلَ وَيُفْسِدُونَ فِي الْأَرْضِ أُولَئِكَ هُمُ الْخَاسِرُونَ (27)","hl":[[281,493,1]]}},{"id":"ق-0341","fp":"abdb6ce39368","stateId":190,"easy":"الفسق ← لا يهديهم الله","cause":"الفسق","result":"لا يهديهم الله","explicit":true,"ref":"سورة المائدة: 108","srcLabel":"القرآن الكريم","quran":{"s":5,"from":108,"to":108,"text":"ذَلِكَ أَدْنَى أَنْ يَأْتُوا بِالشَّهَادَةِ عَلَى وَجْهِهَا أَوْ يَخَافُوا أَنْ تُرَدَّ أَيْمَانٌ بَعْدَ أَيْمَانِهِمْ وَاتَّقُوا اللَّهَ وَاسْمَعُوا وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (108)","hl":[[150,195,1]]}},{"id":"ق-0555","fp":"85e0dfc04028","stateId":190,"easy":"الفسق ← حقّت كلمة الله أنهم لا يؤمنون","cause":"الفسق","result":"حقّت كلمة الله أنهم لا يؤمنون","explicit":true,"ref":"سورة يونس: 33","srcLabel":"القرآن الكريم","quran":{"s":10,"from":33,"to":33,"text":"كَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ فَسَقُوا أَنَّهُمْ لَا يُؤْمِنُونَ (33)","hl":[[0,68,1]]}},{"id":"ق-0003","fp":"01818fa6f10f","stateId":191,"easy":"النفاق والكذب ← زيادة مرض القلب وعذاب أليم","cause":"النفاق والكذب","result":"زيادة مرض القلب وعذاب أليم","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة البقرة: 10","srcLabel":"القرآن الكريم","quran":{"s":2,"from":10,"to":10,"text":"فِي قُلُوبِهِمْ مَرَضٌ فَزَادَهُمُ اللَّهُ مَرَضًا وَلَهُمْ عَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْذِبُونَ (10)","hl":[[0,101,1]]}},{"id":"ق-0004","fp":"7edacd789e33","stateId":191,"easy":"النفاق والاستهزاء بالمؤمنين ← استهزاء الله بهم ومدّهم في طغيانهم يعمهون","cause":"النفاق والاستهزاء بالمؤمنين","result":"استهزاء الله بهم ومدّهم في طغيانهم يعمهون","explicit":true,"star":true,"otherNeedIds":[61],"ref":"سورة البقرة: 14–15","srcLabel":"القرآن الكريم","quran":{"s":2,"from":14,"to":15,"text":"وَإِذَا لَقُوا الَّذِينَ آمَنُوا قَالُوا آمَنَّا وَإِذَا خَلَوْا إِلَى شَيَاطِينِهِمْ قَالُوا إِنَّا مَعَكُمْ إِنَّمَا نَحْنُ مُسْتَهْزِئُونَ (14) اللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ (15)","hl":[[0,218,1]]}},{"id":"ق-0236","fp":"f9d034ecbf56","stateId":191,"easy":"كسب السيئات (النفاق) ← إركاس الله لهم وإضلالهم","cause":"كسب السيئات (النفاق)","result":"إركاس الله لهم وإضلالهم","explicit":true,"star":true,"ref":"سورة النساء: 88","srcLabel":"القرآن الكريم","quran":{"s":4,"from":88,"to":88,"text":"فَمَا لَكُمْ فِي الْمُنَافِقِينَ فِئَتَيْنِ وَاللَّهُ أَرْكَسَهُمْ بِمَا كَسَبُوا أَتُرِيدُونَ أَنْ تَهْدُوا مَنْ أَضَلَّ اللَّهُ وَمَنْ يُضْلِلِ اللَّهُ فَلَنْ تَجِدَ لَهُ سَبِيلًا (88)","hl":[[44,81,1]]}},{"id":"ق-0266","fp":"f4dc5951c542","stateId":191,"easy":"النفاق: مخادعة الله والكسل في الصلاة والرياء وقلة الذكر والتذبذب ← الله خادعهم وإضلالهم","cause":"النفاق: مخادعة الله والكسل في الصلاة والرياء وقلة الذكر والتذبذب","result":"الله خادعهم وإضلالهم","explicit":true,"ref":"سورة النساء: 142–143","srcLabel":"القرآن الكريم","quran":{"s":4,"from":142,"to":143,"text":"إِنَّ الْمُنَافِقِينَ يُخَادِعُونَ اللَّهَ وَهُوَ خَادِعُهُمْ وَإِذَا قَامُوا إِلَى الصَّلَاةِ قَامُوا كُسَالَى يُرَاءُونَ النَّاسَ وَلَا يَذْكُرُونَ اللَّهَ إِلَّا قَلِيلًا (142) مُذَبْذَبِينَ بَيْنَ ذَلِكَ لَا إِلَى هَؤُلَاءِ وَلَا إِلَى هَؤُلَاءِ وَمَنْ يُضْلِلِ اللَّهُ فَلَنْ تَجِدَ لَهُ سَبِيلًا (143)","hl":[[0,301,1]]}},{"id":"ق-0501","fp":"f897f805a00d","stateId":191,"easy":"عدم صدق الإرادة (النفاق) ← تثبيط الله لهم","cause":"عدم صدق الإرادة (النفاق)","result":"تثبيط الله لهم","explicit":true,"ref":"سورة التوبة: 46","srcLabel":"القرآن الكريم","quran":{"s":9,"from":46,"to":46,"text":"وَلَوْ أَرَادُوا الْخُرُوجَ لَأَعَدُّوا لَهُ عُدَّةً وَلَكِنْ كَرِهَ اللَّهُ انْبِعَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ اقْعُدُوا مَعَ الْقَاعِدِينَ (46)","hl":[[0,142,1]]}},{"id":"ق-0502","fp":"25b3c60418df","stateId":191,"easy":"التعلّل بخوف الفتنة لترك أمر الله ← السقوط في الفتنة وإحاطة جهنم","cause":"التعلّل بخوف الفتنة لترك أمر الله","result":"السقوط في الفتنة وإحاطة جهنم","explicit":true,"otherNeedIds":[69],"ref":"سورة التوبة: 49","srcLabel":"القرآن الكريم","quran":{"s":9,"from":49,"to":49,"text":"وَمِنْهُمْ مَنْ يَقُولُ ائْذَنْ لِي وَلَا تَفْتِنِّي أَلَا فِي الْفِتْنَةِ سَقَطُوا وَإِنَّ جَهَنَّمَ لَمُحِيطَةٌ بِالْكَافِرِينَ (49)","hl":[[0,129,1]]}},{"id":"ق-0509","fp":"10ec76897e5d","stateId":191,"easy":"نسيان الله والأمر بالمنكر والنهي عن المعروف والبخل ← نسيان الله لهم","cause":"نسيان الله والأمر بالمنكر والنهي عن المعروف والبخل","result":"نسيان الله لهم","explicit":true,"otherNeedIds":[28],"ref":"سورة التوبة: 67","srcLabel":"القرآن الكريم","quran":{"s":9,"from":67,"to":67,"text":"الْمُنَافِقُونَ وَالْمُنَافِقَاتُ بَعْضُهُمْ مِنْ بَعْضٍ يَأْمُرُونَ بِالْمُنْكَرِ وَيَنْهَوْنَ عَنِ الْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ نَسُوا اللَّهَ فَنَسِيَهُمْ إِنَّ الْمُنَافِقِينَ هُمُ الْفَاسِقُونَ (67)","hl":[[0,209,1]]}},{"id":"ق-0520","fp":"bb37102ac224","stateId":191,"easy":"الرضا بالقعود مع الخوالف ← الطبع على القلوب","cause":"الرضا بالقعود مع الخوالف","result":"الطبع على القلوب","explicit":true,"ref":"سورة التوبة: 87","srcLabel":"القرآن الكريم","quran":{"s":9,"from":87,"to":87,"text":"رَضُوا بِأَنْ يَكُونُوا مَعَ الْخَوَالِفِ وَطُبِعَ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ (87)","hl":[[0,91,1]]}},{"id":"ق-0540","fp":"7385b63a6ea6","stateId":191,"easy":"مرض القلب (النفاق) عند نزول القرآن ← زيادة الرجس والموت على الكفر","cause":"مرض القلب (النفاق) عند نزول القرآن","result":"زيادة الرجس والموت على الكفر","explicit":true,"ref":"سورة التوبة: 125","srcLabel":"القرآن الكريم","quran":{"s":9,"from":125,"to":125,"text":"وَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ فَزَادَتْهُمْ رِجْسًا إِلَى رِجْسِهِمْ وَمَاتُوا وَهُمْ كَافِرُونَ (125)","hl":[[0,108,1]]}},{"id":"ق-0824","fp":"08a8f4bc1ab6","stateId":191,"easy":"مرض القلب وقسوته ← الافتتان بما يلقي الشيطان وشقاق بعيد","cause":"مرض القلب وقسوته","result":"الافتتان بما يلقي الشيطان وشقاق بعيد","explicit":true,"otherNeedIds":[34],"ref":"سورة الحج: 53","srcLabel":"القرآن الكريم","quran":{"s":22,"from":53,"to":53,"text":"لِيَجْعَلَ مَا يُلْقِي الشَّيْطَانُ فِتْنَةً لِلَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْقَاسِيَةِ قُلُوبُهُمْ وَإِنَّ الظَّالِمِينَ لَفِي شِقَاقٍ بَعِيدٍ (53)","hl":[[0,149,1]]}},{"id":"ق-1336","fp":"4e3f0c3fcfe7","stateId":191,"easy":"اتخاذ الأيمان وقاية والصد عن سبيل الله والكفر بعد الإيمان ← الطبع على القلوب","cause":"اتخاذ الأيمان وقاية والصد عن سبيل الله والكفر بعد الإيمان","result":"الطبع على القلوب","explicit":true,"ref":"سورة المنافقون: 2–3","srcLabel":"القرآن الكريم","quran":{"s":63,"from":2,"to":3,"text":"اتَّخَذُوا أَيْمَانَهُمْ جُنَّةً فَصَدُّوا عَنْ سَبِيلِ اللَّهِ إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ (2) ذَلِكَ بِأَنَّهُمْ آمَنُوا ثُمَّ كَفَرُوا فَطُبِعَ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ (3)","hl":[[0,199,1]]}},{"id":"س-04981","fp":"dd8768a439ed","stateId":191,"easy":"إذا أُعجبت بعملك ← فالعجب أخطر عليك من الذنب","cause":"العُجْبَ","result":"لَخَشِيتُ عليكم ما هو أَكثَرُ مِنه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[13],"ref":"الأحكام الوسطى 4/ 277","srcLabel":"الأحكام الوسطى","text":["\"لو لم تَكونوا تُذْنِبونَ ",["لَخَشِيتُ عليكم ما هو أَكثَرُ مِنه",2],": ",["العُجْبَ",1],"\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1M9p9pB7","merged":2,"otherRefs":["صحيح الجامع 5303 (حسن)"]},{"id":"ق-0880","fp":"43077d0cd886","stateId":192,"easy":"اتخاذ الهوى إلهاً ← كالأنعام بل أضل سبيلاً","cause":"اتخاذ الهوى إلهاً","result":"كالأنعام بل أضل سبيلاً","explicit":true,"ref":"سورة الفرقان: 43–44","srcLabel":"القرآن الكريم","quran":{"s":25,"from":43,"to":44,"text":"أَرَأَيْتَ مَنِ اتَّخَذَ إِلَهَهُ هَوَاهُ أَفَأَنْتَ تَكُونُ عَلَيْهِ وَكِيلًا (43) أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَ إِنْ هُمْ إِلَّا كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا (44)","hl":[[0,204,1]]}},{"id":"ق-0921","fp":"f73ec41b16ff","stateId":192,"easy":"اتباع الهوى بغير هدى من الله ← أضلّ الضلال ولا يهديه الله","cause":"اتباع الهوى بغير هدى من الله","result":"أضلّ الضلال ولا يهديه الله","explicit":true,"ref":"سورة القصص: 50","srcLabel":"القرآن الكريم","quran":{"s":28,"from":50,"to":50,"text":"فَإِنْ لَمْ يَسْتَجِيبُوا لَكَ فَاعْلَمْ أَنَّمَا يَتَّبِعُونَ أَهْوَاءَهُمْ وَمَنْ أَضَلُّ مِمَّنِ اتَّبَعَ هَوَاهُ بِغَيْرِ هُدًى مِنَ اللَّهِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (50)","hl":[[77,194,1]]}},{"id":"ق-1061","fp":"5af53429e24f","stateId":192,"easy":"اتباع الهوى ← الضلال عن سبيل الله وعذاب شديد بنسيان يوم الحساب","cause":"اتباع الهوى","result":"الضلال عن سبيل الله وعذاب شديد بنسيان يوم الحساب","explicit":true,"otherNeedIds":[69],"ref":"سورة ص: 26","srcLabel":"القرآن الكريم","quran":{"s":38,"from":26,"to":26,"text":"يَا دَاوُودُ إِنَّا جَعَلْنَاكَ خَلِيفَةً فِي الْأَرْضِ فَاحْكُمْ بَيْنَ النَّاسِ بِالْحَقِّ وَلَا تَتَّبِعِ الْهَوَى فَيُضِلَّكَ عَنْ سَبِيلِ اللَّهِ إِنَّ الَّذِينَ يَضِلُّونَ عَنْ سَبِيلِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ بِمَا نَسُوا يَوْمَ الْحِسَابِ (26)","hl":[[93,252,1]]}},{"id":"ق-1188","fp":"4b78c55d3af3","stateId":192,"easy":"اتخاذ الهوى إلهاً ← الإضلال على علم والختم على السمع والقلب وغشاوة البصر","cause":"اتخاذ الهوى إلهاً","result":"الإضلال على علم والختم على السمع والقلب وغشاوة البصر","explicit":true,"ref":"سورة الجاثية: 23","srcLabel":"القرآن الكريم","quran":{"s":45,"from":23,"to":23,"text":"أَفَرَأَيْتَ مَنِ اتَّخَذَ إِلَهَهُ هَوَاهُ وَأَضَلَّهُ اللَّهُ عَلَى عِلْمٍ وَخَتَمَ عَلَى سَمْعِهِ وَقَلْبِهِ وَجَعَلَ عَلَى بَصَرِهِ غِشَاوَةً فَمَنْ يَهْدِيهِ مِنْ بَعْدِ اللَّهِ أَفَلَا تَذَكَّرُونَ (23)","hl":[[0,145,1]]}},{"id":"ق-1216","fp":"82520f48eef1","stateId":192,"easy":"الاستماع بلا وعي واتباع الأهواء ← الطبع على القلوب","cause":"الاستماع بلا وعي واتباع الأهواء","result":"الطبع على القلوب","explicit":true,"ref":"سورة محمد: 16","srcLabel":"القرآن الكريم","quran":{"s":47,"from":16,"to":16,"text":"وَمِنْهُمْ مَنْ يَسْتَمِعُ إِلَيْكَ حَتَّى إِذَا خَرَجُوا مِنْ عِنْدِكَ قَالُوا لِلَّذِينَ أُوتُوا الْعِلْمَ مَاذَا قَالَ آنِفًا أُولَئِكَ الَّذِينَ طَبَعَ اللَّهُ عَلَى قُلُوبِهِمْ وَاتَّبَعُوا أَهْوَاءَهُمْ (16)","hl":[[0,208,1]]}},{"id":"س-05000","fp":"74982d0d7563","stateId":192,"easy":"إذا اتبعت الهوى ← يبعدك عن الحق","cause":"فأمَّا الهوى","result":"فيُبعِدُ عن الحَقِّ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 596","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ أخوفَ ما أخافُ على أمَّتي الهوى وطولُ الأمَلِ؛ ",["فأمَّا الهوى",1]," ",["فيُبعِدُ عن الحَقِّ",2],"، وأمَّا طولُ الأمَلِ فيُنسي الآخِرةَ"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aIC9DI3U"},{"id":"س-07322","fp":"b968ed768179","stateId":193,"easy":"إذا ابتدعت كلاماً ليس في الكتاب ولا السنة ← فهو ضلالة","cause":"ويَبتدِعُ كَلامًا ليْس في كتابِ اللهِ ولا مِن سُنَّةِ رَسولِ اللهِ","result":"فإنَّ كلَّ ما ابتَدَعَ ضَلالةٌ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8661","srcLabel":"مسلم","text":["عن مُعاذِ بنِ جَبلٍ رَضيَ اللهُ عنه، قال: تكونُ فِتنةٌ يَكثُرُ فيها المالُ، ويُفتَحُ فيها القرآنُ حتَّى يَقرَأَه المؤمنُ والمنافقُ، والصَّغيرُ والكبيرُ، والرَّجلُ والمرأةُ، يَقرَؤه الرَّجلُ سِرًّا فلا يُتَّبَعُ عليها، فيَقولُ: واللهِ لَأقْرَأنَّه عَلانيةً، ثمَّ يَقرَؤه عَلانيةً، فلا يُتَّبَعُ عليها، فيَتَّخِذُ مَسجدًا ",["ويَبتدِعُ كَلامًا ليْس في كتابِ اللهِ ولا مِن سُنَّةِ رَسولِ اللهِ",1]," صلَّى اللهُ عليه وسلَّمَ، فإيَّاكم وإيَّاه؛ ",["فإنَّ كلَّ ما ابتَدَعَ ضَلالةٌ",2],". قال: ولَمَّا مَرِض مُعاذُ بنُ جَبلٍ مَرَضَه الَّذي قُبِض فيه كان يُغْشى عليه أحيانًا، ويُفِيقُ أحيانًا، حتَّى غُشِي عليه غَشْيةٌ ظَننَّا أنَّه قدْ قُبِض، ثمَّ أفاقَ وأنا مُقابِلُه أبْكي، فقال: ما يُبْكِيكَ؟ قُلتُ: واللهِ لا أبْكي على دُنْيا كُنتُ أنالُها منكَ، ولا على نَسبٍ بيْني وبيْنكَ، ولكنْ أبْكي على العلمِ والحُكمِ الَّذي أسْمَعُ منكَ يَذهَبُ، قال: فلا تَبْكِ؛ فإنَّ العلمَ والإيمانَ مَكانَهما، مَن ابْتَغاهما وجَدَهما، فابْتَغِه حيثُ ابْتَغاهُ إبراهيمُ عليه الصَّلاةُ والسَّلامُ؛ فإنَّه سَألَ اللهَ تعالَى وهو لا يَعلَمُ، وتَلا: {إِنِّي ذَاهِبٌ إِلَى رَبِّي سَيَهْدِينِ} [الصافات: 99]، وابْتَغِه بَعْدي عِندَ أربعةِ نَفرٍ، وإنْ لم تَجِدْه عِندَ واحدٍ منهم، فسَلْ عن النَّاسِ أعيانَه: عبدُ اللهِ بنُ مَسعودٍ، وعبدُ اللهِ بنُ سَلَامٍ، وسَلْمانُ، وعُوَيمرٌ أبو الدَّرداءِ. وإيَّاكَ وزَيْغةَ الحكيمِ وحِكَمَ المنافِقِ قال: قُلتُ: وكيْف لي أنْ أعلَمَ زَيْغةَ الحكيمِ؟ قال: كَلمةُ ضَلالةٍ يُلْقِيها الشَّيطانُ على لِسانِ الرَّجلِ، فلا يَحمِلُها ولا يَتأمَّلُ منه، فإنَّ المنافِقَ قدْ يَقولُ الحقَّ، فخُذِ العلمَ أنَّى جاءك؛ فإنَّ على الحقِّ نُورًا، وإيَّاكَ ومُعضِلاتِ الأُمورِ."],"grade":"صحيح","narrator":"يزيد بن عميرة","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه","takhrij":"أخرجه الفسوي في ((المعرفة والتاريخ)) (2/ 550)، وابن عساكر في ((تاريخه)) (65/ 340) كلاهما باختلاف يسير.","bab":"فتن › فتنة المال","dorar":"Cu7zb5vt"},{"id":"س-08351","fp":"de9c5cd5c119","stateId":193,"easy":"إذا اتبعت محدثات الأمور ← فكل محدثة بدعة وكل بدعة ضلالة","cause":"وإيَّاكم ومُحدَثاتِ الأُمورِ","result":"فإنَّ كُلَ مُحدَثةٍ بِدْعةٌ، وكلَّ بِدْعةٍ ضَلالةٌ","explicit":true,"ref":"تخريج سنن أبي داود 4607","srcLabel":"أبو داود","text":["أتَيْنا العِرباضَ بنَ ساريةَ -وهو ممَّن نزَلَ فيه: {وَلَا عَلَى الَّذِينَ إِذَا مَا أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ لَا أَجِدُ مَا أَحْمِلُكُمْ عَلَيْهِ} [التوبة: 92]- فسَلَّمْنا، وقُلنا: أتَيْناك زائِرينَ وعائِدينَ ومُقتبِسينَ، فقال العِرباضُ: صلَّى بنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ذاتَ يَومٍ، ثُمَّ أقبَلَ علينا، فوَعَظَنا مَوعِظةً بَليغةً ذَرَفَتْ منها العُيونُ، ووَجِلَتْ منها القُلوبُ، فقال قائلٌ: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، كأنَّ هذه مَوعِظةُ مُودِّعٍ، فماذا تَعهَدُ إلينا؟ قال: أُوصيكم بتَقْوى اللهِ، والسَّمعِ والطَّاعةِ وإنْ عبدًا حَبَشيًّا؛ فإنَّه مَن يَعِشْ منكم بعدي فسَيَرى اختِلافًا كثيرًا، فعليكم بسُنَّتي وسُنَّةِ الخُلَفاءِ المَهْديِّينَ الرَّاشِدينَ، تمسَّكوا بها، وعَضُّوا عليها بالنَّواجِذِ، ",["وإيَّاكم ومُحدَثاتِ الأُمورِ؛ ",1],["فإنَّ كُلَ مُحدَثةٍ بِدْعةٌ، وكلَّ بِدْعةٍ ضَلالةٌ",2],"."],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4607)، وأحمد (17145)، وابن حبان (5) واللفظ لهم، والترمذي (2676) مختصرا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"aTtFvkrk","merged":7,"otherRefs":["الأربعون البلدانية 119 (صحيح)","صحيح الترغيب 55 (صحيح)","فتاوى نور على الدرب لابن عثيمين 6/283 (صحيح)","فتاوى نور على الدرب لابن باز 3/58 (صحيح)","المستدرك على الصحيحين 337 (صحيح)","صحيح الترغيب 37 (صحيح)"]},{"id":"ق-0127","fp":"ad074d0265b5","stateId":193,"easy":"الاغترار بالأماني والافتراء في الدين ← التولي عن حكم كتاب الله","cause":"الاغترار بالأماني والافتراء في الدين","result":"التولي عن حكم كتاب الله","explicit":true,"ref":"سورة آل عمران: 23–24","srcLabel":"القرآن الكريم","quran":{"s":3,"from":23,"to":24,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يُدْعَوْنَ إِلَى كِتَابِ اللَّهِ لِيَحْكُمَ بَيْنَهُمْ ثُمَّ يَتَوَلَّى فَرِيقٌ مِنْهُمْ وَهُمْ مُعْرِضُونَ (23) ذَلِكَ بِأَنَّهُمْ قَالُوا لَنْ تَمَسَّنَا النَّارُ إِلَّا أَيَّامًا مَعْدُودَاتٍ وَغَرَّهُمْ فِي دِينِهِمْ مَا كَانُوا يَفْتَرُونَ (24)","hl":[[0,305,1]]}},{"id":"ق-0497","fp":"f343f45212ba","stateId":193,"easy":"تحليل ما حرم الله (النسيء) ← تزيين سوء العمل والحرمان من الهداية","cause":"تحليل ما حرم الله (النسيء)","result":"تزيين سوء العمل والحرمان من الهداية","explicit":true,"ref":"سورة التوبة: 37","srcLabel":"القرآن الكريم","quran":{"s":9,"from":37,"to":37,"text":"إِنَّمَا النَّسِيءُ زِيَادَةٌ فِي الْكُفْرِ يُضَلُّ بِهِ الَّذِينَ كَفَرُوا يُحِلُّونَهُ عَامًا وَيُحَرِّمُونَهُ عَامًا لِيُوَاطِئُوا عِدَّةَ مَا حَرَّمَ اللَّهُ فَيُحِلُّوا مَا حَرَّمَ اللَّهُ زُيِّنَ لَهُمْ سُوءُ أَعْمَالِهِمْ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ (37)","hl":[[0,274,1]]}},{"id":"س-03671","fp":"999b170d3ade","stateId":193,"easy":"إذا زغت عن المحجة البيضاء ← تهلك","cause":"لا يزيغُ عنها بعدي","result":"إلا هالِكٌ","explicit":true,"ref":"الفتح الرباني 5/2229","srcLabel":"أبو داود","text":["وعظَنا رسولُ اللهِ صلَّى اللهُ عليه وآلِه وسلَّمَ مَوعظةً ذَرَفَتْ منها العيونُ ووجِلَتْ منها القلوبُ فقلنا يا رسولَ اللهِ إنَّ هذه لموعِظَةَ مُوَدِّعٍ فماذا تعهَدُ إلينا ؟ فقال : تركتُكم على البيضاءِ ليلِها كنهارِها ",["لا يزيغُ عنها بعدي",1]," ",["إلا هالِكٌ",2]," ، ومن يَعِشْ منكم فسَيرى اختلافًا كثيرًا فعليكم بما عرَفتُم من سُنَّتي وسُنَّةِ الخلفاءِ المهدِيِّينَ الرَّاشدينَ . وعليكم بالطاعةِ وإن كان عبدًا حبشيًّا عَضُّوا عليها بالنَّواجذِ فإنما المؤمنُ كالجملِ الأَنِفِ كلما قِيدَ انقَادَ"],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"ثابت ورجاله رجال الصحيح","takhrij":"أخرجه أبو داود (4607)، والترمذي (2676)، وابن ماجه (42)، وأحمد (17144) باختلاف يسير","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"Yr6nOjP2","merged":3,"otherRefs":["تخريج كتاب السنة 48 (صحيح)","الفتح الرباني 8/3784 (صحيح)"]},{"id":"س-03708","fp":"700604b522ca","stateId":193,"easy":"إذا ابتدعت ← فشر الأمور محدثاتها وكل بدعة ضلالة","cause":"وَشَرُّ الأُمُورِ مُحْدَثَاتُهَا","result":"وَكُلُّ بدْعَةٍ ضَلَالَةٌ","explicit":true,"ref":"فتاوى النووي 47","srcLabel":"النسائي","text":["حديثُ: النَّهيِ عنْ مُحْدَثاتِ الأُمورِ، وأنَّ كُلَّ بِدعةٍ ضَلالةٌ [يعني حديث: كانَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ إذَا خَطَبَ احْمَرَّتْ عَيْنَاهُ، وَعَلَا صَوْتُهُ، وَاشْتَدَّ غَضَبُهُ، حتَّى كَأنَّهُ مُنْذِرُ جَيْشٍ يقولُ: صَبَّحَكُمْ وَمَسَّاكُمْ، ويقولُ: بُعِثْتُ أَنَا وَالسَّاعَةُ كَهَاتَيْنِ، وَيَقْرُنُ بيْنَ إصْبَعَيْهِ: السَّبَّابَةِ وَالْوُسْطَى، ويقولُ: أَمَّا بَعْدُ؛ فإنَّ خَيْرَ الحَديثِ كِتَابُ اللهِ، وَخَيْرُ الهُدَى هُدَى مُحَمَّدٍ، ",["وَشَرُّ الأُمُورِ مُحْدَثَاتُهَا",1],"، ",["وَكُلُّ بدْعَةٍ ضَلَالَةٌ",2],"، ثُمَّ يقولُ: أَنَا أَوْلَى بكُلِّ مُؤْمِنٍ مِن نَفْسِهِ؛ مَن تَرَكَ مَالًا فَلأَهْلِهِ، وَمَن تَرَكَ دَيْنًا أَوْ ضَيَاعًا ، فَإِلَيَّ وَعَلَيَّ. [وفي رواية]: كَانَتْ خُطْبَةُ النَّبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ يَومَ الجُمُعَةِ يَحْمَدُ اللَّهَ، وَيُثْنِي عليه، ثُمَّ يقولُ علَى إثْرِ ذلكَ، وَقَدْ عَلَا صَوْتُهُ، ثُمَّ سَاقَ الحَدِيثَ، بمِثْلِهِ.]"],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"ثابت صحيح","takhrij":"أخرجه النسائي (1578)، وابن خزيمة (1785)، وابو نعيم الأصبهاني في ((المستخرج)) (1953) جميعهم بلفظه تاما.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"uH5EXzV5","merged":2,"otherRefs":["الفتح الرباني 11/5718 (حسن)"]},{"id":"س-07445","fp":"3bbc131e365f","stateId":193,"easy":"إذا قست الأمور برأيك في الدين ← فهي أعظم فتنة","cause":"قومٍ يَقيسونَ الأمورَ برَأْيِهم","result":"أعظَمُها فِرقةُ","explicit":true,"ref":"المستدرك على الصحيحين 8545","srcLabel":"الطبراني","text":["ستَفتَرِقُ أُمَّتي على بِضعٍ وسَبعينَ فِرقةً، ",["أعظَمُها فِرقةُ",2]," ",["قومٍ يَقيسونَ الأمورَ برَأْيِهم",1],"، فيُحرِّمون الحلالَ، ويُحلِّلون الحرامَ."],"grade":"صحيح","narrator":"عوف بن مالك","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الطبراني (18/ 50) (90)، والبزار (2755)، وابن بطة في ((الإبانة الكبرى)) (272) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"7xqRbIoQ","merged":2,"otherRefs":["أعلام الموقعين 1/221 (صحيح)"]},{"id":"س-03676","fp":"1ed0d4db6a6b","stateId":193,"easy":"إذا أحدثت بدعة ← يُرفع مثلها من السنة","cause":"ما أحدثَ قومٌ بدعةً","result":"إلَّا رُفعَ مثلُها منَ السُّنَّة","explicit":true,"ref":"معارج القبول 1233/3","srcLabel":"أحمد","text":["بعثَ إليَّ عبدُ الملِكِ بنُ مروانَ ، فقالَ : يا أبا أسماءَ ، إنَّا قد جَمعنا النَّاسَ على أمرينِ ، قالَ : وما هُما ؟ قالَ : تُرفعُ الأيدي على المَنابرِ يومَ الجمعةِ ، والقَصصُ بعدَ الصُّبحِ والعصرِ ، فقالَ : أما إنَّهما أمثلُ بِدعتِكُم عندي ، ولستُ مُجيبَكَ إلى شيءٍ منهُما قالَ : لأنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ : ",["ما أحدثَ قومٌ بدعةً",1]," ",["إلَّا رُفعَ مثلُها منَ السُّنَّة",2]," فتمسُّكٌ بسنَّةٍ خيرٌ من إحداثِ بدعةٍ"],"grade":"حسن","narrator":"غضيف بن الحارث","muhaddith":"إسناده جيد","takhrij":"أخرجه أحمد (17011)، وابن عساكر في ((تاريخ دمشق)) (48/82) باختلاف يسير، وابن بطة في ((الإبانة الكبرى)) (10) مختصراً.","bab":"اعتصام بالسنة › الأمر بالتمسك بها","dorar":"3q20lGG9","merged":2,"otherRefs":["فتح الباري لابن حجر 13/267 (حسن)"]},{"id":"س-07460","fp":"27f6604cd861","stateId":193,"easy":"إذا أحدثت في العبادة ما لم يُشرع ← تفتتح باب ضلالة (أثر ابن مسعود)","cause":"حصًى نعُدُّ به التكبيرَ والتهليلَ والتَّسبيحَ","result":"أو مُفتتِحو بابَ ضلالةٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"السلسلة الصحيحة 5/11","srcLabel":"الدارمي","text":["عن عمرو بنِ سلَمةَ الهمْدانيِّ قال كنا نجلسُ على بابِ عبدِ اللهِ بنِ مسعودٍ قَبل صلاةِ الغداةِ فإذا خرج مَشينا معه إلى المسجدِ فجاءنا أبو موسى الأشعريُّ فقال أخَرَجَ إليكم أبو عبد الرحمنِ بعدُ قلنا لا فجلس معنا حتى خرج فلما خرج قُمْنا إليه جميعًا فقال له أبو موسى يا أبا عبد الرَّحمنِ إني رأيتُ في المسجدِ آنفًا أمرًا أنكرتُه ولم أرَ والحمدُ للهِ إلا خيرًا قال فما هو فقال إن عشتَ فستراه قال رأيتُ في المسجدِ قومًا حِلَقًا جلوسًا ينتظرون الصلاةَ في كلِّ حلْقةٍ رجلٌ وفي أيديهم حصًى فيقول كَبِّرُوا مئةً فيُكبِّرونَ مئةً فيقول هلِّلُوا مئةً فيُهلِّلون مئةً ويقول سبِّحوا مئةً فيُسبِّحون مئةً قال فماذا قلتَ لهم قال ما قلتُ لهم شيئًا انتظارَ رأيِك قال أفلا أمرتَهم أن يعُدُّوا سيئاتِهم وضمنتَ لهم أن لا يضيعَ من حسناتهم شيءٌ ثم مضى ومضَينا معه حتى أتى حلقةً من تلك الحلقِ فوقف عليهم فقال ما هذا الذي أراكم تصنعون قالوا يا أبا عبدَ الرَّحمنِ ",["حصًى نعُدُّ به التكبيرَ والتهليلَ والتَّسبيحَ",1]," قال فعُدُّوا سيئاتِكم فأنا ضامنٌ أن لا يضيعَ من حسناتكم شيءٌ ويحكم يا أمَّةَ محمدٍ ما أسرعَ هلَكَتِكم هؤلاءِ صحابةُ نبيِّكم صلَّى اللهُ عليهِ وسلَّمَ مُتوافرون وهذه ثيابُه لم تَبلَ وآنيتُه لم تُكسَرْ والذي نفسي بيده إنكم لعلى مِلَّةٍ هي أهدى من ملةِ محمدٍ ",["أو مُفتتِحو بابَ ضلالةٍ",2]," قالوا والله يا أبا عبدَ الرَّحمنِ ما أردْنا إلا الخيرَ قال وكم من مُريدٍ للخيرِ لن يُصيبَه إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ حدَّثنا أنَّ قومًا يقرؤون القرآنَ لا يجاوزُ تراقيهم يمرُقونَ من الإسلامِ كما يمرُقُ السَّهمُ منَ الرَّميّةِ وأيمُ اللهِ ما أدري لعلَّ أكثرَهم منكم ثم تولى عنهم فقال عمرو بنُ سلَمةَ فرأينا عامَّةَ أولئك الحِلَقِ يُطاعِنونا يومَ النَّهروانِ مع الخوارجِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (210)، وبحشل في ((تاريخ واسط)) (198) واللفظ لهما.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8xhqC9ly"},{"id":"س-07773","fp":"edf30a9a45df","stateId":194,"easy":"إذا جادلت في المتشابه ← فأنت ممن عناهم الله بالزيغ","cause":"الذين يُجادِلونَ فيه","result":"فهم الذين عَنى اللهُ","explicit":true,"star":true,"otherNeedIds":[33],"ref":"تخريج المسند لشعيب 24210","srcLabel":"متفق عليه","text":["قَرَأَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم:  {هُوَ الَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ مِنْهُ آيَاتٌ مُحْكَمَاتٌ هُنَّ أُمُّ الْكِتَابِ وَأُخَرُ مُتَشَابِهَاتٌ فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغَاءَ الْفِتْنَةِ وَابْتِغَاءَ تَأْوِيلِهِ وَمَا يَعْلَمُ تَأْوِيلَهُ إِلَّا اللَّهُ وَالرَّاسِخُونَ فِي الْعِلْمِ يَقُولُونَ آمَنَّا بِهِ كُلٌّ مِنْ عِنْدِ رَبِّنَا وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ} [آل عمران: 7]،  فإذا رَأيتُم ",["الذين يُجادِلونَ فيه",1],"، ",["فهم الذين عَنى اللهُ",2]," عزَّ وجلَّ؛ فاحْذَروهم."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه البخاري (4547)، ومسلم (2665) باختلاف يسير","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"h5wCwuJu","merged":3,"otherRefs":["تخريج صحيح ابن حبان 76 (صحيح)","تخريج صحيح ابن حبان 73 (صحيح)"]},{"id":"س-07660","fp":"1e3acdf2158b","stateId":194,"easy":"إذا تكلمت في القدر (خوضاً) ← فهو من صنيع شرار الأمة","cause":"آخرُ الكلامِ في القَدَرِ","result":"لشرارِ هذه الأُمَّةِ","explicit":true,"star":true,"similar":["س-07666"],"ref":"المستدرك على الصحيحين 3811","srcLabel":"البخاري","text":["عنِ الزُّهْريِّ، أنَّه تلا قولَ اللهِ تَعالَى: {إِنَّ الْمُجْرِمِينَ فِي ضَلَالٍ وَسُعُرٍ} [القمر: 47] الآيةَ، إلى: {بِقَدَرٍ} [القمر: 49] فقالَ: حدَّثَنا سعيدُ بنُ المُسيَّبِ عنْ أبي هُريرةَ رَضيَ اللهُ عنه أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["آخرُ الكلامِ في القَدَرِ",1]," ",["لشرارِ هذه الأُمَّةِ",2],"»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه البيهقي في ((القضاء والقدر))(449) واللفظ له، والبزار (10079) بنحوه، والطبراني في ((المعجم الأوسط)) (5909) باختلاف يسير زيادة في آخره","bab":"قدر › التكذيب بالقدر","dorar":"VAXztfw1","merged":2,"otherRefs":["تخريج كتاب السنة 350 (حسن)"]},{"id":"س-05804","fp":"b17eebf929dd","stateId":194,"easy":"إذا حدّثت الناس بما لا يعرفون ← تجعلهم يكذّبون الله ورسوله","cause":"حَدِّثوا النَّاسَ بما يعرِفونَ","result":"أَتُريدونَ أَن يُكذَّبَ اللَّهُ ورَسولُهُ","explicit":true,"star":true,"ref":"الجامع الصغير 3677","srcLabel":"البخاري","text":[["حَدِّثوا النَّاسَ بما يعرِفونَ",1]," ",["أَتُريدونَ أَن يُكذَّبَ اللَّهُ ورَسولُهُ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (127)، واللفظ له، عدا \"أتريدون\" فقال: \"أتحبون\"","bab":"رقائق وزهد › الوصايا النافعة","dorar":"PM4wwZGE"},{"id":"س-07666","fp":"bfc951af84cd","stateId":194,"easy":"إذا خضت في القدر ← فأولئك شرار الأمة","cause":"قد تُكُلِّمَ في القَدَرِ","result":"أُولَئِكَ شِرارُ هذه الأُمَّةِ، لا تَعودوا مَرْضاهم، ولا تُصَلُّوا على مَوْتاهم","explicit":true,"repOf":"س-07660","ref":"الأحاديث المختارة 11 / 253","text":["«أتَيْتُ ابنَ عبَّاسٍ وهو يَنزِعُ في زَمْزَمَ، وقدِ ابْتَلَّتْ أسافِلُ ثِيابِه، فقُلْتُ له: ",["قد تُكُلِّمَ في القَدَرِ",1],"، قالَ: قد فَعَلوها؟ ما نَزَلَتْ هذه الآيةُ إلَّا فيهم: {ذُوقُوا مَسَّ سَقَرَ * إِنَّا كُلَّ شَيْءٍ خَلَقْنَاهُ بِقَدَرٍ}، ",["أُولَئِكَ شِرارُ هذه الأُمَّةِ، لا تَعودوا مَرْضاهم، ولا تُصَلُّوا على مَوْتاهم",2],"، إن أَرَيْتَني أحَدًا مِنهم لأَفْقَأْتُ عَيْنَيه بأُصْبُعيَّ هاتَينِ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"له شاهد في صحيح مسلم، من حديث مُحمَّد بن عباد بن جعفر، عن أبي هرير","bab":"قدر › التكذيب بالقدر","dorar":"NjDBTxqb"},{"id":"ق-0801","fp":"afcbb39fd6dc","stateId":194,"easy":"الجدال في الله بغير علم واتباع الشيطان وتولّيه ← يضلّه ويهديه إلى عذاب السعير","cause":"الجدال في الله بغير علم واتباع الشيطان وتولّيه","result":"يضلّه ويهديه إلى عذاب السعير","explicit":true,"otherNeedIds":[69],"ref":"سورة الحج: 3–4","srcLabel":"القرآن الكريم","quran":{"s":22,"from":3,"to":4,"text":"وَمِنَ النَّاسِ مَنْ يُجَادِلُ فِي اللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّبِعُ كُلَّ شَيْطَانٍ مَرِيدٍ (3) كُتِبَ عَلَيْهِ أَنَّهُ مَنْ تَوَلَّاهُ فَأَنَّهُ يُضِلُّهُ وَيَهْدِيهِ إِلَى عَذَابِ السَّعِيرِ (4)","hl":[[0,195,1]]}},{"id":"س-05867","fp":"9065ac141cf5","stateId":194,"easy":"إذا حدّثت قوماً بما لا تبلغه عقولهم ← يكون فتنة لبعضهم","cause":"بمحَدِّثٍ قَومًا حديثًا لا تبلُغُه عُقولُهم","result":"إلَّا كان لبَعضِهم فِتنةً","explicit":true,"ref":"عمدة القاري 2/308","srcLabel":"عمدة القاري","text":["قال ابنُ مسعودٍ: ما أنت ",["بمحَدِّثٍ قَومًا حديثًا لا تبلُغُه عُقولُهم",1]," ",["إلَّا كان لبَعضِهم فِتنةً",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"H2VNrtGZ"},{"id":"س-07343","fp":"040273c75bbe","stateId":194,"easy":"إذا أُوتي القوم الجدل ← ضلوا بعد هدى","cause":"ما ضَلَّ قَوْمٌ بَعْدَ هُدًى كانوا عليه","result":"إلَّا أُتوا الجَدَلَ، ثُمَّ تَلا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذه الآيةَ","explicit":true,"ref":"الأحكام الوسطى 1/ 108","srcLabel":"الترمذي","text":[["ما ضَلَّ قَوْمٌ بَعْدَ هُدًى كانوا عليه",1]," ",["إلَّا أُتوا الجَدَلَ\"، ثُمَّ تَلا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ هذه الآيةَ: ",2],"{مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلًا بَلْ هُمْ قَوْمٌ خَصِمُونَ}."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (3253)، وابن ماجه (48)، وأحمد (22164)، والحاكم (3674) واللفظ لهم.","bab":"فتن › كراهية الاختلاف","dorar":"oim0FKlR"},{"id":"س-07658","fp":"410638d74521","stateId":194,"easy":"إذا كنت قدرياً أو مرجئاً ← فهم مجوس هذه الأمة","cause":"القدريةُ والمُرْجِئَةُ","result":"مجوسُ هذِهِ الأمَّةِ","explicit":true,"ref":"مجمع الزوائد 7/208","srcLabel":"الطبراني","text":[["القدريةُ والمُرْجِئَةُ",1]," ",["مجوسُ هذِهِ الأمَّةِ",2]," فإنَّ مَرِضُوا فَلَا تَعُودُوهم وإنْ ماتُوا فلا تَشْهَدُوهُمْ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح غير هارون بن موسى الفروي وهو ثقة","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4205)","bab":"قدر › التكذيب بالقدر","dorar":"76ieW94l"},{"id":"س-07783","fp":"b5146ba43478","stateId":194,"easy":"إذا آمنت بالمحكم وخضت في المتشابه ← تهلك عنده","cause":"يؤمِنونَ بِمُحكَمِهِ","result":"ويَهلَكونَ عِندَ مُتشابِهِهِ","explicit":true,"ref":"فتح الباري لابن حجر 12/313","srcLabel":"فتح الباري لابن حجر","text":["عنِ ابنِ عبَّاسٍ وذُكِرَ عندَهُ الخوارِجُ وما يَلقَوْنَ عندَ قِرَاءَةِ القُرآنِ فقال ",["يؤمِنونَ بِمُحكَمِهِ",1]," ",["ويَهلَكونَ عِندَ مُتشابِهِهِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"قرآن › النهي عن اتباع متشابه القرآن والاختلاف فيه","dorar":"euMSKfJb"},{"id":"س-03155","fp":"1671b7484b9e","stateId":194,"easy":"إذا تماديت في سؤال «من خلق الله؟» ← تضل","cause":"يَسألونَ يقولونَ ما كَذا ما كَذا حتَّى يقولَ اللهُ خالقُ النَّاسَ فمَن خلقَ اللهَ","result":"فعندَ ذلك يَضلِّونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج كتاب السنة 647","srcLabel":"متفق عليه","text":["لا يزالُ النَّاسُ ",["يَسألونَ يقولونَ ما كَذا ما كَذا حتَّى يقولَ اللهُ خالقُ النَّاسَ فمَن خلقَ اللهَ",1]," ",["فعندَ ذلك يَضلِّونَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (647) واللفظ له، والبخاري (7296)، ومسلم (136) دون قوله: فعند ذلك يضلون.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"pZofoRyu"},{"id":"س-07417","fp":"217701233d54","stateId":195,"easy":"إذا اتخذ الناس رؤساء جهالاً فأفتوا بغير علم ← يضلون ويُضلون","cause":"فيتَّخذَ النَّاسُ رؤساءَ جُهَّالًا ، فيُستَفتوا ، فيُفتُوا بغيرِ علمٍ","result":"فيَضلُّوا ، ويُضلُّوا","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 11/121","srcLabel":"متفق عليه","text":["إنَّ اللَّهَ لا ينزِعُ العِلمَ منَ النَّاسِ بعدَ أن يُعْطيَهم إيَّاهُ ، ولَكِن يذهبُ بالعُلَماءِ ، كلَّما ذَهَبَ عالمٌ ذَهَبَ بما معَهُ منَ العِلمِ ، حتَّى يَبقى من لا يعلمُ ، ",["فيتَّخذَ النَّاسُ رؤساءَ جُهَّالًا ، فيُستَفتوا ، فيُفتُوا بغيرِ علمٍ",1]," ",["فيَضلُّوا ، ويُضلُّوا",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (100)، ومسلم (2673)، والترمذي (2652) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"7xwgUbMU","merged":2,"otherRefs":["تخريج مشكل الآثار 315 (حسن)"]},{"id":"س-01555","fp":"691ae1c40075","stateId":195,"easy":"إذا أفتيت بغير علم ← تضل وتُضل","cause":"فيُفتونَ بغيرِ علمٍ","result":"فيَضلُّونَ ويُضلُّونَ","explicit":true,"ref":"جامع بيان العلم 2/988","srcLabel":"جامع بيان العلم","text":["يذهبُ العلماءُ ثمَّ يتخذُ الناسُ رءوسًا جُهَّالًا ، يُسألونَ ",["فيُفتونَ بغيرِ علمٍ",1]," ، ",["فيَضلُّونَ ويُضلُّونَ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"ue9c39re"},{"id":"س-02778","fp":"28754d82fc37","stateId":195,"easy":"إذا زلّ العالم وجادل المنافق بالقرآن وضلّ الأئمة ← يُهدم الإسلام","cause":"زَلَّةُ عالمٍ وجدالُ منافقٍ بالقرآنِ وأئمةٌ مضِلُّون","result":"يهدِم الإسلامُ","explicit":true,"ref":"بيان تلبيس الجهمية 4/191","srcLabel":"الفريابي","text":["قال عمرُ بنُ الخطابِ ",["يهدِم الإسلامُ",2]," ",["زَلَّةُ عالمٍ وجدالُ منافقٍ بالقرآنِ وأئمةٌ مضِلُّون",1]],"grade":"صحيح","narrator":"زياد بن حدير الأسدي","muhaddith":"محفوظ","takhrij":"أخرجه الفريابي في ((صفة النفاق)) (30) واللفظ له، والدارمي (220)، وأبو نعيم في ((حلية الأولياء)) (4/ 196) بنحوه.","bab":"إيمان › النفاق","dorar":"flqWcbKI"},{"id":"س-04800","fp":"4e9b5a7ba057","stateId":195,"easy":"إذا تكلمت في الدين بلا علم بالناسخ والمنسوخ ← هلكت وأهلكت","cause":"أتعرفُ النَّاسخَ مِنَ المنسوخِ ؟ قال : لا","result":"هلكْتَ وأهلكْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"العلم لأبي خيثمة 130","srcLabel":"البيهقي","text":["أنَّ عليًّا عليهِ السلامُ مرَّ بقاصٍّ ، فقال : ",["أتعرفُ النَّاسخَ مِنَ المنسوخِ ؟ قال : لا",1]," ، قال : ",["هلكْتَ وأهلكْتَ",2]," ."],"grade":"صحيح","narrator":"عبدالله بن حبيب أبو عبدالرحمن السلمي","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو عبيد في ((الناسخ والمنسوخ)) (1)، والبيهقي في ((المدخل)) (184)، وأبو نعيم في ((تاريخ أصبهان)) (1/ 121) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hVqzI45L","merged":2,"otherRefs":["الآداب الشرعية 2/86 (صحيح)"]},{"id":"ق-0248","fp":"112892b143c5","stateId":196,"easy":"مشاقّة الرسول واتباع غير سبيل المؤمنين ← يولّيه الله ما تولى ويصليه جهنم","cause":"مشاقّة الرسول واتباع غير سبيل المؤمنين","result":"يولّيه الله ما تولى ويصليه جهنم","explicit":true,"otherNeedIds":[69],"ref":"سورة النساء: 115","srcLabel":"القرآن الكريم","quran":{"s":4,"from":115,"to":115,"text":"وَمَنْ يُشَاقِقِ الرَّسُولَ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُ الْهُدَى وَيَتَّبِعْ غَيْرَ سَبِيلِ الْمُؤْمِنِينَ نُوَلِّهِ مَا تَوَلَّى وَنُصْلِهِ جَهَنَّمَ وَسَاءَتْ مَصِيرًا (115)","hl":[[0,172,1]]}},{"id":"ق-0368","fp":"4a40879d7da7","stateId":196,"easy":"طاعة أكثر من في الأرض ← الضلال عن سبيل الله","cause":"طاعة أكثر من في الأرض","result":"الضلال عن سبيل الله","explicit":true,"ref":"سورة الأنعام: 116","srcLabel":"القرآن الكريم","quran":{"s":6,"from":116,"to":116,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ (116)","hl":[[0,73,1]]}},{"id":"ق-0535","fp":"4073d993ebc0","stateId":196,"easy":"مخالفة ما بيّن الله بعد الهدى ← الإضلال بعد البيان","cause":"مخالفة ما بيّن الله بعد الهدى","result":"الإضلال بعد البيان","explicit":true,"ref":"سورة التوبة: 115","srcLabel":"القرآن الكريم","quran":{"s":9,"from":115,"to":115,"text":"وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّى يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ (115)","hl":[[0,98,1]]}},{"id":"ق-0994","fp":"301b8537bb92","stateId":196,"easy":"معصية الله ورسوله ← ضلال مبين","cause":"معصية الله ورسوله","result":"ضلال مبين","explicit":true,"ref":"سورة الأحزاب: 36","srcLabel":"القرآن الكريم","quran":{"s":33,"from":36,"to":36,"text":"وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ إِذَا قَضَى اللَّهُ وَرَسُولُهُ أَمْرًا أَنْ يَكُونَ لَهُمُ الْخِيَرَةُ مِنْ أَمْرِهِمْ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَقَدْ ضَلَّ ضَلَالًا مُبِينًا (36)","hl":[[128,192,1]]}},{"id":"ق-1328","fp":"487d5d528660","stateId":196,"easy":"الزيغ عن الحق مع العلم ← إزاغة الله القلوب","cause":"الزيغ عن الحق مع العلم","result":"إزاغة الله القلوب","explicit":true,"ref":"سورة الصف: 5","srcLabel":"القرآن الكريم","quran":{"s":61,"from":5,"to":5,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ يَا قَوْمِ لِمَ تُؤْذُونَنِي وَقَدْ تَعْلَمُونَ أَنِّي رَسُولُ اللَّهِ إِلَيْكُمْ فَلَمَّا زَاغُوا أَزَاغَ اللَّهُ قُلُوبَهُمْ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (5)","hl":[[113,203,1]]}},{"id":"س-06998","fp":"0af1b573c07b","stateId":196,"easy":"إذا أنكرت ما ثبت من السنة لأنه ليس في القرآن ← تهلك (أثر عمر)","cause":"أن يقولَ قائلٌ: لا نجدُ حدَّينِ في كِتابِ اللَّهِ","result":"إيَّاكم أن تَهْلِكوا عَن آيةِ الرَّجمِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فوائد الحنائي الحنائيات 2/1292","srcLabel":"مالك","text":["عن يحيى بنِ سَعيدٍ، أنَّهُ سمعَ سعيدَ بنَ المسيِّبِ، يقولُ: لمَّا صدرَ عمرُ بنُ الخطَّابِ من منًى أَناخَ بالأبطحِ، ثمَّ كوَّمَ كومةً مِن بطحاءِ ثمَّ طرحَ عليها رداءَهُ، ثمَّ استلقى ومدَّ يديهِ إلى السَّماءِ، فقالَ: اللَّهمَّ كبُرَتْ سنِّي، وضعُفَتْ قوَّتي، وانتشَرَت رعيَّتي، فاقبِضني إليكَ غيرَ مُضيِّعٍ ولا مُفرِّطٍ، ثمَّ قدمَ المدينةَ في عقِب ذي الحجَّةِ فخطبَ النَّاسَ، فقالَ: أيُّها النَّاسُ قد سُنَّت لَكُمُ السُّننُ وفُرِضَت لَكُمُ الفرائضُ، وتُرِكْتُمْ على الواضحةِ، إلَّا أن تَضلُّوا بالنَّاسِ يمينًا وشِمالا، وصفَّق إحدَى يديهِ على الأُخرى ثم قالَ: ",["إيَّاكم أن تَهْلِكوا عَن آيةِ الرَّجمِ",2]," ",["أن يقولَ قائلٌ: لا نجدُ حدَّينِ في كِتابِ اللَّهِ",1],"، فقد رَجمَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ورَجَمنا، بعدَهُ فوالَّذي نفسي بيدِهِ لولا أن يقولَ النَّاسُ زادَ ابنُ الخطَّابِ في كتابِ اللَّهِ، لَكَتبتُها: بيَدي الشَّيخُ والشَّيخةُ فارجُموهما البتَّةَ وإنَّا قَد قرأناها قالَ مالِكٌ: قالَ يحيى بنُ سعيدٍ، قالَ: سعيدُ فما انسَلخَ ذو الحجَّةِ حتَّى قُتِلَ عمرُ رضيَ اللَّهُ عنهُ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"حسن صحيح وقد أدرك سعيد بن المسيب عمر بن الخطاب فسماعه من عمر لهذه الخطبة صحيح، والحديث صحيح","takhrij":"أخرجه مالك (2/824)، والحاكم (4513)، وأبو نعيم في ((حلية الأولياء)) (1/54) باختلاف يسير","bab":"علم › الحث على الأخذ بالسنة","dorar":"PN1y35B9","merged":2,"otherRefs":["تخريج مشكل الآثار 2059 (صحيح)"]},{"id":"س-05981","fp":"27fda7040234","stateId":196,"easy":"إذا فارقت الجماعة ← فهي الضلالة","cause":"والفرقةَ","result":"فإنها هي الضلالةُ","explicit":true,"otherNeedIds":[44],"ref":"مجمع الزوائد 5/221","srcLabel":"الطبراني","text":["لقيت أبا مسعودٍ حينَ قُتِل علِيٌّ فتبعته فقلت له أنشدُك اللهَ ما سمعت من النبيِّ صلَّى اللهُ عليه وسلَّم في الفتنِ فقال إنا لا نكتمُ شيئًا عليك بتقوَى اللهِ والجماعةِ وإياكَ ",["والفرقةَ",1]," ",["فإنها هي الضلالةُ",2]," وإن اللهَ لم يكنْ ليجمَعَ أمةِ محمدٍ صلَّى اللهُ عليه وسلَّم على ضلالةٍ"],"grade":"حسن","narrator":"يسير بن عمرو","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (17/ 239) (665) واللفظ له، وابن منده في ((معرفة الصحابة)) (ص260)، وابن أبي شيبة (38770) كلاهما بمعناه.","bab":"رقائق وزهد › تقوى الله","dorar":"WFjtyrKI"},{"id":"س-07716","fp":"c2158cfe0d49","stateId":196,"easy":"إذا زغت عن الحق ← يزيغ الله قلبك","cause":"وهؤلاءِ زاغوا","result":"فأزاغَ اللَّهُ قُلوبَهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"شرح البخاري لابن الملقن 22/587","srcLabel":"الحاكم","text":["لما خرَجتِ الحروريَّةُ قلتُ لأبي سَعدٍ هؤلاءِ الَّذينَ أنزل اللَّهُ فيهم {الَّذِينَ ضَلَّ سَعْيُهُمْ فِي الْحَيَاةِ الدُّنْيَا} قال أولئكَ أهلُ الصَّوامِعِ ",["وهؤلاءِ زاغوا",1]," ",["فأزاغَ اللَّهُ قُلوبَهم",2]],"grade":"صحيح","narrator":"مصعب بن سعد","muhaddith":"على شرطهما","takhrij":"أخرجه الطبري في ((تفسيره)) (18/ 126)، وابن أبي شيبة (37925)، والحاكم (3400) واللفظ لهم باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"f4vVOkHf"},{"id":"س-00563","fp":"f1a8f047937b","stateId":196,"easy":"إذا لم تقبل هدى الله ← فقلبك كالقيعان لا تمسك ماءً ولا تنبت كلأ","cause":"مَنْ لم يَرْفَعْ بذلك رأسًا ولم يَقبلْ هُدى اللهِ الذي أُرْسِلْتُ به","result":"إنما هي قِيعانٌ لا يُنْبِتُ ولا يُمْسِكُ ولا يُنْبِتُ كَلَأً","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"similar":["س-03194"],"ref":"تخريج كتاب السنة 903","srcLabel":"متفق عليه","text":["إنَّ مَثَلَ ما بعثني اللهُ به مِنَ الهُدَى والعِلمِ مَثَلُ غَيْثٍ أصاب الأرضَ وكانت منه أجادِبُ أمسكَتِ الماءَ ، فنفع اللهُ به الناسَ فشرِبوا منها وزرعوا وسَقَوْا وأصاب طائفةً منهم أخرى ",["إنما هي قِيعانٌ لا يُنْبِتُ ولا يُمْسِكُ ولا يُنْبِتُ كَلَأً",2]," فذلك مَثَلُ مَنْ تَفَقَّهَ فى دينِ اللهِ ونفعه اللهُ بما بعثني اللهُ به ونَفَع به فَعَلِم وعَلَّمَ ، ومَثَلُ ",["مَنْ لم يَرْفَعْ بذلك رأسًا ولم يَقبلْ هُدى اللهِ الذي أُرْسِلْتُ به",1]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (79)، ومسلم (2282)، وأحمد (19573)، وابن حبان (3822) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"RNpo4ySJ"},{"id":"س-03194","fp":"66a4145b4597","stateId":196,"easy":"إذا لم ترفع بالهدى رأساً ← فقلبك كالقيعان","cause":"مَن لَم يَرفَعْ بذلك رَأسًا، ولَم يَقبَلْ هُدى اللهِ الذي أُرسِلتُ به","result":"إنَّما هي قيعانٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00563","ref":"صحيح مسلم 2282","text":["إنَّ مَثَلَ ما بَعَثَنيَ اللهُ به عزَّ وجلَّ مِنَ الهُدى والعِلمِ كمَثَلِ غَيثٍ أصابَ أرضًا، فكانَت مِنها طائِفةٌ طَيِّبةٌ، قَبِلَتِ الماءَ فأنبَتَتِ الكَلأَ والعُشبَ الكَثيرَ، وكانَ مِنها أجادِبُ أمسَكَتِ الماءَ، فنَفَعَ اللهُ بها النَّاسَ، فشَرِبوا مِنها وسَقَوا ورَعَوا، وأصابَ طائِفةً مِنها أُخرى، ",["إنَّما هي قيعانٌ",2]," لا تُمسِكُ ماءً، ولا تُنبِتُ كَلَأً، فذلك مَثَلُ مَن فقُهَ في دينِ اللهِ، ونَفَعَه بما بَعَثَنيَ اللهُ به، فعَلِمَ وعَلَّمَ، ومَثَلُ ",["مَن لَم يَرفَعْ بذلك رَأسًا، ولَم يَقبَلْ هُدى اللهِ الذي أُرسِلتُ به",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (79) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"g3qamVi0"},{"id":"س-01720","fp":"73712686b57f","stateId":196,"easy":"إذا تركت سنة النبي ﷺ واتبعت غيره ← تضل","cause":"فاتبعتُموهُ وتركتُموني","result":"لضلَلْتُمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح الجامع 5308","srcLabel":"أحمد","text":["لو نزل موسى ",["فاتبعتُموهُ وتركتُموني",1]," ",["لضلَلْتُمْ",2]," ، أنا حظُّكم منَ النبيينَ . و أنتم حظي منَ الأمَمِ"],"grade":"حسن","narrator":"[عبد الله بن ثابت]","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4836) بلفظه وفي أوله قصة، وأحمد (15864)، وعبد الرزاق (313) بنحوه وفي أوله قصة.","bab":"أنبياء › عام","dorar":"Viieg3R9"},{"id":"ق-0095","fp":"f163d50edded","stateId":197,"easy":"الظلم ← الحرمان من الهداية","cause":"الظلم","result":"الحرمان من الهداية","explicit":true,"star":true,"ref":"سورة البقرة: 258","srcLabel":"القرآن الكريم","quran":{"s":2,"from":258,"to":258,"text":"أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ إِذْ قَالَ إِبْرَاهِيمُ رَبِّيَ الَّذِي يُحْيِي وَيُمِيتُ قَالَ أَنَا أُحْيِي وَأُمِيتُ قَالَ إِبْرَاهِيمُ فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ فَبُهِتَ الَّذِي كَفَرَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (258)","hl":[[302,347,1]]}},{"id":"ق-0563","fp":"04b2a424d662","stateId":197,"easy":"الاعتداء والتكذيب السابق ← الطبع على القلوب","cause":"الاعتداء والتكذيب السابق","result":"الطبع على القلوب","explicit":true,"ref":"سورة يونس: 74","srcLabel":"القرآن الكريم","quran":{"s":10,"from":74,"to":74,"text":"ثُمَّ بَعَثْنَا مِنْ بَعْدِهِ رُسُلًا إِلَى قَوْمِهِمْ فَجَاءُوهُمْ بِالْبَيِّنَاتِ فَمَا كَانُوا لِيُؤْمِنُوا بِمَا كَذَّبُوا بِهِ مِنْ قَبْلُ كَذَلِكَ نَطْبَعُ عَلَى قُلُوبِ الْمُعْتَدِينَ (74)","hl":[[84,190,1]]}},{"id":"ق-0649","fp":"76ebb2d10e3f","stateId":197,"easy":"الظلم ← إضلال الله","cause":"الظلم","result":"إضلال الله","explicit":true,"ref":"سورة إبراهيم: 27","srcLabel":"القرآن الكريم","quran":{"s":14,"from":27,"to":27,"text":"يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ وَيُضِلُّ اللَّهُ الظَّالِمِينَ وَيَفْعَلُ اللَّهُ مَا يَشَاءُ (27)","hl":[[102,133,1]]}},{"id":"س-06424","fp":"ccbbcc0945e0","stateId":197,"easy":"إذا لم تكن أميناً ← فلا إيمان لك","cause":"لمن لا أمانةَ لَهُ","result":"لا إيمانَ","explicit":true,"otherNeedIds":[22],"ref":"الترغيب والترهيب 1/261","srcLabel":"الطبراني","text":[["لا إيمانَ",2]," ",["لمن لا أمانةَ لَهُ",1]," ، ولا صَلاةَ لمن لا طُهورَ لَهُ ، ولا دينَ لمن لا صلاةَ لَهُ ، إنَّما موضِعُ الصَّلاةِ مِنَ الدِّينِ كموضعِ الرَّأسِ منَ الجسَدِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2292)، والمخلص في ((المخلصيات)) (2529)","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"hOTNaxzo","merged":2,"otherRefs":["صحيح ابن خزيمة 4/ 88 (صحيح)"]},{"id":"س-00407","fp":"a18a7d4eb2a3","stateId":198,"easy":"إذا اجتمع فيك البخل وسوء الخلق ← فليس هذا من صفات المؤمن","cause":"البُخلُ ، وسوءُ الخُلُقِ","result":"خَصلتانِ لا يجتمعانِ في مؤمنٍ","explicit":true,"star":true,"ref":"صحيح الترغيب 2608","srcLabel":"البخاري","text":[["خَصلتانِ لا يجتمعانِ في مؤمنٍ",2]," : ",["البُخلُ ، وسوءُ الخُلُقِ",1]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1962)، والبخاري في ((الأدب المفرد)) (282)، وعبدالله بن أحمد في ((زوائد الزهد)) (1380)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"08hDW8Hu"},{"id":"س-04433","fp":"e88470754f1b","stateId":198,"easy":"إذا كنت شحيحاً ← لا يجتمع الشح والإيمان في قلبك","cause":"والشُّحَّ","result":"ولا يجمعُ اللَّهُ في قلبِ امرئٍ مسلمٍ الإيمانَ باللَّهِ والشُّحَّ جميعًا","explicit":true,"star":true,"ref":"صحيح النسائي 3115","srcLabel":"النسائي","text":["لا يَجمعُ اللَّهُ عزَّ وجلَّ غبارًا في سبيلِ اللَّهِ ودخانَ جَهَنَّمَ في جوفِ امرئٍ مسلِمٍ ، ",["ولا يجمعُ اللَّهُ في قلبِ امرئٍ مسلمٍ الإيمانَ باللَّهِ والشُّحَّ جميعًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3110)، وأحمد (7480)، وابن حبان (3251) واللفظ لهم.","bab":"جهاد › فضل الجهاد","dorar":"uSeLVi9o","merged":2,"otherRefs":["صحيح الأدب المفرد 215 (صحيح)"]},{"id":"س-05556","fp":"bda54ebb1c3c","stateId":198,"easy":"إذا ابتُليت الأمة بالبخل وطول الأمل ← يهلك آخرها","cause":"بالبخلِ و الأملِ","result":"و يهلكُ آخرُها","explicit":true,"otherNeedIds":[17,61],"ref":"الجامع الصغير 5095","srcLabel":"أحمد","text":["صلاحُ أولَ هذه الأمةِ بالزهدِ و اليقينِ، ",["و يهلكُ آخرُها",2]," ",["بالبخلِ و الأملِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد في ((الزهد)) (52)، وابن بشران في ((الأمالي)) (534)، والبيهقي في ((شعب الإيمان)) (10351) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NNffQGWt","merged":2,"otherRefs":["صحيح الترغيب 3340 (حسن)"]},{"id":"س-08331","fp":"9053bc5d8fab","stateId":198,"easy":"إذا بخلت ← فلا داء أدوى من البخل","cause":"لَنَزُنَّهُ بالبخلِ","result":"وأيُّ داءٍ أدوى منَ البخلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"تغليق التعليق 3/347","srcLabel":"الطبراني","text":["أنَّ النبيَّ صلى اللهُ عليهِ وسلمَ قالَ : منْ سيدُكمْ يا بنِي سلمةَ ؟ قالوا : جدُّ بنُ قيسٍ, فقال : بمَ تُسَوِّدُونَه ؟ قالوا : إنه أكثرُنَا مالًا, وإنَّا على ذلكَ ",["لَنَزُنَّهُ بالبخلِ",1],", فقالَ : ",["وأيُّ داءٍ أدوى منَ البخلِ",2]," ؟ ليسَ ذا سيدَكُمْ قالوا : فمنْ سيدُنَا ؟ قال سيدُكمْ بِشْرُ بنُ البراءِ"],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (19/ 81) (163)، والطحاوي في ((مشكل الآثار)) (5538)، وأبو نعيم في ((معرفة الصحابة)) (1170) باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"KagBtrq5"},{"id":"س-05545","fp":"be62810c21bc","stateId":198,"easy":"إذا بخلت وطال أملك ← فهو أول فساد الأمة","cause":"البخلُ والأملُ","result":"وأولُ فسادِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"هداية الرواة 5210","srcLabel":"أحمد","text":["أولُ صلاحِ هذهِ الأمةِ : اليقينُ والزهدُ، ",["وأولُ فسادِها",2]," : ",["البخلُ والأملُ",1]," ."],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن","takhrij":"أخرجه أحمد في ((الزهد)) (52)، والطبراني في ((المعجم الأوسط)) (7650) والبيهقي في ((شعب الإيمان)) ((13/ 117)) بنحوه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"dIeqew3R"},{"id":"س-00450","fp":"0c7cc574eef4","stateId":199,"easy":"إذا أكثرت اللعن ← فلا ينبغي ذلك لمؤمن","cause":"لَعَّانًا","result":"لا يَنبَغي للمؤمنِ أنْ يكونَ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 146","srcLabel":"البخاري","text":["«",["لا يَنبَغي للمؤمنِ أنْ يكونَ",2]," ",["لَعَّانًا",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح الإسناد]","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (309) بلفظه، والترمذي (2019)، والروياني (1445) كلاهما باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"wQcVZNaM"},{"id":"ق-0676","fp":"de33bfc71667","stateId":199,"easy":"اتخاذ الأيمان خديعة ونقض العهود ← زلل القدم بعد ثبوتها وذوق السوء وعذاب عظيم","cause":"اتخاذ الأيمان خديعة ونقض العهود","result":"زلل القدم بعد ثبوتها وذوق السوء وعذاب عظيم","explicit":true,"star":true,"otherNeedIds":[56,70],"ref":"سورة النحل: 94","srcLabel":"القرآن الكريم","quran":{"s":16,"from":94,"to":94,"text":"وَلَا تَتَّخِذُوا أَيْمَانَكُمْ دَخَلًا بَيْنَكُمْ فَتَزِلَّ قَدَمٌ بَعْدَ ثُبُوتِهَا وَتَذُوقُوا السُّوءَ بِمَا صَدَدْتُمْ عَنْ سَبِيلِ اللَّهِ وَلَكُمْ عَذَابٌ عَظِيمٌ (94)","hl":[[0,169,1]]}},{"id":"ق-0845","fp":"b8b7d1fb454c","stateId":199,"easy":"السخرية بالمؤمنين ← نسيان ذكر الله","cause":"السخرية بالمؤمنين","result":"نسيان ذكر الله","explicit":true,"star":true,"ref":"سورة المؤمنون: 110","srcLabel":"القرآن الكريم","quran":{"s":23,"from":110,"to":110,"text":"فَاتَّخَذْتُمُوهُمْ سِخْرِيًّا حَتَّى أَنْسَوْكُمْ ذِكْرِي وَكُنْتُمْ مِنْهُمْ تَضْحَكُونَ (110)","hl":[[0,58,1]]}},{"id":"ق-1071","fp":"8ca31a923c29","stateId":199,"easy":"الكذب والكفر ← لا يهديه الله","cause":"الكذب والكفر","result":"لا يهديه الله","explicit":true,"star":true,"ref":"سورة الزمر: 3","srcLabel":"القرآن الكريم","quran":{"s":39,"from":3,"to":3,"text":"أَلَا لِلَّهِ الدِّينُ الْخَالِصُ وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ مَا نَعْبُدُهُمْ إِلَّا لِيُقَرِّبُونَا إِلَى اللَّهِ زُلْفَى إِنَّ اللَّهَ يَحْكُمُ بَيْنَهُمْ فِي مَا هُمْ فِيهِ يَخْتَلِفُونَ إِنَّ اللَّهَ لَا يَهْدِي مَنْ هُوَ كَاذِبٌ كَفَّارٌ (3)","hl":[[211,263,1]]}},{"id":"ق-1108","fp":"4e3f254e3142","stateId":199,"easy":"الإسراف والكذب ← لا يهديه الله","cause":"الإسراف والكذب","result":"لا يهديه الله","explicit":true,"ref":"سورة غافر: 28","srcLabel":"القرآن الكريم","quran":{"s":40,"from":28,"to":28,"text":"وَقَالَ رَجُلٌ مُؤْمِنٌ مِنْ آلِ فِرْعَوْنَ يَكْتُمُ إِيمَانَهُ أَتَقْتُلُونَ رَجُلًا أَنْ يَقُولَ رَبِّيَ اللَّهُ وَقَدْ جَاءَكُمْ بِالْبَيِّنَاتِ مِنْ رَبِّكُمْ وَإِنْ يَكُ كَاذِبًا فَعَلَيْهِ كَذِبُهُ وَإِنْ يَكُ صَادِقًا يُصِبْكُمْ بَعْضُ الَّذِي يَعِدُكُمْ إِنَّ اللَّهَ لَا يَهْدِي مَنْ هُوَ مُسْرِفٌ كَذَّابٌ (28)","hl":[[262,315,1]]}},{"id":"س-03214","fp":"58b0233fa699","stateId":199,"easy":"إذا اتصفت بالخيانة والكذب ← فليست من خلال المؤمن","cause":"الخيانةَ والكذبَ","result":"المؤمنُ يطبعُ على الخلالِ كلِّها إِلَّا","explicit":true,"ref":"الإيمان لابن أبي شيبة 81","srcLabel":"ابن أبي شيبة","text":["عن سعدٍ قال : ",["المؤمنُ يطبعُ على الخلالِ كلِّها إِلَّا",2]," ",["الخيانةَ والكذبَ",1]],"grade":"صحيح","narrator":"مصعب بن سعد","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (26117) واللفظ له، والخلال في ((السنة)) (1525)، وابن أبي الدنيا في ((الصمت)) (490) باختلاف يسير.","bab":"إيمان › فضل الإيمان","dorar":"VYwjlKnO","merged":4,"otherRefs":["المصابيح في الأحاديث المتواترة 630 (صحيح)","تنبيه الغافلين 231 (صحيح)","فتح الباري لابن حجر 10/524 (حسن)"]},{"id":"س-00427","fp":"7c3d5136a5e5","stateId":199,"easy":"إذا كنت لعّاناً طعّاناً فاحشاً بذيئاً ← فلست مؤمناً كامل الإيمان","cause":"باللَّعَّانِ، ولا الطَّعَّانِ، ولا الفاحِشِ، ولا البَذيءِ","result":"إنَّ المؤمنَ ليس","explicit":true,"similar":["س-00381"],"ref":"تخريج المسند لشعيب 3948","srcLabel":"الترمذي","text":[["إنَّ المؤمنَ ليس",2]," ",["باللَّعَّانِ، ولا الطَّعَّانِ، ولا الفاحِشِ، ولا البَذيءِ",1],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1977)، وأحمد (3948) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"DBMSnzxw","merged":3,"otherRefs":["تخريج رياض الصالحين 1734 (صحيح)","السلسلة الصحيحة 320 (صحيح)"]},{"id":"س-03619","fp":"5c790ad8641f","stateId":199,"easy":"إذا بالغت في المدح ← يستجرّك الشيطان","cause":"قولوا بقَولِكم","result":"ولا يَستَجِرَّكمُ الشَّيطانُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 13596","srcLabel":"مسلم","text":["أنَّ رجُلًا قال: يا محمَّدُ، يا خَيْرَنا وابنَ خَيرِنا، ويا سَيِّدَنا وابنَ سَيِّدِنا، فقال: ",["قولوا بقَولِكم",1]," ",["ولا يَستَجِرَّكمُ الشَّيطانُ",2]," -أو: الشَّياطينُ، إحدى الكَلِمتَينِ- أنا محمَّدٌ عبْدُ اللهِ ورسولُه، ما أُحِبُّ أنْ تَرفَعوني فَوقَ مَنزِلَتي التي أنزَلَني اللهُ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10077)، وأحمد (13596) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"0VCPl9HH","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6240 (صحيح)"]},{"id":"س-00381","fp":"8bd89b06512e","stateId":199,"easy":"إذا كنت طعّاناً لعّاناً فاحشاً بذيئاً ← فلست من المؤمنين الكاملين","cause":"بطَعَّانٍ، ولا بلَعَّانٍ، ولا الفاحشِ البَذيءِ","result":"ليس المؤمنُ","explicit":true,"repOf":"س-00427","ref":"تخريج المسند لشعيب 3839","text":["\"",["ليس المؤمنُ",2]," ",["بطَعَّانٍ، ولا بلَعَّانٍ، ولا الفاحشِ البَذيءِ",1],"\"، وقال ابنُ سابقٍ مرَّةً: بالطَّعَّانِ، ولا باللَّعَّانِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1977)، وأحمد (3839) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"QNXl59Tp"},{"id":"س-00443","fp":"2eec6880b2e8","stateId":199,"easy":"إذا كذبت ← فالكذب يجانب الإيمان","cause":"إيَّاكُم والكذِبَ","result":"فإنَّه مُجانِبٌ للإيمانِ","explicit":true,"similar":["س-02592"],"ref":"المقاصد الحسنة 372","srcLabel":"أحمد","text":[["إيَّاكُم والكذِبَ",1]," ،",["فإنَّه مُجانِبٌ للإيمانِ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"رفعه يحيى بن عبد الملك وجعفر الأحمر وعمرو بن ثابت عن إسماعيل ووقفه بعضهم وهو أصح","takhrij":"أخرجه ابن أبي شيبة (25602)، وابن أبي الدنيا في ((الصمت)) (475) كلاهما بلفظه، وأحمد (16) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"c98Mcj2p"},{"id":"س-00998","fp":"71c98fafa2cb","stateId":199,"easy":"إذا أكثرت الكلام بغير ذكر الله ← يقسو قلبك، وأبعد الناس من الله القلب القاسي","cause":"لا تُكْثِروا الكَلامَ بغَيْرِ ذِكْرِ اللهِ تَعالى","result":"فإنَّ الكَلامَ بغَيْرِ ذِكْرِ اللهِ قَسْوةٌ للقَلْبِ، وإنَّ أَبعَدَ النَّاسِ مِن اللهِ القَلْبُ القاسي","explicit":true,"ref":"الأحكام الوسطى 4/ 279","srcLabel":"الأحكام الوسطى","text":["\"",["لا تُكْثِروا الكَلامَ بغَيْرِ ذِكْرِ اللهِ تَعالى؛ ",1],["فإنَّ الكَلامَ بغَيْرِ ذِكْرِ اللهِ قَسْوةٌ للقَلْبِ، وإنَّ أَبعَدَ النَّاسِ مِن اللهِ القَلْبُ القاسي\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"أدعية وأذكار › فضل الذكر","dorar":"NhMBkCAo"},{"id":"س-02592","fp":"961ea7a003d6","stateId":199,"easy":"إذا كذبت ← فالكذب يجانب الإيمان","cause":"الْكذبُ","result":"يجانبُ الإيمانَ","explicit":true,"repOf":"س-00443","ref":"فتح الباري لابن حجر 10/524","text":["عن أبي بَكرٍ الصِّدِّيقِ قالَ: ",["الْكذبُ",1]," ",["يجانبُ الإيمانَ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال تنافي الإيمان","dorar":"gIC8hi3D"},{"id":"س-04910","fp":"25fe24dbe828","stateId":199,"easy":"إذا اقتطعت حق مسلم بالكذب ← تكون في قلبك نكتة سوداء من نفاق لا يغيرها شيء","cause":"أيُّما امرئٍ اقتَطَع حَقَّ امرئٍ مُسلِمٍ كاذِبًا","result":"كانت له نُكتةٌ سَوداءُ مِن نِفاقٍ في قَلْبِه، لا يُغَيِّرُها شَيءٌ إلى يومِ القيامةِ","explicit":true,"ref":"الجامع الصغير 2964","srcLabel":"الطبراني","text":[["أيُّما امرئٍ اقتَطَع حَقَّ امرئٍ مُسلِمٍ كاذِبًا، ",1],["كانت له نُكتةٌ سَوداءُ مِن نِفاقٍ في قَلْبِه، لا يُغَيِّرُها شَيءٌ إلى يومِ القيامةِ",2],"."],"grade":"صحيح","narrator":"ثعلبة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في (2/ 85) (1383)، والبغوي في ((معجم الصحابة)) (268)، وأبو نعيم في ((معرفة الصحابة)) (1387) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"tCOyA1Xk"},{"id":"س-08017","fp":"d571759569cf","stateId":199,"easy":"إذا اقتطعت مال مسلم بيمين كاذبة ← تكون نكتة سوداء في قلبك إلى يوم القيامة","cause":"مَنِ اقتَطَعَ مالَ امرِئٍ مُسلِم بيَمينٍ كاذِبةٍ","result":"كانتْ نُكتةً سَوداءَ في قَلبِه، لا يُغَيِّرُها شَيءٌ إلى يَومِ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 8010","srcLabel":"الحاكم","text":["عن عبدِ اللهِ بنِ ثَعْلبةَ: أنَّه أتى عَبدَ الرَّحمنِ بنَ كَعبِ بنِ مالِكٍ وهو في إزارٍ جَرَدٍ، وطافَ وحَلَقَ قدِ الْتَبَبْتُ به وهو أعمَى يُقادُ، قالَ: فسَلَّمتُ عليه، فقالَ: مَن هذا؟ قُلتُ: عَبدُ اللهِ بنُ ثَعلبةَ. قالَ: أخو بَني حارِثةَ؟ قُلتُ: نَعَم، قال: وخَتَنُ جُهَينةَ؟ قُلتُ: نَعَم، قالَ: هلْ سَمِعتَ أباك يُحَدِّثُ بحَديثٍ سَمِعتَه يُحَدِّثُ به عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ؟ قالَ: لا أدْري، قالَ: سَمِعتَ أباك يَقولُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مَنِ اقتَطَعَ مالَ امرِئٍ مُسلِم بيَمينٍ كاذِبةٍ",1]," ",["كانتْ نُكتةً سَوداءَ في قَلبِه، لا يُغَيِّرُها شَيءٌ إلى يَومِ القِيامةِ",2],"؟ قُلتُ: لا."],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"صحيح الإسناد","bab":"مظالم › تحريم الظلم","dorar":"BLV42TGm"},{"id":"س-04765","fp":"d6bd1bd870da","stateId":199,"easy":"إذا كذبت ← فليس ذلك من صفة المؤمن","cause":"أيكونُ المؤمِنُ كَذَّابًا","result":"قال: لا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"التمهيد 16/253","srcLabel":"مالك","text":["قيل لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم: أيكونُ المؤمِنُ جَبانًا ؟ قال: نَعَمْ ، فقيل: أيكونُ المؤمِنُ بَخيلًا ؟ قال: نَعَمْ ، فقيل له: ",["أيكونُ المؤمِنُ كَذَّابًا",1]," ؟ ",["قال: لا",2]],"grade":"صحيح","narrator":"صفوان بن سليم","muhaddith":"لا أحفظ هذا الحديث مسندا بهذا اللفظ من وجه ثابت وهو حديث حسن","takhrij":"أخرجه مالك (2/990)، وابن وهب في ((الجامع)) (521)، والبيهقي في ((شعب الإيمان)) (4812) باختلاف يسير","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"kO60zcBe"},{"id":"ق-0426","fp":"bde4b0276524","stateId":200,"easy":"التكبر في الأرض بغير الحق والتكذيب بالآيات والغفلة عنها ← الصرف عن آيات الله","cause":"التكبر في الأرض بغير الحق والتكذيب بالآيات والغفلة عنها","result":"الصرف عن آيات الله","explicit":true,"star":true,"ref":"سورة الأعراف: 146","srcLabel":"القرآن الكريم","quran":{"s":7,"from":146,"to":146,"text":"سَأَصْرِفُ عَنْ آيَاتِيَ الَّذِينَ يَتَكَبَّرُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَإِنْ يَرَوْا كُلَّ آيَةٍ لَا يُؤْمِنُوا بِهَا وَإِنْ يَرَوْا سَبِيلَ الرُّشْدِ لَا يَتَّخِذُوهُ سَبِيلًا وَإِنْ يَرَوْا سَبِيلَ الْغَيِّ يَتَّخِذُوهُ سَبِيلًا ذَلِكَ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ (146)","hl":[[0,312,1]]}},{"id":"ق-1110","fp":"62baf27024c7","stateId":200,"easy":"الجدال في آيات الله بغير سلطان والتكبر والتجبر ← مقت الله والطبع على القلب","cause":"الجدال في آيات الله بغير سلطان والتكبر والتجبر","result":"مقت الله والطبع على القلب","explicit":true,"star":true,"otherNeedIds":[28],"ref":"سورة غافر: 35","srcLabel":"القرآن الكريم","quran":{"s":40,"from":35,"to":35,"text":"الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ كَبُرَ مَقْتًا عِنْدَ اللَّهِ وَعِنْدَ الَّذِينَ آمَنُوا كَذَلِكَ يَطْبَعُ اللَّهُ عَلَى كُلِّ قَلْبِ مُتَكَبِّرٍ جَبَّارٍ (35)","hl":[[0,193,1]]}},{"id":"ق-1192","fp":"2d497e8f0f9e","stateId":200,"easy":"الاستكبار عن الإيمان بعد قيام الشاهد (الظلم) ← لا يهديه الله","cause":"الاستكبار عن الإيمان بعد قيام الشاهد (الظلم)","result":"لا يهديه الله","explicit":true,"ref":"سورة الأحقاف: 10","srcLabel":"القرآن الكريم","quran":{"s":46,"from":10,"to":10,"text":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ وَكَفَرْتُمْ بِهِ وَشَهِدَ شَاهِدٌ مِنْ بَنِي إِسْرَائِيلَ عَلَى مِثْلِهِ فَآمَنَ وَاسْتَكْبَرْتُمْ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (10)","hl":[[131,198,1]]}},{"id":"ق-1337","fp":"808c0b5391fe","stateId":200,"easy":"الاستكبار عن الاستغفار والفسق ← لن يغفر الله لهم ولا يهديهم","cause":"الاستكبار عن الاستغفار والفسق","result":"لن يغفر الله لهم ولا يهديهم","explicit":true,"ref":"سورة المنافقون: 5–6","srcLabel":"القرآن الكريم","quran":{"s":63,"from":5,"to":6,"text":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْا يَسْتَغْفِرْ لَكُمْ رَسُولُ اللَّهِ لَوَّوْا رُءُوسَهُمْ وَرَأَيْتَهُمْ يَصُدُّونَ وَهُمْ مُسْتَكْبِرُونَ (5) سَوَاءٌ عَلَيْهِمْ أَسْتَغْفَرْتَ لَهُمْ أَمْ لَمْ تَسْتَغْفِرْ لَهُمْ لَنْ يَغْفِرَ اللَّهُ لَهُمْ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (6)","hl":[[0,291,1]]}},{"id":"ق-1447","fp":"a951e33a0861","stateId":200,"easy":"رؤية النفس مستغنية ← الطغيان","cause":"رؤية النفس مستغنية","result":"الطغيان","explicit":true,"ref":"سورة العلق: 6–7","srcLabel":"القرآن الكريم","quran":{"s":96,"from":6,"to":7,"text":"كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَى (6) أَنْ رَآهُ اسْتَغْنَى (7)","hl":[[0,61,1]]}},{"id":"س-04864","fp":"946a3234bc19","stateId":200,"easy":"إذا قلت «أنا عالم» ← فأنت جاهل","cause":"من قالَ أنا عالمٌ","result":"فهوَ جاهلٌ","explicit":true,"ref":"الغماز على اللماز 282","srcLabel":"الغماز على اللماز","text":["من قالَ أنا مؤمنٌ فهوَ كافرٌ و",["من قالَ أنا عالمٌ",1]," ",["فهوَ جاهلٌ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FvE0OgvB"},{"id":"س-05450","fp":"5c2be201b33e","stateId":200,"easy":"إذا أُعجبت برأيك ← كفى بك جهلاً","cause":"إذا أعجبَ برأيِهِ","result":"و كفى بالمرءِ جهلًا","explicit":true,"ref":"الجامع الصغير 6222","srcLabel":"الطبراني","text":["كفى بالمرءِ فقهًا إذا عبدَ اللهَ، ",["و كفى بالمرءِ جهلًا",2]," ",["إذا أعجبَ برأيِهِ",1]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن المتن","takhrij":"أخرجه مطولاً الطبراني (13/619) (14541) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (5/173)، والبيهقي في ((المدخل إلى السنن)) (453) باختلاف يسير","bab":"رقائق وزهد › الخوف من الله","dorar":"imXqvPrA"},{"id":"س-04058","fp":"5162b2192777","stateId":201,"easy":"إذا سمعت نداء الجمعة ثلاثاً ولم تأتها ← يطبع الله على قلبك فيصير قلب منافق","cause":"مَن سَمِعَ النِّداءَ يَوْمَ الجُمُعةِ ولم يَأتِها ثُمَّ سَمِعَ النِّداءَ فلم يَأتِها ثَلاثًا","result":"طَبَعَ اللهُ على قَلْبِه فجُعِلَ قَلْبَ مُنافِقٍ","explicit":true,"star":true,"similar":["س-01535","س-02791","س-05024","س-04827"],"otherNeedIds":[22],"ref":"الأحاديث المختارة 13 / 127","srcLabel":"متفق عليه","text":["«",["مَن سَمِعَ النِّداءَ يَوْمَ الجُمُعةِ ولم يَأتِها ثُمَّ سَمِعَ النِّداءَ فلم يَأتِها ثَلاثًا، ",1],["طَبَعَ اللهُ على قَلْبِه فجُعِلَ قَلْبَ مُنافِقٍ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جمعة › ترك الجمعة من غير عذر","dorar":"LpR8IUKr","merged":3,"otherRefs":["الترغيب والترهيب 1/353 (صحيح)","تخريج سنن أبي داود 2/288 (حسن)"]},{"id":"س-03586","fp":"64aebec36142","stateId":201,"easy":"إذا تركت الجمعات ← يختم الله على قلبك وتُكتب من الغافلين","cause":"لَيَنْتَهِيَنَّ أَقوامٌ عن وَدْعِهِمُ الجُمُعاتِ","result":"أو لَيَخْتِمَنَّ اللهُ على قُلوبِهِم، ولَيُكْتَبُنَّ مِنَ الغافِلينَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 5560","srcLabel":"النسائي","text":["أنَّ ابنَ عُمرَ، وابنَ عبَّاسٍ حَدَّثَا أنَّهُما سَمِعَا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ على أَعوادِ المِنبرِ: ",["لَيَنْتَهِيَنَّ أَقوامٌ عن وَدْعِهِمُ الجُمُعاتِ",1],"، ",["أو لَيَخْتِمَنَّ اللهُ على قُلوبِهِم، ولَيُكْتَبُنَّ مِنَ الغافِلينَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر وعبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1370)، وابن ماجه (794)، وأحمد (5560) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"XijGxzIG","merged":3,"otherRefs":["صحيح ابن خزيمة 3/ 313 (صحيح)","تخريج المسند لشعيب 3099 (صحيح)"]},{"id":"س-01535","fp":"83623e351ceb","stateId":201,"easy":"إذا سمعت نداء الجمعة ولم تأتها ← يطبع الله على قلبك وتكون من الغافلين","cause":"لَينتهِينَّ أقوامٌ يسمعون النِّداءَ يومَ الجمعةِ ثم لا يأتونها","result":"أو ليطبعنَّ اللهُ على قلوبهم ، ثم ليكوننَّ من الغافلِين","explicit":true,"repOf":"س-04058","ref":"صحيح الترغيب 730","text":[["لَينتهِينَّ أقوامٌ يسمعون النِّداءَ يومَ الجمعةِ ثم لا يأتونها",1]," ، ",["أو ليطبعنَّ اللهُ على قلوبهم ، ثم ليكوننَّ من الغافلِين",2]],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (19/99) (197)، وأبو نعيم في ((حلية الأولياء)) (9/309) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (5/284) باختلاف يسير.","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"ouXU8XdV"},{"id":"س-02791","fp":"339985b2c036","stateId":201,"easy":"إذا تركت الجمعة ثلاثاً ← يُطبع على قلبك ويصير قلب منافق","cause":"مَن ترَك الجمُعةَ ثلاثًا","result":"طُبِع على قلبِه وجُعِل قلبُه قلبَ منافقٍ","explicit":true,"repOf":"س-04058","ref":"إتحاف الخيرة المهرة 2/272","text":[["مَن ترَك الجمُعةَ ثلاثًا ",1],["طُبِع على قلبِه وجُعِل قلبُه قلبَ منافقٍ",2]],"grade":"صحيح","narrator":"يحيى بن أسعد بن زرارة","muhaddith":"سنده صحيح","takhrij":"أخرجه أحمد بن علي المروزي في ((الجمعة وفضلها)) (61) بلفظه، وأبو بكر الخلال في ((السنة)) (1597) باختلاف يسير.","bab":"إيمان › النفاق","dorar":"RkShihb1"},{"id":"س-04070","fp":"16d87e72ee51","stateId":201,"easy":"إذا لم تشهد الجمعة ← يطبع الله على قلبك","cause":"فلا يَشهدُها","result":"حتَّى يطبعَ علَى قَلبِهِ","explicit":true,"similar":["س-06022"],"otherNeedIds":[13],"ref":"صحيح ابن خزيمة 3/ 316","srcLabel":"الحاكم","text":["ألا هل عَسى أحدُكُم أن يتَّخذَ الصُّبَّةَ منَ الغنَمِ علَى رأسِ ميلٍ أو ميلينِ، فتعذَّرَ عليهِ الكلأُ على رأسِ ميلٍ أو ميلَينِ، فيرتَفعَ حتَّى تَجيءَ الجمُعةُ، ",["فلا يَشهدُها",1],"، وتَجيءُ الجمُعةُ فلا يَشهدُها، وتجيءُ الجمُعةُ فلا يَشهدُها ",["حتَّى يطبعَ علَى قَلبِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجة (1127)، والحاكم (1083)، وأبو يعلى (6450) باختلاف يسير.","bab":"جمعة › فرض الجمعة","dorar":"E29vG5gq"},{"id":"س-05024","fp":"c77e6ce4c40f","stateId":201,"easy":"إذا تركت الجمعة ثلاث مرات متواليات بلا ضرورة ← يطبع الله على قلبك","cause":"مَنْ تَرَكَ الجمعةَ ثلاثَ مرَّاتٍ متوالياتٍ : مِنْ غيرِ ضرورةٍ","result":"طَبَعَ اللهُ على قلْبِهِ","explicit":true,"repOf":"س-04058","ref":"صحيح الجامع 6140","text":[["مَنْ تَرَكَ الجمعةَ ثلاثَ مرَّاتٍ متوالياتٍ : مِنْ غيرِ ضرورةٍ ، ",1],["طَبَعَ اللهُ على قلْبِهِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البيهقي (6054) بلفظه، وابن ماجه (1126)، وأحمد (22558) بدون لفظ: متواليات.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3RdX6jpy"},{"id":"س-06022","fp":"868fecfcbabc","stateId":201,"easy":"إذا لم تشهد الجمعة ولا الجماعة ← يطبع الله على قلبك","cause":"ولا يَشهَدُ الجُمُعةَ ولا الجَماعةَ","result":"فيَطبَعُ اللهُ على قَلبِه","explicit":true,"repOf":"س-04070","ref":"الترغيب والترهيب 1/353","text":["يَتَّخِذُ أحَدُكمُ السَّائِمةَ فيَشهَدُ الصَّلاةَ في جَماعةٍ فتَتَعذَّرُ عليه سائِمتُه، فيَقولُ: لو طَلَبتُ لِسائِمَتي مَكانًا هو أكَلأُ مِن هذا؛ فيَتَحوَّلُ ولا يَشهَدُ إلَّا الجُمُعةَ، فتَتَعذَّرُ عليه سائِمةٌ فيَقولُ: لو طَلَبتُ لسائِمَتي مَكانًا هو أكَلأُ مِن هذا؛ فيَتَحوَّلُ ",["ولا يَشهَدُ الجُمُعةَ ولا الجَماعةَ",1],"، ",["فيَطبَعُ اللهُ على قَلبِه",2],"."],"grade":"صحيح","narrator":"حارثة بن النعمان","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (23678) بلفظه، والطبراني (3/ 230) (3230) وأبو القاسم البغوي في ((معجم الصحابة)) (471) بنحوه.","bab":"رقائق وزهد › ذم حب الدنيا","dorar":"Mqjgrk8Q"},{"id":"س-06426","fp":"5ae2766086ba","stateId":201,"easy":"إذا لم تصلِّ ← فلا دين لك","cause":"لمن لا صلاةَ لَهُ","result":"ولا دينَ","explicit":true,"similar":["س-06427"],"ref":"الترغيب والترهيب 1/261","srcLabel":"الطبراني","text":["لا إيمانَ لمن لا أمانةَ لَهُ ، ولا صَلاةَ لمن لا طُهورَ لَهُ ، ",["ولا دينَ",2]," ",["لمن لا صلاةَ لَهُ",1]," ، إنَّما موضِعُ الصَّلاةِ مِنَ الدِّينِ كموضعِ الرَّأسِ منَ الجسَدِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2292)، والمخلص في ((المخلصيات)) (2529)","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"hOTNaxzo"},{"id":"س-06427","fp":"257420612b52","stateId":201,"easy":"إذا لم تصلِّ ← فلا إيمان لك","cause":"لمن لا صلاةَ لهُ","result":"لا إيمانَ","explicit":true,"repOf":"س-06426","ref":"الترغيب والترهيب 1/264","text":["عَن أبي الدَّرداءِ رضيَ اللَّهُ عنهُ ، قالَ : ",["لا إيمانَ",2]," ",["لمن لا صلاةَ لهُ",1]," ولا صَلاةَ لِمَن لا وُضوءَ لَهُ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو بكر الخلال في ((السنة)) (1384)، وابن بطة في ((الإبانة الكبرى)) (887)، واللالكائي في ((شرح أصول الاعتقاد)) (1536)","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"cM7tFwiy"},{"id":"س-04827","fp":"659d7e2d9291","stateId":201,"easy":"إذا تركت الجمعة ← يطبع الله على قلبك","cause":"فلا يحضرُ الجمعةَ","result":"ويطبعُ اللَّهُ على قلبِهِ","explicit":true,"repOf":"س-04058","ref":"مجمع الزوائد 2/196","text":["قام رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ خطيبًا يومَ الجمعةِ فقالَ عسى رجلٌ تحضرُه الجمعةُ وَهوَ على قدرِ ميلٍ منَ المدينةِ فلا يحضُرُ الجمعةَ ثمَّ قالَ في الثَّانيةِ عسى رجلٌ تحضرُهُ الجمعةُ وَهوَ على قدرِ ميلينِ منَ المدينةِ فلا يحضرُها وقالَ في الثَّالثةِ عسى يَكونُ على قدرِ ثلاثةِ أميالٍ منَ المدينةِ ",["فلا يحضرُ الجمعةَ",1]," ",["ويطبعُ اللَّهُ على قلبِهِ",2]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"رجاله موثقون","takhrij":"أخرجه أبو يعلى (2198)، والبيهقي في ((شعب الإيمان)) (3012)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Kx0PBYCL"},{"id":"س-00776","fp":"801e86acdf16","stateId":201,"easy":"إذا لم يكن في جوفك شيء من القرآن ← فأنت كالبيت الخرب","cause":"الَّذي ليس في جَوْفِه شيءٌ مِن القُرآنِ","result":"كالبَيْتِ الخَرِبِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الأحاديث المختارة 9 / 537","srcLabel":"متفق عليه","text":["«الرَّجُلُ ",["الَّذي ليس في جَوْفِه شيءٌ مِن القُرآنِ",1]," ",["كالبَيْتِ الخَرِبِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"SfUO9frM","merged":2,"otherRefs":["المستدرك على الصحيحين 2063 (صحيح)"]},{"id":"س-02143","fp":"d219296b2024","stateId":202,"easy":"إذا بتّ شبعان وجارك جائع ← فلست مؤمناً كامل الإيمان","cause":"الَّذي يَبيتُ وجارُه إلى جَنبِه جائعٌ","result":"ليْسَ المؤمنُ","explicit":true,"star":true,"otherNeedIds":[39],"ref":"المستدرك على الصحيحين 7513","srcLabel":"البخاري","text":["عنْ عبدِ الله بنِ أبي المُساوِرِ، قالَ: سَمِعْتُ ابنَ عبَّاسٍ وهو يبَخِّلُ ابنَ الزُّبَيرِ، ويقولُ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ليْسَ المؤمنُ",2]," ",["الَّذي يَبيتُ وجارُه إلى جَنبِه جائعٌ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه عبد بن حميد في ((المنتخب من المسند)) (694)واللفظ له، والبخاري في ((الأدب المفرد)) (112)، والطحاوي في ((شرح معاني الآثار)) (116) بلفظ مقارب","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TMxUAKXS","merged":5,"otherRefs":["الجامع الصغير 7565 (صحيح)","الأحاديث المختارة 11 / 129 (صحيح)","صحيح الترغيب 2562 (صحيح)","صحيح الترغيب 2563 (صحيح)"]},{"id":"س-00154","fp":"faf549cb17b2","stateId":202,"easy":"إذا امتنعت عن تقبيل أولادك ← فقد نُزعت الرحمة من قلبك","cause":"واللهِ ما نُقبِّلُهم","result":"إنْ كان اللهُ عزَّ وجلَّ نَزَعَ منكَ الرَّحْمةَ","explicit":true,"ref":"تخريج المسند لشعيب 24408","srcLabel":"متفق عليه","text":["جاءَ أعْرابٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: أتُقبِّلون الصِّبْيانَ؟ قال: ",["واللهِ ما نُقبِّلُهم",1],"، قال: لا أملِكُ ",["إنْ كان اللهُ عزَّ وجلَّ نَزَعَ منكَ الرَّحْمةَ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط الشيخين.","takhrij":"أخرجه البخاري (5998)، ومسلم (2317)، وابن ماجه (3665)، وأحمد (24408) واللفظ له","bab":"آداب السلام › تقبيل الرجل لولده","dorar":"j3rgtHaX"},{"id":"س-00156","fp":"4f34b61e7f6f","stateId":202,"easy":"إذا لم تقبّل أولادك ← فكأن الله نزع منك الرحمة","cause":"واللَّهِ ما نُقَبِّلُ","result":"إن كان اللهُ نَزَعَ مِنكُمُ الرَّحمةَ","explicit":true,"similar":["س-00157"],"ref":"صحيح مسلم 2317","srcLabel":"مسلم","text":["قدِمَ ناسٌ مِنَ الأعرابِ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا: أتُقَبِّلونَ صِبيانَكُم؟ فقالوا: نَعَم، فقالوا: لَكِنَّا ",["واللَّهِ ما نُقَبِّلُ",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: وأملِكُ ",["إن كان اللهُ نَزَعَ مِنكُمُ الرَّحمةَ",2],"! وقال ابنُ نُمَيرٍ: مِن قَلبِكَ الرَّحمةَ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2317)، وابن ماجه (3665)","bab":"آداب السلام › تقبيل الرجل لولده","dorar":"A4Xe6w8B"},{"id":"س-03823","fp":"98c9c0cd39a9","stateId":202,"easy":"إذا لم يأمن جارك أذاك ← فلست مؤمناً","cause":"مَنْ لا يَأْمَنُ جارُه غوائِلَه","result":"ليس بمؤمِنٍ","explicit":true,"ref":"الجامع الصغير 7577","srcLabel":"ابن نصر","text":[["ليس بمؤمِنٍ",2]," ",["مَنْ لا يَأْمَنُ جارُه غوائِلَه",1],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","takhrij":"أخرجه ابن نصر في ((تعظيم قدر الصلاة)) (626) واللفظ له، وأبو يعلى (4252)، والخرائطي في ((مساويء الأخلاق)) (376) باختلاف يسير.","bab":"بر وصلة › حق الجار والوصاة به","dorar":"WkvgAGbV","merged":2,"otherRefs":["صحيح الترغيب 2552 (صحيح)"]},{"id":"س-00157","fp":"9c3f27bd858f","stateId":202,"easy":"إذا لم تقبّل أولادك قط ← فقد نُزعت الرحمة من قلبك","cause":"ما قبَّلْتُه قطُّ","result":"إنْ كانَ اللهُ نزَعَ الرَّحمةَ من قَلبِكَ","explicit":true,"repOf":"س-00156","ref":"المستدرك على الصحيحين 4857","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قبَّلَ حَسنًا وضمَّه إليه، وجعَلَ يَشُمُّه وعندَه رَجلٌ منَ الأنْصارِ فقالَ الأنْصاريُّ: إنَّ لي ابنًا قد بلَغَ ",["ما قبَّلْتُه قطُّ",1],"، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أرأيْتَ ",["إنْ كانَ اللهُ نزَعَ الرَّحمةَ من قَلبِكَ",2]," فما ذَنْبي؟»."],"grade":"صحيح","narrator":"[الزبير بن العوام]","muhaddith":"صحيح الإسناد على شرط الشيخين","takhrij":"لم نقف عليه إلا عند الحاكم (4793).","bab":"آداب السلام › تقبيل الرجل لولده","dorar":"K4cC58IU"},{"id":"س-04804","fp":"437ae16b94d2","stateId":202,"easy":"إذا بتّ شبعان وجارك جائع وأنت تعلم ← لم تؤمن حق الإيمان","cause":"مَن باتَ شبعانًا وجارُه جائعٌ إلى جَنبِه وهوَ يعلَمُ","result":"ما آمنَ بي","explicit":true,"ref":"صحيح الترغيب 2561","srcLabel":"الطبراني","text":[["ما آمنَ بي",2]," ",["مَن باتَ شبعانًا وجارُه جائعٌ إلى جَنبِه وهوَ يعلَمُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه البزار كما في ((مجمع الزوائد)) للهيثمي (8/170)، والطبراني (1/259) (754).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"CJA61fw9","merged":3,"otherRefs":["صحيح الجامع 5505 (صحيح)","تخريج مشكلة الفقر 97 (صحيح)"]},{"id":"س-05579","fp":"c4a80da5cfc0","stateId":203,"easy":"إذا طال عليك الأمد (بلا ذكر) ← يقسو قلبك","cause":"يَطولَنَّ عليكُمُ الأمَدُ","result":"فتَقسوَ قُلوبُكُم","explicit":true,"star":true,"ref":"صحيح مسلم 1050","srcLabel":"متفق عليه","text":["بَعَثَ أبو موسى الأشعَريُّ إلى قُرَّاءِ أهلِ البَصرةِ، فدَخَلَ عليه ثَلاثُ مِائةِ رَجُلٍ قد قَرَؤوا القُرآنَ، فقال: أنتُم خيارُ أهلِ البَصرةِ وقُرَّاؤُهم، فاتلوه، ولا ",["يَطولَنَّ عليكُمُ الأمَدُ",1]," ",["فتَقسوَ قُلوبُكُم",2]," كما قَسَت قُلوبُ مَن كان قَبلَكُم، وإنَّا كُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها في الطُّولِ والشِّدَّةِ ببَراءةَ، فأُنسيتُها، غيرَ أنِّي قد حَفِظتُ منها: لو كان لابنِ آدَمَ واديانِ مِن مالٍ لابتَغى واديًا ثالِثًا، ولا يَملأُ جَوفَ ابنِ آدَمَ إلَّا التُّرابُ، وكُنَّا نَقرَأُ سورةً كُنَّا نُشَبِّهُها بإحدى المُسَبِّحاتِ، فأُنسيتُها، غيرَ أنِّي حَفِظتُ منها: يا أيُّها الذينَ آمَنوا لمَ تَقولونَ ما لا تَفعَلونَ، فتُكتَبُ شَهادةً في أعناقِكُم، فتُسألونَ عَنها يَومَ القيامةِ."],"grade":"صحيح","narrator":"أبو الأسود الديلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"u65Ireta"},{"id":"ق-0325","fp":"afaa28aa2c03","stateId":203,"easy":"الأمن من الفتنة والعقوبة ← العمى والصمم عن الحق","cause":"الأمن من الفتنة والعقوبة","result":"العمى والصمم عن الحق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة المائدة: 71","srcLabel":"القرآن الكريم","quran":{"s":5,"from":71,"to":71,"text":"وَحَسِبُوا أَلَّا تَكُونَ فِتْنَةٌ فَعَمُوا وَصَمُّوا ثُمَّ تَابَ اللَّهُ عَلَيْهِمْ ثُمَّ عَمُوا وَصَمُّوا كَثِيرٌ مِنْهُمْ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ (71)","hl":[[0,53,1]]}},{"id":"ق-0541","fp":"7996b747a803","stateId":203,"easy":"الانصراف عن الذكر ← صرف الله قلوبهم","cause":"الانصراف عن الذكر","result":"صرف الله قلوبهم","explicit":true,"star":true,"ref":"سورة التوبة: 127","srcLabel":"القرآن الكريم","quran":{"s":9,"from":127,"to":127,"text":"وَإِذَا مَا أُنْزِلَتْ سُورَةٌ نَظَرَ بَعْضُهُمْ إِلَى بَعْضٍ هَلْ يَرَاكُمْ مِنْ أَحَدٍ ثُمَّ انْصَرَفُوا صَرَفَ اللَّهُ قُلُوبَهُمْ بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ (127)","hl":[[89,168,1]]}},{"id":"ق-0548","fp":"ef8823a6f034","stateId":203,"easy":"الإسراف ونسيان الله بعد كشف الضر ← تزيين العمل السيئ","cause":"الإسراف ونسيان الله بعد كشف الضر","result":"تزيين العمل السيئ","explicit":true,"star":true,"ref":"سورة يونس: 12","srcLabel":"القرآن الكريم","quran":{"s":10,"from":12,"to":12,"text":"وَإِذَا مَسَّ الْإِنْسَانَ الضُّرُّ دَعَانَا لِجَنْبِهِ أَوْ قَاعِدًا أَوْ قَائِمًا فَلَمَّا كَشَفْنَا عَنْهُ ضُرَّهُ مَرَّ كَأَنْ لَمْ يَدْعُنَا إِلَى ضُرٍّ مَسَّهُ كَذَلِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُوا يَعْمَلُونَ (12)","hl":[[84,222,1]]}},{"id":"ق-0571","fp":"0899c9280dcc","stateId":203,"easy":"ترك التعقل ← الرجس","cause":"ترك التعقل","result":"الرجس","explicit":true,"ref":"سورة يونس: 100","srcLabel":"القرآن الكريم","quran":{"s":10,"from":100,"to":100,"text":"وَمَا كَانَ لِنَفْسٍ أَنْ تُؤْمِنَ إِلَّا بِإِذْنِ اللَّهِ وَيَجْعَلُ الرِّجْسَ عَلَى الَّذِينَ لَا يَعْقِلُونَ (100)","hl":[[59,111,1]]}},{"id":"ق-0734","fp":"906e3ffa8e22","stateId":203,"easy":"الإعراض عن آيات الله ونسيان ما قدمت اليدان ← أكنّة على القلوب ووقر في الآذان فلا يهتدون أبداً","cause":"الإعراض عن آيات الله ونسيان ما قدمت اليدان","result":"أكنّة على القلوب ووقر في الآذان فلا يهتدون أبداً","explicit":true,"ref":"سورة الكهف: 57","srcLabel":"القرآن الكريم","quran":{"s":18,"from":57,"to":57,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ فَأَعْرَضَ عَنْهَا وَنَسِيَ مَا قَدَّمَتْ يَدَاهُ إِنَّا جَعَلْنَا عَلَى قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا وَإِنْ تَدْعُهُمْ إِلَى الْهُدَى فَلَنْ يَهْتَدُوا إِذًا أَبَدًا (57)","hl":[[0,250,1]]}},{"id":"ق-0968","fp":"b75314e800b2","stateId":203,"easy":"الجهل والإعراض عن العلم ← الطبع على القلوب","cause":"الجهل والإعراض عن العلم","result":"الطبع على القلوب","explicit":true,"ref":"سورة الروم: 59","srcLabel":"القرآن الكريم","quran":{"s":30,"from":59,"to":59,"text":"كَذَلِكَ يَطْبَعُ اللَّهُ عَلَى قُلُوبِ الَّذِينَ لَا يَعْلَمُونَ (59)","hl":[[0,65,1]]}},{"id":"ق-1082","fp":"627ad2b518a9","stateId":203,"easy":"قسوة القلب عن ذكر الله ← ويل وضلال مبين","cause":"قسوة القلب عن ذكر الله","result":"ويل وضلال مبين","explicit":true,"otherNeedIds":[69],"ref":"سورة الزمر: 22","srcLabel":"القرآن الكريم","quran":{"s":39,"from":22,"to":22,"text":"أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ فَهُوَ عَلَى نُورٍ مِنْ رَبِّهِ فَوَيْلٌ لِلْقَاسِيَةِ قُلُوبُهُمْ مِنْ ذِكْرِ اللَّهِ أُولَئِكَ فِي ضَلَالٍ مُبِينٍ (22)","hl":[[79,163,1]]}},{"id":"ق-1300","fp":"14b373a17e19","stateId":203,"easy":"طول الأمد مع الغفلة عن ذكر الله ← قسوة القلب والفسق","cause":"طول الأمد مع الغفلة عن ذكر الله","result":"قسوة القلب والفسق","explicit":true,"ref":"سورة الحديد: 16","srcLabel":"القرآن الكريم","quran":{"s":57,"from":16,"to":16,"text":"أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللَّهِ وَمَا نَزَلَ مِنَ الْحَقِّ وَلَا يَكُونُوا كَالَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلُ فَطَالَ عَلَيْهِمُ الْأَمَدُ فَقَسَتْ قُلُوبُهُمْ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ (16)","hl":[[103,211,1]]}},{"id":"ق-1322","fp":"cca3a3875600","stateId":203,"easy":"نسيان الله ← إنساؤهم أنفسهم والفسق","cause":"نسيان الله","result":"إنساؤهم أنفسهم والفسق","explicit":true,"ref":"سورة الحشر: 19","srcLabel":"القرآن الكريم","quran":{"s":59,"from":19,"to":19,"text":"وَلَا تَكُونُوا كَالَّذِينَ نَسُوا اللَّهَ فَأَنْسَاهُمْ أَنْفُسَهُمْ أُولَئِكَ هُمُ الْفَاسِقُونَ (19)","hl":[[0,98,1]]}},{"id":"ق-1396","fp":"4d356b1da436","stateId":203,"easy":"عدم خوف الآخرة ← الإعراض عن التذكرة","cause":"عدم خوف الآخرة","result":"الإعراض عن التذكرة","explicit":true,"ref":"سورة المدثر: 49–53","srcLabel":"القرآن الكريم","quran":{"s":74,"from":49,"to":53,"text":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ (49) كَأَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌ (50) فَرَّتْ مِنْ قَسْوَرَةٍ (51) بَلْ يُرِيدُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُؤْتَى صُحُفًا مُنَشَّرَةً (52) كَلَّا بَلْ لَا يَخَافُونَ الْآخِرَةَ (53)","hl":[[0,228,1]]}},{"id":"س-05656","fp":"fe46fe11f63d","stateId":204,"easy":"إذا حرصت على المال والشرف ← أفسدا دينك أكثر من ذئبين في غنم","cause":"حُبِّ المَرْءِ المالَ والشَّرَفَ","result":"ما ذِئْبانِ عادِيانِ أصابا غَنَمًا أضاعَها رَبُّها بأفْسَدَ لَها مِن","explicit":true,"star":true,"otherNeedIds":[57],"ref":"الأحاديث المختارة 8 / 176","srcLabel":"متفق عليه","text":["«اشْتَرَيْتُ أنا وأخي مِئةَ سَهْمٍ مِن سِهامِ خَيْبَرَ، فبلغ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقالَ: (يا عاصِمُ، ",["ما ذِئْبانِ عادِيانِ أصابا غَنَمًا أضاعَها رَبُّها بأفْسَدَ لَها مِن",2]," ",["حُبِّ المَرْءِ المالَ والشَّرَفَ",1]," لدينِه»)."],"grade":"صحيح","narrator":"عاصم بن عدي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"zzKp8ReP","merged":8,"otherRefs":["مجمع الزوائد 10/253 (صحيح)","صحيح الترغيب 3251 (صحيح)","الفتح الرباني 4/1804 (صحيح)","صحيح الموارد 2092 (صحيح)","مجمع الزوائد 10/253 (حسن)","المصابيح في الأحاديث المتواترة 625 (صحيح)","الضعفاء الكبير 3/487 (صحيح)"]},{"id":"ق-0636","fp":"c85aec80fda0","stateId":204,"easy":"استحباب الحياة الدنيا على الآخرة والصد عن سبيل الله وابتغاؤها عوجاً ← ويل من عذاب شديد وضلال بعيد","cause":"استحباب الحياة الدنيا على الآخرة والصد عن سبيل الله وابتغاؤها عوجاً","result":"ويل من عذاب شديد وضلال بعيد","explicit":true,"otherNeedIds":[69],"ref":"سورة إبراهيم: 2–3","srcLabel":"القرآن الكريم","quran":{"s":14,"from":2,"to":3,"text":"اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ وَوَيْلٌ لِلْكَافِرِينَ مِنْ عَذَابٍ شَدِيدٍ (2) الَّذِينَ يَسْتَحِبُّونَ الْحَيَاةَ الدُّنْيَا عَلَى الْآخِرَةِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا أُولَئِكَ فِي ضَلَالٍ بَعِيدٍ (3)","hl":[[63,262,1]]}},{"id":"س-07299","fp":"254225200e98","stateId":204,"easy":"إذا اتبعت الصيد (انشغلت به) ← غفلت","cause":"ومَنِ اتَّبَعَ الصَّيدَ","result":"غفَلَ","explicit":true,"ref":"شعب الإيمان 7/3100","srcLabel":"أحمد","text":["مَن بَدا جَفَا، ",["ومَنِ اتَّبَعَ الصَّيدَ",1]," ",["غفَلَ",2],"، ومَن لَزِمَ السُّلطانَ افتُتِنَ، وما ازدادَ عبدٌ مِن السُّلطانِ دُنُوًّا إلَّا ازدادَ مِن اللهِ بُعدًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"محفوظ","takhrij":"أخرجه أحمد (9683) باختلاف يسير، والبزار (9743)، وابن حبان في ((المجروحين)) (1/271) مختصراً.","bab":"فتن › ظهور الفتن","dorar":"K4SQUDTs","merged":3,"otherRefs":["صحيح الجامع 6296 (صحيح)","التمهيد 18/144 (صحيح)"]},{"id":"س-00487","fp":"81db19d058e0","stateId":204,"easy":"إذا أحببت شيئاً حباً شديداً ← يعميك ويصمّك عن عيوبه","cause":"حبُّكَ الشيءَ","result":"يُعمي ويُصِمُّ","explicit":true,"ref":"الأسرار المرفوعة 187","srcLabel":"أبو داود","text":[["حبُّكَ الشيءَ",1]," ",["يُعمي ويُصِمُّ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إما صحيح لذاته أو لغيره","takhrij":"أخرجه أبو داود (5130)، وأحمد (21740)","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"Jq4xtu54"},{"id":"س-05001","fp":"c6e50160c3b8","stateId":204,"easy":"إذا طال أملك ← تنسى الآخرة","cause":"وأمَّا طولُ الأمَلِ","result":"فيُنسي الآخِرةَ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 596","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ أخوفَ ما أخافُ على أمَّتي الهوى وطولُ الأمَلِ؛ فأمَّا الهوى فيُبعِدُ عن الحَقِّ، ",["وأمَّا طولُ الأمَلِ",1]," ",["فيُنسي الآخِرةَ",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aIC9DI3U"},{"id":"س-05530","fp":"05372f34c8d8","stateId":204,"easy":"إذا انشغلت بالضيعة (الأملاك) ← ترغب في الدنيا","cause":"تتخذوا الضيعةَ","result":"فترغبوا في الدُّنيا","explicit":true,"ref":"تخريج المسند لشاكر 6/58","srcLabel":"الترمذي","text":["لا ",["تتخذوا الضيعةَ",1]," ",["فترغبوا في الدُّنيا",2]," قال : ثم قال عبدُ اللهِ : وبِراذَانَ ما بِراذَانَ وبالمدينةِ ما بالمدينةِ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2328)، وأحمد (4048) واللفظ له","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"qTtj2FW5"},{"id":"س-05538","fp":"67916f1113a4","stateId":204,"easy":"إذا ازددت حرصاً على الدنيا ← تزداد من الله بعداً","cause":"يَزْدَادُ الناسُ على الدنيا إلَّا حِرْصًا","result":"و لا يَزْدَادُونَ مِنَ اللهِ إلَّا بُعْدًا","explicit":true,"ref":"السلسلة الصحيحة 1510","srcLabel":"الحاكم","text":["اقْتَرَبَتِ السَّاعَةُ ، و لا ",["يَزْدَادُ الناسُ على الدنيا إلَّا حِرْصًا",1]," ، ",["و لا يَزْدَادُونَ مِنَ اللهِ إلَّا بُعْدًا",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((العقوبات)) (286)، وابن أبي عاصم في ((الزهد)) (279)، والحاكم (7917) واللفظ له","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"vpHE1NAC"},{"id":"س-05805","fp":"fdc3802bfa23","stateId":204,"easy":"إذا تنعّمت كثيراً ← فعباد الله ليسوا بالمتنعمين","cause":"والتَّنعُّمَ","result":"فإنَّ عِبادَ اللَّهِ لَيسوا بالمتَنعِّمينَ","explicit":true,"ref":"الجامع الصغير 2877","srcLabel":"أحمد","text":["إيَّاكَ ",["والتَّنعُّمَ",1],"، ",["فإنَّ عِبادَ اللَّهِ لَيسوا بالمتَنعِّمينَ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22105)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (5/ 155)، والبيهقي في ((شعب الإيمان)) (5766) جميعهم بلفظه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"oaHonvZJ"},{"id":"س-05572","fp":"ea9e4dbbfafa","stateId":204,"easy":"إذا اجتهدت في العبادة وأحببت الدنيا ← لم تبلغ الاستقامة","cause":"وكان الاثنانِ أحبُّ إليكم من واحدٍ","result":"لم تبلغوا الاستقامةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[52],"ref":"الأجوبة المرضية 2/874","srcLabel":"ابن منده","text":["لو صليتُم حتَّى تكونوا كالحنايا وصُمتُم حتَّى تكونوا كالأوتارِ ",["وكان الاثنانِ أحبُّ إليكم من واحدٍ",1]," ",["لم تبلغوا الاستقامةَ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","takhrij":"أخرجه ابن منده في ((مسند إبراهيم بن أدهم)) (23)، وابن الجوزي في ((صفة التصوف)) (713)، وابن عساكر في ((تاريخ دمشق)) (23/ 131)، وأبو طاهر السلفي في ((معجم السفر)) (1497) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"nuJRCJuW"},{"id":"س-05589","fp":"a626fabcd59c","stateId":204,"easy":"إذا لزمت البطالة ← يقسو قلبك","cause":"والبطالةُ","result":"تقسِّي القلبَ","explicit":true,"ref":"شرح كتاب الشهاب 428","srcLabel":"القضاعي","text":["الزهدُ في الدنيا يريحُ القلبَ والبدنَ والرغبةُ فيها تكثرُ الهمَّ والحزنَ ",["والبطالةُ",1]," ",["تقسِّي القلبَ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (278 )","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Jxm2JwlN"},{"id":"س-06024","fp":"fdcdaa37e860","stateId":204,"easy":"إذا اغتررت بالدنيا ← سحرتك أشد من سحر هاروت وماروت","cause":"الدُّنيا","result":"إنَّها لأسحَرُ من هاروتَ وماروتَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"فيض القدير 145","srcLabel":"فيض القدير","text":["اتَّقوا ",["الدُّنيا",1],"؛ فوالذي نفسي بيَدِه ",["إنَّها لأسحَرُ من هاروتَ وماروتَ",2],"."],"grade":"حسن","narrator":"عبد الله بن بسر المازلي","muhaddith":"قصة هاروت وماروت المشهورة وردت من نحو عشرين طريقا بعضها حسن","bab":"رقائق وزهد › ذم حب الدنيا","dorar":"9z5CGiQB"},{"id":"س-05871","fp":"781e784f0bb0","stateId":205,"easy":"إذا أكثرت الضحك ← يميت قلبك","cause":"لا تُكْثِروا الضَّحِكَ","result":"فإنَّ كَثرةَ الضَّحِكِ تُميتُ القَلبَ","explicit":true,"similar":["س-01691","س-03815"],"ref":"مصباح الزجاجة 4/233","srcLabel":"الترمذي","text":[["لا تُكْثِروا الضَّحِكَ ",1],["فإنَّ كَثرةَ الضَّحِكِ تُميتُ القَلبَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (4193) واللفظ له، وأخرجه الترمذي (2305)، وأحمد (8095) مطولاً باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"OjH64OMG","merged":2,"otherRefs":["صحيح الأدب المفرد 190 (حسن)"]},{"id":"س-01691","fp":"11dcf6e067fc","stateId":205,"easy":"إذا أكثرت الضحك ← يميت قلبك ويُذهب نور وجهك","cause":"إيَّاكَ وكثرةَ الضَّحِكِ","result":"فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ","explicit":true,"repOf":"س-05871","ref":"النوافح العطرة 227","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : ",["إيَّاكَ وكثرةَ الضَّحِكِ ",1],["فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ",2],"، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : عليكَ بالصَّمتِ إلَّا مِن خيرٍ، فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-03815","fp":"a4b78c535952","stateId":205,"easy":"إذا أكثرت الضحك ← يفسد قلبك","cause":"وإياكَ وكثرةَ الضَّحِكِ","result":"فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ","explicit":true,"repOf":"س-05871","ref":"صحيح الجامع 7833","text":["يا أبا هريرةَ ! كُنْ وَرِعًا تَكُنْ من أَعْبَدِ الناسِ ، وارْضَ بما قسم اللهُ لكَ تَكُن من أَغْنَى الناسِ ، وأَحِبَّ للمسلمينَ والمؤمنينَ ما تُحِبُّ لنفسِكَ وأهلِ بيتِكَ ، واكْرَهْ لهم ما تَكْرَهُ لنفسِكَ وأهلِ بيتِكَ تَكُنْ مؤمنًا ، وجاوِرْ مَن جاوَرْتَ بإحسانٍ تَكُنْ مُسْلِمًا ، ",["وإياكَ وكثرةَ الضَّحِكِ",1]," ؛ ",["فإنَّ كَثْرَةَ الضَّحِكِ فسادُ القلبِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2305)، وابن ماجه (4217)، وأحمد (8095) باختلاف يسير","bab":"بر وصلة › حق الجار والوصاة به","dorar":"8idzJ5Is"},{"id":"س-06068","fp":"c92160aaab44","stateId":205,"easy":"إذا أقللت الضحك ← حييت (فكثرة الضحك تميت القلب)","cause":"وأقِلَّ الضَّحِكَ","result":"فإنَّ كَثرةَ الضَّحِكِ تميتُ القَلبَ","explicit":true,"ref":"فيض القدير 5/ 53","srcLabel":"الترمذي","text":["كُن ورِعًا تَكُنْ أعبَدَ النَّاسِ، وكُنْ قَنِعًا تَكُنْ أشكَرَ النَّاسِ، وأحِبَّ للنَّاسِ ما تُحِبُّ لنَفسِكَ تَكُنْ مُؤمِنًا، وأحسِنْ مُجاورةَ مَن جاورَكَ تَكُنْ مُسلِمًا، ",["وأقِلَّ الضَّحِكَ؛ ",1],["فإنَّ كَثرةَ الضَّحِكِ تميتُ القَلبَ",2]],"grade":"صحيح","narrator":"أبو هريرةَ","muhaddith":"[صحيح]","takhrij":"أخرجه ابن ماجه (4217) بلفظه، والترمذي (2305)، وأحمد (8095) كلاهما بنحوه.","bab":"رقائق وزهد › ما جاء في الضحك","dorar":"0FKsiyMz"},{"id":"س-08289","fp":"0944429877ea","stateId":206,"easy":"إذا جلست متكئاً على يدك اليسرى خلف ظهرك ← فهي قعدة المغضوب عليهم","cause":"وضعتُ يدي اليسرى خلفَ ظهري ؛ واتَّكأْتُ على أَلْيةِ يديَّ","result":"أتقعدُ قِعدةَ المغضوبِ عليهِم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"هداية الرواة 4658","srcLabel":"البخاري","text":["عن عمرو بنِ الشريدِ، عن أبيهِ، قال : مرَّ بي رسولُ اللهِ - صلَّى اللهُ عليهِ وسلَّمَ - وأنا جالسٌ هكذا ؛ وقد ",["وضعتُ يدي اليسرى خلفَ ظهري ؛ واتَّكأْتُ على أَلْيةِ يديَّ",1],"، قال : ",["أتقعدُ قِعدةَ المغضوبِ عليهِم",2]," ؟ ! ."],"grade":"صحيح","narrator":"الشريد بن سويد الثقفي","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أبو داود (4848)، وأحمد (19454)","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"ZmqXyMKi","merged":2,"otherRefs":["المستدرك على الصحيحين 7912 (صحيح)"]},{"id":"س-05357","fp":"1d3edfca1060","stateId":206,"easy":"إذا طلبت الرقية أو اكتويت ← لم تحقق كمال التوكل","cause":"مَن استَرْقى أو اكْتَوى","result":"لم يَتوكَّلْ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8499","srcLabel":"الحاكم","text":[["لم يَتوكَّلْ",2]," ",["مَن استَرْقى أو اكْتَوى",1],"."],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"رقائق وزهد › التوكل واليقين","dorar":"f3J1j589","merged":4,"otherRefs":["تخريج المسند لشعيب 18217 (حسن)","الحديث لابن عبدالوهاب 2/226 (حسن)","الآداب الشرعية 2/333 (حسن)"]},{"id":"س-00412","fp":"967971277387","stateId":206,"easy":"إذا سكنت البادية (بعيداً عن الناس) ← يجفو طبعك","cause":"من سكنَ الباديةَ","result":"جفَا","explicit":true,"star":true,"ref":"التمهيد 18/144","srcLabel":"الترمذي","text":["مَنْ لزِمَ الباديةَ جفا [يعني حديث: ",["من سكنَ الباديةَ",1]," ",["جفَا",2],"، ومنِ اتَّبع الصيدَ غفِلَ، ومن أتى السلطانَ افتُتِنَ.]"],"grade":"صحيح","narrator":"[عبدالله بن عباس]","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (2859)، وأحمد (3362)بلفظه، والترمذي (2256)باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"7jRjv7NN","merged":2,"otherRefs":["صحيح الجامع 6296 (صحيح)"]},{"id":"س-03610","fp":"8f613ebc9d39","stateId":206,"easy":"إذا أسقطت يدك في الصلاة (اتكأت) ← فهي جلسة المعذَّبين","cause":"ساقطًا يدَهُ في الصلاةِ","result":"إنما هذه جِلْسةُ الذين يُعذَّبونَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"أصل صفة الصلاة 3/836","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلم رأى رجلًا ",["ساقطًا يدَهُ في الصلاةِ",1]," فقال : لا تجلسْ هكذا ",["إنما هذه جِلْسةُ الذين يُعذَّبونَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده جيد وهو على شرط مسلم","takhrij":"أخرجه أحمد (5972) واللفظ له، وأخرجه ابن أبي شيبة كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/218) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"BMMAqQcK"},{"id":"س-05180","fp":"3b7f6bacda42","stateId":206,"easy":"إذا قرأت القرآن منكوساً (من آخره) ← فذلك منكوس القلب","cause":"يقرأُ القرآنَ منكوسًا","result":"ذلك منكوسُ القلبِ","explicit":true,"ref":"التبيان 125","srcLabel":"التبيان","text":["عن عبدِ اللهِ بنِ مسعودٍ رضي الله عنه أنه قيل له : إن فلانًا ",["يقرأُ القرآنَ منكوسًا",1]," ؟ فقال : ",["ذلك منكوسُ القلبِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QQXQ5awC"},{"id":"س-05372","fp":"254f584230bd","stateId":206,"easy":"إذا اكتويت أو استرقيت ← برئت من كمال التوكل","cause":"مَنِ اكْتَوَى أَوِ اسْتَرْقَى","result":"فقَدْ بَرِئَ مِنَ التَّوكُّلِ","explicit":true,"ref":"تخريج شرح السنة 3241","srcLabel":"الترمذي","text":[["مَنِ اكْتَوَى أَوِ اسْتَرْقَى، ",1],["فقَدْ بَرِئَ مِنَ التَّوكُّلِ",2],"."],"grade":"صحيح","narrator":"المغيرة بن شعبة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2055)، وابن ماجه (3489)، وأحمد (18180)","bab":"رقائق وزهد › التوكل واليقين","dorar":"f50BbVsY"},{"id":"س-03580","fp":"eb32b8d1dfdd","stateId":206,"easy":"إذا اعتمدت على يدك اليسرى في الصلاة ← فهي صلاة اليهود","cause":"و هو معتمدُ على يَدِهِ اليُسرَى","result":"إنَّها صلاةُ اليهودِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الجامع الصغير 9517","srcLabel":"أبو داود","text":["نهى أن يَجْلِسَ الرجلُ في الصلاةِ،  ",["و هو معتمدُ على يَدِهِ اليُسرَى",1],"،  و قالَ : ",["إنَّها صلاةُ اليهودِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (994) بنحوه، والحاكم (1007)، والبيهقي (2924) واللفظ لهما","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"lgLWT1F1"},{"id":"س-05874","fp":"5ce39f09a8cf","stateId":206,"easy":"إذا تركت المشورة ← لم تعدم غيّاً","cause":"من تركَها","result":"لَم يُعدَمْ غَيًّا","explicit":true,"ref":"الدر المنثور 4/89","srcLabel":"البيهقي","text":["لَمَّا نزلَت وَشَاوِرْهُمْ فِي الْأَمْرِ قال رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أما إنَّ اللَّهَ ورسولَهُ لغنِيَّانِ عنها ولكن جعلها اللَّهُ رحمةً لأمَّتي فمنِ استشارَ منهُم لم يُعدَمْ رُشدًا و",["من تركَها",1]," ",["لَم يُعدَمْ غَيًّا",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/ 544)، وأبو عبدالرحمن السلمي في ((آداب الصحبة)) (77)، والبيهقي في ((شعب الإيمان)) (7136)، وابن حجر في ((موافقة الخبر الخبر)) (1/ 61)، واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"RQVSZcxu"},{"id":"س-07692","fp":"54f79adf5d55","stateId":206,"easy":"إذا رجّعت القرآن ترجيع الغناء ← لا يجاوز حنجرتك ويُفتن قلبك","cause":"يُرجِّعونَ القُرْآنَ ترجيعَ الغِناءِ والرَّهبانيَّةِ","result":"لا يُجاوزُ حناجِرَهم، مَفتونةٌ قلوبُهم، وقلوبُ الَّذين يُعجِبُهم شأنُهم","explicit":true,"otherNeedIds":[52],"ref":"الأحكام الكبير 3/225","srcLabel":"الطبراني","text":["اقرَؤوا القُرْآنَ بلُحونِ العرَبِ وأصواتِها، وإيَّاكم ولُحونَ أهلِ الفِسْقِ وأهلِ الكِتابَيْنِ، وسيَجيءُ قومٌ مِن بعدي ",["يُرجِّعونَ القُرْآنَ ترجيعَ الغِناءِ والرَّهبانيَّةِ",1],"، ",["لا يُجاوزُ حناجِرَهم، مَفتونةٌ قلوبُهم، وقلوبُ الَّذين يُعجِبُهم شأنُهم",2],"."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"[له] طرق متعاضدة متناصرة في حسن إسنادها","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7223)، وابن عدي في ((الكامل في الضعفاء)) (2/78)، وابن الجوزي في ((العلل المتناهية)) (160).","bab":"قرآن › آداب الناس كلهم مع القرآن","dorar":"WYDf6LLg"},{"id":"س-00561","fp":"620ab4b604bf","stateId":206,"easy":"إذا سكنت القرى البعيدة عن العلم والجماعة ← فأنت كساكن القبور","cause":"ساكِنَ الكُفُورِ","result":"كساكِنِ القُبورِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 7326","srcLabel":"البخاري","text":["لا تسكُنِ الكُفُورَ ، فإنَّ ",["ساكِنَ الكُفُورِ",1]," ، ",["كساكِنِ القُبورِ",2]],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"حسن","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (579)، والبيهقي في ((شعب الإيمان)) (7518) واللفظ لهم، وابن عدي في ((الكامل في الضعفاء)) (4/ 400) مطولا.","bab":"آداب عامة › ضرب الأمثال","dorar":"nJVPyzlI"},{"id":"ق-0657","fp":"4578d81fcd05","stateId":207,"easy":"القنوط من رحمة الله ← من صفات الضالين","cause":"القنوط من رحمة الله","result":"من صفات الضالين","explicit":true,"star":true,"ref":"سورة الحجر: 56","srcLabel":"القرآن الكريم","quran":{"s":15,"from":56,"to":56,"text":"قَالَ وَمَنْ يَقْنَطُ مِنْ رَحْمَةِ رَبِّهِ إِلَّا الضَّالُّونَ (56)","hl":[[6,63,1]]}},{"id":"ق-1109","fp":"e4c3f6f1b9c1","stateId":207,"easy":"الإسراف والارتياب ← إضلال الله","cause":"الإسراف والارتياب","result":"إضلال الله","explicit":true,"ref":"سورة غافر: 34","srcLabel":"القرآن الكريم","quran":{"s":40,"from":34,"to":34,"text":"وَلَقَدْ جَاءَكُمْ يُوسُفُ مِنْ قَبْلُ بِالْبَيِّنَاتِ فَمَا زِلْتُمْ فِي شَكٍّ مِمَّا جَاءَكُمْ بِهِ حَتَّى إِذَا هَلَكَ قُلْتُمْ لَنْ يَبْعَثَ اللَّهُ مِنْ بَعْدِهِ رَسُولًا كَذَلِكَ يُضِلُّ اللَّهُ مَنْ هُوَ مُسْرِفٌ مُرْتَابٌ (34)","hl":[[176,229,1]]}},{"id":"ق-1332","fp":"e9c4736296d9","stateId":207,"easy":"حمل الكتاب دون العمل به ← كمثل الحمار يحمل أسفاراً ولا يهديه الله","cause":"حمل الكتاب دون العمل به","result":"كمثل الحمار يحمل أسفاراً ولا يهديه الله","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[57],"ref":"سورة الجمعة: 5","srcLabel":"القرآن الكريم","quran":{"s":62,"from":5,"to":5,"text":"مَثَلُ الَّذِينَ حُمِّلُوا التَّوْرَاةَ ثُمَّ لَمْ يَحْمِلُوهَا كَمَثَلِ الْحِمَارِ يَحْمِلُ أَسْفَارًا بِئْسَ مَثَلُ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِ اللَّهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (5)","hl":[[7,210,1]]}},{"id":"س-00534","fp":"d7b916649cac","stateId":207,"easy":"إذا جالست جليس السوء ← يصيبك من شره كدخان الكير","cause":"الجَليسِ السَّوءِ","result":"كمَثَلِ الكِيرِ، إنْ لم يُصِبْكَ مِن شُرورِه أصابكَ مِن دُخَانِه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[41],"ref":"الضعفاء الكبير 1/160","srcLabel":"متفق عليه","text":["مَثَلُ المُؤمِنِ الَّذي يقرَأُ القُرْآنَ كمَثَلِ الأُتْرُجَّةِ: طَعْمُها طيِّبٌ، ورِيحُها طيِّبٌ، ومَثَلُ المُؤمِنِ الَّذي لا يقرَأُ القُرْآنَ مَثَلُ التَّمرَةِ: طَعْمُها طيِّبٌ، ولا رِيحَ لها، ومَثَلُ الفاجرِ الَّذي يقرَأُ القُرْآنَ كمَثَلِ الرَّيحانةِ، رِيحُها طيِّبٌ، لا طَعْمَ لها، ومَثَلُ الفاجرِ الَّذي لا يقرَأُ القُرْآنَ كمَثَلِ الحَنْظَلةِ طَعْمُها مُرٌّ، ولا رِيحَ لها، ومَثَلُ الجَليسِ الصَّالحِ كمَثَلِ صاحبِ المِسْكِ، إنْ لم يُصِبْكَ منه شيءٌ أصابك رِيحُه، ومَثَلُ ",["الجَليسِ السَّوءِ",1]," ",["كمَثَلِ الكِيرِ، إنْ لم يُصِبْكَ مِن شُرورِه أصابكَ مِن دُخَانِه",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4829) باختلاف يسير، وأخرجه البخاري (5427، 2101)، ومسلم (2628، 797) مفرقاً","bab":"آداب عامة › ضرب الأمثال","dorar":"W0scUFv6","merged":6,"otherRefs":["مجمع الزوائد 8/64 (حسن)","صحيح مسلم 2628 (صحيح)","سير أعلام النبلاء 9/386 (صحيح)","تخريج المسند لشعيب 19624 (صحيح)","صحيح الجامع 5829 (صحيح)"]},{"id":"س-03942","fp":"66daed940c2d","stateId":208,"easy":"إذا كسبت السيئات ← يركسك الله (يردّك) بما كسبت","cause":"وَاللَّهُ أَرْكَسَهُمْ","result":"بِمَا كَسَبُوا","explicit":true,"star":true,"otherNeedIds":[22],"ref":"الأحاديث المختارة 934","srcLabel":"البخاري","text":["«أنَّ قَوْمًا مِن العَرَبِ أَتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بالمَدينةِ فأَسْلَموا، وأصابَهم وَباءٌ بالمَدينةِ حُمَّاها، فأُرْكِسوا، فخَرَجوا مِن المَدينةِ، فاسْتَقْبَلَهم نَفَرٌ مِن أصْحابِه -يَعْني أصْحابَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ- فقالوا لهم: ما لكم رَجَعْتُم؟ قالوا: أصابَنا وَباءُ المَدينةِ فاجْتَوَيْنا المَدينةَ، فقالوا: ما لكم في رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أُسْوةٌ؟ فقالَ بعضُهم: نافَقوا، وقالَ بعضُهم: لم يُنافِقوا، هُمْ مُسلِمونَ، فأَنزَلَ اللهُ عَزَّ وجَلَّ: {فَمَا لَكُمْ فِي الْمُنَافِقِينَ فِئَتَيْنِ ",["وَاللَّهُ أَرْكَسَهُمْ",1]," ",["بِمَا كَسَبُوا",2],"} الآية»."],"grade":"صحيح","narrator":"عبد الرحمن بن عوف","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"تفسير آيات › سورة النساء","dorar":"r1ezqwZ9","merged":4,"otherRefs":["تخريج مشكل الآثار 5173 (صحيح)","صحيح البخاري 4050 (صحيح)","تخريج مشكل الآثار 5174 (صحيح)"]},{"id":"س-00495","fp":"501372b28d7e","stateId":208,"easy":"إذا فسد قلبك ← فسد جسدك كله","cause":"وإذا فسَدَت","result":"فسَدَ الجَسَدُ كُلُّه","explicit":true,"star":true,"similar":["س-00527","س-00650"],"ref":"صحيح مسلم 1599","srcLabel":"متفق عليه","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ -وأهوى النُّعمانُ بإصبَعَيه إلى أُذُنَيه-: إنَّ الحَلالَ بَيِّنٌ، وإنَّ الحَرامَ بَيِّنٌ، وبينَهما مُشتَبِهاتٌ لا يَعلَمُهنَّ كَثيرٌ مِنَ النَّاسِ، فمَنِ اتَّقى الشُّبُهاتِ استَبرَأ لدينِه وعِرضِه، ومَن وقَعَ في الشُّبُهاتِ وقَعَ في الحَرامِ، كالرَّاعي يَرعى حَولَ الحِمى، يوشِكُ أن يَرتَعَ فيه، ألا وإنَّ لكُلِّ مَلِكٍ حِمًى، ألا وإنَّ حِمى اللهِ مَحارِمُه، ألا وإنَّ في الجَسَدِ مُضغةً إذا صَلَحَت صَلَحَ الجَسَدُ كُلُّه، ",["وإذا فسَدَت",1]," ",["فسَدَ الجَسَدُ كُلُّه",2],"، ألا وهي القَلبُ."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (52)، ومسلم (1599).","bab":"آداب عامة › ضرب الأمثال","dorar":"3ItFLlck","merged":2,"otherRefs":["الفتاوى الكبرى 1/95 (صحيح)"]},{"id":"س-00527","fp":"217a741dbbcf","stateId":208,"easy":"إذا مرض قلبك وفسد ← مرض جسدك كله وفسد","cause":"وإن سقِمت وفسَدت","result":"سقِمَ الجسدُ كلُّهُ وفسدَ","explicit":true,"repOf":"س-00495","ref":"حلية الأولياء 8/144","text":["ألا إنَّ الحلالَ بيِّنٌ والحرامُ بيَّنٌ وبينَهما أمورٌ مشتبِهاتٌ فمنِ اتَّقى الشُّبُهاتِ فقد استبرأَ لدينِه وعرضِه ومن وقعَ في الشُّبُهاتِ وقعَ في الحرامِ كالرَّاعي يرتعُ حولَ الحمى يوشِك أن يرتعَ في الحمى ألا وإنَّ لكلِّ ملِك حمى وإنَّ حمى اللَّهِ محارمُه ألا وإنَّ في الجسدِ مضغةً إذا صلُحت وطابت صلُحَ لَها الجسدُ وطابَ ",["وإن سقِمت وفسَدت",1]," ",["سقِمَ الجسدُ كلُّهُ وفسدَ",2]," وَهيَ القلبُ"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح ثابت من حديث الشعبي","takhrij":"أخرجه ابن أبي شيبة (22435)، بلفظه، والبخاري (52)، ومسلم (1599)، وأحمد (18374) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"aKwKO9Od","merged":2,"otherRefs":["تخريج المسند لشعيب 18412 (صحيح)"]},{"id":"س-04022","fp":"9f2d79eb9a45","stateId":208,"easy":"إذا أذنبت ← تكون نكتة سوداء في قلبك","cause":"إنَّ المؤمنَ إذا أَذنبَ ذنبًا","result":"كانتْ نُكْتةٌ سوداءُ في قلبِهِ","explicit":true,"similar":["س-02346","س-04002"],"ref":"المستدرك على الصحيحين 3956","srcLabel":"مسلم","text":["«",["إنَّ المؤمنَ إذا أَذنبَ ذنبًا ",1],["كانتْ نُكْتةٌ سوداءُ في قلبِهِ",2],"، فإنْ تابَ ونَزَعَ واستغفرَ سُقِلَ منها قلبُهُ، وإنْ زادَ زادتْ حتَّى يَعْلَقَ بها قلبُهُ، فذلك الرَّانُ الَّذي ذَكَرَ اللهُ في كتابِهِ: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين: 14]»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حديث عال صحيح على شرط مسلم","takhrij":"أخرجه ابن ماجه (4244)، وأحمد (7952)باختلاف يسير، والترمذي (3334) بنحوه","bab":"توبة › الحض على التوبة","dorar":"pb9RPEYz"},{"id":"س-07286","fp":"25d47a581df9","stateId":208,"easy":"إذا لم ينكر قلبك الفتنة ← تُنكت فيه نكتة سوداء","cause":"وأيُّ قلْبٍ لم يُنكِرْها","result":"نُكِتَت في قلْبِه نُكتةٌ سَوداءُ","explicit":true,"ref":"المستدرك على الصحيحين 8667","srcLabel":"مسلم","text":["عن حُذَيفةَ رَضيَ اللهُ عنه، قال: تُعرَضُ فُتنةٌ على القلوبِ، فأيُّ قلْبٍ أنْكَرَها نُكِتَت في قلْبِه نُكتةٌ بَيضاءُ، ",["وأيُّ قلْبٍ لم يُنكِرْها",1]," ",["نُكِتَت في قلْبِه نُكتةٌ سَوداءُ",2],"، ثمَّ تُعرَضُ فِتنةٌ أُخرى على القلوبِ، فإنْ أنْكَرَها القلبُ الَّذي أنْكَرها في المرَّةِ الأُولى نُكِتَت نُكتةٌ بَيضاءُ، وإنْ لم يُنكِرْها نُكِتَت نُكتةٌ سَوداءُ، ثمَّ تُعرَضُ فِتنةٌ أُخرى على القلوبِ، فإنْ أنْكَرَها الَّذي أنْكَرَها في المرَّتينِ الأُولَيَينِ اشتَدَّ وابيَضَّ وَصْفًا، ولم تَضُرَّه فِتنةٌ أبدًا، وإنْ لم يُنكِرْها في المرَّتينِ الأُولَيَينِ اسوَدَّ وارتَدَّ ونَكَسَ، فلا يَعرِفُ حقًّا ولا يُنكِرُ مُنكَرًا."],"grade":"صحيح","narrator":"نبيط بن شريط","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه مسلم (144)، وأحمد (23280)، ونعيم بن حماد في ((الفتن)) (109) جميعهم بنحوه.","bab":"فتن › ظهور الفتن","dorar":"RjWDq4NC"},{"id":"ق-1419","fp":"66c64fecf3a6","stateId":208,"easy":"كسب الذنوب ← الرَّين على القلوب","cause":"كسب الذنوب","result":"الرَّين على القلوب","explicit":true,"ref":"سورة المطففين: 14","srcLabel":"القرآن الكريم","quran":{"s":83,"from":14,"to":14,"text":"كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ (14)","hl":[[0,59,1]]}},{"id":"س-02346","fp":"14db3df7e6d6","stateId":208,"easy":"إذا أذنبت ← تُنكت في قلبك نكتة سوداء، ثم تزيد حتى يسودّ قلبك","cause":"إنَّ الرجلَ ليُذنبُ الذنبَ","result":"فيُنكتُ في قلبِه نُكتةٌ سوداءُ ، ثم يُذنبُ الذنبَ فتُنكتُ أخرى حتى يصيرَ لونُ قلبِه لونُ الشاةِ الرَّبداءِ","explicit":true,"repOf":"س-04022","ref":"الإيمان لابن أبي شيبة 9","text":["قال عبدُ اللهِ : ",["إنَّ الرجلَ ليُذنبُ الذنبَ",1]," ",["فيُنكتُ في قلبِه نُكتةٌ سوداءُ ، ثم يُذنبُ الذنبَ فتُنكتُ أخرى حتى يصيرَ لونُ قلبِه لونُ الشاةِ الرَّبداءِ",2]],"grade":"صحيح","narrator":"طارق بن شهاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (30322)، وأبو نعيم في ((تاريخ أصبهان)) (2/ 135)، والبيهقي في ((شعب الإيمان)) (6809) بلفظه.","bab":"إحسان › الحسنات والسيئات","dorar":"v87sGmx8"},{"id":"س-04002","fp":"c1045af9c5a9","stateId":208,"easy":"إذا أذنبت ← تُنكت في قلبك نكتة سوداء","cause":"إذا أذنبَ العبدُ","result":"نُكِتت في قلبِهِ نُكتةٌ سوداءُ","explicit":true,"repOf":"س-04022","ref":"تفسير آيات أشكلت 1/383","text":[["إذا أذنبَ العبدُ ",1],["نُكِتت في قلبِهِ نُكتةٌ سوداءُ",2]," فإن تابَ ونزعَ واستغفرَ صُقِلَ قلبُهُ وإن زادَ زيد فيها حتى يعلو قلبَهُ فذلِكَ الرَّانُ الَّذي قال اللَّهُ تعالى كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبونَ"],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"r8iWzNNh"},{"id":"س-04046","fp":"f72de3577923","stateId":208,"easy":"إذا أخطأت خطيئة ← تُنكت في قلبك نكتة سوداء","cause":"إنَّ العَبْدَ إذا أخطأَ خطيئةً","result":"نُكِتتْ في قلبِه نُكْتةٌ سَوْداءُ","explicit":true,"ref":"التنوير شرح الجامع الصغير 3/509","srcLabel":"الترمذي","text":[["إنَّ العَبْدَ إذا أخطأَ خطيئةً ",1],["نُكِتتْ في قلبِه نُكْتةٌ سَوْداءُ",2],"، فإن هو نزَع واستغفَر وتاب صُقِل قلبُه، وإن عادَ زِيدَ فيها حتَّى تعلُوَ على قلبِه؛ وهو الرَّانُ [الَّذي] ذكَر اللهُ تعالى: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين: 14]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أسانيده صحيحة","takhrij":"أخرجه الترمذي (3334)، والطبري في ((تفسيره)) (24/ 200)، والخرائطي في ((اعتلال القلوب)) (55) واللفظ لهم.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"Ie0XLKlA"},{"id":"س-04456","fp":"d6d30a5dd453","stateId":208,"easy":"إذا صار قلبك لا يعرف معروفاً ولا ينكر منكراً ← انتكس فصار أعلاه أسفله","cause":"فإذا كان القلبُ لا يعرِفُ معروفًا ولا يُنكِرُ مُنكرًا","result":"نُكِّسَ وجُعِلَ أعْلاهُ أسفَلَه","explicit":true,"ref":"إتحاف الخيرة المهرة 7/365","srcLabel":"إتحاف الخيرة المهرة","text":["عن عليِّ بنِ أبي طالِبٍ  رضي اللهُ عنه  قال ؟ الجِهادُ ثلاثةٌ:  فأوَّلُ ما يُغلَبُ عليهِ مِن الجِهادِ اليد  ثم اللسان  ثم القلب  ",["فإذا كان القلبُ لا يعرِفُ معروفًا ولا يُنكِرُ مُنكرًا",1]," ",["نُكِّسَ  وجُعِلَ أعْلاهُ أسفَلَه",2]],"grade":"حسن","muhaddith":"رواته ثقات","bab":"جهاد › فضل الجهاد","dorar":"FBQejSMu"},{"id":"س-00650","fp":"ead99023710b","stateId":208,"easy":"إذا فسد قلبك ← فسدت جوارحك","cause":"فإذا فسَدَ المَلكُ","result":"فسَدَ جُنودُه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-00495","ref":"الفوائد المجموعة 468","text":["نحو [عن أبي هُرَيرةَ مِن قَولِه: اليَدانِ جَناحانِ، الرِّجلانِ بَريدانِ، والأُذُنانِ قُمعٌ، والعَينانِ دَليلٌ، واللِّسانُ تُرجُمانٌ، والطِّحالُ ضَحكٌ، والرِّئةُ نَفسٌ، والكُليَتانِ مَكرٌ، والكَبدُ رَحمةٌ، والقَلبُ مَلكٌ، ",["فإذا فسَدَ المَلكُ",1]," ",["فسَدَ جُنودُه",2],"، وإذا صَلَحَ المَلِكُ صَلَحَ جُنودُه]"],"grade":"حسن","narrator":"أبو صالح السمان.","muhaddith":"إسناده قوي","takhrij":"أخرجه معمر في ((الجامع)) (20375)، وأبو نعيم الأصبهاني في ((الطب النبوي)) (94)، والبيهقي في ((شعب الإيمان)) (108) جميعهم بلفظه تاما.","bab":"آداب عامة › ضرب الأمثال","dorar":"U6EatbI4"},{"id":"س-05919","fp":"8e74a8caf202","stateId":209,"easy":"إذا نُزعت منك الرحمة ← فأنت شقي","cause":"نُزِعَتِ الرَّحمةُ","result":"إلَّا مِن شَقِيٍّ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7841","srcLabel":"أبو داود","text":["قالَ خَلِيلِي وصَفِيِّي صاحبُ هذه الحُجْرةِ صلَّى اللهُ عليه وسلَّمَ: ما ",["نُزِعَتِ الرَّحمةُ",1]," ",["إلَّا مِن شَقِيٍّ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو يعلى (6652) باختلاف يسير، وأبو داود (4942)، والترمذي (1923) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"iERjQTdN","merged":2,"otherRefs":["تخريج المسند لشعيب 8001 (حسن)"]},{"id":"س-04442","fp":"35e0939fbb89","stateId":209,"easy":"إذا حسدت ← لا يجتمع الإيمان والحسد في جوفك","cause":"والحسَدُ","result":"ولا يجتمِعُ في جوفِ عبدٍ الإيمانُ والحسَدُ","explicit":true,"ref":"الترغيب والترهيب 4/30","srcLabel":"النسائي","text":["لا يجتمِعُ في جوفِ عبدٍ مؤمنٍ غُبارٌ في سبيلِ اللهِ ، وفَيْحُ جهنَّمَ ، ",["ولا يجتمِعُ في جوفِ عبدٍ الإيمانُ والحسَدُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (4606) واللفظ له، وأخرجه النسائي (3109) مطولاً باختلاف يسير، وأحمد (8479) مطولاً بلفظ: \"الإيمان والشح\"","bab":"جهاد › فضل الجهاد","dorar":"BN1Gcg0E"},{"id":"س-05440","fp":"e831fe20cb49","stateId":209,"easy":"إذا سُلب منك الحياء ← تبعه الإيمان","cause":"سُلِب أحَدُهما","result":"تَبِعَه الآخَرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[17],"ref":"فيض القدير 3/ 428","srcLabel":"البخاري","text":["الحياءُ والإيمانُ في قَرَنٍ، فإذا ",["سُلِب أحَدُهما",1]," ",["تَبِعَه الآخَرُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناد صحيح على شرط البخاري","bab":"رقائق وزهد › الحياء","dorar":"Xfij2xD1"},{"id":"س-05226","fp":"cc0d3c8be8b2","stateId":209,"easy":"إذا ذهب حياؤك ← ذهب إيمانك","cause":"فإذا رُفِعَ أحدُهما","result":"رُفِع الآخرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[17],"ref":"صحيح الأدب المفرد 986","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عمرَ قال إنَّ الحياءَ والإيمانَ قُرِنا جميعًا ، ",["فإذا رُفِعَ أحدُهما",1]," ",["رُفِع الآخرُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"7n5SsBRO"}]}