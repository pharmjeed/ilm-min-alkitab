{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":41,"stateIds":[393,394,395,396,397],"items":[{"id":"س-06103","fp":"4d1054c01bd9","stateId":393,"easy":"إذا أحبك الله ← يحبك جبريل وأهل السماء ويوضع لك القبول في الأرض","cause":"إنَّ اللهَ إذا أحَبَّ عَبدًا","result":"دَعا جِبريلَ فقال: إنِّي أُحِبُّ فُلانًا فأحِبَّه، قال: فيُحِبُّه جِبريلُ، ثُمَّ يُنادي في السَّماءِ فيَقولُ: إنَّ اللهَ يُحِبُّ فُلانًا فأحِبُّوه، فيُحِبُّه أهلُ السَّماءِ، قال: ثُمَّ يوضَعُ له القَبولُ في الأرضِ","explicit":true,"star":true,"similar":["س-03140"],"otherNeedIds":[23],"ref":"صحيح مسلم 2637","srcLabel":"البخاري","text":["كُنَّا بعَرَفةَ فمَرَّ عُمَرُ بنُ عبدِ العَزيزِ وهو على المَوسِمِ، فقامَ النَّاسُ يَنظُرونَ إليه، فقُلتُ لأبي: يا أبَتِ إنِّي أرى اللهَ يُحِبُّ عُمَرَ بنَ عبدِ العَزيزِ، قال: وما ذاكَ؟ قُلتُ: لما له مِنَ الحُبِّ في قُلوبِ النَّاسِ، فقال: بأبيكَ أنتَ سَمِعتُ أبا هُرَيرةَ يُحَدِّثُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم...، ثُمَّ ذَكَرَ بمِثلِ حَديثِ جَريرٍ، عن سُهَيلٍ. [أي بمثلِ حديثِ: ",["إنَّ اللهَ إذا أحَبَّ عَبدًا",1]," ",["دَعا جِبريلَ فقال: إنِّي أُحِبُّ فُلانًا فأحِبَّه، قال: فيُحِبُّه جِبريلُ، ثُمَّ يُنادي في السَّماءِ فيَقولُ: إنَّ اللهَ يُحِبُّ فُلانًا فأحِبُّوه، فيُحِبُّه أهلُ السَّماءِ، قال: ثُمَّ يوضَعُ له القَبولُ في الأرضِ",2],"، وإذا أبغَضَ عَبدًا دَعا جِبريلَ فيَقولُ: إنِّي أُبغِضُ فُلانًا فأبغِضْه، قال: فيُبغِضُه جِبريلُ، ثُمَّ يُنادي في أهلِ السَّماءِ: إنَّ اللهَ يُبغِضُ فُلانًا فأبغِضوه، قال: فيُبغِضونَه، ثُمَّ توضَعُ له البَغضاءُ في الأرضِ]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7485) دون القصة في أوله","bab":"رقائق وزهد › محبة الله عز وجل","dorar":"aUQ450Hs","merged":6,"otherRefs":["تخريج المسند لشعيب 22270 (صحيح)","العرش للذهبي 44 (صحيح)","حلية الأولياء 3/91 (صحيح)","حلية الأولياء 3/296 (صحيح)","عارضة الأحوذي 6/243 (صحيح)"]},{"id":"س-03140","fp":"bd4db6892627","stateId":393,"easy":"إذا أحبك الله ← يضع لك القبول في الأرض","cause":"أحَبَّ فلانًا فأحِبُّوه","result":"ثمَّ يوضَعُ له القَبولُ في الأرضِ","explicit":true,"repOf":"س-06103","otherNeedIds":[23],"ref":"تخريج صحيح ابن حبان 365","text":["إذا أحَبَّ اللهُ العبدَ قال لجبريلَ: قد أحبَبْتُ فلانًا فأحِبَّه فيُحِبُّه جبريلُ ثمَّ يُنادي في أهلِ السَّماءِ: إنَّ اللهَ قد ",["أحَبَّ فلانًا فأحِبُّوه",1]," فيُحِبُّه أهلُ السَّماءِ ",["ثمَّ يوضَعُ له القَبولُ في الأرضِ",2]," وإذا أبغَض اللهُ العبدَ قال مالكٌ: لا أحسَبُه إلَّا قال في البُغضِ مِثْلَ ذلك"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3209)، ومسلم (2637) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"xOm20snM","merged":3,"otherRefs":["تخريج صحيح ابن حبان 364 (صحيح)","تخريج المسند لشعيب 8500 (صحيح)"]},{"id":"س-07110","fp":"fa8a074e033b","stateId":393,"easy":"إذا رأى الناس منك خيراً ← ظنوا بك خيراً وأحبوك","cause":"مَن رأينا منه خيرًا","result":"ظَنَنَّا به خيرًا وأحبَبْناه عليه","explicit":true,"star":true,"ref":"الأحاديث المختارة 116","srcLabel":"متفق عليه","text":["«شَهِدْتُ عُمَرَ بنَ الخَطَّابِ وهو يخطُبُ النَّاسَ، قال: فقال: يا أيُّها النَّاسُ إنَّه قد أتى عليَّ زمانٌ وأنا أرى من قرأ القُرآنَ يُريدُ اللهَ وما عِندَه، فيُخَيَّلُ إليَّ أنَّ قَومًا قَرؤوه يُريدونَ به النَّاسَ، ويُريدونَ به الدُّنيا، ألَا فأَريدوا اللهَ بأعمالِكم، ألَا إنَّا إنَّما كُنَّا نَعرِفُكم أن يُنَزَّلَ، وأنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم بَيْنَ أظهُرِنا وإذ: {نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ} فقد انقَطَع الوَحْيُ وذهب نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم فإنَّما نَعرِفُكم بما نقولُ لكم، ألَا ",["مَن رأينا منه خيرًا",1]," ",["ظَنَنَّا به خيرًا وأحبَبْناه عليه",2],"، ومن رأَينا منه شَرًّا ظَنَنَّا به شَرًّا وأبغَضْناه عليه، سرائِرُكم بَيْنَكم وبَيْنَ رَبِّكم، ألَا إنِّي إنَّما أَبعَثُ عُمَّالي ليُعَلِّموكم دينَكم، وليُعَلِّمُوكم سُنَّتَكم، ولا أبعَثُهم ليَضرِبوا ظُهورَكم ولا ليأخُذوا أموالَكم، ألَا فمَن رابه شيءٌ من ذلك فليرفَعْه إليَّ؛ فوالذي نَفْسُ عُمَرَ بيَدِه لأُقِصَّنَّكم منه. قال: فقام عَمرُو بنُ العاصِ، فقال: يا أميرَ المؤمِنينَ، أرأيتَ إنْ بعَثْتَ عامِلًا مِن عُمَّالِك، فأدَّب رجلًا من أهلِ رَعِيَّتِه فضَرَبه، أكُنْتَ تُقِصُّه منه؟ قال: فقال: نَعَم، والذي نَفْسُ عُمَرَ بيَدِه لأقُصَّنَّ منه، ألَا أَقُصُّ، وقد رأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقُصُّ مِن نَفْسِه، ألَا لا تَضْرِبوا المُسلِمينَ فتُذِلُّوهم، ولا تمنَعوهم حُقوَقهم فتُكَفِّروهم، ولا تَجَمِّرُوهم فتَفْتِنوهم، ولا تُنزِلوهم الغِياضَ فتُضَيِّعوهم»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"xh74WHmz","merged":2,"otherRefs":["تخريج المسند لشاكر 1/146 (حسن)"]},{"id":"ق-0178","fp":"16f53e332c42","stateId":393,"easy":"اللين والرحمة بالناس ← اجتماعهم حولك","cause":"اللين والرحمة بالناس","result":"اجتماعهم حولك","explicit":true,"star":true,"ref":"سورة آل عمران: 159","srcLabel":"القرآن الكريم","quran":{"s":3,"from":159,"to":159,"text":"فَبِمَا رَحْمَةٍ مِنَ اللَّهِ لِنْتَ لَهُمْ وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ إِنَّ اللَّهَ يُحِبُّ الْمُتَوَكِّلِينَ (159)","hl":[[0,43,1]]}},{"id":"ق-0330","fp":"e5a2e66dab08","stateId":393,"easy":"العلم والعبادة وترك الاستكبار ← القرب مودةً من المؤمنين","cause":"العلم والعبادة وترك الاستكبار","result":"القرب مودةً من المؤمنين","explicit":true,"star":true,"ref":"سورة المائدة: 82","srcLabel":"القرآن الكريم","quran":{"s":5,"from":82,"to":82,"text":"لَتَجِدَنَّ أَشَدَّ النَّاسِ عَدَاوَةً لِلَّذِينَ آمَنُوا الْيَهُودَ وَالَّذِينَ أَشْرَكُوا وَلَتَجِدَنَّ أَقْرَبَهُمْ مَوَدَّةً لِلَّذِينَ آمَنُوا الَّذِينَ قَالُوا إِنَّا نَصَارَى ذَلِكَ بِأَنَّ مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًا وَأَنَّهُمْ لَا يَسْتَكْبِرُونَ (82)","hl":[[92,262,1]]}},{"id":"ق-0759","fp":"3f6d9b6fa2ec","stateId":393,"easy":"الإيمان والعمل الصالح ← الودّ (المحبة في القلوب)","cause":"الإيمان والعمل الصالح","result":"الودّ (المحبة في القلوب)","explicit":true,"otherNeedIds":[23],"ref":"سورة مريم: 96","srcLabel":"القرآن الكريم","quran":{"s":19,"from":96,"to":96,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَيَجْعَلُ لَهُمُ الرَّحْمَنُ وُدًّا (96)","hl":[[0,85,1]]}},{"id":"س-00186","fp":"b61b6ce57d56","stateId":393,"easy":"إذا حسن ذكرك في السماء ← يوضع لك في الأرض","cause":"فإنْ كان صِيتُهُ في السماءِ حَسَنًا","result":"وُضِعَ في الأرْضِ","explicit":true,"ref":"صحيح الجامع 5732","srcLabel":"الطبراني","text":["ما من عبدٍ إِلَّا ولهُ صِيتٌ في السماءِ ، ",["فإنْ كان صِيتُهُ في السماءِ حَسَنًا",1]," ، ",["وُضِعَ في الأرْضِ",2]," ، و إنْ كان صِيتُهُ في السماءِ سيِّئًا ، وُضِعَ في الأرْضِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البزار (9202)، والطبراني في ((المعجم الأوسط)) (5248)، وابن عدي في ((الكامل في الضعفاء)) (2/163) باختلاف يسير.","bab":"آداب الكلام › الثناء الحسن","dorar":"cDEQM80a","merged":2,"otherRefs":["معجم الشيوخ 2/752 (حسن)"]},{"id":"س-00250","fp":"f811397eab07","stateId":393,"easy":"إذا كنت مؤمناً ← تألف وتُؤلف","cause":"يألفُ ويُؤلفُ","result":"المؤمنُ","explicit":true,"ref":"الجامع الصغير 9127","srcLabel":"أحمد","text":[["المؤمنُ",2]," ",["يألفُ ويُؤلفُ",1],"،   ولا خيرَ فيمنْ لا يألفُ و لايؤلفُ"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه الروياني في ((مسنده)) (1048)، والبيهقي في ((الآداب)) (159) واللفظ لهما، وأحمد (22840) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"2JHlVhUX"},{"id":"س-04729","fp":"51eaedd75316","stateId":393,"easy":"إذا عملت الخير فحمدك الناس عليه ← فتلك عاجل بشرى المؤمن","cause":"يَعمَلُ العَمَلَ مِنَ الخَيرِ ويَحمَدُه النَّاسُ عليه","result":"تلك عاجِلُ بُشرى المُؤمِنِ","explicit":true,"similar":["س-02107","س-02106"],"ref":"صحيح مسلم 2642","srcLabel":"ابن ماجه","text":["قيلَ لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم: أرَأيتَ الرَّجُلَ ",["يَعمَلُ العَمَلَ مِنَ الخَيرِ ويَحمَدُه النَّاسُ عليه",1],"؟ قال: ",["تلك عاجِلُ بُشرى المُؤمِنِ",2],". وفي روايةٍ: ويُحِبُّه النَّاسُ عليه."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"أخرجه ابن ماجه (4225)، وأحمد (21400)، وابن حبان (366) جميعهم بلفظ مقارب.","bab":"رقائق وزهد › الإخلاص","dorar":"tuoT8FcJ"},{"id":"س-05613","fp":"e6e169de1fc7","stateId":393,"easy":"إذا زهدت فيما في أيدي الناس ← يحبك الناس","cause":"وازهد فيما في أيدي النَّاسِ","result":"يحبُّوكَ","explicit":true,"ref":"صحيح ابن ماجه 3326","srcLabel":"الطبراني","text":["يا رسولَ اللَّهِ دلَّني على عَملٍ إذا أَنا عَمِلْتُهُ أحبَّني اللَّهُ وأحبَّني النَّاسُ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ازهَد في الدُّنيا يحبَّكَ اللَّهُ ",["وازهد فيما في أيدي النَّاسِ",1]," ",["يحبُّوكَ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"صحيح","takhrij":"أخرجه أبو عبيد في ((الخطب والمواعظ)) (131) والطبراني (5972) بلفظه.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"pJKVGlLe"},{"id":"س-05347","fp":"6b6cf52481cf","stateId":393,"easy":"إذا تودّدت إلى الناس ← فالتودد نصف العقل","cause":"والتودُّدُ","result":"نصفُ العقلِ","explicit":true,"ref":"شرح كتاب الشهاب 45","srcLabel":"القضاعي","text":["التدبيرُ نصفُ العيشِ ",["والتودُّدُ",1]," ",["نصفُ العقلِ",2]," والهمُّ نصفُ الهرَمِ وقلةُ العيالِ أحدُ اليسارَينِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في((مسند الشهاب)) (32 )","bab":"رقائق وزهد › التوكل واليقين","dorar":"ZQDhnE8o"},{"id":"س-07570","fp":"c03f5b18fd6b","stateId":393,"easy":"إذا اجتمعتم على وضوئكم (طعامكم) ← يجمع الله شملكم","cause":"اجمَعوا وُضوءَكم","result":"جَمَع اللهُ شَملَكم","explicit":true,"ref":"فيض القدير 108","srcLabel":"البيهقي","text":[["اجمَعوا وُضوءَكم",1]," ",["جَمَع اللهُ شَملَكم",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"جيد.","takhrij":"أخرجه البيهقي في ((الشعب)) (5433)، والقضاعي في ((مسند الشهاب)) (702) بلفظه تامًا.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"snRV2XYw"},{"id":"س-02107","fp":"97c08e09e3e4","stateId":393,"easy":"إذا عملت الخير فحمدك الناس ← فذلك بشرى المؤمن","cause":"يعمَلُ العمَلَ مِن الخيرِ","result":"يحمَدُه النَّاسُ ؟ قال: ذلك بُشرى المؤمنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04729","otherNeedIds":[6],"ref":"تخريج صحيح ابن حبان 367","text":["قُلْتُ: يا رسولَ اللهِ أرأَيْتَ الرَّجلَ ",["يعمَلُ العمَلَ مِن الخيرِ",1]," ",["يحمَدُه النَّاسُ ؟ قال: ( ذلك بُشرى المؤمنِ",2]," )"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الصحيح","takhrij":"أخرجه ابن حبان (367) بلفظه، ومسلم (2642)، وابن ماجه (4225)، وأحمد (21400) جميعهم بلفظ مقارب.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"G3bOG1NP","merged":3,"otherRefs":["صحيح ابن ماجه 3423 (صحيح)","تخريج صحيح ابن حبان 5768 (صحيح)"]},{"id":"س-02106","fp":"6bd02c0700b3","stateId":393,"easy":"إذا عملت لنفسك فأحبك الناس ← فتلك عاجل بشرى المؤمن","cause":"يعمَلُ لنفسِه","result":"ويُحِبُّه النَّاسُ ؟ قال: تلك عاجلُ بُشرى المؤمنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-04729","otherNeedIds":[6],"ref":"تخريج صحيح ابن حبان 366","text":["يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم - إنَّ الرَّجلَ ",["يعمَلُ لنفسِه",1]," ",["ويُحِبُّه النَّاسُ ؟ قال: ( تلك عاجلُ بُشرى المؤمنِ",2]," )"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط الصحيح","takhrij":"أخرجه ابن حبان (366) بلفظه، ومسلم (2642)، وابن ماجه (4225)، وأحمد (21400) جميعهم بلفظ مقارب.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"uTaKrBlM"},{"id":"س-00247","fp":"88110e0d4687","stateId":393,"easy":"إذا بسطت وجهك وحسّنت خلقك ← تسع الناس","cause":"بسطُ الوجْهِ ، وحسنُ الخلُقِ","result":"ولكِنْ لِيَسَعْهُمْ منكُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-00277"],"ref":"الجامع الصغير 2530","srcLabel":"الحاكم","text":["إِنَّكم لا تَسَعُونَ الناسَ بأمْوالِكم ، ",["ولكِنْ لِيَسَعْهُمْ منكُمْ",2]," ",["بسطُ الوجْهِ ، وحسنُ الخلُقِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((مكارم الأخلاق)) (18) واللفظ له، والحاكم (427)، والبيهقي في ((شعب الإيمان)) (8054) باختلاف يسير","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"1vOxE0Pb"},{"id":"س-00277","fp":"8ab35e80c639","stateId":393,"easy":"إذا بسطت وجهك وحسّنت خلقك ← تسع الناس وإن لم تسعهم بمالك","cause":"بَسْطُ الوَجْهِ، وحُسْنُ الخُلُقِ","result":"ولكن يَسَعُهم مِنكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00247","ref":"الأحكام الوسطى 4/ 257","text":["\"إنَّكم لن تَسَعوا النَّاسَ بأمْوالِكم، ",["ولكن يَسَعُهم مِنكم",2]," ",["بَسْطُ الوَجْهِ، وحُسْنُ الخُلُقِ",1],"\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن أبي شيبة (25842)، والبزار (8544)، وابن عدي في ((الكامل في الضعفاء)) (4/ 163) بلفظه.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"fRFUU2tF"},{"id":"ق-0763","fp":"92057b2ea263","stateId":393,"easy":"القول اللين في الدعوة ← رجاء التذكر والخشية","cause":"القول اللين في الدعوة","result":"رجاء التذكر والخشية","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"ref":"سورة طه: 44","srcLabel":"القرآن الكريم","quran":{"s":20,"from":44,"to":44,"text":"فَقُولَا لَهُ قَوْلًا لَيِّنًا لَعَلَّهُ يَتَذَكَّرُ أَوْ يَخْشَى (44)","hl":[[0,65,1]]}},{"id":"س-08069","fp":"9e6d3b998ca1","stateId":393,"easy":"إذا كثرت صلاتك بالليل ← يحسن وجهك بالنهار","cause":"مَن كثرَت صلاتُهُ باللَّيلِ","result":"حَسُنَ وجهُهُ بالنَّهارِ","explicit":true,"ref":"المدخل إلى معرفة كتاب الإكليل 125","srcLabel":"ابن ماجه","text":[["مَن كثرَت صلاتُهُ باللَّيلِ ",1],["حَسُنَ وجهُهُ بالنَّهارِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"ليس لهذا الحديث أصل إلا من هذا الوجه ، وعن قوم من المجروحين سرقوه من ثابت بن موسى فرووه عن شريك","takhrij":"أخرجه ابن ماجه (1333)، ومحمد بن نصر المروزي في ((قيام الليل)) كما في ((مختصر قيام الليل))(ص58)، والعقيلي في ((الضعفاء الكبير)) (1/ 176) بلفظه.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"uJ6mtTbH"},{"id":"س-04604","fp":"69f005f5620f","stateId":394,"easy":"إذا مررت بقبر من تعرفه فسلّمت عليه ← يرد الله عليه روحه فيرد عليك السلام","cause":"وما من رجُلٍ يمرُّ بقبرِ الرَّجلِ كانَ يعرفُهُ في الدُّنيا فيسلِّمُ عليْهِ","result":"إلَّا ردَّ اللَّهُ عليْهِ روحَهُ حتَّى يردَّ عليْهِ السَّلامَ","explicit":true,"star":true,"ref":"مجموع الفتاوى 24/173","srcLabel":"مجموع الفتاوى","text":[["وما من رجُلٍ يمرُّ بقبرِ الرَّجلِ كانَ يعرفُهُ في الدُّنيا فيسلِّمُ عليْهِ",1]," ",["إلَّا ردَّ اللَّهُ عليْهِ روحَهُ حتَّى يردَّ عليْهِ السَّلامَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"دفن ومقابر › أحوال الميت في القبر","dorar":"az7yPhKy"},{"id":"س-05848","fp":"28bc32fa0b98","stateId":394,"easy":"إذا تهاديتم ← تذهب الهدية الضغينة","cause":"والهديةُ","result":"تُذْهِبُ السخيمةَ","explicit":true,"ref":"الإصابة في تمييز الصحابة 1/584","srcLabel":"أبو موسى","text":["تهادَوْا وتزاوَروا [يعني حديث: تزاوَرُوا وتهادُوا فإنَّ الزيارةَ تُنْبِتُ الوُدَّ، ",["والهديةُ",1]," ",["تُذْهِبُ السخيمةَ",2],"]"],"grade":"حسن","narrator":"زعبل","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أبو موسى كما في ((أسد الغابة)) (2/ 318) واللفظ له.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wfmZ5puV"},{"id":"ق-0148","fp":"4905ffa88131","stateId":394,"easy":"الاعتصام بحبل الله جميعاً وترك التفرق ← تأليف القلوب والأخوّة والنجاة من النار والهداية","cause":"الاعتصام بحبل الله جميعاً وترك التفرق","result":"تأليف القلوب والأخوّة والنجاة من النار والهداية","explicit":true,"star":true,"otherNeedIds":[15],"ref":"سورة آل عمران: 103","srcLabel":"القرآن الكريم","quran":{"s":3,"from":103,"to":103,"text":"وَاعْتَصِمُوا بِحَبْلِ اللَّهِ جَمِيعًا وَلَا تَفَرَّقُوا وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ إِذْ كُنْتُمْ أَعْدَاءً فَأَلَّفَ بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُمْ بِنِعْمَتِهِ إِخْوَانًا وَكُنْتُمْ عَلَى شَفَا حُفْرَةٍ مِنَ النَّارِ فَأَنْقَذَكُمْ مِنْهَا كَذَلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَهْتَدُونَ (103)","hl":[[0,325,1]]}},{"id":"ق-0485","fp":"471d2f5b42d7","stateId":394,"easy":"التوبة وإقامة الصلاة وإيتاء الزكاة ← الأخوّة في الدين","cause":"التوبة وإقامة الصلاة وإيتاء الزكاة","result":"الأخوّة في الدين","explicit":true,"star":true,"otherNeedIds":[11],"ref":"سورة التوبة: 11","srcLabel":"القرآن الكريم","quran":{"s":9,"from":11,"to":11,"text":"فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَإِخْوَانُكُمْ فِي الدِّينِ وَنُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ (11)","hl":[[0,129,1]]}},{"id":"ق-1173","fp":"f34ed3c1ae92","stateId":394,"easy":"الخلّة على التقوى ← بقاء المودة يوم القيامة","cause":"الخلّة على التقوى","result":"بقاء المودة يوم القيامة","explicit":true,"star":true,"otherNeedIds":[65],"ref":"سورة الزخرف: 67","srcLabel":"القرآن الكريم","quran":{"s":43,"from":67,"to":67,"text":"الْأَخِلَّاءُ يَوْمَئِذٍ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا الْمُتَّقِينَ (67)","hl":[[53,73,1]]}},{"id":"س-00131","fp":"9bf9b29a909c","stateId":394,"easy":"إذا أفشيتم السلام بينكم ← تحاببتم","cause":"أفشُوا السَّلامَ بينكم","result":"إذا فعَلْتُموه تحابَبْتُم","explicit":true,"ref":"الجامع الصغير 4154","srcLabel":"الترمذي","text":["دبَّ إليكم داءُ الأُمَمِ: الحسَدُ والبَغضاءُ، هي الحالِقةُ حالِقةُ الدِّينِ لا حالِقةُ الشَّعرِ، والذي نفسي بيَدِه، لا تدخُلوا الجنَّةَ حتى تُؤمِنوا، ولا تؤمِنوا حتى تحابُّوا، أفلا أنبِّئُكم بشيءٍ ",["إذا فعَلْتُموه تحابَبْتُم",2],"؟ ",["أفشُوا السَّلامَ بينكم",1],"."],"grade":"صحيح","narrator":"الزبير بن العوام","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1412)، والبيهقي (21107)  واللفظ لهما، والترمذي (2510) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"6qVilY5D","merged":3,"otherRefs":["صحيح الجامع 7081 (صحيح)","الأحاديث المختارة 890 (صحيح)"]},{"id":"س-00141","fp":"ccb7c543371d","stateId":394,"easy":"إذا أفشيت السلام ← تتحابون","cause":"أفْشُوا السَّلامَ بيْنَكم","result":"تَحابُّوا","explicit":true,"similar":["س-00135"],"ref":"المستدرك على الصحيحين 7516","srcLabel":"النسائي","text":["لنْ تُؤمِنوا حتَّى تَحابُّوا، أفلا أدُلُّكم على ما تَحابُّوا عليه؟ قالوا: بلى يا رسولَ اللهِ، قالَ: ",["أفْشُوا السَّلامَ بيْنَكم ",1],["تَحابُّوا",2],"، والَّذي نفْسِي بيَدِه، لا تَدخُلُوا الجنَّةَ حتَّى تَراحَمُوا، قالوا: يا رسولَ اللهِ، كُلُّنا رَحيمٌ، قالَ: إنَّه ليسَ برَحمةِ أحدِكم، ولكِنْ رَحمةُ العامَّةِ، رَحمةُ العامَّةِ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (5928) واللفظ له.","bab":"آداب السلام › إفشاء السلام","dorar":"IdRRzV45","merged":2,"otherRefs":["صحيح الأدب المفرد 197 (حسن)"]},{"id":"س-01368","fp":"1f045e4191da","stateId":394,"easy":"إذا تهاديتم ← تذهب الهدية ضغينة الصدر","cause":"تَهادَوا","result":"فإنَّ الهَديَّةَ تُذهِبُ وَحَرَ الصَّدْرِ","explicit":true,"ref":"الأحكام الوسطى 3/ 314","srcLabel":"الترمذي","text":[["تَهادَوا؛ ",1],["فإنَّ الهَديَّةَ تُذهِبُ وَحَرَ الصَّدْرِ",2],"، ولا تَحقِرَنَّ جارةٌ لِجارتِها ولو [شِقَّ] فِرْسِنَ شاةٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (2130)، والحسين بن حرب في ((البر والصلة)) (235)، وابن أبي الدنيا في ((مكارم الأخلاق)) (359) بلفظه.","bab":"هبة وهدية › قبول الهدية","dorar":"z6EYftQV"},{"id":"س-03790","fp":"7333989553b3","stateId":394,"easy":"إذا زرت غِبّاً ← تزدد حباً","cause":"زُرْ غِبًّا","result":"تَزْدَدْ حُبًّا","explicit":true,"ref":"مجمع الزوائد 8/178","srcLabel":"الطيالسي","text":["يا أبا هريرةَ ",["زُرْ غِبًّا ",1],["تَزْدَدْ حُبًّا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"لا يعلم فيه حديث صحيح","takhrij":"أخرجه الطيالسي في ((المسند)) (2658)، والبزار (9315)، والعقيلي في ((الضعفاء الكبير)) (2/138)","bab":"بر وصلة › إكرام الزائر","dorar":"6cFdmmKX"},{"id":"س-05387","fp":"50ca90187d8a","stateId":394,"easy":"إذا أحببت أخاك فأعلمه ← يجد لك مثل ما عندك","cause":"إذا أحبَّ أحدُكم أخاه فلْيُعلمْه","result":"فإنه يجٍدُ له مثلَ الذي عنده","explicit":true,"ref":"السلسلة الصحيحة 1/947","srcLabel":"الطبراني","text":[["إذا أحبَّ أحدُكم أخاه فلْيُعلمْه ",1],["فإنه يجٍدُ له مثلَ الذي عنده",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (13/207) (13927)، والقضاعي في ((مسند الشهاب)) (765)، والبيهقي في ((شعب الإيمان)) (9010) واللفظ له","bab":"رقائق وزهد › الحب في الله","dorar":"1qmQXmW2"},{"id":"س-05930","fp":"da390a1406fb","stateId":394,"easy":"إذا وصلت رحمك ← تزيد المحبة في الأهل والمال والأثر","cause":"صلةَ الرحِمِ","result":"مَحَبَّةٌ في الأهلِ، مَثْرَاةٌ في المالِ، مَنْسَأَةٌ في الأَثَرِ","explicit":true,"otherNeedIds":[1,36],"ref":"هداية الرواة 4862","srcLabel":"الترمذي","text":["تَعَلَّموا من أنسابِكم ما تَصِلُونَ به أرحامَكم ؛ فإن ",["صلةَ الرحِمِ",1]," ",["مَحَبَّةٌ في الأهلِ، مَثْرَاةٌ في المالِ، مَنْسَأَةٌ في الأَثَرِ ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1979)، وأحمد (8855)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"5efD6FnY"},{"id":"س-00315","fp":"645e2cec0b20","stateId":394,"easy":"إذا تهاديت ← فالهدية صلة بين الناس","cause":"بالهديَّةِ","result":"صِلَةً بَيْنَ الناسِ","explicit":true,"ref":"مجمع الزوائد 4/149","srcLabel":"الطبراني","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَأْمُرُ ",["بالهديَّةِ",1]," ",["صِلَةً بَيْنَ الناسِ",2]," ويقولُ لو قَدْ أَسْلَمَ الناسُ تهادَوُا مِنْ غَيْرِ جوعٍ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"فيه سعيد بن بشير وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (1/260) (760) باختلاف يسير، وأبو الشيخ في ((أخلاق النبي)) (746)، وتمام في ((الفوائد)) (1002) مطولاً","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"g1VS57xw"},{"id":"س-05393","fp":"12f45666e093","stateId":394,"easy":"إذا أحببت أخاك فأخبره ← تثبت المودة بينكما","cause":"قُمْ فأَخبِرْهُ","result":"تَثْبُتِ المَودَّةُ بيْنكما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 13535","srcLabel":"أبو داود","text":["مَرَّ رجُلٌ بالنَّبيِّ صلَّى اللهُ عليه وسلَّم وعِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم رجُلٌ جالِسٌ، فقال الرَّجُلُ: واللهِ يا رسولَ اللهِ، إنِّي لَأُحِبُّ هذا في اللهِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أخبَرْتَه بذلك؟ قال: لا، قال: ",["قُمْ فأَخبِرْهُ",1],"؛ ",["تَثْبُتِ المَودَّةُ بيْنكما",2],". فقام إليه فأخبَرَه، فقال: إنِّي أُحِبُّك في اللهِ، أو قال: أُحِبُّك للهِ، فقال الرَّجُلُ: أَحَبَّك الذي أحبَبْتَني فيه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5125)، والنسائي في ((السنن الكبرى)) (10010)، وأحمد (13535) واللفظ له","bab":"رقائق وزهد › الحب في الله","dorar":"6iKj1KC2"},{"id":"س-05847","fp":"01ac2e51696b","stateId":394,"easy":"إذا تزاورتم ← تنبت الزيارة الود","cause":"الزيارةَ","result":"تُنْبِتُ الوُدَّ","explicit":true,"ref":"الإصابة في تمييز الصحابة 1/584","srcLabel":"أبو موسى","text":["تهادَوْا وتزاوَروا [يعني حديث: تزاوَرُوا وتهادُوا فإنَّ ",["الزيارةَ",1]," ",["تُنْبِتُ الوُدَّ",2],"، والهديةُ تُذْهِبُ السخيمةَ]"],"grade":"حسن","narrator":"زعبل","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أبو موسى كما في ((أسد الغابة)) (2/ 318) واللفظ له.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wfmZ5puV"},{"id":"س-05924","fp":"f9d43d7ea674","stateId":394,"easy":"إذا تصافحتم وتهاديتم ← يذهب الغل وتتحابون","cause":"تصافَحوا","result":"يَذهبِ الغِلُّ وتَهادوا تحابُّوا تذهبِ السَّخائِمُ","explicit":true,"otherNeedIds":[19],"ref":"المقاصد الحسنة 199","srcLabel":"مالك","text":[["تصافَحوا ",1],["يَذهبِ الغِلُّ وتَهادوا تحابُّوا تذهبِ السَّخائِمُ",2]],"grade":"حسن","narrator":"عطاء بن أبي مسلم الخراساني","muhaddith":"جيد","takhrij":"أخرجه مالك في ((الموطأ)) (2/908)، وابن وهب في ((الجامع)) (247) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FESbJT08"},{"id":"س-05935","fp":"81bd75828e7f","stateId":394,"easy":"إذا تهاديتم ← تحاببتم","cause":"تهادَوْا","result":"تحابُّوا","explicit":true,"ref":"مختصر المقاصد 328","srcLabel":"الطبراني","text":[["تهادَوْا ",1],["تحابُّوا ",2],"[وهاجِروا تُورِّثوا أولادَكم مَجدًا وأقِيلوا الكِرامَ عَثَراتِهم]"],"grade":"حسن","narrator":"[عائشة أم المؤمنين]","muhaddith":"حسن","takhrij":"أخرجه مطولاً ابن أبي الدنيا في ((مكارم الأخلاق)) (363)، والديلمي في ((الفردوس)) (2268) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (7240) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"HhN50Pxo"},{"id":"س-00135","fp":"eec57c4c972a","stateId":394,"easy":"إذا أفشيت السلام ← تتحابون","cause":"أَفشوا السلامَ بينَكم","result":"ألا أدلُّكم على ما تحابُّون به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-00141","otherNeedIds":[67],"ref":"صحيح الأدب المفرد 751","text":["لا تدخلوا الجنةِ حتى تؤمِنوا ، و لا تؤمنوا حتى تحابُّوا ، ",["ألا أدلُّكم على ما تحابُّون به",2]," ؟ قالوا : بلى ، يا رسولَ اللهِ ، قال : ",["أَفشوا السلامَ بينَكم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (54)، والبخاري في ((الأدب المفرد)) (980) واللفظ له","bab":"آداب السلام › إفشاء السلام","dorar":"qc3KHBM4"},{"id":"س-08327","fp":"d9d772833fe5","stateId":394,"easy":"إذا واسيت إخوانك عند الحاجة فاقتسمتم ما عندكم ← فأنتم من النبي ﷺ وهو منكم","cause":"جَمَعوا ما كانَ عِندَهم في ثَوبٍ واحِدٍ، ثُمَّ اقتَسَموه بينَهم في إناءٍ واحِدٍ بالسَّويَّةِ","result":"فهُم مِنِّي وأنا منهم","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"otherNeedIds":[23],"ref":"صحيح مسلم 2500","srcLabel":"البخاري","text":["إنَّ الأشعَريِّينَ إذا أرمَلوا في الغَزوِ أو قَلَّ طَعامُ عيالِهم بالمَدينةِ، ",["جَمَعوا ما كانَ عِندَهم في ثَوبٍ واحِدٍ، ثُمَّ اقتَسَموه بينَهم في إناءٍ واحِدٍ بالسَّويَّةِ",1],"، ",["فهُم مِنِّي وأنا منهم",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2486)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"Sx6vrijS"},{"id":"س-07563","fp":"50781d3bbcf5","stateId":394,"easy":"إذا أزلت عن أخيك أذى ← نزع الله عنك ما تكره","cause":"فابتدَرَ إليهِ أبو أيُّوبَ فأخذَها","result":"نزَعَ اللَّهُ عنكَ ما تكرَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[29],"ref":"در السحابة 343","srcLabel":"الحاكم","text":["كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يطوفُ بينَ الصَّفا والمروةِ فسقَطت على لحيتِهِ ريشةٌ ",["فابتدَرَ إليهِ أبو أيُّوبَ فأخذَها",1]," فقالَ لهُ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ",["نزَعَ اللَّهُ عنكَ ما تكرَهُ",2]],"grade":"حسن","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه الطبراني في ((الكبير)) (4/ 172) (4048) واللفظ له، والحاكم (5943)، وابن الجوزي في ((العلل المتناهية)) (1212) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"izbaxRLH"},{"id":"س-05899","fp":"aef411ccc3fc","stateId":395,"easy":"إذا طبخت فأكثر المرق ← فهو أوسع للجيران","cause":"أُكثِرَ مَرَقَتَها","result":"فإنَّه أوسَعُ للجيرانِ","explicit":true,"star":true,"similar":["س-05877"],"otherNeedIds":[37],"ref":"تخريج المسند لشعيب 21381","srcLabel":"مسلم","text":["أَوْصاني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا طبَخْتُ قِدرًا أنْ ",["أُكثِرَ مَرَقَتَها",1],"؛ ",["فإنَّه أوسَعُ للجيرانِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (1833) بنحوه، وأحمد (21381) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"1w6KbFJF","merged":3,"otherRefs":["صحيح الجامع 677 (صحيح)","تخريج المسند لشعيب 15030 (صحيح)"]},{"id":"س-05877","fp":"83594c181b63","stateId":395,"easy":"إذا طبخت مرقاً فأكثر ماءه ← فهو أوسع للأهل والجيران","cause":"إذا طبَخْتَ قِدرًا فأكثِرْ مَرقتَها","result":"فإنَّه أوسَعُ للأهلِ والجيرانِ","explicit":true,"repOf":"س-05899","ref":"تخريج صحيح ابن حبان 513","text":[["إذا طبَخْتَ قِدرًا فأكثِرْ مَرقتَها ",1],["فإنَّه أوسَعُ للأهلِ والجيرانِ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2625) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"CbqW9HoW"},{"id":"س-06053","fp":"89d89fc14469","stateId":396,"easy":"إذا صبرت عند الغضب وعفوت عند الإساءة ← يعصمك الله ويخضع لك عدوك","cause":"الصَّبرُ عند الغضبِ والعفوُ عند الإساءةِ","result":"عصَمهم اللهُ وخضع لهم عدوُّهم","explicit":true,"ref":"الترغيب والترهيب 3/385","srcLabel":"الترغيب والترهيب","text":["عن ابنِ عبَّاس ٍ رضِي اللهُ عنهما في قولِه { ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ } قال ",["الصَّبرُ عند الغضبِ والعفوُ عند الإساءةِ",1]," فإذا فعلوا ",["عصَمهم اللهُ وخضع لهم عدوُّهم",2]],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"رقائق وزهد › فضل الصبر","dorar":"TJrEzL8S"},{"id":"س-08021","fp":"658f68a2913a","stateId":396,"easy":"إذا أصلحتم ذات بينكم ← يصلح الله بين المسلمين","cause":"وأصْلِحوا ذاتَ بيْنِكم","result":"فإنَّ اللهَ تعالَى يُصلِحُ بيْن المسْلِمين","explicit":true,"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 8944","srcLabel":"البيهقي","text":["بيْنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالسٌ، إذ رَأيناهُ ضَحِك حتَّى بَدَت ثَناياهُ، فقال له عُمرُ: ما أضْحَكَكَ يا رَسولَ اللهِ، بأبي أنتَ وأُمِّي؟ قال: رجُلانِ مِن أُمَّتي جَثَيَا بيْن يَدَي ربِّ العِزَّةِ، فقال أحدُهما: يا ربِّ، خُذْ لي مَظْلَمتي مِن أخي، فقال اللهُ تَباركَ وتعالَى للطَّالبِ: فكيْف تَصنَعُ بأخيكَ ولم يَبْقَ مِن حَسَناتِه شَيءٌ؟ قال: يا ربِّ، فلْيَحمِلْ مِن أوْزاري، قال: وفاضَتْ عَيْنا رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالبُكاءِ، ثمَّ قال: إنَّ ذاك اليومَ عَظيمٌ، يَحتاجُ النَّاسُ أنْ يُحمَلَ عنْهم مِن أوزارِهم، فقال اللهُ تعالَى للطَّالبِ: ارفَعْ بَصَرَك فانْظُرْ في الجِنانِ، فرَفَع رأْسَه، فقال: يا ربِّ، أرى مَدائنَ مِن ذهَبٍ، وقُصورًا مِن ذهَبٍ مُكلَّلةً باللُّؤلؤِ، لأيِّ نَبيٍّ هذا، أو لأيِّ صدِّيقٍ هذا، أو لأيِّ شَهيدٍ هذا؟ قال: هذا لمَن يُعطي الثَّمنَ، قال: يا ربِّ، ومَن يَملِكُ ذلكَ؟ قال: أنتَ تَملِكُه، قال: بماذا؟ قال: بعَفوِك عن أخيكَ، قال: يا ربِّ، فإنِّي قدْ عفَوتُ عنه، قال اللهُ عزَّ وجلَّ: فخُذْ بيَدِ أخيكَ فأدْخِلْه الجنَّةَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عِندَ ذلكَ: اتَّقُوا اللهَ ",["وأصْلِحوا ذاتَ بيْنِكم",1],"؛ ",["فإنَّ اللهَ تعالَى يُصلِحُ بيْن المسْلِمين",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه البيهقي في ((البعث والنشور)) (393)، وابن أبي الدنيا في ((حسن الظن)) (118) بنحوه، والخرائطي في ((مساوئ الأخلاق )) (602) مختصرا","bab":"مظالم › تحريم الظلم","dorar":"4IyacTvF"},{"id":"ق-0711","fp":"7b4478493104","stateId":396,"easy":"قول التي هي أحسن ← قطع نزغ الشيطان بين الناس","cause":"قول التي هي أحسن","result":"قطع نزغ الشيطان بين الناس","explicit":true,"star":true,"otherNeedIds":[31],"ref":"سورة الإسراء: 53","srcLabel":"القرآن الكريم","quran":{"s":17,"from":53,"to":53,"text":"وَقُلْ لِعِبَادِي يَقُولُوا الَّتِي هِيَ أَحْسَنُ إِنَّ الشَّيْطَانَ يَنْزَغُ بَيْنَهُمْ إِنَّ الشَّيْطَانَ كَانَ لِلْإِنْسَانِ عَدُوًّا مُبِينًا (53)","hl":[[0,88,1]]}},{"id":"ق-1136","fp":"29de2ebd0982","stateId":396,"easy":"دفع السيئة بالتي هي أحسن والصبر ← انقلاب العدو ولياً حميماً","cause":"دفع السيئة بالتي هي أحسن والصبر","result":"انقلاب العدو ولياً حميماً","explicit":true,"ref":"سورة فصلت: 34–35","srcLabel":"القرآن الكريم","quran":{"s":41,"from":34,"to":35,"text":"وَلَا تَسْتَوِي الْحَسَنَةُ وَلَا السَّيِّئَةُ ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ فَإِذَا الَّذِي بَيْنَكَ وَبَيْنَهُ عَدَاوَةٌ كَأَنَّهُ وَلِيٌّ حَمِيمٌ (34) وَمَا يُلَقَّاهَا إِلَّا الَّذِينَ صَبَرُوا وَمَا يُلَقَّاهَا إِلَّا ذُو حَظٍّ عَظِيمٍ (35)","hl":[[47,242,1]]}},{"id":"س-07199","fp":"e28b3ba7bd95","stateId":397,"easy":"إذا أعطيت مرضعتك عبداً أو أمة ← تذهب عنك مذمة الرضاع","cause":"غرةٌ عبدٌ أو أمةٌ","result":"ما يذهب عني مذمةِ الرضاعِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سنن الترمذي 1153","srcLabel":"أبو داود","text":["أنه سأل النبيَّ صلَّى اللهُ عليهِ وسلَّمَ فقال يا رسولَ اللهِ ",["ما يذهب عني مذمةِ الرضاعِ",2]," فقال ",["غرةٌ عبدٌ أو أمةٌ",1]],"grade":"صحيح","narrator":"حجاج الأسلمي","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (2064)، والنسائي (3329) بلفظه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"prnRoqRx"},{"id":"س-00448","fp":"c597b096f2e0","stateId":397,"easy":"إذا أثنيت على من أحسن إليك ← فقد شكرته","cause":"إذا أثْنى عليه","result":"فقد شكَرَه","explicit":true,"star":true,"similar":["س-00544","س-05506"],"ref":"تخريج شرح السنة 3609","srcLabel":"البخاري","text":["مَن صُنِعَ إليه مَعْروفٌ، فلْيَجْزِ به؛ فإنْ لم يَجِدْ ما يَجْزي به، فلْيُثْنِ عليه؛ فإنَّه ",["إذا أثْنى عليه",1],"، ",["فقد شكَرَه",2],"، وإنْ كتَمَه، فقد كَفَرَه، ومَن تَحَلَّى بما لم يُعْطَ، كان كلابِسِ ثَوبَيْنِ من زُورٍ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح بطرقه","takhrij":"أخرجه البغوي في ((شرح السنة)) (13/ 186) واللفظ له، والبخاري في ((الأدب المفرد)) (215) باختلاف يسير، والترمذي (2034) بنحوه، وأبو داود (4813) مختصرًا.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"qXCJmr7W","merged":3,"otherRefs":["تخريج سنن أبي داود 4813 (حسن)","صحيح الأدب المفرد 157 (صحيح)"]},{"id":"س-00544","fp":"4b150450c963","stateId":397,"easy":"إذا ذكرت معروف من أحسن إليك ← فقد شكرته","cause":"فمَن ذكَرَه","result":"فقد شكَرَه","explicit":true,"repOf":"س-00448","ref":"تخريج المسند لشعيب 24593","text":["مَن أُتِيَ إليه معروفٌ، فلْيُكافئْ به، ومَن لم يَستَطِعْ، فلْيَذكُرْه، ",["فمَن ذكَرَه",1],"، ",["فقد شكَرَه",2],"، ومَن تشبَّعَ بما لم يَنلْ، فهو كلابسِ ثَوبَيْ زورٍ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"قوله: \"من تشبع بما لم ينل، فهو كلابس ثوبي زور\" صحيح وبقية الحديث حسن لغيره","takhrij":"أخرجه مسلم (2129)، والنسائي في ((السنن الكبرى)) (8920)، وأحمد (24593) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"Rr2pXS53","merged":2,"otherRefs":["الأحاديث المختارة 836 (صحيح)"]},{"id":"س-00189","fp":"78a4dbebb1c1","stateId":397,"easy":"إذا صُنع إليك معروف فقلت «جزاك الله خيراً» ← فقد أبلغت في الثناء","cause":"من صُنع إليه معروفٌ فقال لفاعلِه جزاك اللهُ خيرًا","result":"فقد أبلغ في الثَّناءِ","explicit":true,"apply":{"k":"say","t":"«جزاك الله خيراً»"},"ref":"الترغيب والترهيب 2/102","srcLabel":"الترمذي","text":[["من صُنع إليه معروفٌ فقال لفاعلِه جزاك اللهُ خيرًا",1]," ",["فقد أبلغ في الثَّناءِ",2]," وفي روايةٍ من أَولَى معروفًا أو أُسدِي إليه معروفٌ فقال للَّذي أسداه جزاك اللهُ خيرًا فقد أبلغ في الثَّناءِ"],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2035)، والنسائي في ((السنن الكبرى)) (10008)","bab":"آداب الكلام › الثناء الحسن","dorar":"NHHWVViw"},{"id":"س-05506","fp":"33a4e6371e0f","stateId":397,"easy":"إذا أثنيت ← فقد شكرت","cause":"من أثنَى","result":"فقد شكر","explicit":true,"repOf":"س-00448","ref":"الترغيب والترهيب 2/101","text":["من أُعطي عطاءً فوجد فليجزِ به فإن لم يجدْ فليُثْنِ فإنَّ ",["من أثنَى",1]," ",["فقد شكر",2]," ومن كتم فقد كفر ومن تحلَّى بما لم يُعطَ كان كلابسِ ثوبيْ زورٍ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (4813)، والترمذي (2034) باختلاف يسير","bab":"رقائق وزهد › الرياء والسمعة","dorar":"sqN17tBB"}]}