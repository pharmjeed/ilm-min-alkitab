{"schema":1,"kind":"sunan-chunk","version":"sunan-cb5af5731a1c","needId":59,"stateIds":[626],"items":[{"id":"س-06477","fp":"bb0f73386e0d","stateId":626,"easy":"إذا أراد أحد قتلك في الفتنة فألقِ طرف ردائك على وجهك ← يبوء هو بإثمك وإثمه","cause":"فأَلْقِ طائفةً من رِدائِكَ على وَجهِكَ","result":"يَبُؤْ بإثمِكَ وإثمِهِ","explicit":true,"star":true,"similar":["س-00224"],"ref":"تخريج المسند لشعيب 21445","srcLabel":"مسلم","text":["كُنْتُ خلفَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ حينَ خرَجْنا من حاشي المدينةِ، فقال: يا أبا ذَرٍّ، صَلِّ الصَّلاةَ لوَقتِها، وإنْ جِئْتَ وقد صَلَّى الإمامُ كُنْتَ قد أحرَزْتَ صلاتَك قبلَ ذلك، وإنْ جِئْتَ ولم يُصلِّ صلَّيْتَ معه، وكانت صلاتُكَ لكَ نافلةً، وكُنْتَ قد أحرَزْتَ صلاتَكَ، يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ جاعوا حتى لا تَبلُغَ مَسجِدَكَ منَ الجَهدِ، أو لا تَرجِعَ إلى فِراشِكَ منَ الجَهدِ، فكيف أنتَ صانعٌ؟ قال: قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَعفَّفْ، قال: يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ ماتوا حتى يكونَ البيتُ بالعَبدِ، فكيف أنتَ صانعٌ؟ قال: قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَصبِرُ، قال: يا أبا ذَرٍّ، أرَأيْتَ إنِ الناسُ قُتِلوا حتى تَغرَقَ حِجارةُ الزيْتِ منَ الدماءِ، كيف أنتَ صانعٌ؟ قُلْتُ: اللهُ ورسولُه أعلَمُ، قال: تَدخُلُ بيتَكَ، قُلْتُ: يا رسولَ اللهِ، فإنْ أنا دُخِلَ عليَّ؟ قال: تَأْتي مَن أنتَ منه، قال: قُلْتُ: وأحمِلُ السلاحَ؟ قال: إذا شارَكْتَ، قال: قُلْتُ: كيف أصنَعُ يا رسولَ اللهِ؟ قال: إنْ خِفْتَ أنْ يَبهَرَكَ شُعاعُ السيفِ، ",["فأَلْقِ طائفةً من رِدائِكَ على وَجهِكَ",1],"، ",["يَبُؤْ بإثمِكَ وإثمِهِ",2],"."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (648)، وأبو داود (431)، والترمذي (176)، وابن ماجه (1256) مختصراً، وأحمد (21445) واللفظ له","bab":"صلاة › فضل أول الوقت","dorar":"TRJG5AII","merged":2,"otherRefs":["المستدرك على الصحيحين 2702 (صحيح)"]},{"id":"س-00224","fp":"5cf783fd3a75","stateId":626,"easy":"إذا أراد أحد قتلك في الفتنة فألقِ رداءك على وجهك ← يبوء هو بإثمه وإثمك","cause":"فألقِ طرفَ ردائِكَ على وجهِكَ","result":"حتَّى يبوءَ بإثمِهِ وإثمِكَ","explicit":true,"repOf":"س-06477","ref":"الصحيح المسند 269","text":["رَكِبَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ حمارًا وأردفَني خلفَهُ ، وقالَ : يا أبا ذرٍّ أرأيتَ إن أصابَ النَّاسَ جوعٌ شديدٌ لا تستطيعُ أن تقومَ من فِراشِكَ إلى مسجدِكَ ، كيفَ تَصنعُ ؟ قالَ : اللَّهُ ورسولُهُ أعلمُ . قالَ : تعفَّفْ يا أبا ذرٍّ ، أرأيتَ إن أصابَ النَّاسَ مَوتٌ شديدٌ يَكونُ البيتُ فيهِ بالعَبدِ ، يعني القبرَ ، كيفَ تصنعُ ؟ قلتُ : اللَّهُ ورسولُهُ أعلمُ . قالَ : أصبر قالَ : يا أبا ذرٍّ ، أرأيتَ إن قَتلَ النَّاسُ بَعضُهُم بعضًا ، يعني حتَّى تغرقَ حجارةُ الزَّيتِ منَ الدِّماءِ ، كيفَ تصنعُ ؟ قالَ : اللَّهُ ورسولُهُ أعلمُ . قالَ : اقعُد في بيتِكَ ، واغلق بابَكَ قالَ : فإن لم أُترَكْ ؟ قالَ : فائتِ مَن أنتَ منهُم ، فَكُن فيهم قالَ : فآخذُ سلاحي ؟ قالَ : إذًا تشارِكَهُم فيما هم فيهِ ، ولَكِن إن خشيتَ أن يَروعَكَ شعاعُ السَّيفِ ، ",["فألقِ طرفَ ردائِكَ على وجهِكَ",1]," ",["حتَّى يبوءَ بإثمِهِ وإثمِكَ",2]," ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21363)، وابن حبان (6685).","bab":"آداب المجلس › الركوب على الدابة","dorar":"Ng9nDRIi"},{"id":"س-02369","fp":"cfb3815c8762","stateId":626,"easy":"إذا جاءك من يقتلك في الفتنة فكفّ يدك ← تكون المقتول في الجنة والقاتل في النار","cause":"إذا مشى الرجلُ من أمتي إلى الرجلِ ليقتلَه فليقلْ هكذا","result":"فالمقتولُ في الجنةِ والقاتلُ في النارِ","explicit":true,"otherNeedIds":[70],"ref":"تخريج المسند لشاكر 8/65","srcLabel":"أبو داود","text":["كنت أمشى معَ عبدِ اللهِ بنِ عمرَ فإذا نحن برأسٍ منصوبٍ على خشبةٍ قال فقال شقي قاتلُ هذا قال قلت أنت تقولُ هذا يا أبا عبدِ الرحمنِ قال فشدَّ يدَه من يدي وقال أبو عبدِ الرحمنِ سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  يقولُ ",["إذا مشى الرجلُ من أمتي إلى الرجلِ ليقتلَه فليقلْ هكذا ",1],["فالمقتولُ في الجنةِ والقاتلُ في النارِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4260) واللفظ له، وأبو يعلى (5732)، وأبو نعيم في ((حلية الأولياء)) (8/ 250) بنحوه.","bab":"إسلام › حرمة المسلم","dorar":"9usD9tLh"},{"id":"س-07486","fp":"ab18faa0b535","stateId":626,"easy":"إذا فررت بدينك بغنمك إلى رؤوس الجبال ← تنجو من الفتن","cause":"الغَنَمُ فيه خَيرَ مالِ المُسلِمِ، يَتبَعُ بها شَعَفَ الجِبالِ -أو سَعَفَ الجِبالِ- في مَواقِعِ القَطرِ","result":"يَفِرُّ بدينِه مِنَ الفِتَنِ","explicit":true,"star":true,"ref":"صحيح البخاري 3600","srcLabel":"متفق عليه","text":["قال لي: إنِّي أراكَ تُحِبُّ الغَنَمَ، وتَتَّخِذُها، فأصلِحْها وأصلِحْ رُعامَها؛ فإنِّي سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: يَأتي على النَّاسِ زَمانٌ، تَكونُ ",["الغَنَمُ فيه خَيرَ مالِ المُسلِمِ، يَتبَعُ بها شَعَفَ الجِبالِ -أو سَعَفَ الجِبالِ- في مَواقِعِ القَطرِ",1],"، ",["يَفِرُّ بدينِه مِنَ الفِتَنِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"UK5Nck3z","merged":3,"otherRefs":["تخريج المسند لشعيب 11542 (صحيح)","تخريج صحيح ابن حبان 5955 (صحيح)"]},{"id":"س-07477","fp":"93ccdb30b9ca","stateId":626,"easy":"إذا قعدت في الفتنة ← تكون خيراً من القائم","cause":"القاعدُ فيها","result":"خيرٌ مِنَ القائمِ","explicit":true,"star":true,"similar":["س-07476","س-05844","س-07303"],"ref":"المستدرك على الصحيحين 8534","srcLabel":"أحمد","text":["عن عُمرِو بنِ وابِصةَ الأسديِّ، عن أبيه، قال: إنِّي لَبِالكوفةِ في داري، إذ سَمِعتُ على بابِ الدَّارِ: السَّلامُ عليكم، أَلِجُ؟ فقُلتُ: عليك السَّلامُ، فَلُجْ، فلمَّا دخَلَ إذا هو عبدُ اللهِ بنُ مَسعودٍ رَضيَ اللهُ عنه، فقُلتُ: يا أبا عبْدَ الرَّحمنِ، أيَّةُ ساعةٍ هذه للزِّيارةِ؟! -وذلك في نحْرِ الظَّهيرةِ- قال: طال علَيَّ النَّهارُ، فتَذكَّرْتُ مَن أتحَدَّثُ إليه، فجَعَل يُحدِّثُني عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأُحَدِّثُه، قال: ثمَّ أنشَأَ يُحَدِّثُني، فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: تكونُ فِتنةٌ، النَّائمُ فيها خيْرٌ مِنَ المضْطجِعِ، والمضْطجِعُ فيها خيرٌ مِنَ القاعدِ، و",["القاعدُ فيها",1]," ",["خيرٌ مِنَ القائمِ",2],"، والقائمٌ خيرٌ مِنَ الماشي، والماشي خيرٌ مِنَ الرَّاكبِ، والرَّاكبُ خيرٌ مِنَ المُجْري، قُلتُ: يا رَسولَ اللهِ، ومَتى ذلكَ؟ قال: ذلكَ أيَّامُ الهَرْجِ حِينَ لا يَأمَنُ الرَّجلُ جَليسَه، قُلتُ: فبِمَ تَأمُرُني إنْ أدرَكْتُ ذلكَ الزَّمانَ؟ قال: اكْفُفْ نفْسَكَ ويَدَكَ، وادْخُلْ دارَك، قال: قُلتُ: يا رَسولَ اللهِ، أرأيْتَ إنْ دخَلَ علَيَّ داري؟ قال: فادخُلْ بيْتَكَ، قال: قُلتُ: أفرأيتَ إنْ دخَلَ علَيَّ بيْتي؟ قال: فادخُلْ مَسجِدَكَ، واصنَعْ هكذا -وقبَضَ بيَمينِه على الكُوعِ- وقُلْ: ربِّي اللهُ، حتَّى تَموتَ على ذلكَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه أحمد (4286)، ومعمر في ((الجامع)) (20727)، والطبراني (10/ 9)، (9774) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"u2LjwKQ4","merged":14,"otherRefs":["تخريج المسند لشعيب 20490 (صحيح)","صحيح أبي داود 4256 (صحيح)","صحيح الجامع 3623 (صحيح)","صحيح الجامع 2049 (صحيح)","صحيح الجامع 3624 (صحيح)","الأحاديث المختارة 938 (صحيح)","تخريج المسند لشعيب 17010 (صحيح)","صحيح مسلم 2886 (صحيح)","تخريج المسند لشعيب 1446 (صحيح)","صحيح مسلم 2887 (صحيح)","تخريج صحيح ابن حبان 5959 (صحيح)","تخريج صحيح ابن حبان 6705 (صحيح)","تخريج المسند لشعيب 21064 (صحيح)"]},{"id":"س-07304","fp":"cd65f9ebd6da","stateId":626,"easy":"إذا اعتزلت في شعب تتقي ربك وتدع الناس من شرك ← تكون من أفضل الناس في الفتنة","cause":"مُؤمِنٌ مُعتَزِلٌ في شِعبٍ مِنَ الشِّعابِ، يَتَّقي رَبَّه تَبارَكَ وتَعالى، ويَدَعُ النَّاسَ مِن شَرِّه","result":"وأفضَلُ النَّاسِ يَومَئِذٍ","explicit":true,"star":true,"otherNeedIds":[48,7],"ref":"تخريج المسند لشعيب 15919","srcLabel":"أحمد","text":["أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم أعرابيٌّ، فقال: يا رَسولَ اللهِ، هَل لهذا الأمرِ مِن مُنتَهًى؟ قال: «نَعَم، فمَن أرادَ اللهُ به خَيرًا مِن أعجَمَ أو عَرَبٍ أدخَلَه عليهم، ثُمَّ تَقَعُ فِتَنٌ كالظُّلَلِ تَعودونَ فيها أساوِدَ صُبًّا، يَضرِبُ بَعضُكُم رِقابَ بَعضٍ، ",["وأفضَلُ النَّاسِ يَومَئِذٍ",2]," ",["مُؤمِنٌ مُعتَزِلٌ في شِعبٍ مِنَ الشِّعابِ، يَتَّقي رَبَّه تَبارَكَ وتَعالى، ويَدَعُ النَّاسَ مِن شَرِّه",1],"» قال عَبدُ اللهِ بنُ أحمَدَ: قال أبي: وحَدَّثَني مُحَمَّدُ بنُ مُصعَبٍ القُرقُسانيُّ مِثلَ حَديثِ أبي المُغيرةِ إلَّا أنَّه قال: كُرزُ بنُ حُبَيشٍ الخُزاعيُّ."],"grade":"صحيح","narrator":"كرز بن علقمة الخزاعي","muhaddith":"صحيح","bab":"فتن › ظهور الفتن","dorar":"5MDttS51","merged":5,"otherRefs":["الأحكام الوسطى 2/352 (صحيح)","صحيح الجامع 5915 (صحيح)","تخريج المسند لشعيب 27353 (صحيح)","صحيح ابن حبان 5956 (صحيح)"]},{"id":"س-07293","fp":"fe399412aa78","stateId":626,"easy":"إذا اعتزلت بغنمك أو ثبتّ مرابطاً في الفتنة ← تكون من خير الناس فيها","cause":"صاحبُ شاءٍ يَأكُلُ مِن رِسلِ غَنمِه، أو رجُلٌ وَراءَ الدَّرْبِ آخِذٌ بعِنانِ فَرَسِه، يَأكُلُ مِن سَيفِه","result":"إنَّما خيرُ النَّاسِ فيها","explicit":true,"ref":"المستدرك على الصحيحين 8658","srcLabel":"عبد الرزاق","text":["عن أبي هُرَيرةَ رَضيَ اللهُ عنه، قال: أيُّها النَّاسُ، أظلَّتْكم فِتنةٌ كقِطَعِ اللَّيلِ المظلِمِ، ",["إنَّما خيرُ النَّاسِ فيها",2]," -أو قال: منها- ",["صاحبُ شاءٍ يَأكُلُ مِن رِسلِ غَنمِه، أو رجُلٌ وَراءَ الدَّرْبِ آخِذٌ بعِنانِ فَرَسِه، يَأكُلُ مِن سَيفِه",1],"."],"grade":"صحيح","narrator":"نافع بن سرجس","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه عبد الرزاق (21808)، ومعمر بن راشد في ((الجامع)) (20762)، وابن بطة في ((الإبانة)) (759) جميعا بلفظه.","bab":"فتن › ظهور الفتن","dorar":"mpj0B5X2","merged":3,"otherRefs":["المستدرك على الصحيحين 8794 (صحيح)","صحيح الجامع 1035 (صحيح)"]},{"id":"س-07476","fp":"33b5af51c40c","stateId":626,"easy":"إذا اضطجعت في الفتنة ← تكون خيراً من القاعد","cause":"والمضْطجِعُ فيها","result":"خيرٌ مِنَ القاعدِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"repOf":"س-07477","ref":"المستدرك على الصحيحين 8534","text":["عن عُمرِو بنِ وابِصةَ الأسديِّ، عن أبيه، قال: إنِّي لَبِالكوفةِ في داري، إذ سَمِعتُ على بابِ الدَّارِ: السَّلامُ عليكم، أَلِجُ؟ فقُلتُ: عليك السَّلامُ، فَلُجْ، فلمَّا دخَلَ إذا هو عبدُ اللهِ بنُ مَسعودٍ رَضيَ اللهُ عنه، فقُلتُ: يا أبا عبْدَ الرَّحمنِ، أيَّةُ ساعةٍ هذه للزِّيارةِ؟! -وذلك في نحْرِ الظَّهيرةِ- قال: طال علَيَّ النَّهارُ، فتَذكَّرْتُ مَن أتحَدَّثُ إليه، فجَعَل يُحدِّثُني عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأُحَدِّثُه، قال: ثمَّ أنشَأَ يُحَدِّثُني، فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: تكونُ فِتنةٌ، النَّائمُ فيها خيْرٌ مِنَ المضْطجِعِ، ",["والمضْطجِعُ فيها",1]," ",["خيرٌ مِنَ القاعدِ",2],"، والقاعدُ فيها خيرٌ مِنَ القائمِ، والقائمٌ خيرٌ مِنَ الماشي، والماشي خيرٌ مِنَ الرَّاكبِ، والرَّاكبُ خيرٌ مِنَ المُجْري، قُلتُ: يا رَسولَ اللهِ، ومَتى ذلكَ؟ قال: ذلكَ أيَّامُ الهَرْجِ حِينَ لا يَأمَنُ الرَّجلُ جَليسَه، قُلتُ: فبِمَ تَأمُرُني إنْ أدرَكْتُ ذلكَ الزَّمانَ؟ قال: اكْفُفْ نفْسَكَ ويَدَكَ، وادْخُلْ دارَك، قال: قُلتُ: يا رَسولَ اللهِ، أرأيْتَ إنْ دخَلَ علَيَّ داري؟ قال: فادخُلْ بيْتَكَ، قال: قُلتُ: أفرأيتَ إنْ دخَلَ علَيَّ بيْتي؟ قال: فادخُلْ مَسجِدَكَ، واصنَعْ هكذا -وقبَضَ بيَمينِه على الكُوعِ- وقُلْ: ربِّي اللهُ، حتَّى تَموتَ على ذلكَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه أحمد (4286)، ومعمر في ((الجامع)) (20727)، والطبراني (10/ 9)، (9774) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"u2LjwKQ4","merged":3,"otherRefs":["تخريج المسند لشعيب 20490 (صحيح)","تخريج المسند لشعيب 1446 (صحيح)"]},{"id":"س-06027","fp":"d0c20dcf5fe7","stateId":626,"easy":"إذا جُنّبت الفتن ← فأنت السعيد","cause":"لَمَن جُنِّبَ الفتَنَ","result":"إنَّ السَّعيدَ","explicit":true,"otherNeedIds":[7],"ref":"البحر الزخار 6/46","srcLabel":"أبو داود","text":["جاءَ المقدادُ بنُ الأسوَدِ في حاجةٍ، فقلنا: اجلِس حتَّى نطلُبَ لَك حاجتَكَ فجلسَ فقال: عجِبتُ لقومٍ مرَرتُ بِهم يتمنَّونَ الفتَنَ يزعُمونَ ليُبلِينَّهمُ اللَّهُ فيها ما أبلى رسولَه صلَّى اللهُ علَيهِ وسلَّم، وأصحابَه رضيَ اللَّهُ عنهُم، ولقد سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: إنَّ السَّعيدَ ",["لَمَن جُنِّبَ الفتَنَ",1],"، ",["إنَّ السَّعيدَ",2]," لمن جُنِّبَ الفتَن يردِّدُها ثلاثَ مرَّاتٍ إلَّا مَنِ ابتُليَ فصبرَ وايمُ اللَّهِ لا أشهَدُ لأحدٍ أنَّهُ من أَهلِ الجنَّةِ حتَّى أعلمَ ما يموتُ علَيهِ بعدَ حديثٍ سمعتُهُ مِن رسولِ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: لَقَلبُ ابنِ آدمَ أشدُّ انقلابًا منَ القِدرِ إذا غَلِيَتْ"],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"محفوظ وإسناده حسن","takhrij":"أخرجه أبو داود (4263) مختصراً، والبزار (2112) واللفظ له.","bab":"رقائق وزهد › فضل الصبر","dorar":"wy9CD1MT","merged":2,"otherRefs":["السلسلة الصحيحة 975 (صحيح)"]},{"id":"س-07282","fp":"8a338884fb2b","stateId":626,"easy":"إذا عضضت على أصل شجرة (اعتزلت الفتن) ← فهو خير لك من اتباع أهلها","cause":"وأنتَ عاضٌّ على جِذْلٍ","result":"خيرٌ لك من أنْ تتَّبِعَ أحدًا منهم","explicit":true,"otherNeedIds":[55],"ref":"تخريج سنن أبي داود 4246","srcLabel":"أبو داود","text":["أتَيْنا اليَشْكُريَّ في رَهْطٍ من بني ليثٍ، فقال: مَن القومُ؟ فقُلْنا: بنو ليثٍ. فقُلْنا: أتَيْناكَ نسألُكَ عن حديثِ حُذَيفةَ، قال: أقبَلْنا مع أبي موسى قافِلِينَ، وغلَتِ الدوابُّ بالكوفةِ، قال: فسألتُ أبا موسى أنا وصاحِبٌ لي، فأذِنَ لنا، فقدِمْنا الكوفةَ، فقلتُ لصاحبي: أنا داخلٌ المسجِدَ، فإذا قامتِ السوقُ خرَجتُ إليك، قال: فدخَلتُ المسجِدَ، فإذا فيه حَلْقةٌ كأنَّما قُطِّعتْ رؤوسُهم، يستَمِعونَ إلى حديثِ رجُلٍ، قال: فقمتُ عليهم، فجاء رجُلٌ فقام إلى جَنْبي، فقلتُ: مَن هذا؟ قال: أبصريٌّ أنتَ؟ قلتُ: نعَمْ، قال: قد عرَفتُ، لو كنتَ كوفيًّا لم تسألْ عن هذا، قال: فدنَوتُ منه، فسمِعتُ حُذَيفةَ يقولُ: كان الناسُ يسألونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عن الخيرِ، وكنتُ أسألُه عن الشرِّ، وعرَفتُ أنَّ الخيرَ لن يسبِقَني.\nقال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ، قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ فقال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. قلت: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: فِتْنةٌ وشرٌّ. قلتُ: يا رسولَ اللهِ، بعدَ هذا الشرِّ خيرٌ؟ قال:  يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ، قلتُ: يا رسولَ اللهِ، بعدَ هذا الشرِّ خيرٌ؟ قال: هُدْنةٌ على دَخَنٍ، وجماعةٌ على أقذاءٍ، فيها -أو فيهم- قلتُ: يا رسولَ اللهِ، الهُدْنةُ على الدَّخَنِ ما هي؟ قال: لا ترجِعُ قلوبُ أقوامٍ على الذي كانت عليه. قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ. قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: فِتْنةٌ عَمْياءُ صَمَّاءُ، عليها دُعاةٌ على أبوابِ النارِ، فإنْ مِتَّ يا حُذَيفةُ ",["وأنتَ عاضٌّ على جِذْلٍ",1],"، ",["خيرٌ لك من أنْ تتَّبِعَ أحدًا منهم",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (5963) واللفظ له، وأبو داود (4246) مختصرا، وأحمد (23282) بنحوه","bab":"فتن › ظهور الفتن","dorar":"jC21BNrR","merged":2,"otherRefs":["المستدرك على الصحيحين 8550 (صحيح)"]},{"id":"س-05844","fp":"d9d8f75dbcae","stateId":626,"easy":"إذا قعدت عن الفتنة ← فهو خير من القتال فيها","cause":"القُعودُ عن الفِتنةِ","result":"خَيرٌ مِن القِتالِ فيها","explicit":true,"repOf":"س-07477","ref":"الفتاوى الكبرى 3/458","text":[["القُعودُ عن الفِتنةِ ",1],["خَيرٌ مِن القِتالِ فيها",2]],"grade":"صحيح","muhaddith":"[صحيح]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"l4kZE2ER"},{"id":"س-07301","fp":"c112311000a5","stateId":626,"easy":"إذا دعوت بدعاء الغريق (بإخلاص) ← تنجو في الفتنة","cause":"مَن دَعا دُعاءَ الغرَقِ","result":"لا يَنْجو فيه إلَّا","explicit":true,"otherNeedIds":[29],"ref":"المستدرك على الصحيحين 8528","srcLabel":"أحمد","text":["عن حُذَيفةَ رَضيَ اللهُ عنه، قال: يَأتي عليكم زَمانٌ ",["لا يَنْجو فيه إلَّا",2]," ",["مَن دَعا دُعاءَ الغرَقِ",1],"."],"grade":"صحيح","narrator":"عمارة بن عمير","muhaddith":"هذا إسناد صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه أحمد في ((العلل ومعرفة الرجال لأحمد- رواية ابنه عبد الله)) (1370) واللفظ له، وابن أبي شيبة (29173)، والبيهقي في ((الشعب)) (1078) كلاهما باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"l4ttcKY5"},{"id":"س-07303","fp":"cd55cb3e39e9","stateId":626,"easy":"إذا نمت عن الفتنة ← تكون خيراً من اليقظان فيها","cause":"سَتَكونُ مِن بَعدي فِتنةٌ النَّائِمُ فيها","result":"خَيرٌ مِنَ اليَقظانِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"repOf":"س-07477","ref":"تخريج المسند لشعيب 17010","text":[["«سَتَكونُ مِن بَعدي فِتنةٌ النَّائِمُ فيها ",1],["خَيرٌ مِنَ اليَقظانِ",2],"، والقاعِدُ فيها خَيرٌ مِنَ القائِمِ، والقائِمُ فيها خَيرٌ مِنَ السَّاعي، فمَن أتَت عليه فليَمشِ بسَيفِه إلى صَفاةٍ فليَضرِبْه بها حَتَّى يَنكَسِرَ، ثُمَّ ليَضطَجِعْ لها حَتَّى تَنجَليَ عَمَّا انجَلَت»."],"grade":"صحيح","narrator":"خرشة","muhaddith":"صحيح لغيره","bab":"فتن › ظهور الفتن","dorar":"vMlILGF8"},{"id":"س-07790","fp":"b682b1782652","stateId":626,"easy":"إذا ظهرت الفتن فاقرأ كتاب الله واعمل بما فيه ← تنجو","cause":"اقْرَأْ كِتابَ اللهِ، واعْمَلْ بما فيه","result":"مَن أجابَهم قَذَفوهُ فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[70],"ref":"تخريج المسند لشعيب 23449","srcLabel":"متفق عليه","text":["قُلتُ: يا رسولَ اللهِ، هل بعدَ هذا الخَيرِ شَرٌّ كما كان قَبلَه شَرٌّ؟ قال: يا حُذَيفةُ، ",["اقْرَأْ كِتابَ اللهِ، واعْمَلْ بما فيه",1],"، فأعرَضَ عَنِّي، فأعَدتُ عليه ثلاثَ مرَّاتٍ، وعَلِمتُ أنَّه إنْ كان خَيرًا اتَّبَعتُه، وإنْ كان شَرًّا اجتَنَبتُه، فقُلتُ: هل بعدَ هذا الخَيرِ من شَرٍّ؟ قال: نَعَمْ، فِتْنةٌ عَمْياءُ صَمَّاءُ، ودُعاةُ ضَلالةٍ على أبْوابِ جَهنَّمَ، ",["مَن أجابَهم قَذَفوهُ فيها",2],"."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن","takhrij":"أخرجه البخاري (3606)، ومسلم (1847) مطولاً بمعناه، وأبو داود (4246)، والنسائي في ((السنن الكبرى)) (8032)، وابن ماجه (3979) بنحوه مطولاً، وأحمد (23449) واللفظ له","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"C5AlUed8"},{"id":"س-07266","fp":"cdc951c42c78","stateId":626,"easy":"إذا أنكرت على أمراء الجور ← تنجو","cause":"فمَنْ نابَذَهمْ","result":"نَجَا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 3661","srcLabel":"الطبراني","text":["سيكونُ أمراءٌ تعرِفونَ و تُنكِرونَ، ",["فمَنْ نابَذَهمْ",1]," ",["نَجَا",2],"، ومَنْ اعتزَلَهم سلِمَ، ومَنْ خالَطَهم هَلَكَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (38898)، والطبراني (11/40) (10973)، وابن عدي في ((الكامل في الضعفاء)) (7/132) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YVAi1vMQ"},{"id":"س-07267","fp":"c0f76864b124","stateId":626,"easy":"إذا اعتزلت أمراء الجور ← تسلم","cause":"ومَنْ اعتزَلَهم","result":"سلِمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 3661","srcLabel":"الطبراني","text":["سيكونُ أمراءٌ تعرِفونَ و تُنكِرونَ، فمَنْ نابَذَهمْ نَجَا، ",["ومَنْ اعتزَلَهم",1]," ",["سلِمَ",2],"، ومَنْ خالَطَهم هَلَكَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (38898)، والطبراني (11/40) (10973)، وابن عدي في ((الكامل في الضعفاء)) (7/132) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YVAi1vMQ"}]}