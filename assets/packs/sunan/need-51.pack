{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":51,"stateIds":[540,541,542,543,544,545],"items":[{"id":"س-04422","fp":"6e27b0fe1ad0","stateId":540,"easy":"إذا قاتلت لتكون كلمة الله هي العليا ← فأنت في سبيل الله","cause":"مَن قاتَلَ لتَكونَ كَلِمةُ اللهِ هي العُلْيا","result":"فهو في سَبيلِ اللهِ","explicit":true,"star":true,"otherNeedIds":[19],"ref":"تخريج المسند لشعيب 19740","srcLabel":"متفق عليه","text":["سَأَلَ رَجُلٌ -أو جاء رَجُلٌ- إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ورسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالسٌ مُنكِّسٌ، فقال: ما القِتالُ في سَبيلِ اللهِ عزَّ وجلَّ؟ فإنَّ أحَدَنا يُقاتِلُ حَميَّةً وغَضَبًا، فله أجْرٌ؟ قال: فرَفَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ رَأسَه إليه، ولَولا أنَّه كان قائمًا أو كان قاعدًا -الشَّكُّ مِن زُهَيرٍ- ما رَفَعَ رَأسَه إليه، فقال: ",["مَن قاتَلَ لتَكونَ كَلِمةُ اللهِ هي العُلْيا",1]," ",["فهو في سَبيلِ اللهِ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (123)، ومسلم (1904)، وأبو داود (2517)، والترمذي (1646)، والنسائي (3136)، وابن ماجه (2783)، وأحمد (19740) واللفظ له","bab":"جهاد › النية في القتال والغزو","dorar":"vVBTh7qd","merged":5,"otherRefs":["صحيح النسائي 3136 (صحيح)","صحيح مسلم 1904 (صحيح)","صحيح أبي داود 2517 (صحيح)"]},{"id":"س-04411","fp":"e650d6213a17","stateId":540,"easy":"إذا كانت هجرتك إلى الله ورسوله ← فهجرتك إلى الله ورسوله","cause":"فمَن كانَت هِجرتُهُ إلى اللَّهِ وإلى رسولِهِ","result":"فَهِجرتُهُ إلى اللَّهِ وإلى رسولِهِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/262","srcLabel":"البخاري","text":["إنَّما الأَعمالُ بالنِّيَّةِ وإنَّما لامرئٍ ما نَوَى، ",["فمَن كانَت هِجرتُهُ إلى اللَّهِ وإلى رسولِهِ",1]," ",["فَهِجرتُهُ إلى اللَّهِ وإلى رسولِهِ",2],"، ومَن كانَت هجرتُهُ إلى دُنْيا يُصيبُها أوِ امرَأةٍ يَتزوَّجُها فَهِجرتُهُ إلى ما هاجرَ إليهِ - وفي روايةٍ بدونِ - وإنَّما لامرئٍ ما نَوَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6689)، والترمذي (1647)، والنسائي (75)، وأحمد (168) واللفظ لهم.","bab":"جهاد › النية في القتال والغزو","dorar":"mfMGtcQO","merged":2,"otherRefs":["صحيح الترغيب 10 (صحيح)"]},{"id":"س-04410","fp":"e41f4b1a436d","stateId":540,"easy":"إذا نويت ← فلك ما نويت","cause":"بالنِّيَّةِ","result":"وإنَّما لامرئٍ ما نَوَى","explicit":true,"star":true,"otherNeedIds":[19],"ref":"صحيح ابن خزيمة 1/262","srcLabel":"البخاري","text":["إنَّما الأَعمالُ ",["بالنِّيَّةِ",1]," ",["وإنَّما لامرئٍ ما نَوَى",2],"، فمَن كانَت هِجرتُهُ إلى اللَّهِ وإلى رسولِهِ فَهِجرتُهُ إلى اللَّهِ وإلى رسولِهِ، ومَن كانَت هجرتُهُ إلى دُنْيا يُصيبُها أوِ امرَأةٍ يَتزوَّجُها فَهِجرتُهُ إلى ما هاجرَ إليهِ - وفي روايةٍ بدونِ - وإنَّما لامرئٍ ما نَوَى"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6689)، والترمذي (1647)، والنسائي (75)، وأحمد (168) واللفظ لهم.","bab":"جهاد › النية في القتال والغزو","dorar":"mfMGtcQO"},{"id":"ق-0297","fp":"d3cb89b77319","stateId":540,"easy":"التقوى ← قبول العمل","cause":"التقوى","result":"قبول العمل","explicit":true,"star":true,"ref":"سورة المائدة: 27","srcLabel":"القرآن الكريم","quran":{"s":5,"from":27,"to":27,"text":"وَاتْلُ عَلَيْهِمْ نَبَأَ ابْنَيْ آدَمَ بِالْحَقِّ إِذْ قَرَّبَا قُرْبَانًا فَتُقُبِّلَ مِنْ أَحَدِهِمَا وَلَمْ يُتَقَبَّلْ مِنَ الْآخَرِ قَالَ لَأَقْتُلَنَّكَ قَالَ إِنَّمَا يَتَقَبَّلُ اللَّهُ مِنَ الْمُتَّقِينَ (27)","hl":[[166,194,2],[194,213,1]]}},{"id":"ق-0531","fp":"c63c111d5b1d","stateId":540,"easy":"تأسيس العمل على تقوى من الله ورضوان ← خير وثبات","cause":"تأسيس العمل على تقوى من الله ورضوان","result":"خير وثبات","explicit":true,"otherNeedIds":[16],"ref":"سورة التوبة: 109","srcLabel":"القرآن الكريم","quran":{"s":9,"from":109,"to":109,"text":"أَفَمَنْ أَسَّسَ بُنْيَانَهُ عَلَى تَقْوَى مِنَ اللَّهِ وَرِضْوَانٍ خَيْرٌ أَمْ مَنْ أَسَّسَ بُنْيَانَهُ عَلَى شَفَا جُرُفٍ هَارٍ فَانْهَارَ بِهِ فِي نَارِ جَهَنَّمَ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (109)","hl":[[0,68,1],[68,74,2]]}},{"id":"ق-0813","fp":"1d0414331781","stateId":540,"easy":"التقوى والإخلاص في القربان والإحسان ← القبول عند الله والبشرى","cause":"التقوى والإخلاص في القربان والإحسان","result":"القبول عند الله والبشرى","explicit":true,"otherNeedIds":[6],"ref":"سورة الحج: 37","srcLabel":"القرآن الكريم","quran":{"s":22,"from":37,"to":37,"text":"لَنْ يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَكِنْ يَنَالُهُ التَّقْوَى مِنْكُمْ كَذَلِكَ سَخَّرَهَا لَكُمْ لِتُكَبِّرُوا اللَّهَ عَلَى مَا هَدَاكُمْ وَبَشِّرِ الْمُحْسِنِينَ (37)","hl":[[0,49,1],[49,67,2],[67,157,1],[157,166,2],[166,181,1]]}},{"id":"س-04293","fp":"3eefabd885d2","stateId":540,"easy":"إذا آمنت بالقدر ← يقبل الله نفقتك (ولا يقبلها بدونه)","cause":"تُؤمِنَ بالقدَرِ وتعلَمَ [ أنَّ ] ما أصابَكَ لَمْ يكُنْ لِيُخطِئَك وأنَّ ما أخطأَكَ لَمْ يكُنْ لِيُصيبَكَ","result":"ولو أنفَقْتَ مِثْلَ أُحُدٍ في سبيلِ اللهِ ما قبِله اللهُ منكَ حتَّى","explicit":true,"otherNeedIds":[52],"ref":"صحيح ابن حبان 727","srcLabel":"أبو داود","text":["عن ابن الديلمي، قال: أتَيْتُ أُبَيَّ بنَ كعبٍ فقُلْتُ له : وقَع في نفسي شيءٌ مِن القدَرِ فحدِّثْني بشيءٍ لعلَّه أنْ يذهَبَ مِن قلبي فقال : إنَّ اللهَ لو عذَّب أهلَ سمَواتِه وأهلَ أرضِه عذَّبهم غيرَ ظالِمٍ لهم ولو رحِمهم كانت رحمتُه خيرًا لهم مِن أعمالِهم ",["ولو أنفَقْتَ مِثْلَ أُحُدٍ في سبيلِ اللهِ ما قبِله اللهُ منكَ حتَّى",2]," ",["تُؤمِنَ بالقدَرِ وتعلَمَ [ أنَّ ] ما أصابَكَ لَمْ يكُنْ لِيُخطِئَك وأنَّ ما أخطأَكَ لَمْ يكُنْ لِيُصيبَكَ",1]," ولو مِتَّ على غيرِ هذا لَدخَلْتَ النَّارَ قال : ثمَّ أتَيْتُ عبدَ اللهِ بنَ مسعودٍ فقال مِثْلَ قولِه ثمَّ أتَيْتُ حُذَيفةَ بنَ اليَمانِ فقال مِثْلَ قولِه ثمَّ أتَيْتُ زيدَ بنَ ثابتٍ فحدَّثني عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِثْلَ ذلكَ\nقال : ثمَّ أتيت عبدالله بن مسعودٍ فقال مثل قوله ثمَّ أتيت حذيفة بن اليمان فقال مثل قوله ثمَّ أتيت زيد بن ثابت فحدثني عن النَّبيّ صلَّى اللهُ عليه وسلَّم مثل ذلك"],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (4699) بلفظه، وابن ماجه (77)، وأحمد (21611)، والبيهقي (20913) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"q4uEztRT","merged":2,"otherRefs":["تخريج المسند لشعيب 21653 (حسن)"]},{"id":"س-04751","fp":"f6d4783c78cb","stateId":540,"easy":"إذا أخلصت دينك ← يكفك العمل القليل","cause":"قالَ: أخلِصْ دينَكَ","result":"يَكفِكَ العَمَلُ القَليلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8056","srcLabel":"البيهقي","text":["أنَّه قال لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حين بَعَثه إلى اليَمَنِ: يا رَسولَ اللهِ، أوصِني،",[" قالَ: أخلِصْ دينَكَ ",1],["يَكفِكَ العَمَلُ القَليلُ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (6444)، وابن أبي حاتم في ((تفسيره)) (6162)، وأبو نعيم في ((الحلية)) (1/ 244) جميعا بلفظه.","bab":"رقائق وزهد › الإخلاص","dorar":"zpINgDRZ","merged":2,"otherRefs":["الجامع الصغير 297 (صحيح)"]},{"id":"س-00320","fp":"103ec441b22b","stateId":540,"easy":"إذا أطعمت الطعام وطاب كلامك في الحج ← فهو بر الحج","cause":"إطعامُ الطعامِ ، و طِيبُ الكلامِ","result":"بِرُّ الحَجِّ","explicit":true,"ref":"صحيح الجامع 2819","srcLabel":"أحمد","text":[["بِرُّ الحَجِّ",2]," ",["إطعامُ الطعامِ ، و طِيبُ الكلامِ",1]],"grade":"حسن","narrator":"جابر بن عبدالله","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6618) بلفظه، وأحمد (14582)، والطيالسي (1824) كلاهما بزيادة في أوله.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"GEhW0dky"},{"id":"س-00618","fp":"b8325145159b","stateId":540,"easy":"إذا تواضعت لعظمة الله ولم تستطل على خلقه ولم تُصرّ على المعصية ← يتقبل الله صلاتك","cause":"ممَّن تواضعَ بها لعظمتي ولم يستطل على خلقي ولم يبت مصرًّا على معصيتي وقطعَ نهارَهُ في ذكري ورحمَ المسكينَ وابنَ السَّبيلِ والأرملةَ ورحمَ المصابَ","result":"إنَّما أتقبَّلُ الصَّلاةَ","explicit":true,"ref":"مجمع الزوائد 2/150","srcLabel":"البزار","text":["قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ اللَّهُ تباركَ وتعالى ",["إنَّما أتقبَّلُ الصَّلاةَ",2]," ",["ممَّن تواضعَ بها لعظمتي ولم يستطل على خلقي ولم يبت مصرًّا على معصيتي وقطعَ نهارَهُ في ذكري ورحمَ المسكينَ وابنَ السَّبيلِ والأرملةَ ورحمَ المصابَ",1]," ذلكَ نورُهُ كنورِ الشَّمسِ أكلؤهُ بعزَّتي وأستحفظُهُ ملائكتي أجعلُ لهُ في الظُّلمةِ نورًا وفي الجهالةِ حلمًا ومثلُهُ في خَلقي كمثلِ الفردَوسِ في الجنَّةِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"فيه عبد الله بن واقد الحراني وبقية رجاله ثقات","takhrij":"أخرجه البزار (4855) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/420)، وأبو نعيم في ((حلية الأولياء)) (4/18)","bab":"آداب عامة › ضرب الأمثال","dorar":"ePrDhAWj"},{"id":"س-01665","fp":"c4f4f7229de3","stateId":540,"easy":"إذا أخلصت عملك لله ← يقبله","cause":"إلا ما كان له خالصًا","result":"إنَّ اللهَ عزَّ وجلَّ لا يقبلُ من العبدِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[19],"ref":"منهاج السنة 6/71","srcLabel":"البيهقي","text":["كتب عمرُ بنُ الخطابِ رضي اللهُ عنه إلى أبي موسى الأشعريِّ : أما بعدُ فإنَّ القضاءَ فريضةٌ محكمةٌ ، وسُنَّةٌ مُتَّبعةٌ ، فافْهم إذا أُدلَى إليك ، فإنه لا ينفع تكلُّمٌ بحقٍّ لا نفاذَ له ، آسِ بين الناسِ في مجلسِك ووجهِك وقضائِك ، حتى لا يطمع شريفٌ في حَيْفِك ، ولا ييأسُ ضعيفٌ من عدلِك . البيِّنةُ على من ادَّعى ، واليمينُ على من أنكر ، والصلحُ جائزٌ بين المسلمين ، إلا صلحًا أحلَّ حرامًا ، أو حرَّم حلالًا . ومن ادَّعى حقًّا غائبًا فامدُدْ له أمدًا ينتهي إليه ، فإن جاء ببينةٍ فأَعطِه حقَّه ، وإن أعجزَه ذلك استحللتَ عليه القضيةَ ، فإنَّ ذلك هو أبلغُ في العُذرِ ، وأجلى للعَمى ، ولا يمنعك قضاءٌ قضيتَه اليومَ فراجعتَ فيه رأيَك فهُديت فيه لرُشدِك أن تراجعَ الحقَّ ، فإنَّ الحقَّ قديمٌ ، وليس يُبطلُه شيءٌ ، ومراجعةُ الحقِّ خيرٌ من التَّمادي في الباطل . والمسلمون عدولٌ بعضُهم على بعضٍ ، إلا مُجرَّبًا عليه شهادةَ زورٍ ، أو مجلودًا في حدٍّ ، أو ظنينًا في ولاءٍ أو نسبٍ ؛ فإنَّ اللهَ تولَّى من العبادِ السرائرَ ، وستر عليهم الحدودَ إلا بالبينات والأيمانِ . ثم الفهمَ الفهمَ فيما أُدليَ إليك وفيما ورد عليك ، مما ليس في قرآنٍ ولا سُنَّةٍ ، ثم قايِسِ الأمورَ عند ذلك ، ثم اعرف الأمثالَ ، ثم اعمد فيما ترى إلى أحبِّها إلى اللهِ وأشبهِها بالحقِّ . وإياك والغضبَ والقلقَ والضجرَ والتأذِّي بالخصومِ ؛ فإنَّ القضاءَ في مواطنِ الحقِّ مما يوجب اللهُ به الأجرَ ، ويحسنُ به الذَّخرُ ، فمن خلصَتْ نيَّتَه في الحقِّ ، ولو على نفسه ، كفاه اللهُ ما بينه وبين الناسِ ، ومن تزيَّنَ بما ليس في نفسِه شانَه اللهُ عزَّ وجلَّ ؛ ف",["إنَّ اللهَ عزَّ وجلَّ لا يقبلُ من العبدِ",2]," ",["إلا ما كان له خالصًا",1]," ، فما ظنُّك بثوابٍ عند اللهِ في عاجلِ رزقِه وخزائنِ رحمتِه"],"grade":"صحيح","narrator":"جعفر بن برقان","muhaddith":"إسناده ثابت","takhrij":"أخرجه البيهقي (20567)، والدارقطني (4471) باختلاف يسير.","bab":"أقضية وأحكام › الاجتهاد في الحكم","dorar":"eQyJvIYr"},{"id":"س-04418","fp":"4cb39756496d","stateId":540,"easy":"إذا قاتلت ← فلك عند الله ما في نفسك من النية","cause":"ما في أنفُسِهم","result":"وما للذينَ يقاتِلونَ عندَ اللهِ إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"إتحاف الخيرة المهرة 3/254","srcLabel":"إتحاف الخيرة المهرة","text":["أنَّ ناسًا كانوا بالكوفةِ مع أبي المختارِ فقُتِلوا إلا رجلَينِ حمَلا على العدوِّ بأسيافِهم فأفرَجوا لهما فنجَيا أو ثلاثةً ، فأتَوُا المدينةَ فخرَج عُمرُ وهم قعودٌ يذكرونَهم . قال عُمرُ : عَمَّ قلتُم لهم ؟ قالوا : استَغفَرْنا لهم ودعَوْنا لهم. قال : لتحدِّثُني ما قلتُم لهم. قالوا : استَغفَرْنا لهم ودعَوْنا. قال : لتحدِّثُني ما قلتُم لهم أو لتلقونَ مني قبوحًا. قالوا : إنا قُلْنا : إنهم شهداءُ. قال عُمرُ : والذي لا إلهَ غيرُه ، والذي بعَث محمدًا بالحقِّ ، والذي لا تقومُ الساعةُ إلا بإذنِه ، ما تعلمُ نفسٌ حيةٌ ماذا عندَ اللهِ لنفسٍ ميتةٍ إلا نبيَّ اللهِ؛ فإنه قد غُفِر له ما تقدَّم مِن ذنبِه وما تأخَّر ، والذي لا إلهَ غيرُه ، والذي بعَث محمدًا بالحقِّ ، والذي لا تقومُ الساعةُ إلا بإذنِه إنَّ الرجلَ يقاتِلُ رِياءً ، ويقاتِلُ حميةً ، ويقاتِلُ يريدُ به الدنيا ، ويقاتِلُ يريدُ به المالَ ، ",["وما للذينَ يقاتِلونَ عندَ اللهِ إلا",2]," ",["ما في أنفُسِهم",1]," ، إنَّ اللهَ اختار لنبيِّه المدينةَ وهي أقلُّ الأرضِ طعامًا وأملحُه ماءً إلا ما كان مِن هذا التمرِ ، وإنه لا يدخُلُها الدجَّالُ ، ولا الطاعونُ إن شاء اللهُ - تعالى"],"grade":"حسن","narrator":"أبو البختري الطائي","muhaddith":"رجاله ثقات","bab":"جهاد › النية في القتال والغزو","dorar":"HtXpaaSq"},{"id":"س-07028","fp":"7532162ce16e","stateId":540,"easy":"إذا عملت مع العلم ← فقليل العمل ينفع","cause":"مع العلمِ","result":"إنَّ قليلَ العملِ ينفعُ","explicit":true,"otherNeedIds":[18],"ref":"جامع بيان العلم 1/203","srcLabel":"ابن منده","text":["جاء رجلٌ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلم فقال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال :  العلمُ باللهِ عزَّ وجلَّ  قال : يا رسولَ اللهِ أيُّ الأعمالِ أفضلُ ؟ قال :  العلمُ باللهِ  . قال : يا رسولَ اللهِ أسألُكَ عن العملِ وتخبِرني عن العلمِ ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلم :  ",["إنَّ قليلَ العملِ ينفعُ",2]," ",["مع العلمِ",1]," ، وإنَّ كثيرَ العملِ لا ينفعُ مع الجهلِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"روى مثل هذا عن عبد الله بن مسعود أيضاً بإسناد صالح","takhrij":"أخرجه ابن منده في ((مجالس من أماليه)) (418)، والديلمي في الفردوس كما في ((جامع الأحاديث)) للسيوطي(4050).","bab":"علم › الحث على طلب العلم","dorar":"b5YRQyKO"},{"id":"س-01371","fp":"1d44caae0a7d","stateId":541,"easy":"إذا كبّرت وقرأت واطمأننت في ركوعك وسجودك ← تمت صلاتك","cause":"إذا قُمتَ إلى الصَّلاةِ فكبِّر ثمَّ اقرَأ ما تيسَّرَ معَكَ منَ القرآنِ ثمَّ اركَع حتَّى تطمئنَّ راكعًا ثمَّ ارفَع حتَّى تعتدلَ قائمًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا ثمَّ اجلِس حتَّى تَطمئنَّ جالسًا ثمَّ افعَل ذلِكَ في صلاتِكَ كُلِّها","result":"فإذا فعلتَ هذا فقد تمَّت صلاتُكَ","explicit":true,"star":true,"similar":["س-06423","س-06416","س-06696"],"ref":"صحيح أبي داود 856","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- دخلَ المسجِدَ فدخلَ رجلٌ فصلَّى ثمَّ جاءَ فسلَّمَ علَى رسولِ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- فردَّ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- عليهِ السَّلامَ وقالَ ارجِع فصلِّ فإنَّكَ لم تُصلِّ فرجعَ الرَّجلُ فصلَّى كما كانَ صلَّى ثمَّ جاءَ إلى النَّبيِّ -صلَّى اللَّهُ علَيهِ وسلَّمَ- فسلَّمَ عليهِ فقالَ لهُ رسولُ اللَّهِ -صلَّى اللَّهُ علَيهِ وسلَّمَ- وعليكَ السَّلامُ ثمَّ قالَ ارجِع فصلِّ فإنَّكَ لم تصلِّ حتَّى فعلَ ذلِكَ ثلاثَ مِرارٍ فقالَ الرَّجلُ والَّذي بعثَكَ بالحقِّ ما أُحسِنُ غيرَ هذا فعلِّمني قالَ ",["إذا قُمتَ إلى الصَّلاةِ فكبِّر ثمَّ اقرَأ ما تيسَّرَ معَكَ منَ القرآنِ ثمَّ اركَع حتَّى تطمئنَّ راكعًا ثمَّ ارفَع حتَّى تعتدلَ قائمًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا ثمَّ اجلِس حتَّى تَطمئنَّ جالسًا ثمَّ افعَل ذلِكَ في صلاتِكَ كُلِّها",1]," ",["فإذا فعلتَ هذا فقد تمَّت صلاتُكَ",2]," وما انتَقَصتَ مِن هذا شيئًا فإنَّما انتقَصتَهُ مِن صلاتِكَ وقالَ فيهِ إذا قُمتَ إلى الصَّلاةِ فأسبِغ الوُضوءَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (856) واللفظ له، وأخرجه البخاري (6251)، ومسلم (397) باختلاف يسير.","bab":"وضوء › إسباغ الوضوء","dorar":"mUZnJ0NE","merged":3,"otherRefs":["صحيح الجامع 740 (صحيح)","نخب الافكار 4/232 (صحيح)"]},{"id":"س-06670","fp":"8fcebf7b2f4b","stateId":541,"easy":"إذا سويت الصفوف ← فهو من تمام الصلاة","cause":"تسويةَ الصُّفوفِ","result":"مِن تَمامِ الصَّلاةِ","explicit":true,"star":true,"similar":["س-06664","س-06674"],"ref":"صحيح ابن خزيمة 3/ 68","srcLabel":"متفق عليه","text":["أقيموا صفوفَكُم؛ فإنَّ ",["تسويةَ الصُّفوفِ",1]," ",["مِن تَمامِ الصَّلاةِ",2]," [وفي روايةٍ]: إنَّ مِن حُسنِ الصَّلاةِ إقامةَ الصَّفِّ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (723) بلفظ مقارب، ومسلم (433)، وأبو داود (668)","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"CGakjvvy","merged":2,"otherRefs":["تخريج المسند لشعيب 13901 (صحيح)"]},{"id":"س-06664","fp":"1651fd266755","stateId":541,"easy":"إذا أقمت الصف في الصلاة ← فهو من حسن الصلاة","cause":"وأقيموا الصَّفَّ في الصَّلاةِ","result":"فإنَّ إقامةَ الصَّفِّ مِن حُسنِ الصَّلاةِ","explicit":true,"repOf":"س-06670","ref":"صحيح البخاري 722","text":["إنَّما جُعِلَ الإمامُ ليُؤتَمَّ به، فلا تَختَلِفوا عليه، فإذا رَكَعَ فاركَعوا، وإذا قال: سَمِعَ اللهُ لمَن حَمِدَه، فقولوا: رَبَّنا لكَ الحَمدُ، وإذا سَجَدَ فاسجُدوا، وإذا صَلَّى جالِسًا فصَلُّوا جُلوسًا أجمَعونَ، ",["وأقيموا الصَّفَّ في الصَّلاةِ",1],"؛ ",["فإنَّ إقامةَ الصَّفِّ مِن حُسنِ الصَّلاةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (417) باختلاف يسير","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"2rwqsioX"},{"id":"س-05825","fp":"1899dd0588e8","stateId":541,"easy":"إذا صليت إلى سترة فادنُ منها ← لا يقطع الشيطان عليك صلاتك","cause":"وليدْنُ مِنها","result":"لا يقطعُ الشَّيطانُ عليهِ صلاتَهُ","explicit":true,"star":true,"otherNeedIds":[31],"ref":"صحيح ابن خزيمة 2/ 39","srcLabel":"ابن خزيمة","text":["عن سَهْلِ بنِ أبي حَثمةَ وبلغَ به النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ - [وفي روايةٍ]: روايةً- قالَ: إذا صلَّى أحدُكُم فليصلِّ إلى سُترةٍ، ",["وليدْنُ مِنها",1],"، ",["لا يقطعُ الشَّيطانُ عليهِ صلاتَهُ",2]],"grade":"صحيح","narrator":"سهل بن أبي حثمة","muhaddith":"أخرجه في صحيحه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"uQNZ6KoX","merged":2,"otherRefs":["صحيح الجامع 637 (صحيح)"]},{"id":"س-06423","fp":"871d9f79224d","stateId":541,"easy":"إذا توضأت كما أمرك الله ثم صليت مطمئناً ← تمت صلاتك","cause":"إذا قُمتَ إلى الصَّلاةِ فتوضَّأْ كما أمرَكَ اللَّهُ به ثمَّ تشَهَّدْ فأقِمْ أيضًا فإن كانَ معَكَ قرآنٌ فاقرَأْ وإلَّا فاحْمَدِ اللَّهَ وَكَبِّرهُ وَهَلِّلهُ ثمَّ اركَعْ فاطمَئنَّ راكعًا ثمَّ اعتدِلْ قائمًا ثمَّ اسجُدْ فاعتِدلْ ساجدًا ثمَّ اجلِسْ فاطمَئنَّ جالسًا ثمَّ قمْ","result":"فإذا فعَلتَ ذلِكَ فقد تَمَّتْ صلاتُكَ","explicit":true,"repOf":"س-01371","ref":"صحيح الترمذي 302","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بينما هوَ جالسٌ في المسجدِ يومًا - قالَ رفاعةُ : ونحنُ معَهُ - إذا جاءَهُ رجلٌ كالبدَويِّ ، فصلَّى فأخفَّ صلاتَهُ ، ثمَّ انصَرَفَ فسلَّمَ علَى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ وعَليكَ فارجِع فصلِّ فإنَّكَ لم تصلِّ ، فرجعَ فصلَّى ثمَّ جاءَ فسلَّمَ عليهِ فقالَ : وعَليكَ فارجِعْ فصلِّ فإنَّكَ لم تُصلِّ [ ففعلَ ذلِكَ ] مرَّتينِ أو ثلاثًا كلُّ ذلِكَ يأتي النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فيسلِّمُ علَى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ، فيقولُ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ وعليكَ فارجِع فصلِّ فإنَّكَ لم تُصلِّ فعافَ النَّاسُ وَكَبُرَ عليهم أن يَكونَ مَن أخفَّ صلاتَهُ لم يُصلِّ فقالَ الرَّجلُ في آخرِ ذلِكَ فأرِني وعلِّمني ، فإنَّما أنا بشرٌ أصيبُ وأخطىء فقالَ : أجَل ",["إذا قُمتَ إلى الصَّلاةِ فتوضَّأْ كما أمرَكَ اللَّهُ به ثمَّ تشَهَّدْ فأقِمْ أيضًا فإن كانَ معَكَ قرآنٌ فاقرَأْ وإلَّا فاحْمَدِ اللَّهَ وَكَبِّرهُ وَهَلِّلهُ ثمَّ اركَعْ فاطمَئنَّ راكعًا ثمَّ اعتدِلْ قائمًا ثمَّ اسجُدْ فاعتِدلْ ساجدًا ثمَّ اجلِسْ فاطمَئنَّ جالسًا ثمَّ قمْ",1]," ",["فإذا فعَلتَ ذلِكَ فقد تَمَّتْ صلاتُكَ",2]," ، وإن انتقَصْتَ منهُ شيئًا انتقصتَ من صلاتِكَ قالَ : وَكانَ هذا أهْوَنَ عليهم منَ الأولى أنَّهُ من انتَقصَ من ذلِكَ شيئًا انتقَصَ من صلاتِهِ ولم تذهَب كلُّها"],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (302)، وابن خزيمة (545)، والحاكم (885)، وإسماعيل بن جعفر في ((حديث علي بن حجر)) (441)، وأبو نعيم في ((معرفة الصحابة)) (2714) جميعا بلفظه.","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"kmwyuRyW","merged":2,"otherRefs":["صحيح النسائي 1313 (صحيح)"]},{"id":"س-00722","fp":"b0ef48a7ecd3","stateId":541,"easy":"إذا استيقظت فتوضأت ثم صليت ← قُبلت صلاتك","cause":"فإنْ قامَ فتوضَّأ ثُمَّ صلَّى","result":"قُبِلتْ صلاتُه","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"ref":"ما تمس إليه الحاجة 131","srcLabel":"ما تمس إليه الحاجة","text":["مَن تَعارَّ مِن اللَّيلِ فقال حِينَ يَستيقظُ: لا إلهَ إلَّا اللهُ وحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قديرٌ، سُبحانَ اللهِ، والحمدُ للهِ، ولا إلهَ إلَّا اللهُ، واللهُ أكبرُ، ولا حولَ ولا قُوَّةَ إلَّا باللهِ العَليِّ العَظيمِ، ثمَّ دعا: ربِّ اغفِرْ لي؛ غُفِرَ له -قال الوَليدُ أحدُ رُواتِه: أو قال: دعا؛ استُجيبَ له-، ",["فإنْ قامَ فتوضَّأ ثُمَّ صلَّى",1],"؛ ",["قُبِلتْ صلاتُه",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"EgFiW0iu"},{"id":"س-06416","fp":"24750ffcb7c7","stateId":541,"easy":"إذا كبّرت وحمدت الله وأثنيت عليه وقرأت ما تيسر واطمأننت ← تمت صلاتك","cause":"ثمَّ يُكَبِّرُ ويحمَدُ اللَّهَ جلَّ وعزَّ ويُثني علَيهِ ويَقرأُ بما تيسَّرَ منَ القرآنِ ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَركعُ حتَّى تطمَئنَّ مَفاصلُهُ ثمَّ يقولُ سمِعَ اللَّهُ لمن حمدَهُ حتَّى يَستويَ قائمًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجُدُ حتَّى تَطمِئنَّ مَفاصِلُهُ ثمَّ يقولُ اللَّهُ أَكْبرُ ويرفعُ رأسَهُ حتَّى يَستويَ قاعدًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجدُ حتَّى تَطمئنَّ مفاصلُهُ ثمَّ يرفعُ رأسَهُ فيُكَبِّرُ","result":"فإذا فعلَ ذلِكَ فقد تمَّت صلاتُهُ","explicit":true,"repOf":"س-01371","ref":"صحيح أبي داود 857","text":["أنَّ رجلًا دخلَ المسجدَ . . . فقالَ النَّبيُّ صلَّى اللَّهُ علَيهِ وسلَّمَ إنَّهُ لا تتِمُّ صلاةٌ لأحَدٍ منَ النَّاسِ حتَّى يتوضَّأَ فيَضعَ الوضوءَ يعني مواضعَهُ ",["ثمَّ يُكَبِّرُ ويحمَدُ اللَّهَ جلَّ وعزَّ ويُثني علَيهِ ويَقرأُ بما تيسَّرَ منَ القرآنِ ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَركعُ حتَّى تطمَئنَّ مَفاصلُهُ ثمَّ يقولُ سمِعَ اللَّهُ لمن حمدَهُ حتَّى يَستويَ قائمًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجُدُ حتَّى تَطمِئنَّ مَفاصِلُهُ ثمَّ يقولُ اللَّهُ أَكْبرُ ويرفعُ رأسَهُ حتَّى يَستويَ قاعدًا ثمَّ يقولُ اللَّهُ أَكْبرُ ثمَّ يَسجدُ حتَّى تَطمئنَّ مفاصلُهُ ثمَّ يرفعُ رأسَهُ فيُكَبِّرُ",1]," ",["فإذا فعلَ ذلِكَ فقد تمَّت صلاتُهُ",2]],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (857) واللفظ له، والترمذي (302)، والنسائي (1136) بنحوه.","bab":"صلاة › التكبير عند كل خفض ورفع","dorar":"yz2RfaIg"},{"id":"س-06518","fp":"1899df13b534","stateId":541,"easy":"إذا أحسنت الصلاة فأتممت ركوعها وسجودها ← تقول الصلاة: حفظك الله كما حفظتني وتُرفع","cause":"إذا أحسنَ الرجلُ الصلاةَ فأتمَّ ركوعَها وسجودَها","result":"قالتْ الصلاةُ: حفِظَكَ اللهُ كما حفظْتَنِي ، فتُرفعُ","explicit":true,"otherNeedIds":[31],"ref":"الجامع الصغير 363","srcLabel":"الطبراني","text":[["إذا أحسنَ الرجلُ الصلاةَ فأتمَّ ركوعَها وسجودَها",1]," ",["قالتْ الصلاةُ: حفِظَكَ اللهُ كما حفظْتَنِي ، فتُرفعُ",2]," ، وإذا أساءَ الصلاةَ ، فلمْ يُتِمَّ ركوعَها وسجودَها ، قالت الصلاةُ: ضيَّعَكَ اللهُ كما ضيعتَني: فَتُلَفُّ كمَا يُلَفُّ الثوبُ الخَلَقُ فيضربُ بها وجهُهُ"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (586) واللفظ له، والطبراني كما في ((مجمع الزوائد)) للهيثمي (2/125)، والبيهقي في ((شعب الإيمان)) (3140) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"TX692F6L"},{"id":"س-06591","fp":"9bdf6d6fd138","stateId":541,"easy":"إذا أديت الصلاة بحقها ← قُبلت منك وقُبل سائر عملك","cause":"فمَنْ أَدَّاها بحقِّها","result":"قُبِلَتْ مِنْهُ ، و قُبِلَ مِنْهُ سائِرُ عَمَلِه ، و مَنْ رُدَّتْ عليهِ صلاتُهُ رُدَّ عليهِ سائِرُ عَمَلِه","explicit":true,"ref":"صحيح الترغيب 539","srcLabel":"البزار","text":["الصَّلاةُ ثلاثَةُ أَثْلاثٍ ، الطُّهورُ ثُلُثٌ ، و الركوعُ ثُلُثٌ ، و السُّجُودُ ثُلُثٌ ، ",["فمَنْ أَدَّاها بحقِّها ",1],["قُبِلَتْ مِنْهُ ، و قُبِلَ مِنْهُ سائِرُ عَمَلِه ، و مَنْ رُدَّتْ عليهِ صلاتُهُ رُدَّ عليهِ سائِرُ عَمَلِه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه البزار (9273) واللفظ له، والديلمي في ((الفردوس)) (3807) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Ej7iouAL"},{"id":"س-06674","fp":"8f84945836c6","stateId":541,"easy":"إذا عدلت الصفوف وحاذيت المناكب ← فهو من تمام الصلاة","cause":"فاعدِلوا الصفوفَ ، وحاذوا المناكبَ","result":"فإنَّ اعتدالَ الصفوفِ مِن تمامِ الصلاةِ","explicit":true,"repOf":"س-06670","ref":"خلاصة الأحكام للنووي 2/805","text":["أنَّ عثمانَ بنَ عفانَ رضي اللهُ عنه كان يقولُ في خطبتِه قَلَّ ما يدَعُ ذلك إذا قام الإمامُ يخطبُ يومَ الجمُعةِ فاستَمِعوا له وأنصِتوا ، فإنَّ للمُنصِتِ الذي لا يسمعُ منَ الحظِّ مثلَ ما للسامعِ المنصتِ ، فإذا قامَتِ الصلاةُ ",["فاعدِلوا الصفوفَ ، وحاذوا المناكبَ",1]," ، ",["فإنَّ اعتدالَ الصفوفِ مِن تمامِ الصلاةِ",2]," . ثم لا يكبِّرُ حتى تأتيَه رجالٌ قد وكَلَهم بتسويةِ الصفوفِ ، فيُخبِرونَه أن قدِ استَوَتْ فيكبرُ"],"grade":"صحيح","narrator":"مالك بن أبي عامر الأصبحي","muhaddith":"صحيح","takhrij":"أخرجه الشافعي في ((مسنده-ترتيب سنجر)) (430)، والبيهقي في ((الصغير)) (630) واللفظ لهما، ومالك (345) باختلاف يسير.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"f9VImpaJ"},{"id":"س-06696","fp":"6e58b108f85e","stateId":541,"easy":"إذا قمت إلى الصلاة فأسبغ الوضوء واستقبل القبلة واطمئن ← تصح صلاتك","cause":"إذَا قُمْتَ إلى الصَّلَاةِ، فأسْبِغِ الوُضُوءَ، ثُمَّ اسْتَقْبِلِ القِبْلَةَ، فَكَبِّرْ واقْرَأْ بما تَيَسَّرَ معكَ مِنَ القُرْآنِ، ثُمَّ ارْكَعْ حتَّى تَطْمَئِنَّ رَاكِعًا، ثُمَّ ارْفَعْ رَأْسَكَ حتَّى تَعْتَدِلَ قَائِمًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ وتَطْمَئِنَّ جَالِسًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ قَائِمًا، ثُمَّ افْعَلْ ذلكَ في صَلَاتِكَ كُلِّهَا","result":"ارجع فصَلِّ فإنَّكَ لم تُصلِّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01371","otherNeedIds":[52],"ref":"مختصر الصواعق المرسلة 610","text":["أحاديثُ فرضِ الطُّمأنينةِ [حديث أبي هريرة: أنَّ رَجُلًا دَخَلَ المَسْجِدَ فَصَلَّى، ورَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ في نَاحِيَةِ المَسْجِدِ، فَجَاءَ فَسَلَّمَ عليه، فَقَالَ له: ارْجِعْ فَصَلِّ فإنَّكَ لَمْ تُصَلِّ فَرَجَعَ فَصَلَّى ثُمَّ سَلَّمَ، فَقَالَ: وعَلَيْكَ، ارْجِعْ فَصَلِّ فإنَّكَ لَمْ تُصَلِّ قَالَ في الثَّالِثَةِ: فأعْلِمْنِي، قَالَ: ",["إذَا قُمْتَ إلى الصَّلَاةِ، فأسْبِغِ الوُضُوءَ، ثُمَّ اسْتَقْبِلِ القِبْلَةَ، فَكَبِّرْ واقْرَأْ بما تَيَسَّرَ معكَ مِنَ القُرْآنِ، ثُمَّ ارْكَعْ حتَّى تَطْمَئِنَّ رَاكِعًا، ثُمَّ ارْفَعْ رَأْسَكَ حتَّى تَعْتَدِلَ قَائِمًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ وتَطْمَئِنَّ جَالِسًا، ثُمَّ اسْجُدْ حتَّى تَطْمَئِنَّ سَاجِدًا، ثُمَّ ارْفَعْ حتَّى تَسْتَوِيَ قَائِمًا، ثُمَّ افْعَلْ ذلكَ في صَلَاتِكَ كُلِّهَا",1],".] [وحديث رفاعة بن رافع:كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ إذ دخلَ رجلٌ المسجدَ فصلَّى ورسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ يرمقُهُ ولا يشعرُ ثمَّ انصرفَ فأتى رسولَ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ فسلَّمَ عليْهِ فردَّ عليْهِ السَّلامَ ثمَّ قالَ ",["ارجع فصَلِّ فإنَّكَ لم تُصلِّ",2]," قالَ لا أدري في الثَّانيةِ أو في الثَّالثةِ قالَ والَّذي أنزلَ عليْكَ الْكتابَ لقد جَهِدتُ فعلِّمني وأرِني قالَ إذا أردتَ الصَّلاةَ فتوضَّأ فأحسنِ الوضوءَ ثمَّ قم فاستقبلِ القبلةَ ثمَّ كبِّر ثمَّ اقرأ ثمَّ ارْكع حتَّى تطمئنَّ راكعًا ثمَّ ارفَع حتَّى تعتدلَ قائمًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا ثمَّ ارفع رأسَكَ حتَّى تطمئنَّ قاعدًا ثمَّ اسجُد حتَّى تطمئنَّ ساجدًا فإذا صنعتَ ذلِكَ فقد قضَيتَ صلاتَكَ وما انتقصتَ من ذلِكَ فإنَّما تنقصُهُ من صلاتِكَ]"],"grade":"صحيح","narrator":"[أبو هريرة ورفاعة بن رافع]","muhaddith":"رواية صحيحة","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"ZWo1inuD","merged":7,"otherRefs":["صحيح النسائي 1312 (صحيح)","صحيح البخاري 6251 (صحيح)","الاستذكار 1/457 (صحيح)","صحيح الترمذي 302 (صحيح)","هداية الرواة 1/371 (حسن)","السيل الجرار 1/214 (صحيح)"]},{"id":"س-06699","fp":"a6b165f1c67a","stateId":541,"easy":"إذا عقلت صلاتك (حضر قلبك) ← فلك منها ما عقلت","cause":"ما عقَلَ منها","result":"ليس للعبدِ من صلاةٍ إلا","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 7/356","srcLabel":"فتاوى نور على الدرب لابن باز","text":[["ليس للعبدِ من صلاةٍ إلا",2]," ",["ما عقَلَ منها",1],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"UZ3mIDuj"},{"id":"س-06705","fp":"6fc3544a080b","stateId":541,"easy":"إذا أمّكم خياركم ← تُقبل صلاتكم فهم وفدكم إلى ربكم","cause":"فليؤُمَّكُم خيارُكُم فإنَّهم وفدُكُم فيما بينَكُم وبينَ ربِّكم","result":"إن سرَّكُم أن تقبلَ صلاتُكُم","explicit":true,"ref":"تحفة المحتاج 1/455","srcLabel":"الحاكم","text":[["إن سرَّكُم أن تقبلَ صلاتُكُم ",2],["فليؤُمَّكُم خيارُكُم فإنَّهم وفدُكُم فيما بينَكُم وبينَ ربِّكم",1]],"grade":"صحيح","narrator":"مرثد بن أبي مرثد الغنوي","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الطبراني (20/328) (777)، والحاكم (4981) واللفظ لهما، والدارقطني (2/88) باختلاف يسير","bab":"صلاة الجماعة والإمامة › فضل الأئمة","dorar":"SzttU2rh"},{"id":"س-00620","fp":"7c736746c82d","stateId":541,"easy":"إذا أتممت صلاتك ← فالله لا يقبل إلا تاماً","cause":"فأتمُّوا صلاتَكُم","result":"إنَّ اللَّهَ عزَّ وجلَّ لا يقبلُ إلَّا تام","explicit":true,"similar":["س-06698"],"ref":"الزواجر عن اقتراف الكبائر 1/140","srcLabel":"الزواجر عن اقتراف الكبائر","text":["لو أنَّ لأحدِكُم هذِهِ السَّاريةَ لَكَرِهَ أن يُجدَعَ بعضُها ، كيفَ يعمدُ أحدُكُم فيجدَعُ صلاتَهُ الَّتي هيَ للَّهِ ",["فأتمُّوا صلاتَكُم",1]," ف",["إنَّ اللَّهَ عزَّ وجلَّ لا يقبلُ إلَّا تام",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"آداب عامة › ضرب الأمثال","dorar":"eXPJVlOl"},{"id":"س-01402","fp":"d583e7ea2710","stateId":541,"easy":"إذا توضأت فغسلت قدميك ← فهذا الوضوء الذي لا تُقبل الصلاة إلا به","cause":"توضَّأَ فغسَلَ قدمَيْه","result":"هذا وُضوءٌ لا يَقبَلُ اللهُ الصَّلاةَ إلَّا به","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"أضواء البيان 2/18","srcLabel":"أضواء البيان","text":["أنَّ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ ",["توضَّأَ فغسَلَ قدمَيْه",1],"، ثمَّ قال: ",["هذا وُضوءٌ لا يَقبَلُ اللهُ الصَّلاةَ إلَّا به",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أورده ابن كثير في ((التفسير)) (3/ 48) بلفظه.","bab":"وضوء › صفة الوضوء","dorar":"5TCSdjOp"},{"id":"س-06698","fp":"6b9b1e95a9b8","stateId":541,"easy":"إذا أتممت صلاتك ← فالله لا يقبل إلا تاماً","cause":"فأتمُّوا صلاتَكم","result":"إنَّ اللَّهَ لا يقبلُ إلَّا تامًّا","explicit":true,"repOf":"س-00620","ref":"مجمع الزوائد 2/124","text":["قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يومًا لأصحابِهِ وأنا حاضرٌ لو كانَ لأحدِكم هذِهِ السَّاريةُ لكرِهَ أن يُخدَعَ كيفَ يعملُ أحدُكم فيخدعُ صلاتَهُ الَّتي هيَ للَّهِ ",["فأتمُّوا صلاتَكم",1]," ",["إنَّ اللَّهَ لا يقبلُ إلَّا تامًّا",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6296)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"qgjN5mQc"},{"id":"س-02029","fp":"f5d665c90960","stateId":541,"easy":"إذا لم تتم صلاتك ← تُكمّل من نوافلك","cause":"مِن سُبُحاتِه","result":"زيدَ عليها مِن سُبُحاتِه حتَّى تَتِمَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01960","ref":"الأحاديث المختارة 8 / 243","text":["(«مَن صلَّى صَلاةً لم يُتِمَّها ",["زيدَ عليها مِن سُبُحاتِه حتَّى تَتِمَّ",2],"»)."],"grade":"صحيح","narrator":"عايذ بن قرط","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"yIlopzZY"},{"id":"س-01960","fp":"4f8916b605b0","stateId":541,"easy":"إذا انتقصت من فريضتك شيئاً ← يتمها الله من نافلتك","cause":"مِن سُبْحَتِه","result":"لا يَنتَقِصْ أحَدُكُم مِن صَلاتِه شَيئًا إلَّا أتَمَّها اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02029"],"ref":"تخريج المسند لشعيب 23637","srcLabel":"أحمد","text":["حدَّثَني رَجُلٌ، مِن أصْحابِ النبيِّ صلَّى اللهُ عليه وسَلَّمَ مِن الأنصارِ، أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يقولُ: ",["لا يَنتَقِصْ أحَدُكُم مِن صَلاتِه شَيئًا إلَّا أتَمَّها اللهُ",2]," ",["مِن سُبْحَتِه",1],"."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح لغيره،","takhrij":"أخرجه أحمد (23637)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ASiJYXKd"},{"id":"س-03711","fp":"cb34752f9cc5","stateId":541,"easy":"إذا صليت بالتيمم ثم وجدت الماء بعد الوقت ← أصبت السنة وأجزأتك صلاتك","cause":"ولمْ يُعِدِ الآخَرُ","result":"أَصَبْتَ السُّنَّةَ، وأَجْزَأَتْكَ صَلاتُكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 644","srcLabel":"أبو داود","text":["خَرَجَ رَجُلانِ في سَفَرٍ، فَحَضَرَتِ الصَّلاةُ وليس مَعَهُما ماءٌ فَتَيَمَّما صَعيدًا طَيِّبًا، فَصَلَّيا، ثُمَّ وَجَدا الماءَ في الوَقْتِ، فَأَعادَ أَحَدُهُما الصَّلاةَ والوُضوءَ ",["ولمْ يُعِدِ الآخَرُ",1],"، ثُمَّ أَتَيا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فَذَكَرا ذلك له، فقالَ للَّذي لمْ يُعِدْ: «",["أَصَبْتَ السُّنَّةَ، وأَجْزَأَتْكَ صَلاتُكَ",2],"»، وقالَ للَّذي تَوَضَّأَ وأَعادَ: «لَكَ الأَجْرُ مَرَّتَيْنِ»."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (338)، والدارمي (771) كلاهما بلفظه، والنسائي (433) بنحوه.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"hbPEnaR6","merged":4,"otherRefs":["الفتح الرباني 5/2617 (صحيح)","صحيح النسائي 431 (صحيح)","فتاوى نور على الدرب لابن باز 5/349 (صحيح)"]},{"id":"س-07163","fp":"c56c6f3ba972","stateId":542,"easy":"إذا صليت (في غير وقت النهي) ← فالصلاة محضورة متقبلة","cause":"ثمَّ صَلِّ","result":"فالصَّلاةُ مَحْضورةٌ مُتقبَّلةٌ","explicit":true,"similar":["س-04556"],"ref":"صحيح ابن ماجه 1042","srcLabel":"ابن ماجه","text":["سأل صَفوانُ بنُ المُعطَّلِ رَضِيَ اللهُ عنه رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، إنِّي سائِلُكَ عن أمْرٍ أنتَ به عالمٌ، وأنا به جاهلٌ، قال: وما هو؟ قال: هل مِن ساعاتِ اللَّيلَ والنهارِ ساعةٌ تُكرَهُ فيها الصَّلاةُ؟ قال: نعم، إذا صلَّيْتَ الصُّبحَ فدَعِ الصَّلاةَ حتَّى تطلُعَ الشَّمسُ؛ فإنَّها تطلُعُ بقرنَيِ الشَّيطانِ، ",["ثمَّ صَلِّ",1],"؛ ",["فالصَّلاةُ مَحْضورةٌ مُتقبَّلةٌ",2]," حتَّى تستويَ الشمسُ على رأسِكَ كالرُّمْحِ، فإذا كانتْ على رأسِكَ كالرُّمْحِ فدَعِ الصَّلاةَ؛ فإنَّ تلك السَّاعةَ تُسْجَرُ فيها جَهنَّمُ، وتُفتَحُ فيها أبوابُها، حتَّى تَزيغَ الشمسُ عن حاجبِكَ الأيمنِ، فإذا زالتْ فالصَّلاةُ مَحْضورةٌ مُتقبَّلةٌ حتَّى تُصلِّيَ العصرَ، ثمَّ دَعِ الصَّلاةَ حتَّى تَغيبَ الشمسُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1252) واللفظ له، وابن خزيمة (1275) بنحوه، والبيهقي (4444) باختلاف يسير","bab":"علم › حسن السؤال ونصح العالم","dorar":"rbq4KyCv"},{"id":"س-06731","fp":"4ba103d26949","stateId":542,"easy":"إذا صمت الاثنين والخميس ← فهما يومان تُعرض فيهما الأعمال على الله","cause":"يَوْمُ الاثْنَينِ ويَوْمُ الخَميسِ","result":"ذانك يَوْمانِ تُعرَضُ فيهما الأعْمالُ على رَبِّ العالَمينَ، وأُحِبُّ أن يُعرَضَ عَمَلي وأنا صائِمٌ","explicit":true,"star":true,"ref":"الأحاديث المختارة 1356","srcLabel":"البخاري","text":["«كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَصومُ الأيَّامَ يَسرُدُ حتَّى يُقالَ: لا يُفطِرُ، ويُفطِرُ الأيَّامَ حتَّى لا يَكادُ أن يَصومَ إلَّا يَوْمَينِ مِن الجُمُعةِ إن كانا في صِيامِه، وإلَّا صامَهما، ولم يكنْ يَصومُ مِن شَهْرٍ مِن الشُّهورِ ما يَصومُ مِن شَعْبانَ، فقُلْتُ: يا رَسولَ اللهِ تَصومُ لا تَكادُ أن تُفطِرَ، وتُفطِرُ حتَّى لا تَكادُ أن تَصومُ إلَّا يَوْمَينِ إن دَخَلا في صِيامِك وإلَّا صُمْتَهما؟ قالَ: أيُّ يَوْمينِ؟ قالَ: قُلْتُ: ",["يَوْمُ الاثْنَينِ ويَوْمُ الخَميسِ",1],"، قالَ: ",["ذانك يَوْمانِ تُعرَضُ فيهما الأعْمالُ على رَبِّ العالَمينَ، وأُحِبُّ أن يُعرَضَ عَمَلي وأنا صائِمٌ",2],"، قالَ: قُلْتُ: ولم أرَك تَصومُ مِن شَهْرٍ مِن الشُّهورِ ما تَصومُ مِن شَعْبانَ؟ قالَ: ذاك شَهْرٌ يَغفُلُ النَّاسُ عنه بَيْنَ رَجَبٍ ورَمَضانَ، وهو شَهْرٌ تُرفَعُ فيه الأعْمالُ إلى رَبِّ العالَمينَ، فأُحِبُّ أن يُرفَعَ عَمَلي وأنا صائِمٌ»."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صيام › صيامه صلى الله عليه وسلم","dorar":"n4unB1VS","merged":7,"otherRefs":["مسند عمر 2/861 (صحيح)","فتاوى نور على الدرب لابن باز 16/432 (صحيح)","صحيح ابن خزيمة 3/ 521 (صحيح)","نخب الافكار 8/453 (حسن)","فتح الباري لابن حجر 4/278 (صحيح)","صحيح الجامع 1583 (صحيح)"]},{"id":"س-02026","fp":"d31b66817f17","stateId":542,"easy":"إذا صليت أربعاً بعد الزوال قبل الظهر ← يصعد لك فيها عمل صالح","cause":"يُصلِّي أربعًا بعدَ أن تَزولَ الشَّمسُ قبلَ الظُّهرِ","result":"إنَّها ساعةٌ تُفتَحُ فيها أبْوابُ السَّماءِ وأُحبُّ أن يصعدَ لي فيها عملٌ صالحٌ","explicit":true,"star":true,"similar":["س-01979","س-02117","س-06428","س-01901","س-07365"],"ref":"الصحيح المسند 576","srcLabel":"مسلم","text":["أنَّ رسولَ اللَّهِ -صلَّى اللَّهُ عليهِ وعلَى آلِه وسلَّمَ- كانَ ",["يُصلِّي أربعًا بعدَ أن تَزولَ الشَّمسُ قبلَ الظُّهرِ",1]," فقالَ : ",["إنَّها ساعةٌ تُفتَحُ فيها أبْوابُ السَّماءِ وأُحبُّ أن يصعدَ لي فيها عملٌ صالحٌ",2]],"grade":"صحيح","narrator":"عبدالله بن السائب","muhaddith":"حسن على شرط مسلم","takhrij":"أخرجه الترمذي (‌478)، وأحمد (15396)، والنسائي في ((السنن الكبرى)) (329) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"gRJRe15H"},{"id":"س-06732","fp":"2c573274ec8c","stateId":542,"easy":"إذا صمت في شعبان ← تُرفع فيه أعمالك وأنت صائم","cause":"ما تَصومُ مِن شَعْبانَ","result":"شَهْرٌ يَغفُلُ النَّاسُ عنه بَيْنَ رَجَبٍ ورَمَضانَ، وهو شَهْرٌ تُرفَعُ فيه الأعْمالُ إلى رَبِّ العالَمينَ، فأُحِبُّ أن يُرفَعَ عَمَلي وأنا صائِمٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الأحاديث المختارة 1356","srcLabel":"البخاري","text":["«كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَصومُ الأيَّامَ يَسرُدُ حتَّى يُقالَ: لا يُفطِرُ، ويُفطِرُ الأيَّامَ حتَّى لا يَكادُ أن يَصومَ إلَّا يَوْمَينِ مِن الجُمُعةِ إن كانا في صِيامِه، وإلَّا صامَهما، ولم يكنْ يَصومُ مِن شَهْرٍ مِن الشُّهورِ ما يَصومُ مِن شَعْبانَ، فقُلْتُ: يا رَسولَ اللهِ تَصومُ لا تَكادُ أن تُفطِرَ، وتُفطِرُ حتَّى لا تَكادُ أن تَصومُ إلَّا يَوْمَينِ إن دَخَلا في صِيامِك وإلَّا صُمْتَهما؟ قالَ: أيُّ يَوْمينِ؟ قالَ: قُلْتُ: يَوْمُ الاثْنَينِ ويَوْمُ الخَميسِ، قالَ: ذانك يَوْمانِ تُعرَضُ فيهما الأعْمالُ على رَبِّ العالَمينَ، وأُحِبُّ أن يُعرَضَ عَمَلي وأنا صائِمٌ، قالَ: قُلْتُ: ولم أرَك تَصومُ مِن شَهْرٍ مِن الشُّهورِ ",["ما تَصومُ مِن شَعْبانَ",1],"؟ قالَ: ذاك ",["شَهْرٌ يَغفُلُ النَّاسُ عنه بَيْنَ رَجَبٍ ورَمَضانَ، وهو شَهْرٌ تُرفَعُ فيه الأعْمالُ إلى رَبِّ العالَمينَ، فأُحِبُّ أن يُرفَعَ عَمَلي وأنا صائِمٌ",2],"»."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صيام › صيامه صلى الله عليه وسلم","dorar":"n4unB1VS","merged":3,"otherRefs":["نخب الافكار 8/453 (حسن)","الأحاديث المختارة 1319 (صحيح)"]},{"id":"س-01979","fp":"222e1b0b3e30","stateId":542,"easy":"إذا صليت أربعاً قبل الظهر ← فهي ساعة تُفتح فيها أبواب السماء ويرتفع فيها عملك","cause":"يُصلِّي أربَعَ رَكَعاتٍ قَبلَ الظُّهرِ","result":"إنَّها ساعةٌ تُفتَحُ فيها أبْوابُ السَّماءِ، فأحْبَبتُ أنْ يَرتَفِعَ لي فيها عَمَلٌ صالِحٌ","explicit":true,"repOf":"س-02026","ref":"تخريج المسند لشعيب 23551","text":["عن أبي أيُّوبَ الأنصاريِّ: أنَّه كان ",["يُصلِّي أربَعَ رَكَعاتٍ قَبلَ الظُّهرِ",1],"، فقيلَ له: إنَّك تُديمُ هذه الصَّلاةَ، فقال: إنِّي رَأيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَفعَلُه فسَأَلتُه، فقال: ",["إنَّها ساعةٌ تُفتَحُ فيها أبْوابُ السَّماءِ، فأحْبَبتُ أنْ يَرتَفِعَ لي فيها عَمَلٌ صالِحٌ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (23551) واللفظ له، وابن خزيمة (1215)، والطبراني (4/170) (4038)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8UHw86En"},{"id":"س-02117","fp":"e5fbc2ccebb0","stateId":542,"easy":"إذا صليت أربعاً قبل الظهر بعد الزوال ← فإن أبواب السماء تُفتح","cause":"قبْلَ الظُّهرِ بعْدَ الزَّوالِ أربعًا","result":"إنَّ أبوابَ السماءِ تُفْتَحُ","explicit":true,"repOf":"س-02026","ref":"تخريج المسند لشعيب 15396","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يُصلِّي ",["قبْلَ الظُّهرِ بعْدَ الزَّوالِ أربعًا",1],"، ويقولُ: ",["إنَّ أبوابَ السماءِ تُفْتَحُ",2],"، فأُحِبُّ أنْ أُقَدِّمَ فيها عمَلًا صالحًا."],"grade":"صحيح","narrator":"عبدالله بن السائب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (478)، والنسائي في ((السنن الكبرى)) (331)، وأحمد (15396) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Eyk9RmkB"},{"id":"س-04556","fp":"d477ea8c0155","stateId":542,"easy":"إذا طلعت الشمس وارتفعت فصلِّ ← فالصلاة محضورة متقبلة","cause":"فإذا طَلَعَت فصَلِّ","result":"فإنَّ الصَّلاةَ مَحضورةٌ مُتَقَبَّلةٌ","explicit":true,"repOf":"س-07163","ref":"تخريج المسند لشعيب 22661","text":["عن صَفوانَ بنِ المُعَطَّلِ السُّلَميِّ أنَّه سَألَ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال: يا نَبيَّ اللهِ، إنِّي أسألُكَ عَمَّا أنتَ به عالِمٌ، وأنا به جاهِلٌ: مِنَ اللَّيلِ والنَّهارِ ساعةٌ تُكرَهُ فيها الصَّلاةُ؟ فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «إذا صَلَّيتَ الصُّبحَ فأمسِكْ عنِ الصَّلاةِ حَتَّى تَطلُعَ الشَّمسُ، ",["فإذا طَلَعَت فصَلِّ",1],"؛ ",["فإنَّ الصَّلاةَ مَحضورةٌ مُتَقَبَّلةٌ",2]," حَتَّى تَعتَدِلَ على رَأسِكَ مِثلَ الرُّمحِ، فإذا اعتَدَلَت على رَأسِكَ فإنَّ تلك السَّاعةَ تُسجَرُ فيها جَهَنَّمُ وتُفتَحُ فيها أبوابُها، حَتَّى تَزولَ عن حاجِبِكَ الأيمَنِ، فإذا زالَت عن حاجِبِكَ الأيمَنِ فصَلِّ؛ فإنَّ الصَّلاةَ مَحضورةٌ مُتَقَبَّلةٌ حَتَّى تُصَلِّيَ العَصرَ»."],"grade":"صحيح","narrator":"صفوان بن المعطل السلمي","muhaddith":"صحيح","bab":"جهنم › شدة نار جهنم وبعد قعرها","dorar":"E6JJyhly"},{"id":"س-06428","fp":"1f79fc636228","stateId":542,"easy":"إذا صليت ركعات تتمهن وتحسنهن عند الزوال ← تُفتح أبواب السماء ويُرفع عملك","cause":"يركَعُ ركعاتٍ يتمُّهُنَّ ويحسِّنُهُنَّ يتمَكَّنُ فيهنَّ","result":"إنَّ أبوابَ السَّماءِ وأبوابَ الجنانِ تفتحُ في تِلكَ السَّاعةِ فأحبُّ أن يصعَدَ منِّي إلى ربِّي تلكَ السَّاعةَ خَيرٌ","explicit":true,"repOf":"س-02026","ref":"مختصر العلو 31","text":["نزلَ علَيَّ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ شَهْرًا فارتَقبتُ عملَهُ فرأيتُهُ إذا زالتِ الشَّمسُ فلو كانَ في يدِهِ عمَلُ الدُّنيا رفضَهُ وإن كانَ نائمًا فَكَأنَّما يوقَظُ فيقومُ فيغتسِلُ أو يتوضَّأُ ثم ",["يركَعُ ركعاتٍ يتمُّهُنَّ ويحسِّنُهُنَّ يتمَكَّنُ فيهنَّ",1]," فسألتُهُ عن ذلِكَ فقالَ ",["إنَّ أبوابَ السَّماءِ وأبوابَ الجنانِ تفتحُ في تِلكَ السَّاعةِ فأحبُّ أن يصعَدَ منِّي إلى ربِّي تلكَ السَّاعةَ خَيرٌ",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"لموضع الشاهد منه ما يشهد له بسند صحيح","takhrij":"أخرجه أحمد (23532)، والحاكم (5940)، والطيالسي (598) بنحوه.","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"aHMhn4ps"},{"id":"س-01901","fp":"27d8899e29ca","stateId":542,"easy":"إذا صليت أربعاً بعد الزوال ← تُفتح لها أبواب السماء","cause":"أربعَ رَكعاتٍ بعدَ الزَّوالِ","result":"تُفتحُ فيها أبوابُ السَّماءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-02026","ref":"هداية الرواة 1126","text":["كانَ يصلِّي ",["أربعَ رَكعاتٍ بعدَ الزَّوالِ",1]," لا يسلِّمُ إلَّا في آخرِهنَّ . وقالَ: إنَّها ",["تُفتحُ فيها أبوابُ السَّماءِ",2]," فأحِبُّ أن يصعَدَ لي فيها عملٌ صالحٌ ."],"grade":"صحيح","narrator":"عبدالله بن السائب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (478)، وأحمد (15396)، والنسائي في ((الكبرى)) (329) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"b5ICF4Ea"},{"id":"س-07365","fp":"93e0ff5f385c","stateId":542,"easy":"إذا صليت أربعاً قبل الظهر ← فأبواب السماء تُفتح عند الزوال","cause":"يُصلِّي قَبلَ الظُّهرِ أربعًا","result":"إنَّ أبْوابَ السَّماءِ تُفتَحُ إذا زالتِ الشَّمسُ، فلا تُرتَجُ حتى يُصَلَّى الظُّهرُ، فأُحِبُّ أنْ يَصعَدَ لي إلى السَّماءِ خَيرٌ","explicit":true,"repOf":"س-02026","ref":"تخريج المسند لشعيب 23565","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ ",["يُصلِّي قَبلَ الظُّهرِ أربعًا",1],"، فقيلَ له: إنَّك تُصلِّي صَلاةً تُديمُها فقال: ",["إنَّ أبْوابَ السَّماءِ تُفتَحُ إذا زالتِ الشَّمسُ، فلا تُرتَجُ حتى يُصَلَّى الظُّهرُ، فأُحِبُّ أنْ يَصعَدَ لي إلى السَّماءِ خَيرٌ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه من طرق أبو داود (1270) مختصراً، وابن ماجه (1157) باختلاف يسير، وأحمد (23565) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"rkCvy6E3","merged":3,"otherRefs":["الجامع الصغير 917 (صحيح)","الجامع الصغير 7053 (حسن)"]},{"id":"س-06848","fp":"ce85ad5549db","stateId":543,"easy":"إذا تصدقت أو عملت ← فالله طيب لا يقبل إلا طيباً","cause":"إلَّا طَيِّبًا","result":"إنَّ اللَّهَ طَيِّبٌ لا يَقْبَلُ","explicit":true,"ref":"عارضة الأحوذي 5/408","srcLabel":"مسلم","text":["إنَّ اللهَ طيِّبٌ. [يعني حديث: أَيُّها النَّاسُ، ",["إنَّ اللَّهَ طَيِّبٌ لا يَقْبَلُ",2]," ",["إلَّا طَيِّبًا",1],"، وإنَّ اللَّهَ أمَرَ المُؤْمِنِينَ بما أمَرَ به المُرْسَلِينَ، فقالَ: {يَا أَيُّهَا الرُّسُلُ كُلُوا مِنَ الطَّيِّبَاتِ وَاعْمَلُوا صَالِحًا إِنِّي بِمَا تَعْمَلُونَ عَلِيمٌ} [المؤمنون: 51]، وقالَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ} [البقرة: 172]، ثُمَّ ذَكَرَ الرَّجُلَ يُطِيلُ السَّفَرَ أشْعَثَ أغْبَرَ، يَمُدُّ يَدَيْهِ إلى السَّماءِ، يا رَبِّ، يا رَبِّ، ومَطْعَمُهُ حَرامٌ، ومَشْرَبُهُ حَرامٌ، ومَلْبَسُهُ حَرامٌ، وغُذِيَ بالحَرامِ ، فأنَّى يُسْتَجابُ لذلكَ؟!]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1015)، وأحمد (8348)، والدارمي (2759) بلفظه تامًا.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"QsWdQUuL"},{"id":"س-06305","fp":"c16d0d96f529","stateId":543,"easy":"إذا تصدقت من طيب ← يتقبلها الله ويربيها لك","cause":"إنَّ العبدَ إذا تَصدَّقَ مِن طيِّبٍ","result":"تقبَّلَها اللَّهُ منهُ، وأخذَها بيمينِهِ، فربَّاها كما يُربِّي أحدُكُم مُهْرَهُ أو فصيلَهُ","explicit":true,"star":true,"otherNeedIds":[45,1],"ref":"صحيح ابن خزيمة 4/ 156","srcLabel":"متفق عليه","text":[["إنَّ العبدَ إذا تَصدَّقَ مِن طيِّبٍ",1]," ",["تقبَّلَها اللَّهُ منهُ، وأخذَها بيمينِهِ، فربَّاها كما يُربِّي أحدُكُم مُهْرَهُ أو فصيلَهُ",2]," إنَّ الرَّجلَ ليتصدَّقُ باللُّقمةِ، فتَربو في يدِ اللَّهِ أو قالَ: في كَفِّ اللَّهِ حتَّى تَكونَ مثلَ الجبلِ فتصدَّقوا [وفي روايةٍ]: نحوَهُ، وزادَ: وتصديقُ ذلِكَ في كتابِ اللَّهِ {يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ} [البقرة: 276]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (1410)، ومسلم (1014)، والنسائي (2525) باختلاف يسير.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"kxEsYxxw","merged":3,"otherRefs":["علل الدارقطني 1894 (حسن)","مختصر العلو 14 (صحيح)"]},{"id":"س-06318","fp":"ba65561ca7b7","stateId":543,"easy":"إذا تصدقت بنية صالحة فوقعت في يد سارق أو زانية أو غني ← تُقبل صدقتك ولعلها تنفعهم","cause":"اللهُمَّ لكَ الحمدُ على سارِقٍ ، وعلى زانيةٍ ، وعلى غنيٍّ","result":"أمَّا صدَقَتُكَ على سارِقٍ فلَعلَّهُ أنْ يَستَعِفَّ عن سرِقَتِه ، وأمّا الزّانيةُ فلَعلَّها أنْ تَستعِفَّ عن زِناها ، وأمّا الغنيُّ فلَعلَّهُ أنْ يَعتبِرَ فيُنفِقُ مِمّا أعْطاهُ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-02057"],"ref":"صحيح الجامع 4346","srcLabel":"متفق عليه","text":["قال رجلٌ : لَأتَصدَّقَنَّ الليلةَ بِصدَقةٍ ، فخرجَ بِصدقتِه فوَضَعَها في يدِ سارِقٍ ، فأصْبحُوا يَتحدَّثُون : تُصِدِّقَ الليلةَ على سارِقٍ ، فقال : اللهُمَّ لكَ الحمدُ ، على سارِقٍ ! لَأتَصدَّقَنَّ الليلةَ بِصدَقةٍ ، فخرجَ بِصدَقتِه فوضعَها في يدِ زانيةٍ ، فأصبحُوا يَتحدَّثُونَ : تُصِدِّقَ الليلةَ على زانيةٍ ! فقال : اللهُمَّ لكَ الحمْدُ على زانيةٍ ، لَأتَصدَّقَنَّ الليلةَ بِصدَقةٍ ، فخرجَ بِصدَقتِه فوضعَها في يدِ غنيٍّ ، فأصبحُوا يتحدَّثُونَ : تُصِدِّقَ الليلةَ على غَنِيٍّ ، فقال : ",["اللهُمَّ لكَ الحمدُ على سارِقٍ ، وعلى زانيةٍ ، وعلى غنيٍّ",1]," ، فأُتِيَ ، فقِيلَ لهُ : ",["أمَّا صدَقَتُكَ على سارِقٍ فلَعلَّهُ أنْ يَستَعِفَّ عن سرِقَتِه ، وأمّا الزّانيةُ فلَعلَّها أنْ تَستعِفَّ عن زِناها ، وأمّا الغنيُّ فلَعلَّهُ أنْ يَعتبِرَ فيُنفِقُ مِمّا أعْطاهُ اللهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1421) واللفظ له، ومسلم (1022)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"JcFzVSGu","merged":3,"otherRefs":["تخريج المسند لشعيب 8602 (صحيح)","أحكام القرآن لابن العربي 1/317 (صحيح)"]},{"id":"س-02057","fp":"1b5bb4a7a327","stateId":543,"easy":"إذا تصدقت بنية صالحة فوقعت في غير أهلها ← تُقبل صدقتك","cause":"تصدقَ بالليلِ على رجلٍ فصادفَتْ صدقُتُه سارقًا","result":"أما صَدَقَتُكَ على سارقٍ فلعلَّهُ أنْ يسْتَعِفَّ عن سرقتِه وأما صدقتُكَ على زانيةٍ فلعلَّها أنْ تستعِفَّ عن زِنَاها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06318","ref":"تخريج مشكلة الفقر 6","text":["حديثُ الرجلِ الذي ",["تصدقَ بالليلِ على رجلٍ فصادفَتْ صدقُتُه سارقًا",1]," فتحدَّثَ الناسُ بذلِكَ ثُمَّ تَصَدَّقَ مرةً أخرى على امرأةٍ فصادَفَتْ صدقتُهُ زانيَةً فأصبَحَ الناسُ يتحدثون بذلِكَ تُصُدِّقَ الليلَةَ على زانِيَةٍ فجاءَهُ في المنامِ من قال له : ",["أما صَدَقَتُكَ على سارقٍ فلعلَّهُ أنْ يسْتَعِفَّ عن سرقتِه وأما صدقتُكَ على زانيةٍ فلعلَّها أنْ تستعِفَّ عن زِنَاها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1421)، ومسلم (1022)، والنسائي (2523)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"woEWr1hC"},{"id":"س-06341","fp":"de8a2f8c6f0a","stateId":543,"easy":"إذا أضفت الضيف وأطعمت المسكين وأعطيت السائل وبدأت بمن تعول ← كان ذلك تزكية لما أنت فيه","cause":"فلْيُضِفِ الضَّيفَ، ولْيُطعِمِ المِسْكينَ، ولْيُعطِ السَّائلَ، ويَبْدأْ بمَن يَتعَوَّلُ","result":"كانَ تَزْكيةَ ما هو فيه","explicit":true,"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 5450","srcLabel":"الطبراني","text":["عنْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قالَ: يا ابنَ عَوفٍ، إنَّكَ منَ الأغْنياءِ، ولن تَدخُلَ الجنَّةَ إلَّا زَحفًا، فأقْرِضِ اللهَ يُطلِقْ قدَمَيْكَ قالَ ابنُ عَوفٍ: يا رَسولَ اللهِ، فما الَّذي أُقرِضُ اللهَ؟ قالَ: تَتبَرَّأُ ممَّا أنتَ فيه قالَ: يا رَسولَ اللهِ، مِن كلِّه أجمَعَ؟ قالَ: نعمْ، فخرَجَ ابنُ عَوفٍ وهو يهُمُّ بذلك، فأرسَلَ إليه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ: أتاني جِبْريلُ، فقالَ: مُرِ ابنَ عَوفٍ ",["فلْيُضِفِ الضَّيفَ، ولْيُطعِمِ المِسْكينَ، ولْيُعطِ السَّائلَ، ويَبْدأْ بمَن يَتعَوَّلُ",1],"؛ فإنَّه إذا فعَل ذلك ",["كانَ تَزْكيةَ ما هو فيه",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن زنجويه في ((الأموال)) (1366)، والآجري في ((الشريعة)) (5/  2304)، والطبراني في ((مسند الشاميين)) (1616) باختلاف يسير","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"JDKjkNCD"},{"id":"س-02081","fp":"5b3e4dfc8cf9","stateId":543,"easy":"إذا تصدقت على أمك ثم ورثتها ← قُبلت صدقتك ورُدت إليك","cause":"أَعْطَيْتُ أُمِّي حديقَةً في حياتِها","result":"رَدَّ عَلَيْكَ حَدِيقَتَكَ وقَبِلَ صَدَقتَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"مجمع الزوائد 4/235","srcLabel":"البزار","text":["أنَّ رجلًا قال يا رسولَ اللهِ إِنِّي ",["أَعْطَيْتُ أُمِّي حديقَةً في حياتِها",1]," وأَنَّها تُوُفِّيَتْ وَلَمْ تَدَعْ وَارِثًا غَيْرِي فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أحْسِبُهُ قال إنَّ اللهَ تَبَارَكَ وَتَعَالَى ",["رَدَّ عَلَيْكَ حَدِيقَتَكَ وقَبِلَ صَدَقتَكَ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار كما في ((كشف الأستار)) (1313) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"EQR4yYd6"},{"id":"س-07512","fp":"f6c05d7caf2a","stateId":544,"easy":"إذا قلت «الله أكبر كبيراً وسبحان الله بكرة وأصيلاً» ← يصعد كلامك إلى السماء حتى يُفتح له باب","cause":"اللهُ أَكبَرُ كَبيرًا، وسُبْحانَ اللهِ بُكْرةً وأَصيلًا","result":"لقد رَأيْتُ كَلامَك يَصعَدُ إلى السَّماءِ حتَّى فَتَحَ بابًا مِنها فدَخَلَ مِنه","explicit":true,"star":true,"apply":{"k":"say","t":"«الله أكبر كبيراً وسبحان الله بكرة وأصيلاً»"},"similar":["س-00956","س-00848"],"otherNeedIds":[45],"ref":"الأحاديث المختارة 13 / 118","srcLabel":"متفق عليه","text":["«جاءَ رَجُلٌ ناءٍ ونحن في الصَّفِّ خَلْفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فدَخَلَ في الصَّفِّ، ثُمَّ قالَ: ",["اللهُ أَكبَرُ كَبيرًا، وسُبْحانَ اللهِ بُكْرةً وأَصيلًا",1],"، فرَفَعَ المُسلِمونَ رُؤوسَهم فاسْتَنْكَروا الرَّجُلَ، وقالوا: مَن الَّذي يَرفَعُ صَوْتَه فوقَ صَوْتِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فلمَّا انْصَرَفَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ قالَ: مَن هذا العالي الصَّوْتِ؟ قيلَ: هذا يا رَسولَ اللهِ! قالَ: واللهِ! ",["لقد رَأيْتُ كَلامَك يَصعَدُ إلى السَّماءِ حتَّى فَتَحَ بابًا مِنها فدَخَلَ مِنه",2],"»."],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"9ioAuYBz"},{"id":"س-07314","fp":"2c2bccbeddc6","stateId":544,"easy":"إذا قلت بعد الوضوء «سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت...» ← تُكتب في رق وتُختم فلا تُكسر إلى يوم القيامة","cause":"و مَنْ تَوَضَّأَ فقال : سبحانَكَ اللهمَّ و بحمدِكَ [ أشهدُ أنْ ] لا إلهَ إلَّا أنتَ ، أستغفرُكَ و أتوبُ إليكَ","result":"كُتِبَ في رَقٍّ ، ثُمَّ جُعِلَ في طابعٍ ، فلمْ يُكْسَرْ إلى يومِ القيامةِ","explicit":true,"apply":{"k":"say","t":"«سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت...» · الوقت: بعد الوضوء"},"otherNeedIds":[50,45],"ref":"السلسلة الصحيحة 2651","srcLabel":"النسائي","text":["مَنْ قرأَ سورةَ الكهفِ [ كما أُنْزِلَتْ ] كانَتْ لهُ نُورًا يومَ القيامةِ ، من مَقَامِهِ إلى مكةَ ، و مَنْ قرأَ عشرَ آياتٍ من آخِرِها ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ ، ",["و مَنْ تَوَضَّأَ فقال : سبحانَكَ اللهمَّ و بحمدِكَ [ أشهدُ أنْ ] لا إلهَ إلَّا أنتَ ، أستغفرُكَ و أتوبُ إليكَ",1]," ، ",["كُتِبَ في رَقٍّ ، ثُمَّ جُعِلَ في طابعٍ ، فلمْ يُكْسَرْ إلى يومِ القيامةِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455)، والحاكم (2072) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"4Vdm3x5r","merged":2,"otherRefs":["الترغيب والترهيب 2/318 (صحيح)"]},{"id":"س-00956","fp":"eed61d2953f9","stateId":544,"easy":"إذا قلت «الله أكبر كبيراً والحمد لله كثيراً وسبحان الله بكرة وأصيلاً» ← تصعد حتى تُفتح لها أبواب السماء","cause":"اللهُ أكبَرُ كَبيرًا، والحَمدُ للهِ كَثيرًا، وسُبحانَ اللهِ بُكرَةً وأصيلًا","result":"إنِّي لَأنظُرُ إليها تَصعَدُ حتَّى فُتِحَتْ لها أبوابُ السَّماءِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«الله أكبر كبيراً والحمد لله كثيراً وسبحان الله بكرة وأصيلاً»"},"repOf":"س-07512","ref":"تخريج المسند لشعيب 5722","text":["كُنَّا جُلوسًا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال رَجُلٌ: ",["اللهُ أكبَرُ كَبيرًا، والحَمدُ للهِ كَثيرًا، وسُبحانَ اللهِ بُكرَةً وأصيلًا",1],"، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَن قال الكَلِماتِ؟ فقال الرَّجُلُ: أنا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: والذي نَفْسي بيَدِه ",["إنِّي لَأنظُرُ إليها تَصعَدُ حتَّى فُتِحَتْ لها أبوابُ السَّماءِ",2],"، فقال ابنُ عُمَرَ: والَّذي نَفْسي بيَدِه ما تَرَكتُها منذُ سَمِعتُها من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وقال عَونٌ: ما تَرَكتُها منذُ سَمِعتُها من ابنِ عُمَرَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه مسلم (601) ، والترمذي (3592) ، والنسائي (885)، وأحمد (5722) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ln01Adoi","merged":4,"otherRefs":["تخريج المسند لشعيب 18860 (صحيح)","صحيح الترمذي 3592 (صحيح)","شرح ابن ماجه لمغلطاي 3/296 (صحيح)"]},{"id":"س-00734","fp":"5acb0eb0f0dd","stateId":544,"easy":"إذا قلت «لا إله إلا الله» ← ليس لها دون الله حجاب حتى تخلص إليه","cause":"ولا إلهَ إلَّا اللهُ","result":"ليس لها دونَ اللهِ حجابٌ حتَّى تخلُصَ إليه","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01194","otherNeedIds":[29],"ref":"الترغيب والترهيب 2/344","text":["التَّسبيحُ نصفُ الميزانِ الحمدُ للهِ تملؤُه ",["ولا إلهَ إلَّا اللهُ",1]," ",["ليس لها دونَ اللهِ حجابٌ حتَّى تخلُصَ إليه",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3518 )،والطبراني في ((المعجم الكبير)) (13/ 33) (73)،","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"vjRPVe4z"},{"id":"س-01194","fp":"96f6ca3e97f6","stateId":544,"easy":"إذا قلت «لا إله إلا الله» مخلصاً ← تُفتح لها أبواب السماء حتى تصل العرش ما اجتنبت الكبائر","cause":"ما قال عبدٌ لا إلهَ إلَّا اللهُ قطُّ مُخلِصًا","result":"إلَّا فُتِحتْ له أبوابُ السَّماءِ حتَّى يُفضيَ إلى العرشِ ما اجتُنِبت الكبائرُ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-00734"],"ref":"الترغيب والترهيب 2/341","srcLabel":"الترمذي","text":[["ما قال عبدٌ لا إلهَ إلَّا اللهُ قطُّ مُخلِصًا ",1],["إلَّا فُتِحتْ له أبوابُ السَّماءِ حتَّى يُفضيَ إلى العرشِ ما اجتُنِبت الكبائرُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3590)، والنسائي في ((السنن الكبرى)) (10669)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"kCwWzU2n"},{"id":"س-00848","fp":"58e0b261db5a","stateId":544,"easy":"إذا قلت «الله أكبر كبيراً والحمد لله كثيراً وسبحان الله بكرة وأصيلاً» ← تُفتح لها أبواب السماء","cause":"اللهُ أكبرُ كبيرًا ، والحمدُ للهِ كثيرًا ، وسبحانَ اللهِ وبحمدِه بكرةً وأصيلًا","result":"لقد رأيتُ أبوابَ السماءِ فُتِحَتْ فما تَناهى دونَها العرشُ","explicit":true,"apply":{"k":"say","t":"«الله أكبر كبيراً والحمد لله كثيراً وسبحان الله بكرة وأصيلاً»"},"repOf":"س-07512","otherNeedIds":[48],"ref":"إتحاف الخيرة المهرة 2/157","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يصلِّي فدخَل رجلٌ ، فقال : ",["اللهُ أكبرُ كبيرًا ، والحمدُ للهِ كثيرًا ، وسبحانَ اللهِ وبحمدِه بكرةً وأصيلًا",1]," ، فلما صلَّى قال : مَنِ القائلُ هذه الكلماتِ قال الرجلُ : أنا يا رسولَ اللهِ ، وما أردتُ بهِنَّ إلا خيرًا فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["لقد رأيتُ أبوابَ السماءِ فُتِحَتْ فما تَناهى دونَها العرشُ",2]],"grade":"حسن","narrator":"وائل الطائي","muhaddith":"إسناده رجاله ثقات","takhrij":"أخرجه الطيالسي  (1116) واللفظ له، والطبراني (55) (22/ 26) باختلاف يسير","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"YsY9VsRK"},{"id":"ق-1402","fp":"07862568e964","stateId":545,"easy":"الصبر والعمل الصالح ← سعي مشكور وجزاء","cause":"الصبر والعمل الصالح","result":"سعي مشكور وجزاء","explicit":true,"star":true,"otherNeedIds":[45],"ref":"سورة الإنسان: 22","srcLabel":"القرآن الكريم","quran":{"s":76,"from":22,"to":22,"text":"إِنَّ هَذَا كَانَ لَكُمْ جَزَاءً وَكَانَ سَعْيُكُمْ مَشْكُورًا (22)","hl":[[0,32,2],[32,52,1],[52,62,2]]}},{"id":"س-01853","fp":"7e4a7467c8ac","stateId":545,"easy":"إذا ذبحت أضحيتك بعد صلاة العيد ← تم نسكك وأصبت السنة","cause":"مَن ذَبَحَ بَعدَ الصَّلاةِ","result":"فقد تَمَّ نُسُكُه وأصابَ سُنَّةَ المُسلِمينَ","explicit":true,"star":true,"ref":"صحيح البخاري 5556","srcLabel":"متفق عليه","text":["ضَحَّى خالٌ لي يُقالُ له أبو بُردةَ، قَبلَ الصَّلاةِ، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: شاتُكَ شاةُ لَحمٍ، فقال: يا رَسولَ اللهِ، إنَّ عِندي داجِنًا جَذَعةً مِنَ المعزِ، قال: اذبَحْها، ولَن تَصلُحَ لغَيرِكَ، ثُمَّ قال: مَن ذَبَحَ قَبلَ الصَّلاةِ فإنَّما يَذبَحُ لنَفسِه، و",["مَن ذَبَحَ بَعدَ الصَّلاةِ",1]," ",["فقد تَمَّ نُسُكُه وأصابَ سُنَّةَ المُسلِمينَ",2],"، تابَعَه عُبَيدةُ، عَنِ الشَّعبيِّ، وإبراهيمَ، وتابَعَه وكيعٌ، عن حُرَيثٍ، عَنِ الشَّعبيِّ، وقال عاصِمٌ، وداوُدُ، عَنِ الشَّعبيِّ: عِندي عَناقُ لَبَنٍ، وقال زُبَيدٌ، وفِراسٌ، عَنِ الشَّعبيِّ: عِندي جَذَعةٌ، وقال أبو الأحوصِ: حَدَّثَنا مَنصورٌ: عَناقٌ جَذَعةٌ، وقال ابنُ عَونٍ: عَناقٌ جَذَعٌ، عَناقُ لَبَنٍ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري(5556)، ومسلم (1961)","bab":"إحسان › الأخذ بالرخصة","dorar":"VRPKck0I","merged":2,"otherRefs":["صحيح مسلم 1961 (صحيح)"]},{"id":"ق-1194","fp":"1bb12f32e4ff","stateId":545,"easy":"برّ الوالدين والشكر والدعاء بصلاح الذرية والتوبة ← قبول أحسن العمل والتجاوز عن السيئات والجنة","cause":"برّ الوالدين والشكر والدعاء بصلاح الذرية والتوبة","result":"قبول أحسن العمل والتجاوز عن السيئات والجنة","explicit":true,"star":true,"otherNeedIds":[11,67,38],"ref":"سورة الأحقاف: 15–16","srcLabel":"القرآن الكريم","quran":{"s":46,"from":15,"to":16,"text":"وَوَصَّيْنَا الْإِنْسَانَ بِوَالِدَيْهِ إِحْسَانًا حَمَلَتْهُ أُمُّهُ كُرْهًا وَوَضَعَتْهُ كُرْهًا وَحَمْلُهُ وَفِصَالُهُ ثَلَاثُونَ شَهْرًا حَتَّى إِذَا بَلَغَ أَشُدَّهُ وَبَلَغَ أَرْبَعِينَ سَنَةً قَالَ رَبِّ أَوْزِعْنِي أَنْ أَشْكُرَ نِعْمَتَكَ الَّتِي أَنْعَمْتَ عَلَيَّ وَعَلَى وَالِدَيَّ وَأَنْ أَعْمَلَ صَالِحًا تَرْضَاهُ وَأَصْلِحْ لِي فِي ذُرِّيَّتِي إِنِّي تُبْتُ إِلَيْكَ وَإِنِّي مِنَ الْمُسْلِمِينَ (15) أُولَئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا وَنَتَجَاوَزُ عَنْ سَيِّئَاتِهِمْ فِي أَصْحَابِ الْجَنَّةِ وَعْدَ الصِّدْقِ الَّذِي كَانُوا يُوعَدُونَ (16)","hl":[[141,417,1],[417,582,2]]}},{"id":"س-07084","fp":"e82f47a13a03","stateId":545,"easy":"إذا نذرت ← فالنذر ما ابتُغي به وجه الله","cause":"ما ابتُغِيَ بِهِ وجهُ اللَّهِ عزَّ وجلَّ","result":"إنَّما النَّذرُ","explicit":true,"ref":"تخريج المسند لشاكر 11/7","srcLabel":"أبو داود","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أدرَكَ رجُلَيْنِ وَهُما مُقتَرِنانِ ، يَمشيانِ إلى البيتِ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ما بالُ القِرانِ ؟ قالا : يا رسولَ اللَّهِ ، نَذَرنا أن نمشيَ إلى البيتِ مُقترنينِ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : لَيسَ هذا نذرًا فقَطعَ قرانَهُما ، قالَ سُرَيْجٌ في حديثِهِ : ",["إنَّما النَّذرُ",2]," ",["ما ابتُغِيَ بِهِ وجهُ اللَّهِ عزَّ وجلَّ",1]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6714) واللفظ له، وأبو داود (3273) مختصرا، والفاكهي في ((أخبار مكة)) (444) بنحوه.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"BkOS5IVy","merged":2,"otherRefs":["تخريج المسند لشاكر 11/166 (صحيح)"]},{"id":"س-02019","fp":"2eaf2c063c53","stateId":545,"easy":"إذا أرضيت عمال الزكاة ← فتمام زكاتكم رضاهم","cause":"وأَرْضوهم","result":"فإنَّ تَمامَ زَكاتِكم رِضاهم","explicit":true,"ref":"الأحكام الوسطى 2/ 184","srcLabel":"أبو داود","text":["سيَأتيكم رَكْبٌ مُبَغَّضونَ، فإن جاؤوكم فرَحِّبوا بِهم، وخَلُّوا بَيْنَهم وبَيْنَ ما يَبْتَغونَ، فإن عَدَلوا فلِأنْفُسِهم، وإن ظَلَموا فعليها، ",["وأَرْضوهم",1],"؛ ",["فإنَّ تَمامَ زَكاتِكم رِضاهم",2],"، ولْيَدْعوا لكم."],"grade":"صحيح","narrator":"جابر بن عتيك","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (1588) و واللفظ لهما، والبيهقي (7454) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"EVk8QgyV"},{"id":"س-05767","fp":"096b57c0d932","stateId":545,"easy":"إذا طيّبت فمك بالسواك ← فهي طرق القرآن","cause":"طيِّبُوا أفواهَكُم بالسواكِ","result":"فإِنَّها طُرُقُ القرآنِ","explicit":true,"otherNeedIds":[18],"ref":"صحيح الجامع 3939","srcLabel":"صحيح الجامع","text":[["طيِّبُوا أفواهَكُم بالسواكِ",1]," ، ",["فإِنَّها طُرُقُ القرآنِ",2]],"grade":"صحيح","narrator":"سمرة بن جندب وعلي بن أبي طالب","muhaddith":"صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"gSLKIgTj"}]}