{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":22,"stateIds":[193,194,195,196,197,198,199,200,201,202,203,204,205,206,207,208,209,210,211],"items":[{"id":"ق-0526","fp":"33b4d55174ef","stateId":193,"easy":"السبق إلى الإيمان واتباع السابقين بإحسان ← رضا الله وجنات خالدين فيها والفوز العظيم","cause":"السبق إلى الإيمان واتباع السابقين بإحسان","result":"رضا الله وجنات خالدين فيها والفوز العظيم","explicit":true,"star":true,"otherNeedIds":[55,46],"ref":"سورة التوبة: 100","srcLabel":"القرآن الكريم","quran":{"s":9,"from":100,"to":100,"text":"وَالسَّابِقُونَ الْأَوَّلُونَ مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ وَأَعَدَّ لَهُمْ جَنَّاتٍ تَجْرِي تَحْتَهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ذَلِكَ الْفَوْزُ الْعَظِيمُ (100)","hl":[[0,254,1]]}},{"id":"ق-0743","fp":"6a914b8f4de7","stateId":193,"easy":"العمل الصالح الخالص من الشرك ← لقاء الله (لمن يرجوه)","cause":"العمل الصالح الخالص من الشرك","result":"لقاء الله (لمن يرجوه)","explicit":true,"star":true,"otherNeedIds":[56],"ref":"سورة الكهف: 110","srcLabel":"القرآن الكريم","quran":{"s":18,"from":110,"to":110,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَى إِلَيَّ أَنَّمَا إِلَهُكُمْ إِلَهٌ وَاحِدٌ فَمَنْ كَانَ يَرْجُو لِقَاءَ رَبِّهِ فَلْيَعْمَلْ عَمَلًا صَالِحًا وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِ أَحَدًا (110)","hl":[[88,197,1]]}},{"id":"ق-1239","fp":"57287f0bb1a9","stateId":193,"easy":"البيعة مع صدق ما في القلب ← رضا الله وإنزال السكينة وفتح قريب ومغانم كثيرة","cause":"البيعة مع صدق ما في القلب","result":"رضا الله وإنزال السكينة وفتح قريب ومغانم كثيرة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[5,38,1],"ref":"سورة الفتح: 18–19","srcLabel":"القرآن الكريم","quran":{"s":48,"from":18,"to":19,"text":"لَقَدْ رَضِيَ اللَّهُ عَنِ الْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ الشَّجَرَةِ فَعَلِمَ مَا فِي قُلُوبِهِمْ فَأَنْزَلَ السَّكِينَةَ عَلَيْهِمْ وَأَثَابَهُمْ فَتْحًا قَرِيبًا (18) وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَا وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا (19)","hl":[[0,217,1]]}},{"id":"س-04753","fp":"17394808c123","stateId":193,"easy":"إذا فارقت الدنيا مخلصاً لله مقيماً للصلاة مؤتياً للزكاة ← تفارقها والله عنك راضٍ","cause":"مَنْ فارَقَ الدُّنيا على الإخلاصِ للهِ وحْدَهُ لا شريكَ له، وإقامِ الصَّلاةِ، وإيتاءِ الزَّكاةِ","result":"فارَقَها واللهُ عنه راضٍ","explicit":true,"otherNeedIds":[51],"ref":"المستدرك على الصحيحين 3319","srcLabel":"ابن ماجه","text":["«",["مَنْ فارَقَ الدُّنيا على الإخلاصِ للهِ وحْدَهُ لا شريكَ له، وإقامِ الصَّلاةِ، وإيتاءِ الزَّكاةِ",1],"، ",["فارَقَها واللهُ عنه راضٍ",2],"، وهو دينُ اللهِ الَّذي جاءتْ به الرُّسلُ، وبلَّغوهُ عنْ ربِّهِم قبلَ مَرْجِ الأحاديثِ، واختلافِ الأهواءِ، وتَصديقُ ذلك في كتابِ اللهِ: {فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ} [التوبة: 5]، وقولُهُ عزَّ وجلَّ: {فَإِنْ تَابُوا} [التوبة: 5] يقولُ: خلَعوا الأوثانَ وعِبادَتَها. {وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ} [التوبة: 5]. وقالَ عزَّ وجلَّ في آيةٍ أُخرى: {فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَإِخْوَانُكُمْ فِي الدِّينِ} [التوبة: 11]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (70) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (6440)، والبزار (6524) بنحوه","bab":"رقائق وزهد › الإخلاص","dorar":"ilanwGiE"},{"id":"س-06843","fp":"6a838c741a60","stateId":193,"easy":"إذا قلت «لا إله إلا الله» ← تمنعك من سخط الله","cause":"لا إلهَ إلَّا اللهُ","result":"تمنَعُ [ العبدَ ] مِنْ سخَطِ اللهِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"otherNeedIds":[30],"ref":"مجمع الزوائد 7/280","srcLabel":"ابن أبي الدنيا","text":[["لا إلهَ إلَّا اللهُ",1]," ",["تمنَعُ [ العبدَ ] مِنْ سخَطِ اللهِ",2]," مَا لَمْ يُؤْثِرُوا سَفْعَةَ دنياهم على دينِهِم فإِذَا فعَلُوا ذَلِكَ ثم قالوا لَا إِلَهَ إلَّا اللهُ قال اللهُ كَذَبْتُمْ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن أبي الدنيا في ((العقوبات)) (6)، والبزار كما في ((مجمع الزوائد)) (7/280) واللفظ له، وأبو يعلى (4034)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jDMn61nP"},{"id":"س-02487","fp":"b9d44f3ed384","stateId":193,"easy":"إذا عبدت الله ولم تشرك واعتصمت بحبله ونصحت لولاة أمرك ← يرضى الله عنك","cause":"ثَلاثًا، ويَكرَهُ لكم ثَلاثًا، فيَرضى لكم: أن تَعبُدوه ولا تُشرِكوا به شيئًا، وأن تَعتَصِموا بحَبلِ اللهِ جَميعًا ولا تَفَرَّقوا، ويَكرَهُ لكم: قيلَ وقال، وكَثرةَ السُّؤالِ، وإضاعةَ المالِ","result":"إنَّ اللهَ يَرضى لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02489"],"ref":"صحيح مسلم 1715","srcLabel":"متفق عليه","text":[["إنَّ اللهَ يَرضى لكم",2],[" ثَلاثًا، ويَكرَهُ لكم ثَلاثًا، فيَرضى لكم: أن تَعبُدوه ولا تُشرِكوا به شيئًا، وأن تَعتَصِموا بحَبلِ اللهِ جَميعًا ولا تَفَرَّقوا، ويَكرَهُ لكم: قيلَ وقال، وكَثرةَ السُّؤالِ، وإضاعةَ المالِ",1],". وفي روايةٍ: مِثلَه، غيرَ أنَّه قال: ويَسخَطُ لكم ثَلاثًا، ولَم يَذكُرْ: ولا تَفَرَّقوا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"Y8yHPARZ"},{"id":"س-02489","fp":"a10220d8c44d","stateId":193,"easy":"إذا عبدت الله ولم تشرك ونصحت لولاة أمرك ← فهو ما رضيه الله لك","cause":"أنْ تَعبُدوه ولا تُشرِكوا به شيئًا، وأنْ تَنصَحوا لِمَن ولَّاه اللهُ أَمرَكم، وأنْ تَعتَصِموا بحَبْلِ اللهِ جميعًا، ولا تَفَرَّقوا","result":"رَضِيَ لكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02487","ref":"تخريج المسند لشعيب 8718","text":["إنَّ الله عزَّ وجَلَّ ",["رَضِيَ لكم",2]," ثلاثًا، وكَرِهَ لكم ثلاثًا: رَضِيَ لكم ",["أنْ تَعبُدوه ولا تُشرِكوا به شيئًا، وأنْ تَنصَحوا لِمَن ولَّاه اللهُ أَمرَكم، وأنْ تَعتَصِموا بحَبْلِ اللهِ جميعًا، ولا تَفَرَّقوا",1],"، وكَرِهَ لكم: قيلَ وقال، وكثرةَ السؤالِ، وإضاعةَ المالِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (1715)، وأحمد (8718) واللفظ له","bab":"إمامة وخلافة › النصح لأئمة المسلمين وولاتهم","dorar":"dRjVB6Nf"},{"id":"س-00582","fp":"718ca99a9291","stateId":194,"easy":"إذا تبت ← يفرح الله بتوبتك","cause":"بتَوبةِ أحدِكم","result":"لَلَّهُ أفرَحُ","explicit":true,"star":true,"similar":["س-06875"],"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 3627","srcLabel":"متفق عليه","text":["حدَّثَنا عبدُ اللهِ حديثَينِ: أحدُهما عن نفْسِه، والآخَرُ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: قال عبدُ اللهِ: إنَّ المؤمنَ يَرى ذُنوبَه كأنَّه في أَصلِ جَبلٍ يَخافُ أنْ يقَعَ عليه، وإنَّ الفاجرَ يَرى ذُنوبَه كذُبابٍ وقَعَ على أنْفِه، فقال له هكذا، فطار\".\nقال: وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"",["لَلَّهُ أفرَحُ",2]," ",["بتَوبةِ أحدِكم",1],"، مِن رَجُلٍ خرَجَ بأَرضٍ دَوِّيَّةٍ مَهلَكةٍ، معه راحِلتُه عليها طعامُه وشرابُه وزادُه وما يُصلِحُه، فأضَلَّها، فخرَجَ في طَلبِها، حتى إذا أدرَكَه المَوتُ فلم يجِدْها، قال: أرجِعُ إلى مَكاني الذي أضلَلْتُها فيه، فأَموتُ فيه، قال: فأَتى مَكانَه، فغلَبَتْه عينُه، فاستَيقَظَ، فإذا راحِلتُه عندَ رأْسِه، عليها طعامُه وشرابُه وزادُه وما يُصلِحُه\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"الحديث الموقوف: أخرجه البخاري (6308)، والترمذي (2497)، وأحمد (3627). والحديث المرفوع: أخرجه البخاري (6308)، ومسلم (2744)، والترمذي (2498)، والنسائي في ((السنن الكبرى)) (7742)، وأحمد (3627)","bab":"آداب عامة › ضرب الأمثال","dorar":"3Iayf7wS","merged":3,"otherRefs":["تخريج صحيح ابن حبان 618 (صحيح)","صحيح ابن ماجه 3444 (صحيح)"]},{"id":"س-06875","fp":"eff64f0e745d","stateId":194,"easy":"إذا تبت ← فالله أفرح بتوبتك","cause":"بتَوْبَةِ عَبْدِهِ","result":"لَلَّهُ أفْرَحُ","explicit":true,"repOf":"س-00582","otherNeedIds":[11],"ref":"العواصم من القواصم 224","text":["حديث: الضَّحِكُ والفَرَحُ [يعني حديث: أنَّ رَسولَ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ قَالَ: يَضْحَكُ اللَّهُ إلى رَجُلَيْنِ يَقْتُلُ أحَدُهُما الآخَرَ يَدْخُلَانِ الجَنَّةَ: يُقَاتِلُ هذا في سَبيلِ اللَّهِ، فيُقْتَلُ، ثُمَّ يَتُوبُ اللَّهُ علَى القَاتِلِ، فيُسْتَشْهَدُ.]             [وحديث: إنَّ المُؤْمِنَ يَرَى ذُنُوبَهُ كَأنَّهُ قاعِدٌ تَحْتَ جَبَلٍ يَخافُ أنْ يَقَعَ عليه، وإنَّ الفاجِرَ يَرَى ذُنُوبَهُ كَذُبابٍ مَرَّ علَى أنْفِهِ فقالَ به هَكَذا، قالَ أبو شِهابٍ: بيَدِهِ فَوْقَ أنْفِهِ. ثُمَّ قالَ: ",["لَلَّهُ أفْرَحُ",2]," ",["بتَوْبَةِ عَبْدِهِ",1]," مِن رَجُلٍ نَزَلَ مَنْزِلًا وبِهِ مَهْلَكَةٌ ، ومعهُ راحِلَتُهُ ، عليها طَعامُهُ وشَرابُهُ، فَوَضَعَ رَأْسَهُ فَنامَ نَوْمَةً، فاسْتَيْقَظَ وقدْ ذَهَبَتْ راحِلَتُهُ ، حتَّى إذا اشْتَدَّ عليه الحَرُّ والعَطَشُ أوْ ما شاءَ اللَّهُ، قالَ: أرْجِعُ إلى مَكانِي، فَرَجَعَ فَنامَ نَوْمَةً، ثُمَّ رَفَعَ رَأْسَهُ، فإذا راحِلَتُهُ عِنْدَهُ.]"],"grade":"صحيح","narrator":"[أبو هريرة]   [عبدالله بن مسعود]","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3l1JaNIH","merged":19,"otherRefs":["تخريج المسند لشعيب 10498 (صحيح)","تخريج المسند لشعيب 18423 (صحيح)","المستدرك على الصحيحين 7819 (صحيح)","تخريج صحيح ابن حبان 617 (صحيح)","تخريج المسند لشعيب 10909 (صحيح)","صحيح ابن حبان 621 (صحيح)","تخريج المسند لشعيب 11791 (صحيح)","تخريج المسند لشعيب 18408 (صحيح)","تخريج المسند لشعيب 18492 (صحيح)","صحيح الجامع 5033 (صحيح)","صحيح مسلم 2745 (صحيح)","مجموع الفتاوى 7/445 (صحيح)","صحيح مسلم 2744 (صحيح)","معجم الشيوخ 2/950 (صحيح)","مجمع الزوائد 10/199 (صحيح)","صحيح البخاري 6309 (صحيح)","صحيح الجامع 5030 (صحيح)","صحيح الجامع 5031 (صحيح)"]},{"id":"س-03128","fp":"9ef0c9fb63c8","stateId":195,"easy":"إذا قلت «لا إله إلا أنت، إني ظلمت نفسي فاغفر لي...» ← يعجب الله منك","cause":"إذا قالَ: لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ","result":"إنَّ اللهَ ليَعْجبُ إلى العبدِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ»"},"otherNeedIds":[11,21],"ref":"المستدرك على الصحيحين 2517","srcLabel":"مسلم","text":["عنْ عَليّ بنِ رَبيعةَ أَنَّهُ كَانَ رِدْفًا لعَليٍّ رَضيَ اللهُ عنه، فلمَّا وَضَعَ رِجلَهُ في الرِّكابِ قالَ: باسمِ اللهِ، فلمَّا اسْتَوى على ظَهْرِ الدَّابَّةِ، قالَ: الحمدُ للهِ ثلاثًا، واللهُ أكبرُ ثلاثًا، {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ} [الزخرف: 13] الآيةَ، ثُمَّ قالَ: لا إلَهَ إلَّا أنتَ سُبحانَكَ، قد ظَلمتُ نَفسي فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ، ثُمَّ مالَ إلى أَحدِ شِقَّيهِ فضَحِكَ، فقلتُ: يا أميرَ المؤمنينَ، ما يُضحِكُكَ؟ قالَ: إنِّي كنتُ رِدْفَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فصَنَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ كما صَنعتُ، فسَألتُهُ كما سَألْتَني، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إنَّ اللهَ ليَعْجبُ إلى العبدِ",2]," ",["إذا قالَ: لا إلَهَ إلَّا أنتَ، إنِّي قد ظَلمتُ نَفسي، فاغفِرْ لي ذُنوبي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنتَ",1],"، قالَ: عَبدي عَرَفَ أنَّ له ربًّا يَغفِرُ ويُعاقِبُ."],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح على شرط مسلم [وله شاهد]","takhrij":"أخرجه أبو داود (2602)، والترمذي (3446)، وأحمد (930) جميعهم بلفظ مقارب.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"aASAcGPW","merged":6,"otherRefs":["الكلم الطيب 173 (صحيح)","هداية الرواة 2368 (صحيح)","الكامل في الضعفاء 2/138 (حسن)","تخريج المسند لشاكر 2/110 (صحيح)","الأحاديث المختارة 677 (صحيح)"]},{"id":"س-03147","fp":"63c0db1b7bb4","stateId":196,"easy":"إذا كنت راعياً في جبل تؤذن وتصلي ← يغفر الله لك ويدخلك الجنة","cause":"راعي غَنَمٍ في رَأسِ الشَّظيَّةِ للجَبَلِ يُؤذِّنُ بالصَّلاةِ ويُصلِّي","result":"قد غَفَرتُ له وأدخَلتُهُ الجَنَّةَ","explicit":true,"star":true,"otherNeedIds":[11,55,21],"ref":"تخريج المسند لشعيب 17443","srcLabel":"أبو داود","text":["يَعجَبُ ربُّك... فذكَرَ مَعناهُ، إلَّا أنَّه قال: يَخافُ مِنِّي؟! قد غَفَرْتُ له، فأَدخَلْتُه الجَنَّةَ. [أي مَعْنى حديثِ: يَعجَبُ ربُّك من ",["راعي غَنَمٍ في رَأسِ الشَّظيَّةِ للجَبَلِ يُؤذِّنُ بالصَّلاةِ ويُصلِّي",1],"، فيقولُ اللهُ: انْظُروا إلى عَبْدي هذا، يُؤذِّنُ ويُقيمُ، يخافُ شَيئًا؟ ",["قد غَفَرتُ له وأدخَلتُهُ الجَنَّةَ",2],"]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1203)، والنسائي (666)، وأحمد (17443) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"k0woA5nI","merged":3,"otherRefs":["تخريج كتاب السنة 572 (حسن)","صحيح الجامع 8102 (صحيح)"]},{"id":"س-02851","fp":"ada55f04c410","stateId":196,"easy":"إذا أحسنت الصلاة في العلانية والسر ← يقول الله: هذا عبدي حقاً","cause":"إنَّ العَبْدَ إذا صلَّى في العَلانيَةِ فأَحسَنَ، ثُمَّ صلَّى في السِّرِّ فأَحسَنَ","result":"قالَ اللهُ تَبارَكَ وتَعالى: هذا عَبْدي حَقًّا","explicit":true,"star":true,"ref":"الأحكام الوسطى 4/ 277","srcLabel":"ابن ماجه","text":["\"",["إنَّ العَبْدَ إذا صلَّى في العَلانيَةِ فأَحسَنَ، ثُمَّ صلَّى في السِّرِّ فأَحسَنَ، ",1],["قالَ اللهُ تَبارَكَ وتَعالى: هذا عَبْدي حَقًّا\"",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن ماجه (4200) بلفظه.","bab":"إيمان › الوعد","dorar":"4qAPkeo1"},{"id":"س-06720","fp":"f4117bb8d105","stateId":196,"easy":"إذا قضيت فريضة وجلست تنتظر أخرى ← يباهي الله بك الملائكة","cause":"مَلائكتَه بمَن قَضى فَريضةً وجلَسَ يَنتَظِرُ أُخْرى","result":"أنَّ اللهَ يُباهي","explicit":true,"ref":"تخريج زاد المعاد 1/394","srcLabel":"ابن ماجه","text":[["أنَّ اللهَ يُباهي",2],[" مَلائكتَه بمَن قَضى فَريضةً وجلَسَ يَنتَظِرُ أُخْرى",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (801)، وأحمد (6750)، والبزار (2365)، والطبراني (13/ 588) (14502) واللفظ لهم مطولا.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"08jy5rSu"},{"id":"س-03103","fp":"b38bb09ad58f","stateId":196,"easy":"إذا قمت الليل تصلي أو اصطففت في الصلاة أو في القتال ← يضحك الله إليك","cause":"الرَّجلُ إذا قام باللَّيلِ يصلِّي والقومُ إذا صَفُّوا في الصلاةِ والقومُ إذا صَفُّوا في قتالِ العدوِّ","result":"ثلاثةٌ يضحكُ اللَّهُ إليهمْ","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"هداية الرواة 2/46","srcLabel":"أحمد","text":[["ثلاثةٌ يضحكُ اللَّهُ إليهمْ",2]," ",["الرَّجلُ إذا قام باللَّيلِ يصلِّي والقومُ إذا صَفُّوا في الصلاةِ والقومُ إذا صَفُّوا في قتالِ العدوِّ",1]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه ابن أبي شيبة (19663)، وابن أبي عاصم في ((الجهاد)) (140) واللفظ لهما، وأحمد (11761) باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"7mkRa9O0"},{"id":"س-06508","fp":"1928a6c8f5ab","stateId":196,"easy":"إذا صليت في أول الوقت ← فهو رضوان الله","cause":"الوقتُ الأوَّلُ منَ الصَّلاةِ","result":"رضوانُ اللَّهِ","explicit":true,"ref":"هداية الرواة 1/297","srcLabel":"الترمذي","text":[["الوقتُ الأوَّلُ منَ الصَّلاةِ",1]," ",["رضوانُ اللَّهِ",2]," والوقتُ الآخِرُ عفوُ اللَّهِ"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (172) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (7/148)، والبيهقي (2131) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"bOC7wao8"},{"id":"س-00930","fp":"1d50307074c2","stateId":197,"easy":"إذا لازمت المساجد للصلاة والذكر ← يفرح الله بك كما يفرح أهل الغائب بقدومه","cause":"ما تَوَطَّنَ رجلٌ مسلمٌ المساجِدَ للصلاةِ والذكْرِ","result":"إلَّا تَبَشْبَشَ اللهُ لَهُ منْ حينِ يَخْرُجُ مِنْ بَيْتِهِ ، كَمَا يتَبَشْبَشُ أهلُ الغائِبِ بغائِبِهِمْ ، إذا قدِمَ علَيْهم","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"similar":["س-03138"],"ref":"الجامع الصغير 7861","srcLabel":"ابن ماجه","text":[["ما تَوَطَّنَ رجلٌ مسلمٌ المساجِدَ للصلاةِ والذكْرِ ،",1]," ",["إلَّا تَبَشْبَشَ اللهُ لَهُ منْ حينِ يَخْرُجُ مِنْ بَيْتِهِ ، كَمَا يتَبَشْبَشُ أهلُ الغائِبِ بغائِبِهِمْ ، إذا قدِمَ علَيْهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (8332)،  وابن ماجه (800)، وابن الجعد في ((مسنده)) (2838) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"TmlZfhSf","merged":2,"otherRefs":["صحيح الترغيب 327 (صحيح)"]},{"id":"س-02006","fp":"1933a8df2924","stateId":197,"easy":"إذا كنت تلازم المساجد فشغلك أمر ثم عدت ← يفرح الله بعودتك كما يفرح أهل الغائب","cause":"ما مِن رجُلٍ كانَ يوطِّنُ المساجِدَ فشغلَهُ أمرٌ أو علَّةٌ، ثُمَّ عادَ إلى ما كانَ","result":"إلَّا تَبشَبشَ اللَّهُ إليهِ كما يتَبَشبَشُ أَهْلُ الغائبِ بغائبِهِم إذا قدِمَ","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"صحيح ابن خزيمة 1/ 451","srcLabel":"أحمد","text":[["ما مِن رجُلٍ كانَ يوطِّنُ المساجِدَ فشغلَهُ أمرٌ أو علَّةٌ، ثُمَّ عادَ إلى ما كانَ",1]," ",["إلَّا تَبشَبشَ اللَّهُ إليهِ كما يتَبَشبَشُ أَهْلُ الغائبِ بغائبِهِم إذا قدِمَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجة (800)، وأحمد (9841)، والحاكم (771) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"F8dPH0bl"},{"id":"س-03138","fp":"dfd7dfe04e5a","stateId":197,"easy":"إذا لازمت المسجد للصلاة والذكر ← يفرح الله بك كما يفرح أهل الغائب بقدومه","cause":"لا يُوطِّنُ الرَّجُلُ المسجِدَ للصَّلاةِ أو لذِكْرِ اللهِ","result":"إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهلُ الغائبِ إذا قدِم عليهم غائبُهم","explicit":true,"repOf":"س-00930","ref":"تخريج صحيح ابن حبان 1607","text":[["لا يُوطِّنُ الرَّجُلُ المسجِدَ للصَّلاةِ أو لذِكْرِ اللهِ",1]," ",["إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهلُ الغائبِ إذا قدِم عليهم غائبُهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح، على شرط الشيخين","takhrij":"أخرجه ابن حبان (1607) واللفظ له، وابن ماجه (800)، وأحمد (9841) كلاهما باختلاف يسير.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"tWEiJt1Q"},{"id":"س-06841","fp":"d1f50a28ffa4","stateId":197,"easy":"إذا صليت في جماعة ← يعجب الله منك","cause":"الصَّلاةِ في الجمعِ","result":"إنَّ اللَّهَ تبارَكَ وتعالى ليَعجبُ منَ","explicit":true,"ref":"الترغيب والترهيب 1/200","srcLabel":"أحمد","text":[["إنَّ اللَّهَ تبارَكَ وتعالى ليَعجبُ منَ",2],[" الصَّلاةِ في الجمعِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (5112) واللفظ له، وابن المبارك في ((الزهد والرقائق)) (الملحق/ 29) وفيه قصة.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"5vDvcw6B"},{"id":"س-05824","fp":"8f377c6cfd9e","stateId":198,"easy":"إذا استكت ← يطهر فمك ويرضى ربك","cause":"السِّواكُ","result":"مطهرةٌ للفَمِ مَرضاةٌ للرَّبِّ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/ 254","srcLabel":"النسائي","text":["قالَت: قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["السِّواكُ ",1],["مطهرةٌ للفَمِ مَرضاةٌ للرَّبِّ",2]],"grade":"صحيح","narrator":"عائشة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (24203)، والدارمي (711)، والنسائي (5) بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"OZLQMENy","merged":4,"otherRefs":["تخريج المسند لشعيب 26014 (صحيح)","الجامع الصغير 4818 (حسن)","صحيح ابن حبان 1070 (صحيح)"]},{"id":"س-01380","fp":"6939458b0046","stateId":198,"easy":"إذا أحسنت الوضوء ثم أتيت المسجد لا تريد إلا الصلاة ← يفرح الله بك كما يفرح أهل الغائب بطلعته","cause":"لا يَتَوضَّأُ أحَدٌ فيُحسِنُ وُضوءَه ويُسبِغُه، ثُمَّ يَأتي المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ","result":"إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهْلُ الغائِبِ بطَلْعتِه","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"ref":"الصحيح المسند 2/307","srcLabel":"الصحيح المسند","text":["أنَّه سَمِعَ أبا هُرَيْرةَ يقولُ: ",["لا يَتَوضَّأُ أحَدٌ فيُحسِنُ وُضوءَه ويُسبِغُه، ثُمَّ يَأتي المَسجِدَ لا يُريدُ إلَّا الصَّلاةَ ",1],["إلَّا تَبَشْبَشَ اللهُ به كما يَتَبَشْبَشُ أهْلُ الغائِبِ بطَلْعتِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","bab":"وضوء › إسباغ الوضوء","dorar":"qYApAF5q"},{"id":"س-05925","fp":"361cfb726b98","stateId":198,"easy":"إذا لزمت السواك ← يطيب فمك ويرضى عنك ربك","cause":"عليكُمْ بِالسِّوَاكِ","result":"فإنَّهُ مَطْيَبَةٌ لِلْفَمِ ، مَرْضَاةٌ لِلرَّبِّ تَبارَكَ وتَعالَى","explicit":true,"ref":"صحيح الترغيب 210","srcLabel":"أحمد","text":[["عليكُمْ بِالسِّوَاكِ ؛ ",1],["فإنَّهُ مَطْيَبَةٌ لِلْفَمِ ، مَرْضَاةٌ لِلرَّبِّ تَبارَكَ وتَعالَى",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (5865) واللفظ له، والطبراني في ((المعجم الأوسط)) (3113)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qddhReDv"},{"id":"س-02000","fp":"7ac9ae4e33cf","stateId":199,"easy":"إذا تصدقت سراً ← تطفئ غضب الله","cause":"وعليكم بصدَقةِ السِّرِّ","result":"فإنَّها تُطفِئُ غضَبَ اللهِ عزَّ وجلَّ","explicit":true,"star":true,"similar":["س-05783"],"ref":"التنوير شرح الجامع الصغير 7/309","srcLabel":"ابن أبي الدنيا","text":["عليكم باصطناعِ المعروفِ؛ فإنَّه يَمنَعُ مَصارِعَ السُّوءِ، ",["وعليكم بصدَقةِ السِّرِّ",1],"؛ ",["فإنَّها تُطفِئُ غضَبَ اللهِ عزَّ وجلَّ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"متنه صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((اصطناع المعروف)) (6)، وابن الخطاب في ((مشيخته)) (105)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (315) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8QIIya4I"},{"id":"س-05783","fp":"b44b3774a680","stateId":199,"easy":"إذا تصدقت سراً ← تطفئ غضب الرب","cause":"والصدقةُ خُفيا","result":"تُطفِئُ غضبَ الربِّ","explicit":true,"repOf":"س-02000","ref":"الجامع الصغير 5024","text":["صنائعُ المعروفِ تَقي مصارعَ السوءِ ",["والصدقةُ خُفيا",1]," ",["تُطفِئُ غضبَ الربِّ",2],"، وصلةُ الرحِمِ زيادةٌ في العمُرِ، وكلُّ معروفٍ صدَقَةٌ، وأهلُ المعروفِ في الدنيا هم أهلُ المعروفِ في الآخرةِ، وأهلُ المُنكَرِ في الدنيا هم أهلُ المُنكَرِ في الآخِرَةِ، وأولُ مَن يدخُلُ الجنةَ أهلُ المعروفِ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6086)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FXfMwMQ4"},{"id":"س-06940","fp":"ea29cf3b11f8","stateId":199,"easy":"إذا تصدقت ← تطفئ غضب الرب وتدفع عنك ميتة السوء","cause":"إنَّ الصَّدقةَ","result":"لتطفئُ غضبَ الرَّبِّ وتدفعُ مَيتةَ السُّوءِ","explicit":true,"otherNeedIds":[51],"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["إنَّ الصَّدقةَ",1]," ",["لتطفئُ غضبَ الرَّبِّ وتدفعُ مَيتةَ السُّوءِ",2]," ، وفي روايةٍ :  إِنَّ اللَّهَ ليَدرأُ بالصَّدقةِ سبعينَ بابًا من ميتةِ السُّوءِ"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"D4BOOjCz"},{"id":"س-03480","fp":"ded40a6005ed","stateId":200,"easy":"إذا وقفت بعرفة أشعث أغبر ← يباهي الله بك ملائكة السماء","cause":"بأهلِ عرفاتٍ ملائكةَ السَّماءِ ، يقولُ : انظروا إلى عبادي ، أتَوْني شُعثًا غُبرًا من كلِّ فجٍّ عميقٍ ، أُشهِدُكم أنِّي قد غفرتُ لهم","result":"إنَّ اللهَ تعالَى يُباهي","explicit":true,"star":true,"apply":{"k":"time","t":"يوم عرفة"},"otherNeedIds":[21,11],"ref":"حلية الأولياء 3/349","srcLabel":"أحمد","text":[["إنَّ اللهَ تعالَى يُباهي",2],[" بأهلِ عرفاتٍ ملائكةَ السَّماءِ ، يقولُ : انظروا إلى عبادي ، أتَوْني شُعثًا غُبرًا من كلِّ فجٍّ عميقٍ ، أُشهِدُكم أنِّي قد غفرتُ لهم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح من حديث سعيد بن المسيب عن عائشة غريب من حديث مجاهد عن أبي هريرة","takhrij":"أخرجه أحمد (8047)، وابن خزيمة (2839)، وابن حبان (3852) مختصراً باختلاف يسير","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"9GzHerPI","merged":6,"otherRefs":["مجموع الفتاوى 5/130 (صحيح)","صحيح الموارد 836 (صحيح)","الفتاوى الكبرى 1/ 335 (صحيح)","صحيح الجامع 1868 (صحيح)","تخريج المسند لشاكر 15/193 (صحيح)"]},{"id":"س-04454","fp":"c56c25fe72cb","stateId":201,"easy":"إذا قُتلت في سبيل الله ← رضي الله عنك ورضيت عنه (من واقعة)","cause":"فعَرَضوا لهم، فقَتَلوهم قَبلَ أن يَبلُغوا المَكانَ","result":"أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[51],"ref":"صحيح مسلم 677","srcLabel":"البخاري","text":["جاءَ ناسٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقالوا: أنِ ابعَثْ معنا رِجالًا يُعَلِّمونا القُرآنَ والسُّنَّةَ، فبَعَثَ إليهم سَبعينَ رَجُلًا مِنَ الأنصارِ، يُقالُ لهم: القُرَّاءُ، فيهم خالي حَرامٌ، يَقرَؤونَ القُرآنَ، ويَتَدارَسونَ باللَّيلِ يَتَعَلَّمونَ، وكانوا بالنَّهارِ يَجيئونَ بالماءِ فيَضَعونَه في المَسجِدِ، ويَحتَطِبونَ فيَبيعونَه، ويَشتَرونَ به الطَّعامَ لأهلِ الصُّفَّةِ ولِلفُقَراءِ، فبَعَثَهُمُ النَّبيُّ صلَّى اللهُ عليه وسلَّم إليهم، ",["فعَرَضوا لهم، فقَتَلوهم قَبلَ أن يَبلُغوا المَكانَ",1],"، فقالوا: اللَّهُمَّ بَلِّغْ عَنَّا نَبيَّنا ",["أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا",2],"، قال: وأتى رَجُلٌ حَرامًا، خالَ أنَسٍ مِن خَلفِه، فطَعَنَه برُمحٍ حتَّى أنفَذَه، فقال حَرامٌ: فُزتُ ورَبِّ الكَعبةِ! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لأصحابِه: إنَّ إخوانَكُم قد قُتِلوا، وإنَّهُم قالوا: اللَّهُمَّ بَلِّغْ عَنَّا نَبيَّنا أنَّا قد لَقيناكَ فرَضينا عَنكَ، ورَضيتَ عَنَّا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2801)، وأحمد (12402)، وعبد بن حميد في ((المنتخب)) (1276) بنحوه.","bab":"جهاد › فضل الجهاد","dorar":"gVZXSr8W"},{"id":"س-05250","fp":"07ea9d6794d3","stateId":202,"easy":"إذا أرضيت والدك ← رضي عنك الرب","cause":"في رِضَا الوالِدِ","result":"رِضَا الرَّبِّ","explicit":true,"star":true,"ref":"تخريج شرح السنة 1/13","srcLabel":"الترمذي","text":[["رِضَا الرَّبِّ",2]," ",["في رِضَا الوالِدِ",1],"، وسَخَطُ الرَّبِّ في سَخَطِ الوالِدِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي بعد حديث (1899)، والخطيب في ((الجامع)) (1698)، وأخرجه الطبراني (13/494) (14367) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8f3GCGqQ","merged":4,"otherRefs":["تخريج شرح السنة 3424 (صحيح)","بلوغ المرام 434 (صحيح)","صحيح الجامع 3507 (صحيح)"]},{"id":"س-03844","fp":"67b9466b5f74","stateId":202,"easy":"إذا أطعت والدك ← فهي طاعة لله","cause":"طاعةُ الوالِدِ","result":"طاعةُ اللهِ","explicit":true,"otherNeedIds":[35],"ref":"صحيح الترغيب 2502","srcLabel":"الطبراني","text":[["طاعةُ اللهِ",2]," ",["طاعةُ الوالِدِ",1]," ، ومعصيةُ اللهِ معصيةُ الوالِدِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2255)","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"9xSWwQlH"},{"id":"س-05681","fp":"7d1b7727c70d","stateId":203,"easy":"إذا رضيت بالبلاء ← فلك الرضا من الله","cause":"فمن رضِي","result":"فله الرِّضا","explicit":true,"star":true,"otherNeedIds":[9],"ref":"الترغيب والترهيب 4/223","srcLabel":"الترمذي","text":["إنَّ عِظَمَ الجزاءِ مع عِظَمِ البلاءِ ، وإنَّ اللهَ تعالَى إذا أحبَّ قومًا ابتلاهم ، ",["فمن رضِي ",1],["فله الرِّضا ",2],"ومن سخِط فله السُّخطُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي بعد حديث (2396)، وابن ماجه (4031)","bab":"رقائق وزهد › الصبر على البلاء","dorar":"6JAtSMug"},{"id":"س-06990","fp":"49c46ab35579","stateId":204,"easy":"إذا أفشيت السلام ← فإنه لله رضا","cause":"أفْشوا السَّلامَ","result":"فإنَّه للهِ تعالى رِضًا","explicit":true,"star":true,"ref":"فيض القدير 2/ 23","srcLabel":"فيض القدير","text":[["أفْشوا السَّلامَ؛ ",1],["فإنَّه للهِ تعالى رِضًا",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"رمز المصنف لحسنه غير مرضي","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"yMLfX0h2"},{"id":"س-06826","fp":"ddcf77586752","stateId":205,"easy":"إذا يسّرت ← فقد رضي الله اليسر لهذه الأمة","cause":"اليُسْرَ","result":"رضيَ لهذه الأُمَّةِ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1635","srcLabel":"البخاري","text":["إنَّ اللهَ ",["رضيَ لهذه الأُمَّةِ",2]," ",["اليُسْرَ",1]," ، و كرِهَ لهم العُسْرَ ، قالها ثلاثَ مراتٍ ، و إنَّ هذا أخذ بالعُسْرِ ، و ترك اليُسْرَ"],"grade":"صحيح","narrator":"محجن بن الأدرع","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه الواحدي في ((الوسيط)) (85) واللفظ له وزيادة، وأحمد (18976) والبخاري في ((الأدب المفرد)) (341) بنحوه مطولا","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"u37fsU2W"},{"id":"س-06122","fp":"cbe1e0a0440c","stateId":205,"easy":"إذا تكلمت بكلمة من رضوان الله ← يكتب الله لك بها رضوانه إلى يوم القيامة","cause":"ليتَكَلَّمُ بالكلِمةِ من رضوانِ اللَّهِ ما يظنُّ أن تبلُغَ ما بلغت","result":"يَكْتبُ اللَّهُ عزَّ وجلَّ لَه بِها رِضوانَهُ إلى يومِ القيامةِ","explicit":true,"similar":["س-00204","س-06118"],"otherNeedIds":[41],"ref":"صحيح ابن ماجه 3220","srcLabel":"الترمذي","text":["مرَّ بهِ رجلٌ لَه شرَفٌ فقالَ لَه علقَمةُ إنَّ لَكَ رحِمًا وإنَّ لَكَ حقًّا وإنِّي رأيتُكَ تدخُلُ علَى هؤلاءِ الأمراءِ وتتَكَلَّمُ عندَهُم بما شاءَ اللَّهُ أن تتَكَلَّمَ بهِ وإنِّي سمِعتُ بلالَ بنَ الحارثِ المزَنيَّ صاحبَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ إنَّ أحدَكُم ",["ليتَكَلَّمُ بالكلِمةِ من رضوانِ اللَّهِ ما يظنُّ أن تبلُغَ ما بلغت",1]," ف",["يَكْتبُ اللَّهُ عزَّ وجلَّ لَه بِها رِضوانَهُ إلى يومِ القيامةِ",2]," وإنَّ أحدَكُم ليتَكَلَّمُ بالكلِمةِ من سَخَطِ اللَّهِ ما يَظنُّ أن تبلُغَ ما بلغت فيَكْتبُ اللَّهُ عزَّ وجلَّ عليهِ بِها سَخطَهُ إلى يومِ يلقاهُ قالَ عَلقَمَةُ فانظُرْ ويحَكَ ماذا تَقولُ وماذا تَكَلَّمُ بهِ فرُبَّ كلامٍ قد منعَني أن أتَكَلَّمَ بهِ ما سمِعتُ من بلالِ بنِ الحارثِ"],"grade":"صحيح","narrator":"بلال بن الحارث المزني.","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2319)، وابن ماجة (3969)، والحاكم (136) واللفظ لهم.","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"LoykDRa9","merged":3,"otherRefs":["صحيح البخاري 6478 (صحيح)","تخريج المسند لشعيب 15852 (صحيح)"]},{"id":"س-00204","fp":"e110f68a9b92","stateId":205,"easy":"إذا تكلمت بكلمة من رضوان الله ولو لم تلقِ لها بالاً ← يرضى الله عنك بها إلى يوم تلقاه","cause":"إنَّ العَبْدَ ليَتَكَلَّمُ بالكَلِمَةِ مِنْ رِضْوانِ اللهِ، ما يَظُنُّ أَنْ تَبْلُغَ ما بَلَغَتْ","result":"فيَرْضَى اللهُ بها عنه إلى يوْمِ يَلْقاهُ","explicit":true,"repOf":"س-06122","ref":"المستدرك على الصحيحين 137","text":["عنْ عَلْقَمةَ بنِ وَقَّاصٍ قالَ: كان رَجُلٌ بَطَّالٌ يدْخُلُ على الأُمَراءِ فَيُضْحِكُهُمْ، فقالَ لهُ جدِّي: وَيْحَكَ يا فُلانُ، لِمَ تدْخُلُ على هؤلاء وتُضْحِكُهُمْ؟ فإني سَمِعْتُ بلالَ بنَ الحارثِ المُزَنِيَّ صاحِبَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يُحدِّثُ أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: «",["إنَّ العَبْدَ ليَتَكَلَّمُ بالكَلِمَةِ مِنْ رِضْوانِ اللهِ، ما يَظُنُّ أَنْ تَبْلُغَ ما بَلَغَتْ",1],"، ",["فيَرْضَى اللهُ بها عنه إلى يوْمِ يَلْقاهُ",2],"، وإنَّ العَبْدَ ليَتَكَلَّمُ بِالكَلِمةِ مِنْ سَخَطِ اللهِ، ما يَظُنُّ أنْ تَبْلُغَ ما بَلَغَتْ، فيَسْخَطُ اللهُ بها إلى يَوْمِ يَلْقاهُ»."],"grade":"صحيح","narrator":"بلال بن الحارث المزني","muhaddith":"صحيح","bab":"آداب الكلام › المزاح والمداعبة","dorar":"UlpYjYwQ"},{"id":"س-06118","fp":"78da54389084","stateId":205,"easy":"إذا تكلمت بكلمة خير ← يكتب الله لك بها رضوانه إلى يوم تلقاه","cause":"إنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الخَيْرِ ما يَعلَمُ مَبلَغَها","result":"يَكتُبُ اللهُ له رِضوانَه إلى يَوْمِ يَلْقاه","explicit":true,"repOf":"س-06122","ref":"الصحيح المسند 183","text":["أنَّ بِلالَ بنَ الحارِثِ المُزَنيَّ قالَ له: إنِّي رَأيْتُك تَدخُلُ على هؤلاء الأُمَراءِ وتَغْشاهم، فانْظُرْ ماذا تُحاضِرُهم به؛ فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["إنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الخَيْرِ ما يَعلَمُ مَبلَغَها",1],"، ",["يَكتُبُ اللهُ له رِضوانَه إلى يَوْمِ يَلْقاه",2],"، وإنَّ الرَّجُلَ لَيَتكلَّمُ بالكَلِمةِ مِن الشَّرِّ ما يَعلَمُ مَبلَغَها، يَكتُبُ اللهُ عليه بِها سَخَطَه إلى يَوْمِ يَلْقاه»، وكانَ عَلْقمةُ يقولُ: رُبَّ حَديثٍ قد حالَ بَيْني وبَيْنَه ما سَمِعْتُ مِن بِلالٍ."],"grade":"صحيح","narrator":"بلال بن الحارث","muhaddith":"صحيح على شرط الشَّيْخين","bab":"رقائق وزهد › من أرضى الناس بسخط الله","dorar":"0boLB4EF"},{"id":"س-06872","fp":"2d0bb6dae7d2","stateId":205,"easy":"إذا لم تغضب ← تتباعد عن غضب الله","cause":"لا تَغضَبْ","result":"ماذا يُباعِدُني مِن غَضَبِ اللهِ عزَّ وجَلَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[8],"ref":"تخريج المسند لشاكر 10/124","srcLabel":"أحمد","text":["عن عبدِ اللهِ بنِ عَمرٍو أنَّه سأَل رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ",["ماذا يُباعِدُني مِن غَضَبِ اللهِ عزَّ وجَلَّ",2]," قال ",["لا تَغضَبْ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6635) بلفظه، وابن حبان (296) بلفظ مقارب .","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"AjGh52Pm","merged":2,"otherRefs":["صحيح الموارد 1655 (حسن)"]},{"id":"س-06234","fp":"e92450604fa7","stateId":206,"easy":"إذا طلبت العلم ← تضع لك الملائكة أجنحتها رضاً بما تطلب","cause":"لطالِبِ العِلمِ","result":"إنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ","explicit":true,"star":true,"similar":["س-07255"],"otherNeedIds":[16],"ref":"الأحاديث المختارة 8 / 33","srcLabel":"متفق عليه","text":["«أتَيْتُ صَفْوانَ بنَ عَسَّالٍ المُرادِيَّ رَضيَ اللهُ عنه؛ فقالَ: ما جاءَ بك؟ قُلْتُ: جِئْتُ ابْتِغاءَ العِلمِ، قالَ: ف",["إنَّ المَلائِكةَ تَضَعُ أجْنِحتَها لطالِبِ العِلمِ رِضًا بما يَطلُبُ",2],"، قالَ: قُلْتُ: حَكَّ في نَفْسي أو صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، فهلْ سَمِعْتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في ذلك شَيئًا؟ قالَ: نَعمْ، كانَ يَأمُرُنا إذا كُنَّا سَفَرًا أو مُسافِرينَ ألَّا نَنزِعَ خِفافَنا ثَلاثةَ أيَّامٍ ولَياليهنَّ إلَّا مِن جَنابةٍ؛ ولكنْ مِن غائِطٍ وبَوْلٍ ونَوْمٍ، قُلْتُ: هلْ سَمِعْتَه يَذكُرُ الهَوى؟ قالَ: نَعمْ، بَيْنا نحن معَه في مَسيرٍ إذ ناداه أعْرابيٌّ بصَوْتٍ جَهْوَرِيٍّ فقالَ: يا مُحمَّدُ، فأجابَه على نَحْوٍ مِن كَلامِه: (هاء). وقالَ: أرَأَيْتَ رَجُلًا أحَبَّ قَوْمًا ولمَّا يَلحَقْ بهم؟ قالَ: (المَرْءُ معَ مَن أَحَبَّ). ثُمَّ لم يَزَلْ يُحَدِّثُنا (إنَّ مِن قِبَلِ المَغرِبِ بابًا يَفتَحُ اللهُ للتَّوبةِ، مَسيرةُ عَرْضِه أرْبَعونَ سَنَةً، فلا يُغلَقُ حتَّى تَطلُعَ الشَّمْسُ) يَعْني مِنه.\nلَفْظُ حَديثِ مُحمَّدِ بنِ عاصِمٍ.\nوفي رِوايةِ عَبْدِ الرَّزَّاقِ قالَ: أتَيْتُ صَفْوانَ بنَ عَسَّالٍ؛ فقالَ: ما جاءَ بك؟ قُلْتُ: ابْتِغاء العِلمِ.\nوعِنْدَه قُلْتُ: حاكَ في صَدْري مَسْحٌ على الخُفَّينِ بَعْدَ الغائِطِ والبَوْلِ، وكُنْتُ امْرَأً مِن أصْحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأتَيْتُك أسْأَلُك عن ذلك، هلْ سَمِعْتَ مِنه في ذلك شَيئًا؟ قالَ: نَعمْ.\nوعِنْدَه: أو كُنَّا مُسافِرينَ.\nوعِنْدَه: قُلْتُ: أسَمِعْتَه يَذكُرُ الهَوى؟\nوعِنْدَه: بصَوْتٍ جَهْوَريٍّ -أو قالَ: (جَوْهَريٍّ) -ابنُ عُيَيْنةَ شَكَّ- قالَ:\nوعِنْدَه: فأجابَه بنَحْوٍ مِن كَلامِه، فقالَ: مَهْ، قالَ: أرَأَيْتَ.\nوعِنْدَه: ولم يَلحَقْ بهم، قالَ: (هو يَوْمَ القِيامةِ معَ مَن أحَبَّ). قالَ: فلم يَزَلْ يُحَدِّثُنا حتَّى قالَ: (إنَّ مِن قِبَلِ المَغرِبِ بابًا مَسيرةُ عَرْضِه سَبْعونَ سَنَةً، فَتَحَه اللهُ للتَّوْبةِ يَوْمَ خَلَقَ السَّمواتِ والأرْضَ، ولا يُغلِقُه حتَّى تَطلُعَ الشَّمْسُ مِن نَحْوِه»."],"grade":"صحيح","narrator":"صفوان بن عسال المرادي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"سفر › المسح على الخفين في السفر","dorar":"0S0WIi8D","merged":5,"otherRefs":["الأحاديث المختارة 8 / 36 (صحيح)","صحيح النسائي 158 (حسن)","الأحاديث المختارة 8 / 35 (صحيح)","تخريج العواصم والقواصم 4/ 25 (حسن)"]},{"id":"س-07255","fp":"1a416a5cce1a","stateId":206,"easy":"إذا خرجت في طلب العلم ← تبسط لك الملائكة أجنحتها رضاً بما تفعل","cause":"ما مِنْ رَجُلٍ يَخْرُجُ في طَلَبِ العِلْمِ","result":"إلَّا بَسَطَتْ له المَلائكَةُ أَجْنِحَتَها؛ رضًا بما يَفْعَلُ حتَّى يَرْجِعَ","explicit":true,"repOf":"س-06234","otherNeedIds":[16],"ref":"المستدرك على الصحيحين 344","text":["عنْ صَفْوانَ بِنْ عَسَّالٍ المُراديِّ، أنَّه جاءَ يَسْأَلُهُ عن شَيءٍ، فقالَ: ما أَعْمَلَكَ إلَيَّ إلَّا ذلك؟ قالَ: ما أَعْمَلْتُ إليكَ إلَّا لِذلك، قالَ: فَأَبْشِرْ؛ فإنَّه ",["ما مِنْ رَجُلٍ يَخْرُجُ في طَلَبِ العِلْمِ،",1]," ",["إلَّا بَسَطَتْ له المَلائكَةُ أَجْنِحَتَها؛ رضًا بما يَفْعَلُ حتَّى يَرْجِعَ",2],"."],"grade":"صحيح","narrator":"زر بن حبيش","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه ابن ماجه (226)، وأحمد (18093) بنحوه.","bab":"علم › فضل مجالس العلم والذكر","dorar":"28RpkhRD"},{"id":"س-03702","fp":"d8b807a454bb","stateId":207,"easy":"إذا أطعت النبي ﷺ ← فقد أطعت الله","cause":"مَن أطاعَني","result":"فَقد أطاعَ اللَّهَ","explicit":true,"star":true,"similar":["س-00608"],"ref":"صحيح ابن خزيمة 3/ 104","srcLabel":"متفق عليه","text":[["مَن أطاعَني",1]," ",["فَقد أطاعَ اللَّهَ",2],"، ومَن عَصاني فقد عَصَى اللَّهَ، ومن أطاعَ الأميرَ فقد أطاعَني، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG","merged":3,"otherRefs":["صحيح النسائي 5525 (صحيح)","صحيح البخاري 2957 (صحيح)"]},{"id":"ق-0233","fp":"95fecd0a1ed4","stateId":207,"easy":"طاعة الرسول ← طاعة الله","cause":"طاعة الرسول","result":"طاعة الله","explicit":true,"ref":"سورة النساء: 80","srcLabel":"القرآن الكريم","quran":{"s":4,"from":80,"to":80,"text":"مَنْ يُطِعِ الرَّسُولَ فَقَدْ أَطَاعَ اللَّهَ وَمَنْ تَوَلَّى فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا (80)","hl":[[0,46,1]]}},{"id":"س-00608","fp":"17b328f9b8c2","stateId":207,"easy":"إذا أطعت محمداً ﷺ ← فقد أطعت الله","cause":"فمَن أطاعَ مُحَمَّدًا","result":"فقد أطاعَ اللهَ","explicit":true,"repOf":"س-03702","ref":"صحيح البخاري 7281","text":["جاءَت مَلائِكةٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم وهو نائِمٌ، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: إنَّ لصاحِبِكُم هذا مَثَلًا، فاضرِبوا له مَثَلًا، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: مَثَلُه كَمَثَلِ رَجُلٍ بَنى دارًا، وجَعَلَ فيها مَأدُبةً وبَعَثَ داعيًا، فمَن أجابَ الدَّاعيَ دَخَلَ الدَّارَ وأكَلَ مِنَ المَأدُبةِ، ومَن لَم يُجِبِ الدَّاعيَ لَم يَدخُلِ الدَّارَ ولَم يَأكُلْ مِنَ المَأدُبةِ، فقالوا: أوِّلوها له يَفقَهْها، فقال بَعضُهم: إنَّه نائِمٌ، وقال بَعضُهم: إنَّ العَينَ نائِمةٌ، والقَلبَ يَقظانُ، فقالوا: فالدَّارُ الجَنَّةُ، والدَّاعي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، ",["فمَن أطاعَ مُحَمَّدًا",1]," صلَّى اللهُ عليه وسلَّم ",["فقد أطاعَ اللهَ",2],"، ومَن عَصى مُحَمَّدًا صلَّى اللهُ عليه وسلَّم فقد عَصى اللهَ، ومُحَمَّدٌ صلَّى اللهُ عليه وسلَّم فَرقٌ بينَ النَّاسِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[أورده في صحيحه] وقال : تابعه قتيبة عن ليث عن خالد عن سعيد بن أبي هلال عن جابر خرج علينا النبي صلى الله عيه وسلم ...","takhrij":"أخرجه أبو عوانة (10114)، والبيهقي في ((الآداب)) (858) كلاهما بلفظه، والترمذي (2860) بمعناه.","bab":"آداب عامة › ضرب الأمثال","dorar":"mmVpxzQK"},{"id":"س-05389","fp":"e97594e4e7a7","stateId":207,"easy":"إذا أحببت أحداً لله ← فقد أكرمت ربك","cause":"ما أَحَبَّ عَبْدٌ عَبْدًا لِلَّهِ","result":"إلا أَكرَمَ رَبَّه - عَزَّ وَجَلَّ","explicit":true,"ref":"هداية الرواة 4949","srcLabel":"أحمد","text":[["ما أَحَبَّ عَبْدٌ عَبْدًا لِلَّهِ ؛",1]," ",["إلا أَكرَمَ رَبَّه - عَزَّ وَجَلَّ - ",2],"."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (22229) واللفظ له، وابن أبي الدنيا في ((الأخوان)) (20) باختلاف يسير، والبيهقي في ((شعب الإيمان)) (9017) مطولاً","bab":"رقائق وزهد › الحب في الله","dorar":"xo1f7Nr0"},{"id":"س-03110","fp":"20b2684be9ac","stateId":208,"easy":"إذا كنت شاباً لا صبوة لك ← يعجب الله منك","cause":"الشَّابِّ ليسَتْ لَهُ صَبوةٌ","result":"إنَّ اللَّهَ تعَالى لَيَعجَبُ منَ","explicit":true,"star":true,"otherNeedIds":[21],"ref":"الجامع الصغير 1793","srcLabel":"أحمد","text":[["إنَّ اللَّهَ تعَالى لَيَعجَبُ منَ",2],[" الشَّابِّ ليسَتْ لَهُ صَبوةٌ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17371) واللفظ له، وأبو يعلى (1749)، والطبراني (17/309) (853) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"hVjSwMcZ","merged":4,"otherRefs":["مختصر المقاصد 634 (حسن)","المقاصد الحسنة 151 (حسن)","السلسلة الصحيحة 2843 (حسن)"]},{"id":"س-06952","fp":"f160240c8e5c","stateId":208,"easy":"إذا أرضيت الله بسخط الناس ← يرضى الله عنك ويرضي عنك الناس","cause":"من أرْضَى اللهَ بِسَخَطِ الناسِ","result":"رَضِيَ اللهُ عنه وأَرْضَى عنه الناسَ","explicit":true,"similar":["س-06884"],"otherNeedIds":[36],"ref":"شرح الطحاوية 268","srcLabel":"الترمذي","text":[["من أرْضَى اللهَ بِسَخَطِ الناسِ ، ",1],["رَضِيَ اللهُ عنه  وأَرْضَى عنه الناسَ ، ",2],"ومن أرْضَى الناسَ بسَخَطِ اللهِ ، عادَ حامِدُهُ مِنَ الناسِ ( لَهُ ) ذَامًّا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2414) بنحوه، وعبد بن حميد في ((المسند)) (1522)، وابن حبان (277) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"NIKhkxFv","merged":2,"otherRefs":["صحيح الترغيب 2250 (صحيح)"]},{"id":"س-06884","fp":"1135a5d4aa79","stateId":208,"easy":"إذا أرضيت الله ولو أسخطت الناس ← يرضى الله عنك ويُرضي عنك الناس","cause":"ومَن أرضى اللهَ في سَخَطِ النَّاسِ","result":"رضِيَ اللهُ عنه وأرضى عنه مَن أسخَطه في رِضاه حتَّى يُزَيِّنَه ويُزَيِّنَ قولَه وعملَه في عينِه","explicit":true,"repOf":"س-06952","otherNeedIds":[36],"ref":"مجمع الزوائد 10/227","text":["مَن أسخَط اللهَ [ في رِضا النَّاسِ سخِطَ اللهُ عليه ] وأسخَط عليه مَن أرضاه في سَخَطِه ",["ومَن أرضى اللهَ في سَخَطِ النَّاسِ",1]," ",["رضِيَ اللهُ عنه وأرضى عنه مَن أسخَطه في رِضاه حتَّى يُزَيِّنَه ويُزَيِّنَ قولَه وعملَه في عينِه",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"رجاله رجال الصحيح غير يحيى بن سليمان الحفري وقد وثقه الذهبي","takhrij":"أخرجه  الطبراني (11/268) (11696)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"3rZo1QHq"},{"id":"ق-1072","fp":"b58f351b2181","stateId":209,"easy":"الشكر ← رضا الله","cause":"الشكر","result":"رضا الله","explicit":true,"star":true,"ref":"سورة الزمر: 7","srcLabel":"القرآن الكريم","quran":{"s":39,"from":7,"to":7,"text":"إِنْ تَكْفُرُوا فَإِنَّ اللَّهَ غَنِيٌّ عَنْكُمْ وَلَا يَرْضَى لِعِبَادِهِ الْكُفْرَ وَإِنْ تَشْكُرُوا يَرْضَهُ لَكُمْ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَى ثُمَّ إِلَى رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ (7)","hl":[[85,118,1]]}},{"id":"س-06888","fp":"ed82d69136e4","stateId":209,"easy":"إذا شكرت النعمة وأعطيت منها ← يرضى الله عنك (من قصة الأعمى)","cause":"قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ","result":"أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"صحيح مسلم 2964","srcLabel":"البخاري","text":["إنَّ ثَلاثةً في بَني إسرائيلَ: أبرَصَ، وأقرَعَ، وأعمى، فأرادَ اللهُ أن يَبتَليَهم، فبَعَثَ إليهم مَلَكًا، فأتى الأبرَصَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: لَونٌ حَسَنٌ، وجِلدٌ حَسَنٌ، ويَذهَبُ عَنِّي الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه قَذَرُه، وأُعطيَ لَونًا حَسَنًا وجِلدًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الإبِلُ أو قال البَقَرُ، شَكَّ إسحاقُ، إلَّا أنَّ الأبرَصَ أوِ الأقرَعَ، قال أحَدُهما: الإبِلُ، وقال الآخَرُ: البَقَرُ، قال: فأُعطيَ ناقةً عُشَراءَ، فقال: بارَك اللهُ لك فيها، قال: فأتى الأقرَعَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: شَعَرٌ حَسَنٌ، ويَذهَبُ عَنِّي هذا الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه، وأُعطيَ شَعَرًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: البَقَرُ، فأُعطيَ بَقَرةً حامِلًا، فقال: بارَك اللهُ لك فيها، قال: فأتى الأعمى، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: أن يَرُدَّ اللهُ إلَيَّ بَصَري، فأُبصِرَ به النَّاسَ، قال: فمَسَحَه فرَدَّ اللهُ إليه بَصَرَه، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الغَنَمُ، فأُعطيَ شاةً والِدًا، فأُنتِجَ هذانِ وولَّدَ هذا، قال: فكانَ لهذا وادٍ مِنَ الإبِلِ، ولهذا وادٍ مِنَ البَقَرِ، ولهذا وادٍ مِنَ الغَنَمِ. قال: ثُمَّ إنَّه أتى الأبرَصَ في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ، قدِ انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ ثُمَّ بك، أسألُك بالذي أعطاك اللَّونَ الحَسَنَ والجِلدَ الحَسَنَ والمالَ، بَعيرًا أتَبَلَّغُ عليه في سَفَري، فقال: الحُقوقُ كَثيرةٌ، فقال له: كَأنِّي أعرِفُك، ألَم تَكُنْ أبرَصَ يَقذَرُك النَّاسُ؟ فقيرًا فأعطاك اللهُ؟ فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ. قال: وأتى الأقرَعَ في صورَتِه، فقال له مِثلَ ما قال لهذا، ورَدَّ عليه مِثلَ ما رَدَّ على هذا، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ، قال: وأتى الأعمى في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ وابنُ سَبيلٍ، انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ، ثُمَّ بك، أسألُك بالذي رَدَّ عليك بَصَرَك شاةً أتَبَلَّغُ بها في سَفَري، فقال: ",["قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ",1],"، فقال: ",["أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3464) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"xELD1ioR"},{"id":"س-00831","fp":"ae682c477006","stateId":210,"easy":"إذا أكلت أو شربت فحمدت الله ← يرضى الله عنك","cause":"العَبدِ أن يَأكُلَ الأَكلةَ فيَحمَدَه عليها، أو يَشرَبَ الشَّربةَ فيَحمَدَه عليها","result":"إنَّ اللهَ لَيَرضى عَنِ","explicit":true,"star":true,"ref":"صحيح مسلم 2734","srcLabel":"الترمذي","text":[["إنَّ اللهَ لَيَرضى عَنِ",2],[" العَبدِ أن يَأكُلَ الأَكلةَ فيَحمَدَه عليها، أو يَشرَبَ الشَّربةَ فيَحمَدَه عليها",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (1816)، وابن أبي شيبة (24499)، وابن منده في ((التوحيد)) (ص251) واللفظ لهم.","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"oOabSoIV","merged":4,"otherRefs":["زاد المعاد 2/370 (صحيح)","مجموع الفتاوى 17/180 (صحيح)","صحيح الجامع 1816 (صحيح)"]},{"id":"س-03672","fp":"2a32f64496a1","stateId":211,"easy":"إذا أطعت الأمير ← فقد أطعت النبي ﷺ","cause":"ومَن يُطِعِ الأميرَ","result":"فقد أطاعَني","explicit":true,"star":true,"similar":["س-03704"],"ref":"صحيح البخاري 2957","srcLabel":"متفق عليه","text":["مَن أطاعَني فقد أطاعَ اللهَ، ومَن عَصاني فقد عَصى اللهَ، ",["ومَن يُطِعِ الأميرَ",1]," ",["فقد أطاعَني",2],"، ومَن يَعصِ الأميرَ فقد عَصاني، وإنَّما الإمامُ جُنَّةٌ يُقاتَلُ مِن ورائِه ويُتَّقى به، فإن أمَرَ بتَقوى اللهِ وعَدَلَ فإنَّ له بذلك أجرًا، وإن قال بغَيرِه فإنَّ عليه منه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2957)، ومسلم (1835)","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"50wib7r4"},{"id":"س-03704","fp":"ddd93abb6ad7","stateId":211,"easy":"إذا أطعت الأمير ← فقد أطعت النبي ﷺ","cause":"ومن أطاعَ الأميرَ","result":"فقد أطاعَني","explicit":true,"repOf":"س-03672","ref":"صحيح ابن خزيمة 3/ 104","text":["مَن أطاعَني فَقد أطاعَ اللَّهَ، ومَن عَصاني فقد عَصَى اللَّهَ، ",["ومن أطاعَ الأميرَ",1]," ",["فقد أطاعَني",2],"، ومَن عصا الأميرَ فقد عَصاني، إنَّما الإمامُ جنَّةٌ، فإذا صلَّى قاعدًا فصلُّوا قعودًا، وإذا قالَ: سمِعَ اللَّهُ لمن حمدَهُ، فقولوا: اللَّهمَّ ربَّنا لَكَ الحمدُ، فإذا وافقَ قَولُ أَهْلِ الأرضِ قولَ أَهْلِ السَّماءِ غُفِرَ لَهُ ما مضَى مِن ذنبِهِ، ويَهْلِكُ كِسرى ولا كِسرى بعدُ، ويَهْلِكُ قَيصرُ فلا قَيصرَ مِن بعدِهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7137)، ومسلم (1835)، والنسائي (4193) بلفظه مختصرًا.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"KojlJ7bG"}]}