{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":22,"stateIds":[210,211,212,213,214,215,216,217,218,219,220,221,222],"items":[{"id":"س-01754","fp":"8eaf18148b39","stateId":210,"easy":"إذا حلفت بغير الله ← فقد أشركت","cause":"من حلفَ بغيرِ اللهِ","result":"فقد أَشركَ","explicit":true,"star":true,"similar":["س-01746","س-03174"],"ref":"تخريج المسند لشاكر 7/199","srcLabel":"متفق عليه","text":["عن سعد بن عبيدة قال: جلستُ أنا ومُحَمَّدٌ الكِنْدِيُّ إلى عبدِ اللهِ بنِ عمرَ ثم قمتُ من عندِه فجلستُ إلى سعيدِ بنِ المسيِّبِ قال فجاء صاحِبِي وقد اصفرَّ وجهُه وتغيَّر لونُه فقال قُمْ إليَّ قلتُ ألم أكنْ جالسًا معك الساعةَ فقال سعيدُ : قُمْ إلَى صاحبِكَ ، قال : فقمتُ إليه فقال ألم تسمعْ إلى ما قالَ ابنُ عمرَ قلتُ وما قال قال : أتاهُ رجلٌ فقال يا أبا عبدِ الرحمنِ أَعَليَّ جُناحٌ أن أحلفَ بالكعبةِ قال ولِمَ تحلفُ بالكعبةِ إذا حلفتَ بالكعبةِ فاحلفْ بربِّ الكعبةِ فإنَّ عمرَ كان إذا حلفَ قال كلَّا وأَبِي فحلفَ بها يومًا عندَ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ لا تحلفْ بأبيك ولا بغيرِ اللهِ فإنه ",["من حلفَ بغيرِ اللهِ ",1],["فقد أَشركَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6108)، ومسلم (1646)، والترمذي (1534) جميعهم مختصرا ببعض لفظه.","bab":"أيمان › الحلف بغير الله عز وجل","dorar":"mrwo7oFb","merged":8,"otherRefs":["تخريج المسند لشاكر 8/222 (صحيح)","تخريج المسند لشاكر 8/9 (صحيح)","تخريج مشكل الآثار 831 (صحيح)","تخريج صحيح ابن حبان 4358 (صحيح)","تخريج رياض الصالحين 1711 (صحيح)","الأحكام الوسطى 4/ 28 (صحيح)","المستدرك على الصحيحين 8024 (صحيح)"]},{"id":"س-02598","fp":"4d5b89671a9b","stateId":210,"easy":"إذا قلت «مُطرنا بنوء كذا» ← فأنت كافر بالله مؤمن بالكوكب","cause":"مَن قال: بنَوءِ كَذا وكَذا","result":"فذلك كافِرٌ بي مُؤمِنٌ بالكَوكَبِ","explicit":true,"star":true,"similar":["س-07457"],"otherNeedIds":[21],"ref":"صحيح البخاري 1038","srcLabel":"مسلم","text":["صَلَّى لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم صَلاةَ الصُّبحِ بالحُدَيبيةِ على إثرِ سَماءٍ كانَت مِنَ اللَّيلةِ، فلَمَّا انصَرَفَ النَّبيُّ صلَّى اللهُ عليه وسلَّم أقبَلَ على النَّاسِ، فقال: هل تَدرونَ ماذا قال رَبُّكُم؟ قالوا: اللهُ ورَسولُه أعلَمُ، قال: أصبَحَ مِن عِبادي مُؤمِنٌ بي وكافِرٌ، فأمَّا مَن قال: مُطِرنا بفَضلِ اللهِ ورَحمَتِه، فذلك مُؤمِنٌ بي كافِرٌ بالكَوكَبِ، وأمَّا ",["مَن قال: بنَوءِ كَذا وكَذا",1],"، ",["فذلك كافِرٌ بي مُؤمِنٌ بالكَوكَبِ",2],"."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (71) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"VrjzJDWE","merged":13,"otherRefs":["صحيح النسائي 1524 (صحيح)","تحفة المحتاج 1/571 (صحيح)","مجمع الزوائد 8/117 (حسن)","صحيح الجامع 1314 (صحيح)","المهذب في اختصار السنن 3/1286 (حسن)","مجمع الزوائد 2/215 (حسن)","تخريج المسند لشعيب 849 (حسن)","سنن الترمذي 3295 (صحيح)","معارج القبول 983/3 (صحيح)","السلسلة الصحيحة 7/85 (حسن)","تخريج مشكل الآثار 5218 (حسن)","صحيح مسلم 72 (صحيح)"]},{"id":"س-01753","fp":"65e75da929b1","stateId":210,"easy":"إذا حلفت بملة غير الإسلام كاذباً ← فأنت كما قلت","cause":"مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا","result":"فهو كما قال","explicit":true,"star":true,"similar":["س-05041"],"ref":"صحيح مسلم 110","srcLabel":"متفق عليه","text":["مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا مُتَعَمِّدًا، فهو كما قال، ومَن قَتَلَ نَفسَه بشيءٍ عَذَّبَه اللهُ به في نارِ جَهَنَّمَ. وفي روايةٍ: ",["مَن حَلَفَ بمِلَّةٍ سِوى الإسلامِ كاذِبًا، ",1],["فهو كما قال، ",2],"ومَن ذَبَحَ نَفسَه بشيءٍ ذُبِحَ به يَومَ القيامةِ."],"grade":"صحيح","narrator":"ثابت بن الضحاك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1363)، ومسلم (110).","bab":"أيمان › الحلف بغير الله عز وجل","dorar":"GdyJNve4"},{"id":"س-01751","fp":"49e283f9a4c7","stateId":210,"easy":"إذا حلفت بغير الله ← فهو شرك","cause":"كُلُّ يَمينٌ يُحْلَفُ بِها دونَ اللهِ","result":"شِرْكٌ","explicit":true,"star":true,"similar":["س-03629"],"ref":"المستدرك على الصحيحين 46","srcLabel":"مسلم","text":["«",["كُلُّ يَمينٌ يُحْلَفُ بِها دونَ اللهِ",1]," ",["شِرْكٌ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[على شرط مسلم]","takhrij":"أخرجه الطبراني (13/ 223)، (13950) بلفظه، وأحمد (4904) باختلاف يسير، والترمذي (1535) بنحوه.","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"tF4P1MQr"},{"id":"س-07457","fp":"97139381bd92","stateId":210,"easy":"إذا قلت «مُطرنا بنجم كذا» ← فأنت مؤمن بالكوكب كافر بالله","cause":"مَن قال: مُطِرنا بنَجمِ كَذا","result":"فهو مُؤمِنٌ بالكَوكَبِ كافِرٌ بي","explicit":true,"repOf":"س-02598","ref":"صحيح البخاري 4147","text":["خَرَجنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم عامَ الحُدَيبيةِ، فأصابَنا مَطَرٌ ذاتَ لَيلةٍ، فصَلَّى لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم الصُّبحَ، ثُمَّ أقبَلَ علينا فقال: أتَدرونَ ماذا قال رَبُّكُم؟ قُلنا: اللهُ ورَسولُه أعلَمُ، فقال: قال اللهُ: أصبَحَ مِن عِبادي مُؤمِنٌ بي وكافِرٌ بي، فأمَّا مَن قال: مُطِرنا برَحمةِ اللهِ وبرِزقِ اللهِ وبفَضلِ اللهِ، فهو مُؤمِنٌ بي، كافِرٌ بالكَوكَبِ، وأمَّا ",["مَن قال: مُطِرنا بنَجمِ كَذا، ",1],["فهو مُؤمِنٌ بالكَوكَبِ كافِرٌ بي",2]],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (71)، وأبو داود (3906)، وابن منده في ((الإيمان)) (504)، وابن بشران في ((أمالي)) (915) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"MFufkCYO"},{"id":"س-01746","fp":"160d7aab31e4","stateId":210,"easy":"إذا حلفت بغير الله ← فقد أشركت","cause":"من حلف بشيْءٍ دون اللهِ تعالى","result":"فقد أشركَ","explicit":true,"repOf":"س-01754","ref":"تخريج المسند لشاكر 7/55","text":["كان [ عمرُ ] يحلفُ وأبي فنهاهُ النبيُّ صلَّى اللهُ عليهِ وسلَّمَ قال : ",["من حلف بشيْءٍ دون اللهِ تعالى ",1],["فقد أشركَ",2]," وقال الآخرُ : فهو شِرْكٌ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (826)، والحاكم (167) باختلاف يسير","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"bZrVXyPH","merged":2,"otherRefs":["تخريج المسند لشاكر 1/166 (صحيح)"]},{"id":"س-07729","fp":"d79fd30fb64e","stateId":210,"easy":"إذا نسبت المطر إلى النجوم ← فقد كفرت بالله (كفر نعمة)","cause":"لقد صَدَقَ نَوءُ كَذا وكَذا","result":"ومِنهُم كافِرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 73","srcLabel":"مسلم","text":["مُطِرَ النَّاسُ على عَهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: أصبَحَ مِنَ النَّاسِ شاكِرٌ، ",["ومِنهُم كافِرٌ",2],"، قالوا: هذه رَحمةُ اللهِ، وقال بَعضُهم: ",["لقد صَدَقَ نَوءُ كَذا وكَذا",1],"، قال: فنَزَلَت هذه الآيةُ: {فلا أُقسِمُ بمَواقِعِ النُّجومِ}، حتَّى بَلَغَ: {وتَجعَلونَ رِزقَكُم أنَّكُم تُكَذِّبون} [الواقعة: 75 - 82]."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخارى","bab":"قرآن › أسباب النزول","dorar":"thHTcEAo"},{"id":"س-02577","fp":"727ceaca746e","stateId":210,"easy":"إذا حلفت فقلت «أنا بريء من الإسلام» ← فأنت كما قلت إن كذبت، ولن ترجع إليه سالماً إن صدقت","cause":"مَن حَلَفَ فقالَ: إنِّي بَرِيءٌ مِن الإسْلامِ","result":"فإن كانَ كاذِبًا فهو كما قالَ، وإن كانَ صادِقًا فلن يَرجِعَ إلى الإسْلامِ سالِمًا","explicit":true,"otherNeedIds":[13],"ref":"الأحكام الوسطى 4/ 28","srcLabel":"أبو داود","text":["\"",["مَن حَلَفَ فقالَ: إنِّي بَرِيءٌ مِن الإسْلامِ",1],"، ",["فإن كانَ كاذِبًا فهو كما قالَ، وإن كانَ صادِقًا فلن يَرجِعَ إلى الإسْلامِ سالِمًا",2],"\"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (3258)، وأحمد (23006)، والبزار (4405) واللفظ لهم","bab":"إيمان › أعمال تنافي الإيمان","dorar":"jKNvWLKA"},{"id":"س-02581","fp":"4855a5144a3f","stateId":210,"easy":"إذا قلت «والله وحياتك» أو «لولا الكلب لأتانا اللصوص» ← فهو باب شرك","cause":"أن تقولَ : واللهِ وحياتِك يا فلانُ وحياتِي، وتقولُ : لولا كُليبةُ هذا لأتانا اللصوصُ، ولولا البطُّ في الدارِ لأتَى اللصوصُ، وقولُ الرجلِ : ما شاء اللهُ وشئتَ، وقولُ : لولا اللهُ وفلانٌ","result":"هذا كلُّه بابُ شركٍ","explicit":true,"ref":"مجموع فتاوى ابن باز 45/1","srcLabel":"مجموع فتاوى ابن باز","text":["عن ابنِ عباسٍ ـ رضِيَ اللهُ عنهما ـ في تفسيرِ قولِه تعالَى : فَلا تَجْعَلُوا لِلَّهِ أَنْدَادًا وَأَنْتُمْ تَعْلَمُونَ، قال: هو الشركُ في هذه الأمةِ أخفَى من دبيبِ النملِ على صفاةٍ سوداءَ في ظلمةِ الليلِ، وهو ",["أن تقولَ : واللهِ وحياتِك يا فلانُ وحياتِي، وتقولُ : لولا كُليبةُ هذا لأتانا اللصوصُ، ولولا البطُّ في الدارِ لأتَى اللصوصُ، وقولُ الرجلِ : ما شاء اللهُ وشئتَ، وقولُ : لولا اللهُ وفلانٌ",1],"، لا تجعلْ فيها فلانٌ، ",["هذا كلُّه بابُ شركٍ",2]],"grade":"صحيح","muhaddith":"[ثابت] بإسناد حسن","bab":"إيمان › أعمال تنافي الإيمان","dorar":"elBk6AsO"},{"id":"س-05041","fp":"33616c8d089d","stateId":210,"easy":"إذا حلفت بملة غير الإسلام ← فأنت كما قلت","cause":"من حلَفَ بمِلَّةٍ غيرَ ملَّةِ الإسلامِ","result":"فهو كافرٌ","explicit":true,"repOf":"س-01753","ref":"الفتح الرباني 11/5750","text":[["من حلَفَ بمِلَّةٍ غيرَ ملَّةِ الإسلامِ",1]," ",["فهو كافرٌ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Rkh3rZxL"},{"id":"س-02607","fp":"50ee11f9751d","stateId":210,"easy":"إذا قلت «ما شاء الله وشئت» ← فقد جعلت لله نداً","cause":"ما شاءَ اللهُ وشِئتَ","result":"أجَعَلتَني للهِ نِدًّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-03175"],"ref":"فتاوى صديق خان 117","srcLabel":"فتاوى صديق خان","text":["أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال: ",["ما شاءَ اللهُ وشِئتَ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["أجَعَلتَني للهِ نِدًّا",2],"؟ قُلْ: ما شاءَ اللهُ وحدَه."],"grade":"صحيح","muhaddith":"ثابت.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"uSKYjM2b","merged":2,"otherRefs":["تخريج المسند لشعيب 3247 (صحيح)"]},{"id":"س-03175","fp":"012cbcc10aeb","stateId":210,"easy":"إذا قلت «ما شاء الله وشئت» ← فقد جعلت لله نداً","cause":"تَقولونَ ما شاءَ اللهُ وشِئتَ","result":"لَولا أنَّكُم تَجعَلونَ للَّهِ نِدًّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02607","ref":"تخريج المسند لشعيب 27093","text":["عن قُتَيلةَ بنتِ صَيفيٍّ الجُهَنيَّةِ، قالت: أتى حَبرٌ مِنَ الأحبارِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا مُحَمَّدُ، نِعمَ القَومُ أنتُم، لَولا أنَّكُم تُشرِكونَ، قال: «سُبحانَ اللهِ، وما ذاكَ؟»، قال: تَقولونَ إذا حَلَفتُم: والكَعبةِ، قالت: فأمهَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم شَيئًا، ثُمَّ قال: \"إنَّه قد قال: فمَن حَلَفَ فليَحلِفْ برَبِّ الكَعبةِ\"، ثُمَّ قال: يا مُحَمَّدُ، نِعمَ القَومُ أنتُم، ",["لَولا أنَّكُم تَجعَلونَ للَّهِ نِدًّا",2],"، قال: «سُبحانَ اللهِ، وما ذاكَ؟»، قال: ",["تَقولونَ ما شاءَ اللهُ وشِئتَ",1],"، قال: فأمهَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم شَيئًا، ثُمَّ قال: «إنَّه قد قال: فمَن قال: ما شاءَ اللهُ فليَفصِل بَينَهما: ثُمَّ شِئتَ»."],"grade":"صحيح","narrator":"قتيلة بنت صيفي الجهنية","muhaddith":"إسناده صحيح","bab":"إيمان › توحيد الأسماء والصفات","dorar":"AsEy6sYL","merged":2,"otherRefs":["صحيح ابن ماجه 1734 (صحيح)"]},{"id":"س-03629","fp":"b61948134913","stateId":210,"easy":"إذا حلفت بأبيك ← فهو شرك","cause":"لا وأبي","result":"وقال: إنَّها شِرْكٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01751","ref":"تخريج مشكل الآثار 2/ 297","text":["عن سعدِ بنِ عُبَيدةَ قال: كُنْتُ مع ابنِ عُمرَ في حَلْقةٍ، فسمِع رجُلًا في حَلْقةٍ أُخْرى وهو يقولُ: ",["لا وأبي",1],"، فرَماهُ ابنُ عمرَ بالحَصَى، وقال: إنَّها كانت يَمِينُ عُمرَ، فنهاهُ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ عنها، ",["وقال: إنَّها شِرْكٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (5222) واللفظ له، وأخرجه أبو داود (3251)، والترمذي (1535) بنحوه مختصراً","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"safNBrxs","merged":2,"otherRefs":["تخريج مشكل الآثار 825 (صحيح)"]},{"id":"س-03174","fp":"4fdee0e7b553","stateId":210,"easy":"إذا حلفت بغير الله (كالكعبة) ← فقد أشركت","cause":"تَقولونَ إذا حَلَفتُم: والكَعبةِ","result":"لَولا أنَّكُم تُشرِكونَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01754","ref":"تخريج المسند لشعيب 27093","text":["عن قُتَيلةَ بنتِ صَيفيٍّ الجُهَنيَّةِ، قالت: أتى حَبرٌ مِنَ الأحبارِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا مُحَمَّدُ، نِعمَ القَومُ أنتُم، ",["لَولا أنَّكُم تُشرِكونَ",2],"، قال: «سُبحانَ اللهِ، وما ذاكَ؟»، قال: ",["تَقولونَ إذا حَلَفتُم: والكَعبةِ",1],"، قالت: فأمهَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم شَيئًا، ثُمَّ قال: \"إنَّه قد قال: فمَن حَلَفَ فليَحلِفْ برَبِّ الكَعبةِ\"، ثُمَّ قال: يا مُحَمَّدُ، نِعمَ القَومُ أنتُم، لَولا أنَّكُم تَجعَلونَ للَّهِ نِدًّا، قال: «سُبحانَ اللهِ، وما ذاكَ؟»، قال: تَقولونَ ما شاءَ اللهُ وشِئتَ، قال: فأمهَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم شَيئًا، ثُمَّ قال: «إنَّه قد قال: فمَن قال: ما شاءَ اللهُ فليَفصِل بَينَهما: ثُمَّ شِئتَ»."],"grade":"صحيح","narrator":"قتيلة بنت صيفي الجهنية","muhaddith":"إسناده صحيح","bab":"إيمان › توحيد الأسماء والصفات","dorar":"AsEy6sYL"},{"id":"س-05513","fp":"2c2da30f1551","stateId":211,"easy":"إذا راءيت ← فالرياء الشرك الأصغر","cause":"الرِّياءُ","result":"الشِّركُ الأصغرُ","explicit":true,"similar":["س-05494"],"otherNeedIds":[52],"ref":"مجمع الزوائد 1/107","srcLabel":"مجمع الزوائد","text":["إنَّ أخوفَ ما أخافُ عليكم ",["الشِّركُ الأصغرُ",2]," قال : وما الشِّركُ الأصغرُ يا رسولَ اللهِ ؟ قال : ",["الرِّياءُ",1]," يقولُ اللهُ عزَّ وجلَّ إذا جزى النَّاسَ بأعمالِهم اذهَبوا إلى الَّذين كُنْتُم تُراؤُونَ في الدُّنيا فانظُروا هل تجِدونَ عندَهم جزاءً"],"grade":"صحيح","narrator":"محمود بن لبيد الأنصاري","muhaddith":"رجاله رجال الصحيح","bab":"رقائق وزهد › الرياء والسمعة","dorar":"CyoHx33S","merged":5,"otherRefs":["صحيح الترغيب 35 (صحيح)","مسند عمر 2/796 (صحيح)","المستدرك على الصحيحين 8151 (صحيح)","شرح البخاري لابن بطال 1/113 (صحيح)"]},{"id":"س-05480","fp":"08852109ce3f","stateId":211,"easy":"إذا زيّنت صلاتك لنظر الناس ← فهو الشرك الخفي، أخوف من الدجال","cause":"الشِّركُ الخفيُّ، أن يقومَ الرَّجلُ يصلِّي، فيزيِّنُ صلاتَهُ، لما يرَى مِن نظرِ رجلٍ","result":"ألا أخبرُكُم بما هوَ أخوَفُ عليكُم عندي منَ المسيحِ الدَّجَّالِ","explicit":true,"similar":["س-05152"],"otherNeedIds":[52],"ref":"الترغيب والترهيب 1/52","srcLabel":"ابن ماجه","text":["خرجَ علَينا رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ونحنُ نتذاكَرُ المسيحَ الدَّجَّالَ، فقالَ: ",["ألا أخبرُكُم بما هوَ أخوَفُ عليكُم عندي منَ المسيحِ الدَّجَّالِ ",2],"؟ قالَ: قُلنا: بلَى، فقالَ: ",["الشِّركُ الخفيُّ، أن يقومَ الرَّجلُ يصلِّي، فيزيِّنُ صلاتَهُ، لما يرَى مِن نظرِ رجلٍ",1]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (4204) بلفظه، وأحمد (11252)، والطحاوي في ((شرح مشكل الآثار)) (1781)  كلاهما بنحوه مطولا.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"Xledbkie","merged":2,"otherRefs":["الترغيب والترهيب 1/52 (صحيح)"]},{"id":"س-04915","fp":"14e50c7315fa","stateId":211,"easy":"إذا أحببت على شيء من الجور أو أبغضت على العدل ← فهو من الشرك الخفي","cause":"أن تُحبَّ علَى شيءٍ منَ الجَورِ ، أو تُبْغِضَ علَى شيءٍ منَ العَدلِ","result":"الشِّركُ أخفى في أمَّتي من دَبيبِ النَّملِ علَى الصَّفا في اللَّيلةِ الظَّلماءِ وأدناهُ","explicit":true,"ref":"الجامع الصغير 4918","srcLabel":"العقيلي","text":[["الشِّركُ أخفى في أمَّتي من دَبيبِ النَّملِ علَى الصَّفا في اللَّيلةِ الظَّلماءِ وأدناهُ",2]," ",["أن تُحبَّ علَى شيءٍ منَ الجَورِ ، أو تُبْغِضَ علَى شيءٍ منَ العَدلِ",1]," وَهَلِ الدِّينُ إلَّا الحبُّ في اللَّهِ والبُغضُ في اللَّهِ ؟ قالَ اللَّهُ تعالى : قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/ 60)، والبزار كما في ((كشف الأستار)) (3566)، وأبو نعيم في ((حلية الأولياء)) (8/ 368) واللفظ لهما جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"do8uhe0I"},{"id":"س-05152","fp":"04aec0de5817","stateId":211,"easy":"إذا عملت لأجل نظر الناس ← فهو الشرك الخفي","cause":"أنْ يَعمَلَ الرَّجُلُ لِمكانِ الرَّجُلِ","result":"الشِّرْكُ الخَفِيُّ","explicit":true,"repOf":"س-05480","otherNeedIds":[52],"ref":"المستدرك على الصحيحين 8150","text":[["الشِّرْكُ الخَفِيُّ",2]," ",["أنْ يَعمَلَ الرَّجُلُ لِمكانِ الرَّجُلِ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (11252)، والطحاوي في ((شرح مشكل الآثار)) (1781) كلاهما بلفظ مقارب وفي أوله قصة، وابن ماجه (4204) بنحوه .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Sfg4E1Mo"},{"id":"س-03578","fp":"d3d9ffec02f4","stateId":211,"easy":"إذا راءيت أو اتبعت الشهوة الخفية ← فهو شرك","cause":"الشهوةُ الخفيةُ و الرياءُ","result":"شركٌ","explicit":true,"otherNeedIds":[52],"ref":"الجامع الصغير 4943","srcLabel":"أحمد","text":[["الشهوةُ الخفيةُ و الرياءُ",1]," ",["شركٌ",2]],"grade":"حسن","narrator":"شداد بن أوس","muhaddith":"حسن","takhrij":"أخرجه ابن ماجة (4205 )، وأحمد (17161 )، والطبراني في ((الأوسط)) (4213 ) بمعناه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"AolUXTKd"},{"id":"س-04732","fp":"2e9166f224cc","stateId":211,"easy":"إذا راءيت ← فقد كان يُعدّ شركاً","cause":"الرِّياءَ","result":"الشِّركَ الأكبرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[52],"ref":"مجمع الزوائد 10/225","srcLabel":"الحاكم","text":["كنَّا نعُدُّ ",["الرِّياءَ",1]," على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ",["الشِّركَ الأكبرَ",2]],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"رجاله رجال الصحيح غير يعلى بن شداد وهو ثقة","takhrij":"أخرجه الطبراني في ((الأوسط)) (196)، وابن قانع في ((معجم الصحابة)) (1/ 34) واللفظ لهما، والحاكم (7937)، والبزار (3481) وقالا: الشرك الأصغر، ولم يقولا: الأكبر.","bab":"رقائق وزهد › الإخلاص","dorar":"2KGVrSz4"},{"id":"س-05494","fp":"5fb217b375b4","stateId":211,"easy":"إذا راءيت الناس بعملك ← فالرياء شرك","cause":"يُراؤونَ النَّاسَ بأعمالِهم","result":"الرِّياءُ شِركٌ هو؟ قالَ: نعَمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-05513","otherNeedIds":[52],"ref":"المستدرك على الصحيحين 8154","text":["عن عُبَادةَ بنِ نُسِيٍّ قال: دخَلْتُ على شدَّادِ بنِ أوْسٍ رَضيَ اللهُ عنه في مُصَلَّاهُ وهو يَبْكِي، فقُلْتُ: يا أبا عبدَ الرَّحمنِ، ما الَّذي أبْكاكَ؟ قالَ: حَديثٌ سَمِعْتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُلْتُ: وما هو؟ قالَ: بيْنما أنا عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، إذْ رأيتُ بوجْهِهِ أمرًا ساءَني، فقُلْتُ: بأبي وأُمِّي يا رسولَ اللهِ، ما الَّذي أرى بوَجهِكَ؟ قالَ: أمْرٌ أتخَوَّفُه على أُمَّتي مِن بَعْدِي، قُلتُ: وما هو؟ قالَ: الشِّركُ وشَهوةٌ خَفيَّةٌ، قالَ: قُلتُ: يا رسولَ اللهِ، أتُشْرِكُ أُمَّتُكَ مِن بعْدِكَ؟ قالَ: يا شَدَّادُ، أمَا إنَّهُم لا يَعبُدونَ شمسًا ولا قَمَرًا، ولا وثَنًا ولا حَجَرًا، ولكنْ ",["يُراؤونَ النَّاسَ بأعمالِهم",1],"، قُلتُ: يا رسولَ اللهِ، ",["الرِّياءُ شِركٌ هو؟ قالَ: نعَمْ",2],"، قُلتُ: فما الشَّهوةُ الخفيَّةُ؟ قالَ: يُصبِحُ أحدُهُم صائمًا، فتَعرِضُ له شَهوةٌ مِن شَهواتِ الدُّنيا فيُفطِرُ."],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (4205)، وأحمد (17120) باختلاف يسير.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"gGdimN4i"},{"id":"س-04938","fp":"dff549caac5a","stateId":212,"easy":"إذا تعاملت بالرقى الشركية والتمائم والتِّوَلة ← فهو شرك","cause":"الرُّقى والتَّمائمَ والتِّوَلةَ","result":"شِركٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 3615","srcLabel":"أبو داود","text":["عن زَينبَ امرأةِ عبدِ اللهِ، قالتْ: كان عبدُ اللهِ إذا جاء مِن حاجةٍ فانْتَهى إلى البابِ، تنَحنَحَ وبزَقَ؛ كراهيَةَ أنْ يهجُمَ منَّا على شيءٍ يكرَهُه، قالتْ: وإنَّه جاء ذاتَ يومٍ، فتنَحنَحَ، قالت: وعندي عجوزٌ تَرقيني مِن الحُمْرةِ، فأدخَلْتُها تحتَ السَّريرِ، فدخَلَ، فجلَسَ إلى جَنبي، فرَأى في عُنُقي خَيطًا، قال: ما هذا الخَيطُ؟ قالتْ: قُلْتُ: خَيطٌ أُرقيَ لي فيه، قالتْ: فأخَذَه فقطَعَه، ثُمَّ قال: إنَّ آلَ عبدِ اللهِ لَأغنياءُ عن الشِّركِ، سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ ",["الرُّقى والتَّمائمَ والتِّوَلةَ",1]," ",["شِركٌ",2],"\"، قالتْ: فقُلْتُ له: لِمَ تقولُ هذا وقد كانتْ عَيني تقذِفُ، فكنتُ أختلِفُ إلى فُلانٍ اليهوديِّ يَرقيها، وكان إذا رَقاها سكَنَتْ؟ قال: إنَّما ذلك عملُ الشَّيطانِ، كان ينخُسُها بيَدِه، فإذا رَقَيْتِها كَفَّ عنها، إنَّما كان يَكفيكِ أنْ تَقولي كما قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"أَذهِبِ البَاسَ ربَّ النَّاسِ، اشْفِ أنتَ الشَّافي، لا شفاءَ إلَّا شفاؤكَ، شفاءً لا يُغادِرُ سَقمًا\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (3883)، وابن ماجه (3530)، وأحمد (3615) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"aUsGFm9B","merged":6,"otherRefs":["صحيح ابن حبان 6090 (صحيح)","المستدرك على الصحيحين 7712 (صحيح)","المستدرك على الصحيحين 8510 (صحيح)","المصابيح في الأحاديث المتواترة 592 (صحيح)","صحيح الجامع 1632 (صحيح)"]},{"id":"س-03766","fp":"40c1af8bb2bb","stateId":212,"easy":"إذا علّقت تميمة ← فقد أشركت","cause":"من علَّق تميمةً","result":"فقد أشركَ","explicit":true,"similar":["س-05321"],"ref":"صحيح الجامع 6394","srcLabel":"أحمد","text":[["من علَّق تميمةً ",1],["فقد أشركَ ",2],"[يعني حديث:  أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أقبل إليه رهطٌ فبايعَ تسعةً وأمسك عن واحدٍ فقالوا يا رسولَ اللهِ : بايعتَ تسعةً وتركتَ هذا قال إنَّ عليه تميمةً فأدخل يدَه فقطعها فبايعَه وقال من علَّقَ تميمةً فقد أشركَ]"],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17422)، والحارث في ((المسند)) (563) واللفظ لهما، والحاكم (7513) باختلاف يسير.","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"uMmqAZN9","merged":3,"otherRefs":["غاية المرام 294 (صحيح)","النوافح العطرة 394 (حسن)"]},{"id":"س-05354","fp":"7b05e8206e4e","stateId":212,"easy":"إذا تطيّرت ← فالطيرة شرك","cause":"الطِّيَرةُ","result":"شِركٌ","explicit":true,"ref":"تخريج مشكل الآثار 829","srcLabel":"أبو داود","text":["ثمَّ ذكَر بإسنادِهِ مِثْلَهُ، غيْرَ أنَّه قال: وما مِنَّا إلَّا، ولكنَّ اللهَ عزَّ وجلَّ يُذْهِبُهُ بالتَّوكُّلِ. [يعني حديثَ: ",["الطِّيَرةُ",1]," ",["شِركٌ",2],"، وما مِنَّا [إلَّا]، ولكنَّ اللهَ يُذهِبُهُ بالتَّوكُّلِ.]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3910)، والترمذي (1614)، وابن ماجه (3538) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"pVNRCBR8","merged":3,"otherRefs":["غاية المرام 303 (صحيح)","صحيح الأدب المفرد 698 (صحيح)"]},{"id":"س-03773","fp":"66e9a7fe1716","stateId":212,"easy":"إذا ردّتك الطيرة (التشاؤم) عن حاجتك ← فقد أشركت","cause":"من ردَّتهُ الطِّيَرةُ مِن حاجةٍ","result":"فقد أشرَكَ","explicit":true,"similar":["س-05159"],"ref":"تخريج المسند لشاكر 12/10","srcLabel":"أحمد","text":[["من ردَّتهُ الطِّيَرةُ مِن حاجةٍ ",1],["فقد أشرَكَ",2]," قالوا يا رسولَ اللَّهِ ما كفَّارةُ ذلِكَ قالَ أن يَقولَ أحدُهُم اللَّهمَّ لا خَيرَ إلَّا خيرُكَ ولا طيرَ إلَّا طيرُكَ ولا إلَهَ غَيرُكَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7045) واللفظ له، والطبراني (14/35) (14622)","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"c4gxT93I","merged":2,"otherRefs":["إصلاح المساجد 117 (صحيح)"]},{"id":"س-05321","fp":"5d25dc95c324","stateId":212,"easy":"إذا علّقت تميمة ← فقد أشركت","cause":"من تعلَّقَ تميمةً","result":"فقد أشرك","explicit":true,"repOf":"س-03766","ref":"فتاوى نور على الدرب لابن باز 1/341","text":["من تعلَّقَ تميمةً فلا أتمَّ اللهُ له ومن تعلقَ ودعةً فلا ودعَ اللهُ له وفي روايةٍ عنه أنه قال: ",["من تعلَّقَ تميمةً ",1],["فقد أشرك",2],"."],"grade":"صحيح","narrator":"[عقبة بن عامر ]","muhaddith":"ثابت","takhrij":"أخرجه أحمد (17404)، وأبو يعلى (1759)، والطبراني في ((مسند الشاميين)) (234)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ySo0C7r5","merged":2,"otherRefs":["الفوائد العلمية من الدروس البازية 3/165 (حسن)"]},{"id":"س-03764","fp":"77225b04094a","stateId":212,"easy":"إذا علّقت حلقة أو تميمة لدفع المرض ← لا تزيدك إلا وهناً، ولو مت وهي عليك ما أفلحت","cause":"على عضدِ رجلٍ حلقةً أراهُ قالَ: من صُفرٍ قال: ويحَكَ ما هذِهِ؟ قال: منَ الواهنة","result":"إنَّها لا تزيدُكُ إلَّا وَهنًا انبِذها عنك فإنَّكَ لو متَّ وَهيَ عليكَ ما أفلحتَ أبدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57,34],"ref":"الزواجر عن اقتراف الكبائر 1/166","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أنَّه صلَّى اللَّهُ عليهِ وسلَّمَ أبصرَ ",["على عضدِ رجلٍ حلقةً أراهُ قالَ: من صُفرٍ قال: ويحَكَ ما هذِهِ؟ قال: منَ الواهنة",1]," قال: أما ",["إنَّها لا تزيدُكُ إلَّا وَهنًا انبِذها عنك فإنَّكَ لو متَّ وَهيَ عليكَ ما أفلحتَ أبدًا",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"0n7Fbsz7","merged":3,"otherRefs":["الفتح الرباني 1/318 (حسن)","صحيح ابن حبان 6088 (صحيح)"]},{"id":"س-05159","fp":"f9953cc75ce1","stateId":212,"easy":"إذا ردّتك الطيرة عن شيء ← فقد قارفت الشرك","cause":"مَن ردَّتْه الطيرُ عن شيءٍ","result":"فقد قارَف الشِّركَ","explicit":true,"repOf":"س-03773","ref":"مختصر زوائد البزار 1/642","text":[["مَن ردَّتْه الطيرُ عن شيءٍ ",1],["فقد قارَف الشِّركَ",2]],"grade":"حسن","narrator":"رويفع بن ثابت الأنصاري","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (2316)، وابن عبد الحكم في ((فتوح مصر)) (صـ309)، باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lmmhWNX8"},{"id":"س-03132","fp":"73e0b7301738","stateId":213,"easy":"إذا قلت إن الله لن يعيدك كما بدأك ← فقد كذّبت الله","cause":"فقَوْلُه: إنِّي لا أُعيدُه كما بَدَأْتُه","result":"كَذَبَني ابنُ آدَمَ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"الأحكام الوسطى 4/ 290","srcLabel":"البخاري","text":["\"قالَ اللهُ تَبارَكَ وتَعالى: ",["كَذَبَني ابنُ آدَمَ",2],"، ولم يكنْ له أن يَكذِبَني، وشَتَمَني ابنُ آدَمَ، ولم يكنْ له أن يَشتِمَني، أمَّا تَكْذيبُه إيَّاي ",["فقَوْلُه: إنِّي لا أُعيدُه كما بَدَأْتُه",1],"، وليس آخِرُ الخَلْقِ بأَعَزَّ علَيَّ مِن أوَّلِه، وأمَّا شَتْمُه إيَّاي فقَوْلُه: اتَّخَذَ اللهُ وَلَدًا، وأنا اللهُ الأَحَدُ الصَّمَدُ، الَّذي لم أَلِدْ ولم أُولَدْ، ولم يكنْ لي كُفُوًا أحَدٌ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (4975)، والنسائي (2078)، وابن حبان (267) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"oAlKYHuP","merged":9,"otherRefs":["أضواء البيان 4/430 (صحيح)","تخريج المسند لشعيب 9114 (صحيح)","صحيح الجامع 4323 (صحيح)","شرح السنة 1/103 (صحيح)","صحيح البخاري 4975 (صحيح)","صحيح الجامع 4327 (صحيح)","صحيح البخاري 3193 (صحيح)","تخريج المسند لشاكر 16/250 (صحيح)"]},{"id":"س-03133","fp":"5942f838d467","stateId":213,"easy":"إذا قلت «اتخذ الله ولداً» ← فقد شتمت الله","cause":"فقَوْلُه: اتَّخَذَ اللهُ وَلَدًا","result":"وشَتَمَني ابنُ آدَمَ","explicit":true,"star":true,"otherNeedIds":[27],"ref":"الأحكام الوسطى 4/ 290","srcLabel":"البخاري","text":["\"قالَ اللهُ تَبارَكَ وتَعالى: كَذَبَني ابنُ آدَمَ، ولم يكنْ له أن يَكذِبَني، ",["وشَتَمَني ابنُ آدَمَ",2],"، ولم يكنْ له أن يَشتِمَني، أمَّا تَكْذيبُه إيَّاي فقَوْلُه: إنِّي لا أُعيدُه كما بَدَأْتُه، وليس آخِرُ الخَلْقِ بأَعَزَّ علَيَّ مِن أوَّلِه، وأمَّا شَتْمُه إيَّاي ",["فقَوْلُه: اتَّخَذَ اللهُ وَلَدًا",1],"، وأنا اللهُ الأَحَدُ الصَّمَدُ، الَّذي لم أَلِدْ ولم أُولَدْ، ولم يكنْ لي كُفُوًا أحَدٌ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (4975)، والنسائي (2078)، وابن حبان (267) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"oAlKYHuP","merged":9,"otherRefs":["أضواء البيان 4/430 (صحيح)","تخريج المسند لشعيب 9114 (صحيح)","صحيح الجامع 4323 (صحيح)","شرح السنة 1/103 (صحيح)","صحيح البخاري 4975 (صحيح)","صحيح الجامع 4327 (صحيح)","صحيح البخاري 3193 (صحيح)","تخريج المسند لشاكر 16/250 (صحيح)"]},{"id":"ق-0272","fp":"c1c249d9b129","stateId":213,"easy":"الإيمان ببعض الرسل والكفر ببعض ← الكفر حقاً وعذاب مهين","cause":"الإيمان ببعض الرسل والكفر ببعض","result":"الكفر حقاً وعذاب مهين","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة النساء: 150–151","srcLabel":"القرآن الكريم","quran":{"s":4,"from":150,"to":151,"text":"إِنَّ الَّذِينَ يَكْفُرُونَ بِاللَّهِ وَرُسُلِهِ وَيُرِيدُونَ أَنْ يُفَرِّقُوا بَيْنَ اللَّهِ وَرُسُلِهِ وَيَقُولُونَ نُؤْمِنُ بِبَعْضٍ وَنَكْفُرُ بِبَعْضٍ وَيُرِيدُونَ أَنْ يَتَّخِذُوا بَيْنَ ذَلِكَ سَبِيلًا (150) أُولَئِكَ هُمُ الْكَافِرُونَ حَقًّا وَأَعْتَدْنَا لِلْكَافِرِينَ عَذَابًا مُهِينًا (151)","hl":[[0,297,1]]}},{"id":"ق-0308","fp":"2e990d099f72","stateId":213,"easy":"ترك الحكم بما أنزل الله ← الكفر","cause":"ترك الحكم بما أنزل الله","result":"الكفر","explicit":true,"star":true,"similar":["س-02680"],"ref":"سورة المائدة: 44","srcLabel":"القرآن الكريم","quran":{"s":5,"from":44,"to":44,"text":"إِنَّا أَنْزَلْنَا التَّوْرَاةَ فِيهَا هُدًى وَنُورٌ يَحْكُمُ بِهَا النَّبِيُّونَ الَّذِينَ أَسْلَمُوا لِلَّذِينَ هَادُوا وَالرَّبَّانِيُّونَ وَالْأَحْبَارُ بِمَا اسْتُحْفِظُوا مِنْ كِتَابِ اللَّهِ وَكَانُوا عَلَيْهِ شُهَدَاءَ فَلَا تَخْشَوُا النَّاسَ وَاخْشَوْنِ وَلَا تَشْتَرُوا بِآيَاتِي ثَمَنًا قَلِيلًا وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ فَأُولَئِكَ هُمُ الْكَافِرُونَ (44)","hl":[[308,382,1]]}},{"id":"ق-0508","fp":"aebd0a5da5f5","stateId":213,"easy":"الاستهزاء بالله وآياته ورسوله ← الكفر بعد الإيمان والعذاب","cause":"الاستهزاء بالله وآياته ورسوله","result":"الكفر بعد الإيمان والعذاب","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة التوبة: 65–66","srcLabel":"القرآن الكريم","quran":{"s":9,"from":65,"to":66,"text":"وَلَئِنْ سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ قُلْ أَبِاللَّهِ وَآيَاتِهِ وَرَسُولِهِ كُنْتُمْ تَسْتَهْزِئُونَ (65) لَا تَعْتَذِرُوا قَدْ كَفَرْتُمْ بَعْدَ إِيمَانِكُمْ إِنْ نَعْفُ عَنْ طَائِفَةٍ مِنْكُمْ نُعَذِّبْ طَائِفَةً بِأَنَّهُمْ كَانُوا مُجْرِمِينَ (66)","hl":[[70,280,1]]}},{"id":"ق-0612","fp":"8d2d78c654c3","stateId":213,"easy":"اليأس من رَوح الله ← من صفات الكافرين","cause":"اليأس من رَوح الله","result":"من صفات الكافرين","explicit":true,"ref":"سورة يوسف: 87","srcLabel":"القرآن الكريم","quran":{"s":12,"from":87,"to":87,"text":"يَا بَنِيَّ اذْهَبُوا فَتَحَسَّسُوا مِنْ يُوسُفَ وَأَخِيهِ وَلَا تَيْأَسُوا مِنْ رَوْحِ اللَّهِ إِنَّهُ لَا يَيْأَسُ مِنْ رَوْحِ اللَّهِ إِلَّا الْقَوْمُ الْكَافِرُونَ (87)","hl":[[59,167,1]]}},{"id":"ق-0863","fp":"85cfcdc8524d","stateId":213,"easy":"الإعراض عن حكم الله ورسوله ← مرض القلب والظلم","cause":"الإعراض عن حكم الله ورسوله","result":"مرض القلب والظلم","explicit":true,"ref":"سورة النور: 48–50","srcLabel":"القرآن الكريم","quran":{"s":24,"from":48,"to":50,"text":"وَإِذَا دُعُوا إِلَى اللَّهِ وَرَسُولِهِ لِيَحْكُمَ بَيْنَهُمْ إِذَا فَرِيقٌ مِنْهُمْ مُعْرِضُونَ (48) وَإِنْ يَكُنْ لَهُمُ الْحَقُّ يَأْتُوا إِلَيْهِ مُذْعِنِينَ (49) أَفِي قُلُوبِهِمْ مَرَضٌ أَمِ ارْتَابُوا أَمْ يَخَافُونَ أَنْ يَحِيفَ اللَّهُ عَلَيْهِمْ وَرَسُولُهُ بَلْ أُولَئِكَ هُمُ الظَّالِمُونَ (50)","hl":[[0,302,1]]}},{"id":"ق-0868","fp":"c3c413c7f0c8","stateId":213,"easy":"الكفر بعد النعمة والتمكين ← الفسق","cause":"الكفر بعد النعمة والتمكين","result":"الفسق","explicit":true,"ref":"سورة النور: 55","srcLabel":"القرآن الكريم","quran":{"s":24,"from":55,"to":55,"text":"وَعَدَ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَعَمِلُوا الصَّالِحَاتِ لَيَسْتَخْلِفَنَّهُمْ فِي الْأَرْضِ كَمَا اسْتَخْلَفَ الَّذِينَ مِنْ قَبْلِهِمْ وَلَيُمَكِّنَنَّ لَهُمْ دِينَهُمُ الَّذِي ارْتَضَى لَهُمْ وَلَيُبَدِّلَنَّهُمْ مِنْ بَعْدِ خَوْفِهِمْ أَمْنًا يَعْبُدُونَنِي لَا يُشْرِكُونَ بِي شَيْئًا وَمَنْ كَفَرَ بَعْدَ ذَلِكَ فَأُولَئِكَ هُمُ الْفَاسِقُونَ (55)","hl":[[300,358,1]]}},{"id":"س-02400","fp":"a48c3aac4720","stateId":213,"easy":"إذا تركت واحدة من أركان الإسلام (جحوداً) ← فأنت كافر","cause":"فمن ترَكَ واحدةً منهن","result":"فهو كافِرٌ","explicit":true,"otherNeedIds":[52],"ref":"الكبائر للذهبي 158","srcLabel":"أبو يعلى","text":["عُرَى الإسلامِ وقواعِدُ الدِّينِ ثلاثةٌ: شهادةُ أنْ لا إلهَ إلا اللهُ، والصَّلاةُ، وصَوْمُ رمضانَ، ",["فمن ترَكَ واحدةً منهن",1]," ",["فهو كافِرٌ",2],"، وتَجِدُه كثيرَ المالِ ولم يَحُجَّ ولم يُزَكِّ ولا يَحِلُّ دَمُه."],"grade":"صحيح","narrator":"[عبدالله بن عباس]","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (2349)، واللالكائي في ((شرح أصول الاعتقاد)) (1576)، وقوام السنة في ((الترغيب والترهيب)) (1932) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"j2RxxyHV","merged":4,"otherRefs":["الزواجر عن اقتراف الكبائر 1/131 (حسن)","مجمع الزوائد 1/53 (حسن)","الزواجر عن اقتراف الكبائر 1/195 (حسن)"]},{"id":"س-02680","fp":"005be8a018cc","stateId":213,"easy":"إذا لم تحكم بما أنزل الله ← فهو كفر دون كفر","cause":"وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ","result":"كُفرٌ دونَ كُفرٍ","explicit":true,"repOf":"ق-0308","ref":"المستدرك على الصحيحين 3261","text":["قالُ ابنُ عبَّاسٍ رَضيَ اللهُ عنهُما: إنَّه ليس بالكُفْرِ الَّذي يَذهبونَ إليه، إنَّه ليس كُفرًا يَنقُلُ عنْ مِلَّةٍ، {",["وَمَنْ لَمْ يَحْكُمْ بِمَا أَنْزَلَ اللَّهُ",1]," فَأُولَئِكَ هُمُ الْكَافِرُونَ} [المائدة: 44] ",["كُفرٌ دونَ كُفرٍ",2],"."],"grade":"صحيح","narrator":"طاوس","muhaddith":"صحيح الإسناد","bab":"إيمان › الحكم بما أنزل الله","dorar":"krZwHZEw","merged":2,"otherRefs":["الإيمان لابن تيمية 310 (صحيح)"]},{"id":"س-04801","fp":"ba0aa26a4c21","stateId":213,"easy":"إذا كفرت بعد إسلامك ← لا تُقبل توبتك (حتى تعود)","cause":"كَفَرَ بعدَ إِسْلامِهِ","result":"لا يَقْبَلُ تَوْبَةَ عبدٍ","explicit":true,"similar":["س-01296"],"otherNeedIds":[52],"ref":"السلسلة الصحيحة 2545","srcLabel":"أحمد","text":["إِنَّ اللهَ تباركَ وتعالى ",["لا يَقْبَلُ تَوْبَةَ عبدٍ",2]," ",["كَفَرَ بعدَ إِسْلامِهِ",1]],"grade":"صحيح","narrator":"معاوية بن حيدة القشيري","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه أحمد (20018) واللفظ له، والطبراني في ((المعجم الكبير)) (19/ 419) (1013) بلفظه مطولًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UMjWJ6RO","merged":2,"otherRefs":["الإلزامات والتتبع 115 (صحيح)"]},{"id":"س-02709","fp":"26095ea5a8f6","stateId":213,"easy":"إذا كفرت بحرف أو آية من القرآن ← فقد كفرت به كله","cause":"من كفر بحرفٍ من القرآنِ ، أو بآيةٍ منه","result":"فقد كفر به كلَّه","explicit":true,"ref":"تفسير الطبري 1/30","srcLabel":"عبدالرزاق","text":["عن عبدِ اللهِ قال : ",["من كفر بحرفٍ من القرآنِ ، أو بآيةٍ منه ",1],["فقد كفر به كلَّه",2]],"grade":"صحيح","narrator":"إبراهيم النخعي","muhaddith":"صحيح","takhrij":"أخرجه عبدالرزاق (15946) مطولاً باختلاف يسير","bab":"إيمان › السحر والنشرة والكهانة","dorar":"gfFtF1F3"},{"id":"س-03549","fp":"2cbf0859f9d9","stateId":213,"easy":"إذا كفرت بالرجم ← كفرت بالقرآن من حيث لا تحتسب","cause":"مَن كَفَر بالرَّجمِ","result":"فقدْ كفَرَ بالقرآنِ مِن حيثُ لا يَحتسِبُ؛ قولَه عزَّ وجلَّ","explicit":true,"ref":"المستدرك على الصحيحين 8282","srcLabel":"النسائي","text":["عن ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قال: ",["مَن كَفَر بالرَّجمِ ",1],["فقدْ كفَرَ بالقرآنِ مِن حيثُ لا يَحتسِبُ؛ قولَه عزَّ وجلَّ: ",2],"{يَا أَهْلَ الْكِتَابِ قَدْ جَاءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ كَثِيرًا مِمَّا كُنْتُمْ تُخْفُونَ مِنَ الْكِتَابِ} [المائدة: 15]، فكان الرَّجمُ ممَّا أخْفَوا ."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه النسائي في ((الكبرى)) (7124)، والطحاوي في ((شرح المشكل)) (15/ 95) كلاهما بلفظه، وابن حبان (4430) باختلاف ىيسير.","bab":"استغفار › مكفرات الذنوب","dorar":"JuyT0nFE"},{"id":"س-04890","fp":"aacff8b818d2","stateId":213,"easy":"إذا استحللت محارم القرآن ← فما آمنت به","cause":"منِ استحلَّ محارمَهُ","result":"ما آمنَ بالقرآنِ","explicit":true,"ref":"الجامع الصغير 7751","srcLabel":"الترمذي","text":[["ما آمنَ بالقرآنِ",2]," ",["منِ استحلَّ محارمَهُ",1]],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2918)، والطبراني (8/36) (7295)، والبيهقي في ((شعب الإيمان)) (173)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"iqf1CHQ3"},{"id":"س-07508","fp":"684994607d81","stateId":213,"easy":"إذا بعت دينك بعرض من الدنيا ← تصبح مؤمناً وتمسي كافراً","cause":"يَبيعُ فيها أقْوامٌ دينَهم بعَرَضٍ منَ الدُّنْيا","result":"يُصبِحُ الرَّجلُ فيها مُؤمِنًا، ويُمْسي كافِرًا","explicit":true,"ref":"المستدرك على الصحيحين 6379","srcLabel":"الحاكم","text":["أَنَّ الضَّحَّاكَ بْنَ قَيْسٍ، كَتَبَ إلى قَيسِ بنِ الهَيثَمِ حيثُ ماتَ يَزيدُ بنُ مُعاويةَ: سَلامٌ عليكَ أمَّا بعدُ، فإنِّي سمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: إنَّ بيْنَ يدَيِ السَّاعةِ فِتَنًا كقِطَعِ الدُّخانِ، يَموتُ منها قَلبُ الرَّجلِ كما يَموتُ بدَنُه، ",["يُصبِحُ الرَّجلُ فيها مُؤمِنًا، ويُمْسي كافِرًا",2],"، ويُمْسي مُؤمِنًا ويُصبِحُ كافِرًا، ",["يَبيعُ فيها أقْوامٌ دينَهم بعَرَضٍ منَ الدُّنْيا",1],"، وأنَّ يَزيدَ قد ماتَ، وأنتم إخْوانُنا وأشِقَّاؤُنا."],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"[صحيح]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"b7oDuNwB"},{"id":"س-07828","fp":"8d9b173c0ef4","stateId":213,"easy":"إذا جحدت آية ← فقد جحدت القرآن كله","cause":"فإنَّه من جَحَد بآيةٍ","result":"جحَدَ به كُلِّه","explicit":true,"ref":"تفسير الطبري 1/18","srcLabel":"الطبراني","text":["لَمَّا خَرَج عبدُ اللهِ بنُ مسعودٍ من الكوفةِ اجتمع إليه أصحابُه فوَدَّعَهم، ثمَّ قال: لا تنازَعوا في القرآنِ؛ فإنَّه لا يختَلِفُ ولا يتلاشى، ولا يتغَيَّرُ لكثرةِ الرَّدِّ، وإنَّ شريعةَ الإسلامِ وحدودَه وفرائِضَه فيه واحِدةٌ، ولو كان شيءٌ مِنَ الحرفينِ يَنهى عن شيءٍ يأمُرُ به الآخَرُ، كان ذلك الاختلافَ، ولكِنَّه جامِعٌ ذلك كلَّه، لا تختَلِفُ فيه الحدودُ ولا الفرائضُ، ولا شيءٌ من شرائعِ الإسلامِ، ولقد رأيتُنا نتنازعُ فيه عند رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فيأمُرُنا فنقرَأُ عليه، فيُخبِرُنا أنَّا كُلُّنا محسِنٌ، ولو أعلَمُ أحدًا أعلَمَ بما أَنزَلَ اللهُ على رسولِه منِّي لطلَبْتُه؛ حتى أزدادَ عِلْمَه إلى علمي، ولقد قرأتُ من لسانِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم سبعينَ سورةً، وقد كنتُ عَلِمْتُ أنَّه يَعرِضُ عليه القرآنَ في كلِّ رمضانَ، حتى كان عامُ قُبِضَ، فعَرَض عليه مرَّتين، فكان إذا فَرَغ أقرأُ عليه، فيخبِرُني أنِّي محسِنٌ، فمَن قرأ على قراءتي فلا يدَعَنَّها رغبةً عنها، ومن قرأَ على شيءٍ من هذه الحروفِ فلا يدَعَنَّه رغبةً عنه؛ ",["فإنَّه من جَحَد بآيةٍ",1]," ",["جحَدَ به كُلِّه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"ثابت","takhrij":"أخرجه الطبراني (10076) (10/ 97)، والبيهقي في ((شعب الإيمان)) (2074) واللفظ لهما. والمستغفري في ((فضائل القرآن)) (252) مختصرا.","bab":"قرآن › نزول القرآن","dorar":"LzEYfMWd"},{"id":"س-01296","fp":"1d624966758b","stateId":213,"easy":"إذا أشركت بعد إسلامك ← لا يقبل الله توبتك (حتى تفارق الشرك)","cause":"أشركَ بعدَ إسلامِهِ","result":"لا يقبَلُ اللَّهُ جلَّ وعزَّ من أحدٍ توبةً","explicit":true,"repOf":"س-04801","otherNeedIds":[52],"ref":"الصحيح المسند 2/178","text":["بعثنيَ اللَّهُ تباركَ وتعالى بالإسلامِ قالَ وما الإسلامُ قالَ شهادةُ أن لا إلهَ إلَّا اللَّهُ وأنَّ محمَّدًا عبدُهُ ورسولُهُ وتقيمُ الصَّلاةَ وتؤتِي الزَّكاةَ أَخَوانِ نصيرانِ ",["لا يقبَلُ اللَّهُ جلَّ وعزَّ من أحدٍ توبةً",2]," ",["أشركَ بعدَ إسلامِهِ",1]," قالَ قلتُ يا رسولَ اللَّهِ ما حقُّ زوجِ أحدِنا عليهِ قالَ تطعِمُها إذا أكلتَ وتكسوها إذا اكتسيْتَ ولا تضرِبِ الوجهَ ولا تقبِّحْ ولا تهجُر إلَّا في البيتِ ثمَّ قالَ ههُنا تُحشَرون ههُنا تحشَرون هُهُنا تُحشَرون ثلاثًا رُكبانًا ومشاةً وعلى وجوهِكم تُوفونَ يومَ القيامةِ سبعينَ أمَّةً أنتم آخرُ الأممِ وأكرمُها على اللَّهِ تبارك وتعالى تأتونَ يومَ القيامةِ وعلى أفواهِكمُ الفِدامُ أوَّلُ ما يعرِبُ عن أحدِكم فخِذُهُ"],"grade":"حسن","narrator":"معاوية بن حيدة القشيري","muhaddith":"حسن","takhrij":"أخرجه أحمد (20011)، والطبراني في ((المعجم الأوسط)) (6402)، وابن عساكر (1/ 95) واللفظ لهم.","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"FG2vppBe"},{"id":"س-02611","fp":"d834d6e8afd3","stateId":213,"easy":"إذا تركت شعائر الإسلام ← فقد ولّيت الإسلام ظهرك","cause":"ومن تركهنَّ","result":"فقد ولَّى الإسلامَ ظهرَه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الإيمان لأبي عبيد 14","srcLabel":"البخاري","text":["[ إنَّ ] للإسلام صِوًى ومنارًا كمنار الطريقِ ، منها أن تُؤمنَ بالله ولا تشركَ به شيئًا ، وإقامةُ الصلاةِ ، وإيتاءُ الزكاةِ ، وصومُ رمضانَ ، وحجُّ البيتِ ، والأمرُ بالمعروفِ ، والنهيُ عن المنكر ، وأن تُسلِّمَ على أهلِك إذا دخلتَ عليهم ، وأن تُسَلِّمَ على القومِ إذا مررتَ بهم ، فمن ترك من ذلك شيئًا [ فقد ترك سهمًا من الإسلامِ ، ",["ومن تركهنَّ",1]," ] ",["فقد ولَّى الإسلامَ ظهرَه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (429)، وأبو نعيم في ((حلية الأولياء)) (5/217) باختلاف يسير، والحاكم (52) مختصراً باختلاف يسير","bab":"إيمان › الأمر بالإيمان بالله تعالى ورسوله وشرائع الدين","dorar":"6RcPsZxP","merged":3,"otherRefs":["السلسلة الصحيحة 333 (صحيح)","المستدرك على الصحيحين 53 (صحيح)"]},{"id":"س-03986","fp":"7c9a8563a8a6","stateId":213,"easy":"إذا أشركت بالله ← فهو الذنب الذي لا يُغفر","cause":"فالشِّرْكُ باللهِ","result":"فأمَّا الذنبُ الذي لَا يُغْفَرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03928"],"otherNeedIds":[13,69],"ref":"الجامع الصغير 4321","srcLabel":"الطبراني","text":["ذنبٌ يُغْفَرُ ، وذنبٌ لا يُغْفَرُ ، وذنبٌ يُجَازَى بِهِ ، ",["فأمَّا الذنبُ الذي لَا يُغْفَرُ",2]," : ",["فالشِّرْكُ باللهِ",1]," ، وأمَّا الذنْبُ الذى يُغْفَرُ : فعَمَلُكَ بينَكَ وبينَ ربِّكَ ، وأمَّا الذنْبُ الذي يُجَازَى بِهِ : فظلْمُكَ أخاكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7595) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"s3XdCCjy","merged":3,"otherRefs":["الجامع الصغير 4320 (صحيح)","البعث والنشور 292 (حسن)"]},{"id":"س-03928","fp":"c71b9c6ee253","stateId":213,"easy":"إذا أشركت بالله ← فهو الذنب الذي لا يغفره الله","cause":"فأمَّا الدِّيوانُ الَّذي لا يَغفِرُ اللهُ منه شَيئًا","result":"فالإشراكُ باللهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03986","otherNeedIds":[69],"ref":"المستدرك على الصحيحين 8943","text":["الدَّواوينُ ثَلاثةٌ؛ فدِيوانٌ لا يَغفِرُ اللهُ منه شَيئًا، ودِيوانٌ لا يَعبَأُ اللهُ به شَيئًا، ودِيوانٌ لا يَترُكُ اللهُ منه شَيئًا، ",["فأمَّا الدِّيوانُ الَّذي لا يَغفِرُ اللهُ منه شَيئًا",1]," ",["فالإشراكُ باللهِ",2]," عزَّ وجلَّ؛ قال اللهُ عزَّ وجلَّ: {إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ} [النساء: 48]، وأمَّا الدِّيوانُ الَّذي لا يَعبَأُ اللهُ به شَيئًا قطُّ فظُلمُ العبدِ نفْسَه فيما بيْنه وبيْن ربِّه، وأمَّا الدِّيوانُ الَّذي لا يَترُكُ اللهُ منه شَيئًا فمَظالِمُ العِبادِ بيْنهم، القِصاصُ لا مَحالةَ."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد ولم يخرجاه","bab":"تفسير آيات › سورة النساء","dorar":"8til7RAO","merged":2,"otherRefs":["البعث والنشور 393 (حسن)"]},{"id":"س-05271","fp":"c8272c0386c5","stateId":214,"easy":"إذا تركت الصلاة متعمداً ← فقد خرجت من الملة","cause":"فمَن تَرَكَها مُتَعَمِّدًا","result":"فقدْ خَرَجَ مِن المِلَّةِ","explicit":true,"star":true,"similar":["س-06439","س-05254","س-06438"],"ref":"الأحاديث المختارة 8 / 287","srcLabel":"متفق عليه","text":["«أوْصانا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بسَبْعِ خِلالٍ فقالَ: (لا تُشْرِكوا باللهِ شَيئًا وإن قُطِعْتُم أو حُرِقْتُم أو صُلِبْتُم، ولا تَتْرُكوا الصَّلاةَ مُتَعَمِّدينَ، ",["فمَن تَرَكَها مُتَعَمِّدًا ",1],["فقدْ خَرَجَ مِن المِلَّةِ",2],"، ولا تَركَبوا المَعصيةَ فإنَّها سَخَطُ اللهِ، ولا تَقْرَبوا الخَمْرَ فإنَّها رَأسُ الخَطايا كلِّها، ولا تَفِرُّوا مِن المَوْتِ أو القَتْلِ وإن كُنْتُم فيه، ولا تَعْصِ والدَيك، وإن أمَراك أن تَخرُجَ مِن الدُّنْيا كلِّها فاخْرُجْ، ولا تَضَعْ عَصاك عن أهْلِك وأَنْصِفْهم مِن نَفْسِك)»."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ayBgZbFv"},{"id":"س-05208","fp":"0e8d0dee26f3","stateId":214,"easy":"إذا تركت الصلاة ← فليس بينك وبين الشرك إلا تركها","cause":"تَركُ الصَّلاةِ","result":"ليسَ بينَ العبدِ و الشِّركِ إلَّا","explicit":true,"star":true,"ref":"صحيح الترغيب 568","srcLabel":"ابن ماجه","text":[["ليسَ بينَ العبدِ و الشِّركِ إلَّا",2]," ",["تَركُ الصَّلاةِ",1]," ، فإذا تركَها فقَد أشركَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (1080) واللفظ له، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (897)، وأبو يعلى (4100) بنحوه","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lDJw5lJN","merged":11,"otherRefs":["صحيح الترمذي 2619 (صحيح)","الترغيب والترهيب 1/260 (صحيح)","صحيح مسلم 82 (صحيح)","صحيح الترغيب 563 (صحيح)","حلية الأولياء 8/282 (صحيح)","النوافح العطرة 93 (صحيح)","حديث المساء 431 (صحيح)","تخريج مشكل الآثار 3175 (صحيح)","حلية الأولياء 8/126 (صحيح)"]},{"id":"س-06439","fp":"145f9f789bd6","stateId":214,"easy":"إذا تركت الصلاة ← فقد كفرت","cause":"من ترك الصلاةَ","result":"فقد كَفَرَ","explicit":true,"repOf":"س-05271","ref":"عارضة الأحوذي 6/84","text":[["من ترك الصلاةَ ",1],["فقد كَفَرَ",2]," ومن أَبَقَ من مَواليهِ فقد كَفَرَ وقال في النساءِ رأيتُكُنَّ أكثرَ أهلِ النارِ بِكُفرانِ الإحسانِ والعَشِيرِ"],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › تارك الصلاة","dorar":"kKuAhjhg","merged":3,"otherRefs":["الأجوبة المرضية 1/84 (حسن)","خلاصة البدر المنير 1/284 (صحيح)"]},{"id":"س-06474","fp":"6399e2069fd7","stateId":214,"easy":"إذا تركت الصلاة ← فهي العمل الوحيد الذي تركه كفر","cause":"غيرَ الصَّلاةِ","result":"تركُه كفرٌ","explicit":true,"ref":"الأجوبة المرضية 2/819","srcLabel":"الترمذي","text":["عن عبدِ اللَّهِ بنِ شقيقٍ قالَ كانَ أصحابُ محمَّدٍ صلَّى اللَّهُ عليهِ وسلَّمَ رضِي اللَّه عنهم لا يرَونَ شيئًا منَ الأعمالِ ",["تركُه كفرٌ",2]," ",["غيرَ الصَّلاةِ",1]],"grade":"صحيح","narrator":"عبدالله بن شقيق","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2622)، وابن نصر في ((تعظيم قدر الصلاة)) (948) باختلاف يسير، وابن أبي شيبة في ((الإيمان)) (137) بنحوه.","bab":"صلاة › فرض الصلاة","dorar":"GOBnqqJm","merged":3,"otherRefs":["تحفة المحتاج 1/575 (صحيح)","فتاوى نور على الدرب لابن باز 6/59 (صحيح)"]},{"id":"س-05254","fp":"1ab083aaf118","stateId":214,"easy":"إذا تركت الصلاة ← فقد كفرت","cause":"فمَن ترَكَها","result":"فقدْ كَفَرَ","explicit":true,"repOf":"س-05271","ref":"المستدرك على الصحيحين 11","text":["«العَهدُ الَّذي بيْنَنا وبيْنَهمُ الصَّلاةُ؛ ",["فمَن ترَكَها ",1],["فقدْ كَفَرَ»",2],"."],"grade":"صحيح","narrator":"بريدة","muhaddith":"صحيح الإسناد ... وله شاهد صحيح على شرطهما جميعا»","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lhYBRRF8","merged":2,"otherRefs":["صحيح الترغيب 566 (صحيح)"]},{"id":"س-06440","fp":"9e4fdda0cd2a","stateId":214,"easy":"إذا تركت الصلاة ← فلا حق لك في الإسلام","cause":"لمن ترك الصلاةَ","result":"ولا حقَّ في الإسلامِ","explicit":true,"similar":["س-05227","س-06490"],"ref":"مجمع الزوائد 1/300","srcLabel":"أحمد","text":["دخلت على عمرَ بنِ الخطابِ وهو مسجًّى فقلت كيفَ ترونه قالوا كما ترَى قلت أيقِظوه بالصلاةِ فإنكم لن توقِظوه لشيءٍ أفزعَ له من الصلاةِ فقالوا الصلاةَ يا أميرَ المؤمنينَ فقال ها اللهِ إذًا ",["ولا حقَّ في الإسلامِ",2]," ",["لمن ترك الصلاةَ",1]," فصلَّى وإن جرحَه ليثعبُ دمًا"],"grade":"صحيح","narrator":"المسور بن مخرمة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (8181) واللفظ له، وابن الأعرابي في ((معجمه)) (407) باختلاف يسير، ومالك (117)، وأحمد في ((الزهد)) (656) بنحوه.","bab":"صلاة › تارك الصلاة","dorar":"olRe6LL4","merged":2,"otherRefs":["تخريج شرح السنة 330 (صحيح)"]},{"id":"س-02605","fp":"b0ed87949fc3","stateId":214,"easy":"إذا تركت الصلاة ← فأنت كافر","cause":"تارِكَ الصَّلاةِ","result":"كافِرٌ","explicit":true,"ref":"تنبيه الغافلين 162","srcLabel":"تنبيه الغافلين","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّ ",["تارِكَ الصَّلاةِ",1]," ",["كافِرٌ",2]],"grade":"صحيح","muhaddith":"[صحيح]","bab":"إيمان › أعمال تنافي الإيمان","dorar":"otiVIYsL"},{"id":"س-05227","fp":"6272fad63e0f","stateId":214,"easy":"إذا تركت الصلاة ← فلا دين لك","cause":"مَن ترَكَ الصَّلاةَ","result":"فَلا دينَ لَهُ","explicit":true,"repOf":"س-06440","ref":"الترغيب والترهيب 1/264","text":["عنِ ابنِ مَسعودٍ رضيَ اللَّهُ عنهُ ، قالَ ",["مَن ترَكَ الصَّلاةَ ",1],["فَلا دينَ لَهُ",2]],"grade":"صحيح","narrator":"[زر بن حبيش]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي شبية في ((مصنفه)) (30397)، وعبد الله بن أحمد في ((السنة)) (772), ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (2/ 898) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RJchoBiv"},{"id":"س-05228","fp":"44cab388dc09","stateId":214,"easy":"إذا لم تصلِّ ← فأنت كافر","cause":"من لم يُصلِّ","result":"فَهوَ كافرٌ","explicit":true,"ref":"الترغيب والترهيب 1/264","srcLabel":"الترغيب والترهيب","text":["عَن جابرٍ رضيَ اللَّهُ عنهُما قالَ ",["من لم يُصلِّ ",1],["فَهوَ كافرٌ",2]],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"XLImfMVK"},{"id":"س-06438","fp":"58ba6a0178e6","stateId":214,"easy":"إذا تركت الصلاة ← فقد كفرت","cause":"فمنْ تركهمَا","result":"فقدْ كفرَ","explicit":true,"repOf":"س-05271","ref":"الجامع الصغير 5722","text":["العهدُ الذي بيننَا و بينهمُ الصلاةُ،  ",["فمنْ تركهمَا ",1],["فقدْ كفرَ",2]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2621)، وابن ماجة (1079)، وأحمد (22937) واللفظ لهم.","bab":"صلاة › تارك الصلاة","dorar":"VlHjW7rH"},{"id":"س-06461","fp":"695d946b8711","stateId":214,"easy":"إذا ترك الناس الصلاة ← لكانوا كفاراً","cause":"لو تركوها","result":"لكانوا كفارًا","explicit":true,"ref":"الصلاة وحكم تاركها 28","srcLabel":"الصلاة وحكم تاركها","text":["عن سعدِ ابنِ أبي وقاصٍ في هذه الآيةِ : { الَّذِينَ هُمْ عَن صَلاَتِهِمْ سَاهُونَ  } أنه قال : ",["لو تركوها",1]," ",["لكانوا كفارًا",2]," ، ولكن ضيعوا وقتَها"],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فرض الصلاة","dorar":"0R3FcoGB"},{"id":"س-06490","fp":"809d6d8f7b7c","stateId":214,"easy":"إذا أضعت الصلاة ← فلا حظ لك في الإسلام","cause":"أضاع الصلاةَ","result":"إنَّهُ لا حظَّ لأحدٍ في الإسلامِ","explicit":true,"repOf":"س-06440","ref":"الإيمان لابن أبي شيبة 103","text":["عن المسورِ بنِ المخرمةِ و ابنِ عباسٍ : أنهما دخلا على عمرَ رضيَ اللهُ عنهُ حين طُعِنَ فقال : الصلاةَ ، فقال : ",["إنَّهُ لا حظَّ لأحدٍ في الإسلامِ",2]," ",["أضاع الصلاةَ",1]," \" ، فصلى وجُرْحُه يشعبُ دمًا ، رضيَ اللهُ عنهُ"],"grade":"صحيح","narrator":"المسور بن مخرمة، وابن عباس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه عبد الرزاق (579)، وابن أبي شيبة في ((المصنف)) (30361)، وابن سعد في ((الطبقات)) (3 / 350)، وابن نصر في ((تعظيم قدر الصلاة)) (925) واللفظ لهم.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"wQZWHNGN"},{"id":"س-04958","fp":"8a634df07d4d","stateId":215,"easy":"إذا أخّرت صلاتك حتى اصفرار الشمس ثم نقرتها ← فهي صلاة المنافق","cause":"يَجلسُ يرقبُ الشَّمسَ حتَّى إذا كانت بينَ قَرنيِ الشَّيطانِ قامَ فنقرَها أربعًا لا يذكرُ اللَّهَ فيها إلَّا قليلًا","result":"تِلكَ صلاةُ المُنافقِ","explicit":true,"star":true,"ref":"صحيح ابن خزيمة 1/ 430","srcLabel":"مسلم","text":["عَنِ العلاءِ بنِ عبدِ الرَّحمنِ بنِ يعقوبَ أنَّهُ دخلَ على أنسِ بنِ مالِكٍ في دارِهِ بالبصرةِ حتَّى انصرفَ منَ الظُّهرِ قالَ ودارُهُ بجنبِ المسجدِ فلمَّا دخلنا عليهِ قالَ صلَّيتُمُ العصرَ قُلنا لَهُ إنَّما انصَرفْنا السَّاعةَ منَ الظُّهرِ قالَ فصلُّوا العصرَ فقمنا فصلَّينا فلمَّا انصَرفنا قالَ سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["تِلكَ صلاةُ المُنافقِ",2]," ",["يَجلسُ يرقبُ الشَّمسَ حتَّى إذا كانت بينَ قَرنيِ الشَّيطانِ قامَ فنقرَها أربعًا لا يذكرُ اللَّهَ فيها إلَّا قليلًا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (622) بلفظ مقارب، وأبو داود (413)، والترمذي (160)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fZhWTRkP","merged":7,"otherRefs":["نخب الافكار 3/481 (صحيح)","تخريج المسند لشعيب 13589 (صحيح)","تخريج صحيح ابن حبان 263 (صحيح)","صحيح الجامع 2606 (صحيح)","صحيح ابن حبان 260 (صحيح)","صحيح ابن خزيمة 1/ 431 (صحيح)"]},{"id":"س-06502","fp":"c254b04d8097","stateId":215,"easy":"إذا تخلفت عن الجماعة ← فهي علامة النفاق","cause":"يَتَخَلَّفُ عَنِ الصَّلاةِ","result":"إلَّا مُنافِقٌ قد عُلِمَ نِفاقُه","explicit":true,"star":true,"similar":["س-01541"],"ref":"صحيح مسلم 654","srcLabel":"متفق عليه","text":["قال عبدُ اللهِ: لقد رَأيتُنا وما ",["يَتَخَلَّفُ عَنِ الصَّلاةِ",1]," ",["إلَّا مُنافِقٌ قد عُلِمَ نِفاقُه",2],"، أو مَريضٌ، إن كان المَريضُ لَيَمشي بينَ رَجُلَينِ حتَّى يَأتيَ الصَّلاةَ، وقال: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عَلَّمَنا سُنَنَ الهُدى، وإنَّ مِن سُنَنَ الهُدى الصَّلاةَ في المَسجِدِ الذي يُؤَذَّنُ فيه."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"YCMFdiby","merged":2,"otherRefs":["أعلام الموقعين 4/334 (صحيح)"]},{"id":"س-06580","fp":"d64bf4729eff","stateId":215,"easy":"إذا ثقلت عليك العشاء والفجر ← فهي أثقل الصلوات على المنافقين","cause":"صلاةِ العِشاءِ وصلاةِ الفَجرِ","result":"ما صلاةٌ أثقَلَ على المُنافقِينَ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 995","srcLabel":"مسلم","text":["قال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما صلاةٌ أثقَلَ على المُنافقِينَ",2]," من ",["صلاةِ العِشاءِ وصلاةِ الفَجرِ",1],"، ولو يعلَمونَ ما فيهما منَ الفَضْلِ لأَتَوْهما ولو حَبْوًا."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطبراني (10/122) (10082)، وأبو الشيخ في ((ذكر الأقران)) (60) باختلاف يسير","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"XUpstiHF","merged":2,"otherRefs":["تخريج المسند لشعيب 21274 (حسن)"]},{"id":"س-06549","fp":"16fe5e300b7f","stateId":215,"easy":"إذا لم تشهد الصبح والعشاء ← فهي علامة النفاق","cause":"صلاةَ الصُّبحِ والعشاءِ","result":"لا يَشهدُهُما منافقٌ","explicit":true,"similar":["س-06651"],"ref":"الصحيح المسند 1515","srcLabel":"أحمد","text":[["لا يَشهدُهُما منافقٌ",2]," يعني ",["صلاةَ الصُّبحِ والعشاءِ",1]," ."],"grade":"صحيح","narrator":"عمومة أبي عمير بن أنس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (20580)، وابن أبي شيبة (3354) واللفظ لهما.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"K1RqpAWZ","merged":2,"otherRefs":["فتح الباري لابن حجر 2/150 (صحيح)"]},{"id":"س-01543","fp":"dae8e8775b4a","stateId":215,"easy":"إذا سمعت النداء ثلاثاً فلم تجب ← تُكتب من المنافقين","cause":"من سمع النداءَ ثلاثًا فلم يُجِبْ","result":"كُتِبَ من المنافقينَ","explicit":true,"ref":"فتح الباري لابن رجب 4/18","srcLabel":"ابن حبان","text":[["من سمع النداءَ ثلاثًا فلم يُجِبْ ",1],["كُتِبَ من المنافقينَ",2]],"grade":"صحيح","narrator":"أبو زرارة الأنصاري","muhaddith":"إسناده صحيح؛ لكن أبو زرارة، قال أبو القاسم البغوي: لا أدري أله صحبة أم لا؟","takhrij":"أخرجه ابن حبان في ((الثقات)) (8/ 465)، وأبو يعلى كما في ((جامع المسانيد)) (12514) واللفظ لهما.","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"hhIdsCjz"},{"id":"س-02779","fp":"4052859c0ec6","stateId":215,"easy":"إذا خرجت من المسجد بعد النداء بلا حاجة ← فهي علامة نفاق","cause":"لا يخرُجُ من المسجِدِ أحدٌ بَعدَ النِّداءِ","result":"إلَّا مُنافقٌ ، إلَّا أحَدٌ أخرجَتْهُ حاجةٌ ، و هوَ يُريدُ الرُّجوعَ","explicit":true,"ref":"صحيح الترغيب 264","srcLabel":"أبو داود","text":[["لا يخرُجُ من المسجِدِ أحدٌ بَعدَ النِّداءِ",1]," ",["إلَّا مُنافقٌ ، إلَّا أحَدٌ أخرجَتْهُ حاجةٌ ، و هوَ يُريدُ الرُّجوعَ",2]],"grade":"صحيح","narrator":"سعيد بن المسيب","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود في ((المراسيل)) (25) واللفظ له، وعبدالرزاق (1946)، والبيهقي (5136) باختلاف يسير","bab":"إيمان › النفاق","dorar":"aX69mCpm"},{"id":"س-04071","fp":"453c7afbba78","stateId":215,"easy":"إذا تركت الجمعة ثلاثاً بلا عذر ← يُطبع على قلبك فتكون منافقاً","cause":"مَن ترَكَ الجُمعةَ ثلاثًا من غيرِ عُذرٍ - قالَ في خَبرِ ابنِ إدريسَ - طُبِعَ علَى قَلبِهِ ، وفي خبَرِ وَكيعٍ","result":"فَهوَ مُنافقٌ","explicit":true,"ref":"صحيح ابن خزيمة 1857","srcLabel":"أبو داود","text":[["مَن ترَكَ الجُمعةَ ثلاثًا من غيرِ عُذرٍ - قالَ في خَبرِ ابنِ إدريسَ - طُبِعَ علَى قَلبِهِ ، وفي خبَرِ وَكيعٍ ، ",1],["فَهوَ مُنافقٌ ",2],"."],"grade":"صحيح","narrator":"أبو الجعد الضمري","muhaddith":"إسناده حسن صحيح","takhrij":"أخرجه أبو داود (1052)، والترمذي (500)، والنسائي (1369)، وابن ماجه (1125)، وأحمد (15498) بنحوه، وابن خزيمة (1857) واللفظ له","bab":"جمعة › فرض الجمعة","dorar":"O7ctzAnq"},{"id":"س-04072","fp":"3ded0b0854d6","stateId":215,"easy":"إذا تركت ثلاث جمع متواليات ← فقد نبذت الإسلام وراء ظهرك","cause":"من ترَكَ الجمعةَ ثلاثَ جمعٍ متوالياتٍ","result":"فقد نَبذَ الإسلامَ وراءَ ظَهْرِهِ","explicit":true,"ref":"الترغيب والترهيب 1/352","srcLabel":"البيهقي","text":["عَنِ ابنِ عبَّاسٍ رضي اللَّه عنهما قالَ : ",["من ترَكَ الجمعةَ ثلاثَ جمعٍ متوالياتٍ ",1],["فقد نَبذَ الإسلامَ وراءَ ظَهْرِهِ",2]],"grade":"صحيح","narrator":"[سعيد بن أبي الحسن]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى في ((مسنده)) (2712) واللفظ له، والبيهقي في ((الشعب)) (3006)، وعبد الرزاق (5169)باختلاف يسير.","bab":"جمعة › فرض الجمعة","dorar":"N6endelS"},{"id":"س-04803","fp":"1cf68094da44","stateId":215,"easy":"إذا تركت ثلاث جمعات بلا عذر ← تُكتب من المنافقين","cause":"مَن تَركَ ثَلاثَ جُمُعَاتٍ مِن غيرِ عُذْرٍ","result":"كُتِبَ مِن المنافِقينَ","explicit":true,"ref":"صحيح الترغيب 729","srcLabel":"الطبراني","text":[["مَن تَركَ ثَلاثَ جُمُعَاتٍ مِن غيرِ عُذْرٍ ، ",1],["كُتِبَ مِن المنافِقينَ",2]],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (1/171) (424)، والدارقطني في ((الأفراد)) كما في ((أطراف الغرائب)) لابن طاهر المقدسي (566)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"bterUerO"},{"id":"س-05279","fp":"0087f847b732","stateId":215,"easy":"إذا سمعت النداء في المسجد ثم خرجت بلا حاجة ولم ترجع ← فأنت منافق","cause":"يَسمَعُ النِّداءَ في مَسجِدي هذا ثُمَّ يَخرُجُ مِنه إلَّا لحاجةٍ ثُمَّ لا يَرجِعُ إليه","result":"إلَّا مُنافِقٌ","explicit":true,"ref":"تنبيه الغافلين 331","srcLabel":"الطبراني","text":["\"لا ",["يَسمَعُ النِّداءَ في مَسجِدي هذا ثُمَّ يَخرُجُ مِنه إلَّا لحاجةٍ ثُمَّ لا يَرجِعُ إليه",1]," ",["إلَّا مُنافِقٌ",2],"\"."],"grade":"صحيح","narrator":"أبو هرَيرةَ","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (3842) بلفظه، وابو نعيم الأصبهاني في ((صفة النفاق)) (60) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"H0MaQeWK"},{"id":"س-06651","fp":"6d571c93cc1e","stateId":215,"easy":"إذا لم تستطع شهود العشاء والصبح ← فهي آية النفاق","cause":"شهودُ العِشاءِ والصُّبحِ لا يستطيعونَهما","result":"آيةٌ بَينَنا وبَينَ المنافِقين","explicit":true,"repOf":"س-06549","ref":"فيض القدير 26","text":[["آيةٌ بَينَنا وبَينَ المنافِقين",2]," ",["شهودُ العِشاءِ والصُّبحِ لا يستطيعونَهما",1],"."],"grade":"صحيح","narrator":"سعيد بن المسيب","muhaddith":"إسناده صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"3ODXQbE9"},{"id":"س-08449","fp":"358f83bb656a","stateId":215,"easy":"إذا أدركك الأذان في المسجد فخرجت لغير حاجة ← فأنت منافق","cause":"مَن أدرَكَهُ الأذانُ في المسجِدِ ، ثمَّ خرجَ، لم يخرُجْ لحاجةٍ، وَهوَ لا يريدُ الرَّجعَةَ","result":"فَهوَ مُنافقٌ","explicit":true,"ref":"صحيح ابن ماجه 606","srcLabel":"ابن ماجه","text":[["مَن أدرَكَهُ الأذانُ في المسجِدِ ، ثمَّ خرجَ، لم يخرُجْ لحاجةٍ، وَهوَ لا يريدُ الرَّجعَةَ، ",1],["فَهوَ مُنافقٌ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (734) واللفظ له، والديلمي في ((الفردوس)) (5815) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (5/324) بنحوه.","bab":"نفاق › علامة المنافق وصفاته","dorar":"UTGYjDSH"},{"id":"س-01541","fp":"0d5a49c10fb8","stateId":215,"easy":"إذا تخلفت عن صلاة الجماعة (الفجر والعشاء) ← فهي علامة نفاق","cause":"لا يتخلَّفُ عنها","result":"إلَّا منافقٌ","explicit":true,"repOf":"س-06502","ref":"مجمع الزوائد 2/46","text":["لو أنَّ رجلًا دعا النَّاسَ إلى عرقٍ أو مرماتينِ لأجابوهُ وَهم يُدعونَ إلى هذِه الصَّلاةِ في جماعةٍ فلا يأتونَها لقد هممتُ أن آمرَ رجلًا أن يصلِّيَ بالنَّاسِ في جماعةٍ ثمَّ أنصرفَ إلى قومٍ سمعوا النِّداءَ فلم يجيبوا فأُضرِمَها عليهم نارًا إنَّهُ ",["لا يتخلَّفُ عنها",1]," ",["إلَّا منافقٌ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2763)","bab":"أذان › من سمع النداء لزمته الإجابة","dorar":"mCkHPu9j"},{"id":"س-08451","fp":"b76ed25ebffb","stateId":216,"easy":"إذا كذبت وغدرت وأخلفت وفجرت في الخصومة ← فأنت منافق خالص","cause":"إذا حَدَّثَ كَذَبَ، وإذا عاهَدَ غَدَرَ، وإذا وعَدَ أخلَفَ، وإذا خاصَمَ فجَرَ","result":"أربَعٌ مَن كُنَّ فيه كان مُنافِقًا خالِصًا، ومَن كانَت فيه خَلَّةٌ منهنَّ كانَت فيه خَلَّةٌ مِن نِفاقٍ حتَّى يَدَعَها","explicit":true,"star":true,"ref":"صحيح مسلم 58","srcLabel":"متفق عليه","text":[["أربَعٌ مَن كُنَّ فيه كان مُنافِقًا خالِصًا، ومَن كانَت فيه خَلَّةٌ منهنَّ كانَت فيه خَلَّةٌ مِن نِفاقٍ حتَّى يَدَعَها",2],": ",["إذا حَدَّثَ كَذَبَ، وإذا عاهَدَ غَدَرَ، وإذا وعَدَ أخلَفَ، وإذا خاصَمَ فجَرَ",1],". غَيرَ أنَّ في حَديثِ سُفيانَ: وإن كانَت فيه خَصلةٌ منهنَّ كانَت فيه خَصلةٌ مِنَ النِّفاقِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2459)، ومسلم (58).","bab":"نفاق › علامة المنافق وصفاته","dorar":"92BFMo96","merged":8,"otherRefs":["المصابيح في الأحاديث المتواترة 608 (صحيح)","تفسير القرآن العظيم 8/254 (صحيح)","تخريج سير أعلام النبلاء 5/409 (صحيح)","إرشاد الساري 7/98 (صحيح)","صحيح الجامع 3043 (صحيح)","صحيح البخاري 2682 (صحيح)","المحلى 8/29 (صحيح)"]},{"id":"س-08453","fp":"eb1cc36ac55c","stateId":216,"easy":"إذا لم تتضلع من زمزم ← فهي آية ما بيننا وبين المنافقين","cause":"لا يَتَضَلَّعونَ مِن زَمْزَمَ","result":"آيةَ ما بَيْنَنا وبَيْنَ المُنافِقينَ","explicit":true,"star":true,"otherNeedIds":[17],"ref":"الأحاديث المختارة 13 / 61","srcLabel":"متفق عليه","text":["«كُنْتُ عِنْدَ ابنِ عبَّاسٍ جالِسًا، فجاءَه رَجُلٌ، فقالَ: مِن أينَ جِئْتَ؟ قالَ: مِن زَمْزَمَ، قالَ: فشَرِبْتَ مِنها كما يَنْبَغي؟ قالَ: وكيف؟ قالَ: إذا شَرِبْتَ مِنها فاسْتَقْبِلِ الكَعْبةَ، واذْكُرِ اسمَ اللهِ، وتَنَفَّسْ ثَلاثًا، وتَضَلَّعْ مِنها، فإذا فَرَغْتَ فاحْمَدِ اللهَ عَزَّ وجَلَّ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ: إنَّ ",["آيةَ ما بَيْنَنا وبَيْنَ المُنافِقينَ",2]," ",["لا يَتَضَلَّعونَ مِن زَمْزَمَ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"نفاق › علامة المنافق وصفاته","dorar":"RCujbO58","merged":3,"otherRefs":["المقاصد الحسنة 422 (حسن)","عمدة القاري 9/398 (حسن)"]},{"id":"س-08452","fp":"6aeeb1b5e9da","stateId":216,"easy":"إذا كانت فيك خصلة منها ← ففيك خصلة من النفاق","cause":"وإن كانَت فيه خَصلةٌ منهنَّ كانَت فيه خَصلةٌ","result":"مِنَ النِّفاقِ","explicit":true,"star":true,"ref":"صحيح مسلم 58","srcLabel":"متفق عليه","text":["أربَعٌ مَن كُنَّ فيه كان مُنافِقًا خالِصًا، ومَن كانَت فيه خَلَّةٌ منهنَّ كانَت فيه خَلَّةٌ مِن نِفاقٍ حتَّى يَدَعَها: إذا حَدَّثَ كَذَبَ، وإذا عاهَدَ غَدَرَ، وإذا وعَدَ أخلَفَ، وإذا خاصَمَ فجَرَ. غَيرَ أنَّ في حَديثِ سُفيانَ: ",["وإن كانَت فيه خَصلةٌ منهنَّ كانَت فيه خَصلةٌ ",1],["مِنَ النِّفاقِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2459)، ومسلم (58).","bab":"نفاق › علامة المنافق وصفاته","dorar":"92BFMo96"},{"id":"س-04437","fp":"0bc3abc0d145","stateId":216,"easy":"إذا مت ولم تغزُ ولم تحدّث نفسك بالغزو ← مت على شعبة من نفاق","cause":"مَنْ ماتَ ولم يغْزُ ، ولم يُحَدِّثْ نفْسَهُ بغزْوٍ","result":"مات على شُعْبَةٍ منَ نفاقٍ","explicit":true,"star":true,"ref":"صحيح الجامع 6548","srcLabel":"مسلم","text":[["مَنْ ماتَ ولم يغْزُ ، ولم يُحَدِّثْ نفْسَهُ بغزْوٍ ",1],["مات على شُعْبَةٍ منَ نفاقٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2502)، والنسائي (3097) واللفظ لهما، وأخرجه مسلم (1910) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"aWcmXKO5","merged":2,"otherRefs":["علل الدارقطني 1885 (حسن)"]},{"id":"ق-0516","fp":"d56c1627cf62","stateId":216,"easy":"إخلاف عهد الله بالبخل بعد الغنى والكذب ← نفاق في القلب إلى يوم لقاء الله","cause":"إخلاف عهد الله بالبخل بعد الغنى والكذب","result":"نفاق في القلب إلى يوم لقاء الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[21],"ref":"سورة التوبة: 75–77","srcLabel":"القرآن الكريم","quran":{"s":9,"from":75,"to":77,"text":"وَمِنْهُمْ مَنْ عَاهَدَ اللَّهَ لَئِنْ آتَانَا مِنْ فَضْلِهِ لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ الصَّالِحِينَ (75) فَلَمَّا آتَاهُمْ مِنْ فَضْلِهِ بَخِلُوا بِهِ وَتَوَلَّوْا وَهُمْ مُعْرِضُونَ (76) فَأَعْقَبَهُمْ نِفَاقًا فِي قُلُوبِهِمْ إِلَى يَوْمِ يَلْقَوْنَهُ بِمَا أَخْلَفُوا اللَّهَ مَا وَعَدُوهُ وَبِمَا كَانُوا يَكْذِبُونَ (77)","hl":[[0,331,1]]}},{"id":"س-04322","fp":"749ea569ac5a","stateId":216,"easy":"إذا طلبت المرأة الخلع بلا سبب ← فهن المنافقات","cause":"المُخْتَلِعَاتِ والمنتزعاتِ","result":"هُنَّ المُنافِقَاتُ","explicit":true,"ref":"صحيح الترغيب 2018","srcLabel":"أبو داود","text":["وَإِنَّ ",["المُخْتَلِعَاتِ والمنتزعاتِ",1]," ",["هُنَّ المُنافِقَاتُ",2]," ، وما مِنِ امرأةٍ تَسْأَلُ زَوْجَها الطَّلاقَ من غَيْرِ بَأْسٍ ؛ فَتَجِدُ رِيحَ الجنةِ ، أوْ قال : رَائِحَةَ الجنةِ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2226)، والترمذي (1187)، وابن ماجه (2055)، وأحمد (22379) بنحوه مختصرا.","bab":"جنة › صفة الجنة","dorar":"8MjdGiMv","merged":5,"otherRefs":["صحيح النسائي 3461 (صحيح)","السلسلة الصحيحة 632 (صحيح)","صحيح الجامع 6681 (صحيح)","السلسلة الصحيحة 2/212 (صحيح)"]},{"id":"س-05437","fp":"e0309d3d2d84","stateId":216,"easy":"إذا كنت بذيئاً جافياً ← فهما شعبتان من النفاق","cause":"والبَذاءُ والجَفاءُ","result":"شُعْبَتانِ مِنَ النِّفاقِ","explicit":true,"ref":"المستدرك على الصحيحين 171","srcLabel":"الترمذي","text":["«العِيُّ والحَياءُ شُعْبَتانِ مِنَ الإيمانِ، ",["والبَذاءُ والجَفاءُ",1]," ",["شُعْبَتانِ مِنَ النِّفاقِ",2],"»."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح على شرط الشيخين وله شاهد صحيح على شرطهما","takhrij":"أخرجه الترمذي (2027)، وأحمد (22312)، والطحاوي في ((شرح مشكل الآثار)) (2983) واللفظ لهم.","bab":"رقائق وزهد › الحياء","dorar":"2G1tBHMo","merged":4,"otherRefs":["الأحكام الوسطى 3/ 173 (صحيح)","صحيح الجامع 3201 (صحيح)","صحيح الترغيب 2629 (صحيح)"]},{"id":"س-02799","fp":"9a45f61be1d3","stateId":216,"easy":"إذا كانت فيك خصلة من النفاق ← تبقى فيك حتى تدعها","cause":"ومَن كانتْ فيه خَصلةٌ منهنَّ","result":"لم يزل -يعني- فيه خَصلةٌ مِن النِّفاقِ حتى يدَعَها","explicit":true,"ref":"إرشاد الساري 7/98","srcLabel":"إرشاد الساري","text":["حديثُ: (ثلاثٌ مَن كُنَّ فيه كان مُنافقًا خالصًا) [يعني حديث: ثلاثٌ إذا كُنَّ في الرَّجُلِ فهو المُنافقُ الخالصُ: إنْ حدَّثَ كذَبَ، وإنْ وعَدَ أخلَفَ، وإنْ اؤتُمِنَ خان، ",["ومَن كانتْ فيه خَصلةٌ منهنَّ؛ ",1],["لم يزل -يعني- فيه خَصلةٌ مِن النِّفاقِ حتى يدَعَها",2],".]"],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"صحيح","bab":"إيمان › النفاق","dorar":"HOjNAvBp","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 5/409 (صحيح)"]},{"id":"س-00401","fp":"a4b0fb7452cf","stateId":216,"easy":"إذا خنت وكذبت ← فليست من خلال المؤمن","cause":"الخيانةَ والكَذِبَ","result":"كُلُّ خَلَّةٍ يُطبَعُ عليها المؤمِنُ إلَّا","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 611","srcLabel":"المصابيح في الأحاديث المتواترة","text":[["كُلُّ خَلَّةٍ يُطبَعُ عليها المؤمِنُ إلَّا",2]," ",["الخيانةَ والكَذِبَ",1]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › الأخلاق المذمومة","dorar":"5e5J8IoF"},{"id":"س-02780","fp":"c00821034bbb","stateId":216,"easy":"إذا اجتمعت فيك خصال النفاق ← كمل فيك النفاق، وإن كانت خصلة ففيك خصلة منه","cause":"من كانت فيهِ خصلةٌ من هذِهِ الخصالِ كانت فيهِ خصلةٌ من خصالِ المنافقينَ ، ومنِ اجتمعت فيهِ","result":"فقد كمُلَ فيهِ النِّفاقُ","explicit":true,"ref":"الفتح الرباني 3/1160","srcLabel":"أحمد","text":[["من كانت فيهِ خصلةٌ من هذِهِ الخصالِ كانت فيهِ خصلةٌ من خصالِ المنافقينَ ، ومنِ اجتمعت فيهِ ",1],["فقد كمُلَ فيهِ النِّفاقُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › النفاق","dorar":"LGIhueAM"},{"id":"س-02782","fp":"281f2c493652","stateId":216,"easy":"إذا تركت لغة القرآن وأكثرت من الأعجمية بلا حاجة ← يورث ذلك النفاق","cause":"يتكلمَنَّ بالفارسيةِ","result":"فإنَّه يورِّثُ النفاقَ","explicit":true,"ref":"الجامع الصغير 8321","srcLabel":"الحاكم","text":["منْ أحسنَ منكمْ أنْ يتكلمَ بالعربيةِ،  فلَا ",["يتكلمَنَّ بالفارسيةِ",1],"،  ",["فإنَّه يورِّثُ النفاقَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7001)","bab":"إيمان › النفاق","dorar":"6PJ9HyX3"},{"id":"س-03211","fp":"59ef0d02e3ea","stateId":216,"easy":"إذا تتبعت غفلات الناس وعوراتهم في رمضان ← فهو فعل المنافقين","cause":"وما يُعِدُّ فيه المُنافِقون مِن غَفَلاتِ النَّاسِ وعَوَراتِهِم","result":"ولا أَتى على المُنافِقينَ شَهرٌ شَرٌّ مِن رمضانَ","explicit":true,"ref":"تخريج المسند لشاكر 16/158","srcLabel":"أحمد","text":["ما أَتى على المُسلِمينَ شَهرٌ خَيرٌ لهُم مِن رَمضانَ، ",["ولا أَتى على المُنافِقينَ شَهرٌ شَرٌّ مِن رمضانَ",2],"؛ وذلكَ لِمَا يُعِدُّ المُؤمِنون فيه مِنَ القوَّةِ للعِبادةِ، ",["وما يُعِدُّ فيه المُنافِقون مِن غَفَلاتِ النَّاسِ وعَوَراتِهِم",1],"، هو غُنْمُ [المُؤمِنِ] يَغتَنِمُه الفاجِرُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8870)، وابن أبي شيبة (8968)، وابن خزيمة (1884) باختلاف يسير","bab":"إيمان › فضل الإيمان","dorar":"H2i8R9ez"},{"id":"س-03886","fp":"ed536329f888","stateId":216,"easy":"إذا كذبت إذا حدّثت وأخلفت إذا وعدت وغدرت إذا عاهدت ← فهي علامات المنافق","cause":"إذا حدَّث كذَب وإذا وعَد أخلَف وإذا عاهَد غدَر","result":"اعتَبِروا المنافقينَ بثلاثٍ","explicit":true,"ref":"مجمع الزوائد 1/113","srcLabel":"الطبراني","text":["عن ابنِ مسعودٍ قال : ",["اعتَبِروا المنافقينَ بثلاثٍ",2]," ",["إذا حدَّث كذَب وإذا وعَد أخلَف وإذا عاهَد غدَر",1]," ، فأنزَل اللهُ عزَّ وجلَّ تصديقَ ذلك في كتابِه {وَمِنْهُمْ مَنْ عَاهَدَ اللَّهَ لَئِنْ آتَانَا مِنْ فَضْلِهِ} إلى آخرِ الآيةِ"],"grade":"صحيح","narrator":"[عبدالرحمن بن يزيد]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (9/ 222) (9075)، وسعيد بن منصور في ((سننه)) (1206) واللفظ لهم.ا، وابن أبي شيبة في ((مصنفه)) (25611)باختلاف يسير  .","bab":"تفسير آيات › سورة التوبة","dorar":"pzWT54rU"},{"id":"س-04863","fp":"448f7421e234","stateId":216,"easy":"إذا قلت «أنا مؤمن» تزكية لنفسك ← فهو مذموم","cause":"من قالَ أنا مؤمنٌ","result":"فهوَ كافرٌ","explicit":true,"ref":"الغماز على اللماز 282","srcLabel":"الغماز على اللماز","text":[["من قالَ أنا مؤمنٌ",1]," ",["فهوَ كافرٌ",2]," ومن قالَ أنا عالمٌ فهوَ جاهلٌ"],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FvE0OgvB"},{"id":"س-05426","fp":"bec730d98fc7","stateId":216,"easy":"إذا كنت شحيحاً عاجزاً بذيئاً ← فهي من النفاق تنقص من آخرتك","cause":"وإِنَّ الشُّحَّ والعَجْزَ والبَذَاءَ","result":"مِنَ النِّفَاقِ ، وإنَّهُنَّ يَزِدْنَ في الدنيا ، ويَنْقُصْنَ مِنَ الآخرةِ ، وما يَنْقُصْنَ مِنَ الآخرةِ أكثرُ مِمَّا يَزِدْنَ في الدنيا","explicit":true,"ref":"صحيح الترغيب 2630","srcLabel":"الطبراني","text":["بَلْ هو الدِّينُ كلُّهُ . ثُمَّ قال رسولُ اللهِ : إِنَّ الحَياءَ والعَفَافُ والعِيَّ – عِيُّ اللِّسانِ ، لا عِيُّ القلبِ ، والفقهُ مِنَ الإيمانِ ، وإنَّهُنَّ يَزِدْنَ في الآخرةِ ، ويُنْقِصْنَ مِنَ الدنيا ، وما يَزِدْنَ في الآخرةِ أكثرُ مِمَّا يُنْقِصْنَ مِنَ الدنيا . ",["وإِنَّ الشُّحَّ والعَجْزَ والبَذَاءَ ",1],["مِنَ النِّفَاقِ ، وإنَّهُنَّ يَزِدْنَ في الدنيا ، ويَنْقُصْنَ مِنَ الآخرةِ ، وما يَنْقُصْنَ مِنَ الآخرةِ أكثرُ مِمَّا يَزِدْنَ في الدنيا",2]," ."],"grade":"صحيح","narrator":"قرة بن إياس المزني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (63) (19/ 29)، وابن أبي الدنيا في ((مكارم الأخلاق)) (87)، والفسوي في ((المعرفة والتاريخ)) (1/ 311)، وأبو نعيم في ((حلية الأولياء)) (3/ 125)، والبيهقي (20845)،  جميعا بنحوه","bab":"رقائق وزهد › الحياء","dorar":"KaSiy8WL"},{"id":"س-02793","fp":"72f5f3e281e5","stateId":216,"easy":"إذا قلت للأمراء قولاً وخلافه إذا خرجت ← كان يُعدّ نفاقاً","cause":"نَدخُلُ على أُمَرائِنا فنقولُ القَولَ، فإذا خَرَجْنا قُلْنا غيرَه","result":"كُنَّا نَعُدُّ هذا على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ النِّفاقَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 5829","srcLabel":"ابن ماجه","text":["قِيلَ لابنِ عُمَرَ إنَّا ",["نَدخُلُ على أُمَرائِنا فنقولُ القَولَ، فإذا خَرَجْنا قُلْنا غيرَه",1],"، فقال: ",["كُنَّا نَعُدُّ هذا على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ النِّفاقَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (3975)، وأحمد (5829)","bab":"إيمان › النفاق","dorar":"bewPUweu","merged":3,"otherRefs":["سير أعلام النبلاء 11/435 (حسن)","صحيح البخاري 7178 (صحيح)"]},{"id":"س-05285","fp":"8eadda6035e8","stateId":216,"easy":"إذا كذبت ← فالكذب يجانب الإيمان","cause":"إيَّاكُم والكَذِبَ","result":"فإنَّ الكَذِبَ مُجانِبٌ للإيمانِ","explicit":true,"ref":"فيض القدير 3/ 133","srcLabel":"أحمد","text":["قامَ فينا خَطيبًا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مَقامي هذا عامَ أوَّلَ، ثُمَّ بَكى وقال: ",["إيَّاكُم والكَذِبَ؛ ",1],["فإنَّ الكَذِبَ مُجانِبٌ للإيمانِ",2]],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (16)، والضياء في ((المختارة)) (58)، والديلمي تعليقا كما في ((زهر الفردوس)) (1004).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"dFzeeBhH"},{"id":"س-05432","fp":"d1586613a850","stateId":216,"easy":"إذا لم يكن لك حياء ← فلا دين لك","cause":"من لا حياءَ له","result":"لا دينَ له","explicit":true,"ref":"التمهيد 21/142","srcLabel":"ابن عبد","text":["لكلِّ دينٍ خُلقٌ وخلقُ الإسلامِ الحياءُ ، ",["من لا حياءَ له",1]," ",["لا دينَ له",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عبد البر في ((الاستذكار)) (8/ 281) واللفظ له.","bab":"رقائق وزهد › الحياء","dorar":"PJ50EQaU"},{"id":"س-00573","fp":"b9d13af1696f","stateId":216,"easy":"إذا أُعطيت القرآن ولم تُعطَ الإيمان ← فأنت كالريحانة طيبة الريح مرة الطعم (حال المنافق)","cause":"مَن أُعطي القرآنَ ولم يُعطَ الإيمانَ","result":"كمَثَلِ الرَّيحانةِ مُرَّةِ الطَّعمِ طيِّبةِ الرِّيحِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج صحيح ابن حبان 121","srcLabel":"متفق عليه","text":["مَثَلُ مَن أُعطي القرآنَ والإيمانَ كمثَلِ أُترُجَّةٍ طيِّبِ الطَّعمِ طيِّبِ الرِّيحِ ومَثَلُ مَن لم يُعطَ القرآنَ ولم يُعطَ الإيمانَ كمَثَلِ الحنظلةِ مُرَّةِ الطَّعمِ لا ريحَ لها ومَثلُ مَن أُعطي الإيمانَ ولم يُعطَ القرآنَ كمَثَلِ التَّمرةِ طيِّبةِ الطَّعمِ ولا ريحَ لها ومَثَلُ ",["مَن أُعطي القرآنَ ولم يُعطَ الإيمانَ",1]," ",["كمَثَلِ الرَّيحانةِ مُرَّةِ الطَّعمِ طيِّبةِ الرِّيحِ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5020)، ومسلم (797)، والترمذي (2865)، والنسائي (5038)، وابن حبان (403) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"EfJmTtpI"},{"id":"س-02790","fp":"0440c0742160","stateId":216,"easy":"إذا أكثرت من الغناء ← ينبت النفاق في قلبك (أثر ابن مسعود)","cause":"الغناءُ","result":"ينبتُ النفاقَ في القلبِ كما ينبتُ الماءُ البقلَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"مسألة السماع 160","srcLabel":"مسألة السماع","text":["عن عبدِ اللهِ بنِ مسعودٍ رضي الله عنه ( ",["الغناءُ",1]," ",["ينبتُ النفاقَ في القلبِ كما ينبتُ الماءُ البقلَ",2]," )"],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › النفاق","dorar":"8hZQgGvg"},{"id":"س-03937","fp":"4f6f1d25b2b3","stateId":216,"easy":"إذا نافقت ← تغرق كما غرق من جاءه السيل (مثَل)","cause":"والَّذي غرِقَ المُنافقُ","result":"فجاءَهُ سيلٌ فأغرقَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[57],"ref":"عمدة التفسير 1/591","srcLabel":"عمدة التفسير","text":["عن عبدِ اللَّهِ - هوَ ابنُ مسعودٍ - قالَ : مَثلُ المؤمنِ والمُنافقِ والكافرِ مثلُ ثلاثةِ نفرٍ انتَهَوا إلى وادٍ ، فدفعَ أحدُهُم فعبرَ ، ثمَّ وقعَ الآخرُ حتَّى إذا أتى علَى نصفِ الوادي ناداهُ الَّذي علَى شفيرِ الوادي : ويلَكَ . أينَ تذهبُ ؟ إلى الهلَكَةِ ؟ ارجِع عَودُكَ على بدئِكَ ، وَناداهُ الَّذي عبرَ : هلمَّ إلى النَّجاةِ . فجعلَ ينظرُ إلى هذا مرَّةً وإلى هذا مرَّةً ، قالَ : ",["فجاءَهُ سيلٌ فأغرقَهُ",2]," ، فالَّذي عبرَ المؤمنُ ، ",["والَّذي غرِقَ المُنافقُ",1]," : مُذَبْذَبِينَ بَيْنَ ذَلِكَ لَا إِلَى هَؤُلَاءِ وَلَا إِلَى هَؤُلَاءِ والَّذي مَكَثَ : الكافرُ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"تفسير آيات › سورة النساء","dorar":"LNoms18h"},{"id":"س-05732","fp":"2db41a3bd5b8","stateId":216,"easy":"إذا كانت تحيتك لعنة وطعامك نهبة ← فتلك من علامات المنافقين","cause":"تحيتهم لعنةٌ","result":"إِنَّ للمنافقينَ علاماتٍ يُعرفونَ بِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشاكر 15/51","srcLabel":"البيهقي","text":[["إِنَّ للمنافقينَ علاماتٍ  يُعرفونَ بِها",2],": ",["تحيتهم لعنةٌ",1],"، وطعامُهم نهبةٌ، وغنيمَتُهم غلولٌ، ولا يقربون المساجدَ إِلا هَجْرًا، ولا يأتُون الصلاةَ إِلا دَبْرًا، مستكبِرينَ، لا يَأْلَفون ولا يُؤْلفون، خشب بالليلِ، صُخُبٌ بالنهارِ  وقال يزِيدُ، مرةً سُخُبٌ بالنهارِ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (8444)، وابن بطة في ((الإبانة الكبرى)) (927)، والبيهقي في ((شعب الإيمان)) (2702) باختلاف يسير","bab":"رقائق وزهد › الكبر والتواضع","dorar":"k0SUNVzn"},{"id":"س-02606","fp":"38da0bf88e1f","stateId":217,"easy":"إذا أخذت الرشوة في الحكم ← فهو كفر","cause":"الرِّشوةُ في الحُكمِ","result":"كُفرٌ","explicit":true,"ref":"تنبيه الغافلين 163","srcLabel":"تنبيه الغافلين","text":["عن ابنِ عبَّاسٍ رَضِيَ اللهُ عنهما، قال: ",["الرِّشوةُ في الحُكمِ",1]," ",["كُفرٌ",2],"، وهيَ بَينَ النَّاسِ سُحتٌ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال تنافي الإيمان","dorar":"mXsDLgXw","merged":2,"otherRefs":["الجامع الصغير 288 (حسن)"]},{"id":"س-04829","fp":"62b6f79138ea","stateId":217,"easy":"إذا طعنت في النسب أو نحت على الميت ← فهما من الكفر","cause":"الطَّعنُ في النَّسَبِ، والنِّياحةُ على المَيِّتِ","result":"هُما بهِم كُفرٌ","explicit":true,"star":true,"ref":"صحيح مسلم 67","srcLabel":"متفق عليه","text":["اثنَتانِ في النَّاسِ ",["هُما بهِم كُفرٌ",2],": ",["الطَّعنُ في النَّسَبِ، والنِّياحةُ على المَيِّتِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"yQ96XDj5","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 2/586 (حسن)"]},{"id":"س-00382","fp":"dd504fd21822","stateId":217,"easy":"إذا قاتلت أخاك المسلم ← فهو كفر","cause":"قِتالُ المُسلمِ أخاه","result":"كُفرٌ","explicit":true,"star":true,"similar":["س-02378"],"ref":"تخريج المسند لشعيب 4394","srcLabel":"متفق عليه","text":[["قِتالُ المُسلمِ أخاه",1]," ",["كُفرٌ",2],"، وسِبابُه فُسوقٌ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البخاري (48)، ومسلم (64) باختلاف يسير","bab":"آداب عامة › الأخلاق المذمومة","dorar":"ysYOxlvz"},{"id":"س-02604","fp":"990a76790c0c","stateId":217,"easy":"إذا شققت عصا المسلمين وهم مجتمعون ← خلعت ربقة الإسلام من عنقك","cause":"مَن شَقَّ عَصا المُسلِمينَ، والمُسلِمونُ في إسْلامٍ دامِجٍ","result":"فقدْ خَلَعَ رِبْقةَ الإسْلامِ مِن عُنُقِه","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 51","srcLabel":"متفق عليه","text":["«",["مَن شَقَّ عَصا المُسلِمينَ، والمُسلِمونُ في إسْلامٍ دامِجٍ، ",1],["فقدْ خَلَعَ رِبْقةَ الإسْلامِ مِن عُنُقِه»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › أعمال تنافي الإيمان","dorar":"1ynWHBkz"},{"id":"س-04280","fp":"7dbd83be32c2","stateId":217,"easy":"إذا انتسبت لغير أبيك وأنت تعلم ← فقد كفرت","cause":"من ادَّعى لغيرِ أبيه وهو يعلمُ","result":"فقد كفر","explicit":true,"star":true,"ref":"صحيح الأدب المفرد 336","srcLabel":"متفق عليه","text":[["من ادَّعى لغيرِ أبيه وهو يعلمُ ",1],["فقد كفر ، ",2],"ومن ادَّعى قومًا ليس هو منهم فلْيتبوَّأْ مقعدَه من النارِ ، ومن دعا رجلًا بالكفرِ ، أو قال : عدوُّ اللهِ ، وليس كذلك إلا حارَتْ عليه"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (433) واللفظ له، وأصله في صحيح البخاري (3508)، ومسلم (61) باختلاف يسير","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"wYGcBCap"},{"id":"س-05027","fp":"655125452ad5","stateId":217,"easy":"إذا رغبت عن أبيك (تبرأت منه) ← فهو كفر","cause":"فمَن رَغِبَ عن أَبِيهِ","result":"فهو كُفْرٌ","explicit":true,"similar":["س-05071"],"ref":"صحيح الجامع 7279","srcLabel":"متفق عليه","text":["لا تَرْغَبُوا عن آبائِكم ، ",["فمَن رَغِبَ عن أَبِيهِ ",1],["فهو كُفْرٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6768)، ومسلم (62)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TCa54von"},{"id":"س-05071","fp":"d787bf5d11e2","stateId":217,"easy":"إذا رغبت عن أبيك ← فقد كفرت","cause":"مَن رغِب عن أبيه","result":"فقد كفَر","explicit":true,"repOf":"س-05027","ref":"تخريج صحيح ابن حبان 1466","text":["لا ترغَبوا عن آبائِكم فإنَّه ",["مَن رغِب عن أبيه ",1],["فقد كفَر",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه البخاري (6768)، ومسلم (62) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"h5HplLaH"},{"id":"س-01181","fp":"6ad0b56a34ae","stateId":217,"easy":"إذا خرجت من الجماعة قيد شبر ← خلعت ربقة الإسلام من عنقك حتى ترجع","cause":"مَن خَرَجَ مِنَ الجَماعةِ قِيدَ شِبرٍ","result":"فقد خَلَعَ رِبقَ الإسلامِ مِن عُنُقِه إلى أن يَرجِعَ","explicit":true,"ref":"تخريج المسند لشعيب 17800","srcLabel":"أحمد","text":["إنَّ اللهَ أمَرَ يَحيى بنَ زَكَريَّا بخَمسِ كَلِماتٍ أن يَعمَلَ بهنَّ، وأن يَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فكادَ أن يُبطِئَ، فقال له عيسى: إنَّكَ قد أُمِرتَ بخَمسِ كَلِماتٍ أن تَعمَلَ بهنَّ، وأن تَأمُرَ بَني إسرائيلَ أن يَعمَلوا بهنَّ، فإمَّا أن تُبَلِّغَهنَّ وإمَّا أُبَلِّغهنَّ، فقال له: يا أخي، إنِّي أخشى إن سَبَقتَني أن أُعَذَّبَ، أو يُخسَفَ بي، قال: فجَمَعَ يَحيى بَني إسرائيلَ في بَيتِ المَقدِسِ، حَتَّى امتَلَأ المَسجِدُ، وقُعِدَ على الشُّرَفِ، فحَمِدَ اللهَ، وأثنى عليه، ثُمَّ قال: إنَّ اللهَ أمَرَني بخَمسِ كَلِماتٍ أن أعمَلَ بهنَّ وآمُرَكُم أن تَعمَلوا بهنَّ: أوَّلُهنَّ: أن تَعبُدوا اللهَ ولا تُشرِكوا به شَيئًا؛ فإنَّ مَثَلَ ذلك مَثَلُ رَجُلٍ اشتَرى عَبدًا مِن خالِصِ مالِه بوَرِقٍ أو ذَهَبٍ، فجَعَلَ يَعمَلُ ويُؤَدِّي عَمَلَه إلى غَيرِ سَيِّدِه، فأيُّكُم يَسُرُّه أن يَكونَ عَبدُه كَذلك؟ وإنَّ اللهَ خَلَقَكُم ورَزَقَكُم فاعبُدوهُ ولا تُشرِكوا به شَيئًا، وآمُرُكُم بالصَّلاةِ؛ فإنَّ اللهَ يَنصِبُ وجهَه لوَجهِ عَبدِه ما لم يَلتَفِتْ، فإذا صَلَّيتُم فلا تَلتَفِتوا، وآمُرُكُم بالصِّيامِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ مَعَه صُرَّةٌ مِن مِسكٍ في عِصابةٍ، كُلُّهم يَجِدُ ريحَ المِسكِ، وإنَّ خُلوفَ فمِ الصَّائِمِ أطيَبُ عِندَ اللهِ مِن ريحِ المِسكِ، وآمُرُكُم بالصَّدَقةِ؛ فإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ أسَرَه العَدوُّ، فشَدُّوا يَدَيه إلى عُنُقِه، وقَرَّبوهُ ليَضرِبوا عُنُقَه، فقال: هَل لَكُم أن أفتَديَ نَفسي مِنكُم، فجَعَلَ يَفتَدي نَفسَه مِنهم بالقَليلِ والكَثيرِ، حَتَّى فكَّ نَفسَه، وآمُرُكُم بذِكرِ اللهِ كَثيرًا، وإنَّ مَثَلَ ذلك كَمَثَلِ رَجُلٍ طَلَبَه العَدوُّ سِراعًا في أثَرِه، فأتى حِصنًا حَصينًا، فتَحَصَّنَ فيه، وإنَّ العَبدَ أحصَنُ ما يَكونُ مِنَ الشَّيطانِ إذا كان في ذِكرِ اللهِ. قال: وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «أنا آمُرُكُم بخَمسٍ اللهُ أمَرَني بهنَّ: بالجَماعةِ، والسَّمعِ، والطَّاعةِ، والهجرةِ، والجِهادِ في سَبيلِ اللهِ؛ فإنَّه ",["مَن خَرَجَ مِنَ الجَماعةِ قِيدَ شِبرٍ ",1],["فقد خَلَعَ رِبقَ الإسلامِ مِن عُنُقِه إلى أن يَرجِعَ، ",2],"ومَن دَعا بدَعوى الجاهِليَّةِ فهو مِن جُثا جَهَنَّمَ»، قالوا: يا رَسولَ اللهِ، وإن صامَ وصَلَّى؟ قال: «وإن صامَ وصَلَّى، وزَعَمَ أنَّه مُسلِمٌ، فادعوا المُسلِمينَ بما سَمَّاهُمُ المُسلِمينَ المُؤمِنينَ عِبادَ اللهِ»."],"grade":"صحيح","narrator":"الحارث الأشعري","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"sHxpfooO","merged":6,"otherRefs":["سنن الترمذي 2863 (صحيح)","المستدرك على الصحيحين 408 (صحيح)","المستدرك على الصحيحين 1554 (صحيح)","تخريج صحيح ابن حبان 6233 (صحيح)","تخريج المسند لشعيب 22910 (صحيح)"]},{"id":"س-08056","fp":"904c031601de","stateId":217,"easy":"إذا ضرب بعضكم رقاب بعض ← رجعتم كفاراً","cause":"يَضرِبُ بَعضُكُم رِقابَ بَعضٍ","result":"لا تَرجِعوا بَعدي كُفَّارًا","explicit":true,"ref":"تخريج المسند لشعيب 20695","srcLabel":"أحمد","text":["عن أبي حُرَّةَ الرَّقاشيِّ، عن عَمِّه، قال كُنتُ آخِذًا بزِمامِ ناقةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في أوسَطِ أيَّامِ التَّشريقِ، أذودُ عنه النَّاسَ، فقال: «يا أيُّها النَّاسُ، هَل تَدرونَ في أيِّ يَومٍ أنتُم؟ وفي أيِّ شَهرٍ أنتُم؟ وفي أيِّ بَلَدٍ أنتُم؟» قالوا: في يَومٍ حَرامٍ، وشَهرٍ حَرامٍ، وبَلَدٍ حَرامٍ، قال: «فإنَّ دِماءَكُم وأموالَكُم وأعراضَكُم عليكُم حَرامٌ، كَحُرمةِ يَومِكُم هذا، في شَهرِكُم هذا، في بَلَدِكُم هذا، إلى يَومِ تَلقَونَه»، ثُمَّ قال: \"اسمَعوا مِنِّي تَعيشوا، ألا لا تَظلِموا، ألا لا تَظلِموا، ألا لا تَظلِموا، إنَّه لا يَحِلُّ مالُ امرِئٍ إلَّا بطيبِ نَفسٍ مِنه، ألا وإنَّ كُلَّ دَمٍ ومالٍ ومَأثُرةٍ كانَت في الجاهِليَّةِ تَحتَ قدَمي هذه إلى يَومِ القيامةِ، وإنَّ أوَّلَ دَمٍ يوضَعُ دَمُ رَبيعةَ بنِ الحارِثِ بنِ عَبدِ المُطَّلِبِ، كان مُستَرضَعًا في بَني لَيثٍ فقَتَلَته هُذَيلٌ، ألا وإنَّ كُلَّ رِبًا كان في الجاهِليَّةِ مَوضوعٌ، وإنَّ اللهَ قَضى أنَّ أوَّلَ رِبًا يوضَعُ رِبا العَبَّاسِ بنِ عَبدِ المُطَّلِبِ، لَكُم رُؤوسُ أموالِكُم لا تَظلِمونَ ولا تُظلَمونَ، ألا وإنَّ الزَّمانَ قدِ استَدارَ كَهَيئَتِه يَومَ خَلَقَ اللهُ السَّمَواتِ والأرضَ، ثُمَّ قَرَأ: {إنَّ عِدَّةَ الشُّهورِ عِندَ اللهِ اثنَا عَشَرَ شَهرًا في كِتابِ اللهِ يَومَ خَلَقَ السَّمَواتِ والأرضَ مِنها أربَعةٌ حُرُمٌ ذلك الدِّينُ القَيِّمُ فلا تَظلِموا فيهنَّ أنفُسَكُم}، ألا ",["لا تَرجِعوا بَعدي كُفَّارًا",2]," ",["يَضرِبُ بَعضُكُم رِقابَ بَعضٍ",1],"، ألا إنَّ الشَّيطانَ قد أيِسَ أن يَعبُدَه المُصَلُّونَ، ولَكِنْ في التَّحريشِ بَينَكُم، فاتَّقوا اللهَ في النِّساءِ؛ فإنَّهنَّ عِندَكُم عَوانٍ، لا يَملِكنَ لأنفُسِهنَّ شَيئًا، وإنَّ لهنَّ عليكُم ولَكُم عليهنَّ حَقًّا: أن لا يوطِئنَ فُرُشَكُم أحَدًا غَيرَكُم، ولا يَأذَنَّ في بُيوتِكُم لأحَدٍ تَكرَهونَه، فإن خِفتُم نُشوزَهنَّ فعِظوهُنَّ واهجُروهُنَّ في المَضاجِعِ، واضرِبوهُنَّ ضَربًا غَيرَ مُبَرِّحٍ\"، قال حُمَيدٌ: قُلتُ للحَسَنِ: ما المُبَرِّحُ؟ قال: المُؤَثِّرُ، «ولَهنَّ رِزقُهنَّ وكِسوتُهنَّ بالمَعروفِ، وإنَّما أخَذتُموهُنَّ بأمانةِ اللهِ، واستَحلَلتُم فُروجَهنَّ بكَلِمةِ اللهِ، ألا ومَن كانَت عِندَه أمانةٌ فليُؤَدِّها إلى مَنِ ائتَمَنَه عليها»، وبَسَطَ يَدَيه، فقال: \"ألا هَل بَلَّغتُ؟ ألا هَل بَلَّغتُ؟ ألا هَل بَلَّغتُ؟ ثُمَّ قال: ليُبَلِّغِ الشَّاهِدُ الغائِبَ؛ فإنَّه رُبَّ مُبَلَّغٍ أسعَدُ مِن سامِعٍ \"، قال حُمَيدٌ: قال الحَسَنُ حينَ بَلَغَ هذه الكَلِمةَ: «قد واللهِ بَلَّغوا أقوامًا كانوا أسعَدَ به»"],"grade":"صحيح","narrator":"عم، أبي حرة الرقاشي","muhaddith":"صحيح لغيره مقطعا","bab":"مظالم › تحريم الظلم","dorar":"7sEuKHD1","merged":13,"otherRefs":["صحيح البخاري 6785 (صحيح)","مجمع الزوائد 6/287 (صحيح)","صحيح النسائي 4143 (صحيح)","صحيح البخاري 4405 (صحيح)","صحيح البخاري 6166 (صحيح)","صحيح البخاري 1739 (صحيح)","صحيح البخاري 7078 (صحيح)","صحيح البخاري 1741 (صحيح)","الأوسط لابن المنذر 13/350 (صحيح)","صحيح البخاري 4402 (صحيح)","صحيح مسلم 1679 (صحيح)","المستدرك على الصحيحين 322 (صحيح)"]},{"id":"س-02378","fp":"66da09d70ad5","stateId":217,"easy":"إذا قاتلت المسلم ← فهو كفر","cause":"وقتالُه","result":"كفرٌ","explicit":true,"repOf":"س-00382","ref":"مجمع الزوائد 8/76","text":["انتهى النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى مجلسٍ من مجالسِ الأنصارِ ورجلٌ منهم كان يُعرَفُ بالبَذاءِ فقال النَّبيُُّ صلَّى اللهُ عليه وسلَّم سِبابُ المسلمِ فُسوقٌ ",["وقتالُه",1]," ",["كفرٌ",2]],"grade":"صحيح","narrator":"عمرو بن النعمان بن مقرن","muhaddith":"رجاله رجال الصحيح غير أبي خالد الوالبي وهو ثقة","takhrij":"أخرجه ابن أبي الدنيا في ((الصمت)) (590) مختصراً، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (1100) بنحوه، والطبراني (17/39) (80) باختلاف يسير.","bab":"إسلام › حرمة المسلم","dorar":"ZK2qOUpR","merged":4,"otherRefs":["صحيح الأدب المفرد 334 (صحيح)","تخريج المسند لشاكر 6/4 (صحيح)","تخريج المسند لشعيب 4262 (صحيح)"]},{"id":"س-02564","fp":"cf002a7ce041","stateId":217,"easy":"إذا ادعيت نسباً ليس لك أو تبرأت من نسبك ← كفرت بالله","cause":"من ادَّعى نسبًا لا يُعْلَمُ وتَبَرَّأَ من نسبٍ وإن دقَّ","result":"كَفَرَ باللهِ","explicit":true,"ref":"السلسلة الصحيحة 7/1114","srcLabel":"ابن أبي شيبة","text":["قال أبو بكرٍ ",["كَفَرَ باللهِ",2]," ",["من ادَّعى نسبًا لا يُعْلَمُ وتَبَرَّأَ من نسبٍ وإن دقَّ",1]],"grade":"صحيح","narrator":"عبدالله بن سخبرة الأزدي أبو معمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (26633) واللفظ له، والدارمي (2903)، وعبد الرزاق (16315) باختلاف يسير.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"ctVR7ibF","merged":4,"otherRefs":["صحيح ابن ماجه 2233 (صحيح)","صحيح الجامع 4486 (حسن)","صحيح الترغيب 1987 (صحيح)"]},{"id":"س-02565","fp":"80a4dbec7bf6","stateId":217,"easy":"إذا قلت لأخيك «أنت عدوي» ← خرج أحدكما من الإسلام أو برئ من صاحبه","cause":"إذا قال الرجلُ لصاحبِه : أنت عدوي","result":"فقد خرج أحدُهما من الإسلامِ ، أو برئ من صاحبِه","explicit":true,"ref":"صحيح الأدب المفرد 324","srcLabel":"البخاري (الأدب المفرد)","text":["عن عبدِ اللهِ بنِ مسعودٍ قال ",["إذا قال الرجلُ لصاحبِه : أنت عدوي",1]," ، ",["فقد خرج أحدُهما من الإسلامِ ، أو برئ من صاحبِه",2]," . قال قيسٌ : وأخبرني - بعد - أبو جحيفةَ ، أن عبدَ اللهِ قال : { إلا من تاب }"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال تنافي الإيمان","dorar":"HwcJr5Qe"},{"id":"س-02589","fp":"33972bf389f9","stateId":217,"easy":"إذا ضربت غير ضاربك أو قتلت غير قاتلك أو تولّيت غير مواليك ← كفرت بالله ورسوله ولا يُقبل منك","cause":"رجُلٌ ضرَبَ غيرَ ضارِبِه، ورجُلٌ قتَلَ غيْرَ قاتِلِه، ورجُلٌ تَولَّى غيْرَ أهلِ نِعمتِه","result":"فمَن فَعَل ذلكَ فقدْ كَفَر باللهِ ورَسولِه، ولا يُقبَلُ منه صَرفٌ ولا عَدلٌ","explicit":true,"otherNeedIds":[52],"ref":"المستدرك على الصحيحين 8235","srcLabel":"البيهقي","text":["عَنْ عَائِشَةَ رَضِيَ اللَّهُ عَنْهَا قَالَتْ: وُجِد في قائمِ سَيفِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ كِتابانِ: إنَّ أشَدَّ النَّاسِ عُتوًّا ",["رجُلٌ ضرَبَ غيرَ ضارِبِه، ورجُلٌ قتَلَ غيْرَ قاتِلِه، ورجُلٌ تَولَّى غيْرَ أهلِ نِعمتِه",1],"، ",["فمَن فَعَل ذلكَ فقدْ كَفَر باللهِ ورَسولِه، ولا يُقبَلُ منه صَرفٌ ولا عَدلٌ",2],"."],"grade":"صحيح","narrator":"عمرة بنت عبد الرحمن","muhaddith":"صحيح الإسناد ولم يخرجاه، [وله شاهد]","takhrij":"أخرجه البيهقي (15994)، وابن أبي عاصم في ((الديات)) (ص51)، والدارقطني (3249) جميعا بلفظه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"BlIslw99"},{"id":"س-02596","fp":"bdc292a671a6","stateId":217,"easy":"إذا ادعيت نسباً لا يُعرف ← كفرت بالله","cause":"منِ ادَّعى نسبًا لا يُعرَفَ","result":"كفر باللهِ","explicit":true,"ref":"صحيح الترغيب 1991","srcLabel":"الطبراني","text":[["منِ ادَّعى نسبًا لا يُعرَفَ ",1],["كفر باللهِ",2]," ، أو انتفى من نسَبٍ وإن دَقَّ كفر بالله"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح لغيره","takhrij":"أخرجه الدارمي (2861)، والحارث في ((المسند)) (30)، والطبراني في ((المعجم الأوسط)) (8575) باختلاف يسير","bab":"إيمان › أعمال تنافي الإيمان","dorar":"gWdW9UuY"},{"id":"س-05217","fp":"631c12a4d16a","stateId":217,"easy":"إذا فارقت الجماعة والإسلام ← خلعت ربقة الإسلام من عنقك","cause":"من فارق الجماعةَ والإسلامَ","result":"فقد خلع رِبْقَةَ الإسلامِ من عُنُقِهِ","explicit":true,"ref":"تخريج كتاب السنة 1054","srcLabel":"أبو داود","text":["من خالف الجماعةَ، نحوَه [يعني حديث: ",["من فارق الجماعةَ والإسلامَ ",1],["فقد خلع رِبْقَةَ الإسلامِ من عُنُقِهِ",2],"]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4758)، وأحمد (21561)، والحاكم (401) جميعهم بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"YJ74bYNI"},{"id":"س-05235","fp":"baf7edc8cb4b","stateId":217,"easy":"إذا هجرت أخاك المسلم ← يخرج أحدكما من الإسلام حتى يرجع","cause":"يتهاجَرُ الرَّجلانِ قد دخَلا في الإسلامِ","result":"إلَّا خرَج أحدُهما منه حتَّى يرجِعَ إلى ما خرَج منه","explicit":true,"otherNeedIds":[60],"ref":"مجمع الزوائد 8/70","srcLabel":"الطبراني","text":["عن عبدِ اللهِ بنِ مسعودٍ قال لا ",["يتهاجَرُ الرَّجلانِ قد دخَلا في الإسلامِ",1]," ",["إلَّا خرَج أحدُهما منه حتَّى يرجِعَ إلى ما خرَج منه",2]," ورجوعُه أن يأتيَه فيُسلِّمَ عليه"],"grade":"صحيح","narrator":"[يزيد بن وهب]","muhaddith":"رجاله رجال الصحيح غير عصمة بن سليمان وهو ثقة","takhrij":"أخرجه الطبراني (9/ 183) (8904) بلفظه، والخرائطي في ((مساوئ الأخلاق)) (519) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"WUkza2m3"},{"id":"س-02571","fp":"9190be0d82be","stateId":217,"easy":"إذا قرأت القرآن ثم خرجت على جارك ورميته بالشرك ← فأنت أولى بالشرك منه","cause":"وسعى على جارِه بالسَّيفِ ورماه بالشِّركِ","result":"أيُّهما أَوْلى بالشِّركِ المَرْميُّ أم الرَّامي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 81","srcLabel":"الطحاوي","text":["( إنَّ ما أتخوَّفُ عليكم رجُلٌ قرَأ القُرآنَ حتَّى إذا رُئِيَتْ بهجتُه عليه وكان رِدْئًا للإسلامِ غيَّره إلى ما شاء اللهُ فانسلَخ منه ونبَذه وراءَ ظَهرِه ",["وسعى على جارِه بالسَّيفِ ورماه بالشِّركِ",1]," ) قال : قُلْتُ : يا نبيَّ اللهِ ",["أيُّهما أَوْلى بالشِّركِ المَرْميُّ أم الرَّامي ؟",2]," قال : ( بلِ الرَّامي )"],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي (( في شرح مشكل الآثار)) (865) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة))(2793)، والبزار((1859)) بنحوه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"siMWhcNp","merged":2,"otherRefs":["تخريج مشكل الآثار 865 (حسن)"]},{"id":"س-02704","fp":"0c5512f7848e","stateId":218,"easy":"إذا تعلمت من علم النجوم ← فقد تعلمت شعبة من السحر","cause":"مَن اقتبَسَ عِلمًا مِن النُّجومِ","result":"اقتبَسَ شُعبَةً مِن سِحرٍ، ما زادَ زادَ، وما زادَ زادَ","explicit":true,"ref":"تخريج المسند لشعيب 2840","srcLabel":"أبو داود","text":[["مَن اقتبَسَ عِلمًا مِن النُّجومِ، ",1],["اقتبَسَ شُعبَةً مِن سِحرٍ، ما زادَ زادَ، وما زادَ زادَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3905)، وابن ماجه (3726)، وأحمد (2840)","bab":"إيمان › السحر والنشرة والكهانة","dorar":"FtnQBb0B"},{"id":"س-02699","fp":"baf8c4dbc453","stateId":218,"easy":"إذا عقدت عقدة ونفثت فيها ← فقد سحرت","cause":"من عقدَ عُقدةً ثمَّ نفثَ فيها","result":"فقد سحَرَ","explicit":true,"ref":"الآداب الشرعية 3/68","srcLabel":"النسائي","text":[["من عقدَ عُقدةً ثمَّ نفثَ فيها ",1],["فقد سحَرَ ",2],"ومن سحرَ فقد أشرَكَ ومن تعلَّقَ شيئًا وُكلَ إليْهِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه النسائي (4079)، والطبراني في ((المعجم الأوسط)) (1469) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (4/341)","bab":"إيمان › السحر والنشرة والكهانة","dorar":"HIkRzaHL"},{"id":"س-02519","fp":"ed35fca127f8","stateId":218,"easy":"إذا عالجت بالنشرة (حل السحر بالسحر) ← فهي من عمل الشيطان","cause":"النُّشْرةِ","result":"أنَّها مِن عَملِ الشَّيطانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[34],"ref":"المستدرك على الصحيحين 8512","srcLabel":"الحاكم","text":["عن الحسنِ، قال: سَألتُ أنَسَ بنَ مالكٍ عن ",["النُّشْرةِ",1],"، فقال: ذَكَروا عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ ",["أنَّها مِن عَملِ الشَّيطانِ",2],"."],"grade":"صحيح","narrator":"الحسن","muhaddith":"صحيح وأبو رجاء هو مطر الوراق، ولم يخرجاه","bab":"إيمان › أعمال الجن والشياطين","dorar":"EnYubODp","merged":3,"otherRefs":["مجمع الزوائد 5/105 (صحيح)","صحيح أبي داود 3868 (صحيح)"]},{"id":"س-05328","fp":"8b29b8b012d5","stateId":218,"easy":"إذا أتيت كاهناً فصدقته أو أتيت امرأة في دبرها ← فقد برئت مما أُنزل على محمد ﷺ","cause":"مَن أتى كاهنًا -قال موسى في حديثِه:- فصدَّقَه بما يقولُ، -ثم اتَّفَقا- أو أتى امرأةً -قال مُسدَّدٌ: امرأتَه حائضًا، أو أتى امرأةً- قال مُسدَّدٌ: امرأتَه في دُبُرِها","result":"فقد برِئَ مما أنزَلَ اللهُ على محمدٍ","explicit":true,"star":true,"ref":"تخريج سنن أبي داود 3904","srcLabel":"أبو داود","text":[["مَن أتى كاهنًا -قال موسى في حديثِه:- فصدَّقَه بما يقولُ، -ثم اتَّفَقا- أو أتى امرأةً -قال مُسدَّدٌ: امرأتَه حائضًا، أو أتى امرأةً- قال مُسدَّدٌ: امرأتَه في دُبُرِها",1],"- ",["فقد برِئَ مما أنزَلَ اللهُ على محمدٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله: \"حائضا\"","takhrij":"أخرجه أبو داود (3904) بلفظه، والترمذي (135)، وابن ماجه (639) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › التوكل واليقين","dorar":"hSDMTxQe","merged":6,"otherRefs":["الإيمان لأبي عبيد 77 (صحيح)","النوافح العطرة 345 (صحيح)","مجمع الزوائد 5/121 (صحيح)","مجمع الزوائد 5/120 (صحيح)","فتح البيان 1/ 241 (صحيح)"]},{"id":"س-05079","fp":"9821c0018f68","stateId":218,"easy":"إذا تعلمت من علم النجوم ← تعلمت شعبة من السحر","cause":"اقتَبَسَ رَجُلٌ عِلْمًا مِنَ النُّجومِ","result":"إلَّا اقتَبَسَ بها شُعبةً مِنَ السِّحرِ، ما زادَ، زادَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 2000","srcLabel":"أبو داود","text":["ما ",["اقتَبَسَ رَجُلٌ عِلْمًا مِنَ النُّجومِ",1],"، ",["إلَّا اقتَبَسَ بها شُعبةً مِنَ السِّحرِ، ما زادَ، زادَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3905)، وابن ماجه (3726)، وأحمد (2000) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"0KQHcXQT","merged":2,"otherRefs":["أضواء البيان 4/568 (صحيح)"]},{"id":"س-02556","fp":"38bc3dcf54da","stateId":218,"easy":"إذا تكهّنت بالطير أو الخط أو تطيّرت ← فهو من الجبت","cause":"العِيَافَةُ والطَّرْقُ والطِّيَرَةُ","result":"مِنَ الجِبْتِ","explicit":true,"ref":"تخريج شرح السنة 3256","srcLabel":"أبو داود","text":[["العِيَافَةُ والطَّرْقُ والطِّيَرَةُ",1]," ",["مِنَ الجِبْتِ",2],"."],"grade":"حسن","narrator":"قبيصة","muhaddith":"[فيه] حيان هو ابن العلاء لم يوثقه غير ابن حبان، وباقي رجاله ثقات","takhrij":"أخرجه أبو داود (3907)، وأحمد (15915)، وابن حبان (6131) جميعهم بلفظه.","bab":"إيمان › أعمال الجن والشياطين","dorar":"q9vX1Imo"},{"id":"س-02700","fp":"ee5b06d4b42a","stateId":218,"easy":"إذا سحرت ← فقد أشركت","cause":"ومن سحرَ","result":"فقد أشرَكَ","explicit":true,"ref":"الآداب الشرعية 3/68","srcLabel":"النسائي","text":["من عقدَ عُقدةً ثمَّ نفثَ فيها فقد سحَرَ ",["ومن سحرَ ",1],["فقد أشرَكَ ",2],"ومن تعلَّقَ شيئًا وُكلَ إليْهِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه النسائي (4079)، والطبراني في ((المعجم الأوسط)) (1469) واللفظ لهما، وابن عدي في ((الكامل في الضعفاء)) (4/341)","bab":"إيمان › السحر والنشرة والكهانة","dorar":"HIkRzaHL"},{"id":"س-05692","fp":"a2c2a04d2f9e","stateId":218,"easy":"إذا عدت لصنع شيء من الكهانة ← فقد كفرت بما أُنزل على محمد ﷺ","cause":"من عاد لصنعةِ شيٍء من هذا","result":"فقد كفر بما أُنْزِلَ على محمدٍ صلَّى اللهُ عليهِ وسلَّمَ","explicit":true,"similar":["س-05696"],"ref":"تخريج المسند لشاكر 2/68","srcLabel":"أبو داود","text":["كان رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ في جنازةٍ فقال : أيُّكم ينطلقُ إلى المدينةِ فلا يدعُ بها وثنًا إلا كسرَهُ ولا قبرًا إلا سوَّاهُ ولا صورةً إلا لطخها فقال : إنَّا يا رسولَ اللهِ فانطلقَ فهاب أهلَ المدينةِ فرجع فقال عليٌّ رضيَ اللهُ عنهُ : أنا أنطلقُ يا رسولَ اللهِ قال : فانطلقَ ثم رجع فقال : يا رسولَ اللهِ لم أدعْ بها وثنًا إلا كسرتُهُ ولا قبرًا إلا سوَّيتُهُ ولا صورةً إلا لطختها ثم قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : ",["من عاد لصنعةِ شيٍء من هذا",1]," ",["فقد كفر بما أُنْزِلَ على محمدٍ صلَّى اللهُ عليهِ وسلَّمَ",2]," ثم قال : لا تكونَنَّ فتَّانًا ولا مختالًا ولا تاجرًا إلا تاجرَ خيرٍ فإنَّ أولئك هم المسبوقونَ بالعملِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (657)، وأبو داود الطيالسي في ((المسند)) (97)، والطبراني في ((المعجم الأوسط)) (3412) واللفظ لهم جميعا.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"hu6bGDa9"},{"id":"س-05696","fp":"6c60d2122088","stateId":218,"easy":"إذا عدت فصنعت شيئاً من الكهانة ← كفرت بما أنزل الله على محمد ﷺ","cause":"مَن عادَ فصنعَ شيئًا مِن ذلِكَ","result":"فقد كفرَ بما أنزلَ اللَّهُ على محمَّدٍ","explicit":true,"repOf":"س-05692","ref":"تخريج المسند لشاكر 2/274","text":["كنَّا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في جَنازةٍ فقالَ : مَن يأتي المدينةَ فلا يدعْ قبرًا إلَّا سوَّاهُ ، ولا صورةً إلَّا طلَخَها ، ولا وثنًا إلَّا كسرَهُ قالَ : فقامَ رجلٌ فقالَ : أَنا . ثمَّ هابَ أَهْلَ المدينةِ فجلسَ ، قالَ عليٌّ رضيَ اللَّهُ عنهُ فانطلقتُ ، ثمَّ جئتُ فقلتُ : يا رسولَ اللَّهِ لَم أدَعْ بالمدينةِ قبرًا إلَّا سوَّيتُهُ ، ولا صورةً إلَّا طلختُها ، ولا وثنًا إلَّا كسَّرتُهُ ، قالَ : فقالَ : ",["مَن عادَ فصنعَ شيئًا مِن ذلِكَ",1]," ",["فقد كفرَ بما أنزلَ اللَّهُ على محمَّدٍ",2]," ، يا عليُّ ، لا تَكوننَّ فتَّانًا أو قالَ : مُختالًا ولا تاجرًا إلَّا تاجرَ الخيرِ ، فإنَّ أولئِكَ همُ المُسَوِّفونَ في العملِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه الطيالسي (97)، وأبو يعلى (506) واللفظ لهما، والطبراني في ((الأوسط)) (3412) بنحوه.","bab":"رقائق وزهد › الكبر والتواضع","dorar":"J1KV1qh0"},{"id":"ق-0490","fp":"cee595ef187d","stateId":219,"easy":"تولّي الأقارب إن استحبوا الكفر على الإيمان ← الظلم","cause":"تولّي الأقارب إن استحبوا الكفر على الإيمان","result":"الظلم","explicit":true,"star":true,"ref":"سورة التوبة: 23","srcLabel":"القرآن الكريم","quran":{"s":9,"from":23,"to":23,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا آبَاءَكُمْ وَإِخْوَانَكُمْ أَوْلِيَاءَ إِنِ اسْتَحَبُّوا الْكُفْرَ عَلَى الْإِيمَانِ وَمَنْ يَتَوَلَّهُمْ مِنْكُمْ فَأُولَئِكَ هُمُ الظَّالِمُونَ (23)","hl":[[132,192,1]]}},{"id":"ق-1325","fp":"2dbfca15fc92","stateId":219,"easy":"تولّي المحاربين في الدين ← الظلم","cause":"تولّي المحاربين في الدين","result":"الظلم","explicit":true,"ref":"سورة الممتحنة: 9","srcLabel":"القرآن الكريم","quran":{"s":60,"from":9,"to":9,"text":"إِنَّمَا يَنْهَاكُمُ اللَّهُ عَنِ الَّذِينَ قَاتَلُوكُمْ فِي الدِّينِ وَأَخْرَجُوكُمْ مِنْ دِيَارِكُمْ وَظَاهَرُوا عَلَى إِخْرَاجِكُمْ أَنْ تَوَلَّوْهُمْ وَمَنْ يَتَوَلَّهُمْ فَأُولَئِكَ هُمُ الظَّالِمُونَ (9)","hl":[[154,205,1]]}},{"id":"ق-0313","fp":"f4a28e7ba81d","stateId":219,"easy":"تولّي اليهود والنصارى ← يكون منهم ولا يهديه الله","cause":"تولّي اليهود والنصارى","result":"يكون منهم ولا يهديه الله","explicit":true,"star":true,"otherNeedIds":[21],"ref":"سورة المائدة: 51","srcLabel":"القرآن الكريم","quran":{"s":5,"from":51,"to":51,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا الْيَهُودَ وَالنَّصَارَى أَوْلِيَاءَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ وَمَنْ يَتَوَلَّهُمْ مِنْكُمْ فَإِنَّهُ مِنْهُمْ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ (51)","hl":[[114,212,1]]}},{"id":"ق-0370","fp":"a458b5f06bf8","stateId":219,"easy":"طاعة أولياء الشيطان في تحليل الحرام ← الشرك","cause":"طاعة أولياء الشيطان في تحليل الحرام","result":"الشرك","explicit":true,"star":true,"ref":"سورة الأنعام: 121","srcLabel":"القرآن الكريم","quran":{"s":6,"from":121,"to":121,"text":"وَلَا تَأْكُلُوا مِمَّا لَمْ يُذْكَرِ اسْمُ اللَّهِ عَلَيْهِ وَإِنَّهُ لَفِسْقٌ وَإِنَّ الشَّيَاطِينَ لَيُوحُونَ إِلَى أَوْلِيَائِهِمْ لِيُجَادِلُوكُمْ وَإِنْ أَطَعْتُمُوهُمْ إِنَّكُمْ لَمُشْرِكُونَ (121)","hl":[[152,198,1]]}},{"id":"س-00366","fp":"47558ecc3cb0","stateId":219,"easy":"إذا أرضيت سلطاناً بما يسخط ربك ← خرجت من دين الله","cause":"منْ أرضَى سلطانًا بما يسخطُ ربَّهُ","result":"خرجَ منْ دينِ اللهِ","explicit":true,"ref":"الجامع الصغير 8374","srcLabel":"الحاكم","text":[["منْ أرضَى سلطانًا بما يسخطُ ربَّهُ،  ",1],["خرجَ منْ دينِ اللهِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((تاريخ أصبهان)) (2/ 326) بلفظه، والحاكم (7071) باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"LflKaVJ9"},{"id":"س-05010","fp":"53ade33954b3","stateId":219,"easy":"إذا جامعت المشرك وسكنت معه ← فأنت مثله","cause":"من جامعَ المشرِكَ وسَكنَ معَهُ","result":"فإنَّهُ مثلُهُ","explicit":true,"ref":"صحيح أبي داود 2787","srcLabel":"أبو داود","text":[["من جامعَ المشرِكَ وسَكنَ معَهُ",1]," ",["فإنَّهُ مثلُهُ",2]],"grade":"صحيح","narrator":"سمرة بن جندب","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2787)، والديلمي في ((الفردوس)) (5756)، وأخرجه الطبراني (7/251) (7023) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"MAj2g1Hm"},{"id":"س-07999","fp":"3aaf531f8d9d","stateId":219,"easy":"إذا مشيت مع ظالم لتقويه وأنت تعلم ← خرجت من الإسلام","cause":"من مشى معَ ظالِمٍ ليُقَوِّيَهُ وهوَ يعلمُ أنَّهُ ظالِمٌ","result":"فقد خرجَ مِنَ الإسلامِ","explicit":true,"ref":"شعب الإيمان 6/2606","srcLabel":"الطبراني","text":[["من مشى معَ ظالِمٍ ليُقَوِّيَهُ وهوَ يعلمُ أنَّهُ ظالِمٌ ، ",1],["فقد خرجَ مِنَ الإسلامِ",2]],"grade":"صحيح","narrator":"أوس بن شرحبيل","muhaddith":"صحيح لا شك فيه","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2252)، والطبراني (1/227) (622)، والبيهقي في ((شعب الإيمان)) (7675) واللفظ له","bab":"مظالم › تحريم الظلم","dorar":"koZ1qweB"},{"id":"س-03896","fp":"800f9d538031","stateId":219,"easy":"إذا أطعت أحداً في تحليل الحرام وتحريم الحلال ← فقد عبدته","cause":"أليسَ يحرمونَ ما أحلَّ اللهُ فتحرِّمونَه ، ويحلُّونَ ما حرَّمَ اللهُ فتحلُّونَه","result":"فتلك عبادتُهم","explicit":true,"ref":"حقيقة الإسلام و الإيمان 111","srcLabel":"الترمذي","text":["قدمَ [ عديُّ بنُ حاتمٍ ] على النَّبيِّ صلَّى اللهُ عليهِ وسلَّمَ وهو نصرانيٌّ فسمعه يقرأُ هذه الآيةَ :  اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِنْ دُونِ اللَّهِ وَالْمَسِيحَ ابْنَ مَرْيَمَ وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا إِلَهًا وَاحِدًا لَا إِلَهَ إِلَّا هُوَ سُبْحَانَهُ عَمَّا يُشْرِكُونَ قال : فقلتُ له : إنَّا لسنا نعبدُهم ، قال : ",["أليسَ يحرمونَ ما أحلَّ اللهُ فتحرِّمونَه ، ويحلُّونَ ما حرَّمَ اللهُ فتحلُّونَه",1]," ، قال : قلتُ : بلى ، قال : ",["فتلك عبادتُهم",2]],"grade":"حسن","narrator":"عدي بن حاتم الطائي","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الكبير)) (17/ 92)، واللفظ له، والترمذي (3095)، والبيهقي في ((الكبرى)) (20350) باختلاف يسير.","bab":"تفسير آيات › سورة التوبة","dorar":"iDciFrcm","merged":3,"otherRefs":["غاية المرام 6 (حسن)","صحيح الترمذي 3095 (حسن)"]},{"id":"س-04861","fp":"1cc3490a0346","stateId":219,"easy":"إذا أخذت شعار الكافر فجعلته في عنقك ← ولّيت الإسلام ظهرك","cause":"ومن نزعَ صغارَ كافرٍ من عنقِهِ فجعلَهُ في عنقِهِ","result":"ولَّى الإسلامَ ظهرَهُ","explicit":true,"ref":"هداية الرواة 3/407","srcLabel":"أبو داود","text":["من أخذَ أرضًا بجزيتِها فقدِ استقالَ هجرتَهُ ",["ومن نزعَ صغارَ كافرٍ من عنقِهِ فجعلَهُ في عنقِهِ",1]," ",["ولَّى الإسلامَ ظهرَهُ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (3082)، والطبراني في ((المعجم الأوسط)) (8244)، والبيهقي (18859) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"fM0BSv4B"},{"id":"س-04588","fp":"5c70853a49b7","stateId":220,"easy":"إذا سرقت ← لا تكون مؤمناً حين تسرق","cause":"يَسرِقُ حينَ يَسرِقُ","result":"لا يَسرِقُ حينَ يَسرِقُ وهو مُؤمِنٌ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"صحيح البخاري 6809","srcLabel":"متفق عليه","text":["لا يَزني العَبدُ حينَ يَزني وهو مُؤمِنٌ، و",["لا يَسرِقُ حينَ يَسرِقُ وهو مُؤمِنٌ",2],"، ولا يَشرَبُ حينَ يَشرَبُ وهو مُؤمِنٌ، ولا يَقتُلُ وهو مُؤمِنٌ. قال عِكرِمةُ: قُلتُ لابنِ عَبَّاسٍ: كيفَ يُنزَعُ الإيمانُ منه؟ قال: هَكَذا، وشَبَّكَ بينَ أصابِعِه، ثُمَّ أخرَجَها، فإن تابَ عادَ إلَيه هَكَذا، وشَبَّكَ بينَ أصابِعِه."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"حدود › تحريم السرقة","dorar":"sOnYNXn3","merged":3,"otherRefs":["المحلى 11/120 (صحيح)","تخريج المسند لشعيب 14731 (صحيح)"]},{"id":"س-00352","fp":"3e5260efc6b5","stateId":220,"easy":"إذا سرقت ← يُنزع منك الإيمان وقت السرقة","cause":"يَسْرِقُ السَّارِقُ","result":"لا يَسْرِقُ السَّارِقُ حِينَ يَسْرِقُ وهو مُؤْمِنٌ","explicit":true,"otherNeedIds":[13],"ref":"صحيح الجامع 7738","srcLabel":"صحيح الجامع","text":["لا يَغُلُّ مؤمنٌ [حديث أبي هريرة: لا يَزْنِي الزَّانِي حِينَ يَزْنِي وهو مُؤْمِنٌ، و",["لا يَسْرِقُ السَّارِقُ حِينَ يَسْرِقُ وهو مُؤْمِنٌ",2],"، ولا يَشْرَبُ الخَمْرَ حِينَ يَشْرَبُها وهو مُؤْمِنٌ. قالَ ابنُ شِهابٍ: فأخْبَرَنِي عبدُ المَلِكِ بنُ أبِي بَكْرِ بنِ عبدِ الرَّحْمَنِ أنَّ أبا بَكْرٍ كانَ يُحَدِّثُهُمْ هَؤُلاءِ عن أبِي هُرَيْرَةَ ، ثُمَّ يقولُ: وكانَ أبو هُرَيْرَةَ يُلْحِقُ معهُنَّ: ولا يَنْتَهِبُ نُهْبَةً ذاتَ شَرَفٍ حِينَ يَنْتَهِبُها وهو مُؤْمِنٌ. وفي حَديثِ هَمَّامٍ: يَرْفَعُ إلَيْهِ المُؤْمِنُونَ أعْيُنَهُمْ فيها وهو حِينَ يَنْتَهِبُها مُؤْمِنٌ. وزادَ: ولا يَغُلُّ أحَدُكُمْ حِينَ يَغُلُّ وهو مُؤْمِنٌ، فإيَّاكُمْ إيَّاكُمْ.] [وحديث ابن عباس: لا يَغُلُّ مؤمنٌ]"],"grade":"صحيح","narrator":"أبو هريرة وابن عباس","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق المذمومة","dorar":"GMr9nwyz","merged":4,"otherRefs":["المحلى 11/119 (صحيح)","المحلى 11/120 (صحيح)"]},{"id":"س-04592","fp":"cc82a0a11f3e","stateId":220,"easy":"إذا زنيت ← لا تكون مؤمناً حين تزني","cause":"يَزني زانٍ","result":"لا يَزني زانٍ حينَ يزني وَهوَ مؤمنٌ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"المحلى 11/120","srcLabel":"متفق عليه","text":["لا يسرِقُ سارقٌ حينَ يسرقُ وَهوَ مؤمنٌ و",["لا يَزني زانٍ حينَ يزني وَهوَ مؤمنٌ",2],"، ولا يشرَبُ الحدودَ - يعني الخمرَ - أحدُكُم حينَ يشربُها وَهوَ مؤمنٌ والَّذي نفسُ محمَّدٍ بيدِهِ لا ينتَهِبُ أحدُكُم نُهْبةً ذاتَ شَرفٍ يرفعُ إليهِ المؤمنونَ أعينَهُم فيها وَهوَ حينَ ينتَهِبُها مُؤمنٌ، ولا يغلُّ أحدُكُم حينَ يغلُّ وَهوَ مؤمِنٌ ثمَّ قالَ أبو هُرَيْرةَ إيَّاكُم إيَّاكُم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه البخاري (5578) دون ذكر \"المؤمنون\" و\"الغل\"، ومسلم (57) باختلاف يسير","bab":"حدود › تحريم السرقة","dorar":"Ew9BiJHG","merged":3,"otherRefs":["المحلى 11/120 (صحيح)","صحيح البخاري 6809 (صحيح)"]},{"id":"س-05089","fp":"ed72112b4a0c","stateId":220,"easy":"إذا سرقت أو زنيت أو شربت الخمر ← يُنزع منك الإيمان","cause":"لا يَسرِقُ حين يَسرِقُ وهو مؤمنٌ، ولا يَزني حين يَزني وهو مؤمنٌ، ولا يَشرَبُ الخمرَ حين يَشرَبُها وهو مؤمنٌ، ولا يَغُلُّ حين يَغُلُّ وهو مؤمنٌ، ولا يَنتَهِبُ حين يَنتَهِبُ وهو مؤمنٌ","result":"إنَّه يُنزَعُ منه الإيمانُ","explicit":true,"similar":["س-00351","س-04011"],"otherNeedIds":[13],"ref":"تخريج المسند لشعيب 9007","srcLabel":"متفق عليه","text":[["لا يَسرِقُ حين يَسرِقُ وهو مؤمنٌ، ولا يَزني حين يَزني وهو مؤمنٌ، ولا يَشرَبُ الخمرَ حين يَشرَبُها وهو مؤمنٌ، ولا يَغُلُّ حين يَغُلُّ وهو مؤمنٌ، ولا يَنتَهِبُ حين يَنتَهِبُ وهو مؤمنٌ",1],". وقال عطاءٌ: ولا يَنتَهِبُ نُهْبةً ذاتَ شَرَفٍ وهو مؤمنٌ. قال بَهْزٌ: فقيلَ له. قال: ",["إنَّه يُنزَعُ منه الإيمانُ",2],"، فإنْ تابَ تابَ اللهُ عليه. وقال عَفَّانُ في حديثِه: قال قتادةُ: وفي حديثِ عطاءٍ: نُهْبةً ذاتَ شَرَفٍ وهو مؤمنٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين من جهة عطاء بن أبي رباح","takhrij":"أخرجه البخاري (2475)، ومسلم (57) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"2XmsJpO0"},{"id":"س-00351","fp":"cc797baf7f54","stateId":220,"easy":"إذا زنيت ← يُنزع منك الإيمان وقت الزنا","cause":"يَزْنِي الزَّانِي","result":"لا يَزْنِي الزَّانِي حِينَ يَزْنِي وهو مُؤْمِنٌ","explicit":true,"repOf":"س-05089","otherNeedIds":[13],"ref":"صحيح الجامع 7738","text":["لا يَغُلُّ مؤمنٌ [حديث أبي هريرة: ",["لا يَزْنِي الزَّانِي حِينَ يَزْنِي وهو مُؤْمِنٌ",2],"، ولا يَسْرِقُ السَّارِقُ حِينَ يَسْرِقُ وهو مُؤْمِنٌ، ولا يَشْرَبُ الخَمْرَ حِينَ يَشْرَبُها وهو مُؤْمِنٌ. قالَ ابنُ شِهابٍ: فأخْبَرَنِي عبدُ المَلِكِ بنُ أبِي بَكْرِ بنِ عبدِ الرَّحْمَنِ أنَّ أبا بَكْرٍ كانَ يُحَدِّثُهُمْ هَؤُلاءِ عن أبِي هُرَيْرَةَ ، ثُمَّ يقولُ: وكانَ أبو هُرَيْرَةَ يُلْحِقُ معهُنَّ: ولا يَنْتَهِبُ نُهْبَةً ذاتَ شَرَفٍ حِينَ يَنْتَهِبُها وهو مُؤْمِنٌ. وفي حَديثِ هَمَّامٍ: يَرْفَعُ إلَيْهِ المُؤْمِنُونَ أعْيُنَهُمْ فيها وهو حِينَ يَنْتَهِبُها مُؤْمِنٌ. وزادَ: ولا يَغُلُّ أحَدُكُمْ حِينَ يَغُلُّ وهو مُؤْمِنٌ، فإيَّاكُمْ إيَّاكُمْ.] [وحديث ابن عباس: لا يَغُلُّ مؤمنٌ]"],"grade":"صحيح","narrator":"أبو هريرة وابن عباس","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق المذمومة","dorar":"GMr9nwyz","merged":6,"otherRefs":["صحيح الترغيب 2395 (صحيح)","المحلى 11/119 (صحيح)","المحلى 11/120 (صحيح)","تخريج المسند لشعيب 14731 (صحيح)"]},{"id":"س-04011","fp":"565c2318b684","stateId":220,"easy":"إذا زنيت ← يخرج منك الإيمان ويكون فوقك كالظلة","cause":"إذا زنى الرجلُ","result":"خَرَجَ منه الإيمان ُ، كان عليه كالظُّلَّةِ","explicit":true,"repOf":"س-05089","otherNeedIds":[13],"ref":"صحيح أبي داود 4690","text":[["إذا زنى الرجلُ",1]," ",["خَرَجَ منه الإيمان ُ، كان عليه كالظُّلَّةِ",2]," ، فإذا انقَطَعَ رَجَعَ إليه الإيمانُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4690)، وابن بطة في ((الإبانة الكبرى)) (976)، والديلمي في ((الفردوس)) (1254) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"zxQe4XII"},{"id":"س-00353","fp":"9d3cec100f13","stateId":220,"easy":"إذا شربت الخمر ← يُنزع منك الإيمان وقت شربها","cause":"يَشْرَبُ الخَمْرَ","result":"لا يَشْرَبُ الخَمْرَ حِينَ يَشْرَبُها وهو مُؤْمِنٌ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"صحيح الجامع 7738","srcLabel":"صحيح الجامع","text":["لا يَغُلُّ مؤمنٌ [حديث أبي هريرة: لا يَزْنِي الزَّانِي حِينَ يَزْنِي وهو مُؤْمِنٌ، ولا يَسْرِقُ السَّارِقُ حِينَ يَسْرِقُ وهو مُؤْمِنٌ، و",["لا يَشْرَبُ الخَمْرَ حِينَ يَشْرَبُها وهو مُؤْمِنٌ",2],". قالَ ابنُ شِهابٍ: فأخْبَرَنِي عبدُ المَلِكِ بنُ أبِي بَكْرِ بنِ عبدِ الرَّحْمَنِ أنَّ أبا بَكْرٍ كانَ يُحَدِّثُهُمْ هَؤُلاءِ عن أبِي هُرَيْرَةَ ، ثُمَّ يقولُ: وكانَ أبو هُرَيْرَةَ يُلْحِقُ معهُنَّ: ولا يَنْتَهِبُ نُهْبَةً ذاتَ شَرَفٍ حِينَ يَنْتَهِبُها وهو مُؤْمِنٌ. وفي حَديثِ هَمَّامٍ: يَرْفَعُ إلَيْهِ المُؤْمِنُونَ أعْيُنَهُمْ فيها وهو حِينَ يَنْتَهِبُها مُؤْمِنٌ. وزادَ: ولا يَغُلُّ أحَدُكُمْ حِينَ يَغُلُّ وهو مُؤْمِنٌ، فإيَّاكُمْ إيَّاكُمْ.] [وحديث ابن عباس: لا يَغُلُّ مؤمنٌ]"],"grade":"صحيح","narrator":"أبو هريرة وابن عباس","muhaddith":"صحيح","bab":"آداب عامة › الأخلاق المذمومة","dorar":"GMr9nwyz","merged":5,"otherRefs":["المحلى 11/120 (صحيح)","المحلى 11/119 (صحيح)"]},{"id":"س-02574","fp":"73b0b718640e","stateId":220,"easy":"إذا أدمنت الخمر ← لا يجتمع الإيمان وإدمانها في صدرك","cause":"وإدمانُ الخمرِ","result":"لا يجتمِعُ الإيمانُ وإدمانُ الخمرِ في صدرِ رجُلٍ أبدًا لَيوشِكَنَّ أحدُهما يُخرِجُ صاحبَه","explicit":true,"otherNeedIds":[13],"ref":"صحيح ابن حبان 5348","srcLabel":"النسائي","text":["اجتَنِبوا أمَّ الخبائثِ فإنَّه كان رجُلٌ ممَّن قبْلَكم يتعبَّدُ ويعتزلُ النَّاسَ فعلِقتْه امرأةٌ فأرسَلتْ إليه خادمًا فقالت: إنَّا ندعوك لشَهادةٍ فدخَل فطفِقتْ كلَّما يدخُلُ بابًا أغلَقتْه دونَه حتَّى أفضى إلى امرأةٍ وضيئةٍ جالسةٍ وعندَها غلامٌ وباطيَةٌ فيها خمرٌ فقالت: إنَّا لم نَدْعُك لشَهادةٍ ولكِنْ دعَوْتُك لتقتُلَ هذا الغلامَ أو تقَعَ عليَّ أو تشرَبَ كأسًا مِن هذا الخمرِ فإنْ أبَيْتَ صِحْتُ بك وفضَحْتُك قال: فلمَّا رأى أنَّه لا بدَّ له مِن ذلك قال: اسقيني كأسًا مِن هذا الخمرِ فسقَتْه كأسًا مِن الخمرِ فقال: زيديني فلم يزَلْ حتَّى وقَع عليها وقتَل النَّفسَ فاجتَنِبوا الخمرَ فإنَّه واللهِ ",["لا يجتمِعُ الإيمانُ وإدمانُ الخمرِ في صدرِ رجُلٍ أبدًا لَيوشِكَنَّ أحدُهما يُخرِجُ صاحبَه",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (5666)، والبيهقي في ((شعب الإيمان)) (5197) كلاهما باختلاف يسير، وابن أبي الدنيا في ((ذم المسكر)) (1) بنحوه.","bab":"إيمان › أعمال تنافي الإيمان","dorar":"NHaSz0RP"},{"id":"س-05232","fp":"a9bb9d754c47","stateId":220,"easy":"إذا أدمنت الخمر ← فأنت كعابد الأوثان","cause":"مدمنَ الخمرِ","result":"كعابدِ الأوثانِ","explicit":true,"star":true,"otherNeedIds":[13],"ref":"حلية الأولياء 3/237","srcLabel":"أبو نعيم","text":["أشهدُ باللهِ وأشهدُ للهِ, لقد قال لي جبريلُ عليه السَّلامُ : يا محمَّدُ ! إنَّ ",["مدمنَ الخمرِ",1]," ",["كعابدِ الأوثانِ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح ثابت وروي من غير طريق","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (2/203)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Q6k9vHJ6","merged":3,"otherRefs":["صحيح الجامع 3701 (صحيح)","فتح الغفار 1957/4 (صحيح)"]},{"id":"س-04015","fp":"8e9a38dae3e4","stateId":220,"easy":"إذا زنيت ← يخرج منك الإيمان فيكون على رأسك كالظلة","cause":"إذا زَنَى العَبْدُ","result":"خَرَجَ مِنهُ الإِيمانُ ، فكانَ على رأْسِهِ كالظُّلَّةِ","explicit":true,"star":true,"similar":["س-03967","س-03999"],"ref":"صحيح الجامع 586","srcLabel":"الحاكم","text":[["إذا زَنَى العَبْدُ",1]," ",["خَرَجَ مِنهُ الإِيمانُ ، فكانَ على رأْسِهِ كالظُّلَّةِ",2]," ، فإذا أقْلَعَ رَجَعَ إِليهِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (56)، والبيهقي في ((شعب الإيمان)) (5364)، والديلمي في ((الفردوس)) (1152) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"gVSsaeOk","merged":2,"otherRefs":["السلسلة الصحيحة 509 (صحيح)"]},{"id":"س-02561","fp":"5a6a08336209","stateId":220,"easy":"إذا أتيت امرأتك في دبرها ← فقد كفرت (بما أُنزل)","cause":"مَنْ أَتَى النِّساءَ في أَعْجَازِهِنَّ","result":"فقد كَفَرَ","explicit":true,"similar":["س-07165"],"ref":"صحيح الترغيب 2430","srcLabel":"الطبراني","text":[["مَنْ أَتَى النِّساءَ في أَعْجَازِهِنَّ ؛ ",1],["فقد كَفَرَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (9179)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"UyrcknXW"},{"id":"س-03967","fp":"1372f2fa7564","stateId":220,"easy":"إذا زنيت ← يُنزع منك الإيمان","cause":"إذا زنا العبدُ","result":"نزع منه الإيمانِ","explicit":true,"repOf":"س-04015","ref":"شرح الطحاوية 337","text":[["إذا زنا العبدُ ",1],["نزع منه الإيمانِ ",2],"، فإذا تاب أعيدَ إليه"],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"NpGoXUt5"},{"id":"س-03999","fp":"546b117645cf","stateId":220,"easy":"إذا زنيت ← يخرج منك الإيمان كالظلة","cause":"إذا زنى الزاني","result":"خرج منه الإيمانُ فكان كالظُّلَّةِ","explicit":true,"repOf":"س-04015","ref":"الإيمان لابن تيمية 30","text":[["إذا زنى الزاني ",1],["خرج منه الإيمانُ فكان كالظُّلَّةِ ",2],"، فإذا انقلع رجع إليه الإيمانُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت","takhrij":"أخرجه أبو داود (4690)، وابن بطة في ((الإبانة الكبرى)) (976)، والديلمي في ((الفردوس)) (1254) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"25EDEokj"},{"id":"س-04003","fp":"005abb18a4ee","stateId":220,"easy":"إذا زنيت خرج منك الإيمان ← فإذا أقلعت رجع إليك","cause":"إذا زنَى الرجُلُ خرَجَ منه الإيمانُ","result":"كان عليه كالظُّلَّةِ، فإذا انقَلعَ رجَعَ إليه الإيمانُ","explicit":true,"ref":"الأحكام الشرعية الصغرى 89","srcLabel":"أبو داود","text":[["إذا زنَى الرجُلُ خرَجَ منه الإيمانُ، ",1],["كان عليه كالظُّلَّةِ، فإذا انقَلعَ رجَعَ إليه الإيمانُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه أبو داود (4690)","bab":"توبة › الحض على التوبة","dorar":"jhNiGKeF"},{"id":"س-04884","fp":"f64b129f45d3","stateId":220,"easy":"إذا زنيت أو شربت الخمر ← ينزع الله منك الإيمان كما يُخلع القميص","cause":"مَن زَنَى أو شَرِبَ الخَمْرَ","result":"نَزَعَ اللهُ منه الإيمانَ ، كما يَخْلَعُ الإنسانُ القميصَ من رأسِه","explicit":true,"ref":"الجامع الصغير 8703","srcLabel":"الحاكم","text":[["مَن زَنَى أو شَرِبَ الخَمْرَ ، ",1],["نَزَعَ اللهُ منه الإيمانَ ، كما يَخْلَعُ الإنسانُ القميصَ من رأسِه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم في ((مستدركه)) (3468) واللفظ له، وأبو داوود (4690), والبيهقي في ((الشعب)) (4979) كلاهما بنحوه .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"BgrtRTVX"},{"id":"س-07165","fp":"8264459d7d44","stateId":220,"easy":"إذا أتيت امرأتك في دبرها ← فقد سألت عن الكفر (أثر ابن عباس)","cause":"الذي يأتي امرأتَه في دُبُرِها","result":"هذا يَسْأَلُنِي عن الكُفْرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02561","otherNeedIds":[13],"ref":"آداب الزفاف 34","text":["سُئِلَ ابنُ عباسٍ عن ",["الذي يأتي امرأتَه في دُبُرِها",1]," ؟ فقال : ",["هذا يَسْأَلُنِي عن الكُفْرِ",2]," ؟"],"grade":"صحيح","narrator":"طاووس بن كيسان اليماني","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبد الرزاق (20953) واللفظ له، والنسائي في ((الكبرى)) (8955)، والخلال في ((السنة)) (1428) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"otVxfAT7","merged":2,"otherRefs":["التلخيص الحبير 3/1208 (حسن)"]},{"id":"س-07661","fp":"42e525b49972","stateId":221,"easy":"إذا غلوت في القدر ← خرجت من الإيمان","cause":"ما غَلا أحَدٌ في القَدَرِ","result":"إلَّا خَرَجَ مِن الإيمانِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 166","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ قالَ: «",["ما غَلا أحَدٌ في القَدَرِ",1]," ",["إلَّا خَرَجَ مِن الإيمانِ»",2],"."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قدر › التكذيب بالقدر","dorar":"eNpJnDiz"},{"id":"س-07772","fp":"b1f928de0169","stateId":221,"easy":"إذا ماريت في القرآن ← فالمراء فيه كفر","cause":"ولا تَمارَوْا فيه","result":"فإنَّ المِراءَ فيه كُفرٌ، أو آيةُ الكُفرِ","explicit":true,"star":true,"similar":["س-07779","س-07778"],"otherNeedIds":[61,28],"ref":"تخريج المسند لشعيب 17821","srcLabel":"أحمد","text":["سمِعَ عَمرُو بنُ العاصِ رَجلًا يَقرَأُ آيةً منَ القُرآنِ، فقال: مَن أقْرَأكَها؟ قال: رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فقد أقْرَأنيها رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على غيرِ هذا، فذَهَبا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال أحَدُهما: يا رسولَ اللهِ، آيةُ كذا وكذا، ثُم قرَأَها، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: هكذا أُنزِلَتْ، فقال الآخَرُ: يا رسولَ اللهِ، فقرَأَها على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وقال: أليس هكذا يا رسولَ اللهِ؟ قال: هكذا أُنزِلَتْ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ هذا القُرآنَ أُنزِلَ على سَبعةِ أحرُفٍ، فأيَّ ذلك قَرَأْتم فقد أصَبْتم، ",["ولا تَمارَوْا فيه",1],"؛ ",["فإنَّ المِراءَ فيه كُفرٌ، أو آيةُ الكُفرِ",2],"."],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17821) واللفظ له، وأبو عبيد في ((فضائل القرآن)) (ص337)، والبيهقي في ((شعب الإيمان)) (2266)","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"UgGMRata","merged":7,"otherRefs":["تخريج سير أعلام النبلاء 11/ 283 (صحيح)","مجمع الزوائد 7/154 (صحيح)","تخريج المسند لشعيب 17819 (صحيح)","تخريج مشكل الآثار 3099 (صحيح)","تفسير الطبري 1/16 (صحيح)","شرح الطحاوية 517 (صحيح)"]},{"id":"س-03067","fp":"28a22ebcc52a","stateId":221,"easy":"إذا كنت مرجئاً أو قدرياً ← فليس لك في الإسلام نصيب","cause":"المُرْجئةُ والقَدَريَّةُ","result":"صِنْفانِ مِن أُمَّتي ليسَ لهما في الإسلامِ نَصيبٌ","explicit":true,"otherNeedIds":[69],"ref":"عارضة الأحوذي 5/5","srcLabel":"الترمذي","text":[["صِنْفانِ مِن أُمَّتي ليسَ لهما في الإسلامِ نَصيبٌ",2],": ",["المُرْجئةُ والقَدَريَّةُ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2149) واللفظ له، وابن ماجه (62).","bab":"إيمان › الوعيد","dorar":"wrRW7LS1","merged":2,"otherRefs":["الجامع الصغير 5027 (حسن)"]},{"id":"س-06454","fp":"2a73b57785c3","stateId":221,"easy":"إذا خالفت السنة (رغبة عنها) ← كفرت","cause":"من خالف السُّنَّةِ","result":"كفَرَ","explicit":true,"ref":"المحلى 4/270","srcLabel":"الطبراني","text":["قلتُ لابنِ عمرَ : حدِّثْني عن صلاةِ السَّفرِ ، فقال : أَتخشى أن تكذبَ عليَّ قلتُ : لا ، قال : ركعتانِ . ",["من خالف السُّنَّةِ",1]," ",["كفَرَ",2]],"grade":"صحيح","narrator":"صفوان بن محرز","muhaddith":"صحيح من رواية الثقات","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (2462) بلفظه، والطبراني (14010)   (13 / 260)، وأبو نعيم في ((حلية الأولياء)) (7/ 185)، والبيهقي (5484) جميعًا بلفظه دون قوله: (( أتخشى أن تكذب علي)) .","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"qCbvXCBJ","merged":2,"otherRefs":["ذخيرة الحفاظ 3/1533 (صحيح)"]},{"id":"س-02601","fp":"af09dfb23dfa","stateId":221,"easy":"إذا قلت «القرآن مخلوق» ← فقد كفرت","cause":"من قالَ : القرآنُ مخلوقٌ","result":"فقدْ كفرَ","explicit":true,"ref":"اللآلئ المصنوعة 1/8","srcLabel":"اللالكائي","text":["أدركتُ تسعةً من أصحابِ رسولِ اللهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولونَ : ",["من قالَ : القرآنُ مخلوقٌ ",1],["فقدْ كفرَ",2]],"grade":"صحيح","narrator":"عمرو بن دينار","muhaddith":"صحيح","takhrij":"أخرجه اللالكائي في ((شرح أصول اعتقاد أهل السنة)) (380)","bab":"إيمان › أعمال تنافي الإيمان","dorar":"Tuenz3PJ"},{"id":"س-07779","fp":"cc1936909312","stateId":221,"easy":"إذا جادلت في القرآن ← فالجدال فيه كفر","cause":"لا تُجادِلوا في القرآنِ","result":"فإنَّ جدالًا فيه كُفْرٌ","explicit":true,"repOf":"س-07772","ref":"صحيح الجامع 7223","text":[["لا تُجادِلوا في القرآنِ ، ",1],["فإنَّ جدالًا فيه كُفْرٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي في ((المسند)) (2400)، والبيهقي في ((شعب الإيمان)) (2257)","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"PtMxLL2N"},{"id":"س-07663","fp":"63a88405f459","stateId":221,"easy":"إذا كذبت بالقدر ← فهو أصل الزندقة","cause":"التكذيبُ بالقدَرِ","result":"ما كانتْ زندقةٌ إلَّا وأصلُها","explicit":true,"ref":"النكت على الموضوعات 43","srcLabel":"النكت على الموضوعات","text":[["ما كانتْ زندقةٌ إلَّا وأصلُها",2]," ",["التكذيبُ بالقدَرِ",1]],"grade":"حسن","narrator":"سهل بن سعد الساعدي وأبو هريرة","muhaddith":"ورد من حديث أبي أمامة بسند لا بأس به","bab":"قدر › التكذيب بالقدر","dorar":"Wps1fq76"},{"id":"س-07778","fp":"17cc8ab3ad5d","stateId":221,"easy":"إذا جادلت في القرآن ← فهو كفر","cause":"جدالٌ بالقرآنِ","result":"كفرٌ","explicit":true,"repOf":"س-07772","ref":"الكامل في الضعفاء 6/84","text":[["جدالٌ بالقرآنِ",1]," ",["كفرٌ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"لا بأس به","takhrij":"أخرجه أبو داود (4603) بنحوه، وأحمد (7499) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (5/41) واللفظ له","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"Lshn8I8Y"},{"id":"س-07781","fp":"767e7ba6c966","stateId":221,"easy":"إذا تأولت القرآن على غير وجهه ← فهو مما خافه النبي ﷺ على أمته","cause":"ما بالُ الكِتابِ","result":"إنَّما أَخافُ على أُمَّتي الكِتابَ واللَّبَنَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[33],"ref":"تخريج المسند لشعيب 17318","srcLabel":"أحمد","text":[["إنَّما أَخافُ على أُمَّتي الكِتابَ واللَّبَنَ",2],". قال: قيل: يا رسولَ اللهِ، ",["ما بالُ الكِتابِ",1],"؟ قال: يَتعلَّمُه المُنافِقونَ ثمَّ يُجادِلونَ به الذين آمَنوا. فقيل: وما بالُ اللَّبَنِ؟ قال: أُناسٌ يُحِبُّونَ اللَّبَنَ، فيَخرُجونَ مِنَ الجَماعاتِ، ويَتْرُكونَ الجُمُعاتِ."],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"حسن","takhrij":"أخرجه أحمد (17318) واللفظ له، وأبو يعلى (1746)، والطبراني (17/296) (816)","bab":"قرآن › النهي عن اتباع متشابه القرآن والاختلاف فيه","dorar":"qqhj7Eht"},{"id":"س-02795","fp":"1919a3219118","stateId":222,"easy":"إذا أبغضت الأنصار ← فهي آية النفاق","cause":"بُغْضُ الأنصارِ","result":"آيةُ النِّفاقِ","explicit":true,"star":true,"similar":["س-08337","س-02788"],"ref":"تخريج المسند لشعيب 13607","srcLabel":"متفق عليه","text":[["آيةُ النِّفاقِ",2]," ",["بُغْضُ الأنصارِ",1],"، وآيةُ الإيمانِ حُبُّ الأنصارِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (17)، ومسلم (74)، والنسائي (5019)، وأحمد (13607) واللفظ له","bab":"إيمان › النفاق","dorar":"5hol09Og"},{"id":"س-08337","fp":"8af5327390b0","stateId":222,"easy":"إذا أبغضت الأنصار ← فهو آية النفاق","cause":"بُغضُ الأنصارِ","result":"وآيةُ المنافقِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-02795","ref":"عمدة القاري 16/95","text":["أنه صلَّى اللهُ عليهِ وسلَّمَ قال آيةُ الإيمانِ حبُّ الأنصارِ ",["وآيةُ المنافقِ",2]," ",["بُغضُ الأنصارِ",1]],"grade":"صحيح","muhaddith":"صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"aVzlKEJr","merged":3,"otherRefs":["صحيح الجامع 3123 (صحيح)","صحيح مسلم 74 (صحيح)"]},{"id":"س-03181","fp":"c1f5c3a32c7a","stateId":222,"easy":"إذا أبغضت العرب ← فهو كفر (على رواية)","cause":"وبغضُّ العربِ","result":"كفرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"similar":["س-08448"],"ref":"حلية الأولياء 2/378","srcLabel":"البزار","text":["حبُّ العربِ إيمانٌ ، ",["وبغضُّ العربِ",1]," ",["كفرٌ",2]," ، فمن أحبَّ العربَ فقد أحبَّني ، ومن أبغضَ العربَ فقد أبغضني"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت عن أنس تفرد به الهيثم بن جماز","takhrij":"أخرجه البزار (6997) بنحوه، والعقيلي في ((الضعفاء الكبير)) (4/355) باختلاف يسير، وأبو نعيم في ((حلية الأولياء)) (2/333) واللفظ له","bab":"إيمان › حب الرسول","dorar":"EboA4xY3"},{"id":"س-05396","fp":"f993b44b1341","stateId":222,"easy":"إذا أبغضت النبي ﷺ ← تفارق دينك","cause":"لا تُبْغِضْني","result":"فتُفارِقَ دِينَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 7190","srcLabel":"الترمذي","text":["قالَ لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا سَلْمانُ، ",["لا تُبْغِضْني",1]," ",["فتُفارِقَ دِينَكَ",2],"، فقلْتُ: يا رسولَ اللهِ، وكيف أُبْغِضُكَ وبكَ هَدَاني اللهُ عزَّ وجلَّ؟! قالَ: تُبْغِضُ العَرَبَ فتُبْغِضُنِي."],"grade":"صحيح","narrator":"سلمان","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3927)، وأحمد (23731) بلفظه.","bab":"رقائق وزهد › الحب في الله","dorar":"5qUt9JL3"},{"id":"س-02788","fp":"dfe1d6247b65","stateId":222,"easy":"إذا أبغضت الأنصار ← فهو نفاق","cause":"وبُغْضُهم","result":"نِفاقٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02795","ref":"الرسالة الوازعة للمعتدين 371","text":["حُبُّ الأنْصارِ إيمانٌ، ",["وبُغْضُهم",1]," ",["نِفاقٌ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح رجاله رجال الصحيح إلَّا أفلح مولى أبي أيوب وقد وثقه ابن سعد","takhrij":"أخرجه أحمد (11686)، ومحمد بن نصر المروزي في ((تعظيم قدر الصلاة)) (480) كلاهما بلفظه، ومسلم (77) بمعناه.","bab":"إيمان › النفاق","dorar":"VKGNaACa","merged":2,"otherRefs":["المستدرك على الصحيحين 7193 (صحيح)"]},{"id":"س-08447","fp":"73b2387206b0","stateId":222,"easy":"إذا أبغضت بني هاشم والأنصار ← فهو كفر (على رواية)","cause":"بُغضُ بني هاشمٍ والأنصارِ","result":"كفرٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"ref":"محجة القرب 228","srcLabel":"الطبراني","text":[["بُغضُ بني هاشمٍ والأنصارِ",1]," ",["كفرٌ",2]," وبُغضُ العربِ نفاقٌ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/146) (11312)","bab":"نفاق › علامة المنافق وصفاته","dorar":"8P4Z2CbZ"},{"id":"س-08448","fp":"e2a392d11f05","stateId":222,"easy":"إذا أبغضت العرب ← فهو نفاق (على رواية)","cause":"وبُغضُ العربِ","result":"نفاقٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-03181","ref":"محجة القرب 228","text":["بُغضُ بني هاشمٍ والأنصارِ كفرٌ ",["وبُغضُ العربِ",1]," ",["نفاقٌ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/146) (11312)","bab":"نفاق › علامة المنافق وصفاته","dorar":"8P4Z2CbZ"}]}