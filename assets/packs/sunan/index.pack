0592","fp":"17777788041d","stateId":12,"easy":"إيفاء المكيال والميزان بالقسط ← بقية الله خير (البركة في الحلال)"},{"id":"س-07065","fp":"37bac245401a","stateId":13,"easy":"إذا اقتنيت الغنم ← ففيها بركة"},{"id":"س-08422","fp":"a45b78a8c861","stateId":14,"easy":"إذا أخذت المال بنفس سخية ← يُبارك لك فيه"},{"id":"س-07330","fp":"6cb9324f2d79","stateId":14,"easy":"إذا كان المال الصالح بيد الرجل الصالح ← فنِعمّا هو"},{"id":"س-05546","fp":"0bce4f976416","stateId":14,"easy":"إذا أعطيت من مالك المسكين واليتيم وابن السبيل ← فنعم الصاحب هو لك"},{"id":"س-07326","fp":"07a4e15e0cb2","stateId":14,"easy":"إذا أخذت المال بحقه وأنفقته في سبيل الله وعلى اليتامى والمساكين ← فنعم الصاحب هو للمسلم"},{"id":"س-02315","fp":"f07bc72d423e","stateId":15,"easy":"إذا وصل القوم أرحامهم ← تعمر ديارهم وتنمو أموالهم"},{"id":"س-03462","fp":"3cb5b6d3a9fb","stateId":17,"easy":"إذا رُزقت الشكر ← لا تُحرم الزيادة"},{"id":"س-03783","fp":"4d8f90fb694d","stateId":18,"easy":"إذا أحسنت إلى الضعفاء ← فبهم تُنصر وتُرزق"},{"id":"س-03799","fp":"160b904061ce","stateId":18,"easy":"إذا كنت مع كبار السن وأهل الفضل ← تكون معك البركة"},{"id":"س-06361","fp":"4db7ef2e863c","stateId":19,"easy":"إذا أنفقت ← فلا تخف من ذي العرش إقتاراً"},{"id":"س-04923","fp":"4219616ab407","stateId":20,"easy":"إذا أخذت أموال الناس تريد أداءها ← يؤدّيها الله عنك"},{"id":"س-07108","fp":"53bf43e6a90a","stateId":20,"easy":"إذا دعوت بدعاء «اللهم مالك الملك...» ← يقضي الله دينك ولو كان مثل جبل"},{"id":"س-07113","fp":"714aefe57edb","stateId":20,"easy":"إذا دعوت «اللهم اكفني بحلالك عن حرامك وأغنني بفضلك عمن سواك» ← يقضي الله دينك ولو كان مثل جبل"},{"id":"س-03757","fp":"f742caba1ee3","stateId":20,"easy":"إذا استدنت لحاجة مشروعة ← فالله مع المدين حتى يقضي دينه"},{"id":"س-07833","fp":"e3c1a83920ab","stateId":21,"easy":"إذا مت وعليك دين ← لا تُترك بلا قضاء (والنبي ﷺ يمتنع من الصلاة على المدين)"},{"id":"س-04156","fp":"ea07d2c83acf","stateId":21,"easy":"إذا مت وعليك دين ← تكون مأسوراً به عن الجنة حتى يُفدى"},{"id":"س-07844","fp":"4ee883fbfdbb","stateId":21