83","fp":"c531358b7890","stateId":514,"easy":"إذا صليت ركعتين من الضحى ← تجزئ عن صدقات مفاصلك كلها"},{"id":"س-05620","fp":"1f0fc1cd6ff6","stateId":514,"easy":"إذا صليت الركعتين عند طلوع الفجر ← فهما أحب إلى النبي ﷺ من الدنيا جميعاً"},{"id":"س-07601","fp":"e1e0d4ffe735","stateId":515,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من ألف صلاة فيما سواه إلا المسجد الحرام"},{"id":"س-06716","fp":"e836902b6e51","stateId":516,"easy":"إذا صليت العشاء في جماعة ← فهو كقيام نصف ليلة"},{"id":"س-00100","fp":"bda816777dcc","stateId":518,"easy":"إذا صليت ثم قعدت في مصلاك تنتظر الصلاة ← فأنت في صلاة"},{"id":"س-06647","fp":"4a4644934e5f","stateId":518,"easy":"إذا صليت في جماعة ← تعدل خمساً وعشرين صلاة فرد"},{"id":"س-01456","fp":"61bf3a8d6051","stateId":518,"easy":"إذا أحسنت الوضوء ثم ذهبت فوجدت الناس قد صلوا ← يعطيك الله مثل أجر من حضرها"},{"id":"س-05906","fp":"4d1b7f4d9a6f","stateId":519,"easy":"إذا قرأت «قل هو الله أحد» ← فهي ثلث القرآن"},{"id":"س-02062","fp":"1a7e1cf6c667","stateId":519,"easy":"إذا فاتك حزبك من الليل فقرأته بين الفجر والظهر ← فكأنما قرأته من ليلتك"},{"id":"س-07646","fp":"48eb329b6020","stateId":519,"easy":"إذا قرأت الإخلاص والمعوذتين ← فكأنك قرأت ثلث القرآن"},{"id":"س-07815","fp":"873b5ad133b0","stateId":519,"easy":"إذا غدوت إلى المسجد فتعلمت أو قرأت آيتين ← فهو خير لك من ناقتين وكل آية خير من ناقة"},{"id":"س-07125","fp":"2eb893d1519f","stateId":520,"easy":"إذا تصدقت بدرهم من درهمين ← سبق درهمك مئة ألف درهم"},{"id":"س-00924","fp":"97b30ec5a0f4","stateId":520,"easy":"إذا منحت منيحة ورق أو لبن أو هديت طريقاً ← فهو كعتق نسمة"},{"id":"س-01054","fp":"99ea6554e919","stateId":520,"easy":"إذا منحت منيحة ورق أو هديت طريقاً أو سقيت لبناً ← فلك عدل رقبة"},{"id":"س-01952","fp":"dc4bdb4e5e3e","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فهو صيام الدهر"},{"id":"س-06740","fp":"0ae91bf87a07","stateId":521,"easy":"إذا صمت رمضان ثم ستة من شوال ← فكأنما صمت الدهر"},{"id":"س-00546","fp":"32b86a094488","stateId":521,"easy":"إذا صمت رمضان وستاً بعده ← فذلك صيام السنة"},{"id":"س-06747","fp":"d0bc183eba65","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فقد صمت الشهر كله"},{"id":"س-06745","fp":"4a1c66cfdf55","stateId":521,"easy":"إذا صمت رمضان وثلاثة أيام من كل شهر ← فهو صوم الدهر"},{"id":"س-07528","fp":"1d6b92c64d8a","stateId":522,"easy":"إذا اعتمرت في رمضان ← تعدل حجة مع النبي ﷺ"},{"id":"س-02240","fp":"31e6cce7b3cb","stateId":522,"easy":"إذا اعتمرت في رمضان ← فهي كحجة"},{"id":"س-04462","fp":"6bb287ef72f6","stateId":523,"easy":"إذا حجّت المرأة ← فهو جهادها"},{"id":"س-02012","fp":"89bcc4d64db7","stateId":524,"easy":"إذا وقفت في الصف في سبيل الله ← فهو أفضل من عبادة ستين سنة"},{"id":"س-07141","fp":"d9d66240c62e","stateId":524,"easy":"إذا أنفقت على الخيل (في سبيل الله) ← فأنت كالباسط يده بالصدقة"},{"id":"س-04317","fp":"5d1e6825e022","stateId":524,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير من الدنيا وما فيها"},{"id":"س-04526","fp":"008a37386154","stateId":524,"easy":"إذا سألت الله الشهادة بصدق ← يبلغك منازل الشهداء ولو مت على فراشك"},{"id":"س-04646","fp":"5fae379e5d5c","stateId":524,"easy":"إذا رابطت يوماً وليلة ← فهو كصيام شهر وقيامه"},{"id":"س-06800","fp":"c1fd749b9617","stateId":524,"easy":"إذا رميت بسهم في سبيل الله ← فهو عدل محرَّر"},{"id":"س-01734","fp":"dc3c619ad962","stateId":524,"easy":"إذا رميت رمية في سبيل الله قصّرت أو بلغت ← فلك مثل أجر عتق أربعة من ولد إسماعيل"},{"id":"س-02058","fp":"3ff4fc8b519b","stateId":525,"easy":"إذا كان والداك حيين ← ففيهما فجاهد"},{"id":"س-07229","fp":"633d6b5e4ecf","stateId":525,"easy":"إذا اجتهدت في بر أمك فرضيت عنك ← فأنت حاج ومعتمر ومجاهد"},{"id":"س-01290","fp":"d86fc67858fa","stateId":526,"easy":"إذا صليت ركعتين وأنت متزوج ← فهما خير من سبعين ركعة لغير المتزوج"},{"id":"س-07184","fp":"7dacf885dd9c","stateId":527,"easy":"إذا وقع الطاعون في بلدك فمكثت صابراً محتسباً ← فلك مثل أجر شهيد"},{"id":"س-05684","fp":"b08b95fcae8b","stateId":527,"easy":"إذا صبرت على أذى (الأمير أو البلاء) ← فأنت كالمجاهد في سبيل الله"},{"id":"س-06752","fp":"ae1f849df924","stateId":528,"easy":"إذا سعيت على الأرملة والمسكين