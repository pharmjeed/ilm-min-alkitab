اص والمعوذتين ثلاثاً، وقل «بسم الله الذي لا يضر مع اسمه شيء» ثلاثاً، و«أعوذ بكلمات الله التامات من شر ما خلق» مساءً، وآية الكرسي وأول غافر.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","أذكار الصباح","أذكار المساء","ورد"],"itemIds":["س-00665","س-01160","س-00895","س-01041","س-00662","س-00676","س-02535","س-00659","س-00663","س-00675","س-01010","س-00829","س-00917","س-00918","س-03591"],"memberIds":["س-02536","س-03242","س-01016","س-01017","س-01044"],"counts":{"items":20,"guide":15,"stars":3,"quran":0,"sunnah":20},"chunk":"need-31.json"},{"id":340,"needId":31,"title":"أذكار النوم للحفظ","summary":"انفض فراشك ثلاثاً، واقرأ آية الكرسي وآخر البقرة وسورة من القرآن، وقل «باسمك ربي وضعت جنبي… إن أحييتها فاحفظها».","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","أذكار النوم","قبل النوم","فراش","كوابيس"],"itemIds":["س-00790","س-00994","س-00789","س-00794","س-03737","س-06406","س-07650","س-08160","س-01120","س-03243","س-03613","س-08147","س-00795"],"memberIds":["س-02509","س-02518","س-08131","س-00788"],"counts":{"items":17,"guide":13,"stars":2,"quran":0,"sunnah":17},"chunk":"need-31.json"},{"id":341,"needId":31,"title":"أريد تحصين بيتي (الذكر عند دخوله، والبقرة وآية الكرسي فيه)","summary":"اذكر الله إذا دخلت بيتك يخرج الشيطان، واقرأ فيه سورة البقرة وآية الكرسي وخواتيم البقرة فلا يقربه شيطان، وصلّ ركعتين إذا دخلت.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","تحصين البيت","بيت مسكون","جن في البيت","سورة البقرة","آية الكرسي","تحصين الأطفال"],"itemIds":["س-07813","س-02306","س-07804","س-04098","س-00613","س-00614","س-00797","س-00798","س-00781","س-01722","س-02545","س-02533"],"memberIds":["س-03618","س-00709","س-02548","س-02555","س-03581"],"counts":{"items":17,"guide":12,"stars":1,"quran":0,"sunnah":17},"chunk":"need-31.json"},{"id":342,"needId":31,"title":"أغلق الأبواب وأغطّي الآنية وأطفئ السراج ليلاً","summary":"أغلقوا الأبواب واذكروا اسم الله، وأوكوا الأسقية، وخمّروا الآنية، وأطفئوا المصابيح؛ فإن الشيطان لا يفتح غلقاً.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","قبل النوم","الأبواب","حريق","نار","ليل"],"itemIds":["س-02501","س-02515","س-05829","س-02549","س-04087","س-02560"],"memberIds":["س-04084","س-02516","س-02537","س-04078","س-04085"],"counts":{"items":11,"guide":6,"stars":1,"quran":0,"sunnah":11},"chunk":"need-31.json"},{"id":343,"needId":31,"title":"أريد تحصين أولادي (عند المغرب، وعند الجماع، وبالتعويذ)","summary":"كفّوا صبيانكم إذا غربت الشمس وجنح الليل، وقل عند إتيان أهلك «بسم الله اللهم جنّبنا الشيطان»، وعوّذهم بكلمات الله التامة.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","تحصين الأطفال","أولاد","عيال","رقية الأطفال","المغرب","جماع","تحصين البيت","بيت مسكون","جن في البيت"],"itemIds":["س-05943","س-02502","س-01061","س-04092","س-05879","س-08272","س-05801"],"memberIds":["س-01352","س-04100"],"counts":{"items":9,"guide":7,"stars":1,"quran":0,"sunnah":9},"chunk":"need-31.json"},{"id":344,"needId":31,"title":"أريد حفظ طعامي من الشيطان (التسمية واللقمة الساقطة)","summary":"سمّ الله على طعامك، فإن نسيت فقل «بسم الله أوله وآخره»، وأمط الأذى عن اللقمة الساقطة وكُلها ولا تدعها للشيطان.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","أكل","تسمية","نسيت التسمية","طعام"],"itemIds":["س-04096","س-00800","س-07597","س-01610","س-00799","س-00885","س-02552"],"memberIds":["س-05814","س-02558","س-01042"],"counts":{"items":10,"guide":7,"stars":2,"quran":0,"sunnah":10},"chunk":"need-31.json"},{"id":345,"needId":31,"title":"أريد الحفظ في سفري","summary":"إذا نزلت منزلاً فقل «أعوذ بكلمات الله التامات من شر ما خلق»، واستودع من تخلّف، وكبّر على كل شرف، ولا تسافر وحدك.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","سفر","دعاء السفر","رحلة","طريق","مسافر","وداع"],"itemIds":["س-07584","س-01165","س-03237","س-00973","س-06238","س-03691","س-06237","س-03689","س-06236","س-07449"],"memberIds":["س-00972","س-07565"],"count