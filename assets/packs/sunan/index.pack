"counts":{"items":12,"guide":9,"stars":1,"quran":0,"sunnah":12},"chunk":"need-31.json"},{"id":350,"needId":31,"title":"أريد دفع البلاء بالصدقة وصنائع المعروف والزكاة","summary":"صنائع المعروف تقي مصارع السوء، ومناولة المسكين تقي ميتة السوء، وحصّنوا أموالكم بالزكاة، ومن كسا مسلماً كان في حفظ الله.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","صدقة","معروف","زكاة","ميتة السوء"],"itemIds":["س-05782","س-06398","س-02022","س-06168","س-06284","س-04712"],"memberIds":["س-01999","س-06865","س-06279"],"counts":{"items":9,"guide":6,"stars":0,"quran":0,"sunnah":9},"chunk":"need-31.json"},{"id":351,"needId":31,"title":"أريد أن أكون في ذمة الله (صلاة الصبح وآية الكرسي دبر الصلاة)","summary":"من صلّى الصبح في جماعة فهو في ذمة الله، ومن قرأ آية الكرسي دبر كل صلاة حُفظ إلى الصلاة الأخرى.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","صلاة الفجر","ذمة الله","آية الكرسي","بعد الصلاة"],"itemIds":["س-06563","س-02456","س-02418","س-07801"],"memberIds":["س-06609","س-05036","س-06520","س-06565","س-01067"],"counts":{"items":9,"guide":4,"stars":1,"quran":0,"sunnah":9},"chunk":"need-31.json"},{"id":352,"needId":31,"title":"أذكار مواقف بعينها (الريح والحريق ورؤية المبتلى والنعمة)","summary":"لا تسبّوا الريح وسلوا الله خيرها، وإذا رأيتم الحريق فكبّروا، ومن رأى مبتلى فقال «الحمد لله الذي عافاني مما ابتلاك به» عوفي منه، ومن قال على نعمته «ما شاء الله لا قوة إلا بالله» لم يرَ فيها آفة دون الموت.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","ريح","عاصفة","غبار","حريق","خسوف","رؤية مبتلى","ما شاء الله","دعاء رؤية المبتلى"],"itemIds":["س-03659","س-00872","س-02847","س-00832","س-00935","س-03594","س-03633"],"counts":{"items":7,"guide":7,"stars":1,"quran":0,"sunnah":7},"chunk":"need-31.json"},{"id":353,"needId":31,"title":"أريد دفع البلاء بحفظ الله وتقواه والاستغفار ولزوم الجماعة","summary":"احفظ الله يحفظك، وما كان الله معذّبهم وهم يستغفرون، ولا يهلك القرى وأهلها مصلحون، ودعوة المسلمين تحيط بمن لزم جماعتهم.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","تقوى","استغفار","حفظ","جماعة"],"itemIds":["س-06014","س-00127","ق-0340","ق-0460","ق-0603","ق-0999","ق-1272","س-04428","س-06308","س-05638","س-06116","س-00619","س-00938","س-07735"],"memberIds":["س-04743"],"counts":{"items":15,"guide":14,"stars":2,"quran":5,"sunnah":10},"chunk":"need-31.json"},{"id":354,"needId":32,"title":"تأتيني وسوسة في الإيمان («من خلق الله؟»)","summary":"إذا قال لك الشيطان: من خلق ربك؟ فاستعذ بالله وانتهِ وقل: آمنت بالله ورسله، واحمد الله الذي ردّ كيده إلى الوسوسة.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","وسواس قهري","شكوك","أفكار","من خلق الله","خواطر","وسواس في الصلاة","وسواس الطهارة","أفكار سيئة","وسواس في العقيدة"],"itemIds":["س-02505","س-02528","س-02541","س-02512","س-08155","س-04105"],"memberIds":["س-02803"],"counts":{"items":7,"guide":6,"stars":1,"quran":0,"sunnah":7},"chunk":"need-32.json"},{"id":355,"needId":32,"title":"تأتيني وسوسة في صلاتي ووضوئي","summary":"إذا لبّس عليك الشيطان صلاتك فتعوّذ واتفل عن يسارك ثلاثاً، ولا تنصرف حتى تسمع صوتاً أو تجد ريحاً، وانتضح بعد الوضوء.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","وسواس الصلاة","وسواس الوضوء","وسواس الطهارة","شك في الصلاة","سهو","خنزب","وسواس قهري","وسواس في الصلاة","أفكار سيئة"],"itemIds":["س-02534","س-02544","س-02498","س-02500","س-01487","س-01424","س-01486"],"memberIds":["س-04102"],"counts":{"items":8,"guide":7,"stars":0,"quran":0,"sunnah":8},"chunk":"need-32.json"},{"id":356,"needId":32,"title":"يُطرد الشيطان بالأذان وتسوية الصفوف","summary":"إذا نودي بالصلاة أدبر الشيطان، وإذا رأيت ما يخيفك فأذّن، وتراصّوا في الصفوف لا يتخللكم الشيطان.","keywords":["وسواس","وسوسة","شيطان","جن","مس","حماية","تحصين","أمان","خوف","حوادث","أذان","صفوف","مسجد","صوت مخيف"],"itemIds":["س-01515","س-01518","س-02517","س-06672","س-06668","س-06678","س-04104","س-01514","س-02710"],"memberIds":["س-06666","س-01495","س-01498","س-01509"