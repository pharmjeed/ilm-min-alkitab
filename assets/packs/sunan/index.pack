-46.json"},{"id":474,"needId":46,"title":"أحب العمل: أدومه وإن قل، والعمل في عشر ذي الحجة","summary":"أحب العمل إلى الله أدومه وإن قلّ، ولا عمل أفضل من العمل الصالح في عشر ذي الحجة.","keywords":["أجر","حسنات","ثواب","فضل"],"itemIds":["س-07765","س-02226","س-02192","س-02133"],"memberIds":["س-01991","س-06727","س-02092","س-04431"],"counts":{"items":8,"guide":4,"stars":1,"quran":0,"sunnah":8},"chunk":"need-46.json"},{"id":475,"needId":47,"title":"بالتوحيد والإيمان","summary":"الذين إذا ذُكر الله وجلت قلوبهم وأقاموا الصلاة لهم درجات عند ربهم.","keywords":["إيمان","يقين","ضعف إيمان","أجر","حسنات","ثواب","فضل"],"itemIds":["ق-0450","ق-0770","ق-1302","س-03196"],"counts":{"items":4,"guide":4,"stars":2,"quran":3,"sunnah":1},"chunk":"need-47.json"},{"id":476,"needId":47,"title":"بالذكر والتسبيح والتحميد","summary":"سبّح واحمد وكبّر دبر كل صلاة ثلاثاً وثلاثين؛ تدرك من سبقك وتسبق من بعدك.","keywords":["أجر","حسنات","ثواب","فضل","أذكار","تسبيح","ذكر"],"itemIds":["س-00878","س-01022","س-00979","س-00860","س-00943","س-01058","س-01078","س-00879","س-00882","س-01116","س-01248","س-01210","س-07247","س-08180","س-01032"],"memberIds":["س-06413","س-01109","س-00741","س-00894","س-01011","س-01037","س-07173"],"counts":{"items":22,"guide":15,"stars":4,"quran":0,"sunnah":22},"chunk":"need-47.json"},{"id":477,"needId":47,"title":"بالدعاء والاستغفار والصلاة على النبي ﷺ","summary":"استعذ بالله من عذاب القبر وعذاب النار. سيد الاستغفار: «اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك…» من قالها موقناً فمات دخل الجنة. من صلى على النبي ﷺ واحدة رفعه الله بها عشر درجات.","keywords":["دعاء","استجابة","طلب","أمنية","أجر","حسنات","ثواب","فضل","ذنب","ذنوب","معصية","توبة","استغفار","ندم","غلطت","صلاة","خشوع","صلوات"],"itemIds":["س-00672","س-00827","س-00834","س-02312"],"memberIds":["س-04694"],"counts":{"items":5,"guide":4,"stars":3,"quran":0,"sunnah":5},"chunk":"need-47.json"},{"id":478,"needId":47,"title":"بالصلاة والقيام والنوافل","summary":"أكثر من السجود؛ فإنك لا تسجد لله سجدة إلا رفعك بها درجة، وصلِّ الضحى والو