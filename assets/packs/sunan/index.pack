لمة طيبة ← فهي صدقة"},{"id":"ق-0098","fp":"66defda5c953","stateId":455,"easy":"القول المعروف والمغفرة للسائل ← خير من صدقة يتبعها أذى"},{"id":"س-02351","fp":"1ad120ffd226","stateId":456,"easy":"إذا دعوت إلى هدى ← لك مثل أجور من تبعك لا ينقص من أجورهم شيء"},{"id":"س-05075","fp":"cd5e9c1fb00c","stateId":456,"easy":"إذا سننت في الإسلام سنة حسنة فعُمل بها ← لك أجرها وأجر من عمل بها بعدك"},{"id":"ق-0277","fp":"a8c839aa951a","stateId":456,"easy":"الرسوخ في العلم والإيمان وإقامة الصلاة وإيتاء الزكاة ← أجر عظيم"},{"id":"س-07085","fp":"fefddbd110ac","stateId":456,"easy":"إذا تعلمت العلم ← فتعليمه حسنة وطلبه عبادة ومذاكرته تسبيح"},{"id":"س-02098","fp":"c75c76d990ee","stateId":457,"easy":"إذا تحاب رجلان ← فأفضلهما أشدهما حباً لصاحبه"},{"id":"ق-0033","fp":"ec9c52431fbe","stateId":458,"easy":"الإيمان والتقوى ← مثوبة من عند الله خير"},{"id":"ق-0073","fp":"db53b545e6c4","stateId":458,"easy":"فعل الخير والتزود بالتقوى ← يعلمه الله ويجازي به، وخير الزاد التقوى"},{"id":"ق-0192","fp":"b29c91bda6ea","stateId":458,"easy":"الإيمان والتقوى ← أجر عظيم"},{"id":"ق-1158","fp":"93ba5067380b","stateId":458,"easy":"الإيمان والتوكل واجتناب الكبائر والفواحش والمغفرة عند الغضب والاستجابة لله وإقامة الصلاة والشورى والإنفاق ← ما عند الله خير وأبقى"},{"id":"س-00149","fp":"048c3ec0d6da","stateId":459,"easy":"إذا سلّمت على مجلس ذكر ← تكون شريكهم فيما يصيبون"},{"id":"س-00151","fp":"99f24efee32b","stateId":459,"easy":"إذا بدأت القوم بالسلام ← يكون لك الأجر"},{"id":"س-07347","fp":"21312db3a1a6","stateId":459,"easy":"إذا سلّمت على أخيك فرد عليك ← اشتركتما في الأجر"},{"id":"س-00957","fp":"e293d9f86277","stateId":459,"easy":"إذا سلّمت على عباد الله ← فهو صدقة"},{"id":"س-00160","fp":"62885e3230bc","stateId":459,"easy":"إذا سبقت إلى السلام ← تنال فضل القوم"},{"id":"س-03674","fp":"4a658badab0e","stateId":460,"easy":"إذا أمرت بتقوى الله وعدلت (وأنت إمام) ← فلك بذلك أجر"},{"id":"س-00235","fp":"46ec0cadaa78","stateId":460,"easy":"إذا عدلت بين اثنين ← فهو صدقة"},{"id":"س-02886","fp":"ae0b6d84e3fa","stateId":460,"easy":"إذا حكمت فاجتهدت فأصبت ← فلك أجران، وإن أخطأت فأجر"},{"id":"س-01825","fp":"101097de9c3b","stateId":461,"easy":"إذا عملت بيدك ونصحت ← فهو خير الكسب"},{"id":"س-04032","fp":"fb35a14184d4","stateId":462,"easy":"إذا أحسنت إسلامك ← تُكتب كل حسنة تعملها بعشر أمثالها إلى سبعمئة ضعف"},{"id":"س-04033","fp":"4e24b0b7e3cf","stateId":462,"easy":"إذا أسلمت فحسن إسلامك ← يكتب الله لك كل حسنة قدمتها ويمحو كل سيئة"},{"id":"س-02353","fp":"0d4ecf4bebe3","stateId":462,"easy":"إذا هممت بحسنة ← تُكتب لك حسنة"},{"id":"س-02152","fp":"ac74c1ecd7c7","stateId":462,"easy":"إذا هممت بسيئة فلم تعملها ← يكتبها الله حسنة كاملة"},{"id":"س-02132","fp":"b5e41e004d04","stateId":462,"easy":"إذا هممت بسيئة فتركتها ← تُكتب لك حسنة"},{"id":"س-02151","fp":"917c4183df4d","stateId":462,"easy":"إذا هممت بها فعملتها ← يكتبها الله عشر حسنات إلى سبعمئة ضعف"},{"id":"س-07575","fp":"88ddc04a6ea5","stateId":463,"easy":"إذا تكلفت من الأعمال ما تطيق ← فالله لا يمل حتى تملّوا"},{"id":"ق-0259","fp":"fd500b95f1fa","stateId":464,"easy":"طلب الثواب من الله ← ثواب الدنيا والآخرة عنده"},{"id":"ق-1148","fp":"97261414464f","stateId":464,"easy":"إرادة حرث الآخرة ← الزيادة في الحرث"},{"id":"س-01907","fp":"6cc99b16ac19","stateId":465,"easy":"إذا عملت الخير ولو بعيداً ← لن يضيع الله من عملك شيئاً"},{"id":"ق-0053","fp":"86a269cf721e","stateId":465,"easy":"التطوع بالخير ← شكر الله له"},{"id":"ق-0254","fp":"fea48c70fcee","stateId":465,"easy":"فعل الخير ← يعلمه الله ويجازي به"},{"id":"س-06031","fp":"7ecdba4524b7","stateId":466,"easy":"إذا عملت صالحاً في أيام الفتن والغربة ← فلك أجر خمسين رجلاً يعملون مثلك"},{"id":"س-04542","fp":"93036d12e201","stateId":467,"easy":"إذا آمنت بلا شك وجاهدت بلا غلول وحججت حجة مبرورة ← فهي أفضل الأعمال"},{"id":"س-06468","fp":"81f4ead61d95","stateId":468,"easy":"إذا صليت في جوف الليل وصمت المحرم ← فهما أفضل الصلاة والصيام بعد الفريضة"},{"id":"س-07058","fp":"87533b371dd1","stateId":468,"easy":"إذا أطلت الركوع والسجود ← فهو خير الصلاة"},{"id":"س-08424","fp":"4ff73840ec1c","stateId":469,"easy":"إذا أعطيت ← فاليد العليا خير من اليد السفلى"},{"id":"س-07368","fp":"777a9f0be1fd","stateId":469,"easy":"إذا تصدقت عن ظهر غنى ← فهي خير الصدقة"},{"id":"س-07009","fp":"778de87c9a0f","stateId":470,"easy":"إذا صمت يوماً وأفطرت يوماً (صيام داود) ← فهو أفضل الصيام"},{"id":"س-01355","fp":"87ff6de2653a","stateId":470,"easy":"إذا صمت يوماً وأفطرت يوماً ← فهو أفضل الصيام"},{"id":"س-00668","fp":"7a6d474d2eaa","stateId":471,"easy":"إذا سألت ربك العفو والعافية في الدنيا والآخرة ← فهو أفضل الدعاء وقد أفلحت"},{"id":"س-04544","fp":"19e43daa5093","stateId":472,"easy":"إذا هجرت ما حرّم الله ← فهي أفضل الهجرة"},{"id":"س-04546","fp":"2b1483bf5a87","stateId":472,"easy":"إذا أُريق دمك وعُقر جوادك ← فهو أشرف القتل"},{"id":"س-02192","fp":"be4e0c081fee","stateId":474,"easy":"إذا عملت في أيام العشر ← فلا عمل أفضل منه"},{"id":"ق-0450","fp":"55a53a406520","stateId":475,"easy":"وجل القلب عند ذكر الله والتوكل وإقامة الصلاة والإنفاق ← الإيمان الحق ودرجات عند الله ومغفرة ورزق كريم"},{"id":"ق-0770","fp":"af9f3205ea4b","stateId":475,"easy":"إتيان الله مؤمناً قد عمل الصالحات (التزكّي) ← الدرجات العلى وجنات عدن"},{"id":"س-00878","fp":"92b1bdc66947","stateId":476,"easy":"إذا كبّرت أربعاً وثلاثين وسبّحت وحمدت ثلاثاً وثلاثين عند نومك ← فهو خير لك من خادم"},{"id":"س-01022","fp":"9bc87a230261","stateId":476,"easy":"إذا سبّحت وكبّرت وحمدت دبر كل صلاة ثلاثاً وثلاثين ← تدرك من سبقك وتسبق من بعدك"},{"id":"س-00979","fp":"88d35bed4eba","stateId":476,"easy":"إذا أكثرت ذكر الله ← تكون من المفرّدين السابقين"},{"id":"س-00860","fp":"6c0619b8506c","stateId":476,"easy":"إذا سبّحت مئة دبر كل صلاة ← تدرك من سبقك ولا يلحقك من بعدك"},{"id":"س-00672","fp":"82c9b87ad5fa","stateId":477,"easy":"إذا قلت «اللهم أنت ربي وأنا عبدك ظلمت نفسي واعترفت بذنبي...» ← فهو أوفق الدعاء"},{"id":"س-00827","fp":"cb4430a44519","stateId":477,"easy":"إذا سألت الله أن يعيذك من عذاب النار والقبر ← كان خيراً لك وأفضل"},{"id":"س-02312","fp":"e1fac966566d","stateId":477,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر خطيئات"},{"id":"س-03751","fp":"38be801208b8","stateId":478,"easy":"إذا صلّت المرأة في بيتها ← فبيتها خير لها"},{"id":"س-02277","fp":"5562aba6b838","stateId":478,"easy":"إذا صليت الضحى حين ترمض الفصال ← فهي صلاة الأوابين"},{"id":"س-07014","fp":"01a738779038","stateId":478,"easy":"إذا لم تنم حتى توتر ← فأنت حازم"},{"id":"س-04689","fp":"4a58d0a34ded","stateId":478,"easy":"إذا صليت من الليل ← تكون رجلاً صالحاً"},{"id":"س-08100","fp":"8868564f881c","stateId":479,"easy":"إذا أحسنت الوضوء وأتيت المسجد لا تريد إلا الصلاة ← تُرفع بكل خطوة درجة"},{"id":"س-06484","fp":"49b4002ff1dd","stateId":480,"easy":"إذا علمت فضل الصف المقدم ← لاستهمت عليه"},{"id":"س-06639","fp":"1be71de35c72","stateId":480,"easy":"إذا صليت في الصف المقدم ← فهو على مثل صف الملائكة"},{"id":"س-06635","fp":"eaedd1aa6ac2","stateId":481,"easy":"إذا علمت ما في الفجر والعشاء ← لأتيتهما ولو حبواً"},{"id":"س-06640","fp":"d03ea4b82779","stateId":481,"easy":"إذا صليت في جماعة ← تفضل صلاتك وحدك بأربع أو خمس وعشرين"},{"id":"س-08217","fp":"14c31992300c","stateId":481,"easy":"إذا شهدت الصلاة مع الجماعة ← تشهد لك الملائكة: جئناهم وهم يصلون وتركناهم وهم يصلون"},{"id":"س-01408","fp":"0fb2a5d9ca15","stateId":482,"easy":"إذا قمت إلى الصلاة (بعد الوضوء) ← يرفع الله درجتك وإن قعدت قعدت سالماً"},{"id":"س-08184","fp":"d37b9f9bb9e7","stateId":484,"easy":"إذا مهرت بالقرآن ← تكون مع السفرة الكرام البررة"},{"id":"س-07695","fp":"e957949017e5","stateId":484,"easy":"إذا زيّنت القرآن بصوتك ← فالصوت الحسن يزيد القرآن حسناً"},{"id":"س-02673","fp":"1d7314b47607","stateId":484,"easy":"إذا أعطاك الله القرآن فقمت به آناء الليل والنهار ← فهو مما يُتنافس فيه"},{"id":"س-07799","fp":"aaa4639adfab","stateId":484,"easy":"إذا أعطاك الله حفظ كتابه ← فلا تظن أن أحداً أُعطي أفضل منك"},{"id":"س-07168","fp":"e44b89a1932e","stateId":484,"easy":"إذا قرأت القرآن قراءة يُرى فيها أنك تخشى الله ← فأنت أحسن الناس صوتاً بالقرآن"},{"id":"س-01823","fp":"201279548bf2","stateId":485,"easy":"إذا أعطيت ← فاليد العليا أفضل من السفلى"},{"id":"س-01824","fp":"c0c0350cabb9","stateId":485,"easy":"إذا كان مالك صالحاً وأنت صالح ← فنعم المال"},{"id":"ق-1296","fp":"b12ce91338f6","stateId":485,"easy":"السبق بالإنفاق والجهاد وقت الشدة ← أعظم درجة"},{"id":"س-02674","fp":"a91860fab5b2","stateId":485,"easy":"إذا أعطاك الله مالاً فأنفقته وتصدقت ← فهو مما يُتنافس فيه"},{"id":"س-06760","fp":"0a1c20807261","stateId":486,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فهو صيام حسن"},{"id":"س-04365","fp":"db90bb450506","stateId":487,"easy":"إذا حجت المرأة حجاً مبروراً ← فهو أحسن جهادها"},{"id":"س-04398","fp":"4849616de5f7","stateId":487,"easy":"إذا حججت ← فهو أفضل جهاد للضعيف"},{"id":"س-04523","fp":"893c48d1c094","stateId":488,"easy":"إذا استُشهدت ← تتمنى أن تُقتل عشر مرات لما ترى من فضل الشهادة"},{"id":"س-06756","fp":"38f7e9b7ebb1","stateId":488,"easy":"إذا خرجت مجاهداً ← فلا عمل يعدل الجهاد"},{"id":"س-02614","fp":"1d2e83ffbfc9","stateId":488,"easy":"إذا جاهدت في سبيل الله ← فلها من الفضل كما بين السماء والأرض"},{"id":"س-07902","fp":"7797a1b0dc96","stateId":489,"easy":"إذا كتمت مصائبك ← فهو تمام البر"},{"id":"س-01870","fp":"d71aa36d3055","stateId":490,"easy":"إذا أعطيت عطيتك لأقاربك (أخوالك) ← فهو أعظم لأجرك"},{"id":"س-03784","fp":"23bfc2d75ee2","stateId":490,"easy":"إذا أكرمت يتيماً في بيتك ← فهو خير البيوت"},{"id":"س-07959","fp":"fc640cbae0fc","stateId":490,"easy":"إذا أمطت الأذى عن الطريق ← فهو من محاسن الأعمال"},{"id":"س-03798","fp":"702f7a8d4a54","stateId":490,"easy":"إذا أكرمت ذا الشيبة المسلم وحامل القرآن والسلطان العادل ← فهو من إجلال الله"},{"id":"س-00338","fp":"6f8a178082e0","stateId":491,"easy":"إذا حسن خلقك ← تبلغ درجة الصوم والصلاة"},{"id":"س-02300","fp":"283f06ff88c2","stateId":491,"easy":"إذا حسن خلقك ← تبلغ عظيم درجات الآخرة وشرف المنازل"},{"id":"س-03677","fp":"c0e6f931aae4","stateId":493,"easy":"إذا صدقت ← تُكتب عند الله صديقاً"},{"id":"س-00343","fp":"49e84db0e9df","stateId":493,"easy":"إذا لزمت الاقتصاد والتؤدة والسمت الحسن ← فهي جزء من أربعة وعشرين جزءاً من النبوة"},{"id":"ق-1312","fp":"7d06ea029189","stateId":494,"easy":"الإيمان والعلم ← رفع الدرجات"},{"id":"س-08429","fp":"a2c7b415a76d","stateId":495,"easy":"إذا آويت النبي ﷺ ونصرته ← فلك الجنة"},{"id":"ق-0080","fp":"aff7457ee511","stateId":496,"easy":"التقوى ← العلو فوق الكافرين يوم القيامة والرزق بغير حساب"},{"id":"ق-0184","fp":"75313459e791","stateId":496,"easy":"اتباع رضوان الله ← درجات عند الله"},{"id":"ق-1250","fp":"b1136f45dd13","stateId":496,"easy":"التقوى ← الكرامة عند الله"},{"id":"ق-1360","fp":"21bb88c1d5e0","stateId":496,"easy":"العفة والتصديق بكلمات الله والقنوت ← الاصطفاء والكرامة"},{"id":"س-05374","fp":"d31e3a9b422b","stateId":496,"easy":"إذا أحسنت الظن بالله ← فهو من عبادة الله"},{"id":"س-00136","fp":"5e67db0fbff7","stateId":497,"easy":"إذا بدأت بالسلام ← فأنت أفضل"},{"id":"س-00137","fp":"9dd3e31d1907","stateId":497,"easy":"إذا مررت بقوم فسلّمت عليهم فردوا ← لك عليهم فضل درجة لتذكيرك إياهم"},{"id":"س-00158","fp":"86c6a810ddf3","stateId":497,"easy":"إذا بدأت بالسلام ← تكون خير المتلاقيين"},{"id":"س-01858","fp":"43e7c6613252","stateId":498,"easy":"إذا أديت شهادتك قبل أن تُسألها ← تكون خير الشهداء"},{"id":"س-05994","fp":"62fa2391ca69","stateId":499,"easy":"إذا كنت كتابياً آمنت بنبيك ثم بمحمد ﷺ أو عبداً أدى حق الله ومواليه ← فلك أجرك مرتين"},{"id":"س-01277","fp":"5b5c38aadede","stateId":499,"easy":"إذا أعتقت جاريتك وتزوجتها ← فلك أجران"},{"id":"س-06777","fp":"507ce68a503d","stateId":499,"easy":"إذا كانت لك جارية فأحسنت إليها ثم أعتقتها وتزوجتها ← فلك أجران"},{"id":"س-04364","fp":"87fb850c122f","stateId":499,"easy":"إذا كنت عبداً مملوكاً مصلحاً ← فلك أجران"},{"id":"س-02168","fp":"926ca80800f9","stateId":499,"easy":"إذا أطعت الله وأديت حق سيدك ← فنعمّا لك"},{"id":"س-07291","fp":"d77a022bf33a","stateId":500,"easy":"إذا أخذت بالأيسر ← فخير دينكم أيسره"},{"id":"ق-0378","fp":"9a0befb77d5d","stateId":500,"easy":"العمل ← درجات بحسبه"},{"id":"س-00862","fp":"81a8d42ea8c5","stateId":501,"easy":"إذا طال عمرك في الإسلام تسبح وتكبر وتهلل ← فلا أحد أفضل عند الله منك"},{"id":"س-03297","fp":"fd47fa9458e3","stateId":501,"easy":"إذا شبت في الإسلام شيبة ← يرفعك الله بها درجة وتُمحى