اً، ومن أعطى واتقى وصدّق بالحسنى فسنيسّره لليسرى.","keywords":["معسّر","مسكّر","مقفلة","ورطة","مشكلة","حل","توفيق","نجاح"],"itemIds":["ق-0593","ق-1352","ق-1441","س-06170","س-03905","س-04779","س-05949","س-00193"],"counts":{"items":8,"guide":8,"stars":2,"quran":3,"sunnah":5},"chunk":"need-54.json"},{"id":578,"needId":54,"title":"أريد قضاء حاجتي (الدعاء، «إن شاء الله»، الصلاة، الكتمان)","summary":"قل «إن شاء الله» على عزمك، وتأنَّ، واسأل الله كل حاجتك، وصلِّ صلاة الحاجة.","keywords":["معسّر","مسكّر","مقفلة","ورطة","مشكلة","حل","توفيق","نجاح","دعاء","استجابة","طلب","أمنية","صلاة","خشوع","صلوات"],"itemIds":["س-01742","س-01730","س-01741","س-04093","س-05344","س-05952","س-00664","س-01176","س-04756","س-07210","س-01174","س-04417"],"memberIds":["س-01743","س-01733","س-00710"],"counts":{"items":15,"guide":12,"stars":3,"quran":0,"sunnah":15},"chunk":"need-54.json"},{"id":579,"needId":54,"title":"أريد الرشد والصواب في قراري","summary":"التؤدة في كل شيء خير، ومن لم يطلب القضاء ولم يستعن عليه أنزل الله عليه ملكاً يسدده.","keywords":["معسّر","مسكّر","مقفلة","ورطة","مشكلة","حل","توفيق","نجاح","استخارة","محتار","متردد في قرار"],"itemIds":["س-08219","س-05798","س-08141","س-05863","س-07140","س-05873","س-03746","س-05341"],"counts":{"items":8,"guide":8,"stars":2,"quran":0,"sunnah":8},"chunk":"need-54.json"},{"id":580,"needId":54,"title":"بالتيسير: قبول رخص الله والسماحة مع الناس","summary":"يسّر على المعسر ييسّر الله عليك، وافسح في المجلس يفسح الله لك. قصر الصلاة في السفر صدقة تصدّق الله بها عليكم فاقبلوا صدقته.","keywords":["معسّر","مسكّر","مقفلة","ورطة","مشكلة","حل","توفيق","نجاح","قبول","رياء","إخلاص","نية","صلاة","خشوع","صلوات","فوز","خسارة","ندم"],"itemIds":["س-01850","س-00379","س-07252","س-00280","س-00325","س-07588","س-02285"],"memberIds":["س-03925","س-02683"],"counts":{"items":9,"guide":7,"stars":3,"quran":0,"sunnah":9},"chunk":"need-54.json"},{"id":581,"needId":54,"title":"آداب السفر","summary":"عليكم بالدُّلجة (السفر ليلاً)؛ فإن الأرض تُطوى بالليل.","keywords":["معسّر","مسكّر","مقف