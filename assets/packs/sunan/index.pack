3","fp":"f806cc5750f8","stateId":109,"easy":"إذا أشركت أو قتلت أو فررت من الزحف أو قذفت ← فهي من الكبائر التسع"},{"id":"س-02777","fp":"042a11a5e28f","stateId":110,"easy":"إذا كنت ذا وجهين ← فلا تصلح أن تكون أميناً"},{"id":"س-07582","fp":"5ebeb8f5bb12","stateId":110,"easy":"إذا جادل المنافق العليم اللسان ← فهو أخوف ما يُخاف عليكم"},{"id":"س-06380","fp":"706201ec5191","stateId":111,"easy":"إذا سننت في الإسلام سيئة ← عليك وزرها ووزر من عمل بها بعدك"},{"id":"س-07990","fp":"6bf9ed673087","stateId":111,"easy":"إذا سننت القتل (كابن آدم الأول) ← عليك نصيب من كل نفس تُقتل ظلماً بعدك"},{"id":"س-03744","fp":"6db008318731","stateId":112,"easy":"إذا سألت عن أمر لم يُحرّم فحُرّم بسببك ← فأنت أعظم المسلمين جرماً"},{"id":"س-03754","fp":"b665741b2e9f","stateId":113,"easy":"إذا خرجت من المسجد بعد الأذان بلا عذر ← فقد عصيت النبي ﷺ"},{"id":"س-03713","fp":"8cd760be4559","stateId":113,"easy":"إذا دُعيت إلى الوليمة فلم تجب ← فقد عصيت الله ورسوله"},{"id":"س-06728","fp":"f8eb097a3e21","stateId":113,"easy":"إذا صمت يوم الشك ← فقد عصيت أبا القاسم ﷺ"},{"id":"س-01604","fp":"f0cd29bab717","stateId":113,"easy":"إذا تركت إجابة الدعوة ← فقد عصيت الله ورسوله"},{"id":"ق-0299","fp":"1a948e075566","stateId":114,"easy":"قتل نفس بغير حق ← كأنما قتل الناس جميعاً"},{"id":"س-03782","fp":"ac385d5f0503","stateId":115,"easy":"إذا أكلت حق الضعيفين (اليتيم والمرأة) ← وقعت في الحرج والإثم الشديد"},{"id":"س-06783","fp":"806824961afb","stateId":115,"easy":"إذا ضربت من تحت يدك ← فالله أقدر عليك منك عليه"},{"id":"ق-0062","fp":"cd0a80d9134d","stateId":115,"easy":"تبديل الوصية بعد سماعها ← الإثم على المبدِّل"},{"id":"س-08025","fp":"3a6c22c17118","stateId":119,"easy":"إذا ماطلت في سداد الدين وأنت غني ← فهو ظلم"},{"id":"س-02593","fp":"c1b86871c924","stateId":119,"easy":"إذا احتكرت ← فأنت خاطئ"},{"id":"س-04590","fp":"e231e13675df","stateId":119,"easy":"إذا سرقت من بيت جارك ← فهو أشد من السرقة من عشرة بيوت"},{"id":"س-01812","fp":"caaf35870737","stateId":119,"easy":"إذا جعلت في فمك ما حرّم الله ← فلأن تأكل تراباً خير لك"},{