"فجر","عشاء"],"remedy":{"needId":17,"stateId":164},"itemIds":["س-04958","س-06502","س-06580","س-06549","س-01543","س-02779","س-04071","س-04072","س-04803","س-05279","س-08449"],"memberIds":["س-06651","س-01541"],"counts":{"items":13,"guide":11,"stars":3,"quran":0,"sunnah":13},"chunk":"need-22.json"},{"id":216,"needId":22,"title":"خصال النفاق: الكذب والغدر وخلف الوعد والفجور","summary":"آية المنافق: إذا حدّث كذب، وإذا وعد أخلف، وإذا عاهد غدر، وإذا خاصم فجر.","keywords":["كلام","لسان","كذب","غيبة","نميمة","سب","كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":169},"itemIds":["س-08451","س-08453","س-08452","س-04437","ق-0516","س-04322","س-05437","س-02799","س-00401","س-02780","س-02782","س-03211","س-03886","س-04863","س-05426","س-02793","س-05285","س-05432","س-00573","س-02790","س-03937","س-05732"],"counts":{"items":22,"guide":22,"stars":5,"quran":1,"sunnah":21},"chunk":"need-22.json"},{"id":217,"needId":22,"title":"أعمال من أعمال الكفر: قتال المسلم والطعن في النسب والانتساب لغير الأب","summary":"قتال المسلم والطعن في النسب والنياحة والانتساب لغير الأب من خصال الكفر.","keywords":["كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":169},"itemIds":["س-02606","س-04829","س-00382","س-02604","س-04280","س-05027","س-01181","س-08056","س-02564","س-02565","س-02589","س-02596","س-05217","س-05235","س-02571"],"memberIds":["س-05071","س-02378"],"counts":{"items":17,"guide":15,"stars":4,"quran":0,"sunnah":17},"chunk":"need-22.json"},{"id":218,"needId":22,"title":"الكهانة والسحر والتنجيم","summary":"من أتى كاهناً أو عرّافاً فصدّقه، أو تعلّم السحر والتنجيم، فقد كفر بما أُنزل على محمد ﷺ.","keywords":["كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":162},"itemIds":["س-02704","س-02699","س-02519","س-05328","س-05079","س-02556","س-02700","س-05692"],"memberIds":["س-05696"],"counts":{"items":9,"guide":8,"stars":2,"quran":0,"sunnah":9},"chunk":"need-22.json"},{"id":219,"needId":22,"title":"موالاة الكفار وطاعة الخلق في معصية الله","summary":"لا تتولَّ أعداء الله، ولا ترضِ مخلوقاً بما يسخط الله.","keywords":["كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":173},"itemIds":["ق-0490","ق-1325","ق-0313","ق-0370","س-00366","س-05010","س-07999","س-03896","س-04861"],"counts":{"items":9,"guide":9,"stars":3,"quran":4,"sunnah":5},"chunk":"need-22.json"},{"id":220,"needId":22,"title":"الزنا والسرقة والخمر: ما يُنزع به الإيمان","summary":"الزنا وشرب الخمر وإتيان المرأة في دبرها تنزع الإيمان كما يُخلع القميص، فإذا أقلعت رجع إليك. السرقة والكسب الحرام ينزعان نور الإيمان من القلب. الزنا يرفع الإيمان عن صاحبه حتى يكون فوقه كالظلة. شرب الخمر وإدمانها ينزع الإيمان ويقسّي القلب.","keywords":["إيمان","يقين","ضعف إيمان","خمر","مسكرات","مخدرات","سكر","شهوة","نظر","علاقة محرمة","إباحية","كفر","شرك","نفاق","ردة","فلوس","فقر","ضيق مادي","ديون","دخل","راتب","وظيفة","شغل","تجارة","بزنس","خسارة","غلاء","هداية","ضياع","قسوة قلب","فتور","شك","ربا","فوائد","حرام","رشوة","غش","سرقة"],"remedy":{"needId":17,"stateId":172},"itemIds":["س-04588","س-00352","س-04592","س-05089","س-00353","س-02574","س-05232","س-04015","س-02561","س-04003","س-04884"],"memberIds":["س-00351","س-04011","س-03967","س-03999","س-07165"],"counts":{"items":16,"guide":11,"stars":5,"quran":0,"sunnah":16},"chunk":"need-22.json"},{"id":221,"needId":22,"title":"البدعة: التكذيب بالقدر والجدال في القرآن","summary":"التكذيب بالقدر والمراء في القرآن ومخالفة السنة رغبة عنها من أبواب الضلال.","keywords":["قرآن","حفظ","دراسة","علم","طلب علم","مذاكرة","كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":162},"itemIds":["س-07661","س-07772","س-03067","س-06454","س-02601","س-07663","س-07781"],"memberIds":["س-07779","س-07778"],"counts":{"items":9,"guide":7,"stars":2,"quran":0,"sunnah":9},"chunk":"need-22.json"},{"id":222,"needId":22,"title":"بغض النبي ﷺ والأنصار والعرب","summary":"بغض الأنصار علامة النفاق، وحبهم علامة الإيمان.","keywords":["كفر","شرك","نفاق","ردة"],"remedy":{"needId":17,"stateId":171},"itemIds":["س-02795","س-03181","س-05396","س-08447"],"memberIds":["س-08337","س-02788","س-08448"],"counts":{"items":7,"guide":4,"stars":1,"quran":0,"sunnah":7},"chunk":"need-22.json"},{"id":223,"needId":23,"title":"بالاستغفار والتوبة","summary":"إن الله يحب التوابين ويحب المتطهرين، ويحب الشاب التائب. إذا تبت فرح الله بتوبتك.","keywords":["ذنب","ذنوب","معصية","توبة","استغفار","ندم","غلطت","حب الله","رضا","قرب من الله"],"itemIds":["ق-0084","س-03984","س-06916","س-00582"],"memberIds":["س-06875"],"counts":{"items":5,"guide":4,"stars":2,"quran":1,"sunnah":4},"chunk":"need-23.json"},{"id":224,"needId":23,"title":"بالذكر والتسبيح والتحميد","summary":"أحب الكلام إلى الله: سبحان الله، والحمد لله، ولا إله إلا الله، والله أكبر.","keywords":["أذكار","تسبيح","ذكر","حب الله","رضا","قرب من الله"],"itemIds":["س-01100","س-00773","س-01114","س-01128","س-00803","س-01106","س-02263","س-00738","س-00910","س-01153","س-01180","س-04095"],"memberIds":["س-06932","س-00811","س-06981","س-00856","س-01048","س-01001"],"counts":{"items":18,"guide":12,"stars":3,"quran":0,"sunnah":18},"chunk":"need-23.json"},{"id":225,"needId":23,"title":"بالدعاء","summary":"الله يحب أن يُسأل؛ فسله العافية ومن فضله وألحّ في الدعاء. قل «لا إله إلا أنت، سبحانك، إني ظلمت نفسي فاغفر لي».","keywords":["دعاء","استجابة","طلب","أمنية","حب الله","رضا","قرب من الله"],"itemIds":["س-00681","س-00767","س-05663","س-03163","س-03128"],"counts":{"items":5,"guide":5,"stars":2,"quran":0,"sunnah":5},"chunk":"need-23.json"},{"id":226,"needId":23,"title":"بالصلاة والقيام والنوافل","summary":"أحب الأعمال إلى الله الصلاة على وقتها، والنافلة في البيت، والوتر، وقيام الليل. أحسن صلاتك في السر والعلانية، واجلس تنتظر الصلاة بعد الصلاة؛ يعجب ربك منك.","keywords":["صلاة","خشوع","صلوات","حب الله","رضا","قرب من الله","يفرح الله بي","يباهي بي الملائكة","يضحك الله إليه","يعجب ربك"],"itemIds":["س-06631","س-06690","س-03121","س-06909","س-06467","س-00009","س-00909","س-01480","س-06596","س-06882","س-05705","س-03879","س-03147","س-02851","س-06720","س-03103","س-06508"],"memberIds":["س-01004","س-03099","س-01236"],"counts":{"items":20,"guide":17,"stars":5,"quran":0,"sunnah":20},"chunk":"need-23.json"},{"id":227,"needId":23,"title":"بالطهارة والمساجد والجماعة","summary":"الصلاة في الجماعة، وكثرة الجمع، وسد الخلل في الصفوف يحبها الله. إن الله يحب المتطهرين، فأحسن الطهارة والاستنجاء. الزم المساجد للصلاة والذكر؛ يتبشبش الله لك كما يتبشبش أهل الغائب بغائبهم. السواك مطهرة للفم مرضاة للرب.","keywords":["حب الله","رضا","قرب من الله","مسجد","جماعة","أذان","جمعة","وضوء","طهارة","غسل","يفرح الله بي","يباهي بي الملائكة","يضحك الله إليه","يعجب ربك"],"itemIds":["س-06638","س-07059","س-08126","س-04820","س-03168","ق-0530","س-07708","س-00930","س-02006","س-06841","س-05824","س-01380","س-05925"],"memberIds":["س-03138"],"counts":{"items":14,"guide":13,"stars":4,"quran":1,"sunnah":13},"chunk":"need-23.json"},{"id":228,"needId":23,"title":"بالقرآن تلاوةً وحفظاً","summary":"أحبّ سورة الإخلاص لأنها صفة الرحمن؛ فحبك إياها أدخلك حبّ الله.","keywords":["قرآن","حفظ","دراسة","علم","طلب علم","مذاكرة","حب الله","رضا","قرب من الله"],"itemIds":["س-06958","س-06823","س-07812","س-07817"],"counts":{"items":4,"guide":4,"stars":1,"quran":0,"sunnah":4},"chunk":"need-23.json"},{"id":229,"needId":23,"title":"بالصدقة والإنفاق والإطعام","summary":"الصدقة في السر، وإيثار الضيف، والسخاء يحبها الله. الصدقة في السر تطفئ غضب الرب.","keywords":["حب الله","رضا","قرب من الله","صدقة","تبرع","إطعام"],"itemIds":["س-08022","س-03123","س-04891","س-06929","س-01622","س-02000","س-06940"],"memberIds":["س-05783"],"counts":{"items":8,"guide":7,"stars":3,"quran":0,"sunnah":8},"chunk":"need-23.json"},{"id":230,"needId":23,"title":"بالصيام وعشر ذي الحجة والأضحية","summary":"أحب الصيام إلى الله صيام داود: يوم وإفطار يوم، وتعجيل الفطر. ما من أيام العمل الصالح فيها أحب إلى الله من عشر ذي الحجة. ضحِّ يوم النحر؛ فهو أحب العمل إلى الله في ذلك اليوم.","keywords":["حب الله","رضا","قرب من الله","صيام","صوم"],"itemIds":["س-01843","س-03951","س-02849","س-01984","س-02144","س-02162"],"memberIds":["س-00739","س-00759","س-02216"],"counts":{"items":9,"guide":6,"stars":3,"quran":0,"sunnah":9},"chunk":"need-23.json"},{"id":231,"needId":23,"title":"بالجهاد والرباط والشهادة","summary":"إن الله يحب الذين يقاتلون في سبيله صفاً، أذلة على المؤمنين أعزة على الكافرين. الشهيد في سبيل الله يرضى الله عنه ويُرضيه.","keywords":["موت","خاتمة","وفاة","شهادة","حب الله","رضا","قرب من الله","جهاد","رباط","يفرح الله بي","يباهي بي الملائكة","يضحك الله إليه","يعجب ربك"],"itemIds":["ق-0172","ق-0316","ق-1327","س-04346","س-05706","س-06910","س-00489","س-04986","س-06881","س-04454"],"memberIds":["س-06980","س-00386","س-00428","س-04426"],"counts":{"items":14,"guide":10,"stars":4,"quran":3,"sunnah":11},"chunk":"need-23.json"},{"id":232,"needId":23,"title":"بصلة الرحم ورعاية الأهل والأولاد","summary":"العدل بين الأولاد، والنفع للعيال، والغيرة في موضعها يحبها الله. صلة الرحم بعد الإيمان بالله من أحب الأعمال إلى الله. رضا الرب في رضا الوالد، وسخطه في سخطه.","keywords":["زواج","عرس","زوجة","خطبة","عزوبية","أولاد","عيال","بنات","حمل","إنجاب","تربية","حب الله","رضا","قرب من الله","أبوي","أمي","أبي","والدي","والدتي","عقوق","بر","أقارب","أهل","قطيعة","صلة"],"itemIds":["س-02620","س-04344","س-03122","س-03167","س-05865","س-05797","س-05250","س-03844"],"counts":{"items":8,"guide":8,"stars":4,"quran":0,"sunnah":8},"chunk":"need-23.json"},{"id":233,"needId":23,"title":"بالإحسان إلى الناس وقضاء حوائجهم","summary":"إن الله يحب المحسنين؛ فكن سمحاً في البيع والشراء والقضاء، واستر على الناس. أفشِ السلام؛ فإنه لله رضا.","keywords":["حب الله","رضا","قرب من الله","مساعدة الناس","خدمة","معروف"],"itemIds":["س-06821","ق-0072","ق-1324","س-06819","س-06830","س-07150","س-01612","س-02250","س-00128","س-02488","س-02206","س-06990"],"memberIds":["س-01611","س-03189"],"counts":{"items":14,"guide":12,"stars":4,"quran":2,"sunnah":12},"chunk":"need-23.json"},{"id":234,"needId":23,"title":"بحسن الخلق (العفو والحلم والتواضع والصدق وحفظ اللسان)","summary":"إن الله رفيق يحب الرفق، ويحب الحليم المتأني، والصادق، وحسن الخلق. اصبر على أذى جارك؛ يحبك الله ويكفيك إياه. من رضي بالبلاء فله الرضا. تكلّم بكلمة من رضوان الله ولو لم تُلقِ لها بالاً، ويسّر، ولا تغضب.","keywords":["حب الله","رضا","قرب من الله","كلام","لسان","كذب","غيبة","نميمة","سب","تواضع","عفو","مسامحة","غضب","مرض","مريض","ألم","وجع","علاج","شفاء","صحة","دواء","عافية","حماية","تحصين","أمان","خوف","حوادث","صبر","تحمل","ابتلاء"],"itemIds":["س-05704","س-06174","س-07388","س-00210","س-00240","س-05074","س-06971","ق-0137","ق-0291","ق-0484","س-06867","س-06899","س-07376","س-07532","س-03105","س-05430","س-06863","س-01764","س-05405","س-05681","س-06826","س-06122","س-06872"],"memberIds":["س-06925","س-06869","س-06173","ق-0483","س-01577","س-02044","س-00204","س-06118"],"counts":{"items":31,"guide":23,"stars":8,"quran":4,"sunnah":27},"chunk":"need-23.json"},{"id":235,"needId":23,"title":"بالحب في الله والتزاور فيه واتباع النبي ﷺ","summary":"حقّت محبتي للمتحابين فيّ والمتزاورين فيّ؛ وإن كنتم تحبون الله فاتبعوني يحببكم الله. أطع النبي ﷺ فطاعته طاعة الله، ومن أحب أحداً لله فقد أكرم ربه.","keywords":["حب الله","رضا","قرب من الله","الحب في الله","صديقي","زيارة الأخ","اتباع السنة","محبوب","قبول","أصدقاء","علاقات","صحبة","وحدة"],"itemIds":["س-08439","ق-0129","س-05395","س-06970","س-07245","س-02675","س-03702","ق-0233","س-05389"],"memberIds":["س-05394","س-00608"],"counts":{"items":11,"guide":9,"stars":4,"quran":2,"sunnah":9},"chunk":"need-23.json"},{"id":236,"needId":23,"title":"بحب النبي ﷺ وأصحابه وآل بيته","summary":"من أحب الأنصار أحبه الله، ومن أحب الحسن والحسين فقد أحب النبي ﷺ.","keywords":["حب الله","رضا","قرب من الله","الأنصار","آل البيت","الصحابة","علي","الحسن والحسين"],"itemIds":["س-03145","س-08356","س-08364","س-03182","س-08398","س-08401","س-08403","س-08265"],"memberIds":["س-08343","س-01798","س-03760","س-08268","س-08338"],"counts":{"items":13,"guide":8,"stars":1,"quran":0,"sunnah":13},"chunk":"need-23.json"},{"id":237,"needId":23,"title":"بالتقوى والخشية والزهد وعمل السر","summary":"إن الله يحب العبد التقي الغني الخفي، والزاهد في الدنيا. قيام الليل والصدقة الخفية والثبات عند اللقاء أعمال سرّ يحبها الله. التمس رضا الله بسخط الناس يرضَ الله عنك ويُرضِ عنك الناس.","keywords":["حب الله","رضا","قرب من الله"],"itemIds":["س-05581","س-05612","س-03106","س-05464","س-02165","س-00467","س-06920","س-03110","س-06952"],"memberIds":["س-05491","س-05528","س-06884"],"counts":{"items":12,"guide":9,"stars":3,"quran":0,"sunnah":12},"chunk":"need-23.json"},{"id":238,"needId":23,"title":"بالإيمان والتوكل واليقين","summary":"توكّل على الله بعد المشاورة والعزم، وتعفّف وإن كنت فقيراً ذا عيال. الإيمان والعمل الصالح والتقوى والإحسان والتمسك بالحنيفية السمحة يحبها الله. السبق إلى الإيمان والعمل الصالح الخالص وصدق البيعة سبب لرضا الله. اشكر النعمة وأعطِ منها؛ إن تشكروا يرضه لكم.","keywords":["حب الله","رضا","قرب من الله","قناعة","طمع","تسخط","إيمان","يقين","ضعف إيمان"],"itemIds":["ق-0336","س-03820","س-02695","س-08271","ق-0180","س-03107","س-01705","ق-0526","ق-0743","ق-1239","س-04753","س-06843","س-02487","ق-1072","س-06888"],"memberIds":["س-02489"],"counts":{"items":16,"guide":15,"stars":5,"quran":6,"sunnah":10},"chunk":"need-23.json"},{"id":239,"needId":23,"title":"بإظهار نعمة الله والتجمّل وآداب يومية (العطاس والطعام والتسمية)","summary":"إذا أنعم الله عليك فأظهر أثر نعمته، وكُل والبس بلا سرف ولا مخيلة. إن الله ليرضى عن العبد أن يأكل الأكلة فيحمده عليها، أو يشرب الشربة فيحمده عليها.","keywords":["حب الله","رضا","قرب من الله","سنن يومية","آداب"],"itemIds":["س-04080","س-06892","س-03117","س-05713","س-00479","س-01362","س-01549","س-06989","س-07147","س-03173","س-00831"],"memberIds":["س-00182","س-00480","س-05428","س-05799","س-01544"],"counts":{"items":16,"guide":11,"stars":4,"quran":0,"sunnah":16},"chunk":"need-23.json"},{"id":240,"needId":23,"title":"بالعدل والأمانة في الولاية والحكم","summary":"إن الله يحب المقسطين؛ فاعدل في حكمك وولايتك.","keywords":["حب الله","رضا","قرب من الله","ظلم","مدير","مسؤول","حكم","سلطة"],"itemIds":["ق-0307","ق-1246","س-07447","س-06820"],"counts":{"items":4,"guide":4,"stars":1,"quran":2,"sunnah":2},"chunk":"need-23.json"},{"id":241,"needId":23,"title":"بالمداومة على العمل وإتقانه والقوة فيه والأخذ بالرخص","summary":"المؤمن القوي أحب إلى الله من المؤمن الضعيف، والله يحب أن تُؤتى رخصه. أحب الأعمال إلى الله أدومها وإن قل؛ فخذ من العمل ما تطيق. إن الله يحب إذا عمل أحدكم عملاً أن يتقنه.","keywords":["حب الله","رضا","قرب من الله"],"itemIds":["س-05047","س-06933","س-07576","س-02697","س-06900"],"memberIds":["س-01884","س-01857","س-06911","س-01807","س-06949"],"counts":{"items":10,"guide":5,"stars":3,"quran":0,"sunnah":10},"chunk":"need-23.json"},{"id":242,"needId":23,"title":"بالحج والعمرة","summary":"يباهي الله ملائكته بأهل عرفة شُعثاً غُبراً.","keywords":["حب الله","رضا","قرب من الله","حج","عمرة"],"itemIds":["س-03480"],"counts":{"items":1,"guide":1,"stars":1,"quran":0,"sunnah":1},"chunk":"need-23.json"},{"id":243,"needId":23,"title":"بالعلم تعلّماً وتعليماً","summary":"الملائكة تضع أجنحتها لطالب العلم رضاً بما يصنع.","keywords":["قرآن","حفظ","دراسة","علم","طلب علم","مذاكرة","حب الله","رضا","قرب من الله"],"itemIds":["س-06234"],"memberIds":["س-07255"],"counts":{"items":2,"guide":1,"stars":1,"quran":0,"sunnah":2},"chunk":"need-23.json"},{"id":244,"needId":23,"title":"بلزوم الجماعة وطاعة ولي الأمر","summary":"من أطاع الأمير فقد أطاع النبي ﷺ.","keywords":["حب الله","رضا","قرب من الله","مسجد","جماعة","أذان","جمعة"],"itemIds":["س-03672"],"memberIds":["س-03704"],"counts":{"items":2,"guide":1,"stars":1,"quran":0,"sunnah":2},"chunk":"need-23.json"},{"id":245,"needId":24,"title":"بالإيمان والتوبة وطاعة الله ورسوله ولزوم الجماعة","summary":"آمن بالله واعتصم به، واعتزل الشرك وأهله؛ ينشر لك ربك من رحمته. استغفروا الله وتوبوا إليه لعلكم تُرحمون. أطيعوا الله والرسول لعلكم تُرحمون. الجماعة رحمة؛ فالزمها.","keywords":["إيمان","يقين","ضعف إيمان","ذنب","ذنوب","معصية","توبة","استغفار","ندم","غلطت","محبوب","قبول","أصدقاء","علاقات","صحبة","وحدة","مسجد","جماعة","أذان","جمعة"],"itemIds":["ق-0282","ق-0726","ق-1189","س-02416","ق-0594","ق-0162","س-05931"],"memberIds":["ق-0902"],"counts":{"items":8,"guide":7,"stars":4,"quran":6,"sunnah":2},"chunk":"need-24.json"},{"id":246,"needId":24,"title":"بالذكر ومجالسه والدعاء","summary":"إذا اجتمع قوم يذكرون الله حفّتهم الملائكة وغشيتهم الرحمة. ادعُ الله خوفاً وطمعاً؛ إن رحمة الله قريب من المحسنين، وتعرّض لنفحاته.","keywords":["أذكار","تسبيح","ذكر","دعاء","استجابة","طلب","أمنية"],"itemIds":["س-07240","س-07242","س-08134","ق-0995","س-01035","س-00833","س-00991","س-00993","س-01026","س-00760","س-00761","ق-0406","س-05839","س-01921"],"counts":{"items":14,"guide":14,"stars":4,"quran":2,"sunnah":12},"chunk":"need-24.json"},{"id":247,"needId":24,"title":"بالصلاة على النبي ﷺ","summary":"من صلّى على النبي ﷺ واحدة صلّى الله عليه بها عشراً، ومن سلّم عليه سلّم الله عليه عشراً.","keywords":["صلاة","خشوع","صلوات"],"itemIds":["س-00113","س-07634","س-08223","س-08144","س-01031","س-02723"],"memberIds":["س-02299","س-00110","س-01527","س-01531","س-08178","س-00112","س-00111","س-00730","س-02018","س-03412","س-03413","س-04705","س-08123","س-02741","س-08159","س-08125","س-08164","س-08196"],"counts":{"items":24,"guide":6,"stars":2,"quran":0,"sunnah":24},"chunk":"need-24.json"},{"id":248,"needId":24,"title":"بالصلاة والقيام والنوافل","summary":"أقم الصلاة وصلِّ أربعاً قبل العصر، وأيقظ أهلك لقيام الليل؛ ترحمك الرحمة.","keywords":["صلاة","خشوع","صلوات"],"itemIds":["ق-0869","س-02336","س-03877","س-01307","س-03885"],"counts":{"items":5,"guide":5,"stars":2,"quran":1,"sunnah":4},"chunk":"need-24.json"},{"id":249,"needId":24,"title":"بالمساجد والأذان والجماعة والجمعة","summary":"الملائكة تصلي على أحدكم ما دام في مصلاه، وعلى الصف الأول.","keywords":["مسجد","جماعة","أذان","جمعة"],"itemIds":["س-02007","س-06421","س-07144","س-01056","س-07972","س-08109","س-03420","س-03438","س-06679","س-06991","س-01997"],"memberIds":["س-06524","س-01507","س-03437","س-08150"],"counts":{"items":15,"guide":11,"stars":3,"quran":0,"sunnah":15},"chunk":"need-24.json"},{"id":250,"needId":24,"title":"بالقرآن تلاوةً وحفظاً","summary":"استمع للقرآن وأنصت لعلكم تُرحمون، واتبع الكتاب واتّق الله.","keywords":["قرآن","حفظ","دراسة","علم","طلب علم","مذاكرة"],"itemIds":["ق-0386","ق-0448","س-02099","س-02321","س-08138"],"memberIds":["س-02100"],"counts":{"items":6,"guide