,"fp":"df1f803a8a31","stateId":33,"easy":"إذا أسلمت ← تسلم"},{"id":"س-08207","fp":"a787a4aad3c7","stateId":34,"easy":"إذا قرأت القرآن ← تنزل السكينة عند قراءتك"},{"id":"س-00743","fp":"49fba0c51ea1","stateId":34,"easy":"إذا اجتمعتم في بيت من بيوت الله تتلون القرآن وتتدارسونه ← تنزل عليكم السكينة وتغشاكم الرحمة وتحفّكم الملائكة ويذكركم الله"},{"id":"ق-0493","fp":"6c551d700396","stateId":34,"easy":"الإيمان والثبات مع الرسول ← السكينة والجنود وتعذيب الكافرين"},{"id":"ق-0499","fp":"4d90e6c1945b","stateId":34,"easy":"اليقين بمعية الله عند الخوف ← السكينة والتأييد بجنود وعلوّ كلمة الله"},{"id":"س-02478","fp":"cda901bc27fa","stateId":35,"easy":"إذا صمت ثلاثة أيام من كل شهر ← يذهب ما في صدرك من غلّ وضيق"},{"id":"ق-0374","fp":"82f6ccc9f827","stateId":35,"easy":"الإسلام والاهتداء ← انشراح الصدر"},{"id":"س-07325","fp":"846d47c6c82c","stateId":36,"easy":"إذا استغنى قلبك ← فهذا هو الغنى الحقيقي"},{"id":"س-06002","fp":"a1d80efe8242","stateId":36,"easy":"إذا اتقيت الله ← فالصحة لك خير من الغنى"},{"id":"س-07596","fp":"87ab07f55a4f","stateId":36,"easy":"إذا كنت مؤمناً ← فكل ما يقضيه الله لك خير"},{"id":"س-05658","fp":"d33ce4ed0474","stateId":36,"easy":"إذا أصبحت معافى آمناً عندك قوت يومك ← فكأنما مُلّكت الدنيا كلها"},{"id":"س-05595","fp":"a3d7407c495b","stateId":36,"easy":"إذا نظرت إلى من هو أسفل منك ← لا تحتقر نعمة الله عليك"},{"id":"س-05388","fp":"a295fbc129d5","stateId":37,"easy":"إذا أحببت المرء لله، وكان الله ورسوله أحب إليك مما سواهما ← تجد طعم الإيمان"},{"id":"س-04088","fp":"94f24827f76c","stateId":38,"easy":"إذا استيقظت فذكرت الله وتوضأت وصليت ← تصبح نشيطاً طيّب النفس"},{"id":"س-00897","fp":"c985bc51536a","stateId":38,"easy":"إذا استيقظت فذكرت الله وتوضأت وصليت ← تصبح نشيطاً قد أصبت خيراً"},{"id":"س-03100","fp":"0b3ed95494a5","stateId":39,"easy":"إذا راعك أمر فقل «الله ربي لا أشرك به شيئاً» ← (ذكر نبوي عند الروع)"},{"id":"س-05823","fp":"065d637fa89c","stateId":40,"easy":"إذا رأيت الكسوف فاحمد الله وكبّر وسبّح وصلّ ← حتى ينجلي"},{"id":"س-05353","fp":"a150984dd7f0","stateId":40,"easy":"إذا توكلت على الله ← يذهب عنك أثر الطيرة"},{"id":"س-07466","fp":"452649c7568b","stateId":41,"easy":"إذا رجوت الله ألا يعيدك إلى النار ← يرحمك ويدخلك الجنة"},{"id":"س-07469","fp":"bc05e1cf253d","stateId":41,"easy":"إذا علم المؤمن ما عند الله من العقوبة ← لا يطمع أحد بالجنة (فيبقى بين خوف ورجاء)"},{"id":"س-07517","fp":"4e95f5a6367e","stateId":42,"easy":"إذا خفت فقل «حسبنا الله ونعم الوكيل» ← (هي كلمة المؤمن عند الشدة)"},{"id":"ق-0011","fp":"dda538f5f9f0","stateId":42,"easy":"اتباع هدى الله ← لا خوف ولا حزن"},{"id":"ق-0324","fp":"60f045737fc1","stateId":42,"easy":"الإيمان بالله واليوم الآخر والعمل الصالح ← لا خوف ولا حزن"},{"id":"ق-0356","fp":"39fbd537242a","stateId":42,"easy":"الإيمان والإصلاح ← لا خوف ولا حزن"},{"id":"ق-0361","fp":"d54a69ba18c7","stateId":42,"easy":"الإيمان الخالص من الشرك ← الأمن والاهتداء"},{"id":"س-04684","fp":"4a0c2775c317","stateId":43,"easy":"إذا كنت أصدق الناس حديثاً ← تكون أصدقهم رؤيا"},{"id":"س-03623","fp":"c565919311ef","stateId":43,"easy":"إذا رأيت رؤيا حسنة فحدّث بها ← فهي بشرى من الله"},{"id":"س-07066","fp":"dca30ab163ed","stateId":44,"easy":"إذا قلت الحق حين تراه ← لا يقرّب ذلك أجلك ولا يبعد رزقك"},{"id":"س-03797","fp":"e70b6bd50163","stateId":45,"easy":"إذا رُزقت جاراً صالحاً ومسكناً واسعاً ومركباً هنيئاً ← فهي من سعادة المسلم في الدنيا"},{"id":"س-01341","fp":"5c1d14dc5eb8","stateId":45,"easy":"إذا رُزقت زوجة صالحة ← فهي خير متاع الدنيا"},{"id":"س-01792","fp":"e02bdbbdf342","stateId":46,"easy":"إذا صمت ← لك فرحتان: عند فطرك، وعند لقاء ربك"},{"id":"س-04451","fp":"72b6e7ca0c6e","stateId":47,"easy":"إذا كنت مستعداً للجهاد في سبيل الله على فرسك ← فهو من خير معاش الناس"},{"id":"ق-0575","fp":"5723a0e12811","stateId":47,"easy":"الاستغفار والتوبة ← متاع حسن إلى أجل مسمى وإيتاء كل ذي فضل فضله"},{"id":"س-02532","fp":"57af25cc7a0f","stateId":48,"easy":"إذا غضبت فقل «أعوذ بالله من الشيطان الرجيم» ← يذهب عنك ما تجد"},{"id":"س-00696","fp":"a1cff1db901f","stateId":48,"easy":"إذا غضبت فقلت «أعوذ بالله من الشيطان الرجيم» ← يسكن غضبك"},{"id":"س-00231","fp":"a322f1ead2ed","stateId":49,"easy":"إذا ملكت نفسك عند الغضب ← فأنت القوي حقاً"},{"id":"س-06028","fp":"72b68e7aae73","stateId":50,"easy":"إذا مات لك ثلاثة من الولد ← لا تدخل النار إلا تحلة القسم"},{"id":"س-07558","fp":"655e73fbf80d","stateId":50,"easy":"إذا صبرت على المصيبة ← يبارك الله لك (من قصة أبي طلحة)"},{"id":"س-04272","fp":"861809ad8706","stateId":50,"easy":"إذا مات لك صغار فصبرت ← يتلقّونك في الجنة (دعاميص الجنة)"},{"id":"س-06040","fp":"066d219a077a","stateId":50,"easy":"إذا صبرت على موت ولدك واحتسبت ← يخلفك الله ذرية مباركة (من قصة أم سليم)"},{"id":"س-08215","fp":"2f1dd2a6f465","stateId":51,"easy":"إذا أُصبت ببلاء في جسدك ← يأمر الله الملائكة بكتابة عملك"},{"id":"س-08214","fp":"9b88129f2de0","stateId":51,"easy":"إذا ابتُليت ببلاء في جسدك ← يُكتب لك مثل ما كنت تعمل صحيحاً"},{"id":"س-07939","fp":"3d4410fe79e7","stateId":51,"easy":"إذا عدت مريضاً فقل «لا بأس، طهور إن شاء الله» ← (المرض طهور)"},{"id":"س-04555","fp":"15fc037d7002","stateId":51,"easy":"إذا أصابتك الحمى ← فهي حظك من النار"},{"id":"س-07631","fp":"a43afd4cb15f","stateId":51,"easy":"إذا مِتّ بالطاعون ← فهو شهادة ورحمة لك"},{"id":"س-02659","fp":"e5f12ca4ffdd","stateId":52,"easy":"إذا أخذ الله عينيك في الدنيا ← فليس لك جزاء إلا الجنة"},{"id":"س-05679","fp":"06309ce5ef8e","stateId":52,"easy":"إذا فقدت عينيك فصبرت ← يعوضك الله الجنة"},{"id":"س-01294","fp":"8d770e58584c","stateId":53,"easy":"إذا أصابتك مصيبة فقلت «إنا لله وإنا إليه راجعون، اللهم أجرني...» ← يخلف الله لك خيراً منها"},{"id":"س-07609","fp":"fe0cbc69c2b7","stateId":53,"easy":"إذا أصابتك نكبة ولو شوكة ← تُحط عنك خطيئة وتُرفع درجة"},{"id":"س-05665","fp":"c0bfddd4af01","stateId":53,"easy":"إذا أصابتك مصيبة فاسترجعت ودعوت ← يأجرك الله ويخلف لك خيراً"},{"id":"ق-0052","fp":"6478e1019737","stateId":53,"easy":"الصبر عند المصيبة وقول: إنا لله وإنا إليه راجعون ← صلوات من الله ورحمة وهداية"},{"id":"س-03543","fp":"06fe1bb6d14c","stateId":54,"easy":"إذا أصابتك شوكة أو وجع ← يرفعك الله بها درجة ويحط عنك خطيئة"},{"id":"س-07561","fp":"a43964c5243e","stateId":54,"easy":"إذا ابتُليت فصبرت ← فلك الجنة"},{"id":"س-03526","fp":"e7b226f3587b","stateId":54,"easy":"إذا صبرت على البلاء ← يتمنى أهل العافية يوم القيامة مكانك لما يرون من ثوابك"},{"id":"س-02503","fp":"69626b0948fc","stateId":54,"easy":"إذا صبرت على بلائك ← تجيء يوم القيامة بلا ذنوب ولا حساب (من واقعة)"},{"id":"س-01717","fp":"b34017f9e43b","stateId":55,"easy":"إذا اشتد بلاؤك ← يضاعف الله لك الأجر"},{"id":"ق-0167","fp":"d7f6c0629eb9","stateId":56,"easy":"الابتلاء بالقرح وتداول الأيام ← تمحيص المؤمنين ومحق الكافرين"},{"id":"ق-0193","fp":"48c4849d169e","stateId":56,"easy":"الإيمان ← التمييز بين الخبيث والطيب بالابتلاء"},{"id":"ق-0439","fp":"15a126204232","stateId":56,"easy":"الابتلاء بالحسنات والسيئات ← غايته الرجوع إلى الله"},{"id":"ق-0788","fp":"01d9b4afc914","stateId":56,"easy":"الابتلاء بالشر والخير ← فتنة واختبار ثم الرجوع إلى الله"},{"id":"س-04089","fp":"0d4faedadce6","stateId":58,"easy":"إذا لم تقم من الليل ← تصبح خبيث النفس كسلان"},{"id":"ق-0174","fp":"db96af7ba160","stateId":59,"easy":"الشرك بالله ← إلقاء الرعب في القلوب ومأواهم النار"},{"id":"س-05599","fp":"dfdd3f0c38f2","stateId":60,"easy":"إذا تشعّبت بك الهموم (غير الآخرة) ← لا يبالي الله في أي أودية الدنيا هلكت"},{"id":"س-05617","fp":"63cc560a97de","stateId":60,"easy":"إذا كان الفقر في قلبك ← لا يغنيك ما كثر لك من الدنيا"},{"id":"س-01287","fp":"881d708049a4","stateId":61,"easy":"إذا كانت زوجتك سيئة لا تأمنها، ومركبك ودارك سيئين ← فذلك من الشقاء"},{"id":"س-05230","fp":"ff286c10f5e6","stateId":61,"easy":"إذا تركت الاستخارة وسخطت بعد القضاء ← فذلك من شقائك"},{"id":"ق-1442","fp":"bd6fb50e2aba","stateId":62,"easy":"البخل والاستغناء والتكذيب بالحسنى ← التيسير للعسرى ولا يغني المال إذا تردّى"},{"id":"س-03160","fp":"8a3090055a6a","stateId":64,"easy":"إذا لقيت الله بملء الأرض خطايا لا تشرك به شيئاً ← يلقاك بمثلها مغفرة"},{"id":"س-03378","fp":"52b539c14422","stateId":64,"easy":"إذا لم تشرك بالله شيئاً ← يُغفر لك"},{"id":"س-01227","fp":"12b7587d99a9","stateId":64,"easy":"إذا قلت «لا إله إلا الله» ← يُغفر لك"},{"id":"س-00854","fp":"c2b5bcde22f8","stateId":66,"easy":"إذا قلت «سبحان الله وبحمده» مئة مرة في يوم ← تُحط خطاياك ولو كانت مثل زبد البحر"},{"id":"س-00942","fp":"4e787e8e9542","stateId":66,"easy":"إذا قلت «سبحان الله وبحمده» مئة صباحاً ومئة مساءً ← تُغفر ذنوبك ولو كانت أكثر من زبد البحر"},{"id":"س-00850","fp":"f2a79f5fdad2","stateId":66,"easy":"إذا سبّحت وحمدت وكبّرت ثلاثاً وثلاثين دبر كل صلاة ← تُغفر خطاياك ولو كانت مثل زبد البحر"},{"id":"س-01039","fp":"d7e821b3a8ef","stateId":67,"easy":"إذا جلست مع قوم يذكرون الله ← يغفر الله لكم"},{"id":"س-08135","fp":"718b5a164fe5","stateId":67,"easy":"إذا جلست في مجلس ذكر تسبّح وتكبّر وتحمد وتسأل ← يغفر الله لكم ويعطيكم ما سألتم ويجيركم مما استجرتم"},{"id":"س-03458","fp":"c446189d30ef","stateId":69,"easy":"إذا دعوت الله ورجوته ← يغفر لك ما كان منك ولا يبالي"},{"id":"س-03356","fp":"b4b138bd9e5d","stateId":70,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر خطيئات ويرفعك عشر درجات"},{"id":"س-07273","fp":"eb72658442e5","stateId":71,"easy":"إذا افتتنت في أهلك ومالك وجارك ← تكفّرها الصلاة والصيام والصدقة"},{"id":"س-06634","fp":"7575a691b131","stateId":71,"easy":"إذا قمت إلى الصلاة فسجدت ← تتناثر عنك خطاياك يميناً وشمالاً"},{"id":"س-06686","fp":"2dc921195ffb","stateId":73,"easy":"إذا وافق تأمينك تأمين الملائكة ← يُغفر لك ما تقدّم من ذنبك"},{"id":"س-03539","fp":"9579ff7b8abf","stateId":74,"easy":"إذا اغتسلت يوم الجمعة وتطهرت وادّهنت وتطيبت ← يُغفر لك ما بين الجمعتين"},{"id":"س-03550","fp":"faecf4c2ed59","stateId":74,"easy":"إذا تطهرت يوم الجمعة كما أُمرت ثم خرجت حتى تأتيها ← تكون كفارة لما قبلها"},{"id":"س-03292","fp":"155d2aab59e9","stateId":74,"easy":"إذا صليت الجمعة إلى الجمعة واجتنبت الكبائر ← تكون كفارة لما بينهما"},{"id":"س-06619","fp":"02d22ca9c917","stateId":75,"easy":"إذا توضأت فأحسنت ثم صليت مع الجماعة ← يغفر الله لك (من واقعة)"},{"id":"س-06594","fp":"7a5c6da604a1","stateId":75,"easy":"إذا تطهرت في بيتك ثم مشيت إلى المسجد لفريضة ← خطوة تحطّ خطيئة وأخرى ترفع درجة"},{"id":"س-01399","fp":"985f77591c64","s