tateId":691,"easy":"إذا قلت «سبحان الله العظيم وبحمده» ← تُغرس لك نخلة في الجنة"},{"id":"س-00753","fp":"5d5528f9efcf","stateId":691,"easy":"إذا قلت صباحاً «رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» ← فالنبي ﷺ زعيم لك أن يأخذ بيدك حتى يدخلك الجنة"},{"id":"س-04298","fp":"314e663c65f9","stateId":692,"easy":"إذا سألت الله الجنة ثلاث مرات ← تقول الجنة: اللهم أدخله الجنة"},{"id":"س-06643","fp":"4970ca4fef01","stateId":693,"easy":"إذا أديت الصلوات كما فُرضت لم تنقص منها استخفافاً ← لك عند الله عهد أن يدخلك الجنة"},{"id":"س-06641","fp":"532b63ebcc34","stateId":693,"easy":"إذا جئت بالصلوات لم تنتقص منها شيئاً ← يجعل الله لك يوم القيامة عهداً أن يدخلك الجنة"},{"id":"س-04190","fp":"37a5f792865d","stateId":693,"easy":"إذا صليت البردين (الفجر والعصر) ← دخلت الجنة"},{"id":"س-01478","fp":"2636d9e9083b","stateId":694,"easy":"إذا صليت لله كل يوم اثنتي عشرة ركعة تطوعاً ← يبني الله لك بيتاً في الجنة"},{"id":"س-04077","fp":"230c8cbed815","stateId":694,"easy":"إذا قرأت آية السجدة فسجدت ← يبكي الشيطان ويقول: أُمر ابن آدم بالسجود فسجد فله الجنة"},{"id":"س-08367","fp":"3354ab4f15e1","stateId":694,"easy":"إذا صليت بعد كل طهور ← تسمع خشخشتك في الجنة (من قصة بلال)"},{"id":"س-02065","fp":"4f5234fd94c5","stateId":695,"easy":"إذا غدوت إلى المسجد أو رحت ← يعد الله لك في الجنة نزلاً كلما غدوت أو رحت"},{"id":"س-01526","fp":"01253625d8e5","stateId":695,"easy":"إذا رددت مع المؤذن من قلبك ← دخلت الجنة"},{"id":"س-01909","fp":"c75ead93f095","stateId":695,"easy":"إذا بنيت لله مسجداً ← يبني الله لك بيتاً في الجنة"},{"id":"س-01472","fp":"45638c8d23ab","stateId":696,"easy":"إذا أحسنت الوضوء ثم ركعت ركعتين تقبل عليهما بقلبك ← أوجبت الجنة"},{"id":"س-07810","fp":"685a92d1432b","stateId":697,"easy":"إذا قرأت آية الكرسي دبر كل صلاة ← لم يكن بينك وبين الجنة إلا أن تموت"},{"id":"س-08301","fp":"f050ec81d177","stateId":697,"easy":"إذا أحببت سورة الإخلاص ← يدخلك حبها الجنة"},{"id":"س-04209","fp":"8a5ba6aeb793","stateId":697,"easy":"إذا قرأت القرآن وتعلمته وعملت به ← تُلبس يوم القيامة تاجاً من نور ضوؤه كالشمس"},{"id":"ق-1029","fp":"e73c61d21ba8","stateId":697,"easy":"وراثة الكتاب والسبق بالخيرات ← جنات عدن وذهاب الحزن ودار المقامة بلا نصب"},{"id":"س-07860","fp":"b49aa5dec08e","stateId":698,"easy":"إذا أنفقت زوجين من مالك ← تناديك كل خزنة الجنة"},{"id":"س-02286","fp":"7e16879f40f2","stateId":698,"easy":"إذا حفرت ماءً يشرب منه كبد حرى ← يأجرك الله ويبني لك بيتاً في الجنة"},{"id":"س-06309","fp":"b8d7b3c1902b","stateId":698,"easy":"إذا تصدقت بلقمة الخبز أو قبضة التمر مما ينفع المسكين ← يدخل الله بها ثلاثة الجنة: الآمر والصانع والمناول"},{"id":"س-06616","fp":"3c72443321d8","stateId":698,"easy":"إذا أنفقت زوجين في سبيل الله ← تُنادى من أبواب الجنة: يا عبد الله هذا خير"},{"id":"ق-1436","fp":"b3c5c291ad92","stateId":698,"easy":"فكّ الرقبة وإطعام اليتيم والمسكين في المسغبة مع الإيمان والتواصي بالصبر والمرحمة ← اقتحام العقبة وأصحاب الميمنة"},{"id":"س-08347","fp":"d076240d93ad","stateId":699,"easy":"إذا كنت من أهل الصيام ← تُدعى من باب الريان"},{"id":"س-04745","fp":"f15b23e090ff","stateId":699,"easy":"إذا صمت يوماً ابتغاء وجه الله فخُتم لك به ← دخلت الجنة"},{"id":"س-02289","fp":"ec73d165275d","stateId":700,"easy":"إذا حججت حجاً مبروراً ← فليس له جزاء إلا الجنة"},{"id":"س-04416","fp":"45522befb0ed","stateId":701,"easy":"إذا خرجت في سبيل الله إيماناً وتصديقاً ← يرجعك بما نلت من أجر أو غنيمة أو يدخلك الجنة"},{"id":"س-01301","fp":"a1044c9c5959","stateId":701,"easy":"إذا صنعت السهم محتسباً أو نبّلته أو رميت به في سبيل الله ← يدخلك الله الجنة"},{"id":"س-04358","fp":"6bf0475bd49b","stateId":701,"easy":"إذا قاتلت في سبيل الله فواق ناقة ← وجبت لك الجنة"},{"id":"س-04527","fp":"47c5a1a2fd5f","stateId":701,"easy":"إذا قُتلت في سبيل الله ← تكون روحك في طير خضر تسرح في الجنة حيث شاءت"},{"id":"س-04372","fp":"08f512504d7b","stateId":701,"easy":"إذا جهزت غازياً أو بنيت مسجداً ← لك مثل أجره ويبني الله لك بيتاً في الجنة"},{"id":"س-04405","fp":"cbb867134f38","stateId":701,"easy":"إذا قُتلت أو مت في سبيل الله ← فأنت في الجنة"},{"id":"س-04303","fp":"c2bdea780ef8","stateId":702,"easy":"إذا أمسيت مرضياً لوالديك ← يصبح لك بابان مفتوحان إلى الجنة"},{"id":"س-07227","fp":"5491f3eb7ca4","stateId":702,"easy":"إذا بررت والدك ← فهو أوسط أبواب الجنة"},{"id":"س-04184","fp":"aa634140bbd7","stateId":703,"easy":"إذا كان لك ثلاث بنات تؤويهن وترحمهن وتكفلهن ← وجبت لك الجنة ألبتة"},{"id":"س-01905","fp":"d4cc525fe1cc","stateId":703,"easy":"إذا علت جاريتين حتى تبلغا ← تدخل الجنة مع النبي ﷺ كهاتين"},{"id":"س-02860","fp":"7ba4d488e595","stateId":703,"easy":"إذا علت ابنتين أو ثلاثاً أو أختين أو ثلاثاً ← تكون مع النبي ﷺ كهاتين"},{"id":"س-02715","fp":"b901c212814f","stateId":703,"easy":"إذا آثرت أولادك على نفسك ← يوجب الله لك بها الجنة"},{"id":"س-04549","fp":"37335ad90c26","stateId":705,"easy":"إذا كانت المرأة ودوداً ولوداً تقول لزوجها إذا غضب «يدي في يدك...» ← فهي من نساء أهل الجنة"},{"id":"س-02658","fp":"1236284c2c30","stateId":706,"easy":"إذا مات لك ثلاثة من الولد فاحتسبتهم ← تدخل الجنة"},{"id":"س-04237","fp":"d9ea88d28acb","stateId":706,"easy":"إذا صبرت على المكاره ← فالجنة حُفّت بالمكاره"},{"id":"س-02653","fp":"f08ca0baae68","stateId":706,"easy":"إذا قبض الله صفيك من الدنيا فاحتسبته ← فما لك عنده جزاء إلا الجنة"},{"id":"س-06059","fp":"db73a15f5d5e","stateId":706,"easy":"إذا مات لك فرطان (طفلان) ← يدخلك الله الجنة"},{"id":"س-02861","fp":"2ecce1b986a4","stateId":707,"easy":"إذا عدت أخاك ← تكون في خرفة الجنة"},{"id":"س-08226","fp":"44ceeb0bed59","stateId":707,"easy":"إذا عدت مريضاً بكراً ← يشيعك سبعون ألف ملك يستغفرون لك ولك خريف في الجنة"},{"id":"س-01963","fp":"fdbec2831380","stateId":708,"easy":"إذا أمطت غصن شوك عن طريق المسلمين ← تدخل الجنة"},{"id":"س-01965","fp":"e6a5d68a44a5","stateId":708,"easy":"إذا نحيت غصن شوك عن الطريق ← يشكر الله لك ويدخلك الجنة"},{"id":"س-00237","fp":"85d790f3437b","stateId":709,"easy":"إذا لزمت الصدق ← يهديك إلى البر ثم إلى الجنة"},{"id":"س-04188","fp":"64dfa58e191f","stateId":709,"easy":"إذا حفظت ما بين لحييك وما بين رجليك ← يتوكل لك النبي ﷺ بالجنة"},{"id":"س-05307","fp":"138826c865ba","stateId":709,"easy":"إذا لزمت الصدق ← فهو في الجنة"},{"id":"س-05719","fp":"b2a5d976fc26","stateId":711,"easy":"إذا فارقت الروح جسدك وأنت بريء من الكبر والغلول والدين ← فأنت في الجنة"},{"id":"س-05914","fp":"d4b1839f337f","stateId":711,"easy":"إذا اتقيت الله وحسن خلقك ← فهما أكثر ما يدخل الناس الجنة"},{"id":"س-00744","fp":"8bff44538c7a","stateId":712,"easy":"إذا سلكت طريقاً تلتمس فيه علماً ← يسهل الله لك به طريقاً إلى الجنة"},{"id":"س-02056","fp":"16ad4586ac03","stateId":712,"easy":"إذا خرجت من بيتك تطلب علماً ← يسهل الله لك طريقاً إلى الجنة"},{"id":"س-02311","fp":"bd84a2941c49","stateId":713,"easy":"إذا زرت أخاً لك في الله ← يناديك منادٍ: طبت وطاب ممشاك وتبوأت من الجنة منزلاً"},{"id":"ق-0123","fp":"b7dacc220b85","stateId":714,"easy":"التقوى: الإيمان والصبر والصدق والقنوت والإنفاق والاستغفار بالأسحار ← جنات وأزواج مطهرة ورضوان من الله"},{"id":"ق-0200","fp":"b18fb2e47fbb","stateId":714,"easy":"التقوى ← جنات تجري من تحتها الأنهار نزلاً من عند الله"},{"id":"ق-0351","fp":"fd07af38b237","stateId":714,"easy":"التقوى ← الدار الآخرة خير لهم"},{"id":"ق-0625","fp":"6bc62cfa5cff","stateId":714,"easy":"الوفاء بعهد الله ووصل ما أمر بوصله وخشيته والصبر ابتغاء وجهه وإقامة الصلاة والإنفاق ودرء السيئة بالحسنة ← عقبى الدار: جنات عدن مع الصالحين من الأهل والذرية وسلام الملائكة"},{"id":"س-02590","fp":"0f105e847662","stateId":715,"easy":"إذا تركت الديباج والحرير وآنية الذهب والفضة في الدنيا ← تكون لك في الآخرة"},{"id":"س-05364","fp":"858e160a7b8a","stateId":717,"easy":"إذا لم تسترقِ ولم تتطير وتوكلت على ربك ← تدخل الجنة بغير حساب ولا عذاب"},{"id":"س-00152","fp":"8542f8b25542","stateId":718,"easy":"إذا أفشيت السلام ووصلت الأرحام وصليت والناس نيام ← تدخل الجنة بسلام"},{"id":"س-00150","fp":"b831ec052815","stateId":718,"easy":"إذا أطعمت الطعام وأفشيت السلام ← تورث الجنات"},{"id":"س-02970","fp":"f9e03a3b28d6","stateId":719,"easy":"إذا عرفت الحق فقضيت به ← فأنت في الجنة"},{"id":"س-03852","fp":"fdf7e12fe94f","stateId":720,"easy":"إذا بايعت على السمع والطاعة والنفقة والأمر بالمعروف ← فلك الجنة"},{"id":"س-08389","fp":"b77434010b4d","stateId":720,"easy":"إذا أردت بحبوحة الجنة ← فالزم الجماعة"},{"id":"س-08334","fp":"61b4e0817218","stateId":721,"easy":"إذا أثنى عليك الناس خيراً ← وجبت لك الجنة"},{"id":"س-03383","fp":"d6f229768e6f","stateId":721,"easy":"إذا شهد لك ثلاثة بالخير ← وجبت لك الجنة"},{"id":"س-03715","fp":"a5e4038d2b7a","stateId":722,"easy":"إذا لم تحمل نفسك من التشديد ما لا تطيق ← فأبشر بالجنة إن لزمت الطريق"},{"id":"س-00159","fp":"dab93fd02a14","stateId":722,"easy":"إذا عملت بخصلة من خصال الخير رجاء ثوابها وتصديق موعودها ← يدخلك الله بها الجنة"},{"id":"س-03217","fp":"c4abc4f100c5","stateId":722,"easy":"إذا طلبت خصلة من خصال الخير ← تأخذ بيدك حتى تدخلك الجنة"},{"id":"س-04488","fp":"837aaa699a68","stateId":723,"easy":"إذا كنت من فقراء المهاجرين ← تكون من أول زمرة تدخل الجنة"},{"id":"س-06045","fp":"b8c75539477b","stateId":723,"easy":"إذا كنت من فقراء المهاجرين ← تسبق الأغنياء إلى الجنة بأربعين خريفاً"},{"id":"س-02623","fp":"c0e883f534bb","stateId":724,"easy":"إذا رجحت حسناتك على سيئاتك ولو بحسنة ← يوسع الله لك في الجنة"},{"id":"س-07259","fp":"adf802d5f8f3","stateId":724,"easy":"إذا كنت سابقاً بالخيرات أو مقتصداً ← تدخل الجنة بغير حساب"},{"id":"س-02215","fp":"697cfdf23428","stateId":725,"easy":"إذا كفلت يتيماً ← تكون مع النبي ﷺ في الجنة هكذا (كالسبابة والوسطى)"},{"id":"س-02853","fp":"7df14613192c","stateId":725,"easy":"إذا علت جاريتين حتى تبلغا ← تأتي يوم القيامة مع النبي ﷺ كأصابعه المضمومة"},{"id":"س-00310","fp":"787480dd6cea","stateId":725,"easy":"إذا حسن خلقك ← تكون أحب الناس إلى النبي ﷺ وأقربهم منه مجلساً يوم القيامة"},{"id":"س-07435","fp":"faf4558c9cfc","stateId":725,"easy":"إذا لم تصدق الظلمة بكذبهم ولم تمالئهم ← فأنت من النبي ﷺ وهو منك"},{"id":"س-04326","fp":"e24268faef33","stateId":726,"easy":"إذا سألت الله فاسأله الفردوس ← فهو وسط الجنة وأعلاها وفوقه عرش الرحمن"},{"id":"س-04318","fp":"0f699b3001b6","stateId":726,"easy":"إذا أطبت الكلام وأطعمت الطعام وبتّ قائماً والناس نيام ← لك غرف في الجنة يُرى ظاهرها من باطنها"},{"id":"ق-0742","fp":"d992376f826f","stateId":726,"easy":"الإيمان والعمل الصالح ← جنات الفردوس نُزلاً"},{"