y":"إذا مت محرماً ← تُبعث يوم القيامة ملبّياً"},{"id":"س-07080","fp":"a9bdcaa7fd5c","stateId":646,"easy":"إذا قلت كلمات النوم عند فراشك ← إن مت من ليلتك مت على الفطرة وإن أصبحت أصبت خيراً"},{"id":"س-04135","fp":"4f94e8e15ed8","stateId":647,"easy":"إذا مت مؤمناً ← تستريح من نصب الدنيا وأذاها إلى رحمة الله"},{"id":"س-04651","fp":"dc8e146fed33","stateId":647,"easy":"إذا مت على الإيمان ← تُبعث في القبر على إيمانك"},{"id":"س-04619","fp":"9ee3eb4138d1","stateId":647,"easy":"إذا كنت مؤمناً في انقطاع من الدنيا وإقبال على الآخرة ← تنزل عليك ملائكة بيض الوجوه بالبشرى"},{"id":"ق-0669","fp":"93d362b25fae","stateId":647,"easy":"التقوى وطيب النفس ← توفّي الملائكة لهم طيبين بالسلام والبشارة بالجنة"},{"id":"ق-1292","fp":"77a94d3081dd","stateId":647,"easy":"القرب من الله بالسبق في الطاعة ← رَوح وريحان وجنة نعيم عند الموت"},{"id":"س-06962","fp":"893a4ba3bb92","stateId":648,"easy":"إذا أحببت لقاء الله ← أحب الله لقاءك"},{"id":"س-04657","fp":"6fec1f5f9e4c","stateId":649,"easy":"إذا كنت مؤمناً ← تكون الصلاة عند رأسك فتقول: ما قِبلي مدخل"},{"id":"س-04672","fp":"901d01708dce","stateId":649,"easy":"إذا قرأت «تبارك الذي بيده الملك» كل ليلة ← يمنعك الله بها من عذاب القبر"},{"id":"س-04622","fp":"7b6a90745d37","stateId":649,"easy":"إذا كنت سريعاً في طاعة الله بطيئاً في معصيته ← تُبشّر في قبرك برضوان وجنات"},{"id":"س-04146","fp":"40356dee0b3b","stateId":649,"easy":"إذا قتلك بطنك ← لن تُعذب في قبرك"},{"id":"س-04610","fp":"038b2e872017","stateId":649,"easy":"إذا استنزهت من البول ← تنجو من عامة عذاب القبر"},{"id":"س-04628","fp":"73c4678dcac9","stateId":650,"easy":"إذا قلت في قبرك «جاءنا بالبينات والهدى فأجبنا» ← يقال لك: نم صالحاً"},{"id":"س-07756","fp":"365648b035e9","stateId":650,"easy":"إذا شهدت في قبرك أن لا إله إلا الله وأن محمداً رسول الله ← يثبتك الله بالقول الثابت"},{"id":"س-04618","fp":"fd4fdbb71eaf","stateId":650,"easy":"إذا قلت في قبرك «ربي الله وديني الإسلام ونبيي محمد» ← يقال لك: صدقت"},{"id":"س-04649","fp":"9932558a3b90","stateId":650,"easy":"إذا شهدت في قبرك أن محمداً رسول الله ← يُريك الله مقعدك من النار قد أُبدل لك مقعداً من الجنة"},{"id":"س-04141","fp":"f3eddba089b0","stateId":651,"easy":"إذا مت مؤمناً ← تكون روحك طائراً يعلق في شجر الجنة حتى البعث"},{"id":"س-04633","fp":"7a93a4a5c369","stateId":651,"easy":"إذا دخلت قبرك مؤمناً ← ترى مقعدك من الجنة"},{"id":"س-04138","fp":"69554ac18eba","stateId":651,"easy":"إذا كنت مؤمناً ← يُفسح لك في قبرك سبعون ذراعاً"},{"id":"ق-0208","fp":"ee36a6ac3ce2","stateId":652,"easy":"تسويف التوبة حتى حضور الموت ← لا تُقبل التوبة"},{"id":"س-07677","fp":"ce8c34b1e090","stateId":652,"easy":"إذا تحولت قبل موتك فعملت عمل أهل النار ← تموت فتدخل النار"},{"id":"س-08450","fp":"439716daa9fb","stateId":652,"easy":"إذا رفضت السجود كبراً ← تموت كافراً (من واقعة)"},{"id":"س-04973","fp":"21a8944a602b","stateId":652,"easy":"إذا نحرت نفسك ← لا يصلي عليك أهل الفضل"},{"id":"س-04653","fp":"3462c0f5f4aa","stateId":653,"easy":"إذا كنت منافقاً فقلت في القبر «لا أدري» ← تلتئم عليك الأرض حتى تختلف أضلاعك"},{"id":"س-04623","fp":"5c4a57a7f719","stateId":653,"easy":"إذا مت كافراً ← تنزل إليك ملائكة غلاظ شداد سود الوجوه"},{"id":"س-04624","fp":"81224f8f90b7","stateId":653,"easy":"إذا قلت في القبر «لا أدري، سمعت الناس يقولون» ← يُفرش لك من النار ويُضيّق عليك قبرك"},{"id":"ق-0364","fp":"96641e5f6c49","stateId":653,"easy":"الافتراء على الله والاستكبار عن آياته ← عذاب الهُون عند الموت"},{"id":"ق-0469","fp":"78e91cafed6a","stateId":653,"easy":"الكفر ← ضرب الملائكة الوجوه والأدبار عند الوفاة وعذاب الحريق"},{"id":"س-04114","fp":"240c4b7dddfc","stateId":654,"easy":"إذا متّ على خطيئتك وذنبك ← تُعذّب بها"},{"id":"س-04606","fp":"6f20713bb118","stateId":654,"easy":"إذا مشيت بالنميمة ← تُعذّب في قبرك"},{"id":"س-04674","fp":"4d416dc43930","stateId":654,"easy":"إذا عصيت النهي ← تُعذّب في قبرك"},{"id":"س-04625","fp":"26b9bbe16156","stateId":654,"easy":"إذا كنت بطيئاً عن طاعة الله سريعاً إلى معصيته ← يُقيّض لك في قبرك أعمى أصم أبكم يضربك"},{"id":"س-04559","fp":"bcdcdfb9fe55","stateId":654,"easy":"إذا منعت المرأة أولادها لبنها ← تنهش ثديها الحيات"},{"id":"س-05113","fp":"90975d77c90d","stateId":655,"easy":"إذا نِيح عليك ← تُعذّب بما نيح عليك"},{"id":"س-04112","fp":"4d2763a0373c","stateId":655,"easy":"إذا بكى أهلك عليك (نياحةً) ← تُعذّب في قبرك"},{"id":"س-06644","fp":"04aaedb11034","stateId":656,"easy":"إذا فارقت الجماعة ← تموت ميتة جاهلية"},{"id":"س-07352","fp":"d14fb2e943d0","stateId":656,"easy":"إذا قُتلت تحت راية عمية تغضب أو تقاتل للعصبية ← فقتلتك جاهلية"},{"id":"س-02563","fp":"dc388f486721","stateId":657,"easy":"إذا استطعت الحج فلم تحج بلا عذر ← فمت إن شئت يهودياً أو نصرانياً"},{"id":"س-06963","fp":"420e1ff90fb5","stateId":658,"easy":"إذا كرهت لقاء الله ← كره الله لقاءك"},{"id":"س-02013","fp":"4d988be43646","stateId":659,"easy":"إذا تصدقت ← تكون في ظل صدقتك حتى يُفصل بين الناس"},{"id":"س-00864","fp":"7bbf40023429","stateId":659,"easy":"إذا كنت إماماً عادلاً أو شاباً نشأ في عبادة الله أو قلبك معلق بالمساجد ← يظلك الله في ظله يوم لا ظل إلا ظله"},{"id":"س-00889","fp":"961a1dc8a276","stateId":659,"easy":"إذا ذكرت الله خالياً ففاضت عيناك ← يظلك الله في ظله"},{"id":"س-05989","fp":"b4917e812a4a","stateId":659,"easy":"إذا نشأت في عبادة الله أو كنت إماماً مقسطاً أو دعتك امرأة حسناء فتعففت ← يظلك الله في ظل عرشه"},{"id":"س-00900","fp":"b965dd55ae16","stateId":660,"easy":"إذا صليت على النبي ﷺ أو سألت له الوسيلة ← حقّت لك شفاعته يوم القيامة"},{"id":"س-01528","fp":"fd65d5e909db","stateId":660,"easy":"إذا سألت للنبي ﷺ الوسيلة ← حلّت لك الشفاعة"},{"id":"س-07800","fp":"7f936368c592","stateId":661,"easy":"إذا قرأت القرآن ← يأتي يوم القيامة شفيعاً لك"},{"id":"س-02458","fp":"82f8e33ee1ee","stateId":662,"easy":"إذا قلت «لا إله إلا الله» ← تجب لك بها الشفاعة يوم القيامة"},{"id":"س-01224","fp":"16b65cfa70f6","stateId":662,"easy":"إذا قلت «لا إله إلا الله» خالصاً من قلبك ← تكون أسعد الناس بشفاعة النبي ﷺ"},{"id":"س-07600","fp":"b7441ef948e1","stateId":663,"easy":"إذا استطعت أن تموت بالمدينة ← يكون لك النبي ﷺ شهيداً أو شفيعاً"},{"id":"س-02135","fp":"11ae3e070f77","stateId":664,"easy":"إذا صلى عليك مئة من المسلمين يشفعون لك ← يُشفّعون فيك"},{