030","fp":"b6cd165b4990","stateId":672,"easy":"إذا صبرت على الأثرة ← تلقى النبي ﷺ على الحوض"},{"id":"س-06583","fp":"54ae3cb2f885","stateId":672,"easy":"إذا لم تصدق الظلمة بكذبهم ولم تعنهم على ظلمهم ← فأنت من النبي ﷺ وترد عليه حوضه"},{"id":"س-01512","fp":"d73a95624ba0","stateId":673,"easy":"إذا رفعت صوتك بالأذان ← لا يسمع مدى صوتك جن ولا إنس ولا شيء إلا شهد لك"},{"id":"س-01519","fp":"71f0a0e9cb1e","stateId":673,"easy":"إذا رفعت صوتك بالأذان ← يشهد لك كل من يسمعه"},{"id":"س-08406","fp":"2f7579c1ff3c","stateId":673,"easy":"إذا استلمت الحجر بحق ← يبعثه الله يوم القيامة له عينان ولسان يشهد لك"},{"id":"س-08434","fp":"00d478a86a2b","stateId":674,"easy":"إذا عبدت الله ولم تشرك به ← فحقك على الله ألا يعذبك"},{"id":"س-01695","fp":"879d374f9522","stateId":674,"easy":"إذا وافيت يوم القيامة تقول «لا إله إلا الله» تبتغي وجه الله ← حُرّمت على النار"},{"id":"س-02386","fp":"0bf4b5106985","stateId":674,"easy":"إذا شهدت الشهادتين صادقاً ← لا تدخل النار"},{"id":"س-01228","fp":"3de65d6c0ac4","stateId":675,"easy":"إذا قلت «لا إله إلا الله» وفي قلبك من الخير وزن شعيرة ← تخرج من النار"},{"id":"س-01239","fp":"6128a5873285","stateId":675,"easy":"إذا شهدت أن لا إله إلا الله مخلصاً ← تُستخرج من النار"},{"id":"س-02810","fp":"b9b8a5407a20","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يباعد الله وجهك عن حر جهنم سبعين خريفاً"},{"id":"س-02316","fp":"b968933ac38a","stateId":676,"easy":"إذا صمت يوماً في سبيل الله ← يباعدك الله من النار مئة عام"},{"id":"س-03096","fp":"d4d8fbf58f4d","stateId":676,"easy":"إذا صمت الدهر ← تضيق عليك جهنم هكذا"},{"id":"س-01433","fp":"c82fee8064a8","stateId":677,"easy":"إذا أعتقت رجلاً مسلماً ← كان فكاكك من النار عضواً بعضو"},{"id":"س-06802","fp":"aae47b608e9a","stateId":677,"easy":"إذا أعتقت رجلاً مسلماً ← يجعل الله كل عظم منه وقاءً لعظم منك من النار"},{"id":"س-06832","fp":"fca5a424c39b","stateId":677,"easy":"إذا كنت يوم عرفة ← فما من يوم أكثر عتقاً من النار منه"},{"id":"س-06376","fp":"7601f7ac3cef","stateId":678,"easy":"إذا تصدقتِ ← تتقين النار (فأكثر النساء حطب جهنم)"},{"id":"س-06250","fp":"d030c9448cfb","stateId":678,"easy":"إذا استطعت أن تقي وجهك حر النار ولو بشق تمرة ← فافعل"},{"id":"س-07154","fp":"09ecd43dbc0b","stateId":678,"easy":"إذا أديت زكاة مالك ← فليس بكنز"},{"id":"س-03203","fp":"79cea6d4ed41","stateId":679,"easy":"إذا قتلت كافراً معتدياً ثم سددت بعده ← لا تجتمعان في النار"},{"id":"س-02060","fp":"05543821b7c9","stateId":679,"easy":"إذا اغبرّت قدماك في سبيل الله ← لا تمسك النار"},{"id":"س-05455","fp":"20cb60ceb571","stateId":679,"easy":"إذا أصابك غبار في سبيل الله ← لا يجتمع ودخان جهنم في منخريك"},{"id":"ق-1330","fp":"00b1e165d3ec","stateId":679,"easy":"الإيمان بالله ورسوله والجهاد في سبيله بالمال والنفس ← النجاة من عذاب أليم ومغفرة وجنات ومساكن طيبة ونصر من الله وفتح قريب"},{"id":"س-05467","fp":"052ef59a5d66","stateId":680,"easy":"إذا خفت النار ← تُجنّب منها"},{"id":"س-00858","fp":"f53e7cb45fa7","stateId":681,"easy":"إذا كبّرت وحمدت وهلّلت وسبّحت واستغفرت وعزلت الأذى عن الطريق ← تمشي يومئذ وقد زحزحت نفسك عن النار"},{"id":"س-01169","fp":"ad8f895dd589","stateId":681,"easy":"إذا قلت صباحاً «اللهم إنا أصبحنا نشهدك ونشهد حملة عرشك...» ← يعتق الله ربعك من النار في ذلك اليوم"},{"id":"س-04300","fp":"475ec39b1346","stateId":681,"easy":"إذا تعوذت بالله من النار ثلاثاً ← تقول النار: اللهم أعذه مني"},{"id":"س-03234","fp":"3e3af0eb0cc5","stateId":681,"easy":"إذا استجرت من النار ثلاث مرات ← تقول النار: يا رب إن عبدك استجار مني فأجره"},{"id":"س-07096","fp":"cc477e3b0e5f","stateId":682,"easy":"إذا قدّمت المرأة ثلاثة من ولدها ← كانوا لها حجاباً من النار"},{"id":"س-02714","fp":"3c9c0ef8365a","stateId":682,"easy":"إذا ابتُليت بالبنات فأحسنت إليهن ← كن لك ستراً من النار"},{"id":"س-04246","fp":"9371432adc38","stateId":682,"easy":"إذا كان لك ثلاث بنات فصبرت عليهن وأطعمتهن وكسوتهن ← كن لك حجاباً من النار"},{"id":"س-03464","fp":"a2e83ed07ee1","stateId":683,"easy":"إذا كففت غضبك ← يكف الله عنك عذابه"},{"id":"س-01750","fp":"956ee4307210","stateId":683,"easy":"إذا حسّن الله خلقك وخُلقك ← فلا تطعمك النار"},{"id":"س-06615","fp":"858f54133233",