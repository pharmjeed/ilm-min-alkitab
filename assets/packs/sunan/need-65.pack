{"schema":1,"kind":"sunan-chunk","version":"sunan-b41390b43331","needId":65,"stateIds":[659,660,661,662,663,664,665,666,667,668,669,670,671,672,673],"items":[{"id":"س-02013","fp":"4d988be43646","stateId":659,"easy":"إذا تصدقت ← تكون في ظل صدقتك حتى يُفصل بين الناس","cause":"صَدَقَتِه","result":"كلُّ امرِئٍ في ظِلِّ صَدَقَتِه حتَّى يُفصَلَ بيْنَ النَّاسِ","explicit":true,"star":true,"similar":["س-08397"],"ref":"المستدرك على الصحيحين 1537","srcLabel":"مسلم","text":[["كلُّ امرِئٍ في ظِلِّ صَدَقَتِه حتَّى يُفصَلَ بيْنَ النَّاسِ",2]," -أو قالَ: حتَّى يُحكَمَ بيْنَ النَّاسِ قالَ يَزيدُ: وكان أبو الخَيرِ لا يُخطِئُه يَومٌ لا يَتصَدَّقُ فيه بشَيءٍ، ولو كَعكةً، ولو بَصَلةً."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (17333)، وابن خزيمة (2431)، وابن حبان (3310) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7wDJy6Qr","merged":3,"otherRefs":["تخريج صحيح ابن حبان 3310 (صحيح)","الزواجر عن اقتراف الكبائر 1/193 (صحيح)"]},{"id":"س-00864","fp":"7bbf40023429","stateId":659,"easy":"إذا كنت إماماً عادلاً أو شاباً نشأ في عبادة الله أو قلبك معلق بالمساجد ← يظلك الله في ظله يوم لا ظل إلا ظله","cause":"الإمامُ العادِلُ، وشابٌّ نَشَأ بعِبادةِ اللهِ، ورَجُلٌ قَلبُه مُعَلَّقٌ في المَساجِدِ، ورَجُلانِ تَحابَّا في اللهِ اجتَمَعا عليه وتَفَرَّقا عليه، ورَجُلٌ دَعَتْه امرَأةٌ ذاتُ مَنصِبٍ وجَمالٍ","result":"سَبعةٌ يُظِلُّهمُ اللهُ في ظِلِّه يَومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"similar":["س-05989","س-05470"],"ref":"صحيح مسلم 1031","srcLabel":"متفق عليه","text":[["سَبعةٌ يُظِلُّهمُ اللهُ في ظِلِّه يَومَ لا ظِلَّ إلَّا ظِلُّه",2],":",[" الإمامُ العادِلُ، وشابٌّ نَشَأ بعِبادةِ اللهِ، ورَجُلٌ قَلبُه مُعَلَّقٌ في المَساجِدِ، ورَجُلانِ تَحابَّا في اللهِ اجتَمَعا عليه وتَفَرَّقا عليه، ورَجُلٌ دَعَتْه امرَأةٌ ذاتُ مَنصِبٍ وجَمالٍ",1],"، فقال: إنِّي أخافُ اللهَ، ورَجُلٌ تَصَدَّقَ بصَدَقةٍ فأخفاها حتَّى لا تَعلَمَ يَمينُه ما تُنفِقُ شِمالُه، ورَجُلٌ ذَكَرَ اللهَ خاليًا، ففاضَت عَيناه. [وفي روايةٍ]: ورَجُلٌ مُعَلَّقٌ بالمَسجِدِ إذا خَرَجَ منه حتَّى يَعودَ إليه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (660)، ومسلم (1031).","bab":"أدعية وأذكار › فضل الذكر","dorar":"ghdpFJ0i"},{"id":"س-00889","fp":"961a1dc8a276","stateId":659,"easy":"إذا ذكرت الله خالياً ففاضت عيناك ← يظلك الله في ظله","cause":"رَجُلٌ ذَكَرَ اللهَ ففاضَت عَيناه","result":"سَبعةٌ يُظِلُّهمُ اللهُ","explicit":true,"star":true,"ref":"صحيح البخاري 6479","srcLabel":"متفق عليه","text":[["سَبعةٌ يُظِلُّهمُ اللهُ",2],":",[" رَجُلٌ ذَكَرَ اللهَ ففاضَت عَيناه.",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6479)، ومسلم (1031) مطولاً","bab":"أدعية وأذكار › فضل الذكر","dorar":"Kj9NqMDl"},{"id":"س-05989","fp":"b4917e812a4a","stateId":659,"easy":"إذا نشأت في عبادة الله أو كنت إماماً مقسطاً أو دعتك امرأة حسناء فتعففت ← يظلك الله في ظل عرشه","cause":"شابٌّ نشأَ في عِبادةِ اللهِ تَعالى، وإمامٌ مُقسِطٌ، ورَجلٌ دَعَتْه امرأةٌ حَسناءُ ذاتُ حَسَبٍ إلى نفْسِها","result":"سِتَّةٌ يُظِلُّهمُ اللهُ تَعالى في ظِلِّ عَرشِه يومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"repOf":"س-00864","ref":"تخريج مشكل الآثار 5845","text":[["سِتَّةٌ يُظِلُّهمُ اللهُ تَعالى في ظِلِّ عَرشِه يومَ لا ظِلَّ إلَّا ظِلُّه",2],":",[" شابٌّ نشأَ في عِبادةِ اللهِ تَعالى، وإمامٌ مُقسِطٌ، ورَجلٌ دَعَتْه امرأةٌ حَسناءُ ذاتُ حَسَبٍ إلى نفْسِها",1],"، فقال: إنِّي أخافُ اللهَ ربَّ العالَمينَ، ورَجلٌ أخْفى يَمينُه عن شِمالِه صدَقَتَه، ورَجلٌ قَلبُه مُتعلِّقٌ في مساجِدِ اللهِ تَعالى، ورَجلانِ تَواخَيا في اللهِ، ثُم افتَرَقا على ذلك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (660)، ومسلم (1031)، والترمذي (2391) جميعا باختلاف يسير.","bab":"رقائق وزهد › تقوى الله","dorar":"9bzgNMra"},{"id":"س-01747","fp":"6d387e481d49","stateId":659,"easy":"إذا أنظرت معسراً أو وضعت عنه ← يظلك الله يوم لا ظل إلا ظله","cause":"أنسَأَ مُعسِرًا إلى مَيسَرتِه، أو محا عنه","result":"أظَلَّ اللهُ عزَّ وجلَّ رَجُلًا يومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"similar":["س-03144","س-06926","س-07026","س-02197","س-02636"],"ref":"تخريج مشكل الآثار 3822","srcLabel":"مسلم","text":["كان ابنُ عُمَرَ يَتقاضى رَجُلًا، فتَوارى عنه، فناداه: أتَحبِسُني وتَوارى عنِّي؟ فقال: ما فَعَلتُ ذلك إلَّا أنِّي لا أجِدُ ما أقضيكَ، قال: آللهِ؟ قال: آللهِ، فأخَذَ صَكَّه فمَحاه! ثُمَّ قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["أظَلَّ اللهُ عزَّ وجلَّ رَجُلًا يومَ لا ظِلَّ إلَّا ظِلُّه",2],"، ",["أنسَأَ مُعسِرًا إلى مَيسَرتِه، أو محا عنه",1],"."],"grade":"صحيح","narrator":"نافع","muhaddith":"إسناده صحيح على شرح مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3822)، بلفظه.","bab":"أيمان › الحلف بالله وصفاته وكلماته","dorar":"Gl3F4Vdd"},{"id":"س-03144","fp":"d71e4f020a96","stateId":659,"easy":"إذا أنظرت معسراً أو وضعت عنه ← يظلك الله في ظل عرشه يوم القيامة","cause":"مَن أَنظَرَ مُعسِرًا -أو وضَعَ له","result":"أظَلَّه اللهُ في ظِلِّ عرشِه يومَ القيامةِ","explicit":true,"repOf":"س-01747","ref":"تخريج المسند لشعيب 8711","text":[["مَن أَنظَرَ مُعسِرًا -أو وضَعَ له- ",1],["أظَلَّه اللهُ في ظِلِّ عرشِه يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (1306)، وأحمد (8711) واللفظ له","bab":"إيمان › توحيد الأسماء والصفات","dorar":"4cwLcz2r"},{"id":"س-08438","fp":"0b3e1d15dd6e","stateId":659,"easy":"إذا تحاببت في الله ← يظلك الله بظل عرشه يوم لا ظل إلا ظله","cause":"المُتحابُّونَ في اللهِ عزَّ وجلَّ","result":"يُظِلُّهم اللهُ عزَّ وجلَّ بظِلِّ عرشِه يومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"ref":"تخريج مشكل الآثار 3892","srcLabel":"أحمد","text":["دخَلتُ مسجدَ حِمْصَ فقعَدْتُ في حَلْقةٍ فيها نيِّفٌ وثلاثونَ مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، منهم يقولُ: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ كذا وكذا، ويُنصِتُ الآخَرونَ، ويقولُ الرجلُ منهم: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ كذا، ويُنصِتُ الآخَرونَ، وفيهم فتًى أَدْعَجُ بَرَّاقُ الثَّنَايَا، إذا اختلَفوا في شيءٍ انتهَوْا إلى قولِه، فلمَّا انصرَفتُ إلى منزلي بِتُّ بأطوَلِ ليلةٍ، فقلتُ: جلَستُ في حلْقةٍ فيها كذا وكذا مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، لا أعرِفُ مَنازِلَهم ولا أسماءَهم! فلمَّا أصبحتُ غَدَوْتُ إلى المسجدِ، فإذا الفتى الأدعَجُ قاعدٌ إلى ساريَةٍ، فجلَستُ إليه، فقلتُ: إنِّي لَأُحِبُّكَ للهِ عزَّ وجلَّ، قال: آللهِ، إنَّك لَتُحِبُّني للهِ تبارَكَ وتعالى؟ فقلتُ: آللهِ، إنِّي لأُحِبُّك للهِ عزَّ وجلَّ، فأخَذَ بحُبْوَتِي حتى مَسَّتْ رُكبتِي رُكبتَه، ثمَّ قال: آللهِ، إنَّك لَتُحبُّني للهِ عزَّ وجلَّ؟ فقلتُ: آللهِ، إنِّي لأُحبُّك للهِ عزَّ وجلَّ، فقال: أفلا أُخبِرُك بشيءٍ سمعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقلتُ: بلى، فقال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["المُتحابُّونَ في اللهِ عزَّ وجلَّ",1]," ",["يُظِلُّهم اللهُ عزَّ وجلَّ بظِلِّ عرشِه يومَ لا ظِلَّ إلَّا ظِلُّه",2],"، قال: فبَيْنا نحن كذلك إذ مَرَّ رجلٌ ممَّن كان في الحلْقةِ، فقُمتُ إليه فقلتُ: إنَّ هذا حدَّثَني بحديثٍ عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فهل سمعتَه منه؟ قال: وما حدَّثَك؟ ما كان لِيُحدِّثَك إلَّا حقًّا، قال: فأخبَرتُه، فقال: سَمِعتُ هذا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وما هو أفضَلُ منه، سمعتُه يقولُ يَأْثُرُ عن اللهِ عزَّ وجلَّ: حَقَّتْ مَحَبَّتِي للمُتحابِّينَ فيَّ، وحقَّتْ للمُتواصِلينَ فيَّ، وحقَّتْ محبَّتي للمُتزاوِرينَ فيَّ، وحقَّتْ محبَّتي للمُتباذِلينَ فيَّ، قُلتُ: مَن أنت يَرحَمُك اللهُ؟ قال: أنا عُبادةُ بنُ الصامتِ، قُلتُ: فمَن الفتى؟ قال: معاذُ بنُ جبلٍ."],"grade":"صحيح","narrator":"معاذ بن جبل وعبادة بن الصامت","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (3892) واللفظ له، وأحمد (22782)، والطبراني في ((الشاميين)) (625) بنحوه.","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"u6v81otP","merged":10,"otherRefs":["المستدرك على الصحيحين 7522 (صحيح)","تخريج المسند لشعيب 22064 (صحيح)","المستدرك على الصحيحين 7521 (صحيح)","تخريج المسند لشعيب 7231 (صحيح)","صحيح الجامع 4320 (صحيح)","صحيح الجامع 1937 (صحيح)","تخريج المسند لشعيب 22783 (صحيح)","تخريج مشكل الآثار 3893 (صحيح)","تخريج المسند لشعيب 22782 (صحيح)"]},{"id":"س-05470","fp":"ec107075b6c8","stateId":659,"easy":"إذا كنت إماماً مقسطاً أو دعتك امرأة ذات جمال ومنصب فقلت إني أخاف الله ← يظلك الله تحت ظل عرشه","cause":"إمامٌ مُقسِطٌ، ورَجُلٌ لقيَته امرَأةٌ ذاتُ جَمالٍ ومَنصِبٍ فعَرَضَت نَفسَها عليه","result":"سَبعةٌ يُظِلُّهم اللَّهُ تَحتَ ظِلِّ عَرشِه يَومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"repOf":"س-00864","ref":"بزوغ الهلال 163","text":[["سَبعةٌ يُظِلُّهم اللَّهُ تَحتَ ظِلِّ عَرشِه يَومَ لا ظِلَّ إلَّا ظِلُّه",2],":",[" إمامٌ مُقسِطٌ، ورَجُلٌ لقيَته امرَأةٌ ذاتُ جَمالٍ ومَنصِبٍ فعَرَضَت نَفسَها عليه",1],"، فقال: إنِّي أخافُ اللَّهَ رَبَّ العالَمينَ، ورَجُلٌ تَعَلَّمَ القُرآنَ في صِغَرِه فهو يَتلوهُ في كِبَرِه، ورَجُلٌ تَصَدَّقَ بصَدَقةٍ بيَمينِه فأخفاها عَن شِمالِه، ورَجُلٌ قَلبُه مُعَلَّقٌ بالمَساجِدِ، ورَجُلٌ أتى رَجُلًا فقال لهُ: إنِّي أُحِبُّكَ في اللَّهِ، ورَجُلٌ ذَكَرَ اللَّهَ بَينَ يَدَيهِ ففاضَت عَيناه خَشيةً مِن اللَّهِ."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه البيهقي في ((الشعب)) (773)، وابن شاذان في ((مشيخته الصغرى)) (32) واللفظ لهما، وأصل الحديث عند البخاري (660) بغير هذه الألفاظ.","bab":"رقائق وزهد › الخوف من الله","dorar":"oJMP8jRM","merged":2,"otherRefs":["تمهيد الفرش 35 (حسن)"]},{"id":"س-08397","fp":"3f6449855f14","stateId":659,"easy":"إذا تصدقت ← تكون صدقتك ظلك يوم القيامة","cause":"صدقتُهُ","result":"ظلُّ المؤمنِ يومَ القِيامةِ","explicit":true,"repOf":"س-02013","ref":"صحيح ابن خزيمة 4/ 159","text":["[عَن] يزيدَ بنِ أبي حبيبٍ، عن مَرثدِ بنِ عبدِ اللَّهِ اليزَنيِّ قالَ: كانَ أوَّلُ أَهْلِ مصرَ يروحُ إلى المسجدِ، وما رأيتُهُ داخلًا المسجدَ قطُّ إلَّا وفي كمِّهِ صدقةٌ، إمَّا فُلوسٌ، وإمَّا خُبزٌ، وإمَّا قَمحٌ حتَّى ربَّما رأيتُ البصَلَ يحملُهُ قالَ: فأقولُ يا أبا الخيرِ إنَّ هذا يُنتنُ ثيابَكَ قالَ: فيقولُ: يا ابنَ حبيبٍ أما إنِّي لم أجد في البيتِ شيئًا أتصدَّقُ بِهِ غيرَهُ، إنَّهُ حدَّثَني رجلٌ مِن أصحابِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ",["ظلُّ المؤمنِ يومَ القِيامةِ",2]," ",["صدقتُهُ",1]],"grade":"صحيح","narrator":"رجل من أصحاب رسول الله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (18043) بلفظ مقارب، والطحاوي في ((شرح مشكل الآثار)) (3837)، وابن زنجويه في ((الأموال)) (1321)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"MTuf6KAl","merged":3,"otherRefs":["تخريج المسند لشعيب 23490 (صحيح)","صحيح الترغيب 873 (حسن)"]},{"id":"س-02871","fp":"c4dc4a836d68","stateId":659,"easy":"إذا أظللت رأس غازٍ ← يظلك الله يوم القيامة","cause":"مَن أظلَّ رأسَ غازٍ","result":"أظلَّه اللهُ يومَ القيامةِ","explicit":true,"similar":["س-04366"],"ref":"إتحاف الخيرة المهرة 2/15","srcLabel":"ابن ماجه","text":[["مَن أظلَّ رأسَ غازٍ ",1],["أظلَّه اللهُ يومَ القيامةِ ، ",2],"ومَن جهَّز غازيًا حتى يستقِلَّ كان له مثلُ أجرِه حتى يموتَ أو يرجِعَ ، ومَن بنى للهِ مسجدًا بنى اللهُ له بيتًا في الجنةِ.  فقال الوليدُ : فذكرتُ ذلك للقاسمِ بنِ محمدٍ ، فقال : قد بلَغني هذا الحديثُ ، قال : قد ذكرتُ ذلك لمحمدِ بنِ المُنكدِرِ وزيدِ بنِ أسلمَ فكلاهما قالا مثلَ ذلك ، وقالا : قد بلَغَنا ذلك"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (735، 2758) مختصراً مفرقاً، وأحمد (126) باختلاف يسير، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/15) واللفظ له","bab":"إيمان › الوعد","dorar":"OnoBmIss","merged":2,"otherRefs":["الأحاديث المختارة 244 (صحيح)"]},{"id":"س-06926","fp":"1bc09ea67dd6","stateId":659,"easy":"إذا يسّرت على معسر أو وضعت عنه ← يظلك الله في ظله يوم لا ظل إلا ظله","cause":"فَلْيُيَسِّرْ على مُعسِرٍ ، أو لِيضعْ عَنهُ","result":"مَن سَرَّه أن يُظِلَّه اللهُ في ظِلِّه يومَ لا ظلَّ إلَّا ظِلُّه","explicit":true,"repOf":"س-01747","ref":"صحيح الترغيب 912","text":[["مَن سَرَّه أن يُظِلَّه اللهُ في ظِلِّه يومَ لا ظلَّ إلَّا ظِلُّه ، ",2],["فَلْيُيَسِّرْ على مُعسِرٍ ، أو لِيضعْ عَنهُ",1]],"grade":"صحيح","narrator":"أسعد بن زرارة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (1/304) (902)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"zP8eaqwY","merged":2,"otherRefs":["تخريج المسند لشعيب 15520 (صحيح)"]},{"id":"س-07026","fp":"033de8f0c9b8","stateId":659,"easy":"إذا أنظرت معسراً أو وضعت عنه ← يظلك الله في ظله","cause":"مَن أنظَرَ مُعسِرًا أو وضَعَ عنه","result":"أظَلَّه اللهُ في ظِلِّه","explicit":true,"repOf":"س-01747","ref":"صحيح مسلم 3006","text":["خَرَجتُ أنا وأبي نَطلُبُ العِلمَ في هذا الحَيِّ مِنَ الأنصارِ قَبلَ أن يَهلِكوا، فكان أوَّلُ مَن لَقينا أبا اليَسَرِ صاحِبَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ومعهُ غُلامٌ له، معهُ ضِمامةٌ مِن صُحُفٍ، وعلى أبي اليَسَرِ بُردةٌ ومعافِريٌّ، وعلى غُلامِه بُردةٌ ومعافِريٌّ، فقال له أبي: يا عَمِّ، إنِّي أرى في وجهِكَ سَفعةً مِن غَضَبٍ، قال: أجَل، كان لي على فُلانِ بنِ فُلانٍ الحَراميِّ مالٌ، فأتَيتُ أهلَه، فسَلَّمتُ، فقُلتُ: ثَمَّ هو؟ قالوا: لا، فخَرَجَ عليَّ ابنٌ له جَفرٌ، فقُلتُ له: أينَ أبوكَ؟ قال: سَمِعَ صَوتَكَ فدَخَلَ أريكةَ أُمِّي، فقُلتُ: اخرُجْ إليَّ؛ فقد عَلِمتُ أينَ أنتَ، فخَرَجَ، فقُلتُ: ما حَمَلَكَ على أنِ اختَبَأتَ مِنِّي؟ قال: أنا واللَّهِ أُحَدِّثُكَ ثُمَّ لا أكذِبُكَ، خَشيتُ واللَّهِ أن أُحَدِّثَكَ فأكذِبَكَ، وأن أعِدَكَ فأُخلِفَكَ، وكُنتَ صاحِبَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وكُنتُ واللَّهِ مُعسِرًا. قال: قُلتُ: آللَّهِ؟ قال: اللهِ، قُلتُ: آللَّهِ؟ قال: اللهِ، قُلتُ: آللَّهِ؟ قال: اللهِ، قال: فأتى بصَحيفَتِه فمَحاها بيَدِه، فقال: إن وجَدتَ قَضاءً فاقضِني، وإلَّا أنتَ في حِلٍّ، فأشهَدُ بَصَرُ عَينَيَّ هاتَينِ -ووضَعَ إصبَعَيه على عَينَيه- وسَمعُ أُذُنَيَّ هاتَينِ، ووعاه قَلبي هذا -وأشارَ إلى مَناطِ قَلبِه- رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم وهو يقولُ: ",["مَن أنظَرَ مُعسِرًا أو وضَعَ عنه ",1],["أظَلَّه اللهُ في ظِلِّه",2],"."],"grade":"صحيح","narrator":"كعب بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (5044)، والحاكم (2224) واللفظ لهما، والطبراني في ((المعجم الكبير)) (19/ 168) (379) باختلاف يسير.","bab":"علم › الحث على طلب العلم","dorar":"u01aL0dg","merged":2,"otherRefs":["المستدرك على الصحيحين 2258 (صحيح)"]},{"id":"س-02197","fp":"31a7e98bdb2d","stateId":659,"easy":"إذا نفّست عن غريمك أو محوت عنه ← تكون في ظل العرش يوم القيامة","cause":"من نفَّسَ عن غريمِهِ أو مَحا عنهُ","result":"كانَ في ظلِّ العرشِ يومَ القيامةِ","explicit":true,"repOf":"س-01747","ref":"عمدة التفسير 1/337","text":["أنَّ أبا قتادةَ كانَ لَهُ دَينٌ على رجلٍ ، وَكانَ يأتيهِ يتقاضاهُ فيختبئُ منهُ ، فجاءَ ذاتَ يومٍ فخرجَ صبيٌّ فسألَهُ عنهُ فقالَ : نعم . هوَ في البيتِ يأكلُ خزيرةً فَناداهُ فقال يا فلانُ ، اخرج فقد أخبرتُ أنَّكَ ههُنا فخرجَ إليهِ فقالَ : ما يغيِّبُكَ عنِّي ؟ فقالَ : إنِّي معسرٌ وليسَ عندي . قالَ : آللَّهِ إنَّكَ معسرٌ ؟ قالَ : نعم . فبَكَى أبو قتادةَ ثمَّ قالَ : سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ : ",["من نفَّسَ عن غريمِهِ أو مَحا عنهُ ",1],["كانَ في ظلِّ العرشِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22623) بلفظه، والدارمي (2631)، والبغوي في ((شرح السنة)) (2143) مختصرًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TJmSkoPI"},{"id":"س-06785","fp":"a53ab90e3cb1","stateId":659,"easy":"إذا أعنت مجاهداً أو غارماً في عسرته أو مكاتباً ← يظلك الله في ظله يوم لا ظل إلا ظله","cause":"مَنْ أَعانَ مُجاهِدًا في سبيلِ اللهِ، أوْ غازيًا، أوْ غارِمًا في عُسرَتِه، أوْ مُكاتَبًا في رَقبتِه","result":"أَظَلَّه اللهُ في ظِلِّه يومَ لا ظِلَّ إلَّا ظِلُّه","explicit":true,"ref":"المستدرك على الصحيحين 2900","srcLabel":"أحمد","text":[["مَنْ أَعانَ مُجاهِدًا في سبيلِ اللهِ، أوْ غازيًا، أوْ غارِمًا في عُسرَتِه، أوْ مُكاتَبًا في رَقبتِه؛ ",1],["أَظَلَّه اللهُ في ظِلِّه يومَ لا ظِلَّ إلَّا ظِلُّه",2],"."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (15986)، والبيهقي (21647) بلفظه.","bab":"عتق وولاء › المكاتب","dorar":"fddTWsFD"},{"id":"س-02636","fp":"cc8d2ea7548f","stateId":659,"easy":"إذا أنظرت معسراً أو تصدقت عليه ← تكون من أول من يستظل في ظل الله","cause":"لرجلٌ أنظرَ معسرًا حتى يجدَ شيئًا أو تصدَّق عليه","result":"إنَّ أولَ الناسِ يستظلُ في ظلِّ اللهِ يومَ القيامةِ","explicit":true,"repOf":"س-01747","ref":"المتجر الرابح 123","text":["أشهدُ على رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: لَسمعتُه يقولُ: ",["إنَّ أولَ الناسِ يستظلُ في ظلِّ اللهِ يومَ القيامةِ",2]," ",["لرجلٌ أنظرَ معسرًا حتى يجدَ شيئًا أو تصدَّق عليه",1]," بما يطلبُه يقولُ: ما لي عليك صدقةٌ ابتغاءَ وجهِ اللهِ ويخرقُ صحيفته."],"grade":"حسن","narrator":"كعب بن عمرو","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (1918)، والطبراني (19/167) (377) واللفظ له","bab":"إيمان › الاحتساب والنية","dorar":"PfBAsasq"},{"id":"س-04366","fp":"bb5d940a21c4","stateId":659,"easy":"إذا أظللت غازياً ← يظلك الله","cause":"من أظلَّ غازيًا","result":"أظلَّه اللهُ","explicit":true,"repOf":"س-02871","ref":"الإصابة في تمييز الصحابة 2/400","text":["عن الوليدِ بن أبي الوليدِ قال : كنتُ بمكَّةَ وعليها عثمانُ بنُ عبدِ الرَّحمنِ بنِ سُراقةَ وهو أميرٌ فسمِعتُه يخطبُهم يقولُ : يا أهلَ مكَّةَ إنَّكم أقبلتم على عمارةِ البيتِ بالطَّوافِ وتركتم الجهادَ في سبيلِ اللهِ ولا أعنتم المجاهدين ، فإنِّي سمِعتُ أبي يقولُ سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وآلِه وسلَّم يقولُ : ",["من أظلَّ غازيًا ",1],["أظلَّه اللهُ ",2],"ومن جهَّز غازيًا حتَّى يستقِلَّ كان له مثلُ أجرِه … قال : فسألتُ عنه فقيل له إنَّه ابنُ بنتِ عمرَ"],"grade":"حسن","narrator":"عبدالرحمن بن سراقة بن المعتمر","muhaddith":"حسن","takhrij":"أخرجه الطبري في ((تهذيب الآثار)) كما في ((تهذيب التهذيب)) (7/ 119) واللفظ له.","bab":"جهاد › الترغيب في الجهاد","dorar":"0xMHvRsf"},{"id":"س-05422","fp":"e7099eedff89","stateId":659,"easy":"إذا صليت على الجنائز فحزنت ← فالحزين في ظل الله","cause":"وصَلِّ على الجنائزِ","result":"لعلَّ ذلك أن يُحزِنَك ، فإنَّ الحزينَ في ظلِّ اللهِ يتعرَّضُ كلَّ خيرٍ","explicit":true,"otherNeedIds":[19],"ref":"الترغيب والترهيب 4/258","srcLabel":"الحاكم","text":["زُرِ القبورَ تذكُرْ بها الآخرةَ ، واغسِلِ الموتَى فإنَّ معالجةَ جسدٍ خاوٍ موعظةٌ بليغةٌ ، ",["وصَلِّ على الجنائزِ",1]," ",["لعلَّ ذلك أن يُحزِنَك ، فإنَّ الحزينَ في ظلِّ اللهِ يتعرَّضُ كلَّ خيرٍ",2]],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رواته ثقات","takhrij":"أخرجه ابن شاهين في ((الترغيب في فضائل الأعمال)) (470)، والحاكم (1395)، والبيهقي في ((شعب الإيمان)) (9291) واللفظ له","bab":"رقائق وزهد › الحزن والبكاء","dorar":"0jjgBRRb"},{"id":"س-02279","fp":"b8e21edbbd15","stateId":659,"easy":"إذا عملت صالحاً ← تظلك أعمالك يوم القيامة (أثر أبي موسى)","cause":"وأعمالُهم","result":"تُظِلُّهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المواهب اللدنية 3/637","srcLabel":"المواهب اللدنية","text":["عن أبي مُوسَى رَضي اللهُ عنه قال: الشَّمسُ فوقَ رُؤوسِ الناسِ يومَ القِيامةِ، ",["وأعمالُهم",1]," ",["تُظِلُّهم",2],"."],"grade":"حسن","muhaddith":"إسناده قوى","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ePy4ZKF6"},{"id":"س-07827","fp":"a41dc271d0fb","stateId":659,"easy":"إذا أدبت أولادك على حب نبيهم وآل بيته وقراءة القرآن ← فحملة القرآن في ظل الله يوم لا ظل إلا ظله","cause":"أدِّبوا أولادَكُم على ثَلاثِ خِصالٍ: حُبِّ نَبيِّكُم، وحُبِّ أهلِ بَيتِه، وعَلى قِراءةِ القُرآنِ","result":"فإنَّ حَمَلةَ القُرآنِ في ظِلِّ اللَّهِ يَومَ لا ظِلَّ إلَّا ظِلُّه، مَعَ أنبيائِه وأصفيائِه","explicit":true,"ref":"تمهيد الفرش 93","srcLabel":"تمهيد الفرش","text":[["أدِّبوا أولادَكُم على ثَلاثِ خِصالٍ: حُبِّ نَبيِّكُم، وحُبِّ أهلِ بَيتِه، وعَلى قِراءةِ القُرآنِ؛ ",1],["فإنَّ حَمَلةَ القُرآنِ في ظِلِّ اللَّهِ يَومَ لا ظِلَّ إلَّا ظِلُّه، مَعَ أنبيائِه وأصفيائِه",2],"."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"غريب، وله شاهد جيد","bab":"قرآن › فضل قراءة القرآن","dorar":"902qvFrB"},{"id":"س-00900","fp":"b965dd55ae16","stateId":660,"easy":"إذا صليت على النبي ﷺ أو سألت له الوسيلة ← حقّت لك شفاعته يوم القيامة","cause":"من صلَّى عليَّ أو سأل لي الوسيلةَ","result":"حقَّت عليه شفاعتي يومَ القيامةِ","explicit":true,"star":true,"similar":["س-01528","س-01532","س-01489","س-01716","س-02887"],"ref":"فضل الصلاة 50","srcLabel":"مسلم","text":[["من صلَّى عليَّ أو سأل لي الوسيلةَ ، ",1],["حقَّت عليه شفاعتي يومَ القيامةِ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح ورجال إسناده ثقات","takhrij":"أخرجه مسلم (384) مطولاً باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"jZq2ZAmh"},{"id":"س-01528","fp":"fd65d5e909db","stateId":660,"easy":"إذا سألت للنبي ﷺ الوسيلة ← حلّت لك الشفاعة","cause":"فمن سألَ ليَ الوسيلةَ","result":"حلَّت لَهُ الشَّفاعةُ","explicit":true,"repOf":"س-00900","ref":"صحيح ابن خزيمة 1/ 499","text":["إذا سَمِعْتُمُ المؤذِّنَ فَقولوا مثلَ ما يقولُ، ثُمَّ صلُّوا عليَّ فإنَّهُ مَن صلَّى عليَّ صلاةً صلَّى اللَّهُ عليهِ عَشرًا، ثمَّ سلوا اللَّهَ ليَ الوسيلةَ، وإنَّها درجةٌ في الجنَّةِ لا تنبَغي إلَّا لِعبدٍ من عبَّادِ اللَّهِ، ",["فمن سألَ ليَ الوسيلةَ ",1],["حلَّت لَهُ الشَّفاعةُ -",2]," وفي روايةٍ - قالَ: وأرجو أن أَكونَ أَنا هوَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (384)، وأبو داود (523)، والنسائي (678) باختلاف يسير","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"B7NK0MAI"},{"id":"س-01532","fp":"dad4160db4e0","stateId":660,"easy":"إذا سألت للنبي ﷺ الوسيلة ← حلّت لك شفاعته يوم القيامة","cause":"ومَن سأَلها لي","result":"حلَّتْ له شفاعتي يومَ القيامةِ","explicit":true,"repOf":"س-00900","ref":"تخريج صحيح ابن حبان 1691","text":["إذا سمِعْتُم المُؤذِّنُ فقولوا كما يقولُ وصَلُّوا علَيَّ فإنَّه ليس أحَدٌ يُصلِّي علَيَّ صلاةً إلَّا صلَّى اللهُ عليه عَشْرًا وسَلُوا لي الوسيلةَ فإنَّ الوسيلةَ مَنزِلةٌ في الجنَّةِ ولا تنبغي أنْ تكونَ إلَّا لِعبدٍ مِن عبادِ اللهِ وأرجو أنْ أكونَ أنا هو ",["ومَن سأَلها لي",1]," ",["حلَّتْ له شفاعتي يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (384) باختلاف يسير","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"mXEMo2RC"},{"id":"س-01489","fp":"5316ac8901eb","stateId":660,"easy":"إذا قلت عند سماع النداء «اللهم رب هذه الدعوة التامة...» ← حلّت لك شفاعة النبي ﷺ يوم القيامة","cause":"مَن قالَ حِينَ يَسْمَعُ النِّداءَ: اللَّهُمَّ رَبَّ هذِه الدَّعْوَةِ التَّامَّةِ، والصَّلاةِ القائِمَةِ، آتِ مُحَمَّدًا الوَسِيلَةَ والفَضِيلَةَ، وابْعَثْهُ مَقامًا مَحْمُودًا الذي وعَدْتَهُ","result":"حَلَّتْ له شَفاعَتي يَومَ القِيامَةِ","explicit":true,"apply":{"k":"say","t":"«اللَّهُمَّ رَبَّ هذِه الدَّعْوَةِ التَّامَّةِ، والصَّلاةِ القائِمَةِ، آتِ مُحَمَّدًا الوَسِيلَةَ والفَضِيلَةَ، وابْعَثْهُ مَقامًا مَحْمُودًا الذي وعَدْتَهُ، حَلَّتْ له شَفاعَتي يَومَ القِيامَةِ رَواهُ حَمْزَةُ بنُ عبدِ اللَّهِ، عن أبِيهِ، عَنِ النبيِّ صَلَّى اللهُ عليه وسلَّم» · الوقت: عند الأذان"},"repOf":"س-00900","ref":"فتاوى نور على الدرب لابن باز 14/144","text":["أحاديثُ الشَّفاعةِ [حديث جابر بن عبدالله: ",["مَن قالَ حِينَ يَسْمَعُ النِّداءَ: اللَّهُمَّ رَبَّ هذِه الدَّعْوَةِ التَّامَّةِ، والصَّلاةِ القائِمَةِ، آتِ مُحَمَّدًا الوَسِيلَةَ والفَضِيلَةَ، وابْعَثْهُ مَقامًا مَحْمُودًا الذي وعَدْتَهُ، ",1],["حَلَّتْ له شَفاعَتي يَومَ القِيامَةِ",2]," رَواهُ حَمْزَةُ بنُ عبدِ اللَّهِ، عن أبِيهِ، عَنِ النبيِّ صَلَّى اللهُ عليه وسلَّمَ.]                             [وحديث أبي هريرة: لِكُلِّ نَبِيٍّ دَعْوَةٌ مُسْتَجابَةٌ يَدْعُو بها، وأُرِيدُ أنْ أخْتَبِئَ دَعْوَتي شَفاعَةً لِأُمَّتي في الآخِرَةِ.]                       [وحديث أنس بن مالك: كُلُّ نَبِيٍّ سَأَلَ سُؤْلًا أوْ قالَ: لِكُلِّ نَبِيٍّ دَعْوَةٌ قدْ دَعا بها فاسْتُجِيبَ، فَجَعَلْتُ دَعْوَتي شَفاعَةً لِأُمَّتي يَومَ القِيامَةِ.]                          [وحديث ابن عمر:سَمِعْتُ ابْنَ عُمَرَ رَضِيَ اللَّهُ عنْهمَا، يقولُ: إنَّ النَّاسَ يَصِيرُونَ يَومَ القِيَامَةِ جُثًا، كُلُّ أُمَّةٍ تَتْبَعُ نَبِيَّهَا يقولونَ: يا فُلَانُ اشْفَعْ، يا فُلَانُ اشْفَعْ، حتَّى تَنْتَهي الشَّفَاعَةُ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَذلكَ يَومَ يَبْعَثُهُ اللَّهُ المَقَامَ المَحْمُودَ]"],"grade":"صحيح","narrator":"[جابر بن عبدالله وأبو هريرة وأنس بن مالك وعبدالله بن عمر]","muhaddith":"متواترة","bab":"أذان › الأذكار بعد الأذان","dorar":"Bd1quNHY","merged":2,"otherRefs":["تخريج كتاب السنة 826 (صحيح)"]},{"id":"س-01716","fp":"0e007daecffb","stateId":660,"easy":"إذا سألت للنبي ﷺ الوسيلة ← يكون لك شهيداً أو شفيعاً يوم القيامة","cause":"سلوا اللَّهَ لي الوسيلةَ ، فإنَّهُ لم يسألها لي عبدٌ في الدُّنيا","result":"إلَّا كنتُ لَهُ شَهيدًا ، أو شفيعًا يومَ القيامةِ","explicit":true,"repOf":"س-00900","ref":"الترغيب والترهيب 1/152","text":[["سلوا اللَّهَ لي الوسيلةَ ، فإنَّهُ لم يسألها لي عبدٌ في الدُّنيا",1]," ",["إلَّا كنتُ لَهُ شَهيدًا ، أو شفيعًا يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (30206)، والطبراني في ((المعجم الأوسط)) (633) واللفظ له، والضياء في ((الأحاديث المختارة)) (96)","bab":"أنبياء › خصائص وفضائل","dorar":"UDV7VzWC"},{"id":"س-00785","fp":"8176aa40a2d9","stateId":660,"easy":"إذا صليت على النبي ﷺ عشراً أو مئة أو ألفاً ← يكون لك شفيعاً وشهيداً يوم القيامة","cause":"مَن صَلَّى عليَّ عَشرًا صَلَّى اللهُ عليه مِائةً، ومَن صَلَّى عليَّ مِائةً صَلَّى اللهُ عليه ألفًا، ومَن زادَ صَبابةً وشَوقًا","result":"كُنتُ له شَفيعًا وشَهيدًا يَومَ القيامةِ","explicit":true,"otherNeedIds":[35,62],"ref":"سبل الهدى والرشاد 12/424","srcLabel":"سبل الهدى والرشاد","text":["«",["مَن صَلَّى عليَّ عَشرًا صَلَّى اللهُ عليه مِائةً، ومَن صَلَّى عليَّ مِائةً صَلَّى اللهُ عليه ألفًا، ومَن زادَ صَبابةً وشَوقًا ",1],["كُنتُ له شَفيعًا وشَهيدًا يَومَ القيامةِ»",2]],"grade":"حسن","muhaddith":"إسناده لا بأس به.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"y2BaSPaa"},{"id":"س-00926","fp":"8bf63805e41d","stateId":660,"easy":"إذا صليت على النبي ﷺ صباحاً عشراً ومساءً عشراً ← تدركك شفاعته يوم القيامة","cause":"مَن صلى عَلَيَّ حين يُصْبِحُ عَشْرًا","result":"وحين يُمْسِي عَشْرًا أَدْرَكَتْه شفاعتي يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"في الصباح، في المساء"},"ref":"الجامع الصغير 8792","srcLabel":"الطبراني","text":[["مَن صلى عَلَيَّ حين يُصْبِحُ عَشْرًا ، ",1],["وحين يُمْسِي عَشْرًا أَدْرَكَتْه شفاعتي يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) (1/261)","bab":"أدعية وأذكار › فضل الذكر","dorar":"RALW0OFl"},{"id":"س-01738","fp":"516abc32d412","stateId":660,"easy":"إذا صليت على محمد وقلت «اللهم أنزله المقعد المقرب عندك» ← وجبت لك شفاعته","cause":"مَنْ صلَّى على محمدٍ وقال : اللهمَّ أنْزِلْهُ المَقْعَدَ المُقَرَّبَ عندَكَ يومَ القيامةِ","result":"وجَبَتْ لهُ شَفاعَتي","explicit":true,"apply":{"k":"say","t":"«اللهم أنزله المقعد المقرب عندك»"},"ref":"تفسير القرآن العظيم 6/461","srcLabel":"أحمد","text":[["مَنْ صلَّى على محمدٍ وقال : اللهمَّ أنْزِلْهُ المَقْعَدَ المُقَرَّبَ عندَكَ يومَ القيامةِ ، ",1],["وجَبَتْ لهُ شَفاعَتي",2]],"grade":"حسن","narrator":"رويفع بن ثابت الأنصاري","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أحمد (16991)، والبزار (2315)، والطبراني في ((المعجم الأوسط)) (3285)","bab":"أنبياء › محمد","dorar":"Fpwv9Oeo"},{"id":"س-02887","fp":"bd184a2ae671","stateId":660,"easy":"إذا قلت عند الأذان «اللهم رب هذه الدعوة التامة...» ← تنالك شفاعة محمد ﷺ يوم القيامة","cause":"إذا أذَّنَ المُؤذِّنُ، فقال الرَّجلُ: اللَّهُمَّ رَبَّ هذه الدَّعوةِ التامَّةِ، والصَّلاةِ القائمةِ، أعطِ مُحمَّدًا سُؤْلَه يومَ القيامةِ","result":"إلَّا نالَتْه شَفاعةُ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ يومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«اللَّهُمَّ رَبَّ هذه الدَّعوةِ التامَّةِ، والصَّلاةِ القائمةِ، أعطِ مُحمَّدًا سُؤْلَه يومَ القيامةِ، إلَّا نالَتْه شَفاعةُ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ يومَ القيامة» · الوقت: عند الأذان"},"repOf":"س-00900","ref":"تخريج سير أعلام النبلاء 10/113","text":[["إذا أذَّنَ المُؤذِّنُ، فقال الرَّجلُ: اللَّهُمَّ رَبَّ هذه الدَّعوةِ التامَّةِ، والصَّلاةِ القائمةِ، أعطِ مُحمَّدًا سُؤْلَه يومَ القيامةِ، ",1],["إلَّا نالَتْه شَفاعةُ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ يومَ القيامةِ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده جيد","takhrij":"أخرجه الذهبي في ((سير أعلام النبلاء)) (10/ 113)، وأبو بكر الشافعي في ((الغيلانيات)) (404)، والطبراني في ((الدعاء)) (431) بلفظه.","bab":"إيمان › الوعد","dorar":"9OTDlD8I"},{"id":"س-07895","fp":"f16e155c9b57","stateId":660,"easy":"إذا أكثرت الصلاة على النبي ﷺ يوم الجمعة وليلتها ← يكون لك شهيداً وشافعاً يوم القيامة","cause":"أكثِروا مِنَ الصَّلاةِ عليَّ في يَومِ الجُمُعةِ ولَيلةِ الجُمُعةِ، فمَن فعَلَ ذلك","result":"كُنتُ له شهيدًا وشافِعًا يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"فيض القدير 2/ 88","srcLabel":"فيض القدير","text":[["أكثِروا مِنَ الصَّلاةِ عليَّ في يَومِ الجُمُعةِ ولَيلةِ الجُمُعةِ، فمَن فعَلَ ذلك",1]," ",["كُنتُ له شهيدًا وشافِعًا يومَ القيامةِ",2]],"grade":"حسن","narrator":"أنس","muhaddith":"رمز المصننف لحسنه وليس كما قال","bab":"قيامة › الشفاعة","dorar":"S4febcnX"},{"id":"س-01533","fp":"09b811f4ea90","stateId":660,"easy":"إذا رددت مع المؤذن وشهدت الشهادتين ← تنالك شفاعة النبي ﷺ وتدخل الجنة","cause":"ما من مسلمٍ يقولُ حينَ يسمَعُ النِّداءَ يُكبِّرُ ويُكبِّرُ ويشهَدُ أن لا إلهَ","result":"إلَّا اللهُ ويشهَدُ أنَّ محمَّدًا رسولُ اللهِ ثُمَّ يقولُ اللَّهمَّ أعطِ محمَّدًا الوسيلةَ والفضيلةَ واجعَلْه في الأعلَيْنَ درجتَه وفي المصطفَيْنَ محبَّتَه وفي المقرَّبينَ ذِكرَه إلا وجَبَت له الشَّفاعةُ يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"ref":"مجمع الزوائد 1/338","srcLabel":"الطبراني","text":[["ما من مسلمٍ يقولُ حينَ يسمَعُ النِّداءَ يُكبِّرُ ويُكبِّرُ ويشهَدُ أن لا إلهَ",1]," ",["إلَّا اللهُ ويشهَدُ أنَّ محمَّدًا رسولُ اللهِ ثُمَّ يقولُ اللَّهمَّ أعطِ محمَّدًا الوسيلةَ والفضيلةَ واجعَلْه في الأعلَيْنَ درجتَه وفي المصطفَيْنَ محبَّتَه وفي المقرَّبينَ ذِكرَه إلا وجَبَت له الشَّفاعةُ يومَ القيامةِ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني (10/16) (9790) واللفظ له، وأخرجه الطحاوي ((شرح معاني الآثار)) (894)، وابن السني في ((عمل اليوم والليلة)) (99) باختلاف يسير","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"qZShJUpC"},{"id":"س-07800","fp":"7f936368c592","stateId":661,"easy":"إذا قرأت القرآن ← يأتي يوم القيامة شفيعاً لك","cause":"اقرَؤوا القُرآنَ","result":"فإنَّه يَأتي يَومَ القيامةِ شَفيعًا لأصحابِه، اقرَؤوا الزَّهراوينِ البَقَرةَ، وسورةَ آلِ عِمرانَ؛ فإنَّهما تَأتيانِ يَومَ القيامةِ كَأنَّهما غَمامَتانِ أو كَأنَّهما غَيايَتانِ أو كَأنَّهما فِرقانِ","explicit":true,"star":true,"similar":["س-07786","س-07789","س-01861","س-07802"],"otherNeedIds":[35],"ref":"صحيح مسلم 804","srcLabel":"متفق عليه","text":[["اقرَؤوا القُرآنَ؛ ",1],["فإنَّه يَأتي يَومَ القيامةِ شَفيعًا لأصحابِه، اقرَؤوا الزَّهراوينِ البَقَرةَ، وسورةَ آلِ عِمرانَ؛ فإنَّهما تَأتيانِ يَومَ القيامةِ كَأنَّهما غَمامَتانِ أو كَأنَّهما غَيايَتانِ أو كَأنَّهما فِرقانِ",2]," مِن طَيرٍ صَوافَّ، تُحاجَّانِ عن أصحابِهما، اقرَؤوا سورةَ البَقَرةِ؛ فإنَّ أخذَها بَرَكةٌ، وتَركَها حَسرةٌ، ولا تَستَطيعُها البَطَلةُ. قال مُعاويةُ: بَلَغَني أنَّ البَطَلةَ: السَّحَرةُ. [وفي روايةٍ]: غيرَ أنَّه قال: وكَأنَّهما في كِلَيهما، ولَم يَذكُرْ قَولَ مُعاويةَ: بَلَغَني."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"قرآن › فضل قراءة القرآن","dorar":"1Ahr4Fxg"},{"id":"س-07786","fp":"6fcd8e23800a","stateId":661,"easy":"إذا تعلمت القرآن ← يأتي يوم القيامة شافعاً لك","cause":"تعلَّموا القرآنَ","result":"فإنَّه يأتي يومَ القيامةِ شافعًا لأصحابِه","explicit":true,"repOf":"س-07800","ref":"تخريج صحيح ابن حبان 116","text":[["تعلَّموا القرآنَ ",1],["فإنَّه يأتي يومَ القيامةِ شافعًا لأصحابِه",2]," وعليكم بالزَّهْراوَيْنِ: البقرةِ وآلِ عِمرانَ فإنَّهما تأتيانِ يومَ القيامةِ كأنَّهما غمامتانِ أو كأنَّهما غَيَايَتانِ أو فِرْقانِ مِن طيرٍ تُحاجَّانِ عن أصحابِهما وعليكم بسورةِ البقرةِ فإنَّ أخْذَها بركةٌ وتَرْكَها حسرةٌ ولا يستطيعُها البَطَلةُ"],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"حديث صحيح رجاله ثقات","takhrij":"أخرجه ابن حبان (116) واللفظ له، ومسلم (804)، وأحمد (22146) كلاهما باختلاف يسير.","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"93PSafPf"},{"id":"س-07789","fp":"dbb49342937b","stateId":661,"easy":"إذا تعلمت القرآن ← فهو شافع لك يوم القيامة","cause":"تَعلَّموا القُرآنَ","result":"فإنَّه شافعٌ يومَ القيامةِ","explicit":true,"repOf":"س-07800","ref":"تخريج المسند لشعيب 22157","text":["قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: ",["تَعلَّموا القُرآنَ؛ ",1],["فإنَّه شافعٌ يومَ القيامةِ",2],"، تَعلَّموا البَقرةَ وآلَ عِمرانَ، تَعلَّموا الزَّهراوَينِ؛ فإنَّهما يَأتيانِ يومَ القيامةِ كأنَّهما غَمامتانِ أو غَيايتانِ أو كأنَّهما فِرقانِ مِن طَيرٍ صَوافَّ يُحاجَّانِ عن صاحبِهما، تَعَلَّموا البَقرةَ؛ فإنَّ تَعليمَها بَركةٌ، وتَركَها حَسرةٌ، ولا يَستطيعُها البَطَلةُ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (804)، وأحمد (22157) واللفظ له","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"RvBQ2vsl"},{"id":"س-01861","fp":"473d3eebba3d","stateId":661,"easy":"إذا قرأت القرآن ← فهو نعم الشفيع يوم القيامة","cause":"اقرءوا القرآنَ","result":"فإنَّهُ نِعْمَ الشفيعُ يومَ القيامةِ , إنَّهُ يقول يومَ القيامةِ : يا ربِّ حَلِّهِ حِلْيَةَ الكرامةِ","explicit":true,"repOf":"س-07800","otherNeedIds":[35],"ref":"الشفاعة للوادعي 249","text":["سمعتُ أبا هريرةَ يقول : ",["اقرءوا القرآنَ , ",1],["فإنَّهُ نِعْمَ الشفيعُ يومَ القيامةِ , إنَّهُ يقول يومَ القيامةِ : يا ربِّ حَلِّهِ حِلْيَةَ الكرامةِ ",2],". فيُحلَّى حِليةَ الكرامةِ , يا ربِّ اكْسُه كسوةَ الكرامةِ . فيُكسى كسوةَ الكرامةِ , يا ربِّ ألبِسْه تاجَ الكرامةِ يا ربِّ ارْضَ عنه فليس بعد رضاكَ شيءٌ ."],"grade":"صحيح","narrator":"ذكوان السمان أبو صالح","muhaddith":"رجاله رجال الصحيح إلا عاصماً , وهو ابن أبي النجود , فقد رويا له مقروناً وهو حسن الحديث","takhrij":"أخرجه الدارمي في ((مسنده))(3354) بلفظه،وأبونعيم في ((الحلية)) (7/ 206)، و السراج في ((حديث السراج)) (1724) باختلاف يسير .","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ldJDXm5h"},{"id":"س-07784","fp":"7f7158f146bf","stateId":661,"easy":"إذا اتبعت القرآن ← فهو شافع مشفّع","cause":"وليَسَعْكُم القرآنُ وما فيه مِنَ البيانِ","result":"فإنَّه شافِعٌ مُشفَّعٌ، وماحِلٌ مُصدَّقٌ","explicit":true,"ref":"المستدرك على الصحيحين 2117","srcLabel":"الطبراني","text":["اعمَلوا بالقرآنِ، وأَحِلُّوا حَلالَهُ، وحَرِّموا حَرامَهُ، واقتَدوا به، ولا تَكفُروا بشيءٍ منه، وما تَشابَه عليكم منه فرُدُّوهُ إلى اللهِ وإلى أولي العِلمِ مِن بَعْدي كيما يُخبِروكُم، وآمِنوا بالتَّوراةِ والإنجيلِ والزَّبورِ، وما أُوتيَ النَّبيُّونَ مِن رَبِّهم، ",["وليَسَعْكُم القرآنُ وما فيه مِنَ البيانِ",1],"؛ ",["فإنَّه شافِعٌ مُشفَّعٌ، وماحِلٌ مُصدَّقٌ",2],"، ألا ولكُلِّ السُّوَرِ نورٌ يومَ القيامةِ، وإنِّي أُعطيتُ سورةَ البقرةِ مِنَ الذِّكرِ الأَوَّلِ، وأُعطيتُ طه، وطَواسينَ، والحواميمَ، مِن أَلواحِ موسى، وأُعطيتُ فاتحةَ الكتابِ مِن تحتِ العرشِ."],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي (19738)، وأبو الفضل الرازي في ((فضائل القرآن)) (77) واللفظ لهما، والطبراني (20/ 225) (525) باختلاف يسير.","bab":"قرآن › النهي عن اتباع متشابه القرآن والاختلاف فيه","dorar":"nW6Ca3Y0"},{"id":"س-07811","fp":"9261f77b3bd9","stateId":661,"easy":"إذا كنت صاحب القرآن ← يقول القرآن يوم القيامة: يا رب حلّه، فتلبس تاج الكرامة","cause":"يجيءُ صاحبُ القرآنِ يومَ القيامةِ","result":"فيقولُ القرآنُ يا ربِّ حَلِّه فيلبسُ تاجَ الكرامةِ ثمَّ يقولُ يا ربِّ زِدْه فيلبسُ حُلَّةَ الكرامةِ ثمَّ يقولُ يا ربِّ ارضَ عنه فيرضَى عنه فيُقالُ له اقرأْ وارقَ ويزدادُ بكلِّ آيةٍ حسنةً","explicit":true,"otherNeedIds":[47,23],"ref":"الترغيب والترهيب 2/299","srcLabel":"الترمذي","text":[["يجيءُ صاحبُ القرآنِ يومَ القيامةِ",1]," ",["فيقولُ القرآنُ يا ربِّ حَلِّه فيلبسُ تاجَ الكرامةِ ثمَّ يقولُ يا ربِّ زِدْه فيلبسُ حُلَّةَ الكرامةِ ثمَّ يقولُ يا ربِّ ارضَ عنه فيرضَى عنه فيُقالُ له اقرأْ وارقَ ويزدادُ بكلِّ آيةٍ حسنةً",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2915) باختلاف يسير، وأحمد (10087) مختصراً.","bab":"قرآن › فضل قراءة القرآن","dorar":"wW4z2173"},{"id":"س-07802","fp":"1601011b5eea","stateId":661,"easy":"إذا قرأت القرآن وسهرت به ← يشفع لك يوم القيامة فتُعطى الملك والخلد","cause":"أنا الذي كنتُ أُسهِرُ لَيْلَكَ، وأُظْمِئُ هَواجِرَكَ","result":"فيُعطَى المُلْكَ بيمينِهِ، والخُلْدَ بشِمالِهِ، ويوضَعُ على رأسِهِ تاجُ الوقارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-07800","otherNeedIds":[67],"ref":"السلسلة الصحيحة 2829","text":["يَجيءُ القرآنُ يومَ القيامةِ كالرَّجُلِ الشَّاحِبِ، يقولُ لصاحبِهِ: هل تَعرِفُني؟ ",["أنا الذي كنتُ أُسهِرُ لَيْلَكَ، وأُظْمِئُ هَواجِرَكَ",1],"، وإنَّ كلَّ تاجرٍ مِن وراءِ تِجارتِهِ، وأنا لكَ اليومَ مِن وراءِ كلِّ تاجرٍ؛ ",["فيُعطَى المُلْكَ بيمينِهِ، والخُلْدَ بشِمالِهِ، ويوضَعُ على رأسِهِ تاجُ الوقارِ",2],"، ويُكْسى والِداهُ حُلَّتَيْنِ لا تقومُ لهما الدُّنيا وما فيها؛ فيقولانِ: يا ربِّ، أنَّى لنا هذا؟! فيُقالُ: بتعليمِ وَلَدِكُما القرآنَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن أو صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5764) مطولاً","bab":"قرآن › فضل قراءة القرآن","dorar":"aHE9inD4"},{"id":"س-02458","fp":"82f8e33ee1ee","stateId":662,"easy":"إذا قلت «لا إله إلا الله» ← تجب لك بها الشفاعة يوم القيامة","cause":"قُلْ لا إلهَ إلَّا اللهُ","result":"تَجِبْ لكَ علَيَّ بها الشَّفاعةُ يومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01224","ref":"المستدرك على الصحيحين 3333","text":["لمَّا حضَرَتْ أبا طالبٍ الوفاةُ أتاهُ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ وعندَهُ عبدُ اللهِ بنُ أبي أُمَيَّةَ وأبو جهلِ بنُ هشامٍ، فقالَ له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أيْ عمِّ، إنَّكَ أعظَمُهُم علَيَّ حقًّا، وأحسَنُهُم عندي يَدًا، ولأنتَ أعظَمُ حقًّا علَيَّ مِن والدي، فقُلْ كلمةً ",["تَجِبْ لكَ علَيَّ بها الشَّفاعةُ يومَ القيامةِ",2],"، ",["قُلْ لا إلهَ إلَّا اللهُ",1],"». فقالا له: أترْغبُ عنْ مِلَّةِ عبدِ المطَّلبِ؟ فسَكَتَ، فأعادها عليه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: أنا على مِلَّةِ عبدِ المطَّلبِ، فماتَ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «لأستَغْفِرنَّ لكَ ما لمْ أُنْهَ عنكَ». فأَنزلَ اللهُ عزَّ وجلَّ {مَا كَانَ لِلنَّبِيِّ وَالَّذِينَ آمَنُوا أَنْ يَسْتَغْفِرُوا لِلْمُشْرِكِينَ} [التوبة: 113] الآيةَ، {وَمَا كَانَ اسْتِغْفَارُ إِبْرَاهِيمَ لِأَبِيهِ} [التوبة: 114] إلى آخرِ الآيةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (25)، والترمذي (3188)، وأحمد (9610) مختصرا","bab":"إسلام › فضل الشهادتين","dorar":"aELKXscu"},{"id":"س-01235","fp":"53a9988f9294","stateId":662,"easy":"إذا قلت لا إله إلا الله ← يشفع لك النبي ﷺ بها","cause":"قل: لا إلهَ إلَّا اللهُ","result":"أشفَعْ لك بها يومَ القيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-01224","otherNeedIds":[66],"ref":"تخريج صحيح ابن حبان 4884","text":["أنَّ غلامًا يهوديًّا كان يخدُمُ النَّبيَّ صلَّى اللهُ عليه وسلَّم فمرِض فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم لأصحابِه: ( اذهَبوا بنا إليه نعودُه فأتَوْه وأبوه قاعدٌ على رأسِه فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["قل: لا إلهَ إلَّا اللهُ",1]," ",["أشفَعْ لك بها يومَ القيامةِ",2]," ) فجعَل الغلامُ ينظُرُ إلى أبيه فقال له أبوه: انظُرْ ما يقولُ لك أبو القاسمِ فقال: أشهَدُ أنْ لا إلهَ إلَّا اللهُ وأشهَدُ أنَّ محمَّدًا رسولُ اللهِ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( الحمدُ للهِ الَّذي أنقَذه مِن نارِ جهنَّمَ )"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4884) واللفظ له، والبخاري (1356)، وأبو داود (3095)، وأحمد (12792) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"vgLsUftw","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6270 (صحيح)"]},{"id":"س-07599","fp":"6d6e553259c6","stateId":662,"easy":"إذا لقيت الله لا تشرك به شيئاً ← تنالك الشفاعة","cause":"مَن لقِيَ اللهَ لا يُشرِكُ به شيئًا","result":"فاختَبأْتُها شَفاعةً لأُمَّتي، وهي نائلةٌ منكم إنْ شاءَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-07633","ref":"تخريج المسند لشعيب 21299","text":["أُوتيتُ خَمسًا لم يُؤتَهُنَّ نَبيٌّ كان قَبْلي: نُصِرْتُ بالرعْبِ، فيُرعَبُ منِّي العَدوُّ عن مَسيرةِ شَهرٍ، وجُعِلَتْ لي الأرضُ مَسجِدًا وطَهورًا، وأُحِلَّتْ لي الغَنائمُ، ولم تَحِلَّ لأحَدٍ كان قَبْلي، وبُعِثْتُ إلى الأحمَرِ والأسوَدِ، وقيلَ لي: سَلْ تُعْطَهْ، ",["فاختَبأْتُها شَفاعةً لأُمَّتي، وهي نائلةٌ منكم إنْ شاءَ اللهُ",2],"، ",["مَن لقِيَ اللهَ لا يُشرِكُ به شيئًا",1],"، قال الأعمَشُ: فكان مُجاهدٌ يَرى: أنَّ الأحمَرَ: الإنسُ، والأسوَدَ: الجِنُّ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (21299) واللفظ له، والدارمي (2467)، وابن أبي شيبة (32307)","bab":"فضائل النبي وصفته ودلائل النبوة › ما اختص به النبي على الأنبياء عليهم الصلاة والسلام","dorar":"pK9YcRy0","merged":6,"otherRefs":["صحيح مسلم 199 (صحيح)","تخريج المسند لشعيب 21435 (صحيح)","تخريج مشكل الآثار 4/ 353 (صحيح)","الخصائص الكبرى 2/223 (حسن)","أصل صفة الصلاة 2/535 (صحيح)"]},{"id":"س-07633","fp":"b1cd679b08e0","stateId":662,"easy":"إذا مت لا تشرك بالله شيئاً ← تكون في شفاعة النبي ﷺ","cause":"ومَن مات لا يُشرِكُ باللهِ شَيئًا","result":"في شفاعتي","explicit":true,"similar":["س-07599","س-02454","س-08379"],"ref":"تخريج المسند لشعيب 22026","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى الله عليه وسلَّم كان يَحرُسُه أصحابُه، فذكر نحوه. [أي: نحوَ حديثِ: أنَّ النَّبيَّ صلَّى الله عليه وسلم كان يحرُسُه أصحابُه، فقُمتُ ذاتَ ليلةٍ فلم أرَه في منامِه، فأخَذَني ما قَدُم وما حَدَث، فذهبتُ أنظُرُ، فإذا أنا بمعاذٍ قد لَقِيَ الذي لَقِيتُ، فسَمِعْنا صوتًا مِثلَ هَزيزِ الرَّحا فوقَفَا على مكانِهما، فجاء النبيُّ صلَّى الله عليه وسلَّم مِن قِبَلِ الصَّوتِ، فقال: هل تدرون أين كنتُ؟ وفيمَ كنتُ؟  أتاني آتٍ مِن رَبِّي عزَّ وجلَّ، فخَيَّرَني بين أن يدخُلَ نِصفُ أمَّتي الجنَّةَ، وبين الشَّفاعةِ، فاختَرتُ الشَّفاعةَ. فقالا: يا رَسولَ اللهِ، ادعُ اللهَ عزَّ وجَلَّ أن يجعَلَنا في شفاعتِك. فقال: أنتم ",["ومَن مات لا يُشرِكُ باللهِ شَيئًا",1]," ",["في شفاعتي",2],"]."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22026) واللفظ له، والطبراني في ((المعجم الصغير)) (784)","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"b10qsHvp"},{"id":"س-03938","fp":"f0ab0b62656b","stateId":662,"easy":"إذا كنت من أهل الكبائر الموحدين ← ترجو شفاعة النبي ﷺ","cause":"وَيَغْفِرُ مَا دونَ ذَلِكَ لِمَنْ يَشَاءُ","result":"إني ادَّخَرْتُ دَعْوَتِي شفَاعَتِي لِأَهْلِ الكبائرِ من أُمَّتِي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[11],"ref":"مجمع الزوائد 7/8","srcLabel":"الطبراني","text":["كنَّا نُمْسِكُ عنِ الاستغفارِ لأهلِ الكبائرِ حتى سمعْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ  إنَّ اللهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ ",["وَيَغْفِرُ مَا دونَ ذَلِكَ لِمَنْ يَشَاءُ",1]," قال ",["إني ادَّخَرْتُ دَعْوَتِي شفَاعَتِي لِأَهْلِ الكبائرِ من أُمَّتِي",2]," فَأَمْسَكْنا عن كثيرٍ مما كان في أنفُسِنا ثم نطَقْنا بعدُ ورَجَوْنَا"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح غير حرب بن سريج وهو ثقة","takhrij":"أخرجه البزار (5840)، وأبو يعلى (5813)، والطبراني في ((المعجم الأوسط)) (5942)","bab":"تفسير آيات › سورة النساء","dorar":"kVyE3QmR"},{"id":"س-07877","fp":"4affbb093b03","stateId":662,"easy":"إذا شهدت أن لا إله إلا الله ← تنالك دعوة النبي ﷺ المدخرة","cause":"ولمن شَهِدَ أَن لا إلَهَ إلَّا اللَّهُ","result":"فأخَّرتُ مَسألتي إلى يومِ القيامةِ ، فَهيَ لَكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"تخريج المسند لشاكر 12/25","srcLabel":"أحمد","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ عامَ غَزوةِ تبوكَ قامَ منَ اللَّيلِ يصلِّي ، فاجتَمعَ وراءَهُ رجالٌ من أصحابِهِ يَحرسونَهُ ، حتَّى إذا صلَّى وانصَرفَ إليهِم ، فقالَ لَهُم : لقد أعطَيتُ اللَّيلةَ خمسًا ، ما أُعْطيَهنَّ أحدٌ قَبلي : أمَّا أَنا فأُرسلتُ إلى النَّاسِ كلِّهم عامَّةً ، وَكانَ مِن قَبلي إنَّما يرسَلُ إلى قومِهِ ، ونُصِرتُ على العدوِّ بالرُّعبِ ، ولو كانَ بيني وبينَهُم مسيرةُ شَهْرٍ لملئَ منهُ رعبًا ، وأحلَّت لي الغَنائمُ أكلُها ، وَكانَ مَن قبلي يُعظِّمونَ أَكْلَها ، كانوا يحرِقونَها ، وجُعِلَت لي الأرضُ مساجدَ وطَهورًا ، أينما أدرَكَتني الصَّلاةُ تمسَّحتُ وصلَّيتُ ، وَكانَ مَن قبلي يعظِّمونَ ذلِكَ ، إنَّما كانوا يصلُّونَ في كَنائسِهِم وبيَعِهِم ، والخامسةُ هيَ ما هيَ ، قيلَ لي : سَل فإنَّ كلَّ نبيٍّ قد سألَ ، ",["فأخَّرتُ مَسألتي إلى يومِ القيامةِ ، فَهيَ لَكُم",2]," ",["ولمن شَهِدَ أَن لا إلَهَ إلَّا اللَّهُ",1]],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7068) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (4489) باختلاف يسير، والبيهقي (1073) مختصرا.","bab":"قيامة › الشفاعة","dorar":"hSzh2B5W"},{"id":"س-03433","fp":"52bb3c7559a9","stateId":662,"easy":"إذا لقيت الله مؤمناً لا تشرك به ← تنالك دعوة المغفرة","cause":"لَقيَكَ يُؤمِنُ بي ولا يُشرِكُ بكَ","result":"اللهُمَّ اغفِرْ لكُلِّ عَبدٍ مُسلِمٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 10473","srcLabel":"أحمد","text":["عنِ ابنِ دارةَ، مَولى عُثمانَ، قال: إنَّا لبالبَقيعِ مَعَ أبي هُرَيرةَ إذ سَمِعناه يَقولُ: أنا أعلَمُ النَّاسِ بشَفاعةِ مُحَمَّدٍ صلَّى اللهُ عليه وسلَّم يَومَ القيامةِ. قال: فتَداكَّ النَّاسُ عليه، فقالوا: إيهٍ يَرحَمُكَ اللهُ! قال: يَقولُ: ",["اللهُمَّ اغفِرْ لكُلِّ عَبدٍ مُسلِمٍ",2]," ",["لَقيَكَ يُؤمِنُ بي ولا يُشرِكُ بكَ",1],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","bab":"استغفار › أسباب المغفرة","dorar":"yLpnIIXA"},{"id":"س-02401","fp":"110bd3a29b67","stateId":662,"easy":"إذا شهدت بالتوحيد مخلصاً ← تنالك الشفاعة","cause":"لِمَن شهِد أنْ لا إلهَ إلَّا اللهُ مُخلِصًا وأنَّ محمَّدًا رسولُ اللهِ يُصدِّقُ لسانُه قلبَه وقلبُه لسانَه","result":"وشفاعتي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01224","ref":"صحيح ابن حبان 6466","text":["سأَلْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم قُلْتُ : يا رسولَ اللهِ ماذا ردَّ إليك ربُّك في الشَّفاعةِ ؟ قال : ( والَّذي نفسُ محمَّدٍ بيدِه لقد ظنَنْتُ أنَّك أوَّلُ مَن يسأَلُني عن ذلك مِن أمَّتي لِمَا رأَيْتُ مِن حرصِك على العِلمِ والَّذي نفسُ محمَّدٍ بيدِه لَمَا يُهِمُّني مِن انقِصافِهم على أبوابِ الجنَّةِ أهَمُّ عندي مِن تمامِ شَفاعتي لهم ",["وشفاعتي",2]," ",["لِمَن شهِد أنْ لا إلهَ إلَّا اللهُ مُخلِصًا وأنَّ محمَّدًا رسولُ اللهِ يُصدِّقُ لسانُه قلبَه وقلبُه لسانَه",1]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (8070)، والحاكم (234)، وقوام السنة في ((الترغيب)) (2135) جميعهم بلفظه.","bab":"إسلام › فضل الشهادتين","dorar":"IfevgCdh","merged":2,"otherRefs":["تخريج المسند لشعيب 10713 (صحيح)"]},{"id":"س-02454","fp":"9d32ce4af2bb","stateId":662,"easy":"إذا لم تشرك بالله ← تنالك الشفاعة","cause":"لِمَن لا يُشرِكُ باللهِ شَيئًا مِن أُمَّتي","result":"أنَّ شَفاعَتي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07633","ref":"تخريج المسند لشعيب 24002","text":["عَرَّسَ بنا رسولُ اللهِ صلَّى اللهُ عليه وسَلَّمَ ذاتَ ليلةٍ، فافْتَرَشَ كلُّ رَجُلٍ منَّا ذِراعَ راحِلَتِه، قال: فانتَهَيتُ إلى بَعضِ الإبِلِ، فإذا ناقةُ رسولِ اللهِ صلَّى اللهُ عليه وسَلَّمَ ليس قُدَّامَها أحَدٌ، قال: فانطَلَقتُ أطْلُبُ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ، فإذا مُعاذُ بنُ جَبَلٍ وعَبدُ اللهِ بنُ قَيسٍ قائِمانِ، قُلتُ: أين رسولُ اللهِ؟ قالا: ما نَدْري، غَيرَ أنَّا سَمِعْنا صَوتًا بأعْلى الوادي، فإذا مِثْلُ هَزيزِ الرَّحْلِ قال: امْكُثوا يَسيرًا، ثُمَّ جاءنا رسولُ اللهِ صلَّى اللهُ عليه وسَلَّمَ فقال: إنَّه أتاني الليلةَ آتٍ مِن ربِّي، فخَيَّرَني بَينَ أنْ يَدخُلَ نِصفُ أُمَّتي الجَنَّةَ، وبَينَ الشَّفاعةِ، فاخْتَرتُ الشَّفاعةَ، فقُلْنا: نَنشُدُكَ اللهَ والصُّحْبةَ لَما جَعَلْتَنا مِن أهلِ شَفاعَتِكَ، قال: فإنَّكم مِن أهلِ شَفاعَتي، قال: فأقْبَلْنا مَعانيقَ إلى الناسِ، فإذا هُم قد فَزِعوا، وفَقَدوا نَبيَّهُم، وقال رسولُ اللهِ صلَّى اللهُ عليه وسَلَّمَ: إنَّه أتاني الليلةَ مِن ربِّي آتٍ، فخَيَّرَني بَينَ أنْ يَدخُلَ نِصفُ أُمَّتي الجَنَّةَ وبَينَ الشَّفاعةِ، وإنِّي اختَرْتُ الشَّفاعةَ. قالوا: يا رسولَ اللهِ، نَنشُدُكَ اللهَ والصُّحْبةَ لَما جَعَلْتَنا مِن أهلِ شَفاعَتِكَ، قال: فلمَّا أضَبُّوا عليه، قال: فأنا أُشهِدُكُم ",["أنَّ شَفاعَتي",2]," ",["لِمَن لا يُشرِكُ باللهِ شَيئًا مِن أُمَّتي",1],"."],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"إسناه صحيح،","takhrij":"أخرجه الترمذي (2441) مختصراً باختلاف يسير، وابن ماجه (4317) مختصراً بنحوه، وأحمد (24002) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"mfllY1rv"},{"id":"س-02470","fp":"dd10ad53954c","stateId":662,"easy":"إذا مت تشهد أن لا إله إلا الله ← تكون من أهل الشفاعة","cause":"لِمَن مات وهو يَشهَدُ أنْ لا إلهَ إلَّا اللهُ","result":"أنْ يَجعَلَنا مِن أهلِ شَفاعتِكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01224","ref":"تخريج المسند لشعيب 19724","text":["عن أبي موسى قال: غَزَوْنا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في بعضِ أسفارِه، قال: فعَرَّسَ بنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فانتَبَهتُ بعضَ اللَّيلِ إلى مُناخِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أطلُبُه فلمْ أجِدْه، قال: فخَرَجتُ بارزًا أطلُبُه، وإذا رَجُلٌ مِن أصحابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَطلُبُ ما أطلُبُ، قال: فبيْنا نحن كذلك، إذِ اتَّجَهَ إلينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فقُلْنا: يا رسولَ اللهِ، أنتَ بأرضِ حَربٍ؛ ولا نَأمَنُ عليك، فلَولا إذ بَدَتْ لك الحاجةُ قُلتَ لبعضِ أصحابِكَ فقام معك، قال: فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي سَمِعتُ هَزيزًا كهَزيزِ الرَّحى، أو حَنينًا كحَنينِ النَّحلِ، وأتاني آتٍ مِن ربِّي عزَّ وجلَّ، قال: فخَيَّرَني بأنْ يَدخُلَ ثُلُثُ أُمَّتي الجنَّةَ وبيْنَ الشَّفاعةِ لهم، فاختَرتُ لهم شَفاعتي، وعَلِمتُ أنَّها أوسعُ لهم، فخَيَّرَني بيْنَ أنْ يَدخُلَ شَطرُ أُمَّتي الجنَّةَ وبيْنَ شَفاعتي لهم، فاختَرتُ شَفاعتي لهم، وعَلِمتُ أنَّها أوسعُ لهم، قال: فقالا: يا رسولَ اللهِ، ادْعُ اللهَ تَعالى ",["أنْ يَجعَلَنا مِن أهلِ شَفاعتِكَ",2],"، قال: فدَعا لهما، ثُمَّ إنَّهما نَبَّها أصحابَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأخبَراهم بقَولِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فجَعَلوا يَأتُونه ويَقولونَ: يا رسولَ اللهِ، ادْعُ اللهَ تَعالى أنْ يَجعَلَنا مِن أهلِ شَفاعتِكَ، فيَدعوَ لهم، قال: فلمَّا أضَبَّ عليه القَومُ وكَثُروا، قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّها ",["لِمَن مات وهو يَشهَدُ أنْ لا إلهَ إلَّا اللهُ",1],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"قوله صلى الله عليه وسلم في الشفاعة: \"إنها لمن مات وهو يشهد أن لا إله إلا الله\" صحيح لغيره\nوقوله: \"خيرني بين أن يدخل شطر أمتي الجنة، ربين شفاعتي لهم، فاخترت شفاعتي لهم\" حسن","takhrij":"أخرجه أحمد (19724) واللفظ له، والطبراني في ((المعجم الصغير)) (784)","bab":"إسلام › فضل الشهادتين","dorar":"slvyT27e"},{"id":"س-01224","fp":"16b65cfa70f6","stateId":662,"easy":"إذا قلت «لا إله إلا الله» خالصاً من قلبك ← تكون أسعد الناس بشفاعة النبي ﷺ","cause":"مَن قال: لا إلَهَ إلَّا اللهُ، خالِصًا مِن قَلبِه","result":"أسعَدُ النَّاسِ بشَفاعَتي يَومَ القيامةِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-02458","س-01235","س-02401","س-02470"],"ref":"صحيح البخاري 99","srcLabel":"متفق عليه","text":["قيلَ: يا رَسولَ اللهِ، مَن أسعَدُ النَّاسِ بشَفاعَتِكَ يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لقد ظَنَنتُ يا أبا هُرَيرةَ أن لا يَسألَني عن هذا الحَديثِ أحَدٌ أوَّلُ مِنكَ؛ لِما رَأيتُ مِن حِرصِكَ على الحَديثِ، ",["أسعَدُ النَّاسِ بشَفاعَتي يَومَ القيامةِ",2]," ",["مَن قال: لا إلَهَ إلَّا اللهُ، خالِصًا مِن قَلبِه",1]," أو نَفسِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"1kAsTqDA"},{"id":"س-08379","fp":"7f31e33b456f","stateId":662,"easy":"إذا مت لا تشرك بالله شيئاً ← تنالك الشفاعة","cause":"هي لِمَنْ ماتَ ولا يُشْرِكُ بِاللَّهِ شَيْئًا","result":"فاخْتَرْتُ الشَّفاعَةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-07633","otherNeedIds":[47],"ref":"المستدرك على الصحيحين 226","text":["عنْ عَوْفِ بنِ مالكٍ، أَنَّهُم كانوا معَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في بَعْضِ مغازيهِ، قالَ عوْفٌ: فَسَمِعْتُ خَلْفي هَزيزًا كهَزيزِ الرَّحَى، فإذا أنا بِالنَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقُلتُ: إنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ إذا كان في أَرْضِ العَدُوِّ كان عليه الحُرَّاسُ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «أَتاني آتٍ مِنْ رَبِّي يُخَيِّرُني بيْنَ أنْ يَدْخُلَ شَطْرُ أُمَّتي الجَنَّةَ وبيْنَ الشَّفاعَةِ، ",["فاخْتَرْتُ الشَّفاعَةَ",2],"». فقالَ مُعاذُ بنُ جَبَلٍ: يا رسولَ اللهِ، قدْ عَرَفْتَ قِوائي فاجْعَلْني مِنهُمْ، قالَ: «أنتَ مِنْهُمْ». قالَ عوْفُ بنُ مالكٍ: يا رسولَ اللهِ، قدْ عَرَفْتَ أنَّا تَرَكْنا قَوْمَنا وأَمْوالَنا راغِبًا لِلَّهِ ورسولهِ فاجْعَلْنا مِنْهُمْ، قالَ: «أنتَ مِنْهُمْ». فانتَهَيْنا إلى القَوْمِ وقد ثاروا، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: «اقْعُدوا». فَقَعَدوا، كأنَّه لم يَقُمْ أَحَدٌ مِنهُمْ، قالَ: «أَتاني آتٍ مِنْ ربِّي فخَيَّرَني بينَ أَنْ يدْخُلَ شَطْرُ أُمَّتي الجَنَّةَ وبينَ الشَّفاعةِ، فاخْتَرْتُ الشَّفاعَةَ». فَقالوا: يا رسولَ اللهِ، اجْعَلْنا مِنْهُمْ. فقالَ: «",["هي لِمَنْ ماتَ ولا يُشْرِكُ بِاللَّهِ شَيْئًا",1],"»."],"grade":"صحيح","narrator":"عوف بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (23977)، وابن حبان (3541)، وابن خزيمة في ((التوحيد)) (2/ 638) جميعهم باختلاف يسير.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"2lTfj5la"},{"id":"س-01566","fp":"9e05585bdfff","stateId":663,"easy":"إذا صبرت على شدة المدينة حتى تموت ← يكون لك النبي ﷺ شهيداً أو شفيعاً","cause":"لا يَثبُتُ فيها أحدٌ فيَثبُتُ للأوائِها وشِدَّتِها حتى يموتَ","result":"إلَّا كنتُ له يومَ القيامةِ شهيدًا أو شفيعًا","explicit":true,"repOf":"س-07600","otherNeedIds":[35,62],"ref":"سبل الهدى والرشاد 3/306","text":["«سيأتي على النَّاسِ زَمانٌ يُفتَحُ فيه فتحاتُ الأرضِ فيَخرُجُ إليها دجَّالٌ -وفي لفظٍ: فيَخرُجُ النَّاسُ إلى الأريافِ يَلتَمِسون الرَّخاءَ، فيَجِدون رخاءً، وفي لفظٍ: مَطعَمًا ومَلبَسًا ومركَبًا، فيقالُ لهم: هَلُمَّ إلينا؛ فإنَّكم بأرضِ حجازٍ جَدوبةٍ، والمدينةُ خَيرٌ لهم لو كانوا يعلمون، وفي لفظٍ: فيَكتُبون إلى أهليهم هَلُمُّوا إلينا؛ فإنَّكم بأرضِ حِجازٍ جَدوبةٍ، والمدينةُ خيرٌ لهم لو كانوا يعلمون، وفي لفظ: فيمُرُّون على إخوانٍ لهم حُجَّاجًا أو عُمَّارًا، فيقولون: ما يقيمُكم في لأواءِ العَيشِ وشِدَّةِ الجوعِ؟ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فذاهِبٌ وقاعِدٌ، حتى قالها مرارًا، والمدينةُ خيرٌ لهم، ",["لا يَثبُتُ فيها أحدٌ فيَثبُتُ للأوائِها وشِدَّتِها حتى يموتَ",1]," ",["إلَّا كنتُ له يومَ القيامةِ شهيدًا أو شفيعًا",2],"، والذي نفسي بيَدِه لا يخرُجُ أحدٌ رَغبةً عنها إلَّا أخلفَ اللهُ فيها خيرًا منه، ألا إنَّ المدينةَ كالكِيرِ تُخرِجُ الخبيثَ، لا تقومُ السَّاعةُ حتى تنفيَ المدينةُ شِرارَها كما ينفي الكِيرُ خَبَثَ الحديدِ»"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[رجاله ] رجال الصحيح.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"yxaTr1WP","merged":13,"otherRefs":["تخريج المسند لشعيب 9670 (صحيح)","تخريج المسند لشعيب 27085 (صحيح)","فقه السيرة 172 (صحيح)","صحيح مسلم 1378 (صحيح)","تخريج المسند لشعيب 11246 (صحيح)","المتجر الرابح 160 (صحيح)","سنن الترمذي 3918 (صحيح)","صحيح مسلم 1377 (صحيح)","تخريج المسند لشاكر 9/28 (صحيح)","تخريج المسند لشاكر 16/194 (صحيح)","صحيح مسلم 1374 (صحيح)","تخريج المسند لشعيب 11659 (صحيح)"]},{"id":"س-07307","fp":"b65e4ae20cda","stateId":663,"easy":"إذا استطعت أن تموت بالمدينة فمت بها ← يكون لك النبي ﷺ شفيعاً وشهيداً","cause":"من استطاعَ منكم أن يموتَ بالمدينةِ فليمُتْ بِها فمن ماتَ بالمدينةِ","result":"كنت لَهُ شفيعًا وشَهيدًا","explicit":true,"repOf":"س-07600","otherNeedIds":[35,62],"ref":"الزواجر عن اقتراف الكبائر 1/207","text":[["من استطاعَ منكم أن يموتَ بالمدينةِ فليمُتْ بِها فمن ماتَ بالمدينةِ ",1],["كنت لَهُ شفيعًا وشَهيدًا",2],". الوباءُ والدَّجَّالُ لا يدخلانِها"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"فتن › فتنة الدجال","dorar":"wqPhl8US","merged":2,"otherRefs":["صحيح الترغيب 1196 (صحيح)"]},{"id":"س-07868","fp":"46d146fa5de5","stateId":663,"easy":"إذا مت في المدينة ← يكون لك النبي ﷺ شفيعاً","cause":"ومَن ماتَ في المدينةِ","result":"كنتُ لَهُ شفيعًا","explicit":true,"repOf":"س-07600","ref":"تخريج كتاب السنة 829","text":["كنَّا معَ رسولِ اللَّهِ في بعضِ أسفارِهِ، فقالَ إنَّ جبريلَ عليْهِ السَّلامُ أتاني وإنَّ ربِّي خيَّرني بينَ خَصلتينِ بينَ أن يدخلَ نِصفُ أمَّتيَ الجنَّةَ وبينَ الشَّفاعةِ فاخترتُ الشَّفاعةَ وفيهِ عن مِعقلِ بنِ يسارٍ عنِ النَّبيِّ اثنانِ لا تنالُهما شفاعَتي ",["ومَن ماتَ في المدينةِ",1]," ",["كنتُ لَهُ شفيعًا",2]],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (829)، وابن أبي داود في ((البعث)) (47) واللفظ لهما، والترمذي (2441) وفيه زيادة.","bab":"قيامة › الحساب والقصاص","dorar":"17cgkttC","merged":2,"otherRefs":["صحيح الترغيب 1197 (صحيح)"]},{"id":"س-02325","fp":"5a7da00bdf76","stateId":663,"easy":"إذا زرت النبي ﷺ لا تريد إلا زيارته ← كان حقاً عليه أن يكون لك شفيعاً","cause":"مَن جاءَني زائِرًا [لا] يُعمِلُه حاجةٌ إلَّا زيارَتي","result":"كان حَقًّا عليَّ أن أكونَ له شَفيعًا يَومَ القيامةِ","explicit":true,"repOf":"س-02625","ref":"سبل الهدى والرشاد 12/379","text":["«",["مَن جاءَني زائِرًا [لا] يُعمِلُه حاجةٌ إلَّا زيارَتي",1]," ",["كان حَقًّا عليَّ أن أكونَ له شَفيعًا يَومَ القيامةِ",2],"»"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((الأوسط)) (4546)، وابن المقريء في ((المعجم)) (169)، وابو نعيم الأصبهاني في ((تاريخ أصبهان)) (2/ 276) جميعهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"49QFP9MC"},{"id":"س-04675","fp":"d320f72a09ea","stateId":663,"easy":"إذا زرت قبر النبي ﷺ ← وجبت لك شفاعته (على رواية)","cause":"مَن زارَ قَبري","result":"وَجَبتْ له شَفاعَتي","explicit":true,"repOf":"س-02625","ref":"الأحكام الشرعية الصغرى 467","text":[["مَن زارَ قَبري، ",1],["وَجَبتْ له شَفاعَتي",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (4/170) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (6/351)، والدارقطني (2/278) واللفظ لهما","bab":"دفن ومقابر › قبر النبي صلى الله عليه وسلم وأبي بكر وعمر","dorar":"nF3eWfsO"},{"id":"س-07875","fp":"32b3d0a5dc6b","stateId":663,"easy":"إذا ثبتّ على شدة المدينة وجهدها ← يكون لك النبي ﷺ شفيعاً أو شهيداً","cause":"ولا يَثبُتُ أحَدٌ على لَأوائِها وجَهدِها","result":"كُنتُ له شَفيعًا، أو شَهيدًا يَومَ القيامةِ","explicit":true,"repOf":"س-07600","ref":"صحيح مسلم 1363","text":["إنِّي أُحَرِّمُ ما بينَ لابَتَيِ المَدينةِ أن يُقطَعَ عِضاهُها، أو يُقتَلَ صَيدُها، وقال: المَدينةُ خَيرٌ لهم لو كانوا يَعلَمونَ، لا يَدَعُها أحَدٌ رَغبةً عَنها إلَّا أبدَلَ اللهُ فيها مَن هو خَيرٌ منه، ",["ولا يَثبُتُ أحَدٌ على لَأوائِها وجَهدِها",1]," إلَّا ",["كُنتُ له شَفيعًا، أو شَهيدًا يَومَ القيامةِ",2],". [وفي روايةٍ]: ولا يُريدُ أحَدٌ أهلَ المَدينةِ بسوءٍ إلَّا أذابَه اللهُ في النَّارِ ذَوبَ الرَّصاصِ، أو ذَوبَ المِلحِ في الماءِ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (1573)، وعبد بن حميد في ((المنتخب)) (153)، والبيهقي (10053) واللفظ لهم.","bab":"قيامة › الشفاعة","dorar":"hpxIUgNd"},{"id":"س-02625","fp":"998cd4c702e0","stateId":663,"easy":"إذا زرت النبي ﷺ بالمدينة محتسباً ← يكون لك شهيداً وشفيعاً يوم القيامة","cause":"مَنْ زَارَنِي بالمدينةِ مُحتسبًا","result":"كنتُ لهُ شهيدًا و شفيعًا يومَ القيامةِ","explicit":true,"similar":["س-02325","س-04675"],"ref":"الجامع الصغير 8697","srcLabel":"البيهقي","text":[["مَنْ زَارَنِي بالمدينةِ مُحتسبًا،  ",1],["كنتُ لهُ شهيدًا و شفيعًا يومَ القيامةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4157)، وابن الجوزي في ((مثير العزم الساكن)) (469)، وابن بشكوال في ((القربة إلى رب العالمين)) (120)، واللفظ لهم.","bab":"إيمان › الاحتساب والنية","dorar":"rf0Wsfqu"},{"id":"س-07600","fp":"b7441ef948e1","stateId":663,"easy":"إذا استطعت أن تموت بالمدينة ← يكون لك النبي ﷺ شهيداً أو شفيعاً","cause":"من استطاع منكم أن يموتَ بالمدينةِ","result":"كنتُ له شهيدًا أو شفيعًا","explicit":true,"star":true,"similar":["س-01566","س-07307","س-07868","س-07875"],"otherNeedIds":[47,62],"ref":"صحيح الترغيب 1197","srcLabel":"الطبراني","text":[["من استطاع منكم أن يموتَ بالمدينةِ",1]," فلْيَمُتْ ، فإنه من مات بها ؛ ",["كنتُ له شهيدًا أو شفيعًا",2]," يومَ القيامةِ ."],"grade":"صحيح","narrator":"امرأة يتيمة من ثقيف","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (3214)، والطبراني (25/186) (458)، وأبو نعيم في ((معرفة الصحابة)) (8084)","bab":"فضائل النبي وصفته ودلائل النبوة › ما اختص به النبي على الأنبياء عليهم الصلاة والسلام","dorar":"DcWJ1SNN","merged":5,"otherRefs":["صحيح ابن ماجه 2543 (صحيح)","السلسلة الصحيحة 2928 (صحيح)","صحيح الترغيب 1194 (صحيح)","تخريج شرح السنة 2021 (صحيح)"]},{"id":"س-07123","fp":"dc7f64a45cb5","stateId":664,"easy":"إذا حفظت للأمة أربعين حديثاً من أمر دينها ← يبعثك الله فقيهاً ويكون النبي ﷺ لك شفيعاً","cause":"من حفِظ على أمَّتي أربعين حديثًا من أمرِ دينِها","result":"بعثه اللهُ فقيهًا ، وكنتُ له يومَ القيامةِ شافعًا وشهيدًا","explicit":true,"repOf":"س-07880","ref":"شعب الإيمان 2/742","text":["سُئل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ما حدُّ العلمِ إذا حفِظه الرَّجلُ كان فقيهًا ؟ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["من حفِظ على أمَّتي أربعين حديثًا من أمرِ دينِها ",1],["بعثه اللهُ فقيهًا ، وكنتُ له يومَ القيامةِ شافعًا وشهيدًا",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"متنه مشهور وليس له إسناده صحيح","takhrij":"أخرجه أبو بكر الشافعي في ((الغيلانيات)) (389)، والشجري في ((ترتيب الأمالي)) (4)، وابن الجوزي في ((العلل المتناهية)) (164) واللفظ لهم.","bab":"علم › حسن السؤال ونصح العالم","dorar":"p45u0ADN"},{"id":"س-02135","fp":"11ae3e070f77","stateId":664,"easy":"إذا صلى عليك مئة من المسلمين يشفعون لك ← يُشفّعون فيك","cause":"يُصلِّيَ عليه أُمَّةٌ مِنَ المُسلمِينَ يَبلُغونَ أنْ يكونوا مِئَةً، فيَشفَعوا له","result":"إلَّا شُفِّعوا فيه","explicit":true,"star":true,"otherNeedIds":[11],"ref":"تخريج مشكل الآثار 264","srcLabel":"مسلم","text":["ما مِن رجُلٍ مُسلِمٍ يموتُ ف",["يُصلِّيَ عليه أُمَّةٌ مِنَ المُسلمِينَ يَبلُغونَ أنْ يكونوا مِئَةً، فيَشفَعوا له",1],"، ",["إلَّا شُفِّعوا فيه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (947) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"bVfmDjHz","merged":6,"otherRefs":["تخريج المسند لشعيب 24657 (صحيح)","تخريج المسند لشعيب 24127 (صحيح)","تخريج مشكل الآثار 272 (صحيح)","تخريج مشكل الآثار 267 (حسن)","تخريج صحيح ابن حبان 3081 (صحيح)"]},{"id":"س-04536","fp":"26237c9f2c49","stateId":664,"easy":"إذا استُشهدت ← تشفع في سبعين من أهل بيتك","cause":"الشَّهيدُ","result":"يشفَعُ في سبعينَ مِن أهلِ بيتِه","explicit":true,"otherNeedIds":[37,47],"ref":"فتاوى نور على الدرب لابن باز 4/338","srcLabel":"أبو داود","text":["حديثُ شفاعةِ الشهيدِ [يعني حديث: دخَلْنا على أمِّ الدَّرداءِ ونحنُ أيتامٌ صِغارٌ فمسَحتْ رؤوسَنا وقالت: أبشِروا يا بَنيَّ فإنِّي أرجو أنْ تكونوا في شفاعةِ أبيكم فإنِّي سمِعْتُ أبا الدَّرداءِ يقولُ: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["الشَّهيدُ",1]," ",["يشفَعُ في سبعينَ مِن أهلِ بيتِه",2]," )]"],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2522)، وابن حبان (4660)، والآجري في ((الشريعة)) (813) بنحوه تامًا.","bab":"جهاد › فضل الشهيد","dorar":"NQLnd2RA","merged":3,"otherRefs":["صحيح الجامع 3747 (صحيح)","تخريج سير أعلام النبلاء 1/193 (حسن)"]},{"id":"س-07880","fp":"c1b0da2dea6a","stateId":664,"easy":"إذا حفظت للأمة أربعين حديثاً من السنة وأديتها ← يكون لك النبي ﷺ شفيعاً أو شهيداً","cause":"من حفِظَ على أمَّتي أربعينَ حديثًا منَ السُّنَّةِ حتَّى يؤدِّيَها إليهِم","result":"كنتُ لهُ شفيعًا أو شَهيدًا يومَ القيامةِ","explicit":true,"similar":["س-07123"],"otherNeedIds":[35,62],"ref":"التذكار في أفضل الأذكار 6","srcLabel":"ابن عبدالبر","text":[["من حفِظَ على أمَّتي أربعينَ حديثًا منَ السُّنَّةِ حتَّى يؤدِّيَها إليهِم ",1],["كنتُ لهُ شفيعًا أو شَهيدًا يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"ليس يروى من وجه ثابت","takhrij":"أخرجه ابن عبدالبر في ((جامع بيان العلم وفضله)) (205) واللفظ له، وابن الجوزي في ((العلل المتناهية)) (176) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"Z2GIV29g"},{"id":"س-06552","fp":"32b1bf98bc30","stateId":664,"easy":"إذا أكثرت السجود ← تنال شفاعة النبي ﷺ","cause":"بكَثْرةِ السُّجودِ","result":"حاجتي أن تَشفَعَ لي يَوْمَ القِيامةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"في السجود"},"ref":"الصحيح المسند 1465","srcLabel":"الصحيح المسند","text":["عن خادِمٍ للنَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ -رَجُلٍ أو امْرَأةٍ- قالَ: كانَ النَّبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ممَّا يقولُ للخادِمِ: «ألك حاجةٌ؟»، قالَ: حتَّى كانَ ذاتَ يَوْمٍ فقالَ: يا رَسولَ اللهِ، حاجتي قالَ: «وما حاجتُك؟»، قالَ: ",["حاجتي أن تَشفَعَ لي يَوْمَ القِيامةِ",2],"، قالَ: «ومَن دَلَّك على هذا؟»، قالَ: رَبِّي، قالَ: «إمَّا لا فأَعنِّي ",["بكَثْرةِ السُّجودِ",1],"»."],"grade":"صحيح","narrator":"خادم للنبي","muhaddith":"صحيح، رجاله رجال الصحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"TxjNrWR0"},{"id":"س-07873","fp":"66dba71b6aea","stateId":664,"easy":"إذا آثرت أخاك على نفسك في الدنيا ← يشفع لك يوم القيامة","cause":"أنا الذي آثَرتُك على نَفسي يَومَ المَفازةِ","result":"فيُوهَبُ له، فيَأخُذُ بيَدِه فيَنطَلِقُ به إلى الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[67],"ref":"البعث والنشور 363","srcLabel":"الطبراني","text":["«سَلكَ رَجُلانِ مَفازةً أحَدُهما عابدٌ، والآخَرُ به رَهَقٌ، قال: ومَعَ الذي به رَهَقٌ إداوةٌ فيها ماءٌ، وليسَ مَعَ العابدِ ماءٌ، فعَطِشَ العابدُ، فقال: أي فُلانُ، اسقِني، فهو ذا أموتُ، قال: إنَّما مَعي إداوةٌ في هذه المَفازةِ، فإن سَقَيتُك هَلكتُ أنا، فسَلكا، ثُمَّ إنَّ العابدَ استَبَدَّ به العَطَشُ، فقال: أي فُلانُ، اسقِني فهو ذا أموتُ، قال: إنَّما مَعي إداوةٌ، ونَحنُ في مَفازةٍ، فإن سَقَيتُك هَلكتُ، فسَلكا، ثُمَّ إنَّ العابدَ سَقَطَ، فقال: أي فُلانُ، اسقِني فهو ذا أموتُ، قال الذي به رَهَقٌ: واللهِ لئِن تَرَكتُ هذا العَبدَ الصَّالحَ يَموتُ ضَياعًا لا تبلني عِندَ اللهِ بالة أبَدًا، فرَشَّ عليه الماءَ وسَقاه، ثُمَّ سَلكا المَفازةَ فقَطَعاها، قال: فيوقَفانِ في الحِسابِ يَومَ القيامةِ، فيُؤمَرُ بالعابدِ إلى الجَنَّةِ، ويُؤمَرُ بالذي به رَهَقٌ إلى النَّارِ، قال: فيَعرِفُ الذي به رَهَقٌ العابدَ، ولا يَعرِفُ العابدُ الذي به رَهَقٌ، فيُناديه، أي فُلانُ، ",["أنا الذي آثَرتُك على نَفسي يَومَ المَفازةِ",1],"، وقد أُمِر بي إلى النَّارِ، فاشفَعْ إلى رَبِّك، فيَقولُ: أي رَبِّ، إنَّه آثَرَني على نَفسِه، أي رَبِّ هَبْه لي اليَومَ، ",["فيُوهَبُ له، فيَأخُذُ بيَدِه فيَنطَلِقُ به إلى الجَنَّةِ",2],"».\nزادَ فيه، يَقولُ: «يا فُلانُ، أشَدَّ ما غَيَّرَتك نِقمةُ رَبِّي»."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي، وله شاهد من حديثِ أنس","takhrij":"أخرجه أبو يعلى (4212)، والطبراني في ((الأوسط)) بمعناه.","bab":"قيامة › الحساب والقصاص","dorar":"6bwjEwBr","merged":2,"otherRefs":["البدور السافرة 273 (حسن)"]},{"id":"س-06801","fp":"c46f788b9044","stateId":665,"easy":"إذا شبت شيبة في سبيل الله ← تكون لك نوراً يوم القيامة","cause":"ومَن شابَ شَيْبةً في سبيلِ اللهِ","result":"كانت له نورًا يَومَ القيامةِ","explicit":true,"star":true,"similar":["س-03741","س-01437","س-06814"],"otherNeedIds":[15],"ref":"تخريج المسند لشعيب 17022","srcLabel":"مسلم","text":["حاصَرْنا مع نَبيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ حِصنَ الطائفِ، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن بَلَغَ بسَهمٍ فله درجةٌ في الجَنَّةِ. قال: فبلَّغْتُ يَومَئذٍ ستَّةَ عَشَرَ سَهمًا، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن رَمى بسَهمٍ في سبيلِ اللهِ عزَّ وجلَّ فهو عِدْلُ مُحَرَّرٍ، ",["ومَن شابَ شَيْبةً في سبيلِ اللهِ، ",1],["كانت له نورًا يَومَ القيامةِ، ",2],"وأَيُّما رجُلٍ مُسلِمٍ أَعتَقَ رجُلًا مُسلِمًا، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِه عَظْمًا مِن عِظامِ مُحَرِّرِه مِنَ النارِ، وأَيُّما امْرأةٍ مُسلِمةٍ أَعتَقَتِ امْرأةً مُسلِمةً، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِها عَظْمًا مِن عِظامِ مُحَرِّرِها مِنَ النارِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (3966) مختصرا بنحوه، والترمذي (1638) مختصرا، والنسائي (3145) مختصرا باختلاف يسير، وأحمد (17022) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"hWvbEIGM","merged":8,"otherRefs":["تخريج المسند لشعيب 17020 (صحيح)","صحيح النسائي 3142 (صحيح)","مسند الفاروق 1/133 (صحيح)","صحيح النسائي 3144 (صحيح)","السلسلة الصحيحة 3371 (حسن)","تخريج المسند لشعيب 19437 (صحيح)","تخريج المسند لشعيب 19440 (صحيح)"]},{"id":"س-02308","fp":"dc017882ee1c","stateId":665,"easy":"إذا مشيت في ظلم الليل إلى المساجد ← فأبشر بالنور التام يوم القيامة","cause":"المشَّائِينَ في ظُلَمِ اللَّيلِ إلى المساجِدِ","result":"بالنُّورِ التَّامِّ يومَ القيامةِ","explicit":true,"star":true,"apply":{"k":"time","t":"في السجود"},"similar":["س-06722","س-07973","س-02095"],"ref":"الأحاديث المختارة 1713","srcLabel":"البخاري","text":["«بَشِّرِ ",["المشَّائِينَ في ظُلَمِ اللَّيلِ إلى المساجِدِ",1]," ",["بالنُّورِ التَّامِّ يومَ القيامةِ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JtUVp002","merged":3,"otherRefs":["صحيح ابن ماجه 639 (صحيح)","مجمع الزوائد 2/33 (حسن)"]},{"id":"س-01410","fp":"a9868accf1f5","stateId":665,"easy":"إذا أسبغت الوضوء ← تأتي يوم القيامة غراً محجلاً","cause":"مِن إسباغِ الوُضوءِ","result":"أنتُمُ الغُرُّ المُحَجَّلونَ يَومَ القيامةِ","explicit":true,"star":true,"similar":["س-07879","س-01461"],"ref":"صحيح مسلم 246","srcLabel":"متفق عليه","text":["رَأيتُ أبا هُرَيرةَ يَتَوضَّأُ فغَسَلَ وجهَه فأسبَغَ الوُضوءَ، ثُمَّ غَسَلَ يَدَه اليُمنى حتَّى أشرَعَ في العَضُدِ، ثُمَّ يَدَه اليُسرى حتَّى أشرَعَ في العَضُدِ، ثُمَّ مَسَحَ رَأسَه، ثُمَّ غَسَلَ رِجلَه اليُمنى حتَّى أشرَعَ في السَّاقِ، ثُمَّ غَسَلَ رِجلَه اليُسرى حتَّى أشرَعَ في السَّاقِ، ثُمَّ قال: هَكَذا رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَتَوضَّأُ. وقال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["أنتُمُ الغُرُّ المُحَجَّلونَ يَومَ القيامةِ",2]," ",["مِن إسباغِ الوُضوءِ",1],"، فمَنِ استَطاعَ مِنكم فليُطِلْ غُرَّتَه وتَحجيلَه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (136) بنحوه، ومسلم (246).","bab":"وضوء › صفة الوضوء","dorar":"DyWc9NTM"},{"id":"س-03741","fp":"0c9c058c19c5","stateId":665,"easy":"إذا شبت شيبة ← فهي لك نور يوم القيامة","cause":"من شاب شَيبةً","result":"فهي له نورٌ يَومَ القيامةِ، فلا أحِبُّ أن أُغَيِّرَ نُوري","explicit":true,"repOf":"س-06801","otherNeedIds":[15],"ref":"الأحاديث المختارة 129","text":["«رأيتُ عُمَرَ لا يُغَيِّرُ شَيبه بشَيءٍ، وقال: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["من شاب شَيبةً ",1],["فهي له نورٌ يَومَ القيامةِ، فلا أحِبُّ أن أُغَيِّرَ نُوري»",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"اعتصام بالسنة › لزوم السنة","dorar":"Xw33wo1q"},{"id":"س-02842","fp":"875e0a5586b6","stateId":665,"easy":"إذا أعتقت مسلماً ← كان فكاكك من النار وله نور يوم القيامة","cause":"مَن أعتَقَ امرَأً مُسلِمًا كان فِكاكَه منَ النارِ، يُجْزى بكلِّ عَظمٍ منه عَظمًا منه، ومَن أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عَظميْنِ منهما عَظمًا منه، ومَن شابَ شَيبةً في سَبيلِ اللهِ","result":"كانت له نورًا يومَ القيامةِ","explicit":true,"star":true,"otherNeedIds":[15],"ref":"تخريج المسند لشعيب 18064","srcLabel":"مسلم","text":[["مَن أعتَقَ امرَأً مُسلِمًا كان  فِكاكَه منَ النارِ، يُجْزى بكلِّ عَظمٍ منه عَظمًا منه، ومَن أعتَقَ امرأتَيْنِ مُسلِمتَيْنِ كانَتا فِكاكَه منَ النارِ، يُجْزى بكلِّ عَظميْنِ منهما عَظمًا منه، ومَن شابَ شَيبةً في سَبيلِ اللهِ ",1],["كانت له نورًا يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"كعب بن مرة","muhaddith":"صحيح لغيره، دون قوله: \"ومن أعتق امرأتين مسلمتين ... \"","takhrij":"أخرجه الترمذي (1634)، والنسائي (3144) مختصراً، وأحمد (18064) واللفظ له","bab":"إيمان › الوعد","dorar":"niF4qGm6"},{"id":"س-07879","fp":"294c38029341","stateId":665,"easy":"إذا حافظت على الطهور ← تأتي غراً محجلاً","cause":"من أَثَرِ الطُّهُورِ","result":"فنَمْضِي غُرًّا مُحَجَّلِينَ","explicit":true,"repOf":"س-01410","otherNeedIds":[68],"ref":"تخريج المسند لشاكر 4/241","text":["إنَّهُ لم يكُنْ نبيٌّ إلا لَهُ دَعْوَةٌ تَنَجَّزَهَا في الدنيا وإنِّى اختَبَأْتُ دَعْوَتِي شَفَاعَةً لأمَّتِي وأنا سَيِّدُ ولدِ آدَمَ يومَ القيامَةِ ولا فَخْرَ وأنا أوَّلُ من تنشقُّ عنه الأرضُ ولا فخرَ وبِيدِي لواءُ الحمدِ ولا فخرَآدمُ فمن دونَهُ تَحْتَ لِوَائِي قالَ: ويطولُ يومَ القيامَةِ على الناسِ حتى يقولَ بعضُهُم لِبَعضٍ انطلِقُوا بِنَا إلى آدَمَ أبِي البشرِ فيشفعُ لنَا إلَى ربِّه عزَّ وجَلَّ فلْيَقْضِ بينَنَا فيأتُونَ آدمَ عليه السلامُ فيقولونَ: يا آدمُ أنتَ الذِي خَلَقَكَ اللهُ بِيَدِهِ وأسكَنَكَ جنَّتَهُ وأسجَدَ لكَ ملائكتَهُ فاشفعْ لنَا إلى ربكَ فليقضِ بينَنَا فيقولُ: إنِّي لستُ هُنَاكُم إنِّي قد أُخْرِجْتُ من الجنةِ بخطيئتِي وإنه لا يهمُّنِي اليومَ إلا نفسِي ولكن ائْتُوا نوحًا رأسَ النبيينَ فيأتون نوحًا فيقولونَ: يا نوحُ اشفعْ لَنَا إلى ربكَ فليقضِ بينَنَا فيقولُ: إني لستُ هناكُم إني قد دعوتُ دعوةً أَغْرَقَتْ أهلَ الأرضِ وإنه لا يهمُّنِي اليومَ إلا نفسِي ولكن ائْتُوا إبراهيمَ خليلَ اللهِ عليه السلامُ قال: فيأتونَ إبراهيمَ فيقولون: يا إبراهيمُ اشفعْ لنا إلى ربكَ فليقضِ بينَنَا فيقولُ: إني لستُ هُناكُم إنِّي قد كذبت في الإسلام ثلاثَ كَذِبَاتٍ وإنه لا يهمني اليوم إلا نفسِي فقالَ رسولُ الله صلَّى اللهُ عليه وسلَّم: إنْ حَاوَلَ بِهِنَّ إلا عن دِينِ اللهِ قوله: { إِنِّي سَقِيمٌ } وقولُهُ { بَلْ فَعَلَهُ كَبِيرُهُمْ هَذَا } وقَوْلُهُ لامرأتِهِ إنَّها أُخْتِي ولكن ائتُوا موسى عليه السلامُ الذي اصطفاه اللهُ برسالتِهِ وكلامِهِ فيأتُونَ موسَى فيقولُونَ: يا موسَى أنتَ الذِي اصطفاكَ اللهُ برسالتِهِ وكلَّمَكَ فاشْفَعْ لنَا إلى ربك فليقْضِ بينَنَا فيقول: إني لست هُنَاكُم إني قتَلْتُ نفْسًا بغير نفسٍ وإنه لا يهمني اليوم إلا نفسِي ولكن ائْتُوا عيسَى رُوحَ اللهِ وكلمتَه فيأتونَ عيسى فيقولون: يا عيسى أنت روحُ اللهِ وكلمتُه فاشفعْ لنا إلى ربك فليقْضِ بينَنَا فيقولُ: إني لستُ هُنَاكُم قد اتُّخِذْتُ إلهًا من دونِ اللهِ وإنه لا يهمني اليوم إلا نفسي ثم قال: أرأيتم لو كانَ متاعٌ في وعاءٍ قد خُتِمَ عليه أكانَ يُقدَرُ علَى ما في الوعَاءِ حتَّى يُفَضَّ الخاتَمُ فيقولونَ: لا فيقول: إن محمدًا صلَّى اللهُ عليه وسلَّم خاتَمَ النبيينَ قد حَضَرَ اليومَ وقد غُفِرَ لَهُ ما تقدَّمَ من ذنبِهِ وما تَأَخَّرَ قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فيأتُونِي فيقولونَ: يا محمدُ اشفَعْ لنَا إلى ربِّكَ فليَقْضِ بينَنَا فأقولُ: نعم أنَا لها حتَّى يأذَنَ اللهُ لمن يشاءُ ويرضَى فإذا أرادَ اللهُ عزَّ وجَلَّ أن يصدَعَ بين خلقِهِ نادَى منادٍ: أينَ أحْمَدُ وأمَّتُهُ فنحنُ الآخِرُونَ الأوَّلُونَ فنحنُ آخِرُ الأُمَمِ وأوَّلُ من يُحَاسَبُ فتُفَرِّجُ لنَا الأُمَمُ عن طريقِنَا ",["فنَمْضِي غُرًّا مُحَجَّلِينَ",2]," ",["من أَثَرِ الطُّهُورِ",1]," وتقولُ الأممُ: كادتْ هذه الأمةُ أن تكونَ أنبياءَ كلَّهَا قالَ: ثم آتِي بابَ الجنةِ فآخُذُ بِحَلْقَةِ بابِ الجنةِ فأقْرَعُ البابَ فيقالُ: مَنْ أَنْتَ فأقولُ: محمدٌ فيُفْتَحُ لي فأرى ربِّي عزَّ وجَلَّ وهو على كُرْسِيِّهِ أو سَرِيرِه فأَخِرُّ له ساجِدًا وأحَمِدُهُ بمحَامِدَ لم يَحْمِدْه بِهَا أَحَدٌ كانَ قبْلِي ولا يَحمِدُهُ بِهَا أحدًا بعدِي فيقالُ: ارفَعْ رأسَكَ وقُل تُسْمَعْ وسَلْ تُعْطَهْ واشفَعْ تُشْفَعْ قالَ: فأرفَعُ رأسِي فأقولُ: أيْ ربِّ أُمَّتي أُمَّتي فيقالُ لي: أَخْرِجْ من النارِ مَن كانَ في قَلْبِهِ مِثْقَالَ كذا وكذا فأخرِجْهُمْ ثم أعُودُ فَأَخِرُّ ساجِدًا وأحْمِدُهُ بمحامِدَ لم يَحْمِدْهُ بِهَا أحَدٌ كان قبلِي ولا يحمدُهُ بِهَا أحدٌ بعدِي فيُقَالُ لِي: ارفَعْ رأسَكَ وقُل تُسْمَعْ وسَلْ تُعْطَهْ واشفَعْ تُشْفَعْ فأرفَعُ رأسِي فأقولُ: أيْ ربِّ أُمَّتي أُمَّتي فيقالُ لي: أَخْرِجْ من النارِ مَن كانَ في قَلْبِهِ مِثْقَالَ كذا وكذا فأخرِجْهُمْ قالَ: وقالَ في الثالِثَةِ مثلَ هذَا أيضًا"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطيالسي (2834)، وأبو يعلى (2328)، والبيهقي في ((شعب الإيمان)) (1488) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"FqOjRpAz","merged":13,"otherRefs":["تخريج صحيح ابن حبان 7240 (صحيح)","تخريج المسند لشعيب 9292 (صحيح)","صحيح مسلم 246 (صحيح)","صحيح مسلم 247 (صحيح)","تخريج صحيح ابن حبان 1048 (صحيح)","صحيح ابن ماجه 3490 (صحيح)","معرفة السنن والآثار 738 (صحيح)","تخريج المسند لشعيب 17693 (صحيح)","تخريج المسند لشعيب 22257 (صحيح)","المصابيح في الأحاديث المتواترة 587 (صحيح)","صحيح ابن ماجه 3494 (صحيح)"]},{"id":"ق-0152","fp":"4b8585ec08f3","stateId":665,"easy":"الثبات على الإيمان ← بياض الوجه والخلود في رحمة الله","cause":"الثبات على الإيمان","result":"بياض الوجه والخلود في رحمة الله","explicit":true,"otherNeedIds":[24],"ref":"سورة آل عمران: 107","srcLabel":"القرآن الكريم","quran":{"s":3,"from":107,"to":107,"text":"وَأَمَّا الَّذِينَ ابْيَضَّتْ وُجُوهُهُمْ فَفِي رَحْمَةِ اللَّهِ هُمْ فِيهَا خَالِدُونَ (107)","hl":[[0,19,1],[19,87,2]]}},{"id":"ق-1298","fp":"fa2a2ba1d1d3","stateId":665,"easy":"الإيمان ← نور يسعى بين الأيدي وبالأيمان والبشرى بالجنات","cause":"الإيمان","result":"نور يسعى بين الأيدي وبالأيمان والبشرى بالجنات","explicit":true,"otherNeedIds":[67],"ref":"سورة الحديد: 12","srcLabel":"القرآن الكريم","quran":{"s":57,"from":12,"to":12,"text":"يَوْمَ تَرَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ يَسْعَى نُورُهُمْ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ بُشْرَاكُمُ الْيَوْمَ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا ذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ (12)","hl":[[0,45,1],[45,217,2]]}},{"id":"س-03514","fp":"4b537f48bf8d","stateId":665,"easy":"إذا شبت شيبة في الإسلام ← تكون لك نوراً يوم القيامة","cause":"ما من مسلمٍ يشيبُ شَيْبةً في الإسلامِ -قال عن سُفْيانَ","result":"إلَّا كانت له نورًا يومَ القيامةِ، وقال في حديثِ يَحْيى: إلَّا كتَبَ اللهُ له بها حسنةً، وحطَّ عنه بها خَطيئةً","explicit":true,"similar":["س-03498"],"otherNeedIds":[45,11],"ref":"تخريج سنن أبي داود 4202","srcLabel":"الترمذي","text":["لا تَنتِفوا الشَّيْبَ، ",["ما من مسلمٍ يشيبُ شَيْبةً في الإسلامِ -قال عن سُفْيانَ- ",1],["إلَّا كانت له نورًا يومَ القيامةِ، وقال في حديثِ يَحْيى: إلَّا كتَبَ اللهُ له بها حسنةً، وحطَّ عنه بها خَطيئةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2821)، والنسائي (5068) مختصراً باختلاف يسير، وأحمد (6937) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"361QRUUF","merged":2,"otherRefs":["تخريج المسند لشاكر 10/156 (صحيح)"]},{"id":"س-05127","fp":"e648c519b7ac","stateId":665,"easy":"إذا حافظت على الصلاة ← تكون لك نوراً وبرهاناً ونجاة يوم القيامة","cause":"مَن حافَظَ عليها","result":"كانت له نورًا وبُرهانًا ونَجاةً يومَ القيامةِ","explicit":true,"otherNeedIds":[66],"ref":"تخريج مشكل الآثار 3180","srcLabel":"أحمد","text":["ذكَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الصَّلاةَ يومًا، فقال: ",["مَن حافَظَ عليها ",1],["كانت له نورًا وبُرهانًا ونَجاةً يومَ القيامةِ، ",2],"ومَن لم يُحافِظْ عليها، لم تكُنْ له نورًا ولا بُرهانًا ولا نَجاةً، وكان يومَ القيامةِ مع فِرعونَ، وقارونَ، وهامانَ، وأُبَيٍّ صاحبِ العِظامِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6576)، والدارمي (2721)، وابن حبان (1467) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"QKOyihCm","merged":2,"otherRefs":["مجموع فتاوى ابن باز 234/10 (حسن)"]},{"id":"س-05390","fp":"78d1b4eafb99","stateId":665,"easy":"إذا تحاببت في الله مع أناس شتى ← تكون وجوهكم نوراً وعلى نور لا تخافون إذا خاف الناس","cause":"هم ناسٌ من قبائلَ شتَّى يتحابُّونَ في اللهِ","result":"إنَّ وجوهَهم لنورٌ وإنَّهم لعلى نورٍ لا يخافونَ إذا خاف النَّاسُ ولا يحزَنونَ إذا حزِنوا","explicit":true,"repOf":"س-05391","otherNeedIds":[6],"ref":"مجمع الزوائد 10/280","text":["كان فينا رجلٌ معشرَ الأشعريِّينَ قد صحِب رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم وشهِد معه مشاهدَه الحسنةَ الجميلةَ يُقالُ له مالكٌ أو ابنُ مالكٍ - شكَّ عوفٌ - فأتى يومًا فقال أتَيْتُكم لأُعلِّمَكم وأُصلِّيَ بكم كما كان رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم يُصلِّي بنا فدعا بجَفْنةٍ عظيمةٍ فجعَل فيها من الماءِ ثُمَّ دعا بإناءٍ صغيرٍ فجعَل يُفرِغُ من الإناءِ الصَّغيرِ على أيدينا ثُمَّ قال أسبِغوا الآنَ الوُضوءَ ثُمَّ قام فصلَّى بنا صلاةً تامَّةً وجيزةً فلمَّا انصرَف قال قال لنا رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم قد علِمْتُ أنَّ أقوامًا ليسوا بأنبياءَ ولا شهداءَ يغبِطُهم الأنبياءُ والشُّهداءُ بمكانِهم من اللهِ فقال رجلٌ من حَجْرةِ القومِ أعرابيٌّ قال وكان يُعجِبُنا إذا شهِدنا رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم أن يكونَ فينا الأعرابيُّ لأنَّهم يجتَرِئونَ أن يسأَلوا رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم ولا نجتَرِئُ فقال يا رسولَ اللهِ سمِّهم لنا قال فرأَينا وجهَ رسولِ الله صلَّى اللَّهُ عليه وسلَّم يتهلَّلُ ثُمَّ قال ",["هم ناسٌ من قبائلَ شتَّى يتحابُّونَ في اللهِ",1]," ",["إنَّ وجوهَهم لنورٌ وإنَّهم لعلى نورٍ لا يخافونَ إذا خاف النَّاسُ ولا يحزَنونَ إذا حزِنوا",2]],"grade":"صحيح","narrator":"مالك أو ابن مالك","muhaddith":"رجاله رجال الصحيح غير حوشب وقد وثقه غير واحد","takhrij":"أخرجه أبو يعلى (12/ 233)، واللفظ له، والحارث بن أبي أسامة كما في ((بغية الباحث)) (1109) للهيثمي بلفظ مقارب، والطبراني في ((المعجم الكبير)) (3/ 291) (3435)، مختصرا.","bab":"رقائق وزهد › الحب في الله","dorar":"vbJzs6Ev","merged":2,"otherRefs":["تخريج صحيح ابن حبان 573 (صحيح)"]},{"id":"س-06722","fp":"23471f0f8cf0","stateId":665,"easy":"إذا تخللت إلى المساجد في الظلم ← تُبشّر بنور ساطع يوم القيامة","cause":"لِلَّذِينَ يَتَخَلَّلونَ إلى المَساجِدِ في الظُّلْمِ","result":"بِنُورٍ ساطِعٍ يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"في السجود"},"repOf":"س-02308","ref":"صحيح الترغيب 317","text":["إِنَّ اللهَ لَيُضِيءُ ",["لِلَّذِينَ يَتَخَلَّلونَ إلى المَساجِدِ في الظُّلْمِ",1]," ",["بِنُورٍ ساطِعٍ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((الأوسط)) (843)، وابن شاهين في ((الترغيب)) (93) واللفظ لهما، وابن ماجة (779) بنحوه.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"FRdXZZ6Q","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 28 (صحيح)"]},{"id":"س-07312","fp":"bbff14f01f61","stateId":665,"easy":"إذا قرأت سورة الكهف كما أُنزلت ← تكون لك نوراً يوم القيامة من مقامك إلى مكة","cause":"مَنْ قرأَ سورةَ الكهفِ كما أُنْزِلَتْ","result":"كانَتْ لهُ نُورًا يومَ القيامةِ ، من مَقَامِهِ إلى مكةَ","explicit":true,"apply":{"k":"read","t":"سورة الكهف"},"otherNeedIds":[15],"ref":"السلسلة الصحيحة 2651","srcLabel":"النسائي","text":[["مَنْ قرأَ سورةَ الكهفِ [ كما أُنْزِلَتْ",1]," ] ",["كانَتْ لهُ نُورًا يومَ القيامةِ ، من مَقَامِهِ إلى مكةَ",2]," ، و مَنْ قرأَ عشرَ آياتٍ من آخِرِها ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ ، و مَنْ تَوَضَّأَ فقال : سبحانَكَ اللهمَّ و بحمدِكَ [ أشهدُ أنْ ] لا إلهَ إلَّا أنتَ ، أستغفرُكَ و أتوبُ إليكَ ، كُتِبَ في رَقٍّ ، ثُمَّ جُعِلَ في طابعٍ ، فلمْ يُكْسَرْ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455)، والحاكم (2072) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"4Vdm3x5r","merged":2,"otherRefs":["الترغيب والترهيب 2/318 (صحيح)"]},{"id":"س-01437","fp":"e02bd6dc4b04","stateId":665,"easy":"إذا شبت شيبة في سبيل الله ← فهي لك نور يوم القيامة","cause":"وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ","result":"فهي له نورٌ","explicit":true,"repOf":"س-06801","ref":"تخريج المسند لشعيب 19439","text":["أيُّما رَجُلٍ رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ، فبَلَغَ، مُخطِئًا أو مُصيبًا، فله مِن الأجْرِ كرَقبةٍ يُعتِقُها مِن وَلدِ إسماعيلَ، ",["وأيُّما رَجُلٍ شاب شَيبةً في سَبيلِ اللهِ",1],"، ",["فهي له نورٌ",2],"، وأيُّما رَجُلٍ مُسلِمٍ أعتَقَ رَجُلًا مُسلِمًا، فكلُّ عُضوٍ مِن المُعتَقِ بعُضوٍ مِن المُعتِقِ فِداءٌ له مِن النَّارِ، وأيُّما امرأةٍ مُسلِمةٍ أعتَقَتِ امرأةً مُسلِمةً، فكلُّ عُضوٍ مِن المُعتَقةِ بعُضوٍ مِن المُعتِقةِ فِداءٌ لها مِن النَّارِ، وأيُّما رَجُلٍ مُسلِمٍ قَدَّمَ للهِ عزَّ وجلَّ مِن صُلبِه ثلاثةً لم يَبلُغوا الحِنثَ، أو امرأةٍ، فهم له سُترةٌ مِن النَّارِ، وأيُّما رَجُلٍ قام إلى وُضوءٍ يُريدُ الصَّلاةَ، فأحصى الوُضوءَ إلى أماكنِه، سَلِمَ مِن كلِّ ذَنبٍ أو خَطيئةٍ له، فإنْ قام إلى الصَّلاةِ، رَفَعَه اللهُ عزَّ وجلَّ بها دَرجةً، وإنْ قَعَدَ، قَعَدَ سالمًا. فقال شُرَحبيلُ بنُ السِّمطِ: آنتَ سَمِعتَ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يا ابنَ عَبَسةَ؟ قال: نَعَمْ، والذي لا إلهَ إلَّا هو، لو أنِّي لم أسمَعْ هذا الحديثَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غيرَ مَرَّةٍ أو مَرَّتَينِ أو ثلاثٍ أو أربعٍ أو خَمسٍ أو ستٍّ أو سَبعٍ -فانتَهى عندَ سَبعٍ-، ما حَلَفتُ -يَعني ما بالَيتُ- ألَّا أُحدِّثَ به أحَدًا مِن النَّاسِ، ولكنِّي واللهِ ما أدري عَددَ ما سَمِعتُه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه النسائي (3142) مختصراً، وأحمد (19439) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"LicciAss"},{"id":"س-02903","fp":"e5cc496a8884","stateId":665,"easy":"إذا حلقت رأسك في الحج ← تكون كل شعرة نوراً لك يوم القيامة","cause":"وأما حلقُك رأسَك","result":"فإنه ليس من شعرِك شعرةٌ تقعُ في الأرضِ ؛ إلا كانت لك نورًا يومَ القيامةِ","explicit":true,"similar":["س-02825"],"otherNeedIds":[15],"ref":"صحيح الترغيب 1160","srcLabel":"الطبراني","text":[["وأما حلقُك رأسَك ؛ ",1],["فإنه ليس من شعرِك شعرةٌ تقعُ في الأرضِ ؛ إلا كانت لك نورًا يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (2320) واللفظ له.","bab":"إيمان › الوعد","dorar":"Z2pDfgrA"},{"id":"س-03498","fp":"20c2ed22ae61","stateId":665,"easy":"إذا شبت في الإسلام فلا تنتف شيبك ← فإنه نور يوم القيامة وتُكتب لك به حسنة","cause":"لا تنتِفوا الشَّيبَ","result":"فإنَّه نورٌ يومَ القيامةِ ومَن شاب شيبةً في الإسلامِ كُتِب له بها حسنةٌ وحُطَّ عنه بها خطيئةٌ ورُفِع له بها درجةٌ","explicit":true,"repOf":"س-03514","otherNeedIds":[15,45],"ref":"صحيح ابن حبان 2985","text":[["لا تنتِفوا الشَّيبَ ",1],["فإنَّه نورٌ يومَ القيامةِ ومَن شاب شيبةً في الإسلامِ كُتِب له بها حسنةٌ وحُطَّ عنه بها خطيئةٌ ورُفِع له بها درجةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (3601)، وابن عدي في ((الكامل في الضعفاء)) (5/263)، والدارقطني في ((الأفراد)) كما في ((أطراف الغرائب والأفراد)) لابن طاهر المقدسي (5/186) مختصراً بنحوه","bab":"استغفار › مكفرات الذنوب","dorar":"NGGJYbty"},{"id":"س-03516","fp":"002bf6f18921","stateId":665,"easy":"إذا قرأت سورة الكهف يوم الجمعة ← يسطع لك نور من تحت قدمك إلى عنان السماء","cause":"مَن قرَأَ سورةَ الكَهفِ يومَ الجمُعةِ","result":"سطَعَ له نورٌ من تحتِ قَدَمِه إلى عَنانِ السماءِ يُضيءُ به يومَ القيامةِ، وغُفِرَ له ما بينَ الجمُعَتَينِ","explicit":true,"apply":{"k":"read","t":"سورة الكهف · الوقت: يوم الجمعة أو ليلتها"},"otherNeedIds":[11],"ref":"تخريج زاد المعاد 1/366","srcLabel":"الحاكم","text":[["مَن قرَأَ سورةَ الكَهفِ يومَ الجمُعةِ ",1],["سطَعَ له نورٌ من تحتِ قَدَمِه إلى عَنانِ السماءِ يُضيءُ به يومَ القيامةِ، وغُفِرَ له ما بينَ الجمُعَتَينِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (3392)، والبيهقي (6209) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"vAGy1Svl"},{"id":"س-06791","fp":"dcc025721f02","stateId":665,"easy":"إذا أعتقت رقبة مسلمة أو شبت في سبيل الله ← تكون لك نوراً يوم القيامة","cause":"ومن أعتقَ رقبةً مسلمةً كانَ فداءُ كلِّ عضوٍ منْهُ عضوًا منْهُ ، من نارِ جَهنَّمَ ، ومن شابَ شيبةً في سبيلِ اللَّهِ","result":"كانت لَهُ نورًا يومَ القيامةِ","explicit":true,"otherNeedIds":[15],"ref":"صحيح النسائي 3145","srcLabel":"الترمذي","text":["من رمى بسَهمٍ في سبيلِ اللَّهِ فبلغَ العدوَّ أخطأَ أو أصابَ كانَ لَهُ كعِدلِ رقبةٍ ",["ومن أعتقَ رقبةً مسلمةً كانَ فداءُ كلِّ عضوٍ منْهُ عضوًا منْهُ ، من نارِ جَهنَّمَ ، ومن شابَ شيبةً في سبيلِ اللَّهِ ",1],["كانت لَهُ نورًا يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1638) بنحوه، والنسائي (3145) واللفظ له، وابن ماجه (2812) مختصراً، وأحمد (17020) باختلاف يسير.","bab":"عتق وولاء › فضل العتق","dorar":"FtWmJfNf"},{"id":"س-06814","fp":"fd1fffcc0068","stateId":665,"easy":"إذا أصابك شيب في سبيل الله ← فهو لك نور يوم القيامة","cause":"ومَن أصابَه شَيبٌ في سَبيلِ اللهِ عَزَّ وجَلَّ","result":"فهو له نورٌ يَومَ القيامةِ","explicit":true,"repOf":"س-06801","otherNeedIds":[15],"ref":"تخريج المسند لشعيب 19428","text":["حاصَرنا مَعَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حِصنَ الطَّائِفِ أو قَصرَ الطَّائِفِ، فقال: «مَن بَلَغَ بسَهمٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، فلَه دَرَجةٌ في الجَنَّةِ»، فبَلَغتُ يَومَئِذٍ سِتَّةَ عَشَرَ سَهمًا. «ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عَزَّ وجَلَّ، فهو له عَدلُ مُحَرَّرٍ، ",["ومَن أصابَه شَيبٌ في سَبيلِ اللهِ عَزَّ وجَلَّ ",1],["فهو له نورٌ يَومَ القيامةِ، ",2],"وأيُّما رَجُلٍ أعتَقَ رَجُلًا مُسلِمًا، جَعَلَ اللهُ عَزَّ وجَلَّ وِقاءَ كُلِّ عَظمٍ مِن عِظامِه عَظمًا مِن عِظامِ مُحَرَّرِه مِنَ النَّارِ. وأيُّما امرَأةٍ مُسلِمةٍ أعتَقَتِ امرَأةً مُسلِمةً؛ فإنَّ اللهَ عَزَّ وجَلَّ جاعِلٌ وِقاءَ كُلِّ عَظمٍ مِن عِظامِها عَظمًا مِن عِظامِ مُحَرَّرِها مِنَ النَّارِ»"],"grade":"صحيح","narrator":"أبو نجيح السلمي","muhaddith":"إسناده صحيح","bab":"عتق وولاء › فضل العتق","dorar":"n9mz7kuy"},{"id":"س-07973","fp":"d86cd238422e","stateId":665,"easy":"إذا مشيت في ظلمة الليل إلى المساجد ← تلقى الله بنور يوم القيامة","cause":"من مشى في ظلمةِ الليلِ إلى المساجدِ","result":"لقيَ اللهَ عزَّ و جلَّ بنورٍ يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"في السجود"},"repOf":"س-02308","otherNeedIds":[15],"ref":"صحيح الترغيب 424","text":[["من مشى في ظلمةِ الليلِ إلى المساجدِ ",1],["لقيَ اللهَ عزَّ و جلَّ بنورٍ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (6499) واللفظ له، وابن حبان (2046)، والطبراني في ((المعجم الأوسط)) (4697) باختلاف يسير.","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"hup4p4fv"},{"id":"س-00735","fp":"7f5bbc9780c2","stateId":665,"easy":"إذا زينت مجالسك بالصلاة على النبي ﷺ ← تكون نوراً لك يوم القيامة","cause":"زَيِّنوا مَجالِسَكم بالصَّلاةِ علَيَّ","result":"فإنَّ صَلاتَكم علَيَّ نورٌ لكم يومَ القيامَةِ","explicit":true,"ref":"مختصر المقاصد 515","srcLabel":"ابن عساكر","text":[["زَيِّنوا مَجالِسَكم بالصَّلاةِ علَيَّ ",1],["فإنَّ صَلاتَكم علَيَّ نورٌ لكم يومَ القيامَةِ",2]],"grade":"حسن","narrator":"[عائشة أم المؤمنين]","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن عساكر في ((تاريخه)) (44/ 380)، وأورده العجلوني في ((كشف الخفاء)) (1/ 508)وعزاه للديلمي.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"YhAjZqze"},{"id":"س-02095","fp":"b07b6eac5f81","stateId":665,"easy":"إذا مشيت في ظلمة الليل إلى المسجد ← تلقى الله بنور تام","cause":"مَن مَشى في ظُلمَةِ الليلِ إلى المسجِدِ إلى صلاةٍ","result":"لَقي اللهَ ، عزَّ وجلَّ ، بنورٍ تامٍّ","explicit":true,"repOf":"س-02308","ref":"إتحاف الخيرة المهرة 2/31","text":[["مَن مَشى في ظُلمَةِ الليلِ إلى المسجِدِ إلى صلاةٍ ",1],["لَقي اللهَ ، عزَّ وجلَّ ، بنورٍ تامٍّ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"[روي بإسناد حسن]","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (6499)، وابن حبان (2046)، والطبراني في ((المعجم الأوسط)) (4697) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"bOdtQ5pI"},{"id":"س-02104","fp":"ef1e3dc63e8c","stateId":665,"easy":"إذا تلوت القرآن ← يكون لك نوراً يوم القيامة","cause":"ومن تلاها","result":"كانت لَهُ نورًا يومَ القيامَةِ","explicit":true,"otherNeedIds":[15],"ref":"الدر المنثور 6/726","srcLabel":"أحمد","text":["منِ استمَعَ إلى آيةٍ من كتابِ اللَّهِ كتبت لَهُ حسنةٌ مضاعَفةٌ ",["ومن تلاها ",1],["كانت لَهُ نورًا يومَ القيامَةِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (8475)، وابن منده في ((من يقول الم حرف)) (24) واللفظ لهما، والعقيلي في ((الضعفاء)) (3/ 133)، وأبو عمرو الداني في ((البيان)) (ص23) كلاهما بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DJOL6Vmp"},{"id":"س-02832","fp":"1f3689f98c04","stateId":665,"easy":"إذا ذهب بصرك وأنت صالح ← يجعل الله لك نوراً يوم القيامة","cause":"من ذَهبَ بصَرُه في الدُّنيا","result":"جعَلَ اللَّهُ لَهُ نورًا يومَ القِيامةِ إن كانَ صالِحًا","explicit":true,"otherNeedIds":[15],"ref":"الجامع الصغير 8662","srcLabel":"الطبراني","text":[["من ذَهبَ بصَرُه في الدُّنيا ",1],["جعَلَ اللَّهُ لَهُ نورًا يومَ القِيامةِ إن كانَ صالِحًا",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1220) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/13) باختلاف يسير","bab":"إيمان › الوعد","dorar":"C7RGIsJg"},{"id":"س-05391","fp":"9b5fe426b45e","stateId":665,"easy":"إذا تحاببتم بروح الله ← يجعل الله وجوهكم نوراً ويجعل لكم منابر من نور قدام الرحمن","cause":"يتحابُّونَ بروحِ اللهِ","result":"يجعلُ اللهُ وجوهَهم نورًا وتُجعَلُ لهم منابرَ من نورٍ قدامَ الرحمنِ يفزعُ النَّاسُ ولا يفزعونَ ويخافُ النَّاسُ ولا يخافونَ","explicit":true,"similar":["س-05390"],"otherNeedIds":[6,26],"ref":"هداية الرواة 4/439","srcLabel":"أحمد","text":["كنتُ عندَ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ إذ قالَ إنَّ للَّهِ عبادًا ليسوا بأنبياءَ ولا شهداءَ يغبطُهمُ النَّبيونَ والشُّهداءُ بقربِهم ومقعدِهم منَ اللهِ يومَ القيامةِ فقالَ أعرابيُّ حدِّثنا يا رسولَ اللهِ من هم فقال هم عبادٌ من عبادِ اللهِ من بلدانٍ شتَّى وقبائلَ شتَّى لم يكن بينهم أرحامٌ يتواصلونَ بها ولا دنيا يتباذلونَ بها ",["يتحابُّونَ بروحِ اللهِ",1]," ",["يجعلُ اللهُ وجوهَهم نورًا وتُجعَلُ لهم منابرَ من نورٍ قدامَ الرحمنِ يفزعُ النَّاسُ ولا يفزعونَ ويخافُ النَّاسُ ولا يخافونَ",2]],"grade":"حسن","narrator":"أبو مالك الأشعري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أحمد (22894)، والطبراني (3/290) (3433)، والبيهقي في ((الأسماء والصفات)) (976) باختلاف يسير","bab":"رقائق وزهد › الحب في الله","dorar":"d5PamRQG"},{"id":"س-01461","fp":"8ebbd7bbad8c","stateId":665,"easy":"إذا توضأت ← تأتي يوم القيامة أغر محجلاً","cause":"من أثرِ الوضوءِ","result":"هم غُرٌّ محجَّلونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01410","ref":"هداية الرواة 286","text":["أنا أوَّلُ من يُؤذَنُ لَهُ بالسُّجودِ يومَ القيامةِ، وأنا أوَّلُ من يُؤذَنُ لَهُ أن يرفعَ رأسَهُ، فأنظُرَ إلى ما بينِ يديَّ، فأعرفَ أمَّتي مِن بينِ الأممِ، ومِن خلفي مثلُ ذلِكَ، وعَن يميني مثلُ ذلِكَ، وعَن شمالي مثلُ ذلِكَ فقالَ رجلٌ: يا رسولَ اللهِ، كيفَ تعرفُ أمَّتَكَ من بينِ الأممِ فيما بينَ نوحٍ إلى أمَّتِكَ ؟ قالَ: ",["هم غُرٌّ محجَّلونَ",2]," ",["من أثرِ الوضوءِ",1],"، ليسَ أحدٌ كذلِكَ غيرَهم، وأعرفُهم أنَّهم يؤتَونَ كتُبَهم بأيمانِهم، وأعرفُهم تَسعى بينَ أيديهِم ذرِّيَّتُهُم"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (21737)، والطبراني في ((المعجم الأوسط)) (3234)، والحاكم (3784) باختلاف يسير","bab":"وضوء › فضل الوضوء","dorar":"b8yjHAQP","merged":4,"otherRefs":["تخريج المسند لشعيب 10778 (صحيح)","صحيح ابن حبان 1047 (صحيح)","تخريج المسند لشعيب 3820 (صحيح)"]},{"id":"س-04315","fp":"3d8045ed5006","stateId":665,"easy":"إذا عملت صالحاً ← تُعطى نورك على قدر عملك","cause":"على قَدْرِ أعمالِهم","result":"فيُعطيهم نُورَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-02011","س-08194"],"ref":"الترغيب والترهيب 4/365","srcLabel":"الحاكم","text":["يَجمَعُ اللهُ الأوَّلينَ والآخِرينَ لمِيقاتِ يَومٍ مَعلومٍ، قيامًا أربَعينَ سَنةً، شاخِصةً أبصارُهم، يَنتَظِرونَ فَصلَ القَضاءِ، قال: ويَنزِلُ اللهُ عَزَّ وجَلَّ في ظُلَلٍ مِن الغَمامِ مِن العَرشِ إلى الكُرسيِّ، ثمَّ يُنادي مُنادٍ: أيُّها الناسُ: ألم تَرضَوْا مِن رَبِّكمُ الذي خَلَقَكم ورَزَقَكم، وأمَرَكم أنْ تَعبُدوه ولا تُشرِكوا به شَيئًا أنْ يُوَلِّيَ كلَّ إنسانٍ منكم ما كانوا يَعبُدونَ في الدُّنيا؟ أليسَ ذلكَ عَدلًا مِن رَبِّكم؟ قالوا: بَلى. فيَنطَلِقُ كلُّ قَومٍ إلى ما كانوا يَعبُدونَ ويَتوَلَّوْنَ في الدُّنيا. قال: فيَنطَلِقونَ ويُمَثَّلُ لهم أَشْباهُ ما كانوا يَعبُدونَ؛ فمِنهم مَن يَنطَلِقُ إلى الشَّمسِ، ومنهم مَن يَنطَلِقُ إلى القَمَرِ والأَوْثانِ مِن الحِجارةِ، وأَشْباهِ ما كانوا يَعبُدونَ. قال: ويُمَثَّلُ لمَن كان يَعبُدُ عيسى شَيطانُ عيسى، ويُمَثَّلُ لمن كان يَعبُدُ عُزَيرًا شَيطانُ عُزَيرٍ، ويَبقى محمَّدٌ صلَّى اللهُ عليه وسلَّمَ وأُمَّتُه، قال: فيَتمَثَّلُ الرَّبُّ تَبارَكَ وتَعالى فيَأْتيهم فيقولُ: ما لكم لا تَنطَلِقونَ كما انطَلَقَ الناسُ؟ قال: فيقولونَ: إنَّ لنا إلهًا ما رأَيْناه. فيقولُ: هل تَعرِفونَه إنْ رأَيتُموه؟ فيقولونَ: إنَّ بَينَنا وبَينَه عَلامةً، إذا رأَيْناها عَرَفْناه. قال: فيقولُ: ما هي؟ فيقولونَ: يَكشِفُ عن ساقِه، فعِندَ ذلكَ يَكشِفُ عن ساقِه، فيَخِرُّ كلُّ مَن كان مُشرِكًا يُرائي لظَهرِه، ويَبقى قَومٌ ظُهورُهم كصياصي البَقَرِ، يُريدونَ السُّجودَ فلا يَستَطيعونَ، {وَقَدْ كَانُوا يُدْعَوْنَ إِلَى السُّجُودِ وَهُمْ سَالِمُونَ} [القلم: 43]، ثمَّ يقولُ: ارفَعوا رُؤوسَكم. فيَرفَعونَ رُؤوسَهم، ",["فيُعطيهم نُورَهم",2]," ",["على قَدْرِ أعمالِهم",1],"؛ فمِنهم مَن يُعطَى نُورَه مِثلَ الجَبَلِ العَظيمِ، يَسعى بينَ أيديهم، ومِنهم مَن يُعطَى نُورَه أصغَرَ مِن ذلكَ، ومنهم مَن يُعطَى مِثلَ النَّخلةِ بيَدِه، ومنهم مَن يُعطَى أصغَرَ مِن ذلكَ، حتى يكونَ آخِرُهم يُعطَى نُورَه على إبهامِ قَدَمِه، يُضيءُ مرَّةً، ويُطفَأُ مرَّةً، فإذا أضاءَ قَدَمُه قَدِمَ، وإذا أُطفِئَ قامَ. قال: والرَّبُّ تَبارَكَ وتَعالى أمامَهم، حتى يَمُرَّ بهم إلى النارِ، فيَبقى أثَرُه كحَدِّ السَّيفِ، قال: فيقولُ: مُرُّوا. فيَمُرُّونَ على قَدْرِ نُورِهم، منهم مَن يَمُرُّ كطَرْفةِ العَينِ، ومنهم مَن يَمُرُّ كالبَرقِ، ومنهم مَن يَمُرُّ كالسَّحابِ، ومنهم مَن يَمُرُّ كانقِضاضِ الكَواكِبِ، ومنهم مَن يَمُرُّ كالرِّيحِ، ومنهم مَن يَمُرُّ كشَدِّ الفَرَسِ، ومنهم مَن يَمُرُّ كشَدِّ الرجُلِ حتى يَمُرَّ الذي يُعطَى نُورَه على ظَهرِ قَدَمَيْه يَحْبو على وَجهِه ويَدَيْه ورِجلَيْه، تُجَرُّ يَدٌ، وتُعَلَّقُ يَدٌ، وتُجَرُّ رِجلٌ وتُعلَّقُ رِجلٌ، وتُصيبُ جَوانبَه النارُ، فلا يَزالُ كذلكَ حتى يَخلُصَ، فإذا خَلَصَ وَقَفَ عليها، فقال: الحَمدُ للهِ الذي أَعْطاني ما لم يُعطِ أحَدًا؛ إذْ أَنْجاني منها بعدَ إذْ رأَيتُها. قال: فيَنطَلِقُ به إلى غَديرٍ عِندَ بابِ الجنَّةِ، فيَغتَسِلُ، فيَعودُ إليه ريحُ أهلِ الجنَّةِ وألوانُهم، فيَرى ما في الجنَّةِ مِن خَلَلِ البابِ، فيقولُ: رَبِّ أدخِلْني الجنَّةَ. فيقولُ اللهُ: أتسأَلُ الجنَّةَ وقد نَجَّيتُكَ مِن النارِ؟ فيقولُ: رَبِّ اجعَلْ بَيني وبَينَها حِجابًا حتى لا أسمَعَ حَسيسَها. قال: فيَدخُلُ الجنَّةَ، ويَرى أو يُرفَعُ له مَنزِلٌ أمامَ ذلكَ، كأنَّ ما هو فيه بالنِّسبةِ إليه حُلْمٌ، فيقولُ: يا رَبِّ أعطِني ذلكَ المَنزِلَ. فيقولُ: لَعَلَّكَ إنْ أُعطيتَه تَسألُ غَيرَه؟ فيقولُ: لا وعِزَّتِكَ، لا أسألُ غَيرَه، وأيُّ مَنزِلٍ أحسَنُ منه؟! فيُعطاه، فيَنزِلُه، ويَرى أمامَ ذلكَ مَنزِلًا كأنَّ ما هو فيه بالنِّسبةِ إليه حُلْمٌ، قال: رَبِّ أعطِني ذلكَ المَنزِلَ. فيقولُ اللهُ تَبارَكَ وتَعالى له: لَعَلَّكَ إنْ أُعطيتَه تَسألُ غَيرَه؟ فيقولُ: لا وعِزَّتِكَ، وأيُّ مَنزِلٍ أحسَنُ منه، فيُعطاه فيَنزِلُه، ثمَّ يَسكُتُ، فيقولُ اللهُ جَلَّ ذِكرُه: ما لكَ لا تَسألُ؟ فيقولُ: رَبِّ، قد سأَلتُكَ حتى استَحيَيتُكَ. فيقولُ اللهُ جَلَّ ذِكرُه: ألم تَرضَ أنْ أُعطيَكَ مِثلَ الدُّنيا مُنذُ خَلَقتُها إلى يَومِ أَفْنَيتُها وعَشَرةَ أضعافِه؟ فيقولُ: أتَهزَأُ بي وأنتَ رَبُّ العِزَّةِ؟! قال: فيقولُ الرَّبُّ جَلَّ ذِكرُه: لا، ولكِنِّي على ذلكَ قادِرٌ. فيقولُ: أَلْحِقْني بالناسِ. فيقولُ: الْحَقْ بالناسِ. قال: فيَنطَلِقُ يَرمُلُ في الجنَّةِ، حتى إذا دَنا مِن الناسِ رُفِعَ له قَصرٌ مِن دُرَّةٍ، فيَخِرُّ ساجِدًا، فيقولُ له: ارفَعْ رأْسَكَ، ما لكَ؟ فيقولُ: رأَيتُ رَبِّي، أو تَراءَى لي رَبِّي، فيُقالُ: إنَّما هو مَنزِلٌ مِن مَنازِلِكَ. قال: ثمَّ يأتي رجُلًا فيَتهيَّأُ للسُّجودِ له، فيُقالُ له: مَهْ. فيقولُ: رأَيتُ أنَّكَ مَلَكٌ مِن المَلائكةِ. فيقولُ: إنَّما أنا خازِنٌ مِن خُزَّانِكَ، وعبدٌ مِن عَبيدِكَ، تَحتَ يَدي ألْفُ قَهرَمانٍ على ما أنا عليه. قال: فيَنطَلِقُ أمامَه حتى يَفتَحَ له بابَ القَصرِ. قال: وهو مِن دُرَةٍّ مُجَوَّفةٍ سَقائفُها وأبوابُها وأغلاقُها ومَفاتيحُها منها، يَستَقبِلُها جَوهَرةٌ خَضراءُ مُبَطَّنةٌ بحَمراءَ، فيها سَبعونَ بابًا، كلُّ بابٍ يُفضي إلى جَوهَرةٍ خَضراءَ مُبَطَّنةٍ، كلُّ جَوهَرةٍ تُفضي إلى جَوهَرةٍ على غَيرِ لَونِ الأُخرى، في كلِّ جَوهَرةٍ سُرُرٌ وأزواجٌ ووَصائفُ، أدناهنَّ حَوراءُ عَيْناءُ، عليها سَبعونَ حُلَّةً، يُرَى مُخُّ ساقِها مِن وَراءِ حُلَلِها، كَبِدُها مِرآتُه، وكَبِدُه مِرآتُها، إذا أعرَضَ عنها إعراضةً ازدادَتْ في عَينِه سَبعينَ ضِعفًا عَمَّا كانتْ قبلَ ذلك، فيقولُ لها: واللهِ لقدِ ازدَدتِ في عَيني سَبعينَ ضِعفًا. وتَقولُ له: وأنتَ لقدِ ازدَدتَ في عَيني سَبعينَ ضِعفًا. فيُقالُ له: أشرِفْ. فيُشرِفُ، فيُقالُ له: مُلكُكَ مَسيرةُ مئةِ عامٍ، يَنفُذُه بَصَرُكَ. قال: فقال له عُمَرُ: ألَا تَسمَعُ ما يُحَدِّثُنا ابنُ أُمِّ عبدٍ يا كَعبُ عن أَدْنى أهلِ الجنَّةِ مَنزِلًا؟ فكيفَ أَعْلاهم؟ قال: يا أميرَ المؤمِنينَ، ما لا عَينٌ رأَتْ، ولا أُذُنٌ سَمِعتْ، إنَّ اللهَ جَلَّ ذِكرُه خَلَقَ دارًا جعَلَ فيها ما شاءَ مِن الأَزْواجِ، والثَّمَراتِ، والأشرِبةِ، ثمَّ أطبَقَها، فلم يَرَها أحَدٌ مِن خَلْقِه، لا جِبريلُ ولا غَيرُه مِن المَلائكةِ، ثمَّ قَرأ كَعبٌ: {فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ} [السجدة: 17].\nقال: وخَلَقَ دونَ ذلكَ جَنَّتينِ وزَيَّنَهما بما شاءَ، وأراهما مَن شاءَ مِن خَلقِه، ثمَّ قال: مَن كان كِتابُه في عِلِّيِّينَ نزَلَ في تلكَ الدارِ التي لم يَرَها أحَدٌ، حتى إنَّ الرجُلَ مِن أهلِ عِلِّيِّينَ، فيَخرُجُ فيَسيرُ في مُلكِه، فلا تَبقى خَيمةٌ مِن خِيَمِ الجنَّةِ إلَّا دخَلَها مِن ضَوءِ وَجهِه، فيَستَبشِرونَ بريحِه، فيقولونَ: واهًا لهذا الرِّيحِ، هذا رِيحُ رجُلٍ مِن أهلِ عِلِّيِّينَ قد خرَجَ يَسيرُ في مُلكِه. قال: وَيحَكَ يا كَعبُ، إنَّ هذه القُلوبَ قدِ استَرسَلَتْ فاقبِضْها. فقال كَعبٌ: إنَّ لجَهنَّمَ يَومَ القِيامةِ لَزَفْرةً ما مِن مَلَكٍ مُقَرَّبٍ ولا نَبيٍّ مُرسَلٍ إلَّا خَرَّ لرُكبَتَيْه، حتى إنَّ إبراهيمَ خَليلَ اللهِ لَيقولُ: رَبِّ نَفْسي نَفْسي، حتى لو كان لكَ عَمَلُ سَبعينَ نَبيًّا إلى عَمَلِكَ لَظَنَنتَ ألَّا تَنجُوَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أحد طرقه صحيح","takhrij":"أخرجه الطبراني (9/417) (9763)، والدارقطني في ((رؤية الله)) (163)، والحاكم (8751) باختلاف يسير","bab":"جنة › درجات الجنة","dorar":"PBvJI3Mn","merged":4,"otherRefs":["المستدرك على الصحيحين 3468 (صحيح)","البدور السافرة 158 (صحيح)","المصابيح في الأحاديث المتواترة 599 (صحيح)"]},{"id":"س-01522","fp":"1193b4667602","stateId":665,"easy":"إذا حافظت على الجمعة ← تُبعث معها زهراء منيرة تضيء لك","cause":"ويبعثُ الجُمعةَ زهْراءَ مُنِيرةً لأهلِها","result":"فيَحُفُّونَ بِها كالعرُوسِ تُهدَى إلى كرِيمِها تُضِيءُ لهمْ ، يَمشونَ في ضَوْئِها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 1872","srcLabel":"الحاكم","text":["إنَّ اللهَ : يَبعثُ الأيامَ يومَ القيامةِ على هيئَتِها ، ",["ويبعثُ الجُمعةَ زهْراءَ مُنِيرةً لأهلِها",1]," ، ",["فيَحُفُّونَ بِها كالعرُوسِ تُهدَى إلى كرِيمِها تُضِيءُ لهمْ ، يَمشونَ في ضَوْئِها",2]," ، ألوانُهمْ كالثَّلجِ بَياضًا ، رِياحُهمْ تَسطَعُ كالمِسكِ ، يَخوضُونَ في جِبالِ الكافورِ ، يَنظرُ إليهِمُ الثَّقلانِ ما يُطْرِقُونَ تعجُّبًا ، حتى يَدخلوا الجنةَ ، لا يُخالِطُهمْ أحدٌ إلَّا المؤذِّنونَ المحتسِبونَ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه ابن خزيمة (1730)، والطبراني في ((مسند الشاميين)) (1557)، والحاكم (1042) باختلاف يسير","bab":"أذان › فضل التأذين","dorar":"5t7ylciK"},{"id":"س-02011","fp":"8ab30807a1dc","stateId":665,"easy":"إذا عملت صالحاً ← تُؤتى نورك على قدر عملك","cause":"على قدْرِ أعمالِهِم","result":"يُؤتَوْنَ نورَهُم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-04315","ref":"المستدرك على الصحيحين 3831","text":["عنْ عبدِ اللهِ رَضيَ اللهُ عنه، في قولِهِ عزَّ وجلَّ: {يَسْعَى نُورُهُمْ بَيْنَ أَيْدِيهِمْ} [الحديد: 12] قالَ: ",["يُؤتَوْنَ نورَهُم",2]," ",["على قدْرِ أعمالِهِم",1],"، منهم مَنْ نورُهُ مثلُ الجَبلِ وأدناهم نورًا مَن نورُهُ على إبهامِهِ يُطفأَهُ مرَّةً، ويَقِدُ أخرى."],"grade":"صحيح","narrator":"قيس بن السكن","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (34558)، والطبري في ((تفسيره)) (22/ 398) واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"psHnIx2w"},{"id":"س-02797","fp":"8107a5df1111","stateId":665,"easy":"إذا كنت موحّداً ← تُعطى نوراً يوم القيامة","cause":"الموحِّدينَ","result":"إلَّا يُعطى نورًا يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 3878","srcLabel":"ابن أبي حاتم","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما في قولِ اللهِ عزَّ وجلَّ: {يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [التحريم: 8] قالَ: ليس أَحَدٌ مِنَ ",["الموحِّدينَ",1]," ",["إلَّا يُعطى نورًا يومَ القيامةِ",2],"، فأمَّا المنافقُ فيُطفئُ نورَهُ، والمؤمنُ مُشفِقٌ ممَّا رَأى مِن إطفاءِ نورِ المنافقِ، فهو يقولُ: {رَبَّنَا أَتْمِمْ لَنَا نُورَنَا}."],"grade":"صحيح","narrator":"عكرمة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي حاتم كما في ((تفسير)) لابن كثير (1/ 192) بلفظ مقارب.","bab":"إيمان › النفاق","dorar":"ozt0akKO"},{"id":"س-02825","fp":"3b29f3fa9a2d","stateId":665,"easy":"إذا حلقت رأسك في النسك ← لك بكل شعرة نور يوم القيامة","cause":"حلَق رأسَه","result":"فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02903","ref":"شرح البخاري لابن الملقن 12/123","text":["حديثُ أنَّ لمن حلقَ رأسَهُ بكلِّ شعرةٍ سقطتْ من رأسِهِ نورًا يومَ القيامةِ [يعني حديث: جاء رجُلٌ مِن الأنصارِ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ قال : ( اجلِسْ ) وجاء رجُلٌ مِن ثَقيفٍ فقال : يا رسولَ اللهِ كلماتٌ أسأَلُ عنهنَّ فقال صلَّى اللهُ عليه وسلَّم : ( سبَقكَ الأنصاريُّ ) فقال الأنصاريُّ : إنَّه رجُلٌ غريبٌ وإنَّ للغريبِ حقًّا فابدَأْ به فأقبَل على الثَّقَفيِّ فقال : ( إنْ شِئْتَ أجبَتْكُ عمَّا كُنْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني وأُخبِرُكَ ) فقال : يا رسولَ اللهِ بل أجِبْني عمَّا كُنْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الرُّكوعِ والسُّجودِ والصَّلاةِ والصَّومِ ) فقال : لا والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإذا ركَعْتَ فضَعْ راحتَيْكَ على رُكبَتْيكَ ثمَّ فرِّجْ بَيْنَ أصابعِكَ ثمَّ امكُثْ حتَّى يأخُذَ كلُّ عضوٍ مأخَذَه وإذا سجَدْتَ فمَكِّنْ جبهتَكَ ولا تنقُرْ نَقْرًا وصَلِّ أوَّلَ النَّهارِ وآخِرَه ) فقال : يا نَبيَّ اللهِ فإنْ أنا صلَّيْتُ بَيْنَهما ؟ قال : ( فأنتَ إذًا مُصلِّي وصُمْ مِن كلِّ شهرٍ ثلاثَ عَشْرةَ وأربعَ عَشْرةَ وخمسَ عَشْرةَ ) فقام الثَّقفيُّ ثمَّ أقبَل على الأنصاريِّ فقال : ( إنْ شِئْتَ أخبَرْتُكَ عمَّا جِئْتَ تسأَلُ وإنْ شِئْتَ سأَلْتَني فأُخبِرُكَ ) فقال : لا يا نَبيَّ اللهِ أخبِرْني عمَّا جِئْتُ أسأَلُكَ قال : ( جِئْتَ تسأَلُني عنِ الحاجِّ ما له حينَ يخرُجُ مِن بيتِه وما له حينَ يقومُ بعرَفاتٍ وما له حينَ يرمي الجِمارَ وما له حينَ يحلِقُ رأسَه وما له حينَ يقضي آخِرَ طوافٍ بالبيتِ ) فقال : يا نَبيَّ اللهِ والَّذي بعَثك بالحقِّ ما أخطَأْتَ ممَّا كان في نفسي شيئًا قال : ( فإنَّ له حينَ يخرُجُ مِن بيتِه أنَّ راحلتَه لا تخطو خُطوةً إلَّا كُتِب له بها حَسنةٌ أو حُطَّت عنه بها خطيئةٌ فإذا وقَف بعرَفةَ فإنَّ اللهَ عزَّ وجلَّ ينزِلُ إلى السَّماءِ الدُّنيا فيقولُ : انظُروا إلى عبادي شُعْثًا غُبْرًا اشهَدوا أنِّي قد غفَرْتُ لهم ذُنوبَهم وإنْ كان عدَدَ قَطْرِ السَّماءِ ورَمْلِ عالجٍ وإذا رمى الجِمارَ لا يدري أحَدٌ ما له حتَّى يُوفَّاه يومَ القيامةِ وإذا ",["حلَق رأسَه",1]," ",["فله بكلِّ شَعرةٍ سقَطَتْ مِن رأسِه نورٌ يومَ القيامةِ",2]," وإذا قضى آخِرَ طوافِه بالبيتِ خرَج مِن ذنوبِه كيومَ ولَدَتْه أُمُّه )]"],"grade":"صحيح","narrator":"[عبدالله بن عمر]","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (1887) بلفظه تامًا، وعبد الرزاق (8830)، والبيهقي في ((الدلائل)) (6/ 293) بنحوه تامًا.","bab":"إيمان › الوعد","dorar":"gtGMMaGB"},{"id":"س-08194","fp":"35d93044ae3e","stateId":665,"easy":"إذا عملت صالحاً ← تُعطى نورك بقدر عملك","cause":"بقدرِ أعمالِكُم","result":"ارفَعوا رؤوسَكُم إلى نورِكم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-04315","ref":"المطالب العالية 5/100","text":["إنَّ عبدَ اللهِ بنَ مسعودٍ رضيَ اللهُ عنهُ حدَّثَ عمرَ بنَ الخطَّابِ رضيَ اللهُ عنهُ هذا الحديثَ فقال : إذا حُشِرَ النَّاسُ يومَ القيامةِ قاموا أربعينَ ، على رؤوسِهِم الشَّمسُ ، شاخصةً أبصارُهُم إلى السَّماءِ ، ينتظرونَ الفصلَ ، كلُّ برٍّ منهُم وفاجرٍ ، لا يتكلمُ منهُم بشرٌ ، ثمَّ يُنادي مُنادٍ : أليسَ عدلًا من ربِّكُم الَّذي خلقَكُم وصوَّرَكُم ورزقَكُم ثمَّ عبدتُم غيرَهُ أن يُولِّي كلَّ قَومٍ ما تولَّوْا ؟ فيقولونَ : بلَى . فيُنادي بذلكَ ملَكٌ ثلاثَ مرَّاتٍ ، ثمَّ يُمَثَّلُ لكلِّ قَومٍ آلهتُهُم الَّتي كانوا يعبدونَها ، فيتبِعونَها حتَّى تُوردَهم النَّارُ ، فيبقَى المؤمنونَ والمنافقونَ ، فيخرُّ المؤمنونَ سُجَّدًا ، وتُدْمَجُ أصلابُ المنافقينَ فتكونُ عظمًا واحدًا كأنَّها صَيَاصِيُّ البقرِ ، ويخرُّونَ على أقْفيتِهِم ، فيقولُ اللهُ تعالى لهُم : ",["ارفَعوا رؤوسَكُم إلى نورِكم",2]," ",["بقدرِ أعمالِكُم",1]," ، فيرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيْهِ مثلُ الجبلِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ القصرِ ، ويرفعُ الرَّجلُ رأسَهُ ونورُهُ بينَ يدَيهِ مثلُ البَيتِ ، حتَّى ذكرَ مثلَ الشَّجرةِ ، فيمضونَ على الصِّراطِ كالبرقِ ، وكالرِّيحِ ، وكحضرِ الفرسِ ، وكاشتدادِ الرَّجلِ ، حتَّى يبقَى آخرَ النَّاسِ نورُهُ على إبهامِ رجلِهِ مثلُ السِّراجِ ، فأحيانًا يُضيءُ لهُ ، وأحيانًا يخفَى عليهِ ، فتنفثُ منهُ النَّارُ ، فلا يزالُ كذلكَ حتَّى يخرجَ فيقولُ : ما يدري أحدٌ ما نجا منهُ غَيري ، ولا أصابَ أحدٌ مثلَ ما أصبتَ ، إنَّما أصابَني حرُّها ونجَوتُ منها ، قال : فيُفتَحُ لهُ بابٌ من الجنَّةِ فيقولُ : يا ربِّ ، أدخِلْني هذا ، فيقولُ : عبدي لعلِّي إن أدخلتُكَ تسألْني غيرَهُ . قال : فيُدخِلُهُ ، فبَينا هوَ يعجبُ بما هوَ فيهِ إذ فُتِحَ لهُ بابٌ آخرُ ، فيستَحقِرُ في عَينِهِ الَّذي هوَ فيهِ ، فيقولُ : يا ربِّ ، أدخِلْني هذا . فيقولُ : أو لَم تزعُمْ أنَّكَ لا تسألْني غيرَهُ ، فيقولُ : وعزَّتِكَ وجلالِكَ لئن أدخلتَنِيهِ لا أسألُكَ غيرَهُ . قال : فيُدخِلُهُ حتَّى يُدْخِلَهُ أربعةَ أبوابٍ كلَّها يسألُها ، ثمَّ يستقبلُهُ رجلٌ مثلُ النُّورِ ، فإذا رآهُ هوَى يسجدُ لهُ فيقولُ : ما شأنُكَ ؟ فيقولُ : ألستَ بربِّي ؟ فيقولُ : إنَّما أنا قَهرمانٌ لكَ في الجنَّةِ [ من ] ألفِ قَهرمانٍ على ألفِ قصرٍ ، بينَ كلِّ قصرَيْنِ مسيرةُ ( ألفِ سنةٍ ) ، يُرَى أقصاها كما يُرَى أدناها ، ثمَّ يُفْتَحُ لهُ بابٌ من زَبرجَدةٍ خضراءَ ، فيها سبعونَ بابًا ، في كلِّ بابٍ منها أزواجٌ وسُرُرٌ ومناصفٌ ، فيقعدُ مع زوجتِهِ فتُناولُهُ الكأسَ ، فتقولُ : لأنتَ منذُ ناولتُكَ الكأسَ أحسنُ منكَ قبلَ ذلكَ بسبعينَ ضِعْفًا ، علَيها سبعونَ حُلَّةً ، ألوانُها شتَّى يُرَى مخُّ ساقِها ، ويلبسُ الرَّجلُ ثيابَهُ على كبدِها ، وكبدُها مِرْآتُهُ"],"grade":"صحيح","narrator":"قيس بن السكن وأبو عبيدة بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((تفسيره)) (23/ 190) بلفظ قريب، وأورده البلوصيري في ((الإتحاف)) (7684) وعزاه لإسحاق.","bab":"ملائكة › أعمال الملائكة","dorar":"II3fMWHr"},{"id":"س-01616","fp":"4bf304942be6","stateId":666,"easy":"إذا مشيت مع أخيك في حاجته حتى تتهيأ ← يثبت الله قدمك يوم تزول الأقدام","cause":"ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ","result":"أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ","explicit":true,"otherNeedIds":[16],"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ",["ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ",1]," ",["أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ",2],"، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-06063","fp":"8ae4b26d6e1d","stateId":666,"easy":"إذا أبلغت ذا سلطان حاجة من لا يستطيع إبلاغه ← يثبت الله قدميك على الصراط يوم تزل الأقدام","cause":"من أبلغ ذا سلطانٍ حاجةَ من لا يستطيع إبلاغَه","result":"ثبّت اللهُ قدمَيه على الصراطِ يومَ تَزِلُّ فيه الأقدامُ","explicit":true,"similar":["س-02267","س-06077","س-03826"],"ref":"البحر الزخار 10/58","srcLabel":"ابن شاهين","text":[["من أبلغ ذا سلطانٍ حاجةَ من لا يستطيع إبلاغَه ، ",1],["ثبّت اللهُ قدمَيه على الصراطِ يومَ تَزِلُّ فيه الأقدامُ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ","takhrij":"أخرجه ابن شاهين في ((الترغيب)) (425)، وابن عبد البر في ((التمهيد)) (13/ 56) بنحوه.","bab":"رقائق وزهد › ما جاء في السعي لقضاء حوائج الخلق","dorar":"hGHe8KXO"},{"id":"س-07874","fp":"73a6c4ca7803","stateId":666,"easy":"إذا استفرهت أضحيتك (اخترت أفضلها) ← فإنها مطاياكم على الصراط (على رواية)","cause":"استَفرِهوا ضَحاياكم","result":"فإنَّها مطاياكم على الصِّراطِ","explicit":true,"ref":"فيض القدير 992","srcLabel":"الديلمي","text":[["استَفرِهوا ضَحاياكم؛ ",1],["فإنَّها مطاياكم على الصِّراطِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"غير معروف ولا ثابت.","takhrij":"أخرجه الديلمي كما في ((التلخيص الحبير)) (4/ 138)، والقاضي عيد الجبار في ((أماليه)) كما في ((أخبار قزوين)) (3/ 219) واللفظ لهما.","bab":"قيامة › الحساب والقصاص","dorar":"KKU8XN2R"},{"id":"س-02267","fp":"f225b816160e","stateId":666,"easy":"إذا أبلغت سلطاناً حاجة من لا يستطيع إبلاغها ← يثبت الله قدميك على الصراط","cause":"فمن أبْلَغَ سلطانًا حاجةَ من لا يستطيعُ إبلاغُها","result":"ثبَّتَ اللهُ قدَمَيْه على الصراطِ يومَ القيامةِ","explicit":true,"repOf":"س-06063","ref":"الجامع الصغير 59","text":["أبْلِغوا حاجةَ من لا يستطيعُ إبلاغَ حاجتِه، ",["فمن أبْلَغَ سلطانًا حاجةَ من لا يستطيعُ إبلاغُها",1]," ، ",["ثبَّتَ اللهُ قدَمَيْه على الصراطِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه البزار (4121) بلفظه مطولًا، وابن شاهين في ((الترغيب)) (425)، وابن عبد البر في ((التمهيد)) (13/ 56) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"mb1OIi8L"},{"id":"س-04213","fp":"e5bd233efe25","stateId":666,"easy":"إذا كانت المساجد بيتك ← تُبشّر بالأمن والجواز على الصراط","cause":"لِمَنْ كانَتِ المَساجِدُ بَيْتَه","result":"الأمنَ ، والجوازَ على الصِّراطِ يومَ القيامةِ","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"البحر الزخار 10/86","srcLabel":"الطبراني","text":["لِتكنِ المساجِدُ مَجلِسَكَ ؛ فإنِّي سَمعتُ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ يقولُ : إنَّ اللهَ عزَّ وجلَّ ضمن ",["لِمَنْ كانَتِ المَساجِدُ بَيْتَه",1]," ",["الأمنَ ، والجوازَ على الصِّراطِ يومَ القيامةِ",2]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن الإسناد","takhrij":"أخرجه ابن أبي شيبة (35753)، والطبراني في ((الأوسط)) (7149)، وابن الجوزي في ((العلل المتناهية)) (690) باختلاف يسير.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"J6l8gbMV"},{"id":"س-06077","fp":"94f40489207d","stateId":666,"easy":"إذا أبلغت حاجة من لا يستطيع إبلاغها ← يثبت الله قدميك على الصراط","cause":"أَبلِغوا حاجةَ مَن لا يَسْتطيعُ إبلاغَها","result":"فإنَّ مَن أبلَغَ سُلْطانًا حاجةَ مَن لا يستطيعُ إبلاغَها إيَّاه ثبَّتَ اللهُ قدَمَيْه يَومَ القيامةِ","explicit":true,"repOf":"س-06063","ref":"مختصر المقاصد 9","text":[["أَبلِغوا حاجةَ مَن لا يَسْتطيعُ إبلاغَها، ",1],["فإنَّ مَن أبلَغَ سُلْطانًا حاجةَ مَن لا يستطيعُ إبلاغَها إيَّاه ثبَّتَ اللهُ قدَمَيْه يَومَ القيامةِ",2],"."],"grade":"حسن","narrator":"[هند بن أبي هالة]","muhaddith":"حسن","takhrij":"أخرجه الطبراني (22/155)","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"Wsjzrnxd"},{"id":"س-03843","fp":"35f779a9c460","stateId":666,"easy":"إذا عملت صالحاً ← تجري بك أعمالك على الصراط","cause":"تَجري بهِم أعمالُهم","result":"حتَّى تَعجِزَ أعمالُ العِبادِ، حتَّى يَجيءَ الرَّجُلُ فلا يَستَطيعُ السَّيرَ إلَّا زَحفًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[66],"ref":"صحيح مسلم 195","srcLabel":"ابن خزيمة","text":["يَجمَعُ اللهُ تَبارَك وتَعالى النَّاسَ، فيَقومُ المُؤمِنونَ حتَّى تُزلَفَ لهمُ الجَنَّةُ، فيَأتونَ آدَمَ، فيَقولونَ: يا أبانا، استَفتِحْ لنا الجَنَّةَ، فيَقولُ: وهل أخرَجَكُم مِنَ الجَنَّةِ إلَّا خَطيئةُ أبيكُم آدَمَ؟ لَستُ بصاحِبِ ذلك، اذهَبوا إلى ابني إبراهيمَ خَليلِ اللهِ، قال: فيَقولُ إبراهيمُ: لَستُ بصاحِبِ ذلك، إنَّما كُنتُ خَليلًا مِن وراءَ وراءَ، اعمِدوا إلى موسى صلَّى اللهُ عليه وسلَّم الذي كَلَّمَه اللهُ تَكليمًا، فيَأتونَ موسى صلَّى اللهُ عليه وسلَّم، فيَقولُ: لَستُ بصاحِبِ ذلك، اذهَبوا إلى عيسى كَلِمةِ اللهِ وروحِه، فيَقولُ عيسى صلَّى اللهُ عليه وسلَّم: لَستُ بصاحِبِ ذلك، فيَأتونَ مُحَمَّدًا صلَّى اللهُ عليه وسلَّم، فيَقومُ فيُؤذَنُ له، وتُرسَلُ الأمانةُ والرَّحِمُ، فتَقومانِ جَنَبَتَيِ الصِّراطِ يَمينًا وشِمالًا، فيَمُرُّ أوَّلُكُم كالبَرقِ، قال: قُلتُ: بأبي أنتَ وأُمِّي، أيُّ شيءٍ كَمَرِّ البَرقِ؟ قال: ألَم تَرَوا إلى البَرقِ كيفَ يَمُرُّ ويَرجِعُ في طَرفةِ عَينٍ؟ ثُمَّ كَمَرِّ الرِّيحِ، ثُمَّ كَمَرِّ الطَّيرِ، وشَدِّ الرِّجالِ، ",["تَجري بهِم أعمالُهم",1],"، ونَبيُّكُم قائِمٌ على الصِّراطِ، يقولُ: رَبِّ سَلِّمْ سَلِّمْ، ",["حتَّى تَعجِزَ أعمالُ العِبادِ، حتَّى يَجيءَ الرَّجُلُ فلا يَستَطيعُ السَّيرَ إلَّا زَحفًا",2],"، قال: وفي حافَتَيِ الصِّراطِ كَلاليبُ مُعَلَّقةٌ مَأمورةٌ بأخذِ مَنِ أُمِرَت به، فمَخدوشٌ ناجٍ، ومَكدوسٌ في النَّارِ. والذي نَفسُ أبي هُرَيرةَ بيَدِه، إنَّ قَعرَ جَهَنَّمَ لَسَبعونَ خَريفًا."],"grade":"صحيح","narrator":"أبو هريرة وحذيفة بن اليمان","muhaddith":"[صحيح]","takhrij":"أخرجه ابن خزيمة (2/ 600)، وابن أبي داود في ((البعث)) (28)، وابن منده في ((الإيمان)) (883) جميعهم باختلاف يسير.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"QiFJFtK9"},{"id":"س-08229","fp":"a5cc83238321","stateId":666,"easy":"إذا جئت بالحق ← تجوز الصراط","cause":"فمن جاء بالحقِّ","result":"جاز","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المصابيح في الأحاديث المتواترة 599","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ على جهنَّمَ جِسرًا أدَقَّ من الشَّعرِ وأحَدَّ من السَّيفِ، أعلاه نحوُ الجنَّةِ دَحْضٌ مَزَلَّةٌ، بجنبيه كلاليبُ وحسَكُ النَّارِ، يحشُرُ اللهُ به من يشاءُ من عبادِه، الزَّالُّون والزَّالَّاتُ يومئذٍ كثيرٌ، والملائكةُ بجانبَيه قيامٌ يُنادونَ: اللَّهُمَّ سَلِّم سَلِّم، ",["فمن جاء بالحقِّ",1]," ",["جاز",2],"، ويُعطَونَ النُّورَ يومَئذٍ على قَدرِ أعمالِهم وإيمانِهم، منهم من يمضي عليه كلَمحِ البَرقِ، ومنهم من يَمضي عليه كمَرِّ الرِّيحِ، ومنهم من يُعطى نورًا إلى موضِعِ قَدَميه، ومنهم من يحبو حبوًا وتأخُذُ النَّارُ منه بذُنوبٍ أصابها، وهي تحرِقُ من يشاءُ اللهُ منهم على قَدرِ ذُنوبِهم حتَّى ينجوَ، وتنجو أوَّلُ زُمرةٍ سبعونَ ألفًا لا حِسابَ عليهم ولا عذابَ، كأنَّ وُجوهَهم القَمَرُ ليلةَ البدرِ، والذين يلونَهم كأضوأِ نَجمٍ في السَّماءِ حتَّى يَبلُغوا إلى الجنَّةِ برحمةِ اللهِ تعالى"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"ملائكة › أعمال الملائكة","dorar":"ftBFF8cJ"},{"id":"س-03826","fp":"8eaf039d90ee","stateId":666,"easy":"إذا كنت وصلة لأخيك إلى ذي سلطان في بر أو تيسير عسر ← يجيزك الله على الصراط عند دحض الأقدام","cause":"مَن كان وُصلةً لأخيه المسلمِ إلى ذي سلطانٍ في مَبلَغِ بِرٍّ أو تيسيرِ عُسرٍ أجازه اللهُ على","result":"الصِّراطِ يومَ القيامةِ عندَ دَحْضِ الأقدامِ","explicit":true,"repOf":"س-06063","ref":"صحيح ابن حبان 530","text":[["مَن كان وُصلةً لأخيه المسلمِ إلى ذي سلطانٍ في مَبلَغِ بِرٍّ أو تيسيرِ عُسرٍ أجازه اللهُ على ",1],["الصِّراطِ يومَ القيامةِ عندَ دَحْضِ الأقدامِ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (94)، والطبراني في ((مكارم الأخلاق)) (132)، وابن الجوزي في ((البر والصلة)) (457) باختلاف يسير.","bab":"بر وصلة › حق المسلم على المسلم","dorar":"Z9s0V9m7"},{"id":"س-02421","fp":"38f9a9270e88","stateId":667,"easy":"إذا لزمت «لا إله إلا الله» ← فلو وُضعت السماوات السبع والأرضون في كفة لرجحت بها","cause":"آمُرُك بلا إلهَ إلَّا اللهُ","result":"فإنَّ السَّمَواتِ السَّبْعَ والأرَضينَ السَّبْعَ لو وُضِعَتْ في كِفَّةٍ ووُضِعَتْ لا إلهَ إلَّا اللهُ في كِفَّةٍ، رَجَحَتْ بِهنَّ لا إلهَ إلَّا اللهُ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-01219","س-03204","س-01240","س-06915"],"otherNeedIds":[49,45],"ref":"الصحيح المسند 801","srcLabel":"البخاري","text":["كُنَّا عنْدَ رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فجاءَه رَجُلٌ مِن أهْلِ البادِيةِ، عليه جُبَّةُ سيجانَ، مَزْرورةٌ بالدِّيباجِ، فقالَ: أَلَا إنَّ صاحِبَكم هذا قد وَضَعَ كلَّ فارِسٍ ابنِ فارِسٍ، قالَ: يُريدُ أن يَضَعَ كلَّ فارِسٍ ابنِ فارِسٍ، ويَرفَعَ كلَّ راعٍ ابنِ راعٍ، قالَ: فأخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ بمَجامِعِ جُبَّتِه، وقالَ: (أَلَا أرى عليك لِباسَ مَن لا يَعقِلُ؟)، ثُمَّ قالَ: (إنَّ نَبيَّ اللهِ نوحًا صلَّى اللهُ عليه وعلى آلِه وسلَّمَ لمَّا حَضَرَتْه الوَفاةُ قالَ لابنِه: إنِّي قاصٌّ عليك الوَصيَّةَ: آمُرُك باثْنتَينِ، وأَنْهاك عن اثْنتَينِ؛ ",["آمُرُك بلا إلهَ إلَّا اللهُ",1],"؛ ",["فإنَّ السَّمَواتِ السَّبْعَ والأرَضينَ السَّبْعَ لو وُضِعَتْ في كِفَّةٍ ووُضِعَتْ لا إلهَ إلَّا اللهُ في كِفَّةٍ، رَجَحَتْ بِهنَّ لا إلهَ إلَّا اللهُ",2],"، ولو أنَّ السَّمَواتِ السَّبْعَ والأرَضينَ السَّبْعَ كُنَّ حَلْقةً مُبْهَمةً قَصَمَتْهنَّ لا إلهَ إلَّا اللهُ، وسُبْحانَ اللهِ وبحَمْدِه؛ فإنَّها صَلاةُ كلِّ شيءٍ، وبها يُرزَقُ الخَلْقُ، وأَنْهاك عن الشِّرْكِ والكِبْرِ، قالَ: قُلْتُ -أو قيلَ: يا رَسولَ اللهِ، هذا الشِّرْكُ قد عَرَفْنا، فما الكِبْرُ؟ قالَ: أن يكونَ لأحَدِنا نَعْلانِ حَسَنتانِ، لهما شِراكانَ حَسَنانِ؟ قالَ: لا، قالَ: أن يكونَ لأحَدِنا حُلَّةٌ يَلبَسُها؟ قالَ: لا، قالَ: الكِبْرُ: هو أن يكونَ لأحَدِنا دابَّةٌ يَركَبُها؟ قالَ: لا، قالَ: أفهو أن يكونَ لأحَدِنا أصْحابٌ يَجلِسونَ إليه؟ قالَ: لا، قيلَ: يا رَسولَ اللهِ، فما الكِبْرُ؟ قالَ: (سَفَهُ الحَقِّ، وغَمْصُ النَّاسِ)."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6583)، والبخاري في ((الأدب المفرد)) (548)، والطبراني (13/ 7) (1) واللفظ لهم.","bab":"إسلام › فضل الشهادتين","dorar":"yZ4HqxR4","merged":3,"otherRefs":["المستدرك على الصحيحين 155 (صحيح)","الأحكام الوسطى 4/ 317 (صحيح)"]},{"id":"س-01313","fp":"38e8720d8bfe","stateId":667,"easy":"إذا سبّحت وحمدت ثلاثاً وثلاثين وكبّرت أربعاً وثلاثين عند نومك ← فهي مئة على اللسان وألف في الميزان","cause":"إذا أَوَيْتما إلى فِراشِكما فسبِّحا اللهَ ثلاثًا وثلاثينَ، واحمَداه ثلاثًا وثلاثينَ، وكبِّراه أربعًا وثلاثينَ","result":"فتلك مِئَةٌ على اللِّسانِ، وألفٌ في الميزانِ","explicit":true,"star":true,"apply":{"k":"count","t":"ثلاثاً وثلاثين"},"similar":["س-00838","س-06409"],"ref":"تخريج المسند لشعيب 1250","srcLabel":"متفق عليه","text":["قُلتُ لفاطمةَ: لو أتيْتِ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فسأَلْتِيه خادمًا، فقد أَجهَدكِ الطَّحنُ والعمَلُ؟ -قال حُسَينٌ: إنَّه قد جهَدكِ الطَّحنُ والعمَلُ، وكذلك قال أبو أحمدَ- قالت: فانطلِقْ معي. قال: فانطلَقْتُ معها، فسأَلْناه، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ألَا أَدُلُّكما على ما هو خَيرٌ لكما من ذلك؟ ",["إذا أَوَيْتما إلى فِراشِكما فسبِّحا اللهَ ثلاثًا وثلاثينَ، واحمَداه ثلاثًا وثلاثينَ، وكبِّراه أربعًا وثلاثينَ",1],"، ",["فتلك مِئَةٌ على اللِّسانِ، وألفٌ في الميزانِ",2],"، فقال عليٌّ رضِي اللهُ عنه: ما ترَكْتُها بعدَما سمِعْتُها منَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال رجُلٌ: ولا ليلةَ صِفِّينَ؟ قال: ولا ليلةَ صِفِّينَ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10650) باختلاف يسير، وأخرجه البخاري (3705)، ومسلم (2727) بنحوه","bab":"نكاح › حق الزوج على المرأة","dorar":"bhMg9COE"},{"id":"س-02119","fp":"f4bdc1eb478d","stateId":667,"easy":"إذا قلت «سبحان الله وبحمده سبحان الله العظيم» ← فهما ثقيلتان في الميزان حبيبتان إلى الرحمن","cause":"سُبْحانَ اللهِ وبِـحمْدِه، سُبْحانَ اللهِ العَظيمِ","result":"كَلِمَتانِ خَفِيفَتانِ على اللِّسانِ ثَقيلَتانِ في الـمِيزانِ، حَبيبَتانِ إلى الرَّحمنِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده سبحان الله العظيم»"},"otherNeedIds":[23],"ref":"تخريج المسند لشعيب 7167","srcLabel":"متفق عليه","text":[["كَلِمَتانِ خَفِيفَتانِ على اللِّسانِ ثَقيلَتانِ في الـمِيزانِ، حَبيبَتانِ إلى الرَّحمنِ",2],": ",["سُبْحانَ اللهِ وبِـحمْدِه، سُبْحانَ اللهِ العَظيمِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6682)، ومسلم (2694)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"xEwX6uml"},{"id":"س-00837","fp":"1644c2925113","stateId":667,"easy":"إذا سبّحت وحمدت وكبّرت عشراً دبر كل صلاة ← فهي خمسون ومئة باللسان وألف وخمسمئة في الميزان","cause":"يسبِّحُ اللَّهَ في دُبُرِ كلِّ صلاةٍ عَشرًا ، ويَحمدُهُ عشرًا ، ويُكَبِّرُهُ عَشرًا","result":"فتِلكَ خَمسونَ ، ومائةٌ باللِّسانِ ، والأَلفٌ وخمسُ مائةٍ في الميزانِ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"similar":["س-01064","س-06412","س-00983","س-06408"],"otherNeedIds":[45],"ref":"صحيح الترمذي 3410","srcLabel":"أبو داود","text":["خلَّتانِ لا يُحصيهما رجلٌ مسلِمٌ إلاَّ دخلَ الجنَّةَ ، ألا وَهُما يَسيرٌ ، ومَن يَعملُ بِهِما قَليلٌ : ",["يسبِّحُ اللَّهَ في دُبُرِ كلِّ صلاةٍ عَشرًا ، ويَحمدُهُ عشرًا ، ويُكَبِّرُهُ عَشرًا",1]," ، قالَ : فأَنا رأيتُ رَسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يعقدُها بيدِهِ ، قالَ : ",["فتِلكَ خَمسونَ ، ومائةٌ باللِّسانِ ، والأَلفٌ وخمسُ مائةٍ في الميزانِ",2]," ، وإذا أخَذتَ مَضجعَكَ تسبِّحُهُ وتُكَبِّرُهُ وتحمَدُهُ مائةً ، فتِلكَ مائةٌ باللِّسانِ ، وألفٌ في الميزانِ ، فأيُّكُم يعمَلُ في اليومِ واللَّيلةِ ألفَينِ وخَمسمائةِ سيِّئةٍ ؟ قالوا : فَكَيفَ لا نُحصيها ؟ قالَ : يأتي أحدَكُمُ الشَّيطانُ وَهوَ في صلاتِهِ ، فَيقولُ : اذكُر كذا ، حتَّى ينفَتِلَ ، فلعلَّهُ أن لا يَفعلَ ، ويأتيهِ وَهوَ في مَضجعِهِ ، فَلا يزالُ ينوِّمُهُ حتَّى يَنامَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410) واللفظ له، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910)","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"zXLbjjQf","merged":8,"otherRefs":["تخريج سير أعلام النبلاء 11/ 551 (صحيح)","الفتوحات الربانية 3/52 (حسن)","صحيح ابن ماجه 763 (صحيح)","صحيح النسائي 1347 (صحيح)","تخريج مشكل الآثار 4089 (حسن)","تخريج مشكل الآثار 4091 (حسن)","الإمتاع لابن حجر 1/98 (حسن)"]},{"id":"س-00838","fp":"ad812c4afc2d","stateId":667,"easy":"إذا سبّحت وكبّرت وحمدت عند نومك مئة ← فهي مئة باللسان وألف في الميزان","cause":"وإذا أخَذتَ مَضجعَكَ تسبِّحُهُ وتُكَبِّرُهُ وتحمَدُهُ مائةً","result":"فتِلكَ مائةٌ باللِّسانِ ، وألفٌ في الميزانِ","explicit":true,"repOf":"س-01313","ref":"صحيح الترمذي 3410","text":["خلَّتانِ لا يُحصيهما رجلٌ مسلِمٌ إلاَّ دخلَ الجنَّةَ ، ألا وَهُما يَسيرٌ ، ومَن يَعملُ بِهِما قَليلٌ : يسبِّحُ اللَّهَ في دُبُرِ كلِّ صلاةٍ عَشرًا ، ويَحمدُهُ عشرًا ، ويُكَبِّرُهُ عَشرًا ، قالَ : فأَنا رأيتُ رَسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يعقدُها بيدِهِ ، قالَ : فتِلكَ خَمسونَ ، ومائةٌ باللِّسانِ ، والأَلفٌ وخمسُ مائةٍ في الميزانِ ، ",["وإذا أخَذتَ مَضجعَكَ تسبِّحُهُ وتُكَبِّرُهُ وتحمَدُهُ مائةً",1]," ، ",["فتِلكَ مائةٌ باللِّسانِ ، وألفٌ في الميزانِ",2]," ، فأيُّكُم يعمَلُ في اليومِ واللَّيلةِ ألفَينِ وخَمسمائةِ سيِّئةٍ ؟ قالوا : فَكَيفَ لا نُحصيها ؟ قالَ : يأتي أحدَكُمُ الشَّيطانُ وَهوَ في صلاتِهِ ، فَيقولُ : اذكُر كذا ، حتَّى ينفَتِلَ ، فلعلَّهُ أن لا يَفعلَ ، ويأتيهِ وَهوَ في مَضجعِهِ ، فَلا يزالُ ينوِّمُهُ حتَّى يَنامَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410) واللفظ له، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910)","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"zXLbjjQf","merged":9,"otherRefs":["تخريج سير أعلام النبلاء 11/ 551 (صحيح)","الفتوحات الربانية 3/52 (حسن)","صحيح ابن ماجه 763 (صحيح)","صحيح النسائي 1347 (صحيح)","تخريج صحيح ابن حبان 2012 (صحيح)","تخريج مشكل الآثار 4091 (حسن)","الإمتاع لابن حجر 1/98 (حسن)","صحيح الأدب المفرد 922 (صحيح)"]},{"id":"س-02917","fp":"fad13e1c8004","stateId":667,"easy":"إذا حسن خلقك ← فهو أول ما يوضع في الميزان","cause":"خُلُقٌ حَسَنٌ","result":"أوَّلُ ما يُوضَعُ في الميزانِ","explicit":true,"otherNeedIds":[45],"ref":"علل ابن أبي حاتم 2232","srcLabel":"ابن أبي شيبة","text":["حَديثٌ رَواه شَريكٌ، عن خَلَفِ بنِ حَوْشَبٍ، عن مَيْمونِ بنِ مِهْرانَ، عن أُمِّ الدَّرْداءِ: سَمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: ",["أوَّلُ ما يُوضَعُ في الميزانِ",2]," ",["خُلُقٌ حَسَنٌ",1],".\nورَواه ابنُ عُيَيْنةَ، عن عَمْرِو بنِ دينارٍ، عن ابنِ أبي مُلَيْكةَ، عن يَعْلى بنِ مُملَكٍ، عن أُمِّ الدَّرْداءِ، عن أبي الدَّرْداءِ.\nورَواه شُعْبةُ، عن القاسِمِ بنِ أبي بَزَّةَ، عن عَطاءٍ الكَيْخارانيِّ، عن أُمِّ الدَّرْداءِ، عن أبي الدَّرْداءِ؟"],"grade":"صحيح","narrator":"أم الدرداء.","muhaddith":"كلُّ هذا صَحيحٌ، إلَّا حَديثَ خَلَفِ بنِ حَوْشَبٍ؛ فإنَّ أُمَّ الدَّرْداءِ هذه لم تَسمَعْ مِن النَّبيِّ صلَّى اللهُ عليه وسلَّم شَيئًا.","takhrij":"أخرجه ابن أبي شيبة (25846)، وعبد بن حميد (1563)، وأبو نعيم في ((الحلية)) (5/ 75) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"BGDOnc5G","merged":10,"otherRefs":["البحر الزخار 10/36 (حسن)","تخريج المسند لشعيب 27553 (صحيح)","تخريج شرح السنة 3496 (حسن)","تخريج كتاب السنة 783 (صحيح)","تخريج المسند لشعيب 27496 (صحيح)","صحيح الجامع 5726 (صحيح)","تخريج رياض الصالحين 626 (صحيح)","صحيح الجامع 5632 (صحيح)","صحيح الجامع 135 (صحيح)"]},{"id":"ق-1455","fp":"574d0aab0dd9","stateId":667,"easy":"ثقل الموازين ← عيشة راضية","cause":"ثقل الموازين","result":"عيشة راضية","explicit":true,"otherNeedIds":[67],"ref":"سورة القارعة: 6–7","srcLabel":"القرآن الكريم","quran":{"s":101,"from":6,"to":7,"text":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ (6) فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ (7)","hl":[[0,40,1],[40,68,2]]}},{"id":"س-00970","fp":"2a8a11253e06","stateId":667,"easy":"إذا قلت «لا إله إلا الله والله أكبر وسبحان الله والحمد لله» أو مات لك ولد صالح فاحتسبته ← فما أثقلهن في الميزان","cause":"لا إلهَ إلَّا اللهُ، واللهُ أكبَرُ، وسُبْحانَ اللهِ، والحَمدُ للهِ، والوَلَدُ الصَّالحُ يُتَوفَّى فيَحتَسِبُه والِدُه","result":"بَخٍ بَخٍ لخَمسٍ ما أثقَلَهُنَّ في المِيزانِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله والله أكبر وسبحان الله والحمد لله»"},"ref":"تخريج المسند لشعيب 23100","srcLabel":"أحمد","text":["عن أبي سَلَّامٍ، أنَّ رَجُلًا حَدَّثَه، أنَّه سَمِعَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["بَخٍ بَخٍ لخَمسٍ ما أثقَلَهُنَّ في المِيزانِ",2],"! قال رَجُلٌ: ما هُنَّ يا رسولَ اللهِ؟ قال: ",["لا إلهَ إلَّا اللهُ، واللهُ أكبَرُ، وسُبْحانَ اللهِ، والحَمدُ للهِ، والوَلَدُ الصَّالحُ يُتَوفَّى فيَحتَسِبُه والِدُه",1],"، خَمسٌ مَنِ اتَّقَى اللهَ بِهِنَّ مُستَيْقِنًا، دَخَلَ الجَنَّةَ: مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا عبدُه ورسولُه، وأيقَنَ بالمَوتِ، والبَعْثِ، والحِسابِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23100)","bab":"أدعية وأذكار › فضل الذكر","dorar":"T69jiPHk","merged":3,"otherRefs":["تخريج المسند لشعيب 18076 (صحيح)","صحيح الترغيب 2009 (صحيح)"]},{"id":"س-00840","fp":"87c694605d52","stateId":667,"easy":"إذا قلت «الحمد لله» ← تملأ الميزان","cause":"و الحمدُ للهِ","result":"تملأ الميزانَ","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"similar":["س-00733","س-01443","س-01445"],"otherNeedIds":[45],"ref":"صحيح الترغيب 189","srcLabel":"الترمذي","text":["إسباغُ الوضوءِ شطرُ الإيمانِ ",["و الحمدُ للهِ",1]," ",["تملأ الميزانَ",2]," ، و سبحان اللهِ و الحمدُ للهِ تملآنِ أو تملأ ما بين السماءِ و الأرضِ ، و الصلاةُ نورٌ ، و الصدقةُ برهانٌ ، و الصبرُ ضياءٌ ، و القرآنُ حُجَّةٌ لك أو عليك ، كلُّ الناسِ يَغدو ، فبائعٌ نفسَه ، فمُعتِقُها أو موبِقُها"],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3517)، والنسائي (2437)، وابن ماجه (280) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"XLyeA0GQ","merged":2,"otherRefs":["الجامع الصغير 4619 (صحيح)"]},{"id":"س-00733","fp":"01722dc989bd","stateId":667,"easy":"إذا قلت «الحمد لله» ← تملأ الميزان","cause":"الحمدُ للهِ","result":"تملؤُه","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"repOf":"س-00840","ref":"الترغيب والترهيب 2/344","text":["التَّسبيحُ نصفُ الميزانِ ",["الحمدُ للهِ",1]," ",["تملؤُه",2]," ولا إلهَ إلَّا اللهُ ليس لها دونَ اللهِ حجابٌ حتَّى تخلُصَ إليه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3518 )،والطبراني في ((المعجم الكبير)) (13/ 33) (73)،","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"vjRPVe4z"},{"id":"س-01064","fp":"9ddfe68ba0d1","stateId":667,"easy":"إذا سبّحت وحمدت وكبّرت عشراً دبر كل صلاة ← فهي ألف وخمسمئة في الميزان","cause":"ومَن يَعمَلُ بهما قليلٌ، يُسَبِّحُ في دُبُرِ كلِّ صلاةٍ عَشَرةً، ويَحمَدُ عَشَرةً، ويُكبِّرُ عَشَرةً","result":"فذلك خمسونَ ومئةٌ باللسانِ، وألفٌ وخَمسُ مئةٍ في المِيزانِ، ويُكبِّرُ أربعًا وثلاثينَ إذا أخَذَ مَضجَعَه، ويَحمَدُ ثلاثًا وثلاثينَ، ويُسَبِّحُ ثلاثًا وثلاثينَ، فذلك مئةٌ في اللسانِ، وألفٌ في الميزانِ؛ فلقدْ رأيْتُ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-00837","ref":"تخريج سير أعلام النبلاء 6/ 111","text":["خَصلَتانِ -أو خَلَّتانِ- لا يُحافِظُ عليهما عبدٌ مُسلِمٌ إلَّا دخَلَ الجَنَّةَ، هما يَسيرٌ، ",["ومَن يَعمَلُ بهما قليلٌ، يُسَبِّحُ في دُبُرِ كلِّ صلاةٍ عَشَرةً، ويَحمَدُ عَشَرةً، ويُكبِّرُ عَشَرةً، ",1],["فذلك خمسونَ ومئةٌ باللسانِ، وألفٌ وخَمسُ مئةٍ في المِيزانِ، ويُكبِّرُ أربعًا وثلاثينَ إذا أخَذَ مَضجَعَه، ويَحمَدُ ثلاثًا وثلاثينَ، ويُسَبِّحُ ثلاثًا وثلاثينَ، فذلك مئةٌ في اللسانِ، وألفٌ في الميزانِ؛ فلقدْ رأيْتُ",2]," رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَعقِدُها بيَدِه، قالوا: يا رسولَ اللهِ، كيف هما يَسيرٌ، ومَن يَعمَلُ بهما قليلٌ؟ قال: يَأْتي أحَدَكم -يَعْني الشيطانَ- في مَنامِه فيُنَوِّمُه قبلَ أنْ يقولَه، ويَأْتيه في صلاتِه فيُذَكِّرُه حاجَتَه قبلَ أنْ يقولَها."],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"ZWKTQRtj"},{"id":"س-01219","fp":"d112f47cb118","stateId":667,"easy":"إذا لزمت «لا إله إلا الله» ← فلو وُضعت السماوات والأرض في كفة لرجحت بها","cause":"أُوصِيك ب لا إلهَ إلَّا اللهُ","result":"فإنَّ السَّمواتِ والأرضِ لَو كانَتا حلقةً قَصمَتْهُما ، ولَو كانَتا في كفَّةٍ وزنتْهُما","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-02421","otherNeedIds":[49],"ref":"صحيح الترغيب 1543","text":["قال نوحٌ لابنِهِ : إنِّي مُوصِيكَ بوصيَّةٍ وقاصِرُها لكي لا تنساها ؛ أُوصِيك باثنتَيْنِ ، وأنهاك عن اثنتيْنِ : أمَّا اللَّتانِ أُوصِيكَ بهِما ؛ فيستبشِرُ اللهُ بِهِما وصالِحُ خَلقِه ، وهما يُكثرانِ الوُلوجَ على اللهِ : ",["أُوصِيك ب ( لا إلهَ إلَّا اللهُ",1]," ) ؛ ",["فإنَّ السَّمواتِ والأرضِ لَو كانَتا حلقةً قَصمَتْهُما ، ولَو كانَتا في كفَّةٍ وزنتْهُما",2]," . وأُوصِيك ب ( سُبحانَ اللهِ وبِحَمدِه ) ؛ فإنَّهُما صلاةُ الخَلقِ ، وبهما يُرْزَقُ الخلقُ ،  وَإِنْ مِنْ شَيْءٍ إِلَّا يُسَبِّحُ بِحَمْدِهِ وَلَكِنْ لَا تَفْقَهُونَ تَسْبِيحَهُمْ إِنَّهُ كَانَ حَلِيمًا غَفُورًا  . وأمَّا اللَّتانِ أنهاك عَنهُما ؛ فيحتَجبُ اللهُ منهُما وصالِحُ خلقِه : أنهاكَ عن الشِّركِ والكِبْرِ ."],"grade":"صحيح","narrator":"رجل من الأنصار","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10600)، واللفظ له.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"cBhXOPuB"},{"id":"س-01443","fp":"4acf9531755b","stateId":667,"easy":"إذا قلت «الحمد لله» ← تملأ الميزان","cause":"والحَمدُ للهِ","result":"يَملَأُ الميزانَ","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"repOf":"س-00840","otherNeedIds":[45],"ref":"تخريج المسند لشعيب 23139","text":["عن رَجُلٍ من بَني سُلَيمٍ، أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ عَقَدَ في يَدِه، أو في يَدِ السُّلَميِّ فقال: سُبْحانَ اللهِ نِصفُ الميزانِ، ",["والحَمدُ للهِ",1]," ",["يَملَأُ الميزانَ",2],"، واللهُ أكبَرُ يَملَأُ ما بيْنَ السَّماءِ والأرضِ، والطُّهورُ نِصفُ الإيمانِ، والصَّومُ نِصفُ الصَّبرِ."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23139) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"FH2RtXl2"},{"id":"س-01445","fp":"af10aa29b701","stateId":667,"easy":"إذا قلت «الحمد لله» ← تملأ الميزان","cause":"والحَمدُ للهِ","result":"يَملَؤه","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"repOf":"س-00840","otherNeedIds":[45],"ref":"تخريج المسند لشعيب 23160","text":["عن جُرَيٍّ النَّهْديِّ قال: لَقيتُ شَيخًا من بَني سُلَيمٍ بالكُناسةِ فحَدَّثَني، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَدَّ خَمسًا في يَدِه، أو في يَدي، قال: التَّسبيحُ نِصفُ الميزانِ، ",["والحَمدُ للهِ",1]," ",["يَملَؤه",2],"، والتَّكبيرُ يَملَأُ ما بيْنَ السَّماءِ والأرضِ، والصَّومُ نِصفُ الصَّبرِ، والطُّهورُ نِصفُ الإيمانِ."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23160) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"Hn5ERxvd"},{"id":"س-06412","fp":"ba34e215fa19","stateId":667,"easy":"إذا سبّحت وكبّرت وحمدت عشراً دبر كل صلاة ومئة عند النوم ← فهي ألف وخمسمئة في الميزان","cause":"ومَنْ يعملُ بهما قليلٌ ، من سبَّحَ اللهَ في دُبِرِ كلِّ صلاةٍ عشرًا ، وكَبَّرَ اللهَ عشرًا ، وحَمِدَ اللهَ عشرًا","result":"فذلكَ خمسونَ ومئةٌ باللسانِ ، وألفٌ وخمسمئةٍ في الميزانِ ، وإذا آوَى إلى فراشِهِ سبَّحَ ثلاثًا وثلاثينَ وحمِدَ ثلاثًا وثلاثينَ وكبَّرَ أربعًا وثلاثينَ ، فذلِكَ مئةٌ باللسانِ وألفٌ في الميزانِ","explicit":true,"apply":{"k":"time","t":"عند النوم، دبر كل صلاة"},"repOf":"س-00837","ref":"نتائج الأفكار 2/282","text":["خصْلتَانِ مَنْ حافَظَ عليهِمَا دخَلَ الجنَّةَ – وفي روايةِ الثورِيِّ - لا يُحْصِيهُمَا رجلٌ مسلمٌ إلا دَخَلَ الجنةَ ، همَا يسِيرٌ ، ",["ومَنْ يعملُ بهما قليلٌ ، من سبَّحَ اللهَ في دُبِرِ كلِّ صلاةٍ عشرًا ، وكَبَّرَ اللهَ عشرًا ، وحَمِدَ اللهَ عشرًا ، ",1],["فذلكَ خمسونَ ومئةٌ باللسانِ ، وألفٌ وخمسمئةٍ في الميزانِ ، وإذا آوَى إلى فراشِهِ سبَّحَ ثلاثًا وثلاثينَ وحمِدَ ثلاثًا وثلاثينَ وكبَّرَ أربعًا وثلاثينَ ، فذلِكَ مئةٌ باللسانِ وألفٌ في الميزانِ",2]," ، وأيُّكُمْ يعملُ في اليومِ والليلةِ ألفينِ وخمسمئةِ سيئةٍ ؟ . قالَ عبدُ اللهِ بنُ عمرٍو : فأنَا رأيتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يعقدُهَا بيدِهِ . قالوا : يا رسولَ اللهِ كيفَ من يعمَلُ بهمَا قليلٌ ، وفي روايةِ الثوريِّ : كيفَ لا يحصِيهمَا ؟ قالَ : يجِيءُ الشيطانُ أحدَكمْ في صلاتِهِ فيُذَكِّرُهُ حاجَةَ كذا وحاجَةَ كذَا ، فلا يَقُولُهَا ، ويأتِيهِ عندَ منَامِهِ فَيُنَوِّمُهُ فلا يَقُولُهَا"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح وله شاهد بإسناد قوي","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910) باختلاف يسير.","bab":"صلاة › أدعية دبر الصلوات","dorar":"oPe2p9ln"},{"id":"س-00983","fp":"4940450f0e9b","stateId":667,"easy":"إذا كبّرت وسبّحت وحمدت عشراً دبر كل صلاة ← فهي مئة وخمسون باللسان وألف وخمسمئة في الميزان","cause":"ومَن يَفعَلُه قليلٌ؛ في دُبُرِ كلِّ صلاةٍ مكتوبةٍ عشرَ تكبيراتٍ، وعشرَ تسبيحاتٍ، وعشرَ تحميداتٍ","result":"فذلك مئةٌ وخمسونَ باللِّسانِ، وألفٌ وخمسُ مئةٍ في الميزانِ، فإذا وضَعَ جنْبَه سبَّح اللهَ عزَّ وجلَّ ثلاثًا وثلاثينَ، وحَمِد اللهَ عزَّ وجلَّ ثلاثًا وثلاثينَ، وكبَّر أربعًا وثلاثينَ، فذلك مئةٌ باللِّسانِ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-00837","ref":"تخريج مشكل الآثار 4088","text":["خيرٌ كثيرٌ، ",["ومَن يَفعَلُه قليلٌ؛ في دُبُرِ كلِّ صلاةٍ مكتوبةٍ عشرَ تكبيراتٍ، وعشرَ تسبيحاتٍ، وعشرَ تحميداتٍ، ",1],["فذلك مئةٌ وخمسونَ باللِّسانِ، وألفٌ وخمسُ مئةٍ في الميزانِ، فإذا وضَعَ جنْبَه سبَّح اللهَ عزَّ وجلَّ ثلاثًا وثلاثينَ، وحَمِد اللهَ عزَّ وجلَّ ثلاثًا وثلاثينَ، وكبَّر أربعًا وثلاثينَ، فذلك مئةٌ باللِّسانِ،",2]," وألفٌ في الميزانِ، فأيُّكم يَفعَلُ في اليومِ والليلةِ ألفينِ وخمسَ مئةِ سيِّئةٍ؟"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10580)، والطحاوي في ((شرح مشكل الآثار)) (4088) واللفظ لهما، وابن ماجه (926)، وأحمد (6910) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"CBwGnOWm"},{"id":"س-03204","fp":"7698ff0162c0","stateId":667,"easy":"إذا قلت لا إله إلا الله ← ترجح بالسماوات والأرضين","cause":"قُلْ: لا إلَهَ إلَّا اللهُ","result":"لوْ أنَّ السَّمواتِ السَّبعَ، وعامِرَهُنَّ غيري، والأرَضينَ السَّبعَ في كِفَّةٍ، ولا إلَهَ إلَّا اللهُ في كِفَّةٍ؛ مالَتْ بهِنَّ لا إلَهَ إلَّا اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02421","otherNeedIds":[49],"ref":"المستدرك على الصحيحين 1960","text":["قالَ موسى عليه السَّلامُ: يا ربِّ، علِّمْني شيئًا أَذكُرْكَ به، وأَدعوكَ به، قالَ: يا موسى ",["قُلْ: لا إلَهَ إلَّا اللهُ",1],"، قالَ: يا ربِّ، كُلُّ عبادِكَ يقولُ هذا، قالَ: قُلْ: لا إلَهَ إلَّا اللهُ، قالَ: لا إلَهَ إلَّا أنتَ يا ربِّ، إنَّما أُريدُ شيئًا تَخُصُّني به، قالَ: يا موسى، ",["لوْ أنَّ السَّمواتِ السَّبعَ، وعامِرَهُنَّ غيري، والأرَضينَ السَّبعَ في كِفَّةٍ، ولا إلَهَ إلَّا اللهُ في كِفَّةٍ؛ مالَتْ بهِنَّ لا إلَهَ إلَّا اللهُ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10602)، وابن حبان (6218)، والطبراني في ((الدعاء)) (1480) جميعا بلفظه.","bab":"إيمان › فضل الإيمان","dorar":"9E9l9P70"},{"id":"س-01444","fp":"1995eba4b065","stateId":667,"easy":"إذا سبّحت ← فالتسبيح نصف الميزان","cause":"التَّسبيحُ","result":"نِصفُ الميزانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[45],"ref":"تخريج المسند لشعيب 23160","srcLabel":"الترمذي","text":["عن جُرَيٍّ النَّهْديِّ قال: لَقيتُ شَيخًا من بَني سُلَيمٍ بالكُناسةِ فحَدَّثَني، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَدَّ خَمسًا في يَدِه، أو في يَدي، قال: ",["التَّسبيحُ",1]," ",["نِصفُ الميزانِ",2],"، والحَمدُ للهِ يَملَؤه، والتَّكبيرُ يَملَأُ ما بيْنَ السَّماءِ والأرضِ، والصَّومُ نِصفُ الصَّبرِ، والطُّهورُ نِصفُ الإيمانِ."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23160) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"Hn5ERxvd","merged":4,"otherRefs":["الترغيب والترهيب 2/344 (صحيح)","الجامع الصغير 4619 (صحيح)","تخريج المسند لشعيب 23139 (صحيح)"]},{"id":"س-02387","fp":"82c95134262e","stateId":667,"easy":"إذا شهدت أن لا إله إلا الله ← تطيش بها سجلات السيئات","cause":"بطاقةٌ فيها : أشهدُ أن لا إلَهَ إلَّا اللَّهُ ، وأنَّ محمَّدًا عبدُهُ ورسولُهُ","result":"فَطاشتِ السِّجلَّاتُ ، وثقُلتِ البطاقةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[66],"ref":"صحيح ابن ماجه 3488","srcLabel":"ابن ماجه","text":["يُصاحُ برجلٍ من أمَّتي يومَ القيامةِ على رءوسِ الخلائقِ ، فيُنشَرُ لَهُ تسعةٌ وَتِسْعونَ سجلًّا ، كلُّ سجلٍّ مدَّ البصرِ ، ثمَّ يقولُ اللَّهُ عزَّ وجلَّ : هل تُنكرُ من هذا شيئًا ؟ فيقولُ : لا ، يا ربِّ ، فيقولُ : أظلمَتكَ كتبتي الحافظونَ ؟ ثمَّ يقولُ : ألَكَ عن ذلكَ حسنةٌ ؟ فيهابُ الرَّجلُ ، فيقولُ : لا ، فيقولُ : بلَى ، إنَّ لَكَ عندَنا حسَناتٍ ، وإنَّهُ لا ظُلمَ عليكَ اليومَ ، فتُخرَجُ لَهُ ",["بطاقةٌ فيها : أشهدُ أن لا إلَهَ إلَّا اللَّهُ ، وأنَّ محمَّدًا عبدُهُ ورسولُهُ",1]," ، قالَ : فَيقولُ : يا ربِّ ما هذِهِ البطاقةُ ، معَ هذِهِ السِّجلَّاتِ ؟ فيقولُ : إنَّكَ لا تُظلَمُ ، فتوضَعُ السِّجلَّاتُ في كفَّةٍ ، والبطاقةُ في كفَّةٍ ، ",["فَطاشتِ السِّجلَّاتُ ، وثقُلتِ البطاقةُ",2]," قالَ محمَّدُ بنُ يحيى : البطاقةُ : الرُّقعةُ ، وأَهْلُ مِصرَ يقولونَ للرُّقعةِ : بِطاقةً"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4300) واللفظ له، وأحمد (6994) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"ksURUCX6","merged":4,"otherRefs":["شرح الطحاوية 417 (صحيح)","تخريج المسند لشاكر 12/24 (صحيح)","تخريج شرح الطحاوية 317 (صحيح)"]},{"id":"س-01240","fp":"5e82f847a47c","stateId":667,"easy":"إذا قلت لا إله إلا الله ← ترجح بالسماوات والأرض في الميزان","cause":"لو أنَّ السَّمواتِ والأرضَ وما فيهما وضعَ في كفَّةِ","result":"الميزانِ ووضعَتْ لا إلهَ إلَّا اللَّهُ في الكفَّةِ الأخرى لرجحَت بِهنَّ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-02421","otherNeedIds":[45],"ref":"الصحيح المسند 1/625","text":["أنَّ نَوْفًا وعبدَ اللَّهِ بنَ عمرٍو يعني ابنَ العاص اجتمعا فقالَ نوفٌ : ",["لو أنَّ السَّمواتِ والأرضَ وما فيهما وضعَ في كفَّةِ ",1],["الميزانِ ووضعَتْ لا إلهَ إلَّا اللَّهُ في الكفَّةِ الأخرى لرجحَت بِهنَّ ",2],"، ولو أنَّ السَّماواتِ والأرضَ وما فيهنَّ كنَّ طبقًا من حديدٍ فقالَ رجلٌ : لا إلهَ إلَّا اللَّهُ لخرقَتهُنَّ حتَّى تنتهيَ إلى اللَّهِ عزَّ وجلَّ فقالَ عبدُ اللَّهِ بنُ عمرٍو : صلَّينا معَ رسولِ اللَّهِ ٍ- صلَّى اللَّهُ عليهِ وعلى آلِهِ وسلَّمَ - المغربَ فعقَّبَ من عقَّبَ ورجعَ من رجعَ فجاءَ - صلَّى اللَّهُ عليهِ وعلى آلِه وسلَّمَ - وقد كادَ يَحسِرُ ثيابَهُ عن ركبتيهِ فقالَ : (أبشِروا معشرَ المسلمينَ . هذا ربُّكم قد فتحَ بابًا من أبوابِ السَّماءِ يباهي بهي الملائكةَ يقولُ : هؤلاءِ عبادي قضَوا فريضةً وهم ينتظِرونَ أخرى ) . في رواية مثلِه وزاد : وإن كاد يحسِرُ ثوبَهُ عن ركبتيهِ وقد حفزَهُ النفَسُ ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح ، رجاله رجال الصحيح","takhrij":"أخرجه ابن ماجه (801)، وأحمد (6750)، والطبراني (13/ 605) (14523) واللفظ لهم.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"YlSCjy5c"},{"id":"س-02025","fp":"cbd5c34a6340","stateId":667,"easy":"إذا حسن خلقك وطال صمتك ← فهما أثقل في الميزان","cause":"عليك بحُسْنِ الخُلُقِ وطولِ الصَّمْتِ","result":"أَلَا أَدُلُّك على خَصْلتَينِ هما خَفيفتانِ على الظَّهْرِ وأَثقَلُ في الميزانِ مِن غَيْرِهما","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[49],"ref":"الأحكام الوسطى 4/ 278","srcLabel":"الأحكام الوسطى","text":["لَقِيَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أبا ذَرٍّ فقالَ له: \"يا أبا ذَرٍّ، ",["أَلَا أَدُلُّك على خَصْلتَينِ هما خَفيفتانِ على الظَّهْرِ وأَثقَلُ في الميزانِ مِن غَيْرِهما",2],"؟\" قالَ: بَلى يا رَسولَ اللهِ، قالَ: \"",["عليك بحُسْنِ الخُلُقِ وطولِ الصَّمْتِ",1],"؛ فوَالَّذي نفْسي بيَدِه ما عَمِلَ الخَلائِقُ بمِثلِهما\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"wiJnai1Q"},{"id":"س-06408","fp":"40ff33cf8a7a","stateId":667,"easy":"إذا سبّحت وحمدت وكبّرت عشراً دبر كل صلاة ← فهي مائة وخمسون باللسان وألف وخمسمائة في الميزان","cause":"تسبِّحُ اللَّهَ عشرًا وتحمدُ اللَّهَ عشرًا وتُكَبِّرُ اللَّهَ عشرًا في دُبرِ كلِّ صلاةٍ","result":"فذلِكَ مائةٌ وخمسونَ باللِّسانِ وألفٌ وخمسُمائةٍ في الميزانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"دبر كل صلاة"},"repOf":"س-00837","ref":"تخريج المسند لشاكر 11/128","text":["خَصلتانِ أو خلَّتانِ لا يحافظُ عليهِما رجلٌ مسلمٌ إلَّا دخلَ الجنَّةَ هُما يسيرٌ ومَن يعملُ بِهِما قليلٌ ",["تسبِّحُ اللَّهَ عشرًا وتحمدُ اللَّهَ عشرًا وتُكَبِّرُ اللَّهَ عشرًا في دُبرِ كلِّ صلاةٍ",1]," ",["فذلِكَ مائةٌ وخمسونَ باللِّسانِ وألفٌ وخمسُمائةٍ في الميزانِ",2]," وتسبِّحُ ثلاثًا وثلاثينَ وتحمدُ ثلاثًا وثلاثينَ وتُكَبِّرُ أربعًا وثلاثينَ عطاءٌ لا يدري أيَّتُهُنَّ أربعٌ وثلاثونَ إذا أخذَ مَضجعَهُ فذلِكَ مائةٌ باللِّسانِ وألفٌ في الميزانِ فأيُّكم يعملُ في اليومِ ألفَينِ وخمسَمائةِ سَيِّئةٍ قالوا يا رسولَ اللَّهِ كيفَ هُما يسيرٌ ومَن يعملُ بِهِما قليلٌ قالَ يأتي أحدَكُمُ الشَّيطانُ إذا فرغَ مِن صلاتِهِ فيذَكِّرُهُ حاجةَ كَذا وَكَذا فيقومُ ولا يقولُها فإذا اضطجعَ يأتيهِ الشَّيطانُ فينَوِّمُهُ قبلَ أن يقولَها فلقد رأيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يعقِدُهُنَّ في يدِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910) واللفظ له.","bab":"صلاة › أدعية دبر الصلوات","dorar":"8yf7ss7P"},{"id":"س-06409","fp":"aff920223458","stateId":667,"easy":"إذا سبّحت وحمدت وكبّرت عند النوم ← فهي مائة باللسان وألف في الميزان","cause":"وتسبِّحُ ثلاثًا وثلاثينَ وتحمدُ ثلاثًا وثلاثينَ وتُكَبِّرُ أربعًا وثلاثينَ عطاءٌ لا يدري أيَّتُهُنَّ أربعٌ وثلاثونَ إذا أخذَ مَضجعَهُ","result":"فذلِكَ مائةٌ باللِّسانِ وألفٌ في الميزانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"عند النوم"},"repOf":"س-01313","ref":"تخريج المسند لشاكر 11/128","text":["خَصلتانِ أو خلَّتانِ لا يحافظُ عليهِما رجلٌ مسلمٌ إلَّا دخلَ الجنَّةَ هُما يسيرٌ ومَن يعملُ بِهِما قليلٌ تسبِّحُ اللَّهَ عشرًا وتحمدُ اللَّهَ عشرًا وتُكَبِّرُ اللَّهَ عشرًا في دُبرِ كلِّ صلاةٍ فذلِكَ مائةٌ وخمسونَ باللِّسانِ وألفٌ وخمسُمائةٍ في الميزانِ ",["وتسبِّحُ ثلاثًا وثلاثينَ وتحمدُ ثلاثًا وثلاثينَ وتُكَبِّرُ أربعًا وثلاثينَ عطاءٌ لا يدري أيَّتُهُنَّ أربعٌ وثلاثونَ إذا أخذَ مَضجعَهُ",1]," ",["فذلِكَ مائةٌ باللِّسانِ وألفٌ في الميزانِ",2]," فأيُّكم يعملُ في اليومِ ألفَينِ وخمسَمائةِ سَيِّئةٍ قالوا يا رسولَ اللَّهِ كيفَ هُما يسيرٌ ومَن يعملُ بِهِما قليلٌ قالَ يأتي أحدَكُمُ الشَّيطانُ إذا فرغَ مِن صلاتِهِ فيذَكِّرُهُ حاجةَ كَذا وَكَذا فيقومُ ولا يقولُها فإذا اضطجعَ يأتيهِ الشَّيطانُ فينَوِّمُهُ قبلَ أن يقولَها فلقد رأيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يعقِدُهُنَّ في يدِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5065)، والترمذي (3410)، والنسائي (1348)، وابن ماجه (926)، وأحمد (6910) واللفظ له.","bab":"صلاة › أدعية دبر الصلوات","dorar":"8yf7ss7P"},{"id":"س-06915","fp":"e6afd0187bc9","stateId":667,"easy":"إذا قلت لا إله إلا الله ← ترجح في الميزان","cause":"وهو لا إلهَ إلَّا اللهُ","result":"فتوضعُ في كِفَّةِ الميزانِ فترجحُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-02421","ref":"حلية الأولياء 2/378","text":["يؤتَى بعملِ العبدِ يومَ القيامةِ فيُوضعُ في كِفَّةِ الميزانِ ، فلا يَرجحُ حتَّى يؤتَى بصحيفةٍ مختومةٍ من يدِ الرَّحمنِ عزَّ وجلَّ ، ",["فتوضعُ في كِفَّةِ الميزانِ فترجحُ",2]," ، ",["وهو لا إلهَ إلَّا اللهُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت تفرد به الهيثم بن جماز","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (7/102)، وأبو نعيم في ((حلية الأولياء)) (2/333) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"1SHB7mLQ"},{"id":"س-02645","fp":"c69006e6369b","stateId":668,"easy":"إذا نويت الخير ← يبعثك الله على نيتك","cause":"على نيَّاتِهم","result":"يَبعَثُهمُ اللهُ","explicit":true,"star":true,"otherNeedIds":[19],"ref":"تخريج المسند لشعيب 24738","srcLabel":"متفق عليه","text":["بينَما رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ نائمٌ، إذ ضحِكَ في مَنامِه، ثُم استَيقَظَ، فقُلْتُ: يا رسولَ اللهِ، ممَّ ضحِكْتَ؟ قال: إنَّ أُناسًا من أُمَّتي يَؤمُّونَ هذا البيتَ لرَجلٍ من قُرَيشٍ، قدِ استَعاذَ بالحَرَمِ، فلمَّا بَلَغوا البَيداءَ، خُسِفَ بهم، مصادِرُهم شَتَّى، يَبعَثُهمُ اللهُ ",["على نيَّاتِهم",1],"، قُلْتُ: وكيف ",["يَبعَثُهمُ اللهُ",2]," عزَّ وجلَّ على نيَّاتِهم ومصادِرُهم شَتَّى؟ قال: جمَعَهمُ الطريقُ، منهمُ المُستَبصِرُ، وابنُ السبيلِ، والمَجبورُ، يَهلِكونَ مَهلِكًا واحدًا، ويَصدُرونَ مصادِرَ شَتَّى."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2118) بنحوه، ومسلم (2884) باختلاف يسير","bab":"إيمان › الاحتساب والنية","dorar":"whwQIxV3","merged":7,"otherRefs":["تخريج المسند لشعيب 9090 (صحيح)","صحيح ابن ماجه 3302 (صحيح)","تخريج المسند لشعيب 26747 (صحيح)","صحيح الترغيب 13 (صحيح)","البدر المنير 1/659 (صحيح)","صحيح الجامع 4123 (صحيح)"]},{"id":"س-07250","fp":"71bfe7a08e6b","stateId":668,"easy":"إذا نفّست عن مؤمن كربة من كرب الدنيا ← ينفّس الله عنك كربة من كرب يوم القيامة","cause":"مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا","result":"نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ","explicit":true,"star":true,"similar":["س-08042","س-03827"],"otherNeedIds":[4],"ref":"تخريج المسند لشعيب 7427","srcLabel":"مسلم","text":[["مَن نفَّسَ عن مُؤْمنٍ كُرْبَةً مِن كُرَبِ الدُّنيا؛ ",1],["نفَّسَ اللهُ عَنه كُرْبَةً مِن كُرَبِ يَوْمِ القِيامَةِ، ",2],"ومَن ستَرَ مُسْلمًا ستَرَه اللهُ في الدُّنيا والآخِرَةِ، ومَن يسَّرَ على مُعْسِرٍ يسَّرَ اللهُ عليه في الدُّنيا والآخِرَةِ، واللهُ في عَوْنِ العَبْدِ ما كان العَبْدُ في عَوْنِ أَخيه، ومَن سلَكَ طَريقًا يَلْتَمِسُ فيه عِلْمًا سهَّلَ اللهُ له به طَريقًا إلى الجنةِ، وما اجتمَعَ قَوْمٌ في بَيْتٍ مِن بُيوتِ اللهِ يَتْلُون كِتابَ اللهِ، ويَتَدارَسُونه بَيْنَهم؛ إلَّا نزلَتْ عليهم السَّكِينَةُ، وغشِيَتْهم الرَّحْـمةُ، وحفَّتْهم الـمَلائِكةُ، وذكَرَهم اللهُ عزَّ وجلَّ فيمَن عِندَه، ومَن أبْطَأَ به عَمَلُه، لَـمْ يُسْرِعْ به نَسَبُه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه مسلم (2699) باختلاف يسير","bab":"علم › فضل مجالس العلم والذكر","dorar":"hv3Ejh53"},{"id":"س-08042","fp":"66f50f609924","stateId":668,"easy":"إذا فرّجت عن مسلم كربة ← يفرج الله عنك كربة من كرب يوم القيامة","cause":"ومَن فرَّجَ عن مُسلِمٍ كُربةً","result":"فرَّجَ اللهُ عنه كُربةً مِن كُرُباتِ يَومِ القيامةِ","explicit":true,"repOf":"س-07250","otherNeedIds":[4],"ref":"صحيح البخاري 2442","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: المُسلِمُ أخو المُسلِمِ لا يَظلِمُه ولا يُسلِمُه، ومَن كان في حاجةِ أخيه كان اللهُ في حاجَتِه، ",["ومَن فرَّجَ عن مُسلِمٍ كُربةً",1]," ",["فرَّجَ اللهُ عنه كُربةً مِن كُرُباتِ يَومِ القيامةِ",2],"، ومَن سَتَرَ مُسلِمًا سَتَرَه اللهُ يَومَ القيامةِ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2580) باختلاف يسير","bab":"مظالم › تحريم الظلم","dorar":"jlxZZOdn"},{"id":"ق-0888","fp":"3b7d22fba687","stateId":668,"easy":"القلب السليم ← النفع يوم لا ينفع مال ولا بنون","cause":"القلب السليم","result":"النفع يوم لا ينفع مال ولا بنون","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة الشعراء: 88–89","srcLabel":"القرآن الكريم","quran":{"s":26,"from":88,"to":89,"text":"يَوْمَ لَا يَنْفَعُ مَالٌ وَلَا بَنُونَ (88) إِلَّا مَنْ أَتَى اللَّهَ بِقَلْبٍ سَلِيمٍ (89)","hl":[[0,39,2],[39,87,1]]}},{"id":"ق-1401","fp":"3277b4f5af33","stateId":668,"easy":"الوفاء بالنذر وخوف يوم القيامة وإطعام الطعام على حبه مسكيناً ويتيماً وأسيراً لوجه الله ← الوقاية من شر ذلك اليوم ونضرة وسرور وجنة وحرير","cause":"الوفاء بالنذر وخوف يوم القيامة وإطعام الطعام على حبه مسكيناً ويتيماً وأسيراً لوجه الله","result":"الوقاية من شر ذلك اليوم ونضرة وسرور وجنة وحرير","explicit":true,"otherNeedIds":[67,6],"ref":"سورة الإنسان: 5–12","srcLabel":"القرآن الكريم","quran":{"s":76,"from":5,"to":12,"text":"إِنَّ الْأَبْرَارَ يَشْرَبُونَ مِنْ كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا (5) عَيْنًا يَشْرَبُ بِهَا عِبَادُ اللَّهِ يُفَجِّرُونَهَا تَفْجِيرًا (6) يُوفُونَ بِالنَّذْرِ وَيَخَافُونَ يَوْمًا كَانَ شَرُّهُ مُسْتَطِيرًا (7) وَيُطْعِمُونَ الطَّعَامَ عَلَى حُبِّهِ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا (8) إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اللَّهِ لَا نُرِيدُ مِنْكُمْ جَزَاءً وَلَا شُكُورًا (9) إِنَّا نَخَافُ مِنْ رَبِّنَا يَوْمًا عَبُوسًا قَمْطَرِيرًا (10) فَوَقَاهُمُ اللَّهُ شَرَّ ذَلِكَ الْيَوْمِ وَلَقَّاهُمْ نَضْرَةً وَسُرُورًا (11) وَجَزَاهُمْ بِمَا صَبَرُوا جَنَّةً وَحَرِيرًا (12)","hl":[[0,444,1],[444,570,2]]}},{"id":"س-06917","fp":"a118f02940da","stateId":668,"easy":"إذا خفت الله في الدنيا ← يؤمنك يوم القيامة","cause":"إذا خافني في الدُّنيا","result":"أمَّنتُه يومَ القيامةِ","explicit":true,"otherNeedIds":[6],"ref":"الترغيب والترهيب 4/209","srcLabel":"ابن حبان","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما يَروي عن ربِّه جلَّ وعلا أنَّه قال : وعِزَّتي لا أجمعُ على عبدي خوفَيْن وأمنَيْن : ",["إذا خافني في الدُّنيا",1]," ",["أمَّنتُه يومَ القيامةِ",2]," ، وإذا أمِنني في الدُّنيا أخفتُه في الآخرةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (640)، والبيهقي في ((شعب الإيمان)) (759) كلاهما بلفظه، والبزار (8029) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"rtOiudlK","merged":3,"otherRefs":["صحيح ابن حبان 640 (صحيح)","السلسلة الصحيحة 742 (صحيح)"]},{"id":"س-02909","fp":"08b6b10b8e19","stateId":668,"easy":"إذا مت مرابطاً ← تأمن من الفزع الأكبر ويُغدى عليك برزقك","cause":"ومَنْ ماتَ مرابِطًا فِي سبيلِ اللهِ","result":"أمِنَ مِنَ الفزَعِ الأَكْبَرِ ، وغُدِيَ عليْهِ برزقِهِ ، ورِيحَ مِنَ الجنةِ ، ويَجْرِي عليه أجرُ المرابِطِ ، حتى يبعَثَهُ اللهُ","explicit":true,"otherNeedIds":[50,63],"ref":"صحيح الجامع 3479","srcLabel":"الطبراني","text":["رباطُ شهرٍ خيرٌ من صيامِ دهرٍ ، ",["ومَنْ ماتَ مرابِطًا فِي سبيلِ اللهِ ",1],["أمِنَ مِنَ الفزَعِ الأَكْبَرِ ، وغُدِيَ عليْهِ برزقِهِ ، ورِيحَ مِنَ الجنةِ ، ويَجْرِي عليه أجرُ المرابِطِ ، حتى يبعَثَهُ اللهُ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (5/293)","bab":"إيمان › الوعد","dorar":"zjkF0Rdo","merged":2,"otherRefs":["المصابيح في الأحاديث المتواترة 622 (صحيح)"]},{"id":"س-02244","fp":"a501d7bc2093","stateId":668,"easy":"إذا نفّست عن معسر أو وضعت عنه ← ينجيك الله من كرب يوم القيامة","cause":"فليُنَفِّسْ عن مُعسِرٍ، أو يَضَعْ عنه","result":"مَن سَرَّه أن يُنجيَه اللهُ مِن كُرَبِ يَومِ القيامةِ","explicit":true,"ref":"صحيح مسلم 1563","srcLabel":"أحمد","text":["أنَّ أبا قَتادةَ طَلَبَ غَريمًا له، فتَوارى عنه، ثُمَّ وجَدَه، فقال: إنِّي مُعسِرٌ، فقال: آللَّهِ؟ قال: آللَّهِ؟ قال: فإنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن سَرَّه أن يُنجيَه اللهُ مِن كُرَبِ يَومِ القيامةِ ",2],["فليُنَفِّسْ عن مُعسِرٍ، أو يَضَعْ عنه",1],"."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22559)، وابن أبي الدنيا في ((اصطناع المعروف)) (157)، وأبو عوانة (5670) واللفظ لهم جميعا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OvLmoosA"},{"id":"س-02914","fp":"839d95b10614","stateId":668,"easy":"إذا كنت ممن يفزع الناس إليهم في حوائجهم ← تكون من الآمنين يوم القيامة","cause":"يفزعُ الناسُ إليهم في حوائجِهم","result":"أولئك الآمِنونَ يومَ القيامةِ","explicit":true,"ref":"شرح كتاب الشهاب 216","srcLabel":"الطبراني","text":["إنَّ للهِ عبادًا خلقَهم لحوائجِ الناسِ  ",["يفزعُ الناسُ إليهم في حوائجِهم",1]," ",["أولئك الآمِنونَ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (12/358) (13334)، وابن عدي في ((الكامل في الضعفاء)) (4/190)، وأبو نعيم في ((حلية الأولياء)) (3/225) باختلاف يسير","bab":"إيمان › الوعد","dorar":"gTQ7w4AU"},{"id":"س-03827","fp":"26db2bdf15de","stateId":668,"easy":"إذا نجيت مكروباً ← يفك الله عنك كربة من كرب يوم القيامة","cause":"ومن نجَّى مكروبًا","result":"فكَّ الله عنه كربةً من كُربِ يومِ القيامةِ","explicit":true,"repOf":"س-07250","otherNeedIds":[4],"ref":"عمدة القاري 12/405","text":["مَن ستر مسلمًا في الدنيا ستره اللهُ في الدنيا والآخرةِ [",["ومن نجَّى مكروبًا ",1],["فكَّ الله عنه كربةً من كُربِ يومِ القيامةِ ",2],"ومن كان في حاجةِ أخيه كان اللهُ عزَّ وجلَّ في حاجتِه]"],"grade":"صحيح","narrator":"مسلمة بن مخلد","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن المقريء في ((معجمه)) (1308) واللفظ له، وأحمد (16959)، وعبد الرزاق (18936) باختلاف يسير.","bab":"بر وصلة › حق المسلم على المسلم","dorar":"qzLDnXIH"},{"id":"س-05448","fp":"75260e11dfb8","stateId":668,"easy":"إذا غضضت عينك عن محارم الله أو سهرت في سبيل الله أو بكت من خشيته ← لا تبكي عينك يوم القيامة","cause":"عَيْنًا غَضَّتْ عن مَحَارِمِ اللهِ تعالى ، وعَيْنًا سَهِرَتْ في سبيلِ اللهِ تعالى ، وعَيْنًا خرج منها مِثْلُ رأسُ الذُّبابِ من خشيةِ اللهِ تعالى","result":"كلُّ عينٍ باكيةٌ يومَ القيامةِ ، إلا","explicit":true,"ref":"الجامع الصغير 6316","srcLabel":"أبو نعيم","text":[["كلُّ عينٍ باكيةٌ يومَ القيامةِ ، إلا",2]," ",["عَيْنًا غَضَّتْ عن مَحَارِمِ اللهِ تعالى ، وعَيْنًا سَهِرَتْ في سبيلِ اللهِ تعالى ، وعَيْنًا خرج منها مِثْلُ رأسُ الذُّبابِ من خشيةِ اللهِ تعالى",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو نعيم في ((الحلية)) (3/ 163)، وابن أبي عاصم في ((الجهاد)) (148)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (497) جميعهم بلفظه.","bab":"رقائق وزهد › الخوف من الله","dorar":"TXSFeoK1"},{"id":"س-07892","fp":"f1d17e6e7708","stateId":668,"easy":"إذا كنت مؤمناً ← يكون عليك هول القيامة كالزكمة","cause":"فأمَّا المُؤْمِنُ","result":"فهو عليه كالزُّكْمةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03202","س-01775"],"ref":"الأحاديث المختارة 2695","srcLabel":"متفق عليه","text":["«حَدَّثَني نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنِّي لقائِمٌ أنْتَظِرُ أمَّتي تَعبُرُ الصِّراطَ إذ جاءَني عيسى، قالَ: فقالَ: هذه الأنْبِياءُ قد جاءَتْك يا مُحمَّدُ يَسْألونَ، أو قالَ: يَجْتَمِعونَ إليك ويَدْعونَ اللهَ عَزَّ وجَلَّ أن تُفرِّقَ بَيْنَ جَمْعِ الأُمَمِ إلى حيثُ يَشاءُ اللهُ؛ لِغَمِّ ما هُمْ فيه، فالخَلْقُ مُلجَمونَ في العَرَقِ، ",["فأمَّا المُؤْمِنُ",1]," ",["فهو عليه كالزُّكْمةِ",2],"، وأمَّا الكافِرُ فيَتَغشَّاه المَوْتُ، قالَ: قالَ عيسى: انْتَظِرْ حتَّى أرْجِعَ إليك، قالَ: فذَهَبَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ فقامَ تحتَ العَرْشِ، فلَقيَ ما لم يَلْقَ مَلَكٌ مُصْطَفًى، ولا نَبِيٌّ مُرسَلٌ، فأَوْحى اللهُ عَزَّ وجَلَّ إلى جِبْريلَ أن اذْهَبْ إلى مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ فقُلْ له: ارْفَعْ رأسَك، سَلْ تُعْطَه، واشْفَعْ تُشَفَّعْ، قالَ: فشُفِّعْتُ في أمَّتي أن أُخرِجَ مِن كلِّ تِسْعةٍ وتِسْعينَ إنْسانًا واحِدًا، قالَ: فما زِلْتُ أتَرَدَّدُ على رَبِّي عَزَّ وجَلَّ فلا أقومُ مِنه مَقامًا إلَّا شُفِّعْتُ حتَّى أعْطاني اللهُ مِن ذلك أن قالَ: يا مُحمَّدُ، أَدخِلْ مِن أمَّتِك مِن خَلْقِ اللهِ مَن شَهِدَ أنْ لا إلهَ إلَّا اللهُ يَوْمًا واحِدًا مُخلِصًا، وماتَ على ذلك»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قيامة › الشفاعة","dorar":"RwPYP6i7","merged":2,"otherRefs":["تخريج العواصم والقواصم 8/ 424 (حسن)"]},{"id":"س-02952","fp":"884e25fee8a0","stateId":668,"easy":"إذا أصاب قومك عذاب وأنت صالح ← تُبعث على عملك","cause":"على أعمالِهم","result":"ثمَّ بُعثُوا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[19],"ref":"الجامع الصغير 399","srcLabel":"متفق عليه","text":["إذا أرادَ اللهُ بقومٍ عذابًا أصابَ العذابُ منْ كانَ فيهمْ، ",["ثمَّ بُعثُوا",2]," ",["على أعمالِهم",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7108) باختلاف يسير، ومسلم (2879) واللفظ له","bab":"إيمان › الوعيد","dorar":"C99AXfNr"},{"id":"س-03202","fp":"e81070e12711","stateId":668,"easy":"إذا كنت مؤمناً ← يُهوّن عليك يوم القيامة","cause":"المُؤمِنينَ","result":"يُهوِّنُ ذلكَ على المُؤمِنينَ كتدَلِّي الشَّمسِ لِلغروبِ إلى أنْ تغرُبَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-07892","ref":"تخريج صحيح ابن حبان 7333","text":["( يقومُ النَّاسُ لِربِّ العالَمينَ مِقدارَ نِصفِ يومٍ مِن خمسينَ ألفَ سنةٍ، ",["يُهوِّنُ ذلكَ على المُؤمِنينَ كتدَلِّي الشَّمسِ لِلغروبِ إلى أنْ تغرُبَ",2]," )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أبو يعلى (6025)، وابن حبان (7333) ، وابن عساكر في ((تاريخ دمشق)) (8/ 416) جميعا بلفظه.","bab":"إيمان › فضل الإيمان","dorar":"nTF79ACc"},{"id":"س-01775","fp":"afcfcacf3e7d","stateId":668,"easy":"إذا كنت مؤمناً ← يُخفف عليك يوم القيامة حتى يكون أخف من صلاة مكتوبة","cause":"المُؤمِنِ","result":"إنَّه لَيُخفَّفُ على المُؤمِنِ حتَّى يكونَ أخَفَّ عليه مِن صلاةٍ مكتوبةٍ يُصلِّيها في الدُّنيا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-07892","ref":"صحيح ابن حبان 7334","text":["( {يَوْمٍ كَانَ مِقْدَارُهُ خَمْسِينَ أَلْفَ سَنَةٍ} [المعارج: 4] فقيل : ما أطوَلَ هذا اليومَ ؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( والَّذي نفسي بيدِه ",["إنَّه لَيُخفَّفُ على المُؤمِنِ حتَّى يكونَ أخَفَّ عليه مِن صلاةٍ مكتوبةٍ يُصلِّيها في الدُّنيا",2]," )"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (11717)، وابن أبي الدنيا في ((الأهوال)) (103) بلفظه.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"CY3672Um","merged":3,"otherRefs":["المواهب اللدنية 3/637 (حسن)","الوهم والإيهام 4/378 (حسن)"]},{"id":"س-01796","fp":"51c8dce719b1","stateId":668,"easy":"إذا عملت المعروف ← يبشّرك يوم القيامة بالخير","cause":"فأَمَّا المعروفُ","result":"فيُبَشِّرُ أصحابَهُ ويوعِدُهم الخيرَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 7/265","srcLabel":"أحمد","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والَّذِي نَفْسُ محمدٍ بيدِهِ إنَّ المعروفَ والمنكَرَ لَخَلِيقَتَانِ يُنْصَبانِ للناسِ يومَ القيامةِ ",["فأَمَّا المعروفُ",1]," ",["فيُبَشِّرُ أصحابَهُ ويوعِدُهم الخيرَ",2]," وأمَّا المنكرَ فيقولُ إليكم إليكم وما يستطيعونَ لَهُ إلَّا لُزَومًا"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (19487)، والطيالسي (537)، وابن أبي الدنيا في ((اصطناع المعروف)) (16)، والطبراني في ((المعجم الأوسط)) (8925) واللفظ لهم.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"36Ag1uXp"},{"id":"س-02457","fp":"a2f772804438","stateId":668,"easy":"إذا قلت «اللهم فاطر السماوات والأرض... إني أعهد إليك» ← يكون لك عهد عند الله","cause":"اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ [الزمر: 46] إنِّي أعهدُ إليكَ في هذه الحياةِ الدُّنيا بأنِّي أَشهدُ أنْ لا إلهَ إلَّا أنتَ وحدَكَ لا شريكَ لكَ، وأنَّ مُحمَّدًا عبدُكَ ورسولُكَ، فإنَّكَ إنْ تَكِلني إلى عمَلٍ يُقرِّبني مِنَ الشَّرِّ، ويُباعدُني مِنَ الخيرِ، وإنِّي لا أثِقُ إلَّا برحمتِكَ فاجعلْهُ لي عندكَ عهدًا تُوفِّيهِ إليَّ يومَ القيامةِ، إنَّكَ لا تُخلِفُ الميعادَ","result":"مَنْ كان له عندي عهدٌ فليَقُمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ} [الزمر: 46] إنِّي أعهدُ إليك»"},"ref":"المستدرك على الصحيحين 3470","srcLabel":"الحاكم","text":["عنْ عبدِ اللهِ بنِ مسعودٍ رَضيَ اللهُ عنه، أنَّه قَرَأَ: {إِلَّا مَنِ اتَّخَذَ عِنْدَ الرَّحْمَنِ عَهْدًا} [مريم: 87] فقالَ: اتَّخذوا عندَ الرَّحمنِ عهدًا، فإنَّ اللهَ يقولُ يومَ القيامةِ: ",["مَنْ كان له عندي عهدٌ فليَقُمْ",2],". قالَ: فقُلنا: فعلِّمْنا يا أبا عبدِ الرَّحمنِ، قالَ: قولوا: {قُلِ ",["اللَّهُمَّ فَاطِرَ السَّمَاوَاتِ وَالْأَرْضِ عَالِمَ الْغَيْبِ وَالشَّهَادَةِ} [الزمر: 46] إنِّي أعهدُ إليكَ في هذه الحياةِ الدُّنيا بأنِّي أَشهدُ أنْ لا إلهَ إلَّا أنتَ وحدَكَ لا شريكَ لكَ، وأنَّ مُحمَّدًا عبدُكَ ورسولُكَ، فإنَّكَ إنْ تَكِلني إلى عمَلٍ يُقرِّبني مِنَ الشَّرِّ، ويُباعدُني مِنَ الخيرِ، وإنِّي لا أثِقُ إلَّا برحمتِكَ فاجعلْهُ لي عندكَ عهدًا تُوفِّيهِ إليَّ يومَ القيامةِ، إنَّكَ لا تُخلِفُ الميعادَ",1],"."],"grade":"صحيح","narrator":"الأسود بن يزيد","muhaddith":"صحيح الإسناد","bab":"إسلام › فضل الشهادتين","dorar":"JPqjOyp0"},{"id":"س-02722","fp":"36c438e34ee4","stateId":668,"easy":"إذا كنت من الشهداء ← يقيك الله شر يوم القيامة","cause":"أولئك هم الشهداءُ","result":"يقيهمُ اللهُ شرَّ ذلك اليومِ ويؤمِّنَهم منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"التذكرة للقرطبي 194","srcLabel":"إسحق","text":["إنَّ اللهَ تعالى لما فرغ من خلقِ السمواتِ والأرضِ خلق الصُّورَ وأعطاهُ إسرافيلَ فهو واضعُه على فيهِ شاخصٌ ببصرِه إلى العرشِ ينتظرُ متى يؤمَرُ فقال أبو هريرةَ قلت : يا رسولَ اللهِ وما الصُّورُ ؟ قال : قرنٌ فقلتُ : وكيفَ هوَ ؟ قال : هو عظيمٌ والذي نفسي بيدِه إنَّ عظمَ دارةٍ فيه لكعرضِ السماءِ والأرضِ فينفخُ فيه ثلاثُ نفخاتٍ الأولى ، نفخةُ الفزعِ ، والثانيةُ : نفخةُ الصعقِ ، والثالثةُ : نفخةُ القيامِ لربِّ العالمين ، يأمرُ اللهُ إسرافيلَ بالنفخةِ الأولى فيقولُ : انفخْ نفخةَ الفزعِ فيفزعُ أهلُ السماءِ والأرضِ إلا ما شاء اللهُ ويأمرهُ فيمدُّها ويديمُها ويطوِّلُها يقولُ اللهُ عزَّ وجلَّ : { وَمَا يَنْظُرُ هَؤُلَاءِ إِلَّا صَيْحَةً وَاحِدَةً مَا لَهَا مِنْ فَوَاقٍ } ويكونُ ذلك يومُ الجمعةِ في النصفِ من شهرِ رمضانَ فيسيِّرُ اللهُ الجبالَ فتمرُّ مرَّ السحابِ ، ثمَّ تكون سرابًا ثمَّ ترتجُّ الأرضُ بأهلِها رجًّا وهي التي يقولُ اللهُ عزَّ وجلَّ { يَوْمَ تَرْجُفُ الرَّاجِفَةُ . تَتْبَعُهَا الرَّادِفَةُ . قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌ } فتكونُ الأرضُ كالسفينةِ في البحرِ تضربُها الأمواجُ فيميدُ الناسُ على ظهرِها وتذهلُ المراضعُ وتضعُ الحواملُ ما في بطونِها ، وتشيبُ الولدانُ ، وتتطايرُ الشياطينُ هارِبةً ، حتَّى تأتيَ الأقطارَ فتتلقاها الملائكةُ هاربةً فتضربُ بها وجوهَها ويولِّي الناسُ مُدبِرين ينادي بعضُهم بعضًا وهي التي يقولُ اللهُ عزَّ وجلَّ { يَوْمَ التَّنَادِ (32) يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ } فبينما هم على ذلك إذ تصدَّعتِ الأرضُ من قُطرٍ إلى قُطرٍ ، ورأوْا أمرًا عظيمًا لم يروْا مثلَه فيأخذَهم من ذلك من الكربِ والهولِ ما اللهُ به عليمٌ ، ثمَّ ينظرونَ إلى السماءِ فإذا هي كالمُهلِ ثمَّ انشقتْ وانخسفَ شمسُها وقمرُها وانتثرتُ نجومُها ، ثمَّ كُشِطتِ السماءُ عنهم ، ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلم : والموتَى لا يعلمونَ شيئًا من ذلك قلتُ : يا رسولَ اللهِ فمن استثنَى اللهُ عزَّ وجلَّ ، حين يقولُ { فَفَزِعَ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ إِلَّا مَنْ شَاءَ اللَّهُ } ؟ قال : ",["أولئك هم الشهداءُ",1]," عند ربِّهم يُرزقونَ إنما يصلُ الفزعُ إلى الأحياءِ ، ",["يقيهمُ اللهُ شرَّ ذلك اليومِ ويؤمِّنَهم منه",2]," وهو عذابٌ يلقيهِ اللهُ على شرارِ خلقِه ، وهو الذي يقولُ اللهُ تعالى : { يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمْ إِنَّ زَلْزَلَةَ السَّاعَةِ شَيْءٌ عَظِيمٌ } أي شديدٌ فتمكثونَ في ذلك ما شاء اللهُ إلا أنه يطولُ عليهم كأطوَلِ يومٍ ، ثمَّ يأمرُ اللهُ إسرافيلَ فينفخُ نفخةَ الصعقِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه إسحق بن راهويه في ((المسند)) (10)، وابن أبي الدنيا في ((الأهوال)) (55)، وابن أبي حاتم في ((التفسير)) (18909) مطولاً باختلاف يسير","bab":"إيمان › الملائكة","dorar":"ftJ66CEz"},{"id":"س-04528","fp":"acbeff3a34a1","stateId":668,"easy":"إذا كنت من الشهداء ← لا تُصعق يوم النفخ","cause":"شُهداءُ اللهِ عزَّ وجلَّ","result":"الَّذين لمْ يَشأِ اللهُ أنْ يَصْعقَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الترغيب 1387","srcLabel":"الحاكم","text":["هم شهداءُ اللهِ [يعني حديث: عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، أنَّه سَأَلَ جِبريلَ عليه السَّلامُ عنْ هذه الآيَةِ: {وَنُفِخَ فِي الصُّورِ فَصَعِقَ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ إِلَّا مَنْ شَاءَ اللَّهُ} [الزمر: 68]. «مَنِ ",["الَّذين لمْ يَشأِ اللهُ أنْ يَصْعقَهم",2],"؟». قالَ: هُم ",["شُهداءُ اللهِ عزَّ وجلَّ",1],".]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (3000) مطولاً","bab":"جهاد › فضل الشهيد","dorar":"wgyEZhTB"},{"id":"س-07849","fp":"59351f6a5b34","stateId":668,"easy":"إذا أطعت أمراءك في المعروف ← فإثم ظلمهم عليهم وأنت منه بريء","cause":"وأُمِّرَتْ علينا أمراءَ فأَطَعْناهم","result":"فيقولُ : صَدَقْتُم هو عليهِم وأنتم منه بَراءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج كتاب السنة 1048","srcLabel":"الطبراني","text":["أَطِيعوا أمراءَكم مهما كان فإن أمروكم بشيءٍ مِمَّا جئتُكم به فإنهم يُؤْجَرُونَ عليه وتُؤْجَرُونَ عليه ذلك بأنكم إذا لَقِيتُم ربَّكم قلتم : ربَّنا لا ظُلْمَ فيقولُ : لا ظُلْمَ فيقولونَ : ربَّنا أَرْسَلْتَ إلينا رُسُلًا فأَطَعْناهم واستُخْلِفَتْ علينا خُلَفاءُ فأَطَعْناهم ",["وأُمِّرَتْ علينا أمراءَ فأَطَعْناهم",1]," ",["فيقولُ : صَدَقْتُم هو عليهِم وأنتم منه بَراءٌ",2]],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (1048) واللفظ له، والطبراني (20/278) (658)، والبيهقي (17069) باختلاف يسير.","bab":"قيامة › الحساب والقصاص","dorar":"BR8RctwP"},{"id":"س-01494","fp":"0bed3df73896","stateId":668,"easy":"إذا قرأت القرآن لله وأممت قوماً راضين ← لا يهولك الفزع الأكبر","cause":"رجلٌ قرأَ القرآنَ ابتغاءَ وجهِ اللَّهِ وأمَّ بِهِ قومًا وَهُم بِهِ راضونَ وداعٍ إلى الصَّلواتِ ابتغاءَ وجهِ اللَّهِ وعبدٌ أحسنَ فيما بينَهُ وبينَ ربِّهِ وفيما بينَهُ وبينَ مَواليهِ","result":"ثلاثةٌ لا يَهولُهُمُ الفزعُ الأَكْبرُ ولا يَنالُهُمُ الحسابُ هُم على كثبٍ من مسكٍ حتَّى يفرغَ مِن حسابِ الخلائقِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 1/146","srcLabel":"الترمذي","text":[["ثلاثةٌ لا يَهولُهُمُ الفزعُ الأَكْبرُ ولا يَنالُهُمُ الحسابُ هُم على كثبٍ من مسكٍ حتَّى يفرغَ مِن حسابِ الخلائقِ",2]," : ",["رجلٌ قرأَ القرآنَ ابتغاءَ وجهِ اللَّهِ وأمَّ بِهِ قومًا وَهُم بِهِ راضونَ وداعٍ إلى الصَّلواتِ ابتغاءَ وجهِ اللَّهِ وعبدٌ أحسنَ فيما بينَهُ وبينَ ربِّهِ وفيما بينَهُ وبينَ مَواليهِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الترمذي (1986)، وأحمد (4799) بنحوه، والطبراني في ((المعجم الصغير)) (1116) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"ecpOrCqY"},{"id":"س-07871","fp":"edcfd038b177","stateId":668,"easy":"إذا كنت مؤمناً ← لا يضرك حر الشمس يوم القيامة (أثر سلمان)","cause":"مؤمنًا ولا مؤمنةً","result":"ولا يضُرُّ حرُّها يومئذٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المواهب اللدنية 3/637","srcLabel":"المواهب اللدنية","text":["عن سَلْمانَ رَضي اللهُ عنه قال: تُعطى الشمسُ يومَ القيامةِ حَرَّ عَشْرِ سنينَ، ثمَّ تدْنو مِن جَماجمِ الرأسِ حتى تكونَ قابَ قوسينِ، فيَعرَقونَ حتى يَرشَحَ العرَقُ في الأرضِ قامةً، ثمَّ يَرتفِعَ حتى يُغَرْغِرَ الرجُلُ. زاد ابنُ المبارَكِ في روايتِه: ",["ولا يضُرُّ حرُّها يومئذٍ",2]," ",["مؤمنًا ولا مؤمنةً",1],"."],"grade":"حسن","muhaddith":"إسناده جيد","bab":"قيامة › الحساب والقصاص","dorar":"wKtFrMaK"},{"id":"س-06472","fp":"c680935e199e","stateId":669,"easy":"إذا أكملت صلاتك ← تُكتب لك كاملة","cause":"فإنْ كان أكمَلَها","result":"كُتِبَت له كامِلةً","explicit":true,"star":true,"similar":["س-06255"],"ref":"المستدرك على الصحيحين 982","srcLabel":"مسلم","text":["أوَّلُ ما يُحاسَبُ به العَبدُ يَومَ القِيامةِ صَلاتُه، ",["فإنْ كان أكمَلَها",1]," ",["كُتِبَت له كامِلةً",2],"، وإنْ لم يُكمِلْها قالَ اللهُ تَبارَكَ وتَعالَى لمَلائكَتِه: هل تَجِدون لعَبدي تَطَوُّعًا تُكمِلوا به ما ضَيَّع من فَريضَتِه؟ ثمَّ الزَّكاةُ مِثلُ ذلكَ، ثمَّ سائرُ الأعمالِ على حسَبِ ذلكَ."],"grade":"صحيح","narrator":"تميم الداري","muhaddith":"[إسناده صحيح على شرط مسلم]","bab":"صلاة › فرض الصلاة","dorar":"fXNlmdkM","merged":4,"otherRefs":["صحيح الجامع 2574 (صحيح)","صحيح النسائي 465 (صحيح)","تخريج مشكل الآثار 2552 (صحيح)"]},{"id":"س-06255","fp":"cd41272d7f7e","stateId":669,"easy":"إذا كانت صلاتك تامة ← تُكتب لك تامة","cause":"فإن كانت تامَّةً","result":"كُتِبت تامَّةً","explicit":true,"repOf":"س-06472","ref":"الترغيب والترهيب 1/187","text":["إنَّ أوَّلَ ما افتَرضَ اللَّهُ على النَّاسِ من دينِهِمُ الصَّلاةُ ، وآخرَ ما يبقى الصَّلاةُ ، وأوَّلَ ما يحاسبُ بِهِ الصَّلاةُ ، ويقولُ اللَّهُ انظُروا في صلاةِ عبدي . ",["فإن كانت تامَّةً",1]," ",["كُتِبت تامَّةً",2]," ، وإن كانت ناقصةً يقولُ : انظُروا هل لعبدي تطوُّعٍ ؟ فإن وُجِدَ لَهُ تطوُّعٌ تمَّتِ الفريضةُ منَ التَّطوُّعِ ، ثمَّ قالَ : انظُروا هل زَكاتُهُ تامَّةٌ ؟ فإن كانت تامَّةً كُتِبت تامَّةً ، وإن كانت ناقِصةً قالَ : انظروا هل لَهُ صدقةٌ ؟ فإن كانت لَهُ صدقة تمَّت له زَكاتُهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"nQR3w5rf"},{"id":"ق-1374","fp":"69b6453606d6","stateId":669,"easy":"اليقين بلقاء الحساب والعمل الصالح في الأيام الخالية ← الكتاب باليمين وعيشة راضية في جنة عالية","cause":"اليقين بلقاء الحساب والعمل الصالح في الأيام الخالية","result":"الكتاب باليمين وعيشة راضية في جنة عالية","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة الحاقة: 19–24","srcLabel":"القرآن الكريم","quran":{"s":69,"from":19,"to":24,"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَيَقُولُ هَاؤُمُ اقْرَءُوا كِتَابِيَهْ (19) إِنِّي ظَنَنْتُ أَنِّي مُلَاقٍ حِسَابِيَهْ (20) فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ (21) فِي جَنَّةٍ عَالِيَةٍ (22) قُطُوفُهَا دَانِيَةٌ (23) كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا أَسْلَفْتُمْ فِي الْأَيَّامِ الْخَالِيَةِ (24)","hl":[[0,83,2],[83,137,1],[137,251,2],[251,299,1]]}},{"id":"ق-1423","fp":"09b6e42a893f","stateId":669,"easy":"الإيمان والعمل الصالح ← الكتاب باليمين والحساب اليسير والانقلاب إلى الأهل مسروراً","cause":"الإيمان والعمل الصالح","result":"الكتاب باليمين والحساب اليسير والانقلاب إلى الأهل مسروراً","explicit":true,"ref":"سورة الانشقاق: 7–9","srcLabel":"القرآن الكريم","quran":{"s":84,"from":7,"to":9,"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ (7) فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا (8) وَيَنْقَلِبُ إِلَى أَهْلِهِ مَسْرُورًا (9)","hl":[[0,14,1],[14,127,2]]}},{"id":"س-00699","fp":"2af086cf27dd","stateId":669,"easy":"إذا أكثرت الاستغفار ← تسرك صحيفتك","cause":"فَلْيُكْثِرْ فيها من الاستغفارِ","result":"مَن أَحَبَّ أن تَسُرَّه صحيفتُه","explicit":true,"otherNeedIds":[11],"ref":"صحيح الجامع 5955","srcLabel":"الطبراني","text":[["مَن أَحَبَّ أن تَسُرَّه صحيفتُه ، ",2],["فَلْيُكْثِرْ فيها من الاستغفارِ",1]],"grade":"صحيح","narrator":"الزبير بن العوام","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (839)، والبيهقي في ((شعب الإيمان)) (648)، والضياء في ((الأحاديث المختارة)) (892)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"n1r6f5mD"},{"id":"س-04173","fp":"88100089e84b","stateId":669,"easy":"إذا بلغت الثمانين من هذه الأمة (صالحاً) ← لم تُعرض ولم تُحاسب","cause":"مَنْ بَلَغَ الثَّمانِينَ من هذه الأُمَّةِ","result":"لمْ يُعْرَضْ ، ولمْ يُحاسَبْ","explicit":true,"ref":"الفتح الرباني 11/5364","srcLabel":"ابن عدي","text":[["مَنْ بَلَغَ الثَّمانِينَ من هذه الأُمَّةِ",1]," ",["لمْ يُعْرَضْ ، ولمْ يُحاسَبْ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/354)، والدارقطني في ((العلل)) (15/113)، وأبو نعيم في ((حلية الأولياء)) (8/215) مطولاً","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"S8SbInDj"},{"id":"س-03520","fp":"542547bbc513","stateId":669,"easy":"إذا نوقشت بالعرض اليسير ← يُتجاوز عنك","cause":"يُنظَرُ في كِتابِهِ","result":"ويُتَجاوَزُ عنه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03522","otherNeedIds":[11],"ref":"المستدرك على الصحيحين 191","text":["عنْ عائشةَ قالتْ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ في بَعْضِ صَلاتِهِ: «اللَّهُمَّ حاسِبْني حِسابًا يَسيرًا». فلمَّا انصَرَفَ قُلتُ: يا رسولَ اللهِ، ما الحِسابُ اليَسيُر؟ قالَ: «",["يُنظَرُ في كِتابِهِ",1]," ",["ويُتَجاوَزُ عنه",2],"؛ إنَّه مَنْ نُوقِشَ الحِسابَ يَوْمَئذٍ يا عائشةُ هَلَكَ، وكُلُّ ما يُصيبُ المؤمنَ يُكَفِّرُ اللهُ عنه حتَّى الشَّوْكةُ تَشوكُهُ»."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (24215)، وابن خزيمة (849) بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"dPGGB2l8"},{"id":"س-03522","fp":"5facf4c35c86","stateId":669,"easy":"إذا دعوت «اللهم حاسبني حساباً يسيراً» ← يُنظر في سيئاتك ويُتجاوز عنها","cause":"أنْ يَنظُرَ في سيِّئاتِه","result":"ويَتجاوَزَ له عنها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"say","t":"«اللهم حاسبني حساباً يسيراً»"},"similar":["س-03520"],"otherNeedIds":[11],"ref":"المستدرك على الصحيحين 8953","srcLabel":"مسلم","text":["اللَّهمَّ حاسِبْني حِسابًا يَسيرًا، قال: فقُلتُ: يا رَسولَ اللهِ، ما الحِسابُ اليسيرُ؟ قال: ",["أنْ يَنظُرَ في سيِّئاتِه",1]," ",["ويَتجاوَزَ له عنها",2],"، إنَّه مَن نُوقِشَ الحسابَ يومئذٍ هَلَك، وكلُّ ما يُصِيبُ المؤمنَ يُكفِّرُ اللهُ عنه مِن سيِّئاتِه، حتَّى الشَّوكةِ تَشُوكُه."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح على شرط مسلم","bab":"استغفار › مكفرات الذنوب","dorar":"kJfOjt6A"},{"id":"س-02102","fp":"7404384c043a","stateId":669,"easy":"إذا عملت البر ← فقد أعددت للمسائل جواباً","cause":"أعمالُ البرِّ","result":"فأعِدُّوا للمسائلِ جوابًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الدر المنثور 6/319","srcLabel":"النسائي","text":["كلُّكم راعٍ وَكلُّكم مسؤولٌ عن رعيَّتِهِ ",["فأعِدُّوا للمسائلِ جوابًا",2]," قالوا وما جوابُها قالَ ",["أعمالُ البرِّ",1]],"grade":"صحيح","narrator":"أنس","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (3576)، وأبو نعيم في ((فضيلة العادلين)) (6) بلفظه مطولًا، والنسائي في ((الكبرى)) (9129) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Q6jXpI5r"},{"id":"س-06117","fp":"0bda41079034","stateId":669,"easy":"إذا أعطيت من حرمك وعفوت عمن ظلمك ووصلت من قطعك ← يحاسبك الله حساباً يسيراً ويدخلك الجنة","cause":"تُعطي مَنْ حَرمَكَ، وتَعْفو عمَّنْ ظلمَكَ، وتَصِلُ مَنْ قَطعَكَ","result":"حاسَبَهُ اللهُ حسابًا يَسيرًا وأدْخلَهُ الجنَّةَ برحمتِهِ","explicit":true,"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 3960","srcLabel":"الطبراني","text":["«ثلاثٌ مَنْ كُنَّ فيه ",["حاسَبَهُ اللهُ حسابًا يَسيرًا وأدْخلَهُ الجنَّةَ برحمتِهِ",2],"». قالوا: لِمَنْ يا رسولَ اللهِ؟ قالَ: «",["تُعطي مَنْ حَرمَكَ، وتَعْفو عمَّنْ ظلمَكَ، وتَصِلُ مَنْ قَطعَكَ",1],"». قالَ: فإذا فَعلتُ ذلك، فما لي يا رسولَ اللهِ؟ قالَ: «أنْ تُحاسَبَ حِسابًا يَسيرًا، ويُدخِلَكَ اللهُ الجنَّةَ برحمتِهِ»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي (21132) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (909)، والبزار (8635) بنحوه","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"eNSwcDve"},{"id":"س-06974","fp":"d5ff9d186d15","stateId":670,"easy":"إذا عدلت في حكمك وأهلك وما وليت ← تكون على منابر من نور عن يمين الرحمن","cause":"الَّذِينَ يَعْدِلُونَ في حُكْمِهِمْ وأَهْلِيهِمْ وما وَلُوا","result":"إنَّ المُقْسِطِينَ عِنْدَ اللهِ علَى مَنابِرَ مِن نُورٍ، عن يَمِينِ الرَّحْمَنِ","explicit":true,"star":true,"similar":["س-01911"],"ref":"تأويل مختلف الحديث 397","srcLabel":"مسلم","text":["إنَّ كلتي يديهِ يمينٌ [يعني حديث: ",["إنَّ المُقْسِطِينَ عِنْدَ اللهِ علَى مَنابِرَ مِن نُورٍ، عن يَمِينِ الرَّحْمَنِ",2]," عزَّ وجلَّ -وكِلْتا يَدَيْهِ يَمِينٌ- ",["الَّذِينَ يَعْدِلُونَ في حُكْمِهِمْ وأَهْلِيهِمْ وما وَلُوا",1],".]"],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1827)، والنسائي (5379)، وأحمد (6492) واللفظ لهم.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"X8U0pCps","merged":3,"otherRefs":["المستدرك على الصحيحين 7201 (صحيح)","صحيح الجامع 1953 (صحيح)"]},{"id":"س-01911","fp":"cdaf543a6d3c","stateId":670,"easy":"إذا عدلت في حكمك وأهلك وما وليت ← تكون على منابر من نور على يمين العرش","cause":"الَّذينَ يعدِلونَ في حُكمِهم وأَهاليهم وما وُلُّوا","result":"المقسِطونَ على منابرَ من نورٍ على يمينِ العرشِ","explicit":true,"repOf":"س-06974","ref":"تفسير القرآن العظيم 8/117","text":[["المقسِطونَ على منابرَ من نورٍ على يمينِ العرشِ",2]," ",["الَّذينَ يعدِلونَ في حُكمِهم وأَهاليهم وما وُلُّوا",1]],"grade":"صحيح","narrator":"[عبدالله بن عمرو]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1827) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"s5G5VBZY"},{"id":"س-08380","fp":"c7d7f09111e8","stateId":670,"easy":"إذا تحاببت في الله ← لك منابر من نور يوم القيامة","cause":"المُتحابُّون في اللهِ","result":"لهم مَنابرُ مِن نُورٍ يَومَ القيامةِ","explicit":true,"repOf":"س-08437","otherNeedIds":[15,6,26],"ref":"المستدرك على الصحيحين 8516","text":["عن الحارثِ بنِ عَمِيرةَ، قال: قَدِمتُ مِنَ الشَّامِ إلى المدينةِ في طلَبِ العلمِ، فسَمِعتُ مُعاذَ بنَ جبَلٍ رَضيَ اللهُ عنه يَقولُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["المُتحابُّون في اللهِ",1]," ",["لهم مَنابرُ مِن نُورٍ يَومَ القيامةِ",2],"، يَغبِطُهم الشُّهداءُ. فأقمْتُ معه فذكَرْتُ له الشَّامَ وأهْلَها وأشعارَها، فتَجهَّزَ إلى الشَّامِ فخرَجْتُ معه، فسَمِعتُه يَقولُ لعَمرِو بنِ العاصِ رَضيَ اللهُ عنهُما: لَقدْ صَحِبتَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ وأنتَ أضلُّ مِن حمارِ أهْلِه، فأصاب ابنَه الطَّاعونُ وامرأتَه، فَماتا جَميعًا، فحَفَر لهما قبْرًا واحدًا، فدُفِنا، ثمَّ رَجَعْنا إلى مُعاذٍ وهو ثَقيلٌ، فبَكَيْنا حوْلَه، فقال: إنْ كُنتم تَبْكُون على العلمِ فهذا كتابُ اللهِ بيْن أظْهرِكم، فاتَّبِعوه، فإنْ أشْكَلَ عليكم شَيءٌ مِن تَفسيرِه فعليكمْ بهؤلاء الثَّلاثةِ: عُوَيمرٍ أبي الدَّرداءِ، وابنِ أُمِّ عبْدٍ، وسَلْمانَ الفارسيِّ، وإيَّاكم وزَلَّةَ العالِمِ، وجدَلَ المنافِقِ. فأقَمْتُ شَهرًا، ثمَّ خرَجْتُ إلى العراقِ، فأتَيْتُ ابنَ مَسعودٍ رَضيَ اللهُ عنه، فقال: نِعمَ الحيُّ أهلُ الشَّامِ لوْلا أنَّهم يَشْهَدون على أنفُسِهم بالنَّجاةِ، قُلتُ: صدَقَ مُعاذٌ، قال: وما قال؟ قُلتُ: أوْصاني بكَ، وبعُوَيمرٍ أبي الدَّرداءِ، وسَلْمانَ الفارسيِّ، وقال: وإيَّاكم وزَلَّةَ العالِمِ، وجدَلَ المنافِقِ، ثمَّ تَنحَّيْتُ، فقال لي: يا ابنَ أخي، إنَّما كانت زلَّةً منِّي، فأقَمْتُ عنده شَهرًا، ثمَّ أتَيتُ سَلْمانَ الفارسيَّ، فسَمِعتُه يَقولُ: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ الأرواحَ جُنودٌ مُجنَّدةٌ؛ فما تَعارَفَ منها ائْتَلَف، وما تَناكَرَ منها اختَلَف، فأقمتُ عنده شَهرًا يَقسِمُ اللَّيلَ، ويَقسِمُ النَّهارَ بيْنه وبيْن خادمَه."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"لم نقف عليه إلا عند الحاكم في ((مستدركه)) (8296).","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"X2YfaIyJ","merged":8,"otherRefs":["تخريج المسند لشعيب 22064 (صحيح)","صحيح الترغيب 3027 (صحيح)","الجامع الصغير 9148 (صحيح)","المستدرك على الصحيحين 7524 (صحيح)","تخريج الإحياء للعراقي 2/198 (حسن)","العلو للذهبي 100 (حسن)","تخريج سنن أبي داود 3527 (صحيح)"]},{"id":"س-08437","fp":"1b2baf497237","stateId":670,"easy":"إذا تحاببت في جلال الله ← لك منابر من نور يغبطك عليها النبيون والشهداء","cause":"المُتحابُّونَ في جَلالي","result":"لهم مَنابرُ مِن نورٍ يَغبِطُهم النَّبيُّونَ والشُّهَداءُ","explicit":true,"similar":["س-08380","س-01105","س-06896"],"ref":"تخريج المسند لشعيب 22080","srcLabel":"الترمذي","text":["دَخَلتُ مسجدَ حِمصَ فإذا فيه نحوٌ مِن ثلاثينَ كَهلًا مِن أصحابِ النَّبيِّ صَلَّى اللهُ عليه وسلَّمَ، فإذا فيهم شابٌّ أكحلُ العَينَينِ، بَرَّاقُ الثَّنايا، ساكتٌ، فإذا امتَرى القَومُ في شيءٍ أقبَلوا عليه فسَأَلوه، فقُلتُ لجَليسٍ لي: مَن هذا؟ قال: هذا مُعاذُ بنُ جَبلٍ، فوَقَعَ له في نَفْسي حُبٌّ، فكنتُ معهم حتى تَفرَّقوا، ثُمَّ هَجَّرتُ إلى المسجدِ، فإذا مُعاذُ بنُ جَبلٍ قائمٌ يُصلِّي إلى ساريةٍ، فسَكَتَ لا يُكلِّمُني فصَلَّيتُ، ثُمَّ جَلَستُ فاحتَبَيتُ برِدائي، ثُمَّ جَلَسَ فسَكَتَ لا يُكلِّمُني، وسَكَتُّ لا أُكلِّمُه، ثُمَّ قُلتُ: واللهِ إنِّي لأُحِبُّكَ، قال: فيمَ تُحِبُّني؟ قال: قُلتُ: في اللهِ تَبارَكَ وتَعالى، فأخَذَ بحُبوَتي فجَرَّني إليه هُنيَّةً، ثُمَّ قال: أبشِرْ إنْ كنتَ صادقًا؛ سَمِعتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: ",["المُتحابُّونَ في جَلالي ",1],["لهم مَنابرُ مِن نورٍ يَغبِطُهم النَّبيُّونَ والشُّهَداءُ",2],"، قال: فخَرَجتُ فلَقيتُ عُبادةَ بنَ الصَّامتِ فقُلتُ: يا أبا الوَليدِ، ألَا أُحدِّثُكَ بما حَدَّثَني مُعاذُ بنُ جَبلٍ في المُتحابِّينَ؟ قال: فأنا أُحدِّثُكَ عن النَّبيِّ صَلَّى اللهُ عليه وسلَّمَ يَرفَعُه إلى الرَّبِّ عزَّ وجلَّ، قال: حَقَّتْ مَحبَّتي للمُتحابِّينَ فيَّ، وحَقَّتْ مَحبَّتي للمُتزاوِرينَ فيَّ، وحَقَّتْ مَحبَّتي للمُتباذِلينَ فيَّ، وحَقَّتْ مَحبَّتي للمُتواصِلينَ فيَّ."],"grade":"صحيح","narrator":"معاذ بن جبل وعبادة بن الصامت","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2390) مختصراً، وأحمد (22080) واللفظ له","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"OfEDrLaj","merged":3,"otherRefs":["الأحاديث المختارة 8 / 312 (صحيح)","هداية الرواة 4939 (صحيح)"]},{"id":"س-01105","fp":"36d8a9e27655","stateId":670,"easy":"إذا تحاببت في الله مع أناس من قبائل وبلاد شتى تجتمعون على ذكره ← يبعثك الله يوم القيامة وفي وجهك النور على منابر من لؤلؤ","cause":"همُ المتحابُّونَ في اللهِ ، مِن قبائلَ شتَّى ، وبلادٍ شتَّى ، يجتَمِعونَ على ذِكرِ اللهِ يَذكرونَه","result":"ليبعثَنَّ اللهُ أقوامًا يومَ القيامةِ في وُجوهِهِمُ النُّورُ ، علَى منابرِ اللُّؤلؤِ ، يغبِطُهُمُ النَّاسُ","explicit":true,"repOf":"س-08437","ref":"صحيح الترغيب 1509","text":[["ليبعثَنَّ اللهُ أقوامًا يومَ القيامةِ في وُجوهِهِمُ النُّورُ ، علَى منابرِ اللُّؤلؤِ ، يغبِطُهُمُ النَّاسُ",2]," ، لَيسوا بأنبياءَ ولاشُهداءَ . قال : فَجثَا أعرابيٌّ على رُكبتَيْهِ ؛ فقالَ : يا رسولَ اللهِ ! جَلِّهِم لنا نَعرِفْهمْ . قال : ",["همُ المتحابُّونَ في اللهِ ، مِن قبائلَ شتَّى ، وبلادٍ شتَّى ، يجتَمِعونَ على ذِكرِ اللهِ يَذكرونَه",1]," ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (2/262)","bab":"أدعية وأذكار › فضل الذكر","dorar":"IlkUd9Ah"},{"id":"س-06896","fp":"05fd8dbf314a","stateId":670,"easy":"إذا تحاببت بجلال الله ← تكون من جلساء الله يوم القيامة عن يمين العرش","cause":"هُم المُتحابُّونَ بجلالِ اللهِ تباركَ وتعالى","result":"إنَّ للهِ جُلَسَاءَ يومَ القيامةِ عن يمينِ العرشِ ، وكِلْتَا يدَي اللهِ يمينٌ ، على منابرٍ مِن نورٍ ، وجوهُهُم مِن نورٍ","explicit":true,"repOf":"س-08437","otherNeedIds":[26],"ref":"صحيح الترغيب 3022","text":[["إنَّ للهِ جُلَسَاءَ يومَ القيامةِ عن يمينِ العرشِ ، وكِلْتَا يدَي اللهِ يمينٌ ، على منابرٍ مِن نورٍ ، وجوهُهُم مِن نورٍ",2]," ، لَيسوا بأنبياءَ ولا شُهداءَ ولا صدِّيقينَ قيلَ : يا رسولَ اللهِ ! مَن هُم ؟ قال : ",["هُم المُتحابُّونَ بجلالِ اللهِ تباركَ وتعالى",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (12/134) (12686)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"6U1CmRiL"},{"id":"س-06846","fp":"b2e9c3b84ed0","stateId":670,"easy":"إذا اجتمعت على ذكر الله تنتقي أطايب الكلام ← تكون عن يمين الرحمن يوم القيامة","cause":"يجتَمِعونَ علَى ذِكرِ اللَّهِ فينتَقونَ أطايِبَ الكلامِ كما يَنتقي آكِلُ التَّمرِ أطايِبَهُ","result":"عَن يمينِ الرَّحمنِ ، وَكِلتا يدَيهِ يمينٌ رجالٌ لَيسوا بأنبياءَ ولا شُهداءَ ، يَغشَى بياضُ وجوهِهِم نظرَ النَّاظرينَ يغبِطُهم النَّبيُّونَ والشُّهَداءُ بمقعَدِهِم وقُربِهِم من اللَّهِ","explicit":true,"otherNeedIds":[26],"ref":"البدور السافرة 106","srcLabel":"الطبراني","text":[["عَن يمينِ الرَّحمنِ ، وَكِلتا يدَيهِ يمينٌ رجالٌ لَيسوا بأنبياءَ ولا شُهداءَ ، يَغشَى بياضُ وجوهِهِم نظرَ النَّاظرينَ يغبِطُهم النَّبيُّونَ والشُّهَداءُ بمقعَدِهِم وقُربِهِم من اللَّهِ",2]," قيلَ مَن هُم يا رَسولَ اللَّهِ ؟ قالَ : هُم جُمَّاعٌ من نُزَّاعِ القَبائلِ ",["يجتَمِعونَ علَى ذِكرِ اللَّهِ فينتَقونَ أطايِبَ الكلامِ كما يَنتقي  آكِلُ التَّمرِ أطايِبَهُ",1]],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني كما في ((الترغيب والترهيب)) للمنذري (2/261)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"ssYCFFFs"},{"id":"س-07175","fp":"bdb0f33383ae","stateId":670,"easy":"إذا تحاببت في الله ← يغبطك الأنبياء والشهداء","cause":"قومٌ تحابُّوا برُوحِ اللهِ تبارك وتعالى","result":"فإنَّ الشُّهَداءَ والأنبياءَ لَيَغبِطونَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[47,6],"ref":"الضعفاء الكبير 3/166","srcLabel":"النسائي","text":["إنِّي لأعرِفُ ناسًا ما هم بشُهَداءَ ولا أنبياءَ، ",["فإنَّ الشُّهَداءَ والأنبياءَ لَيَغبِطونَهم",2]," بمنان لهم، قيل: مَن هم يا رَسولَ اللهِ؟ قال: ",["قومٌ تحابُّوا برُوحِ اللهِ تبارك وتعالى",1]," على غيرِ مالٍ تعاطَوه، ولا نَسَبٍ قَريبٍ تواصَلوا، والذي نفسي بيَدِه ما يَحزَنونَ إذا حَزِنوا، ولا يَفرَحونَ إذا فَرِحوا، وإنَّهم لنُورٌ على نُورٍ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"يروى من غير هذا الوجه بإسناد صالح","takhrij":"أخرجه النسائي في ((الكبرى)) (11172)، وابن حبان (573)، وأبو يعلى (6110) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"yLrXRQSp"},{"id":"س-04421","fp":"02b19557917a","stateId":671,"easy":"إذا جُرحت في سبيل الله ← تأتي يوم القيامة كهيئته يوم جُرحت لونه لون الدم","cause":"ما مِن كَلْمٍ يُكْلَمُ في سَبيلِ اللهِ","result":"إلَّا جاء يَوْمَ القِيامةِ كهَيْئَتِه يَوْمَ كُلِم، لَوْنُه لَوْنُ دمٍ، ورِيـحُه ريحُ مِسكٍ","explicit":true,"star":true,"similar":["س-01768","س-02121","س-02883","س-04706","س-04740","س-01973","س-04460","س-08084","س-08085","س-08087"],"ref":"تخريج المسند لشعيب 7157","srcLabel":"متفق عليه","text":["انتَدَبَ اللهُ عزَّ وجلَّ لـمَن خرَجَ في سبيلِه، لا يَـخْرُجُ إلا جِهادًا في سَبِيلي، وإيمانًا بي، وتصديق رسولي ؛ فهو عَلَيَّ ضامِنٌ أنْ أُدْخِلَه الجنةَ، أو أُرْجِعَه إلى مَسْكنِه الذي خرَجَ منه، نَائِلًا ما نالَ مِن أَجْرٍ أو غَنيمَةٍ، والذي نَفْسُ محمدٍ بِيَدِه، ",["ما مِن كَلْمٍ يُكْلَمُ في سَبيلِ اللهِ",1]," ",["إلَّا جاء يَوْمَ القِيامةِ كهَيْئَتِه يَوْمَ كُلِم، لَوْنُه لَوْنُ دمٍ، ورِيـحُه ريحُ مِسكٍ",2],". والذي نَفْسُ محمدٍ بِيَدِه، لَوْلا أنْ أَشُقَّ على المُسلِمين ما قعَدْتُ خِلافَ سَرِيَّةٍ تَغْزو في سَبيلِ اللهِ أَبَدًا، ولكنِّي لا أَجِدُ سَعَةً فيَتْبَعوني، ولا تَطِيبُ أَنْفُسُهم فيَتَخَلَّفون بَعْدِي، والذي نَفْسُ محمدٍ بِيَدِه، لَوَدِدْتُ أنْ  أَغزُوَ في سبيلِ اللهِ فأُقتَلَ، ثم أَغزُوَ فأُقتَلَ، ثم أَغزُوَ فأُقتَلَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (36)، ومسلم (1876) باختلاف يسير","bab":"جهاد › النية في القتال والغزو","dorar":"xIpjl4MF","merged":4,"otherRefs":["تخريج المسند لشعيب 10870 (صحيح)","صحيح النسائي 3148 (صحيح)","الأحاديث المختارة 9 / 116 (صحيح)"]},{"id":"س-01768","fp":"4a1ce3156833","stateId":671,"easy":"إذا جُرحت في سبيل الله ← تأتي يوم القيامة وجرحك يتفجر دماً لونه لون الدم وريحه ريح المسك","cause":"كُلُّ كَلْمٍ يُكلَمُه المُسلِمُ في سَبيلِ اللهِ","result":"ثُمَّ تَكونُ يَومَ القيامةِ كَهَيئَتِها إذا طُعِنَت، تَفَجَّرُ دَمًا، اللَّونُ لَونُ دَمٍ، والعَرفُ عَرفُ المِسكِ","explicit":true,"repOf":"س-04421","ref":"صحيح مسلم 1876","text":[["كُلُّ كَلْمٍ يُكلَمُه المُسلِمُ في سَبيلِ اللهِ",1],"، ",["ثُمَّ تَكونُ يَومَ القيامةِ كَهَيئَتِها إذا طُعِنَت، تَفَجَّرُ دَمًا، اللَّونُ لَونُ دَمٍ، والعَرفُ عَرفُ المِسكِ",2],". وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: والذي نَفسُ مُحَمَّدٍ في يَدِه، لَولا أن أشُقَّ على المُؤمِنينَ ما قَعَدتُ خَلفَ سَريَّةٍ تَغزو في سَبيلِ اللهِ، ولَكِن لا أجِدُ سَعةً فأحمِلَهم، ولا يَجِدونَ سَعةً فيَتَّبِعوني، ولا تَطيبُ أنفُسُهم أن يَقعُدوا بَعدي."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (237)، ومسلم (1876).","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"P7PnRuvF"},{"id":"س-02121","fp":"e53dc4ef3371","stateId":671,"easy":"إذا جُرحت في سبيل الله ← تأتي يوم القيامة وجرحك يثعب دماً وريحه المسك","cause":"لا يُكْلَمُ أَحَدٌ في سبيلِ اللهِ، واللهُ أَعلمُ بِـمَن يُكْلَمُ في سَبيلِه","result":"إلا جاء يَوْمَ القيامةِ والـجُرْحُ يَثْعَبُ دَمًا، اللَّوْنُ لَوْنُ دَمٍ، والرِّيحُ رِيحُ مِسْكٍ، وأَفْرَدَه سُفيانُ مرَّةً عن أَبِي الزِّنادِ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 7302","text":[["لا يُكْلَمُ أَحَدٌ في سبيلِ اللهِ، واللهُ أَعلمُ بِـمَن يُكْلَمُ في سَبيلِه،",1]," ",["إلا جاء يَوْمَ القيامةِ والـجُرْحُ يَثْعَبُ دَمًا، اللَّوْنُ لَوْنُ دَمٍ، والرِّيحُ رِيحُ مِسْكٍ، وأَفْرَدَه سُفيانُ مرَّةً عن أَبِي الزِّنادِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده من طريق أبي الزناد صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2803)، ومسلم (1876)، والترمذي (1656)، والنسائي (3147)، وابن ماجه (2795)، وأحمد (7302) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DI6n6MRf"},{"id":"س-02883","fp":"2a754cbfd033","stateId":671,"easy":"إذا جُرحت في سبيل الله ← يأتي جرحك لونه الدم وريحه المسك","cause":"مَن يُكلَمُ في سَبيلِ اللهِ، واللهُ أعلَمُ بمَن يُكلَمُ في سَبيلِهِ","result":"يَأْتي الجُرحُ لَونُهُ لَونُ الدَّمِ، ورِيحُهُ رِيحُ المِسكِ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 9189","text":["نَحوَ هذا الحَديثِ. [أي حديثَ: ",["مَن يُكلَمُ في سَبيلِ اللهِ، واللهُ أعلَمُ بمَن يُكلَمُ في سَبيلِهِ، ",1],["يَأْتي الجُرحُ لَونُهُ لَونُ الدَّمِ، ورِيحُهُ رِيحُ المِسكِ",2],"]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2803)، ومسلم (1876)، والترمذي (1656)، والنسائي (3147)، وابن ماجه (2795)، وأحمد (9189) واللفظ له","bab":"إيمان › الوعد","dorar":"zDmiXRM4"},{"id":"س-04706","fp":"9af255a463df","stateId":671,"easy":"إذا جُرحت في الله ← تأتي يوم القيامة وجرحك يدمى لونه الدم وريحه المسك","cause":"ما مِنْ مَكْلومٍ يُكْلَمُ في اللهِ","result":"إلَّا جاءَ يومَ القيامَةِ وكَلْمُهُ يُدْمِي ، اللونُ لونُ الدَّمِ ، والريحُ ريحُ المسْكِ","explicit":true,"repOf":"س-04421","ref":"صحيح الجامع 5783","text":[["ما مِنْ مَكْلومٍ يُكْلَمُ في اللهِ ،",1]," ",["إلَّا جاءَ يومَ القيامَةِ وكَلْمُهُ يُدْمِي ، اللونُ لونُ الدَّمِ ، والريحُ ريحُ المسْكِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5533) واللفظ له، ومسلم (1876)","bab":"رقائق وزهد › الإخلاص","dorar":"6tPNz7vH"},{"id":"س-04740","fp":"6cf733e3d4d1","stateId":671,"easy":"إذا جُرحت في سبيل الله ← تأتي يوم القيامة وجرحك كهيئته يوم جُرحت","cause":"ما مِن مَجروحٍ يُجرَحُ في سَبيلِ اللهِ، واللهُ أعلَمُ بمَن يُجرَحُ في سَبيلِه","result":"إلَّا جاءَ يَومَ القيامةِ والجُرحُ كهَيئَتِهِ يَومَ جُرِحَ، اللَّونُ لَونُ دَمٍ، والرِّيحُ رِيحُ مِسكٍ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 10740","text":[["ما مِن مَجروحٍ يُجرَحُ في سَبيلِ اللهِ، واللهُ أعلَمُ بمَن يُجرَحُ في سَبيلِه،",1]," ",["إلَّا جاءَ يَومَ القيامةِ والجُرحُ كهَيئَتِهِ يَومَ جُرِحَ، اللَّونُ لَونُ دَمٍ، والرِّيحُ رِيحُ مِسكٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5533)، ومسلم (1876) بنحوه","bab":"رقائق وزهد › الإخلاص","dorar":"mj1g8uMf"},{"id":"ق-0757","fp":"61a62ae5cc62","stateId":671,"easy":"التقوى ← الحشر إلى الرحمن وفداً","cause":"التقوى","result":"الحشر إلى الرحمن وفداً","explicit":true,"ref":"سورة مريم: 85","srcLabel":"القرآن الكريم","quran":{"s":19,"from":85,"to":85,"text":"يَوْمَ نَحْشُرُ الْمُتَّقِينَ إِلَى الرَّحْمَنِ وَفْدًا (85)","hl":[[0,15,2],[15,30,1],[30,55,2]]}},{"id":"س-05034","fp":"e41dc7219717","stateId":671,"easy":"إذا اتقيت وبررت وصدقت في تجارتك ← لا تُبعث مع الفجار","cause":"مَنِ اتَّقى وبرَّ وصدقَ","result":"إنَّ التُّجَّارِ يُبعثون يومَ القيامةِ فُجَّارًا إلا","explicit":true,"otherNeedIds":[53,1],"ref":"مسند علي 48","srcLabel":"الترمذي","text":["خرجنا مع رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إلى المصلَّى بالمدينةِ بُكرةً وبه ناسٌ منَ التُّجارِ وكانوا يُسمَّونَ السماسرةَ فإذا هم يتبايعون فناداهم يا معشرَ التُّجارِ فلما رفعوا إليه أبصارَهم ومدُّوا إليه أعناقَهم واشرأَبُّوا ولهَوا عما في أيديهم قال ألا ",["إنَّ التُّجَّارِ يُبعثون يومَ القيامةِ فُجَّارًا إلا",2]," ",["مَنِ اتَّقى وبرَّ وصدقَ",1]],"grade":"صحيح","narrator":"رفاعة بن رافع","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1210)، وابن ماجه (2146)، والدارمي (2580)، وابن حبان (4910) جميعا باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"KDKpisQY","merged":5,"otherRefs":["مسند علي 47 (صحيح)","اللآلئ المصنوعة 2/141 (صحيح)","المستدرك على الصحيحين 2176 (صحيح)","تخريج مشكل الآثار 2083 (صحيح)"]},{"id":"س-07320","fp":"c98ea9fd2fe9","stateId":671,"easy":"إذا كنت مؤمناً ← تُوضع لك يوم القيامة كراسي من نور وتُظلل بالغمام","cause":"فأينَ المُؤمِنونَ يومَئذٍ","result":"يُوضَعُ لهم كراسِيُّ مِن نورٍ وتُظلَّلُ عليهم الغَمامُ يكونُ ذلكَ اليومُ أقصَرَ على المُؤمِنينَ مِن ساعةٍ مِن نهارٍ","explicit":true,"ref":"صحيح ابن حبان 7419","srcLabel":"الطبراني","text":["تجتمِعونَ يومَ القيامةِ فيُقالُ : أينَ فُقَراءُ هذه الأُمَّةِ ومساكينُها ؟ قال : فيقومونَ فيُقالُ لهم : ماذا عمِلْتُم ؟ فيقولونَ : ربَّنا ابتَلَيْتَنا فصبَرْنا وآتَيْتَ الأموالَ والسُّلطانَ غيرَنا فيقولُ اللهُ : صدَقْتُم قال : فيدخُلونَ الجنَّةَ قبْلَ النَّاسِ ويَبقى شِدَّةُ الحِسابِ على ذوي الأموالِ والسُّلطانِ ) قالوا : ",["فأينَ المُؤمِنونَ يومَئذٍ",1]," ؟ قال : ( ",["يُوضَعُ لهم كراسِيُّ مِن نورٍ وتُظلَّلُ عليهم الغَمامُ يكونُ ذلكَ اليومُ أقصَرَ على المُؤمِنينَ مِن ساعةٍ مِن نهارٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطبراني (13/553) (14445)، وأبو نعيم في ((حلية الأولياء)) (7/206) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"canpDkxD","merged":4,"otherRefs":["البدور السافرة 92 (حسن)","تمهيد الفرش 128 (صحيح)","عمدة القاري 23/171 (حسن)"]},{"id":"س-01077","fp":"4570ac769a71","stateId":671,"easy":"إذا قلت صباحاً ومساءً «رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» ← كان حقاً على الله أن يرضيك يوم القيامة","cause":"ما مِن عَبدٍ يقولُ حين يُمسي ويُصبِحُ: رَضيتُ باللهِ ربًّا، وبالإسلامِ دينًا، وبمحمَّدٍ نبيًّا","result":"إلَّا كان حقًّا على اللهِ أنْ يُرضيَهُ يومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» · الوقت: صباحاً ومساءً"},"similar":["س-00974","س-00975","س-08352"],"otherNeedIds":[5],"ref":"المستدرك على الصحيحين 1929","srcLabel":"أبو داود","text":["عنْ أَبي سلَّامٍ، قالَ: كنَّا جُلوسًا في مسجدِ حِمصَ، فمَرَّ رَجلٌ فقالوا: هذا خَدَمَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فنَهضتُ إليه فسألتُهُ، قلتُ: حدِّثْني حديثًا سَمِعْتَه مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ولمْ يَتداولْهُ الرِّجالُ بيْنَكما، قالَ: سَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مِن عَبدٍ يقولُ حين يُمسي ويُصبِحُ: رَضيتُ باللهِ ربًّا، وبالإسلامِ دينًا، وبمحمَّدٍ نبيًّا؛",1]," ",["إلَّا كان حقًّا على اللهِ أنْ يُرضيَهُ يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"رجل خدم النبي صلَّى اللهُ عليه وسلم","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (5072)، وأحمد (18969) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"dERGTMi9","merged":2,"otherRefs":["الفتوحات الربانية 3/102 (حسن)"]},{"id":"س-01973","fp":"983efe2b3cea","stateId":671,"easy":"إذا جُرحت في سبيل الله ← تأتي يوم القيامة لونه الزعفران وريحه المسك","cause":"مَن جُرِحَ جُرحًا في سَبيلِ اللهِ","result":"جاء يومَ القيامةِ لَونُه لَونُ الزَّعفَرانِ، ورِيحُه رِيحُ المِسكِ، عليه طابَعُ الشُّهَداءِ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 22110","text":[["مَن جُرِحَ جُرحًا في سَبيلِ اللهِ، ",1],["جاء يومَ القيامةِ لَونُه لَونُ الزَّعفَرانِ، ورِيحُه رِيحُ المِسكِ، عليه طابَعُ الشُّهَداءِ، ",2],"ومَن سَأَلَ اللهَ الشَّهادةَ مُخلِصًا، أعطاه اللهُ أجرَ شَهيدٍ وإنْ مات على فِراشِه، ومَن قاتَلَ في سَبيلِ اللهِ فُواقَ ناقةٍ، وَجَبَتْ له الجنَّةُ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2541)، والترمذي (1657)، والنسائي (3141)، وابن ماجه (2792)، وأحمد (22110) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iOg93jm2","merged":2,"otherRefs":["صحيح ابن حبان 3185 (صحيح)"]},{"id":"س-00314","fp":"2cbbc71e17c4","stateId":671,"easy":"إذا عزّيت أخاك بمصيبة ← يكسوك الله من حلل الكرامة يوم القيامة","cause":"ما من مُؤمنٍ يُعزِّي أخاه بمصيبةٍ","result":"إلَّا كساه اللهُ من حُلَلِ الكرامةِ يومَ القيامةِ","explicit":true,"ref":"الترغيب والترهيب 4/262","srcLabel":"الديلمي","text":[["ما من مُؤمنٍ يُعزِّي أخاه بمصيبةٍ ",1],["إلَّا كساه اللهُ من حُلَلِ الكرامةِ يومَ القيامةِ",2]],"grade":"صحيح","narrator":"عمرو بن حزم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الديلمي في ((الفردوس)) (6081) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"urekQQIe"},{"id":"س-00694","fp":"68c90c521a24","stateId":671,"easy":"إذا أكثرت الصلاة على النبي ﷺ ← تكون أولى الناس به يوم القيامة","cause":"أَكْثرُهُم عليَّ صلاةً","result":"أولى النَّاسِ بي يَومَ القيامةِ","explicit":true,"ref":"بلوغ المرام 455","srcLabel":"الترمذي","text":["إنَّ ",["أولى النَّاسِ بي يَومَ القيامةِ",2]," ",["أَكْثرُهُم عليَّ صلاةً",1]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (484) باختلاف يسير، وابن حبان (911)، والبيهقي في ((شعب الإيمان)) (1563) واللفظ لهما","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"xtaKdWqK"},{"id":"س-00974","fp":"e755a50abdd9","stateId":671,"easy":"إذا قلت صباحاً ومساءً ثلاثاً «رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» ← كان حقاً على الله أن يرضيك يوم القيامة","cause":"إذا أصبَحَ وإذا أمْسى: رَضيتُ باللهِ ربًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ نَبيًّا، ثلاثَ مِرارٍ إذا أصبَحَ، وثلاثَ مِرارٍ إذا أمْسى","result":"إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه يَومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«رضيت بالله رباً وبالإسلام ديناً وبمحمد نبياً» · الوقت: صباحاً ومساءً"},"repOf":"س-01077","otherNeedIds":[5],"ref":"تخريج المسند لشعيب 23112","text":["عن أبي سَلَّامٍ البَراءِ -رَجُلٍ من أهْلِ دِمَشقَ- قال: كُنَّا قُعودًا في مَسجِدِ حِمصَ، فذَكَرَ مَعْناهُ إلَّا أنَّه قال: يقولُ ",["إذا أصبَحَ وإذا أمْسى: رَضيتُ باللهِ ربًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ نَبيًّا، ثلاثَ مِرارٍ إذا أصبَحَ، وثلاثَ مِرارٍ إذا أمْسى؛ ",1],["إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9832)، وأحمد (23112) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"p4nFY0Y2"},{"id":"س-00975","fp":"d3b86e0f59cf","stateId":671,"easy":"إذا قلت ثلاثاً صباحاً أو مساءً «رضيت بالله رباً...» ← كان حقاً على الله أن يرضيك يوم القيامة","cause":"ما مِن عبدٍ مُسلِمٍ يقولُ ثلاثَ مرَّاتٍ حين يُمْسي أو يُصبِحُ: رَضيتُ باللهِ رَبًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ نبيًّا","result":"إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه يَومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«رَضيتُ باللهِ رَبًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ نبيًّا» · الوقت: صباحاً ومساءً"},"repOf":"س-01077","otherNeedIds":[5],"ref":"تخريج المسند لشعيب 23111","text":["عن أبي سَلَّامٍ قال: كُنَّا قُعودًا في مَسجِدِ حِمصَ، إذ مَرَّ رَجُلٌ فقالوا: هذا خَدَمَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، قال: فنَهَضتُ فسَأَلتُه فقُلتُ: حَدِّثْنا بما سَمِعتَ من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ لم يَتَداوَلْه الرِّجالُ فيما بيْنَكما، قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مِن عبدٍ مُسلِمٍ يقولُ ثلاثَ مرَّاتٍ حين يُمْسي أو يُصبِحُ: رَضيتُ باللهِ رَبًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ نبيًّا؛",1]," ",["إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه يَومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9832)، وأحمد (23111) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"wsIOSwd0"},{"id":"س-01615","fp":"cefc37ebede7","stateId":671,"easy":"إذا كظمت غيظك وأنت قادر على إنفاذه ← يملأ الله قلبك رجاءً يوم القيامة","cause":"ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ","result":"مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ","explicit":true,"otherNeedIds":[5],"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ",["ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ",1]," ",["مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ",2],"، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-02944","fp":"118a21b34b14","stateId":671,"easy":"إذا أتيت قوماً فقالوا لك «مرحباً» ← يقال لك مرحباً يوم القيامة يوم تلقى ربك","cause":"إذا أتى الرجلُ القومَ فقالوا لهُ: مرحبًا","result":"فمرحبًا بهِ يومَ القيامةِ يومَ يلقى ربَّهُ","explicit":true,"otherNeedIds":[41],"ref":"الجامع الصغير 340","srcLabel":"أحمد","text":[["إذا أتى الرجلُ القومَ فقالوا لهُ: مرحبًا",1]," ، ",["فمرحبًا بهِ يومَ القيامةِ يومَ يلقى ربَّهُ",2]," ، وإذا أتى الرجلُ القومَ فقالوا لهُ : قَحْطًا ، فقَحْطًا لهُ يومَ القيامةِ"],"grade":"صحيح","narrator":"الضحاك بن قيس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/ 298)\n(8136)، والحاكم (6235)، وأحمد في ((الزهد)) (1375) جميعهم باختلاف يسير.","bab":"إيمان › الوعيد","dorar":"ccFZ9N5U"},{"id":"س-04460","fp":"18e6d14dde87","stateId":671,"easy":"إذا جُرحت أو نُكبت في سبيل الله ← يجيء يوم القيامة كأغزر ما كان ريحه المسك","cause":"ومَن جُرِحَ جُرحًا في سَبيلِ اللهِ أو نُكِبَ نَكبةً","result":"فإنَّها تَجيءُ يومَ القيامةِ كأغزرِ ما كانتْ -وقال عبدُ الرَّزَّاقِ: كأغرِّ، ورَوحٌ: كأغزرِ، وحَجَّاجٌ: كأعزِّ ما كانتْ- لَونُها كالزَّعفَرانِ، ورِيحُها كالمِسكِ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 22116","text":["أنَّه سَمِعَ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: مَن جاهَدَ في سَبيلِ اللهِ -وقال رَوحٌ: قاتَلَ في سَبيلِ اللهِ- مِن رَجُلٍ مُسلِمٍ فُواقَ ناقةٍ، فقد وَجَبَتْ له الجنَّةُ، ومَن سَأَلَ اللهَ القَتلَ مِن عندِ نَفْسِه صادقًا، ثُمَّ مات أو قُتِلَ، فله أجرُ الشُّهَداءِ، ",["ومَن جُرِحَ جُرحًا في سَبيلِ اللهِ أو نُكِبَ نَكبةً، ",1],["فإنَّها تَجيءُ يومَ القيامةِ كأغزرِ ما كانتْ -وقال عبدُ الرَّزَّاقِ: كأغرِّ، ورَوحٌ: كأغزرِ، وحَجَّاجٌ: كأعزِّ ما كانتْ- لَونُها كالزَّعفَرانِ، ورِيحُها كالمِسكِ، ",2],"ومَن جُرِحَ في سَبيلِ اللهِ، فعليه طابَعُ الشُّهَداءِ."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2541)، والترمذي (1657)، والنسائي (3141) باختلاف يسير، وابن ماجه (2792) مختصراً، وأحمد (22116) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"JjJkfDcT"},{"id":"س-05492","fp":"4f3feefe494f","stateId":671,"easy":"إذا قاتلت صابراً محتسباً ← يبعثك الله صابراً محتسباً","cause":"إنْ قَاتلْتَ صابِرًا مُحتسِبًا","result":"بَعَثَكَ اللهُ صابِرًا مُحتسِبًا","explicit":true,"ref":"المستدرك على الصحيحين 2565","srcLabel":"أبو داود","text":["يا رسولَ اللهِ، أَخبِرني عنِ الجهادِ والغَزْوِ، فقالَ: يا عبدَ اللهِ بنَ عَمرٍو، ",["إنْ قَاتلْتَ صابِرًا مُحتسِبًا",1],"؛ ",["بَعَثَكَ اللهُ صابِرًا مُحتسِبًا",2],"، وإنْ قاتلْتَ مُرائيًا مُكاثِرًا؛ بَعَثَكَ اللهُ مُرائيًا مُكاثِرًا، يا عبدَ اللهِ بنَ عَمرٍو، على أَيِّ حالٍ قاتلْتَ أوْ قُتِلتَ؛ بَعَثَكَ اللهُ على تلك الحالِ."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (2519)، والبيهقي (18588) كلاهما باختلاف يسير، وابن أبي الدنيا في ((محاسبة النفس)) (62) ببعض لفظه.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"f6sMT1kR"},{"id":"س-06228","fp":"5c884a2fc000","stateId":671,"easy":"إذا عطشت لله في يوم صائف ← فحق على الله أن يسقيك يوم العطش","cause":"مَن يَعطَشْ للهِ في يومٍ صائفٍ","result":"فإنَّ حقًّا على اللهِ أنْ يَسقيَه يومَ العَطَشِ","explicit":true,"similar":["س-06227"],"ref":"المستدرك على الصحيحين 6095","srcLabel":"البزار","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ استَعمَلَ أبا موسَى على سَريَّةِ البَحرِ، فبَيْنا هي تَجْري بهِم في البَحرِ في اللَّيلِ؛ إذ ناداهُم مُنادٍ مِن فَوقِهم: ألَا أُخبِرُكم بقَضاءٍ قَضاهُ اللهُ على نَفْسه أنَّه ",["مَن يَعطَشْ للهِ في يومٍ صائفٍ؛ ",1],["فإنَّ حقًّا على اللهِ أنْ يَسقيَه يومَ العَطَشِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البزار (4974)، وابن شاهين ((الترغيب في فضائل الأعمال)) (133) بنحوه","bab":"سرايا › السرايا","dorar":"kuJA3vwU"},{"id":"س-08084","fp":"dd06943c4e0d","stateId":671,"easy":"إذا جُرحت في الله ← يبعثك الله يوم القيامة وجرحك يدمى لونه الدم وريحه المسك","cause":"ما من مَجْروحٍ جُرِحَ في اللهِ","result":"إلَّا بَعَثَه اللهُ يَومَ القيامةِ وجُرحُهُ يَدْمى، اللَّونُ لَونُ الدَّمِ، والرِّيحُ رِيحُ المِسكِ","explicit":true,"repOf":"س-04421","ref":"تخريج المسند لشعيب 23662","text":["أشرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على أصحابِ أُحُدٍ... فذَكَرَ مَعْنى حَديثِ يَزيدَ. [أي حديثِ: لمَّا أشرَفَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم على قَتْلى أُحُدٍ، قال: أشهَدُ على هؤلاءِ ",["ما من مَجْروحٍ جُرِحَ في اللهِ",1],"، ",["إلَّا بَعَثَه اللهُ يَومَ القيامةِ وجُرحُهُ يَدْمى، اللَّونُ لَونُ الدَّمِ، والرِّيحُ رِيحُ المِسكِ",2],"، انْظُروا أكثَرَهم جَمعًا لِلقُرآنِ، فقَدِّموهُ أمامَهم في القَبرِ]"],"grade":"صحيح","narrator":"عبدالله بن ثعلبة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (23662) واللفظ له، وابن أبي عاصم في ((الآحاد والمثاني)) (630)، وأبو نعيم في ((معرفة الصحابة)) (4033)","bab":"مغازي › غزوة أحد","dorar":"oqBWtVR5"},{"id":"س-08085","fp":"73ef269d16b3","stateId":671,"easy":"إذا جُرحت في سبيل الله ← يبعثك الله وجرحك يدمى لونه دم وريحه مسك","cause":"ما مِن جريحٍ يُجرَحُ في سبيلِ اللَّهِ","result":"إلَّا واللَّهُ يبعثُهُ يومَ القيامةِ يَدمى جُرحُهُ اللَّونُ لونُ دَمٍ والرِّيحُ ريحُ مِسْكٍ","explicit":true,"repOf":"س-04421","ref":"فقه السيرة 270","text":["أنا شَهيدٌ على هؤلاءِ أنَّهُ ",["ما مِن جريحٍ يُجرَحُ في سبيلِ اللَّهِ",1]," ",["إلَّا واللَّهُ يبعثُهُ يومَ القيامةِ يَدمى جُرحُهُ اللَّونُ لونُ دَمٍ والرِّيحُ ريحُ مِسْكٍ",2]],"grade":"صحيح","narrator":"عبدالله بن ثعلبة","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (4033) واللفظ له، وأحمد (23669) بمعناه.","bab":"مغازي › غزوة أحد","dorar":"eN6AJThq"},{"id":"س-08087","fp":"e139e24107a9","stateId":671,"easy":"إذا جُرحت في سبيل الله ← يأتي جرحك يوم القيامة يدمى لونه الدم وريحه المسك","cause":"ليس مَجروحٌ يُجرَحُ في سبيلِ اللهِ","result":"إلا جاء جُرحُه يومَ القيامةِ يَدْمَى لونُه لونُ الدَّمِ وريحُه ريحُ المِسكِ","explicit":true,"repOf":"س-04421","ref":"مجمع الزوائد 6/122","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال من رأى مَقْتَلَ حمزةَ فقال رجلٌ أعَزَّك اللهُ أنا رأيتُ مَقتَلَه فانطلق فوقف على حمزةَ فرآه قد شُقَّ بطنُه وقد مُثِّلَ به فقال يا رسولَ اللهِ قد مُثِّلَ به فكره رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أن ينظرَ إليه ووقف بين ظَهرانَيِ القَتْلَى وقال أنا شهيدٌ على هؤلاءِ لُفُّوهم بدمائِهم فإنه ",["ليس مَجروحٌ يُجرَحُ في سبيلِ اللهِ",1]," ",["إلا جاء جُرحُه يومَ القيامةِ يَدْمَى لونُه لونُ الدَّمِ وريحُه ريحُ المِسكِ",2]," قَدِّموا أكثرَهم قرآنًا واجعَلوه في الَّلحدِ"],"grade":"صحيح","narrator":"كعب بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (19/82) (167) واللفظ له، وأخرجه الطحاوي في ((شرح مشكل الآثار)) (4051)، والبيهقي (7047) باختلاف يسير","bab":"مغازي › غزوة أحد","dorar":"Dxdynuun"},{"id":"س-08302","fp":"85a53dfcfca4","stateId":671,"easy":"إذا قمت إلى إمام جائر فأمرته ونهيته فقتلك ← تكون سيد الشهداء","cause":"ورجلٌ قام إلى إمامٍ جَائِرٍ فأمرَهُ ونَهاهُ ، فَقَتَلهُ","result":"سَيِّدُ الشُّهَدَاءِ","explicit":true,"otherNeedIds":[47],"ref":"صحيح الترغيب 2308","srcLabel":"ابن حبان","text":[["سَيِّدُ الشُّهَدَاءِ",2]," حَمْزَةُ بْنُ عَبْدِ المُطَّلِبِ ، ",["ورجلٌ قام إلى إمامٍ جَائِرٍ فأمرَهُ ونَهاهُ ، فَقَتَلهُ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/186)، والحاكم (4884)، والديلمي في ((الفردوس)) (3472) باختلاف يسير.","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"u58oQmyi"},{"id":"س-08352","fp":"1be3375ea0d6","stateId":671,"easy":"إذا قلت صباحاً ومساءً «رضينا بالله رباً وبالإسلام ديناً وبمحمد رسولاً» ← كان حقاً على الله أن يرضيك","cause":"مَن قال إذا أصبَحَ وإذا أمْسى: رَضينا باللهِ ربًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ رسولًا","result":"إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه","explicit":true,"apply":{"k":"say","t":"«رضينا بالله رباً وبالإسلام ديناً وبمحمد رسولاً» · الوقت: صباحاً ومساءً"},"repOf":"س-01077","otherNeedIds":[5],"ref":"تخريج سنن أبي داود 5072","text":["أنَّه كان في مَسجِدِ حِمصَ، فمَرَّ به رَجُلٌ، فقالوا: هذا خدَمَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقامَ إليه، فقال: حدِّثْني بحديثٍ سَمِعتَه من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ لم يَتداوَلْه بينَك وبينَه الرِّجالُ، قال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن قال إذا أصبَحَ وإذا أمْسى: رَضينا باللهِ ربًّا، وبالإسلامِ دِينًا، وبمُحمَّدٍ رسولًا، ",1],["إلَّا كان حقًّا على اللهِ أنْ يُرضِيَه",2],"."],"grade":"صحيح","narrator":"رجل خدم النبي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5072)، وأحمد (18969)، والطبراني في ((الدعاء)) (302)، والبغوي في ((شرح السنة)) (1324) واللفظ لهم جميعا.","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"RkYDt0yW"},{"id":"س-06062","fp":"39266a0508e0","stateId":671,"easy":"إذا لقيت أخاك بما يحب الله لتسرّه ← يسرك الله يوم القيامة","cause":"مَنْ لَقِيَ أخاه المسلمَ بما يُحِبُّ اللهُ ليسرَّهُ بذلِكَ","result":"سرَّهُ اللهُ عزَّ وجلَّ يومَ القيامَةِ","explicit":true,"ref":"مجمع الزوائد 8/196","srcLabel":"الطبراني","text":[["مَنْ لَقِيَ أخاه المسلمَ بما يُحِبُّ اللهُ ليسرَّهُ بذلِكَ ",1],["سرَّهُ اللهُ عزَّ وجلَّ يومَ القيامَةِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (894)، والطبراني في ((المعجم الصغير)) (1178)، وابن عدي في ((الكامل في الضعفاء)) (2/215) باختلاف يسير.","bab":"رقائق وزهد › ما جاء في إدخال السرور على المسلم","dorar":"sT4YsPRc"},{"id":"س-06227","fp":"3b222aea5dfe","stateId":671,"easy":"إذا أعطشت نفسك لله في يوم صائف ← يسقيك الله يوم العطش","cause":"من أعطشَ نفسَه لَه في يومٍ صائفٍ","result":"سقاهُ اللَّهُ يومَ العطشِ","explicit":true,"repOf":"س-06228","ref":"مجمع الزوائد 3/186","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بعثَ أبا موسى سريَّةً في البحرِ فبينما هم كذلِكَ إذ رفعوا الشِّراعَ في ليلةٍ مظلِمةٍ إذا هاتفٌ يَهتفُ من فوقِهم يا أَهلَ السَّفينةِ قفوا أخبرُكم بقضاءٍ قضاهُ اللَّهُ على نفسِه فقالَ أبو موسى أخبِرنا إن كنتَ مخبِرًا قالَ إنَّ اللَّهَ تبارَك وتعالى قضى على نفسِه أنَّه ",["من أعطشَ نفسَه لَه في يومٍ صائفٍ ",1],["سقاهُ اللَّهُ يومَ العطشِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"رجاله موثقون","takhrij":"أخرجه البزار (4974)، وابن حبان في ((المجروحين)) (1/448)، والحاكم (5968) باختلاف يسير","bab":"سرايا › السرايا","dorar":"9m8TcSlG"},{"id":"س-06889","fp":"8dcd0fc37c74","stateId":671,"easy":"إذا طلبت الدنيا حلالاً استعفافاً وسعياً على أهلك وعطفاً على جارك ← تأتي يوم القيامة ووجهك كالقمر ليلة البدر","cause":"من طلبَ الدُّنيا حلالًا ، استعفافًا عن المسألةِ ، وسعيًا على أَهلِهِ وتعطُّفًا على جارِهِ","result":"جاءَ يومَ القيامةِ ووجْهُهُ كالقمرِ ليلةَ البدرِ","explicit":true,"ref":"الآداب الشرعية 3/260","srcLabel":"الطبراني","text":[["من طلبَ الدُّنيا حلالًا ، استعفافًا عن المسألةِ ، وسعيًا على أَهلِهِ وتعطُّفًا على جارِهِ ",1],["جاءَ يومَ القيامةِ ووجْهُهُ كالقمرِ ليلةَ البدرِ ",2],"ومن طلبَ الدُّنيا حلالًا مُكاثِرًا لقيَ اللَّهَ وَهوَ عليْهِ غضبانُ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه عبد بن حميد في ((المسند)) (1431)، وابن أبي الدنيا في ((النفقة على العيال)) (32)، والطبراني في ((مسند الشاميين)) (3465) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"akZUgD4A"},{"id":"س-07886","fp":"c50a7c9031c0","stateId":671,"easy":"إذا سجدت لله طوعاً في الدنيا ← يأذن الله لك بالسجود يوم القيامة","cause":"مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه","result":"إلَّا أذِنَ اللهُ له بالسُّجودِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 183","srcLabel":"البخاري","text":["أنَّ ناسًا في زَمَنِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قالوا: يا رَسولَ اللهِ، هل نَرى رَبَّنا يَومَ القيامةِ؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: نَعَم، قال: هل تُضارُّونَ في رُؤيةِ الشَّمسِ بالظَّهيرةِ صَحوًا ليس معها سَحابٌ؟ وهل تُضارُّونَ في رُؤيةِ القَمَرِ لَيلةَ البَدرِ صَحوًا ليس فيها سَحابٌ؟ قالوا: لا يا رَسولَ اللهِ، قال: ما تُضارُّونَ في رُؤيةِ اللهِ تَبارَك وتَعالى يَومَ القيامةِ إلَّا كما تُضارُّونَ في رُؤيةِ أحَدِهما، إذا كانَ يَومُ القيامةِ أذَّنَ مُؤَذِّنٌ: ليَتَّبِعْ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، فلا يَبقى أحَدٌ كانَ يَعبُدُ غيرَ اللهِ سُبحانَه مِنَ الأصنامِ والأنصابِ إلَّا يَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ مِن بَرٍّ وفاجِرٍ وغُبَّرِ أهلِ الكِتابِ، فيُدعى اليَهودُ، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ عُزَيرَ ابنَ اللهِ، فيُقالُ: كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فماذا تَبغونَ؟ قالوا: عَطِشنا يا رَبَّنا، فاسقِنا، فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى النَّارِ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، ثُمَّ يُدعى النَّصارى، فيُقالُ لهم: ما كُنتُم تَعبُدونَ؟ قالوا: كُنَّا نَعبُدُ المَسيحَ ابنَ اللهِ، فيُقالُ لهم، كَذَبتُم، ما اتَّخَذَ اللهُ مِن صاحِبةٍ ولا ولَدٍ، فيُقالُ لهم: ماذا تَبغونَ؟ فيَقولونَ: عَطِشنا يا رَبَّنا، فاسقِنا، قال: فيُشارُ إليهم، ألا تَرِدونَ؟ فيُحشَرونَ إلى جَهَنَّمَ كَأنَّها سَرابٌ يَحطِمُ بَعضُها بَعضًا، فيَتَساقَطونَ في النَّارِ، حتَّى إذا لَم يَبقَ إلَّا مَن كانَ يَعبُدُ اللهَ تَعالى مِن بَرٍّ وفاجِرٍ، أتاهم رَبُّ العالَمينَ سُبحانَه وتَعالى في أدنى صورةٍ مِنَ التي رَأوْه فيها، قال: فما تَنتَظِرونَ؟ تَتبَعُ كُلُّ أُمَّةٍ ما كانَت تَعبُدُ، قالوا: يا رَبَّنا، فارَقنا النَّاسَ في الدُّنيا أفقَرَ ما كُنَّا إليهم، ولَم نُصاحِبْهُم، فيَقولُ: أنا رَبُّكُم، فيَقولونَ: نَعوذُ باللهِ مِنك لا نُشرِكُ باللهِ شيئًا، مَرَّتَينِ أو ثَلاثًا، حتَّى إنَّ بَعضَهم لَيَكادُ أن يَنقَلِبَ، فيَقولُ: هل بينَكُم وبينَه آيةٌ فتَعرِفونَه بها؟ فيَقولونَ: نَعَم، فيُكشَفُ عن ساقٍ، فلا يَبقى ",["مَن كانَ يَسجُدُ للَّهِ مِن تِلقاءِ نَفسِه",1]," ",["إلَّا أذِنَ اللهُ له بالسُّجودِ",2],"، ولا يَبقى مَن كانَ يَسجُدُ اتِّقاءً ورياءً إلَّا جَعَلَ اللهُ ظَهرَه طَبَقةً واحِدةً، كُلَّما أرادَ أن يَسجُدَ خَرَّ على قَفاه، ثُمَّ يَرفَعونَ رُؤوسَهم وقد تَحَوَّلَ في صورَتِه التي رَأوْه فيها أوَّلَ مَرَّةٍ، فقال: أنا رَبُّكُم، فيَقولونَ: أنتَ رَبُّنا، ثُمَّ يُضرَبُ الجِسرُ على جَهَنَّمَ، وتَحِلُّ الشَّفاعةُ، ويقولونَ: اللهمَّ سَلِّمْ سَلِّمْ، قيلَ: يا رَسولَ اللهِ، وما الجِسرُ؟ قال: دَحضٌ مَزِلَّةٌ، فيه خَطاطيفُ وكَلاليبُ، وحَسَكٌ تَكونُ بنَجدٍ فيها شويكةٌ يُقالُ لها السَّعدانُ، فيَمُرُّ المُؤمِنونَ كَطَرفِ العَينِ، وكالبَرقِ، وكالرِّيحِ، وكالطَّيرِ، وكَأجاويدِ الخَيلِ والرِّكابِ؛ فناجٍ مُسَلَّمٌ، ومَخدوشٌ مُرسَلٌ، ومَكدوسٌ في نارِ جَهَنَّمَ، حتَّى إذا خَلَصَ المُؤمِنونَ مِنَ النَّارِ، فوالذي نَفسي بيَدِه، ما مِنكُم مِن أحَدٍ بأشَدَّ مُناشَدةً للَّهِ في استِقصاءِ الحَقِّ مِنَ المُؤمِنينَ للَّهِ يَومَ القيامةِ لإخوانِهمُ الذينَ في النَّارِ، يقولونَ: رَبَّنا كانوا يَصومونَ معنا ويُصَلُّونَ ويَحُجُّونَ، فيُقالُ لهم: أخرِجوا مَن عَرَفتُم، فتُحَرَّمُ صورُهم على النَّارِ، فيُخرِجونَ خَلقًا كَثيرًا قدِ أخَذَتِ النَّارُ إلى نِصفِ ساقَيه، وإلى رُكبَتَيه، ثُمَّ يقولونَ: رَبَّنا ما بَقيَ فيها أحَدٌ مِمَّن أمَرتَنا به، فيَقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها أحَدًا مِمَّن أمَرتَنا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ نِصفِ دينارٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها مِمَّن أمَرتَنا أحَدًا، ثُمَّ يقولُ: ارجِعوا فمَن وجَدتُم في قَلبِه مِثقالَ ذَرَّةٍ مِن خَيرٍ فأخرِجوه، فيُخرِجونَ خَلقًا كَثيرًا، ثُمَّ يقولونَ: رَبَّنا لَم نَذَرْ فيها خَيرًا. وكانَ أبو سَعيدٍ الخُدريُّ يقولُ: إن لَم تُصَدِّقوني بهذا الحَديثِ فاقرَؤوا إن شِئتُم: {إنَّ اللهَ لا يَظلِمُ مِثقالَ ذَرَّةٍ وإن تَكُ حَسَنةً يُضاعِفها ويُؤتِ مِن لَدُنْه أجرًا عَظيمًا} [النساء: 40]، فيَقولُ اللهُ عزَّ وجلَّ: شَفَعَتِ المَلائِكةُ، وشَفَعَ النَّبيُّونَ، وشَفَعَ المُؤمِنونَ، ولَم يَبقَ إلَّا أرحَمُ الرَّاحِمينَ، فيَقبِضُ قَبضةً مِنَ النَّارِ، فيُخرِجُ مِنها قَومًا لَم يَعمَلوا خَيرًا قَطُّ قد عادوا حُمَمًا، فيُلقيهم في نَهَرٍ في أفواهِ الجَنَّةِ، يُقالُ له: نَهَرُ الحَياةِ، فيَخرُجونَ كما تَخرُجُ الحِبَّةُ في حَميلِ السَّيلِ، ألا تَرَونَها تَكونُ إلى الحَجَرِ أو إلى الشَّجَرِ، ما يَكونُ إلى الشَّمسِ أُصَيفِرُ وأُخَيضِرُ، وما يَكونُ مِنها إلى الظِّلِّ يَكونُ أبيَضَ؟ فقالوا: يا رَسولَ اللهِ، كَأنَّك كُنتَ تَرعى بالباديةِ! قال: فيَخرُجونَ كاللُّؤلُؤِ في رِقابِهمُ الخَواتِمُ، يَعرِفُهم أهلُ الجَنَّةِ: هؤلاء عُتَقاءُ اللهِ الذينَ أدخَلَهمُ اللهُ الجَنَّةَ بغيرِ عَمَلٍ عَمِلوه، ولا خَيرٍ قدَّموه، ثُمَّ يقولُ: ادخُلوا الجَنَّةَ فما رَأيتُموه فهو لكم، فيَقولونَ: رَبَّنا، أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ، فيَقولُ: لكم عِندي أفضَلُ مِن هذا، فيَقولونَ: يا رَبَّنا، أيُّ شيءٍ أفضَلُ مِن هذا؟ فيَقولُ: رِضايَ، فلا أسخَطُ علَيكُم بَعدَه أبَدًا. قال مُسلِمٌ: قَرَأتُ على عيسى بنِ حَمَّادٍ زُغبةَ المِصريِّ هذا الحَديثَ في الشَّفاعةِ، وقُلتُ له: أُحَدِّثُ بهذا الحَديثِ عَنك أنَّك سَمِعتَ مِنَ اللَّيثِ بنِ سَعدٍ، فقال: نَعَم، قُلتُ لعيسى بنِ حَمَّادٍ: أخبَرَكُمُ اللَّيثُ بنُ سَعدٍ، عن خالِدِ بنِ يَزيدَ، عن سَعيدِ بنِ أبي هِلالٍ، عن زَيدِ بنِ أسلَمَ، عن عَطاءِ بنِ يَسارٍ، عن أبي سَعيدٍ الخُدريِّ، أنَّه قال: قُلنا: يا رَسولَ اللهِ، أنَرى رَبَّنا؟ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل تُضارُّونَ في رُؤيةِ الشَّمسِ إذا كانَ يَومٌ صَحوٌ؟ قُلنا: لا، وسُقتُ الحَديثَ حتَّى انقَضى آخِرُه، وهو نَحوُ حَديثِ حَفصِ بنِ مَيسَرةَ، وزادَ بَعدَ قَولِه: بغيرِ عَمَلٍ عَمِلوه، ولا قدَمٍ قدَّموه، فيُقالُ لهم: لكم ما رَأيتُم ومِثلُه معهُ. قال أبو سَعيدٍ: بَلَغَني أنَّ الجِسرَ أدَقُّ مِنَ الشَّعرةِ، وأحَدُّ مِنَ السَّيفِ. وليسَ في حَديثِ اللَّيثِ، فيَقولونَ: رَبَّنا أعطَيتَنا ما لَم تُعطِ أحَدًا مِنَ العالَمينَ وما بَعدَه، فأقَرَّ به عيسى بنُ حَمَّادٍ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7439) باختلاف يسير","bab":"قيامة › الشفاعة","dorar":"KOAVhCFo"},{"id":"س-01520","fp":"b3e272774919","stateId":671,"easy":"إذا أذّنت ← تكون أطول الناس أعناقاً يوم القيامة","cause":"النِّداءَ","result":"أطوَلُ النَّاسِ أعْناقًا يومَ القيامةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 6501","srcLabel":"الطبراني","text":["عَنْ عَبْدِ اللَّهِ بْنِ الزُّبَيْرِ رَضِيَ اللَّهُ عَنْهُمَا قَالَ:  ودِدْتُ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أعْطاني ",["النِّداءَ",1]," قالَ: ولمَ؟ قالَ: إنَّهم ",["أطوَلُ النَّاسِ أعْناقًا يومَ القيامةِ",2],"."],"grade":"صحيح","narrator":"عروة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((الأوسط)) (6309) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"iGMsQ1Zw","merged":4,"otherRefs":["تخريج المسند لشعيب 13789 (صحيح)","عمدة القاري 5/165 (حسن)","تخريج المسند لشعيب 16898 (صحيح)"]},{"id":"س-00940","fp":"c3dd163fa4f8","stateId":671,"easy":"إذا جالست مجالس الذكر في المساجد ← تكون من أهل الكرم يوم القيامة","cause":"أهلُ مجالِسِ الذِّكرِ في المساجِدِ","result":"مَن أهلُ الكرَمِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[47],"ref":"صحيح ابن حبان 816","srcLabel":"أحمد","text":["يقولُ اللهُ جلَّ وعلا : سيعلَمُ أهلُ الجمعِ اليومَ ",["مَن أهلُ الكرَمِ",2]," ) فقيل : مَن أهلُ الكرَمِ يا رسولَ اللهِ ؟ قال : ( ",["أهلُ مجالِسِ الذِّكرِ في المساجِدِ",1]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (11652)، وأبو يعلى (1046)، والبيهقي في ((شعب الإيمان)) (531) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"seZxIc4Q","merged":2,"otherRefs":["الترغيب والترهيب 2/333 (صحيح)"]},{"id":"س-06000","fp":"f475ae524e72","stateId":671,"easy":"إذا كنت من المتقين ← تُحشر راكباً لا ماشياً","cause":"الْمُتَّقِينَ","result":"ما على أرجُلِهم يُحشَرون، ولا يُساقُون سَوقًا، ولكنَّهم يُؤتَون بنُوقٍ مِن نُوقِ الجنَّةِ لم تَنظُرِ الخلائقُ إلى مِثلِها، رِحالُهم الذَّهبُ، وأَزِمَّتُها الزَّبرجدُ، فيَقعُدون عليها حتَّى يَقْرَعوا بابَ الجنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8914","srcLabel":"الحاكم","text":["كنَّا جُلوسًا عِندَ علِيِّ بنِ أبي طالبٍ رَضيَ اللهُ عنه، فقَرَأ: {يَوْمَ نَحْشُرُ ",["الْمُتَّقِينَ",1]," إِلَى الرَّحْمَنِ وَفْدًا} [مريم: 85] قال: لا واللهِ ",["ما على أرجُلِهم يُحشَرون، ولا يُساقُون سَوقًا، ولكنَّهم يُؤتَون بنُوقٍ مِن نُوقِ الجنَّةِ لم تَنظُرِ الخلائقُ إلى مِثلِها، رِحالُهم الذَّهبُ، وأَزِمَّتُها الزَّبرجدُ، فيَقعُدون عليها حتَّى يَقْرَعوا بابَ الجنَّةِ",2],"."],"grade":"صحيح","narrator":"النعمان بن سعد","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"رقائق وزهد › تقوى الله","dorar":"E0EdI1dZ","merged":2,"otherRefs":["المستدرك على الصحيحين 3469 (صحيح)"]},{"id":"س-01455","fp":"5ed186cebd55","stateId":671,"easy":"إذا تجافى جنبك عن المضجع ← تكون من أهل الكرم يوم القيامة","cause":"أين الَّذين كانت تَتجافى جُنوبُهم عنِ المضاجِعِ؟»، ثُمَّ يقولُ: «أين الَّذين كانوا {لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ} [النور: 37] إلى آخرِ الآيةِ، ثُمَّ يُنادي مُنادٍ: سيَعلمُ الجمعُ لمَنِ الكرمُ اليومَ»، ثُمَّ يقولُ: «أين الحمَّادونَ الَّذين كانوا يَحمَدونَ ربَّهم","result":"سيَعلمُ أهلُ الجمعِ لمَنِ الكرمُ اليومَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[47],"ref":"المستدرك على الصحيحين 3554","srcLabel":"الروياني","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سفَرٍ، فكنَّا نَتناوبُ الرِّعيَةَ، فلمَّا كانت نَوْبَتي سرَّحتُ إِبِلي، ثُمَّ رُحتُ، فجئتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو يَخطُبُ النَّاسَ فسَمِعْتُهُ يقولُ: «ما مِن مسلمٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقومُ في صلاتِهِ فيَعلَمُ ما يَقولُ إلَّا انفَتَلَ كيومِ ولدَتْهُ أُمُّهُ مِنَ الخطايا، ليس عليه ذنبٌ». قالَ: فما مَلكْتُ نفْسي عند ذلك أنْ قلتُ: بَخٍ بَخٍ. فقالَ عُمَرُ -وكنتُ إلى جنبِهِ-: أتعجبُ مِن هذا؟ قد قالَ قبلَ أنْ تَجيءَ ما هو أجودُ منه. فقلتُ: ما هو فِداكَ أبي وأُمِّي؟ قالَ: قالَ: «ما مِن رَجلٍ يَتوضَّأُ فيُسبِغُ الوُضوءَ، ثُمَّ يقولُ عندَ فراغِهِ مِن وُضوئِهِ: أَشهدُ أنْ لا إلهَ إلَّا اللهُ وأَشهدُ أنَّ مُحمَّدًا عبدُهُ ورسولُهُ إلَّا فُتِحتْ له ثمانيةُ أبوابٍ مِنَ الجنَّةِ يَدخلُ مِنْ أيِّها شاءَ». ثُمَّ قالَ: «يُجمعُ النَّاسُ في صَعيدٍ واحدٍ، يَنفذُهم البَصرُ، ويُسمِعُهم الدَّاعي، فيُنادي مُنادٍ: ",["سيَعلمُ أهلُ الجمعِ لمَنِ الكرمُ اليومَ",2],"». ثلاثَ مرَّاتٍ. «ثُمَّ يقولُ: «",["أين الَّذين كانت تَتجافى جُنوبُهم عنِ المضاجِعِ؟»، ثُمَّ يقولُ: «أين الَّذين كانوا {لَا تُلْهِيهِمْ تِجَارَةٌ وَلَا بَيْعٌ عَنْ ذِكْرِ اللَّهِ} [النور: 37] إلى آخرِ الآيةِ، ثُمَّ يُنادي مُنادٍ: سيَعلمُ الجمعُ لمَنِ الكرمُ اليومَ»، ثُمَّ يقولُ: «أين الحمَّادونَ الَّذين كانوا يَحمَدونَ ربَّهم",1],"؟»."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح","takhrij":"أخرجه الروياني (251)، وابن عبد البر في ((التمهيد)) (1/ 51)، وأبو موسى المديني في ((اللطائف)) (719) جميعهم دون لفظه الأخير.","bab":"وضوء › فضل الوضوء","dorar":"jTAp8ilA"},{"id":"س-01502","fp":"95a92ca59a15","stateId":671,"easy":"إذا أديت حق الله وحق مواليك ← تكون على كثبان المسك يوم القيامة","cause":"عَبدٌ أدَّى حقَّ اللَّهِ وحقَّ مواليهِ ، ورجُلٌ أمَّ قومًا وَهُم بِهِ راضونَ ، ورَجلٌ يُنادي بالصَّلواتِ الخمسِ في كلِّ يومٍ وليلَةٍ","result":"ثلاثةٌ علَى كُثبانِ المسكِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"الترغيب والترهيب 1/228","srcLabel":"الترمذي","text":[["ثلاثةٌ علَى كُثبانِ المسكِ",2]," -أُراهُ قالَ - يومَ القيامةِ ",["عَبدٌ أدَّى حقَّ اللَّهِ وحقَّ مواليهِ ، ورجُلٌ أمَّ قومًا وَهُم بِهِ راضونَ ، ورَجلٌ يُنادي بالصَّلواتِ الخمسِ في كلِّ يومٍ وليلَةٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (1986) واللفظ له، وأحمد (4799)","bab":"أذان › فضل التأذين","dorar":"zdOAyc0R"},{"id":"س-08416","fp":"56d6956ccf49","stateId":671,"easy":"إذا كنت من الفقراء المهاجرين ← تأتي يوم القيامة ونورك كنور الشمس","cause":"الفُقَراءُ والمُهاجرونَ الَّذينَ يُحشَرونَ مِن أقطارِ الأرضِ","result":"يأتي اللَّهَ قومٌ يومَ القيامةِ ، نورُهُم كَنورِ الشَّمسُ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[67],"ref":"تخريج المسند لشاكر 12/28","srcLabel":"أحمد","text":["كنتُ عندَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ وطلَعتِ الشَّمسُ ، فقالَ : ",["يأتي اللَّهَ قومٌ يومَ القيامةِ ، نورُهُم كَنورِ الشَّمسُ",2]," ، فقالَ أبو بَكْرٍ : أنَحنُ هم يا رَسولَ اللَّهِ ؟ قالَ : لا ، ولَكُم خيرٌ كثيرٌ ، ولَكِنَّهمُ ",["الفُقَراءُ والمُهاجرونَ الَّذينَ يُحشَرونَ مِن أقطارِ الأرضِ",1]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه مطولاً أحمد (7072) واللفظ له، والطبراني (13/363) (14178)، والبيهقي في ((الزهد الكبير)) (203) باختلاف يسير.","bab":"مناقب وفضائل › فضائل المهاجرين ومناقبهم","dorar":"zzoJgv3B"},{"id":"س-06030","fp":"b6cd165b4990","stateId":672,"easy":"إذا صبرت على الأثرة ← تلقى النبي ﷺ على الحوض","cause":"فاصبِروا","result":"حتَّى تَلقَوني على الحَوضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"similar":["س-00306"],"otherNeedIds":[16],"ref":"صحيح البخاري 3163","srcLabel":"متفق عليه","text":["دَعا النَّبيُّ صلَّى اللهُ عليه وسلَّم الأنصارَ ليَكتُبَ لهم بالبَحرَينِ، فقالوا: لا واللهِ حتَّى تَكتُبَ لإخوانِنا مِن قُرَيشٍ بمِثلِها، فقال: ذاكَ لهم ما شاءَ اللهُ على ذلك، يقولونَ له، قال: فإنَّكُم سَتَرَونَ بَعدي أثَرةً، ",["فاصبِروا",1]," ",["حتَّى تَلقَوني على الحَوضِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"رقائق وزهد › فضل الصبر","dorar":"frt4ngc1","merged":5,"otherRefs":["صحيح البخاري 3794 (صحيح)","صحيح الترمذي 2189 (صحيح)","صحيح مسلم 1845 (صحيح)","تخريج صحيح ابن حبان 7275 (صحيح)"]},{"id":"س-06583","fp":"54ae3cb2f885","stateId":672,"easy":"إذا لم تصدق الظلمة بكذبهم ولم تعنهم على ظلمهم ← فأنت من النبي ﷺ وترد عليه حوضه","cause":"ومَن لم يُصدِّقْهم بكَذِبِهم ولم يُعِنْهم على ظُلمِهم","result":"فأولئكَ منِّي وأنا منْهم، وسيَرِدُون علَيَّ حَوْضي","explicit":true,"star":true,"similar":["س-08012"],"otherNeedIds":[26],"ref":"المستدرك على الصحيحين 8522","srcLabel":"الحاكم","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال لكَعبِ بنِ عُجْرةَ: أعاذَكَ اللهُ يا كعْبُ مِن إمارةِ السُّفهاءِ، قال: وما إمارةُ السُّفهاءِ يا رَسولَ اللهِ؟ قال: أُمراءُ يكونونَ بعْدي، لا يَهْدُون بهَدْيي، ولا يَسْتنُّون بسُنَّتي، فمَن صَدَّقهم بكَذِبِهم وأعانَهم على ظُلمِهم، فأولئكَ ليْسوا منِّي، ولسْتُ منهم، ولا يَرِدُون علَيَّ حَوْضي، ",["ومَن لم يُصدِّقْهم بكَذِبِهم ولم يُعِنْهم على ظُلمِهم، ",1],["فأولئكَ منِّي وأنا منْهم، وسيَرِدُون علَيَّ حَوْضي",2],". يا كَعْبُ بنَ عُجْرةَ، الصَّومُ جُنَّةٌ، والصَّدقةُ تُطفِئُ الخطيئةَ، والصَّلاةُ قُربانٌ، أو قال: بُرهانٌ. يا كَعْبُ بنَ عُجْرةَ، لا يَدخُلُ الجنَّةَ لحْمٌ نبَتَ مِن سُحتٍ أبدًا، النَّارُ أَولى به. يا كَعْبُ بنَ عُجْرةَ، النَّاسُ غاديانِ؛ فمُبتاعٌ نفْسَه فمُعتِقُها، أو قال: فمُوبِقُها."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"0TB3rhhe","merged":9,"otherRefs":["الأحكام الشرعية الصغرى 495 (صحيح)","تخريج صحيح ابن حبان 1723 (صحيح)","تخريج المسند لشعيب 15284 (صحيح)","تخريج سنن الترمذي 2/513 (صحيح)","تخريج صحيح ابن حبان 285 (صحيح)","تخريج كتاب السنة 758 (صحيح)","مجمع الزوائد 5/250 (صحيح)","الفتح الرباني 9/4671 (صحيح)"]},{"id":"س-05629","fp":"48f776990afb","stateId":672,"easy":"إذا كنت من فقراء المهاجرين الشعث الذين لا تُفتح لهم الأبواب ← تكون أول من يرد الحوض","cause":"فقراءُ المُهاجرينَ ، الدُّنسُ ثيابًا ، والشُّعثُ رءوسًا ، الَّذينَ لا ينكِحونَ المنعَّماتِ ، ولا يُفتَحُ لَهُمُ السُّددُ","result":"وأوَّلُ مَن يردُهُ عليَّ","explicit":true,"similar":["س-01575","س-08417"],"otherNeedIds":[9],"ref":"صحيح ابن ماجه 3491","srcLabel":"الترمذي","text":["إنَّ حوضي ما بينَ عدَنَ إلى أيلةَ ، أشدُّ بياضًا منَ اللَّبَنِ ، وأحلَى منَ العسلِ ، أَكاويبُهُ كعَددِ نجومِ السَّماءِ ، مَن شربَ منهُ شَربةً لم يظمَأْ بعدَها أبدًا ، ",["وأوَّلُ مَن يردُهُ عليَّ",2]," ",["فقراءُ المُهاجرينَ ، الدُّنسُ ثيابًا ، والشُّعثُ رءوسًا ، الَّذينَ لا ينكِحونَ المنعَّماتِ ، ولا يُفتَحُ لَهُمُ السُّددُ",1]," قالَ : فبَكَى عمرُ حتَّى اخضلَّت لحيتُهُ ، ثمَّ قالَ : لَكِنِّي قد نَكَحتُ المنعَّماتِ ، وفُتِحَت لي السُّددُ ، لا جرمَ أنِّي لا أغسلُ ثوبي الَّذي على جَسدي حتَّى يتَّسخَ ، ولا أدهنُ رأسي حتَّى يَشعَثَ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2444)، وابن ماجة (4303)، والحاكم (7374) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"ReGtQTdT","merged":4,"otherRefs":["صحيح الترغيب 3617 (صحيح)","صحيح الترغيب 3184 (صحيح)","تخريج كتاب السنة 749 (صحيح)"]},{"id":"س-00306","fp":"678c211454e7","stateId":672,"easy":"إذا رأيت أثرة في الأمر والقسم فاصبر ← حتى تلقى النبي ﷺ على الحوض","cause":"وسَتَرَوْن بعدِي أثَرةً في الأمْرِ والقَسْمِ، فاصْبِروا","result":"حتَّى تَلْقَوْني على الحَوْضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"repOf":"س-06030","otherNeedIds":[16],"ref":"المستدرك على الصحيحين 7169","text":["جاء أُسَيْدُ بنُ حُضَيْرٍ الأشْهلِيُّ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، وقدْ كانَ قَسَّمَ طعامًا، فذَكَرَ لهُ أهْلَ بَيتٍ مِن الأنصارِ مِنْ بَني ظُفَرٍ فيهم حاجةٌ، قالَ: وجُلُّ أهْلِ ذلكَ البيتِ نِسوةٌ، قالَ: فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ترَكْتَنا يا أُسَيْدُ حتَّى ذهَبَ ما في أيدِينا، فإذا سَمِعْتَ بشَيْءٍ قد جاءَنا، فاذْكُرْ لي أهْلَ ذلكَ البَيْتِ. قالَ: فجاءَهُ بعْدَ ذلك طعامٌ مِن خَيْبَرَ شَعيرٌ وتَمْرٌ، قال: فقَسَمَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ في النَّاسِ، وقسَمَ في الأنصارِ فأَجْزَلَ، وقسَمَ في أهْلِ ذلكَ البيتِ فأجْزَلَ، قالَ: فقالَ له أُسَيدُ بنُ حُضَيْرٍ: مُتَشَكَّرٌ، أجْزأَكَ اللهُ -أيْ نَبِيَّ اللهِ- عنَّا أفضَلَ الجزاءِ -أو قالَ: خَيْرًا- فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: وأنتُمْ يا مَعشَرَ الأنصارِ، فجَزاكُم اللهُ أطْيَبَ الجزاءِ -أو قَالَ: خيرًا - فإنَّكُمْ -ما علِمْتُ- أعِفَّةٌ صُبْرٌ، ",["وسَتَرَوْن بعدِي أثَرةً في الأمْرِ والقَسْمِ، فاصْبِروا",1]," ",["حتَّى تَلْقَوْني على الحَوْضِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (8712) واللفظ له، والنسائي في ((الكبرى)) (8287) وابن حبان (7277) بنحوه","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"s3LspWNJ"},{"id":"س-08012","fp":"fd3ab6179ba5","stateId":672,"easy":"إذا لم تصدق الظلمة ولم تعنهم ← فأنت من النبي ﷺ وترد عليه الحوض","cause":"فلا تُصدِّقوهم بِكَذبِهِم ولا تُعينُوهُم على ظُلمِهِم","result":"فَهوَ منِّي وأَنا منهُ وسَيَردُ عليَّ الحوضَ","explicit":true,"repOf":"س-06583","ref":"الأمالي المطلقة 219","text":["عن خبَّابٍ كُنَّا قعودًا على بابِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ فخرجَ علَينا فقال ألا تَسمَعونَ ؟ فقُلنا قد سمِعنا مرَّتينِ أو ثلاثةً فقال إنُّه سيَكونُ أمراءُ ",["فلا تُصدِّقوهم بِكَذبِهِم ولا تُعينُوهُم على ظُلمِهِم",1]," فمَن صدَّقَهُم بِكَذبِهِم ولم يُعِنهُم على ظُلمِهِم ، ",["فَهوَ منِّي وأَنا منهُ وسَيَردُ عليَّ الحوضَ",2]],"grade":"حسن","narrator":"خباب بن الأرت","muhaddith":"حسن","takhrij":"أخرجه أحمد (21074) بلفظه، والطبراني (4/ 59) (3627)، والحاكم (264) كلاهما بنحوه .","bab":"مظالم › تحريم الظلم","dorar":"ivhG4YVL"},{"id":"س-08369","fp":"3109c57868e7","stateId":672,"easy":"إذا حفظت النبي ﷺ في أصحابه ← ترافقه وترد عليه الحوض","cause":"فمن حفِظَني في أصحابي","result":"رافَقني وورد عليَّ الحَوضَ","explicit":true,"otherNeedIds":[68],"ref":"در السحابة 35","srcLabel":"ابن عساكر","text":["احفَظوني في أصحابي ",["فمن حفِظَني في أصحابي",1]," ",["رافَقني وورد عليَّ الحَوضَ",2]," ومن لم يحفَظني فيهم لم يرِد حَوضي ولم يرَني إلَّا من بعيدٍ"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (23/463)","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"Sq9X6rpZ"},{"id":"س-01575","fp":"30132ddde379","stateId":672,"easy":"إذا كنت من فقراء المهاجرين ← تكون أول من يرد الحوض","cause":"الشُّعْثُ رُؤوسًا، الدُّنْسُ ثِيابًا","result":"أوَّلُ النَّاسِ وُرودًا عليه فُقراءُ المُهاجرينَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-05629","otherNeedIds":[9],"ref":"المستدرك على الصحيحين 7578","text":["عنْ أبي سَلَّامٍ الأسْوَدِ قالَ: بلَغَ عُمَرَ بنَ عبدِ العزيزِ أنَّه يُحدِّثُ عنْ ثَوْبانَ حَديثَ أبي الأحْوَصِ، قالَ: فبَعَثَ إليهِ فحُمِلَ على البَريدِ، قالَ: فلمَّا انتهى إليهِ فدَخَلَ عليه سَلَّمَ، وقال: يا أميرَ المُؤْمنينَ، لقَدْ شَقَّ على رَحْلي مَرْكَبي مِنَ البَرِيدِ، قالَ: فقالَ عُمَرُ كالمُتَوَجِّعِ: ما أرَدْنا المَشَقَّةَ عليكَ يا أبا سَلَّامٍ، ولكِنْ بلَغَنِي حَديثٌ تُحدِّثُه، عنْ ثَوْبانَ، عنْ نَبِيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ في الحَوْضِ، فأحبَبْتُ أنْ تُشافِهَني بهِ مُشافَهةً. قال أبو سَلَّامٍ: سَمِعْتُ ثَوْبانَ يقولُ: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: حَوْضِي ما بيْنَ عَدَنَ إلى عُمَانَ البَلْقاءِ، ماؤُهُ أشَدُّ بياضًا مِن اللَّبَنِ، وأحْلَى مِن العَسَلِ، وأكْوابُه عدَدُ النُّجومِ، مَن شَرِبَ منه شَربةً لم يَظْمَأْ بعْدَها أبدًا، ",["أوَّلُ النَّاسِ وُرودًا عليه فُقراءُ المُهاجرينَ",2]," ",["الشُّعْثُ رُؤوسًا، الدُّنْسُ ثِيابًا",1],"، الَّذينَ لا يَنكِحُونَ المُنَعَّماتِ، ولا تُفتَحُ لهم السُّدَدُ.\n قالَ: فقالَ عُمَرُ رَضيَ اللهُ عنه: لكِنِّي قدْ نكَحْتُ المُنَعَّماتِ فاطمةَ بنتَ عبدِ المَلِكِ، وفُتِحَتْ لي السُّدَدُ، لا جرَمَ أنِّي لا أغْسِلُ رأْسي حتَّى يَشْعَثَ، ولا ثَوْبي الَّذي يَلِي جَسَدي حتَّى يتَّسِخَ."],"grade":"صحيح","narrator":"ثوبان","muhaddith":"صحيح الإسناد","bab":"أشربة › اللبن","dorar":"szQjhGMm","merged":2,"otherRefs":["تخريج المسند لشعيب 22367 (صحيح)"]},{"id":"س-08417","fp":"46cf6650fa36","stateId":672,"easy":"إذا كنت من الفقراء المهاجرين الذين تُسد بهم الثغور ← تكون من أول من يدخل الجنة","cause":"الفقراءُ والمُهاجرونَ ، الَّذينَ تسدُّ بِهِمُ الثُّغورُ ، ويتَّقى بِهِمُ المَكارِهُ","result":"أوَّلَ من يدخلُ الجنَّةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-05629","otherNeedIds":[67],"ref":"تخريج المسند لشاكر 10/77","text":["هل تَدرونَ ",["أوَّلَ من يدخلُ الجنَّةَ",2]," مِن خلقِ اللَّهِ ؟ قالوا : اللَّهُ ورسولُهُ أعلمُ قالَ : أوَّلُ من يدخلُ الجنَّةَ من خلقِ اللَّهِ ",["الفقراءُ والمُهاجرونَ ، الَّذينَ تسدُّ بِهِمُ الثُّغورُ ، ويتَّقى بِهِمُ المَكارِهُ",1]," ، ويموتُ أحدُهُم وحاجتُهُ في صدرِهِ ، لا يَستطيعُ لَها قضاءً فيقولُ اللَّهُ عزَّ وجلَّ لمن يشاءُ من ملائِكَتِهِ : ائتوهم فحيُّوهم ، فتقولُ الملائِكَةُ : نحنُ سُكَّانُ سمائِكَ ، وخيرتُكَ من خلقِكَ ، أفتأمرُنا أن نأتيَ هؤلاءِ فنسلِّمَ عليهِم ؟ قالَ : إنَّهم كانوا عبادًا يعبُدوني ، لا يُشرِكونَ بي شيئًا ، وتسدُّ بِهِمُ الثُّغورُ ، ويتَّقى بِهِمُ المَكارِهُ ويموتُ أحدُهُم ، وحاجتُهُ في صدرِهِ ، لا يستطيعُ لَها قضاءً قالَ : فتأتيهمُ الملائِكَةُ عندَ ذلِكَ ، فيدخُلونَ عليهم من كلِّ بابٍ :  سَلَامٌ عَلَيْكُمْ بِمَا صَبَرْتُمْ فَنِعْمَ عُقْبَى الدَّارِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6570) واللفظ له، وابن حبان (7421)، والطبراني (14/113) (14734) باختلاف يسير.","bab":"مناقب وفضائل › فضائل المهاجرين ومناقبهم","dorar":"GrV5tuGU"},{"id":"س-01512","fp":"d73a95624ba0","stateId":673,"easy":"إذا رفعت صوتك بالأذان ← لا يسمع مدى صوتك جن ولا إنس ولا شيء إلا شهد لك","cause":"فارْفَعْ صَوْتَك بالنِّداءِ","result":"فإنَّه لا يَسمَعُ مَدى صَوْتِ المُؤَذِّنِ جِنٌّ ولا إنْسٌ ولا شيءٌ إلَّا شَهِدَ له يَوْمَ القِيامةِ","explicit":true,"star":true,"apply":{"k":"time","t":"عند الأذان"},"similar":["س-01519","س-01511"],"ref":"الأحكام الوسطى 1/ 312","srcLabel":"البخاري","text":["عن عَبْدِ الرَّحْمنِ بنِ عَبْدِ اللهِ بنِ عَبْدِ الرَّحْمنِ بنِ أبي صَعْصَعةَ الأنْصاريِّ ثُمَّ المازِنيِّ، عن أبيه: أنَّه أَخبَرَه أنَّ أبا سَعيدٍ الخُدْريَّ قالَ له: إنِّي أراك تُحِبُّ الغَنَمَ والبادِيةَ، فإذا كُنْتَ في غَنَمِك وبادِيتِك ",["فارْفَعْ صَوْتَك بالنِّداءِ",1],"؛ ",["فإنَّه لا يَسمَعُ مَدى صَوْتِ المُؤَذِّنِ جِنٌّ ولا إنْسٌ ولا شيءٌ إلَّا شَهِدَ له يَوْمَ القِيامةِ",2],"، قالَ أبو سَعيدٍ: سَمِعْتُه مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (609)، والنسائي (644)، وأحمد (11305) واللفظ لهم.","bab":"أذان › فضل التأذين","dorar":"NLN3lpsg"},{"id":"س-01519","fp":"71f0a0e9cb1e","stateId":673,"easy":"إذا رفعت صوتك بالأذان ← يشهد لك كل من يسمعه","cause":"فارفَعْ صوتَكَ بالأذانِ","result":"ليس شيءٌ يَسمَعُه إلَّا شهِد له","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01512","ref":"تخريج المسند لشعيب 11031","text":["قال لي أبو سعيدٍ، وكان في حِجْرِه فقال لي: يا بُنَيَّ، إذا أَذَّنْتَ ",["فارفَعْ صوتَكَ بالأذانِ",1],"؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["ليس شيءٌ يَسمَعُه إلَّا شهِد له",2]," جِنٌّ، ولا إنسٌ، ولا حَجَرٌ\"، وقال مرَّةً: يا بُنَيَّ، إذا كُنْتَ في البَراريِّ، فارفَعْ صوتَكَ بالأذانِ؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"لا يَسمَعُه جِنٌّ، ولا إنسٌ، ولا حَجَرٌ، ولا شيءٌ يسمَعُه إلَّا شهِد له\"، قال أبي: \"وسُفيانُ يُخطِئُ في اسمِه، والصَّوابُ: عبدُ الرحمنِ بنُ عبدِ اللهِ بنِ عبدِ الرحمنِ بنِ أبي صَعْصَعةَ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (7548)، وابن ماجه (723)، وأحمد (11031) واللفظ له","bab":"أذان › فضل التأذين","dorar":"w11J5TSO"},{"id":"س-08406","fp":"2f7579c1ff3c","stateId":673,"easy":"إذا استلمت الحجر بحق ← يبعثه الله يوم القيامة له عينان ولسان يشهد لك","cause":"من استلمَهُ بحقٍّ","result":"ليبعثنَّهُ اللَّهُ يومَ القيامةِ لَهُ عينانِ يُبصِرُ بِهِما ، ولسانٌ ينطقُ بِهِ ، يَشهدُ على","explicit":true,"star":true,"similar":["س-00553","س-04330"],"ref":"الصحيح المسند 595","srcLabel":"مسلم","text":["قالَ رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلَى آلِهِ وسلَّمَ في الحجرِ : واللَّهِ ",["ليبعثنَّهُ اللَّهُ يومَ القيامةِ لَهُ عينانِ يُبصِرُ بِهِما ، ولسانٌ ينطقُ بِهِ ، يَشهدُ على",2]," ",["من استلمَهُ بحقٍّ",1]," ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (961) واللفظ له، وابن ماجه (2944)، وأحمد (2215)","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"hNsDqvnr","merged":2,"otherRefs":["صحيح الجامع 7098 (صحيح)"]},{"id":"س-00636","fp":"b3aa1e8d2197","stateId":673,"easy":"إذا عملت بالقرآن (البقرة وآل عمران) ← يجادلان عنك يوم القيامة","cause":"وأَهلُهُ الَّذينَ يعملونَ بِهِ في الدُّنيا","result":"تُجادِلانِ عن صاحبِهما","explicit":true,"similar":["س-01872","س-02895"],"ref":"صحيح الترمذي 2883","srcLabel":"مسلم","text":["يأتي القرآنُ ",["وأَهلُهُ الَّذينَ يعملونَ بِهِ في الدُّنيا",1]," تَقدمُهُ سورةُ البقرةِ وآلُ عمرانَ، قالَ نوَّاسٌ: وضربَ لَهما رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ثلاثةَ أمثالٍ ما نسيتُهنَّ بعدُ، قال: يأتيانِ كأنَّهما غيابتانِ وبينَهما شَرْقٌ، أو كأنَّهما غمامَتانِ سَوْداوانِ، أو كأنَّهما ظُلَّةٌ من طيرٍ صوافَّ ",["تُجادِلانِ عن صاحبِهما",2]],"grade":"صحيح","narrator":"النواس بن سمعان الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (805)، والترمذي (2883) واللفظ له، وأحمد (17637)","bab":"آداب عامة › ضرب الأمثال","dorar":"pwi3xG4L"},{"id":"س-00553","fp":"c895e3cbdcbb","stateId":673,"easy":"إذا استلمت الحجر الأسود بنية ← يأتي يوم القيامة يشهد لك","cause":"عَمَّنِ استَلَمَه بالنِّيَّةِ","result":"يَأتي الرُّكنُ يَومَ القِيامةِ أعظَمَ من أبي قُبَيسٍ له لِسانٌ وشَفَتانِ يَتكَلَّمُ","explicit":true,"repOf":"س-08406","ref":"المستدرك على الصحيحين 1702","text":[["يَأتي الرُّكنُ يَومَ القِيامةِ أعظَمَ من أبي قُبَيسٍ له لِسانٌ وشَفَتانِ يَتكَلَّمُ",2]," ",["عَمَّنِ استَلَمَه بالنِّيَّةِ",1],"، وهو يَمينُ اللهِ الَّتي يُصافِحُ بها خَلقَه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه ابن خزيمة (2737)، والبيهقي في ((الأسماء والصفات)) (729) كلاهما بلفظه، وأحمد (6978) ببعض لفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"xONZGCP8"},{"id":"س-01872","fp":"a149652bc699","stateId":673,"easy":"إذا قرأت البقرة وآل عمران ← تأتيان يوم القيامة كغمامتين تحاجّان عنك","cause":"أنَّ البقرةَ وآلَ عمرانَ","result":"يأتيانِ يومَ القيامةِ كأنهما غَمامتانِ أو كأنهما [ حزقانِ ] من طيرٍ صوافٍّ تُظِلَّانِ صاحبَهما","explicit":true,"repOf":"س-00636","ref":"العواصم من القواصم 246","text":[["أنَّ البقرةَ وآلَ عمرانَ",1]," معا ",["يأتيانِ يومَ القيامةِ كأنهما غَمامتانِ أو كأنهما [ حزقانِ ] من طيرٍ صوافٍّ تُظِلَّانِ صاحبَهما",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QErKEMH1"},{"id":"س-02895","fp":"0cfa80318af2","stateId":673,"easy":"إذا عملت بالقرآن ← تحاجّ عنك البقرة وآل عمران","cause":"وأهلِهِ الذينَ كانوا يَعمَلونَ بِهِ","result":"تُحاجَّانِ عن صاحِبِهِما","explicit":true,"repOf":"س-00636","ref":"كشف الخفاء 2/565","text":["حديث  يُؤتَى يومَ القيامَةِ بالقُرآنِ ",["وأهلِهِ الذينَ كانوا يَعمَلونَ بِهِ",1]," في الدُّنيا تقدمهم البقرة وآل عمران [يعني حديث: يُؤْتَى بالقُرْآنِ يَومَ القِيامَةِ وأَهْلِهِ الَّذِينَ كانُوا يَعْمَلُونَ به، تَقْدُمُهُ سُورَةُ البَقَرَةِ وآلُ عِمْرانَ، وضَرَبَ لهما رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ ثَلاثَةَ أمْثالٍ ما نَسِيتُهُنَّ بَعْدُ؛ قالَ: كَأنَّهُما غَمامَتانِ، أوْ ظُلَّتانِ سَوْداوانِ، بيْنَهُما شَرْقٌ، أوْ كَأنَّهُما حِزْقانِ مِن طَيْرٍ صَوافَّ ، ",["تُحاجَّانِ عن صاحِبِهِما",2],".]"],"grade":"صحيح","narrator":"[النواس بن سمعان الأنصاري]","muhaddith":"صحيح","bab":"إيمان › الوعد","dorar":"z01s6bs1"},{"id":"س-03848","fp":"927c51e20679","stateId":673,"easy":"إذا وصلت رحمك ← تشهد لك بالصلة يوم القيامة","cause":"إن كان وصلها","result":"تشهدُ له بصلةٍ","explicit":true,"otherNeedIds":[39],"ref":"صحيح الأدب المفرد 54","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عباسٍ أنه قال احفظوا أنسابَكم تصلوا أرحامَكم فإنه لا بعد بالرحمِ إذا قربت وإن كانت بعيدةً ولا قُربَ بها إذا بعدت وإن كانت قريبةً وكلُّ رحمٍ آتيةٌ يومَ القيامةِ أمام صاحبِها ",["تشهدُ له بصلةٍ",2]," ",["إن كان وصلها",1]," وعليه بقطيعةٍ إن كان قطعها"],"grade":"صحيح","muhaddith":"صحيح الإسناد وصح مرفوعا","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"woiNIi8Y"},{"id":"س-04330","fp":"1e1f43b1dd09","stateId":673,"easy":"إذا استلمت الحجر وقبلته ← يُبعث يوم القيامة مثل أحد يشهد لك","cause":"لمنِ استلمَهُ، وقبَّلَهُ","result":"يُبعَثُ يومَ القيامةِ مثلُ أُحُدٍ يشهدُ","explicit":true,"repOf":"س-08406","ref":"صحيح ابن خزيمة 4/ 382","text":["الحجرُ الأسوَدُ ياقوتةٌ بَيضاءُ من ياقوتِ الجنَّةِ، وإنَّما سوَّدتُهُ خطايا المشرِكينَ ",["يُبعَثُ يومَ القيامةِ مثلُ أُحُدٍ يشهدُ",2]," ",["لمنِ استلمَهُ، وقبَّلَهُ",1]," مِن أَهْلِ الدُّنيا"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (2795)، والطبراني (11314) (11/ 146)، والبيهقي في ((شعب الإيمان)) (3744) بلفظ مقارب","bab":"جنة › صفة الجنة","dorar":"kedeIx3T"},{"id":"س-01036","fp":"ea3e52523410","stateId":673,"easy":"إذا عقدت التسبيح بأناملك ← فهن مسؤولات مستنطقات يشهدن لك","cause":"واعْقِدْنَ بالأناملِ","result":"فإنَّهنَّ مَسؤولاتٌ مُسْتَنْطَقاتٌ","explicit":true,"similar":["س-00704"],"otherNeedIds":[45],"ref":"الحديث لابن عبدالوهاب 1/496","srcLabel":"الترمذي","text":["يا نِساءَ المُؤمناتِ، عليكنَّ بالتَّهليلِ والتَّسبيحِ والتَّقديسِ، ولا تَغفُلْنَ فتَنسَيْنَ الرَّحمةَ، ",["واعْقِدْنَ بالأناملِ",1],"؛ ",["فإنَّهنَّ مَسؤولاتٌ مُسْتَنْطَقاتٌ",2],"."],"grade":"حسن","narrator":"يسيرة بنت ياسر","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (3583) بلفظه، وابن سعد (8/ 310) وإسحاق بن راهويه (2327) بمعناه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"WO58NgnT","merged":2,"otherRefs":["نتائج الأفكار 1/87 (حسن)"]},{"id":"س-00704","fp":"35b083e0febd","stateId":673,"easy":"إذا عقدت التسبيح بأناملك ← فإنها مستنطقات تشهد لك","cause":"واعْقِدْنَ بِالأنامِلِ","result":"فإنَّها مُسْتَنْطَقَاتٌ","explicit":true,"repOf":"س-01036","otherNeedIds":[45],"ref":"تخريج الإحياء للعراقي 1/398","text":["عَلَيْكُنَّ بِالتَّسْبيحِ والتَّهْلِيلِ والتَّقْدِيسِ ولا تَغْفُلْنَ ",["واعْقِدْنَ بِالأنامِلِ",1]," ",["فإنَّها مُسْتَنْطَقَاتٌ",2]],"grade":"حسن","narrator":"يسيرة","muhaddith":"إسناده جيد","takhrij":"لم نقف عليه مسنداً.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"cEu9AcrU"},{"id":"س-02253","fp":"140888b588af","stateId":673,"easy":"إذا تعلمت آية من كتاب الله ← تستقبلك يوم القيامة تضحك في وجهك","cause":"مَنْ تَعَلَّمَ آيَةً من كتابِ اللهِ","result":"استقبَلَتْهُ يومَ القيامةِ تضحَكُ في وجهِهِ","explicit":true,"ref":"مجمع الزوائد 7/164","srcLabel":"الطبراني","text":[["مَنْ تَعَلَّمَ آيَةً من كتابِ اللهِ ",1],["استقبَلَتْهُ يومَ القيامةِ تضحَكُ في وجهِهِ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((الشاميين)) (3421)، والشجري في ((أماليه)) (577) واللفظ لهما.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"vNYvexwN"},{"id":"س-07878","fp":"a8e3860fcdc9","stateId":673,"easy":"إذا أشهدت الحجر الأسود خيراً ← يكون لك يوم القيامة شافعاً مشفّعاً","cause":"أَشهِدُوا هذا الحجرَ خيرًا","result":"فإنَّه يومَ القيامةِ شافعٌ مشفعٌ","explicit":true,"ref":"الجامع الصغير 1069","srcLabel":"الطبراني","text":[["أَشهِدُوا هذا الحجرَ خيرًا",1]," ، ",["فإنَّه يومَ القيامةِ شافعٌ مشفعٌ",2]," ، لهُ لسانٌ وشفتانِ يشهدُ لمن استلمَهُ"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (2971) واللفظ له.","bab":"قيامة › الشفاعة","dorar":"ZlougFj8"},{"id":"س-01511","fp":"c550d8071c58","stateId":673,"easy":"إذا رفعت صوتك بالأذان ← يشهد لك كل ما سمعه","cause":"فارفَعْ صَوتَكَ بالنِّداءِ","result":"لا يسمَعُ صَوتَهُ شجرٌ، ولا مدرٌ، ولا حجرٌ، ولا جنٌّ، ولا إنسٌ إلَّا شَهِدَ لَهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01512","ref":"صحيح ابن خزيمة 1/ 477","text":["إذا كنتَ في البَوادي ",["فارفَعْ صَوتَكَ بالنِّداءِ",1]," فإنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["لا يسمَعُ صَوتَهُ شجرٌ، ولا مدرٌ، ولا حجرٌ، ولا جنٌّ، ولا إنسٌ إلَّا شَهِدَ لَهُ",2]," - وَفي رِوايةٍ - وَكانَ يتيمًا في حِجرِ أبي سعيدٍ، وَكانت أمُّهُ عندَ أبي سعيدٍ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (609)، والنسائي (644)، وابن ماجه (723) باختلاف يسير.","bab":"أذان › فضل التأذين","dorar":"P0xdASJd"}]}