{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":24,"stateIds":[245,246,247,248,249,250,251,252,253,254,255,256,257,258,259,260],"items":[{"id":"ق-0282","fp":"f350d4679c18","stateId":245,"easy":"الإيمان بالله والاعتصام به ← رحمة من الله وفضل وهداية صراط مستقيم","cause":"الإيمان بالله والاعتصام به","result":"رحمة من الله وفضل وهداية صراط مستقيم","explicit":true,"star":true,"otherNeedIds":[1,15],"ref":"سورة النساء: 175","srcLabel":"القرآن الكريم","quran":{"s":4,"from":175,"to":175,"text":"فَأَمَّا الَّذِينَ آمَنُوا بِاللَّهِ وَاعْتَصَمُوا بِهِ فَسَيُدْخِلُهُمْ فِي رَحْمَةٍ مِنْهُ وَفَضْلٍ وَيَهْدِيهِمْ إِلَيْهِ صِرَاطًا مُسْتَقِيمًا (175)","hl":[[0,146,1]]}},{"id":"ق-0726","fp":"d113ab9b180b","stateId":245,"easy":"اعتزال الشرك وأهله فراراً بالدين ← نشر الرحمة وتهيئة المِرفق","cause":"اعتزال الشرك وأهله فراراً بالدين","result":"نشر الرحمة وتهيئة المِرفق","explicit":true,"otherNeedIds":[54,4],"ref":"سورة الكهف: 16","srcLabel":"القرآن الكريم","quran":{"s":18,"from":16,"to":16,"text":"وَإِذِ اعْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا اللَّهَ فَأْوُوا إِلَى الْكَهْفِ يَنْشُرْ لَكُمْ رَبُّكُمْ مِنْ رَحْمَتِهِ وَيُهَيِّئْ لَكُمْ مِنْ أَمْرِكُمْ مِرْفَقًا (16)","hl":[[0,170,1]]}},{"id":"ق-1189","fp":"c84aa6e4c41a","stateId":245,"easy":"الإيمان والعمل الصالح ← دخول رحمة الله والفوز المبين","cause":"الإيمان والعمل الصالح","result":"دخول رحمة الله والفوز المبين","explicit":true,"otherNeedIds":[53],"ref":"سورة الجاثية: 30","srcLabel":"القرآن الكريم","quran":{"s":45,"from":30,"to":30,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُدْخِلُهُمْ رَبُّهُمْ فِي رَحْمَتِهِ ذَلِكَ هُوَ الْفَوْزُ الْمُبِينُ (30)","hl":[[0,124,1]]}},{"id":"س-02416","fp":"a112f2aa2fba","stateId":245,"easy":"إذا آمنت بالنبي ﷺ ← تمت لك الرحمة في الدنيا والآخرة","cause":"مَن آمَنَ به","result":"تَمَّتْ له الرَّحْمةُ في الدُّنْيا والآخِرةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحاديث المختارة 10 / 398","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ «في قَوْلِ اللهِ عَزَّ وجَلَّ: {وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِلْعَالَمِينَ} قالَ: ",["مَن آمَنَ به",1]," ",["تَمَّتْ له الرَّحْمةُ في الدُّنْيا والآخِرةِ",2],"، ومَن كَفَرَ به صُرِفَتْ عنه العُقوبةُ الَّتي كانَ يُعاقَبُ بها الأُمَمُ، يَعْني في الدُّنْيا»."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إسلام › فضل الشهادتين","dorar":"ATuqUC5j"},{"id":"ق-0594","fp":"de8e29e1233e","stateId":245,"easy":"الاستغفار والتوبة ← رحمة الله وودّه","cause":"الاستغفار والتوبة","result":"رحمة الله وودّه","explicit":true,"star":true,"similar":["ق-0902"],"otherNeedIds":[23],"ref":"سورة هود: 90","srcLabel":"القرآن الكريم","quran":{"s":11,"from":90,"to":90,"text":"وَاسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ إِنَّ رَبِّي رَحِيمٌ وَدُودٌ (90)","hl":[[0,77,1]]}},{"id":"ق-0902","fp":"99d644059c3e","stateId":245,"easy":"الاستغفار ← رحمة الله","cause":"الاستغفار","result":"رحمة الله","explicit":true,"repOf":"ق-0594","otherNeedIds":[11],"ref":"سورة النمل: 46","quran":{"s":27,"from":46,"to":46,"text":"قَالَ يَا قَوْمِ لِمَ تَسْتَعْجِلُونَ بِالسَّيِّئَةِ قَبْلَ الْحَسَنَةِ لَوْلَا تَسْتَغْفِرُونَ اللَّهَ لَعَلَّكُمْ تُرْحَمُونَ (46)","hl":[[72,127,1]]}},{"id":"ق-0162","fp":"6dbfbbfebed6","stateId":245,"easy":"طاعة الله والرسول ← رحمة الله","cause":"طاعة الله والرسول","result":"رحمة الله","explicit":true,"star":true,"ref":"سورة آل عمران: 132","srcLabel":"القرآن الكريم","quran":{"s":3,"from":132,"to":132,"text":"وَأَطِيعُوا اللَّهَ وَالرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ (132)","hl":[[0,56,1]]}},{"id":"س-05931","fp":"3e777581fcb9","stateId":245,"easy":"إذا لزمت الجماعة ← فالجماعة رحمة","cause":"الجماعةُ","result":"رحمةٌ","explicit":true,"star":true,"ref":"تخريج كتاب السنة 895","srcLabel":"أبن","text":["أن النبيَّ خطب فقال : ",["الجماعةُ",1]," ",["رحمةٌ",2]," والفُرقةُ عذابٌ"],"grade":"حسن","narrator":"النعمان بن بشير","muhaddith":"إسناده حسن","takhrij":"أخرجه أبن أبي عاصم في ((السنة)) (895)، وابن بطة في ((الإبانة)) (117)، والقضاعي في ((مسند الشهاب)) (15) جميعا بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4oZliEJJ"},{"id":"س-07240","fp":"0e048a2d69ef","stateId":246,"easy":"إذا دمت على حالك عند الذكر ← تصافحك الملائكة في فراشك وطرقك","cause":"لَو تَدومونَ على ما تَكونونَ عِندي وفي الذِّكرِ","result":"لَصافَحَتكُمُ المَلائِكةُ على فُرُشِكُم وفي طُرُقِكُم","explicit":true,"star":true,"otherNeedIds":[17],"ref":"صحيح مسلم 2750","srcLabel":"متفق عليه","text":["أنَّ حَنظَلةَ الأُسَيديَّ -وكان مِن كُتَّابِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم- قال: لَقيَني أبو بَكرٍ، فقال: كيفَ أنتَ يا حَنظَلةُ؟ قال: قُلتُ: نافَقَ حَنظَلةُ، قال: سُبحانَ اللهِ! ما تَقولُ؟ قال: قُلتُ: نَكونُ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يُذَكِّرُنا بالنَّارِ والجَنَّةِ، حتَّى كَأنَّا رَأيُ عَينٍ، فإذا خَرَجنا مِن عِندِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم عافَسنا الأزواجَ والأولادَ والضَّيعاتِ، فنَسينا كَثيرًا، قال أبو بَكرٍ: فواللهِ إنَّا لَنَلقى مِثلَ هذا، فانطَلَقتُ أنا وأبو بَكرٍ حتَّى دَخَلنا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، قُلتُ: نافَقَ حَنظَلةُ، يا رَسولَ اللهِ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: وما ذاكَ؟ قُلتُ: يا رَسولَ اللهِ، نَكونُ عِندَكَ، تُذَكِّرُنا بالنَّارِ والجَنَّةِ حتَّى كَأنَّا رَأيُ عَينٍ، فإذا خَرَجنا مِن عِندِكَ عافَسنا الأزواجَ والأولادَ والضَّيعاتِ، نَسينا كَثيرًا، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: والذي نَفسي بيَدِه، إن ",["لَو تَدومونَ على ما تَكونونَ عِندي وفي الذِّكرِ",1],"، ",["لَصافَحَتكُمُ المَلائِكةُ على فُرُشِكُم وفي طُرُقِكُم",2],"، ولَكِن يا حَنظَلةُ ساعةً وساعةً، ثَلاثَ مَرَّاتٍ."],"grade":"صحيح","narrator":"حنظلة بن الربيع الكاتب الأسيدي","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"علم › فضل مجالس العلم والذكر","dorar":"k91EbvoF","merged":17,"otherRefs":["صحيح الجامع 7073 (صحيح)","تخريج صحيح ابن حبان 344 (صحيح)","السلسلة الصحيحة 3020 (صحيح)","الصحيح المسند 2/366 (صحيح)","صحيح مسلم 2750 (صحيح)","صحيح ابن ماجه 3436 (صحيح)","صحيح الترمذي 2452 (صحيح)","السلسلة الصحيحة 2235 (صحيح)","صحيح الترمذي 2526 (صحيح)","الأحاديث المختارة 2469 (صحيح)","الأحاديث المختارة 1615 (صحيح)","علل الدارقطني 2258 (صحيح)","تخريج المسند لشعيب 19046 (صحيح)","تخريج المسند لشعيب 19045 (صحيح)","تخريج المسند لشعيب 12796 (صحيح)","صحيح الترمذي 2514 (صحيح)"]},{"id":"س-07242","fp":"b6b24f857017","stateId":246,"easy":"إذا اجتمعتم تذكرون الله ← تحفّكم الملائكة وتغشاكم الرحمة وتنزل عليكم السكينة","cause":"ما اجتَمَعَ قَومٌ يَذكُرون اللهَ","result":"إلَّا حَفَّتْهمُ الملائكةُ، وتَغَشَّتْهمُ الرَّحْمةُ، ونَزَلَتْ عليهم السَّكينةُ، وذَكَرَهمُ اللهُ فيمَن عِندَه","explicit":true,"star":true,"otherNeedIds":[5,26],"ref":"تخريج المسند لشعيب 11892","srcLabel":"متفق عليه","text":[["ما اجتَمَعَ قَومٌ يَذكُرون اللهَ",1]," ",["إلَّا حَفَّتْهمُ الملائكةُ، وتَغَشَّتْهمُ الرَّحْمةُ، ونَزَلَتْ عليهم السَّكينةُ، وذَكَرَهمُ اللهُ فيمَن عِندَه",2],"، وقال: إنَّ اللهَ يُمهِلُ حتى إذا كان ثُلُثُ اللَّيلِ الآخِرُ، نَزَلَ اللهُ عزَّ وجلَّ إلى هذه السَّماءِ، فنادَى: هل من مُذنِبٍ يَتوبُ؟ هل من مُستَغْفِرٍ؟ هل من داعٍ؟ هل من سائِلٍ؟ إلى الفَجْرِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري وأبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1145)، وأبو داود (1315)، والترمذي (446)، والنسائي في ((السنن الكبرى)) (10319) بنحوه من حديث أبي هريرة، ومسلم (758، 2699) مفرقاً، وابن ماجه (3791، 1366) مفرقاً، وأحمد (11892) واللفظ له","bab":"علم › فضل مجالس العلم والذكر","dorar":"7ZWQDN7i","merged":4,"otherRefs":["صحيح ابن ماجه 3073 (صحيح)","صحيح الجامع 7757 (صحيح)","تخريج المسند لشعيب 11287 (صحيح)"]},{"id":"س-08134","fp":"e346b35f86e6","stateId":246,"easy":"إذا جلست في مجلس ذكر ← تحفّكم الملائكة بأجنحتها","cause":"مَجلِسًا فيه ذِكرٌ","result":"قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا","explicit":true,"star":true,"ref":"صحيح مسلم 2689","srcLabel":"البخاري","text":["إنَّ للَّهِ تَبارَكَ وتَعالى مَلائِكةً سَيَّارةً فُضُلًا يَتَبَّعونَ مَجالِسَ الذِّكرِ، فإذا وجَدوا ",["مَجلِسًا فيه ذِكرٌ",1]," ",["قَعَدوا معهُم، وحَفَّ بَعضُهم بَعضًا بأجنِحَتِهم، حتَّى يَملَؤوا ما بينَهم وبينَ السَّماءِ الدُّنيا",2],"، فإذا تَفَرَّقوا عَرَجوا وصَعِدوا إلى السَّماءِ، قال: فيَسألُهمُ اللهُ عَزَّ وجَلَّ، وهو أعلَمُ بهم: مِن أينَ جِئتُم؟ فيَقولونَ: جِئنا مِن عِندِ عِبادٍ لكَ في الأرضِ، يُسَبِّحونَكَ ويُكَبِّرونَكَ ويُهَلِّلونَكَ ويَحمَدونَكَ ويَسألونَكَ، قال: وماذا يَسألوني؟ قالوا: يَسألونَكَ جَنَّتَكَ، قال: وهل رَأوا جَنَّتي؟ قالوا: لا، أي رَبِّ، قال: فكيفَ لو رَأوا جَنَّتي؟ قالوا: ويَستَجيرونَكَ، قال: ومِمَّ يَستَجيرونَني؟ قالوا: مِن نارِكَ يا رَبِّ، قال: وهل رَأوا ناري؟ قالوا: لا، قال: فكيفَ لو رَأوا ناري؟ قالوا: ويَستَغفِرونَكَ، قال: فيَقولُ: قد غَفَرتُ لهم فأعطَيتُهم ما سَألوا، وأجَرتُهم ممَّا استَجاروا، قال: فيَقولونَ: رَبِّ، فيهم فُلانٌ عَبدٌ خَطَّاءٌ، إنَّما مَرَّ فجَلَسَ معهُم، قال: فيَقولُ: وله غَفَرتُ، هُمُ القَومُ لا يَشقى بهم جَليسُهم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6408) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"vgLc7Z6G"},{"id":"ق-0995","fp":"fd123af92968","stateId":246,"easy":"ذكر الله كثيراً وتسبيحه بكرة وأصيلاً ← صلاة الله وملائكته والإخراج من الظلمات إلى النور","cause":"ذكر الله كثيراً وتسبيحه بكرة وأصيلاً","result":"صلاة الله وملائكته والإخراج من الظلمات إلى النور","explicit":true,"otherNeedIds":[26,15],"ref":"سورة الأحزاب: 41–43","srcLabel":"القرآن الكريم","quran":{"s":33,"from":41,"to":43,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا (41) وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا (42) هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا (43)","hl":[[0,239,1]]}},{"id":"س-01035","fp":"673c05d10585","stateId":246,"easy":"إذا لزمت التهليل والتسبيح والتقديس ← لا تُحرم الرحمة","cause":"عليكنَّ بالتَّهليلِ والتَّسبيحِ والتَّقديسِ","result":"ولا تَغفُلْنَ فتَنسَيْنَ الرَّحمةَ","explicit":true,"ref":"الحديث لابن عبدالوهاب 1/496","srcLabel":"الترمذي","text":["يا نِساءَ المُؤمناتِ، ",["عليكنَّ بالتَّهليلِ والتَّسبيحِ والتَّقديسِ",1],"، ",["ولا تَغفُلْنَ فتَنسَيْنَ الرَّحمةَ",2],"، واعْقِدْنَ بالأناملِ؛ فإنَّهنَّ مَسؤولاتٌ مُسْتَنْطَقاتٌ."],"grade":"حسن","narrator":"يسيرة بنت ياسر","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (3583) بلفظه، وابن سعد (8/ 310) وإسحاق بن راهويه (2327) بمعناه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"WO58NgnT","merged":2,"otherRefs":["صحيح الجامع 4087 (حسن)"]},{"id":"س-00833","fp":"b9da404a3c6b","stateId":246,"easy":"إذا قلت «الحمد لله كثيراً» ← يقول الله: اكتبوا لعبدي رحمتي كثيراً","cause":"إذا قال العبدُ : الحمدُ للهِ كثيرًا","result":"قال اللهُ تعالى : اكتُبوا لعَبدي رَحمتي كثيرًا","explicit":true,"apply":{"k":"say","t":"«الحمد لله كثيراً»"},"ref":"صحيح الترغيب 1578","srcLabel":"الطبراني","text":[["إذا قال العبدُ : ( الحمدُ للهِ كثيرًا ) ؛ ",1],["قال اللهُ تعالى : اكتُبوا لعَبدي رَحمتي كثيرًا ",2],"."],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((الدعاء)) (1685)","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"dQW6h6Hw"},{"id":"س-00991","fp":"4b812feeef2d","stateId":246,"easy":"إذا جلست في جماعة تذكر الله ← تنزل عليك الرحمة","cause":"في عِصابَةٍ يَذْكُرونَ اللَّهَ","result":"فإنِّي رَأَيْتُ الرَّحْمةَ تَنزِلُ عَلَيْكُمْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 424","srcLabel":"أبو نعيم","text":["عنْ أَبي عُثْمانَ، عنْ سَلْمانَ الفارِسيِّ قالَ: كان سَلْمانُ ",["في عِصابَةٍ يَذْكُرونَ اللَّهَ",1],"، فَمَرَّ بهِمْ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فَجاءَ نَحْوَهُمْ قاصِدًا حتَّى دَنا مِنْهُمْ، فَكَفُّوا عنِ الحَديثِ؛ إعْظامًا لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: «ما كُنْتُمْ تَقولونَ؟ ",["فإنِّي رَأَيْتُ الرَّحْمةَ تَنزِلُ عَلَيْكُمْ",2],"؛ فَأَحْبَبْتُ أنْ أُشاركَكُمْ فيها»."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (1/ 342) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"wsYv2Ccy"},{"id":"س-00993","fp":"8f7031a8cd60","stateId":246,"easy":"إذا ذكرت الله كثيراً وسبّحته بكرة وأصيلاً ← تصلّي عليك الملائكة","cause":"اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا (41) وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا","result":"لوْ شئتُم صَلَّتْ عليكم الملائكةُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"المستدرك على الصحيحين 3611","srcLabel":"مسلم","text":["جاءَ رجلٌ إلى أبي أُمامةَ رَضيَ اللهُ عنه، فقالَ: يا أبا أُمامةَ، إنِّي رأيتُ في مَنامي أنَّ الملائكةَ تُصلِّي عليكَ كلَّما دَخَلْتَ، وكلَّما خَرَجْتُ، وكلَّما قُمتَ، وكلَّما جَلَسْتَ. قالَ أبو أُمامةَ: اللَّهُمَّ غُفرًا، دَعونا عنكم، وأنتم ",["لوْ شئتُم صَلَّتْ عليكم الملائكةُ",2],"، ثُمَّ قَرَأَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا ",["اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا (41) وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا",1]," (42) هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا} [الأحزاب: 41 - 43]."],"grade":"صحيح","narrator":"سليم بن عامر","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (7/ 25)، وابن عساكر في ((تاريخ دمشق)) (24/ 66) بلفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"s22xmIBA"},{"id":"س-01026","fp":"06878e75b499","stateId":246,"easy":"إذا قلت «سبحان الله والحمد لله ولا إله إلا الله والله أكبر وتبارك الله» ← يرفعها ملك إلى السماء","cause":"إذا قالَ: سُبحانَ اللهِ والحَمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ وتَبارَكَ اللهُ","result":"قَبَضَ عليهِنَّ مَلَكٌ فضَمَّهُنَّ تَحتَ جَناحِه وصَعَدَ بهِنَّ لا يَمُرُّ بهِنَّ على جَمعٍ مِنَ المَلائِكةِ إلَّا استَغفَروا لِقائِلِهِنَّ حتى يُحَيَّى بهِنَّ وَجهُ الرَّحمنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر وتبارك الله»"},"otherNeedIds":[51],"ref":"الترغيب والترهيب 2/356","srcLabel":"الحاكم","text":["عن عَبدِ اللهِ بنِ مَسعودٍ رَضيَ اللهُ عنه قالَ: إذا حَدَّثتُكم بحَديثٍ أتيناكم بتَصديقِ ذلك في كِتابِ اللهِ، إنَّ العَبدَ ",["إذا قالَ: سُبحانَ اللهِ والحَمدُ للهِ ولا إلهَ إلَّا اللهُ واللهُ أكبَرُ وتَبارَكَ اللهُ",1],"، ",["قَبَضَ عليهِنَّ مَلَكٌ فضَمَّهُنَّ تَحتَ جَناحِه وصَعَدَ بهِنَّ لا يَمُرُّ بهِنَّ على جَمعٍ مِنَ المَلائِكةِ إلَّا استَغفَروا لِقائِلِهِنَّ حتى يُحَيَّى بهِنَّ وَجهُ الرَّحمنِ",2],"، ثم تَلا عَبدُ اللهِ {إِلَيْهِ يَصْعَدُ الْكَلِمُ الطَّيِّبُ وَالْعَمَلُ الصَّالِحُ يَرْفَعُهُ} [فاطر: 10]."],"grade":"صحيح","narrator":"[المخارق بن سليم]","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه مسدد كما في ((المطالب العالية)) لابن حجر (3406)، والطبراني (9/233) (9144)، والحاكم (3589) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"ZGZAX74E"},{"id":"س-00760","fp":"71ba1a9c6655","stateId":246,"easy":"إذا جلست تعظّم آلاء الله وتتلو كتابه وتصلي على نبيه ← تغشاك رحمة الله","cause":"يُعظِّمونَ آلاءَكَ، ويَتْلونَ كتابَكَ، ويُصلُّونَ على نبِيِّكَ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ، ويَسألونَكَ لآخِرتِهم ودُنْياهم","result":"غَشُّوهم رَحْمتي","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 10/80","srcLabel":"البزار","text":["إنَّ للهِ سَيَّارةً مِن الملائكةِ يطلُبونَ حِلَقَ الذِّكْرِ، فإذا [فإذا أتَوْا عليهم حَفُّوا بهم] ، ثمَّ بعَثوا رائدَهم إلى السماءِ، إلى ربِّ العِزَّةِ تبارَكَ وتعالى، فيقولونَ: ربَّنا أَتَيْنا على عِبادٍ مِن عِبادِكَ، ",["يُعظِّمونَ آلاءَكَ، ويَتْلونَ كتابَكَ، ويُصلُّونَ على نبِيِّكَ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ، ويَسألونَكَ لآخِرتِهم ودُنْياهم",1],"، فيقولُ تبارَكَ وتعالى: ",["غَشُّوهم رَحْمتي",2],". فيقولونَ: يا ربِّ، إنَّ فيهم فلانًا الخَطَّاءَ، إنَّما اعتَنقَهم اعتِناقًا، فيقولُ تبارَكَ وتعالى: غَشُّوهم رَحْمتي، فهم الجُلَساءُ لا يَشْقى بهم جَليسُهم."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (6494)، وأبو نعيم في ((حلية الأولياء)) (6/ 268)، وابن حجر في ((نتائج الأفكار)) (1/ 24) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"uX8NjDlD"},{"id":"س-00761","fp":"c857f028b427","stateId":246,"easy":"إذا جالست الذاكرين ولو كنت مذنباً ← تغشاك الرحمة معهم","cause":"فلانًا الخَطَّاءَ، إنَّما اعتَنقَهم اعتِناقًا","result":"غَشُّوهم رَحْمتي، فهم الجُلَساءُ لا يَشْقى بهم جَليسُهم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[53],"ref":"مجمع الزوائد 10/80","srcLabel":"البزار","text":["إنَّ للهِ سَيَّارةً مِن الملائكةِ يطلُبونَ حِلَقَ الذِّكْرِ، فإذا [فإذا أتَوْا عليهم حَفُّوا بهم] ، ثمَّ بعَثوا رائدَهم إلى السماءِ، إلى ربِّ العِزَّةِ تبارَكَ وتعالى، فيقولونَ: ربَّنا أَتَيْنا على عِبادٍ مِن عِبادِكَ، يُعظِّمونَ آلاءَكَ، ويَتْلونَ كتابَكَ، ويُصلُّونَ على نبِيِّكَ محمَّدٍ صلَّى اللهُ عليه وسلَّمَ، ويَسألونَكَ لآخِرتِهم ودُنْياهم، فيقولُ تبارَكَ وتعالى: غَشُّوهم رَحْمتي. فيقولونَ: يا ربِّ، إنَّ فيهم ",["فلانًا الخَطَّاءَ، إنَّما اعتَنقَهم اعتِناقًا",1],"، فيقولُ تبارَكَ وتعالى: ",["غَشُّوهم رَحْمتي، فهم الجُلَساءُ لا يَشْقى بهم جَليسُهم",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (6494)، وأبو نعيم في ((حلية الأولياء)) (6/ 268)، وابن حجر في ((نتائج الأفكار)) (1/ 24) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"uX8NjDlD"},{"id":"ق-0406","fp":"ed5bef17fbd2","stateId":246,"easy":"الإحسان والدعاء خوفاً وطمعاً ← قرب رحمة الله","cause":"الإحسان والدعاء خوفاً وطمعاً","result":"قرب رحمة الله","explicit":true,"star":true,"otherNeedIds":[29],"ref":"سورة الأعراف: 56","srcLabel":"القرآن الكريم","quran":{"s":7,"from":56,"to":56,"text":"وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا وَادْعُوهُ خَوْفًا وَطَمَعًا إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ (56)","hl":[[51,130,1]]}},{"id":"س-05839","fp":"8615c1cdfbdc","stateId":246,"easy":"إذا طلبت الخير وتعرضت لنفحات الله ← تصيبك رحمته","cause":"اطْلُبوا الخَيْرَ، وتَعَرَّضوا لنَفَحاتِ اللهِ","result":"فإنَّ للهِ نَفَحاتٍ مِن رَحْمتِه يُصيبُ بِها مَن يَشاءُ","explicit":true,"ref":"الأحكام الوسطى 4/ 325","srcLabel":"الأحكام الوسطى","text":["\"",["اطْلُبوا الخَيْرَ، وتَعَرَّضوا لنَفَحاتِ اللهِ؛ ",1],["فإنَّ للهِ نَفَحاتٍ مِن رَحْمتِه يُصيبُ بِها مَن يَشاءُ",2],"، وسَلوا اللهَ أن يَستُرَ عَوْراتِكم، ويُؤمِنَ رَوْعاتِكم\"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"fZJIgiKq"},{"id":"س-01921","fp":"998f0ba6a469","stateId":246,"easy":"إذا فُتح لك باب الدعاء ← فُتحت لك أبواب الرحمة","cause":"من فتحَ لهُ منكم بابُ الدُّعاءِ","result":"فتحت لهُ أبوابُ الرَّحمةِ","explicit":true,"ref":"هداية الرواة 2/411","srcLabel":"الترمذي","text":[["من فتحَ لهُ منكم بابُ الدُّعاءِ ",1],["فتحت لهُ أبوابُ الرَّحمةِ",2]," وما سُئلَ اللَّهُ شيئًا يعني أحبَّ إليهِ من أن يسألَ العافية"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (3548) واللفظ له، والعقيلي في ((الضعفاء الكبير)) (2/324) مختصراً، والحاكم (1833) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"eFyk0Mth"},{"id":"س-00113","fp":"d716ffda83fb","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويرفعك عشر درجات","cause":"من صلَّى عليك من أُمَّتِك واحِدةً","result":"صَلَّى اللهُ عليه عَشْرًا ورفَعَهَ بها عَشْرَ دَرَجاتٍ","explicit":true,"star":true,"similar":["س-02299","س-00110","س-01527","س-01531","س-08178","س-00111","س-00730","س-02018","س-03412","س-03413","س-04705","س-02741","س-08159","س-08125","س-08164","س-08196"],"otherNeedIds":[47,11],"ref":"الأحاديث المختارة 93","srcLabel":"متفق عليه","text":["«خرج رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لحاجتِه، فلم يجِدْ أحدًا يَتْبَعُه، ففَزِعَ عُمَرُ فأتاه بمِطهَرةٍ مِن خَلْفِه، فوجد النَّبيَّ صلَّى اللهُ عليه وسلَّم ساجِدًا في شَرَبةٍ، فتنحَّى عنه مِن خَلْفِه حتَّى رفع النَّبيُّ صلَّى اللهُ عليه وسلَّم رأسَه، فقال: أحسَنْتَ يا عُمَرُ حيثُ وجَدْتَني ساجِدًا فتنحَّيتَ عني، إنَّ جِبريلَ عليه السَّلامُ أتاني، فقال: ",["من صلَّى عليك من أُمَّتِك واحِدةً ",1],["صَلَّى اللهُ عليه عَشْرًا ورفَعَهَ بها عَشْرَ دَرَجاتٍ»",2],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"fIrV2hCu","merged":2,"otherRefs":["الأربعون العشارية 202 (حسن)"]},{"id":"س-02299","fp":"6838c1b327e9","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً","cause":"ومن صلَّى علَيَّ واحِدةً","result":"صَلَّيتُ عليه عَشْرًا","explicit":true,"repOf":"س-00113","ref":"الأحاديث المختارة 1567","text":["«من ذَكَرني فلْيُصَلِّ عَلَيَّ، ",["ومن صلَّى علَيَّ واحِدةً",1]," ",["صَلَّيتُ عليه عَشْرًا",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HjxGQESR","merged":2,"otherRefs":["مجمع الزوائد 10/166 (حسن)"]},{"id":"س-07634","fp":"7aef9b84cf1e","stateId":247,"easy":"إذا سلّمت على النبي ﷺ ← يسلّم الله عليك","cause":"مَن سلَّمَ عليك","result":"سلَّمَ اللهُ عليه","explicit":true,"star":true,"similar":["س-00112"],"ref":"الأحاديث المختارة 928","srcLabel":"البخاري","text":["«رَأيْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سَجَدَ سَجْدةً فأطالَ، فرَفَعَ رأسَه، فسَألْتُه عن ذلك فقال: إنَّ جِبْريلَ لَقِيَني فقالَ: مَن صلَّى عليك صلَّى اللهُ عليه، و",["مَن سلَّمَ عليك",1]," ",["سلَّمَ اللهُ عليه",2],"، قالَ: أَحسَبُه عَشْرًا. قالَ: فسَجَدْتُ للهِ شُكْرًا»."],"grade":"صحيح","narrator":"عبد الرحمن بن عوف","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فضائل النبي وصفته ودلائل النبوة › نزول الوحي عليه صلى الله عليه وسلم","dorar":"xjCoKtS0","merged":2,"otherRefs":["الأحاديث المختارة 932 (صحيح)"]},{"id":"س-08223","fp":"d3d5924bc96e","stateId":247,"easy":"إذا صليت على النبي ﷺ ← تصلي عليك الملائكة ما دمت تصلي عليه","cause":"ما مِن مُسلِمٍ يُصَلِّي عليَّ صَلاةً","result":"إلَّا صلَّتْ عليه المَلائِكةُ ما صلَّى عليَّ، فلْيُقِلَّ مِن ذلك أو لِيُكْثِرْ","explicit":true,"ref":"الأحاديث المختارة 8 / 190","srcLabel":"متفق عليه","text":["«",["ما مِن مُسلِمٍ يُصَلِّي عليَّ صَلاةً",1]," ",["إلَّا صلَّتْ عليه المَلائِكةُ ما صلَّى عليَّ، فلْيُقِلَّ مِن ذلك أو لِيُكْثِرْ»)",2],"."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"fQdot4uq","merged":2,"otherRefs":["تخريج المسند لشعيب 15680 (حسن)"]},{"id":"س-00110","fp":"60d1417f81f4","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يصلي الله عليك","cause":"مَن صلَّى عليك مِنهم صَلاةً","result":"صلَّى اللهُ عليه","explicit":true,"repOf":"س-00113","ref":"الأحاديث المختارة 932","text":["«خَرَجَ عليهم يَوْمًا وفي وَجْهِه البِشْرُ، فقالَ: إنَّ جِبْريلَ جاءَني، فقالَ: أَلَا أُبَشِّرُك يا مُحَمَّدُ بما أَعْطاك اللهُ مِن أمَّتِك، وما أَعْطى أمَّتَك مِنك؟ ",["مَن صلَّى عليك مِنهم صَلاةً",1]," ",["صلَّى اللهُ عليه",2],"، ومَن سلَّمَ عليك سلَّمَ اللهُ عليه»."],"grade":"صحيح","narrator":"عبد الرحمن بن عوف","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"a6S5ju25"},{"id":"س-01527","fp":"1239140ea53d","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً","cause":"مَن صلَّى عليَّ صلاةً","result":"صلَّى اللَّهُ عليهِ عَشرًا","explicit":true,"repOf":"س-00113","ref":"صحيح ابن خزيمة 1/ 499","text":["إذا سَمِعْتُمُ المؤذِّنَ فَقولوا مثلَ ما يقولُ، ثُمَّ صلُّوا عليَّ فإنَّهُ ",["مَن صلَّى عليَّ صلاةً ",1],["صلَّى اللَّهُ عليهِ عَشرًا",2],"، ثمَّ سلوا اللَّهَ ليَ الوسيلةَ، وإنَّها درجةٌ في الجنَّةِ لا تنبَغي إلَّا لِعبدٍ من عبَّادِ اللَّهِ، فمن سألَ ليَ الوسيلةَ حلَّت لَهُ الشَّفاعةُ - وفي روايةٍ - قالَ: وأرجو أن أَكونَ أَنا هوَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (384)، وأبو داود (523)، والنسائي (678) باختلاف يسير","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"B7NK0MAI","merged":2,"otherRefs":["الحديث لابن عبدالوهاب 2/166 (حسن)"]},{"id":"س-01531","fp":"774bb085bd70","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يصلي الله عليك عشراً","cause":"وصَلُّوا علَيَّ","result":"فإنَّه ليس أحَدٌ يُصلِّي علَيَّ صلاةً إلَّا صلَّى اللهُ عليه عَشْرًا وسَلُوا لي الوسيلةَ فإنَّ الوسيلةَ مَنزِلةٌ في الجنَّةِ ولا تنبغي أنْ تكونَ إلَّا لِعبدٍ مِن عبادِ اللهِ وأرجو أنْ أكونَ أنا","explicit":true,"repOf":"س-00113","ref":"تخريج صحيح ابن حبان 1691","text":["إذا سمِعْتُم المُؤذِّنُ فقولوا كما يقولُ ",["وصَلُّوا علَيَّ ",1],["فإنَّه ليس أحَدٌ يُصلِّي علَيَّ صلاةً إلَّا صلَّى اللهُ عليه عَشْرًا وسَلُوا لي الوسيلةَ فإنَّ الوسيلةَ مَنزِلةٌ في الجنَّةِ ولا تنبغي أنْ تكونَ إلَّا لِعبدٍ مِن عبادِ اللهِ وأرجو أنْ أكونَ أنا",2]," هو ومَن سأَلها لي حلَّتْ له شفاعتي يومَ القيامةِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (384) باختلاف يسير","bab":"أذان › ما يقول إذا سمع المؤذن","dorar":"mXEMo2RC"},{"id":"س-08144","fp":"7761c274b29a","stateId":247,"easy":"إذا سلّمت على النبي ﷺ ← تبلّغه الملائكة سلامك","cause":"عن أمَّتي السَّلامَ","result":"إنَّ للهِ ملائكةً سيَّاحينَ يبلغون","explicit":true,"ref":"مجمع الزوائد 9/27","srcLabel":"النسائي","text":[["إنَّ للهِ ملائكةً سيَّاحينَ يبلغون",2]," ",["عن أمَّتي السَّلامَ",1]," قال وقال رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم حياتي خيرٌ لكم تُحدِّثونَ ويُحدَّثُ لكم ووفاتي خيرٌ لكم تُعرَضُ عليَّ أعمالُكم فما رأَيْتُ من خيرٍ حمِدْتُ اللهَ عليه وما رأَيْتُ من شرٍّ استغفَرْتُ اللهَ لكم"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه النسائي (1282)، وأحمد (3666)، والبزار (1925) واللفظ له","bab":"ملائكة › أعمال الملائكة","dorar":"IX5DodBU","merged":7,"otherRefs":["تخريج المسند لشعيب 4320 (صحيح)","تخريج المسند لشعيب 3666 (صحيح)","تخريج سير أعلام النبلاء 17/ 105 (صحيح)","الروح 1/266 (صحيح)","سبل الهدى والرشاد 3/133 (صحيح)","سبل الهدى والرشاد 12/368 (صحيح)"]},{"id":"س-08178","fp":"30a04d0b0ccd","stateId":247,"easy":"إذا صليت أو سلّمت على النبي ﷺ ← يصلي الله ويسلّم عليك عشراً","cause":"لا يصلِّي عليك أحدٌ من أمَّتِك","result":"إلَّا صلَّيْتُ عليه عشرًا ولا يُسلِّمُ عليك أحدٌ من أمَّتِك إلَّا سلَّمتُ عليه عشرًا","explicit":true,"repOf":"س-00113","ref":"الترغيب والترهيب 2/401","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم جاء ذاتَ يومٍ والسُّرورُ يُرَى في وجهِه فقالوا: يا رسولَ اللهِ إنَّا لنرَى السُّرورَ في وجهِك فقال: إنَّه أتاني الملَكُ فقال: يا محمَّدُ أما يرضيك أنَّ ربَّك عزَّ وجلَّ يقولُ: إنَّه ",["لا يصلِّي عليك أحدٌ من أمَّتِك",1]," ",["إلَّا صلَّيْتُ عليه عشرًا ولا يُسلِّمُ عليك أحدٌ من أمَّتِك إلَّا سلَّمتُ عليه عشرًا",2],"؟ قال: بلى."],"grade":"صحيح","narrator":"أبو طلحة الأنصاري زيد بن سهل","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (16363) واللفظ له، وأخرجه النسائي (1283) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"MKXngk2R","merged":6,"otherRefs":["تخريج الإحياء للعراقي 1/408 (حسن)","صحيح الجامع 71 (صحيح)","صحيح الجامع 2198 (حسن)","صحيح ابن حبان 915 (صحيح)","فضل الصلاة 2 (صحيح)"]},{"id":"س-00112","fp":"04f89053a6e0","stateId":247,"easy":"إذا سلّمت على النبي ﷺ ← يسلّم الله عليك","cause":"مَن سلَّمَ عليك","result":"سلَّمْتُ عليه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-07634","ref":"الأحاديث المختارة 926","text":["«خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فتَوَجَّهَ نَحْوَ صَدَقتِه، فدَخَلَ فاسْتَقْبَلَ القِبْلةَ فخَرَّ ساجِدًا، فأطالَ السُّجودَ حتَّى ظَنَنْتُ أنَّ اللهَ عَزَّ وجَلَّ قَبَضَ نفْسَه فيها، فدَنَوْتُ مِنه ثُمَّ جَلَسْتُ، فرَفَعَ رأسَه فقالَ: مَن هذا؟ قُلْتُ: عَبْدُ الرَّحْمنِ، قالَ: ما شأنُك؟ قُلْتُ: يا رَسولَ اللهِ، سَجَدْتُ سَجْدةً خَشيْتُ أن يكونَ اللهُ عَزَّ وجَلَّ قد قَبَضَ نفْسَك فيها، فقالَ: إنَّ جِبْريلَ عليه السَّلامُ أتاني فبَشَّرَني، فقالَ: إنَّ اللهَ عَزَّ وجَلَّ يَقولُ: مَن صلَّى عليك صَلَّيْتُ عليه، و",["مَن سلَّمَ عليك",1]," ",["سلَّمْتُ عليه",2],"، فسَجَدْتُ للهِ عَزَّ وجَلَّ شُكْرًا»."],"grade":"صحيح","narrator":"عبد الرحمن بن عوف","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"HpU4Jual","merged":3,"otherRefs":["الأحاديث المختارة 930 (صحيح)","أعلام الموقعين 2/301 (صحيح)"]},{"id":"س-00111","fp":"e8854162534d","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله وملائكته عليك عشراً","cause":"ليس أحدٌ من أمَّتِك يصلِّي عليك صلاةً","result":"إلَّا صلَّى اللهُ وملائكتُه عليه بها عَشرًا","explicit":true,"repOf":"س-00113","ref":"المصابيح في الأحاديث المتواترة 580","text":["أتاني جِبريلُ ببشارةٍ من ربِّي قال: إنَّ اللهَ عزَّ وجلَّ بعثني إليك أُبشِّرُك أنَّه ",["ليس أحدٌ من أمَّتِك يصلِّي عليك صلاةً",1]," ",["إلَّا صلَّى اللهُ وملائكتُه عليه بها عَشرًا",2]],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب الدعاء › الصلاة على النبي صلى الله عليه وسلم في الدعاء","dorar":"nKCRM65i"},{"id":"س-00730","fp":"15cbe085fe08","stateId":247,"easy":"إذا صليت على النبي ﷺ من تلقاء نفسك ← يصلي الله عليك عشراً","cause":"من صلَّى عليَّ من تِلْقَاءِ نفسِهِ","result":"صلَّى اللهُ بها عليهِ عشرًا","explicit":true,"repOf":"س-00113","ref":"السلسلة الصحيحة 7/1084","text":[["من صلَّى عليَّ من تِلْقَاءِ نفسِهِ",1]," ",["صلَّى اللهُ بها عليهِ عشرًا",2]],"grade":"صحيح","narrator":"عامر بن ربيعه","muhaddith":"صحيح دون قوله من تلقاء نفسه","takhrij":"أخرجه البزار (3811) واللفظ له، والبيهقي في ((الشعب)) (1458)، وأبو نعيم في ((الحلية)) (1/ 180) بنحوه.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"L1JSNkBS"},{"id":"س-01031","fp":"b66fd2bacad6","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يردّها الله عليك عشر أمثالها","cause":"لن يُصَلِّيَ علَيَّ أحَدٌ مِن أمَّتي","result":"إلَّا ردَّها اللهُ تعالى عليه عَشرةَ أمثالِها","explicit":true,"similar":["س-08123"],"ref":"شرح ابن ماجه لمغلطاي 3/517","srcLabel":"النسائي","text":["من صَلَّى عَلَيَّ واحِدةً صَلَّى اللهُ عليه وآلِه وسَلَّم عَشرًا، فلْيُكثِرْ من ذلك أو لِيُقِلَّ، وفي لفظٍ: أتاني الآنَ آتٍ من رَبِّي، فأخبَرَني أنَّه ",["لن يُصَلِّيَ علَيَّ أحَدٌ مِن أمَّتي",1]," ",["إلَّا ردَّها اللهُ تعالى عليه عَشرةَ أمثالِها",2],"، وفي لفظٍ: ولا يُسَلِّمُ عليك إلَّا سَلَّمتُ عليه عَشْرًا."],"grade":"صحيح","narrator":"أبو طلحة الأنصاري زيد بن سهل","muhaddith":"سنده صحيح","takhrij":"أخرجه النسائي (1283)، وأحمد (16363)، وابن أبي شيبة (8787) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"rH8ltsAc"},{"id":"س-02018","fp":"dd24d98e28f3","stateId":247,"easy":"إذا صليت على النبي ﷺ أو سلّمت عليه ← يصلي الله عليك ويسلّم عليك عشراً","cause":"ما أَحَدٌ مِن أُمَّتِكَ صلَّى عليكَ","result":"إلَّا صلَّيتُ عليه عشرَ صلواتٍ، ولا سَلَّمَ عليكَ أَحَدٌ مِن أُمَّتِكَ إلَّا ردَدْتُ عليه عشرَ مرَّاتٍ","explicit":true,"repOf":"س-00113","ref":"المستدرك على الصحيحين 3621","text":["أنَّ رسولَ الله صلَّى اللهُ عليه وسلَّمَ جاءَ ذاتَ يومٍ والبِشرُ يُرى في وجهِهِ فقُلنا: يا رسولَ اللهِ، إنَّا لنَرى البِشرَ في وجْهِكَ، فقالَ: «إنَّه أتاني الملَكُ فقالَ: يا مُحمَّدُ، إنَّ رَبَّكَ يقولُ: أما ترضى ",["ما أَحَدٌ مِن أُمَّتِكَ صلَّى عليكَ",1]," ",["إلَّا صلَّيتُ عليه عشرَ صلواتٍ، ولا سَلَّمَ عليكَ أَحَدٌ مِن أُمَّتِكَ إلَّا ردَدْتُ عليه عشرَ مرَّاتٍ",2],"؟». فقالَ: «بَلى»."],"grade":"صحيح","narrator":"أبو طلحة زيد بن سهل الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6414)، وأبو نعيم في ((الحلية)) (8/ 131)، والشاشي في ((مسنده)) (1054) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"gMKK2a4Y"},{"id":"س-02723","fp":"b64b45b60e38","stateId":247,"easy":"إذا سلّمت على النبي ﷺ ← يرد الله عليه روحه حتى يرد عليك السلام","cause":"يسلِّمُ عليه أحدٌ","result":"إلا ردَّ عليه اللهُ رُوحَه حتى يردَّ عليه السلامَ","explicit":true,"ref":"دفع إيهام الاضطراب 34","srcLabel":"دفع إيهام الاضطراب","text":["أنه صلَّى اللهُ عليهِ وسلَّمَ لا ",["يسلِّمُ عليه أحدٌ",1]," ",["إلا ردَّ عليه اللهُ رُوحَه حتى يردَّ عليه السلامَ",2]," وأنَ اللهَ وَكلَ ملائكةً يبلغونُه سلامَ أمتِه."],"grade":"صحيح","muhaddith":"ثابت","bab":"إيمان › الملائكة","dorar":"Ixz5tuWX"},{"id":"س-03412","fp":"a4625d672ddf","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً","cause":"ومن صلَّى عليَّ مرَّةً","result":"صلَّى اللهُ عليه بها عشرًا","explicit":true,"repOf":"س-00113","ref":"الترغيب والترهيب 2/399","text":["من ذُكِرتُ عنده فلْيُصلِّ عليَّ ",["ومن صلَّى عليَّ مرَّةً ",1],["صلَّى اللهُ عليه بها عشرًا",2]," وفي روايةٍ من صلَّى عليَّ صلاةً واحدةً صلَّى اللهُ عليه عشرَ صلواتٍ ويحطُّ عنه عشرَ سيِّئاتٍ ورفعه بها عشرَ درجاتٍ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9889)، والطيالسي في ((المسند)) (2236) واللفظ لهما، وأبو يعلى (4002) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"pVegubXO"},{"id":"س-03413","fp":"785f8f284bd6","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله عليك عشراً ويحط عنك عشر سيئات ويرفعك عشر درجات","cause":"من صلَّى عليَّ صلاةً واحدةً","result":"صلَّى اللهُ عليه عشرَ صلواتٍ ويحطُّ عنه عشرَ سيِّئاتٍ ورفعه بها عشرَ درجاتٍ","explicit":true,"repOf":"س-00113","otherNeedIds":[11,47],"ref":"الترغيب والترهيب 2/399","text":["من ذُكِرتُ عنده فلْيُصلِّ عليَّ ومن صلَّى عليَّ مرَّةً صلَّى اللهُ عليه بها عشرًا وفي روايةٍ ",["من صلَّى عليَّ صلاةً واحدةً",1]," ",["صلَّى اللهُ عليه عشرَ صلواتٍ ويحطُّ عنه عشرَ سيِّئاتٍ ورفعه بها عشرَ درجاتٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9889)، والطيالسي في ((المسند)) (2236) واللفظ لهما، وأبو يعلى (4002) باختلاف يسير.","bab":"استغفار › أسباب المغفرة","dorar":"pVegubXO"},{"id":"س-04705","fp":"7b8ba97bc64b","stateId":247,"easy":"إذا صليت على النبي ﷺ مخلصاً من قلبك ← يصلي الله عليك عشراً ويرفعك عشر درجات","cause":"مَن صلَّى عَليَّ مِن أُمَّتي صلاةً مُخلِصًا من قلبِه","result":"صَلَّى اللهُ عليهِ بِها عَشرَ صلَواتٍ ، ورَفعَه بِها عَشرَ دَرجاتٍ ، وكَتبَ لهُ بِها عَشرَ حَسَناتٍ ، ومَحا عنهُ عَشرَ سَيِّئاتٍ","explicit":true,"repOf":"س-00113","otherNeedIds":[47,11],"ref":"صحيح الترغيب 1659","text":[["مَن صلَّى عَليَّ مِن أُمَّتي صلاةً مُخلِصًا من قلبِه ؛ ",1],["صَلَّى اللهُ عليهِ بِها عَشرَ صلَواتٍ ، ورَفعَه بِها عَشرَ دَرجاتٍ ، وكَتبَ لهُ بِها عَشرَ حَسَناتٍ ، ومَحا عنهُ عَشرَ سَيِّئاتٍ ",2],"."],"grade":"صحيح","narrator":"هانئ بن نيار أبو بردة","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9893) واللفظ له، والبزار (3799)، والطبراني (22/195) (513)","bab":"رقائق وزهد › الإخلاص","dorar":"Oh0PMOg1"},{"id":"س-08123","fp":"03abd2efdfdc","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يردها الله عليك عشر أمثالها","cause":"يصلِّيَ عليَّ أحَدٌ من أمَّتي","result":"إلا ردَّها اللهُ عليه عشرَ أمثالِها","explicit":true,"repOf":"س-01031","ref":"فضل الصلاة 1","text":["إنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم خرج عليهم يومًا يعرفون البِشرَ في وجهه ، فقالوا : إنا نعرفُ الآن في وجهِك البِشرَ يا رسولَ اللهِ ! قال : أجلْ أتاني الآنَ آتٍ من ربِّي فأخبرَني أنه لن ",["يصلِّيَ عليَّ أحَدٌ من أمَّتي",1]," ",["إلا ردَّها اللهُ عليه عشرَ أمثالِها",2]," ."],"grade":"صحيح","narrator":"أبو طلحة الأنصاري زيد بن سهل","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه النسائي (1283)، وأحمد (16363)، وابن أبي شيبة (8787) بنحوه تامًا.","bab":"ملائكة › أعمال الملائكة","dorar":"jPWoPhzw"},{"id":"س-02741","fp":"d8b04436c9d1","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يصلي الله عليك","cause":"مَن صَلَّى عَلَيكَ","result":"صَلَّيتُ عليه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-00113","ref":"المستدرك على الصحيحين 906","text":["دَخَلتُ المَسجِدَ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خارِجٌ منَ المَسجِدِ، فتَبِعتُه أمشي وَراءَه وهو لا يَشعُرُ، حتَّى دَخَل نَخلًا فاستَقبَلَ القِبلةَ، فسَجَد فأطالَ السُّجودَ وأنا وَراءَه، حتَّى ظَنَنتُ أنَّ اللهَ قد تَوَفَّاه، فأقبَلتُ أمشي حتَّى جِئتُه فطَأطَأتُ رأسي أنظُرُ في وَجهِه فرَفَع رَأسَه، فقالَ: ما لَكَ يا عَبدَ الرَّحمنِ؟ فقُلتُ: لَمَّا أطلْتَ السُّجودَ -يا رَسولَ اللهِ-خَشِيتُ أن يَكونَ تُوُفِّي نَفْسُكَ؛ فجِئتُ أنظُرُ، فقالَ: إنِّي لَمَّا دَخَلتُ النَّخلَ لَقِيتُ جِبريلَ؛ فقالَ: إنِّي أُبَشِّرُكَ أنَّ اللهَ يَقولُ: مَن سَلَّم عَلَيكَ سَلَّمتُ عليه، و",["مَن صَلَّى عَلَيكَ",1]," ",["صَلَّيتُ عليه",2],"."],"grade":"صحيح","narrator":"عبد الرحمن بن عوف","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو يعلى (869)، البيهقي (3993) باختلاف يسير، وأحمد (1662) مختصرا","bab":"إيمان › الملائكة","dorar":"aHxNC6n3","merged":4,"otherRefs":["الأحاديث المختارة 930 (صحيح)","الأحاديث المختارة 926 (صحيح)","أعلام الموقعين 2/301 (صحيح)"]},{"id":"س-08159","fp":"eb4a47c64662","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله وملائكته عليك سبعين","cause":"من صلَّى على النَّبِّي صلَّى اللهُ عليه وسلَّم واحدةً","result":"صلَّى اللهُ تعالَى عليه وملائكتُه بها سبعين صلاةً","explicit":true,"repOf":"س-00113","ref":"القول البديع 153","text":["عن عبدِ اللهِ بنِ عمرِو بنِ العاصِ رضِي اللهُ عنهما قال : ",["من صلَّى على النَّبِّي صلَّى اللهُ عليه وسلَّم واحدةً",1]," ",["صلَّى اللهُ تعالَى عليه وملائكتُه بها سبعين صلاةً",2]],"grade":"حسن","muhaddith":"إسناده حسن","bab":"ملائكة › أعمال الملائكة","dorar":"SWi2FVNx","merged":2,"otherRefs":["تخريج المسند لشاكر 10/107 (حسن)"]},{"id":"س-08125","fp":"1af40a1b0d0e","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يصلي الله عليك عشر أمثالها","cause":"يُصلِّيَ على عبدٍ صلاةً","result":"إلا صلَّى عليه عشرَ أمثالِها","explicit":true,"repOf":"س-00113","ref":"صحيح الجامع 2176","text":["إنَّ للهِ تعالى ملَكًا أعطاه سمْعَ العبادِ ، فليس من أحدٍ يصلِّي عليَّ إلا أبلغَنيها ، و إني سألتُ ربي أن لا ",["يُصلِّيَ على عبدٍ صلاةً",1]," ",["إلا صلَّى عليه عشرَ أمثالِها",2]],"grade":"حسن","narrator":"عمار بن ياسر","muhaddith":"حسن","takhrij":"أخرجه البزار (1425)، والعقيلي في ((الضعفاء الكبير)) (3/248)، والطبراني كما في ((مجمع الزوائد)) للهيثمي (10/165) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"pazugkrN"},{"id":"س-08164","fp":"96009a440d80","stateId":247,"easy":"إذا صليت على النبي ﷺ مرة ← يصلي الله وملائكته عليك عشراً","cause":"ما على الأرضِ من مُسلمٍ يصلِّي عليكَ مرةً واحدةً","result":"إلَّا صلِيْتُ أنا وملائكتِي عليهِ عشرًا","explicit":true,"repOf":"س-00113","ref":"صحيح الترغيب 1662","text":["أَكْثِرُوا الصَّلاةَ عليَّ يومَ الجمعةِ ، فإنَّهُ أتاني جبريلُ آنفا عن ربِه عزَّ وجلَّ فقال : ",["ما على الأرضِ من مُسلمٍ يصلِّي عليكَ مرةً واحدةً ؛",1]," ",["إلَّا صلِيْتُ أنا وملائكتِي عليهِ عشرًا ",2],"."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني في ((الكبير)) مطولًا، كما نقله عنه ابن القيم في ((جلاء الأفهام في فضل الصلاة على محمد خير الأنام)) (صـ 86 ـ 87). والشجري في ((الأمالي)) (صـ 162) باختلاف يسير، وابن عساكر في ((معجمه)) (1/ 103) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"7DDN1Y5u"},{"id":"س-08196","fp":"8eea7aeec602","stateId":247,"easy":"إذا صليت على النبي ﷺ ← يصلي الله عليك عشراً","cause":"من صلَّى عليَّ","result":"صلَّى اللهُ عليه عشرًا ، ووكَّلَ بها ملَكًا حتى يُبَلِّغَنيها","explicit":true,"repOf":"س-00113","ref":"صحيح الترغيب 1663","text":[["من صلَّى عليَّ ؛ ",1],["صلَّى اللهُ عليه عشرًا ، ووكَّلَ بها ملَكًا حتى يُبَلِّغَنيها ",2],"."],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن لغيره","takhrij":"أخرجه الطبراني (8/ 134) (7611)، والشجري في ((أماليه)) (638) واللفظ لهما.","bab":"ملائكة › أعمال الملائكة","dorar":"jDfs63S4"},{"id":"ق-0869","fp":"06c36c6d4891","stateId":248,"easy":"إقامة الصلاة وإيتاء الزكاة وطاعة الرسول ← رحمة الله","cause":"إقامة الصلاة وإيتاء الزكاة وطاعة الرسول","result":"رحمة الله","explicit":true,"star":true,"ref":"سورة النور: 56","srcLabel":"القرآن الكريم","quran":{"s":24,"from":56,"to":56,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَطِيعُوا الرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ (56)","hl":[[0,88,1]]}},{"id":"س-02336","fp":"ae983474b5c3","stateId":248,"easy":"إذا صليت أربعاً قبل العصر ← يرحمك الله","cause":"صَلَّى أربَعًا قَبلَ العَصرِ","result":"رَحِمَ اللهُ امرَأً","explicit":true,"star":true,"ref":"مجموع الشروح الفقهية. 303/23","srcLabel":"مجموع الشروح الفقهية","text":[["رَحِمَ اللهُ امرَأً",2],[" صَلَّى أربَعًا قَبلَ العَصرِ",1],"."],"grade":"صحيح","narrator":"ابن عمر","muhaddith":"لا بأس به صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"DTUrdhV1","merged":2,"otherRefs":["تخريج رياض الصالحين 1120 (حسن)"]},{"id":"س-03877","fp":"e010e2e43353","stateId":248,"easy":"إذا دمت في صلاتك ← يُذر البر على رأسك","cause":"ما دام في صلاتِه","result":"وإنَّ البِرَّ ليُذَرُّ على رأسِ العبدِ","explicit":true,"otherNeedIds":[45],"ref":"هداية الرواة 2/84","srcLabel":"الترمذي","text":["ما أذِنَ اللهُ لعبدٍ في شيءٍ أفضلَ من ركعتينِ يصلِّيهما ",["وإنَّ البِرَّ ليُذَرُّ على رأسِ العبدِ",2]," ",["ما دام في صلاتِه",1]," وما تقرَّب العبادُ إلى اللهِ تعالى بمِثلِ ما خرجَ منه يعني القرآنَ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2911)، وأحمد (22306) باختلاف يسير","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"SIChCS0E"},{"id":"س-01307","fp":"a75bdc2de62a","stateId":248,"easy":"إذا قمت الليل وأيقظت زوجتك فصلّت ← رحمك الله","cause":"قامَ من الليْلِ فصَلَّى وأيْقظَ امْرَأَتَهُ فصَلَّتْ فإِنْ أبَتْ نضحَ في وجْهِها الماءَ","result":"رَحِمَ اللهُ رَجُلًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"time","t":"في الليل"},"ref":"صحيح الجامع 3494","srcLabel":"أبو داود","text":[["رَحِمَ اللهُ رَجُلًا",2],[" قامَ من الليْلِ فصَلَّى وأيْقظَ امْرَأَتَهُ فصَلَّتْ فإِنْ أبَتْ نضحَ في وجْهِها الماءَ ",1],". رَحِمَ اللهُ امْرأةً قامَتْ من الليلِ فصلَّتْ وأيقظَتْ زَوْجَها فصلَّى ، فإنْ أبَى نَضَحَتْ في وجهِهِ الماءَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1450) واللفظ له، والنسائي (1610)، وابن ماجه (1336)، وأحمد (7404).","bab":"نكاح › حسن العشرة بين الأزواج","dorar":"VdTRzBiD"},{"id":"س-03885","fp":"781dd142237f","stateId":248,"easy":"إذا قمت من الليل ← رحمك الله","cause":"قامَ من الليلِ","result":"رحِم اللهُ رجلًا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"في الليل"},"ref":"تخريج المسند لشاكر 13/101","srcLabel":"أبو داود","text":[["رحِم اللهُ رجلًا",2],[" قامَ من الليلِ",1]," قال سفيانَ لا تَرُشُّ في وجهِهِ تَمْسَحُه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1450)، والنسائي (1610)، وابن ماجه (1336) دون قول سفيان","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"wMfksaud"},{"id":"س-02007","fp":"4be8c808b606","stateId":249,"easy":"إذا صليت ثم جلست في مصلاك ← تظل الملائكة تصلي عليك: اللهم اغفر له اللهم ارحمه","cause":"إذا صلَّى أحدُكُم ثمَّ جلَسَ مجلسَهُ الَّذي صلَّى فيهِ","result":"لم تَزلِ الملائِكَةُ تصلِّي عليهِ: اللَّهُمَّ اغفرْ لَهُ، اللَّهمَّ ارحمهُ، ما لم يُحدِثْ","explicit":true,"star":true,"similar":["س-03437","س-08150"],"ref":"صحيح ابن خزيمة 1/ 735","srcLabel":"متفق عليه","text":[["إذا صلَّى أحدُكُم ثمَّ جلَسَ مجلسَهُ الَّذي صلَّى فيهِ ",1],["لم تَزلِ الملائِكَةُ تصلِّي عليهِ: اللَّهُمَّ اغفرْ لَهُ، اللَّهمَّ ارحمهُ، ما لم يُحدِثْ",2],". [وفي روايةٍ] أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: إذا صلَّى المسلِمُ، ثمَّ جلسَ في مصلَّاهُ لم تَزلِ الملائِكَةُ تدعو لَهُ: اللَّهمَّ اغفِر لَهُ، اللَّهمَّ ارحمهُ، ما لَم يُحدِثْ أو يقُم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (659)، ومسلم (649)، والترمذي (330) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0otdHuAF"},{"id":"س-06421","fp":"a32247d60095","stateId":249,"easy":"إذا بقيت في مصلاك تنتظر الصلاة ← تقول الملائكة: اللهم ارحمه اللهم اغفر له","cause":"ما دامَ في مُصَلَّاهُ، لا يَحبِسُهُ إلَّا انتظارُ الصَّلاةِ","result":"والمَلائكةُ معه تَقولُ: اللَّهمَّ ارحَمْهُ، اللَّهمَّ اغفِرْ لهُ","explicit":true,"star":true,"similar":["س-06524"],"otherNeedIds":[11],"ref":"تخريج المسند لشعيب 10901","srcLabel":"متفق عليه","text":["إنَّ العَبدَ المُؤمِنَ في صلاةٍ ",["ما دامَ في مُصَلَّاهُ، لا يَحبِسُهُ إلَّا انتظارُ الصَّلاةِ",1],"، ",["والمَلائكةُ معه تَقولُ: اللَّهمَّ ارحَمْهُ، اللَّهمَّ اغفِرْ لهُ",2],"؛ ما لم يُحدِثْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (445)، ومسلم (649)، وأبو داود (469)، والنسائي (733)، وأحمد (10901) واللفظ له","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"cADmfU2k"},{"id":"س-07144","fp":"c1d80c33fe76","stateId":249,"easy":"إذا بقيت في مسجدك ← تصلي عليك الملائكة","cause":"ما دام في مَسجِدِه","result":"ولا تَزالُ المَلائِكَةُ تُصلِّي على أَحدِكم","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7892","srcLabel":"متفق عليه","text":["لا يَزالُ أَحدُكم في صلاةٍ ما دام يَنتظِرُ الَّتي بعْدَها، ",["ولا تَزالُ المَلائِكَةُ تُصلِّي على أَحدِكم",2]," ",["ما دام في مَسجِدِه",1],"، تَقولُ: اللَّهمَّ اغفِرْ له، اللَّهمَّ ارحَمْه، ما لم يُحْدِثْ. قال: فقال رَجُلٌ مِن أَهلِ حَضْرَمَوتَ: وما ذلك الحَدثُ يا أبا هُريرةَ؟ قال: إنَّ اللهَ لا يَستَحْيي مِن الحَقِّ: إنْ فَسا أو ضرَطَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (176)، ومسلم (649)، وأبو داود (471)، والترمذي (330)، وابن ماجه (799)، وأحمد (7892) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"EyZcfKs5"},{"id":"س-06524","fp":"84bf21d3d833","stateId":249,"easy":"إذا بقيت في مصلاك تنتظر الصلاة ← تستغفر لك الملائكة وتسأل لك الرحمة","cause":"ما كان في مُصَلَّاهُ يَنتَظِرُ الصَّلاةَ","result":"تَقولُ الملائكةُ: اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ ارْحَمْه، حتَّى يَنصَرِفَ أو يُحدِثَ","explicit":true,"repOf":"س-06421","otherNeedIds":[11],"ref":"تخريج المسند لشعيب 11907","text":["لا يَزالُ العَبدُ في صَلاةٍ ",["ما كان في مُصَلَّاهُ يَنتَظِرُ الصَّلاةَ",1],"، ",["تَقولُ الملائكةُ: اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ ارْحَمْه، حتَّى يَنصَرِفَ أو يُحدِثَ",2],"، فقُلتُ: ما يُحدِثُ؟ فقال: كذا قُلتُ لأبي سَعيدٍ، فقال: يَفسو أو يَضرِطُ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه مسلم (649)، وأبو داود (471)، وأحمد (11907) واللفظ له","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"lBXFauh1"},{"id":"س-01056","fp":"bdb4be5914e7","stateId":249,"easy":"إذا صليت في الصف الأول ← يصلي الله وملائكته عليك","cause":"الصَّفِّ الأوَّلِ أو الصُّفوفِ الأُوَلِ","result":"إنَّ اللهَ وملائكتَه يُصلُّونَ على","explicit":true,"similar":["س-01507"],"ref":"تخريج المسند لشعيب 18704","srcLabel":"أبو داود","text":["مَن مَنَحَ مَنيحةَ وَرِقٍ، أو هَدى زُقاقًا، أو سَقى لَبَنًا؛ كان له  عِدلُ رَقبةٍ أو نَسَمةٍ، ومَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قَديرٌ، عَشْرَ مِرارٍ؛ كان له  عِدلُ رَقبةٍ أو نَسَمةٍ. وكان يَأتينا إذا قُمْنا إلى الصَّلاةِ، فيَمسَحُ صُدورَنا أو عَواتِقَنا، يقولُ: لا تَختلِفْ صُفوفُكم؛ فتَختلِفَ قُلوبُكم. وكان يقولُ: ",["إنَّ اللهَ وملائكتَه يُصلُّونَ على",2]," ",["الصَّفِّ الأوَّلِ أو الصُّفوفِ الأُوَلِ",1],". وقال: زَيِّنوا القُرآنَ بأصْواتِكم، كنتُ نَسيتُها، فذَكَّرَنيها الضَّحَّاكُ بنُ مُزاحِمٍ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (664، 1468) مفرقاً بنحوه، والنسائي (811، 1015) مفرقاً بنحوه، وابن ماجه (1342) مختصراً، وأحمد (18704) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"LmO01swC","merged":14,"otherRefs":["الضعفاء الكبير 4/86 (صحيح)","نتائج الأفكار 1/313 (حسن)","تخريج المسند لشعيب 22263 (صحيح)","صحيح ابن خزيمة 3/ 72 (صحيح)","صحيح ابن خزيمة 3/ 75 (صحيح)","الصحيح المسند 1/117 (صحيح)","صحيح الجامع 1840 (صحيح)","تخريج شرح السنة 817 (صحيح)","الترغيب والترهيب 1/235 (حسن)","صحيح الترغيب 507 (صحيح)","صحيح الترغيب 491 (حسن)","صحيح ابن ماجه 821 (صحيح)"]},{"id":"س-07972","fp":"23cd80344032","stateId":249,"easy":"إذا بقيت في مجلسك الذي صليت فيه ← تصلي عليك الملائكة","cause":"ما دَامَ في مَجْلِسِهِ الذي صَلَّى فيه","result":"وَالْمَلَائِكَةُ يُصَلُّونَ علَى أَحَدِكُمْ ما دَامَ في مَجْلِسِهِ الذي صَلَّى فيه يقولونَ: اللَّهُمَّ ارْحَمْهُ، اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ تُبْ عليه","explicit":true,"otherNeedIds":[11],"ref":"عارضة الأحوذي 6/304","srcLabel":"عارضة الأحوذي","text":["حديث  أنَّهُ لا يخطو خطوةً إلا كتب اللهُ لهُ بها حسنةً ومحا عنهُ بها سيئةً ورفعَه بها درجةً [يعني حديث: قالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ: صَلَاةُ الرَّجُلِ في جَمَاعَةٍ تَزِيدُ علَى صَلَاتِهِ في بَيْتِهِ، وَصَلَاتِهِ في سُوقِهِ، بضْعًا وَعِشْرِينَ دَرَجَةً، وَذلكَ أنَّ أَحَدَهُمْ إذَا تَوَضَّأَ فأحْسَنَ الوُضُوءَ ، ثُمَّ أَتَى المَسْجِدَ لا يَنْهَزُهُ إلَّا الصَّلَاةُ، لا يُرِيدُ إلَّا الصَّلَاةَ، فَلَمْ يَخْطُ خَطْوَةً إلَّا رُفِعَ له بهَا دَرَجَةٌ، وَحُطَّ عنْه بهَا خَطِيئَةٌ، حتَّى يَدْخُلَ المَسْجِدَ، فَإِذَا دَخَلَ المَسْجِدَ كانَ في الصَّلَاةِ ما كَانَتِ الصَّلَاةُ هي تَحْبِسُهُ، ",["وَالْمَلَائِكَةُ يُصَلُّونَ علَى أَحَدِكُمْ ما دَامَ في مَجْلِسِهِ الذي صَلَّى فيه يقولونَ: اللَّهُمَّ ارْحَمْهُ، اللَّهُمَّ اغْفِرْ له، اللَّهُمَّ تُبْ عليه",2],"، ما لَمْ يُؤْذِ فِيهِ، ما لَمْ يُحْدِثْ فِيهِ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"مساجد ومواضع الصلاة › فضل من غدا إلى المسجد أو راح","dorar":"HzQfmfaA","merged":3,"otherRefs":["صحيح البخاري 659 (صحيح)","التمهيد 19/39 (صحيح)"]},{"id":"س-01507","fp":"5a5b2d9c0ade","stateId":249,"easy":"إذا صليت في الصف المقدم ← يصلي الله وملائكته عليك","cause":"الصَّفِّ المُقدَّمِ","result":"إنَّ اللهَ وملائكتَه يُصلُّونَ على","explicit":true,"repOf":"س-01056","ref":"تخريج العواصم والقواصم 9/ 135","text":["وله مِثلُ أجرِ مَن صلَّى [يعني حديث: ",["إنَّ اللهَ وملائكتَه يُصلُّونَ على",2]," ",["الصَّفِّ المُقدَّمِ",1]," والمُؤذِّنُ يُغفَرُ له مَدَّ صوتِه ويُصدِّقُه مَن سمِعه مِن رَطْبٍ ويابسٍ وله مِثْلُ أجرِ مَن صلَّى معه]"],"grade":"صحيح","narrator":"[البراء بن عازب]","muhaddith":"حديث صحيح","takhrij":"أخرجه النسائي (646)، وأحمد (18506) مطولاً من حديث البراء بن عازب رضي الله عنه","bab":"أذان › فضل التأذين","dorar":"IAQt4qlU","merged":2,"otherRefs":["صحيح الترغيب 235 (صحيح)"]},{"id":"س-08109","fp":"daf8f2c5ab56","stateId":249,"easy":"إذا كنت من أوتاد المساجد ← تجالسك الملائكة وتفتقدك وتعودك","cause":"للمساجدِ أوتادًا","result":"الملائكةُ جلساؤهم ، إن غابوا يفتقدونهم ، وإن مرِضوا عادوهم ، وإن كانوا في حاجةٍ أعانوهم","explicit":true,"apply":{"k":"time","t":"في السجود"},"otherNeedIds":[25],"ref":"صحيح الترغيب 329","srcLabel":"أحمد","text":["إنَّ ",["للمساجدِ أوتادًا",1]," ؛ ",["الملائكةُ جلساؤهم ، إن غابوا يفتقدونهم ، وإن مرِضوا عادوهم ، وإن كانوا في حاجةٍ أعانوهم",2]," . ثم قال : جليسُ المسجدِ على ثلاثِ خصالٍ : أخٌ مستفادٌ ، أو كلمةُ حكمةٍ ، أو رحمةٌ مَنتظَرَةٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (9424، 9425) واللفظ له، والديلمي في ((الفردوس)) (787) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"ZjtTy7OX","merged":2,"otherRefs":["المستدرك على الصحيحين 3553 (صحيح)"]},{"id":"س-03420","fp":"f9426c5cdc42","stateId":249,"easy":"إذا خرجت من بيتك متطهراً فصليت في المسجد ← تقول الملائكة: اللهم اغفر له اللهم ارحمه","cause":"وما من أحدٍ يخرُجُ من بيتِه مُتطهِّرًا ؛ يأتي المسجدَ ، فيُصلِّي مع المسلمين أو مع الإمامِ ، ثمَّ ينتظِرُ الصَّلاةَ الَّتي بعدُ","result":"إلَّا قالت الملائكةُ : اللَّهمَّ ! اغفِرْ له ، اللَّهمَّ ! ارحَمْه","explicit":true,"apply":{"k":"time","t":"عند الخروج من البيت"},"otherNeedIds":[11],"ref":"صحيح الموارد 355","srcLabel":"ابن ماجه","text":["ألا أدلُّكم على شيءٍ يُكفِّرُ الخطايا ، ويزيدُ في الحسناتِ ؟ ! . قالوا : بلَى يا رسولَ اللهِ ! قال : إسباغُ الوضوءِ والطَّهورِ في المكارهِ ، وكثرةُ الخُطَى إلى هذا المسجدِ ، والصَّلاةُ بعد الصَّلاةِ ، ",["وما من أحدٍ يخرُجُ من بيتِه مُتطهِّرًا ؛ يأتي المسجدَ ، فيُصلِّي مع المسلمين أو مع الإمامِ ، ثمَّ ينتظِرُ الصَّلاةَ الَّتي بعدُ",1]," ؛ ",["إلَّا قالت الملائكةُ : اللَّهمَّ ! اغفِرْ له ، اللَّهمَّ ! ارحَمْه",2]," . فإذا قمتم إلى الصَّلاةِ ؛ فاعدِلوا صفوفَكم ، وسُدُّوا الفُرُجَ . فإذا كبَّر الإمامُ فكبِّروا ؛ فإنِّي أراكم من ورائي ، وإذا قال : سمِع اللهُ لمن حمِده ؛ فقولوا : ربَّنا ! ولك الحمدُ . وخيرُ صفوفِ الرِّجالِ المُقدَّمُ ، وشرُّ صفوفِ الرِّجالِ المُؤخَّرُ، وخيرُ صفوفِ النِّساءِ المُؤخَّرُ ، وشرُّ صفوفِ النِّساءِ المُقدَّمُ ، يا معشرَ النِّساءِ ! إذا سجد الرِّجالُ ؛ فاخفِضْن أبصارَكنَّ عن عوراتِ الرِّجالِ . فقلتُ لعبدِ اللهِ بنِ أبي بكرٍ : ما يعني بذلك ؟ قال : ضيقُ الأُزُرِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (427، 776) مختصرًا، وأحمد (3/ 3) باختلاف يسير جدًّا، والدارمي (1/ 189) مختصرًا.","bab":"استغفار › أسباب المغفرة","dorar":"1bFZlrYc"},{"id":"س-03437","fp":"b8ef1ccbb1d3","stateId":249,"easy":"إذا صليت الصبح ثم جلست في مصلاك ← تصلي عليك الملائكة","cause":"مَن صلَّى الصُّبحَ ، ثمَّ جلسَ في مصلَّاهُ","result":"صلَّت عليهِ الملائِكةُ ، وصلاتُهُم عليهِ اللَّهُمَّ اغفِر لَه ، اللَّهُمَّ ارحَمهُ","explicit":true,"repOf":"س-02007","ref":"مختصر زوائد البزار 2/412","text":[["مَن صلَّى الصُّبحَ ، ثمَّ جلسَ في مصلَّاهُ ، ",1],["صلَّت عليهِ الملائِكةُ ، وصلاتُهُم عليهِ اللَّهُمَّ اغفِر لَه ، اللَّهُمَّ ارحَمهُ ",2],"ومنِ انتظرَ الصَّلاةَ صلَّت عليهِ الملائِكةُ وصلاتُهم عليهِ . اللَّهمَّ اغفِر لَه اللَّهمَّ ارحَمهُ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن، بل صحيح","takhrij":"أخرجه البزار (597) واللفظ له، وأحمد (1251)، والبيهقي في ((الشعب)) (2700) باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"r80HARqr"},{"id":"س-03438","fp":"9af11a788ed0","stateId":249,"easy":"إذا انتظرت الصلاة ← تصلي عليك الملائكة","cause":"ومنِ انتظرَ الصَّلاةَ","result":"صلَّت عليهِ الملائِكةُ وصلاتُهم عليهِ","explicit":true,"ref":"مختصر زوائد البزار 2/412","srcLabel":"أحمد","text":["مَن صلَّى الصُّبحَ ، ثمَّ جلسَ في مصلَّاهُ ، صلَّت عليهِ الملائِكةُ ، وصلاتُهُم عليهِ اللَّهُمَّ اغفِر لَه ، اللَّهُمَّ ارحَمهُ ",["ومنِ انتظرَ الصَّلاةَ ",1],["صلَّت عليهِ الملائِكةُ وصلاتُهم عليهِ ",2],". اللَّهمَّ اغفِر لَه اللَّهمَّ ارحَمهُ"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن، بل صحيح","takhrij":"أخرجه البزار (597) واللفظ له، وأحمد (1251)، والبيهقي في ((الشعب)) (2700) باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"r80HARqr"},{"id":"س-08150","fp":"dd44f58ac2cc","stateId":249,"easy":"إذا صليت ثم جلست في مصلاك ← تظل الملائكة تصلي عليك","cause":"إذا صلَّى أحدُكُمْ ثُمَّ جلسَ في مُصَلَّاهُ","result":"لمْ تَزَلِ الملائكةُ تُصَلِّي عليهِ : اللهمَّ اغفرْ لهُ ، اللهمَّ ارْحَمْهُ ، فإنْ قامَ من مُصَلَّاهُ فجلسَ في المسجدِ يَنْتَظِرُ الصَّلاةَ ؛ لمْ يَزَلْ في صَلاةٍ حتى يصلِّيَ","explicit":true,"repOf":"س-02007","ref":"صحيح الترغيب 442","text":["عن أبي هريرةَ قال : ",["إذا صلَّى أحدُكُمْ ثُمَّ جلسَ في مُصَلَّاهُ، ",1],["لمْ تَزَلِ الملائكةُ تُصَلِّي عليهِ : اللهمَّ اغفرْ لهُ ، اللهمَّ ارْحَمْهُ ، فإنْ قامَ من مُصَلَّاهُ فجلسَ في المسجدِ يَنْتَظِرُ الصَّلاةَ ؛ لمْ يَزَلْ في صَلاةٍ حتى يصلِّيَ",2]],"grade":"صحيح","narrator":"نعيم بن عبدالله المجمر","muhaddith":"صحيح","takhrij":"أخرجه مالك (556)، وابن المظفر في ((غرائب مالك)) (91) واللفظ لهما.","bab":"ملائكة › أعمال الملائكة","dorar":"xnHc8YXI"},{"id":"س-06679","fp":"6d59c0027461","stateId":249,"easy":"إذا صليت في ميامن الصفوف ← يصلي الله وملائكته عليك","cause":"ميامنِ الصُّفوفِ","result":"إنَّ اللهَ وملائكتَه يُصَلُّون على","explicit":true,"ref":"الوهم والإيهام 5/688","srcLabel":"ابن ماجه","text":["حديث ",["ميامنِ الصُّفوفِ",1]," [يعني حديث: ",["إنَّ اللهَ وملائكتَه يُصَلُّون على",2]," ميامنِ الصُّفوفِ]"],"grade":"حسن","narrator":"[عائشة أم المؤمنين]","muhaddith":"حسن","takhrij":"أخرجه أبو داوود (676)، وابن ماجه (1005)، وأحمد (25270) واللفظ لهم.","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"Ys8xIEml"},{"id":"س-06991","fp":"93d7a5d96dc4","stateId":249,"easy":"إذا مشيت إلى المساجد في الظلمة ← تخوض في رحمة الله","cause":"المَشَّاؤونَ إلى المَساجِدِ في الظُّلَمِ","result":"أولئك الخَوَّاضونَ في رَحمةِ اللهِ تعالى","explicit":true,"apply":{"k":"time","t":"في السجود"},"ref":"فيض القدير 6/ 272","srcLabel":"ابن ماجة","text":[["المَشَّاؤونَ إلى المَساجِدِ في الظُّلَمِ",1]," ",["أولئك الخَوَّاضونَ في رَحمةِ اللهِ تعالى",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رمز السيوطي لحسنه وليس كما قال","takhrij":"أخرجه ابن ماجة (779)، وابن عساكر في ((تاريخ دمشق)) (52/ 17) واللفظ لهما، وابن شاهين في ((الترغيب)) (92) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"OT9xpxFp"},{"id":"س-01997","fp":"3d747b5ae37b","stateId":249,"easy":"إذا واظبت على الجمعة ثم غبت ← تدعو لك الملائكة بالهداية والشفاء","cause":"ما حبسَ فلانًا","result":"فتقولُ الملائِكَةُ: اللَّهمَّ إن كانَ ضالًّا فاهدِهِ، وإن كانَ مَريضًا فاشفِهِ، وإن كانَ عائلًا فأغنِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح ابن خزيمة 3/ 250","srcLabel":"البيهقي","text":["تُبعَثُ الملائِكَةُ على أبوابِ المسجدِ يومَ الجمعةِ يَكْتبونَ مَجيءَ النَّاسِ، فإذا خرجَ الإمامُ طُوِيَتِ الصُّحفُ، ورُفِعَتِ الأقلامُ، فتَقولُ الملائِكَةُ بعضُهُم لبَعضٍ: ",["ما حبسَ فلانًا",1],"؟ ",["فتقولُ الملائِكَةُ: اللَّهمَّ إن كانَ ضالًّا فاهدِهِ، وإن كانَ مَريضًا فاشفِهِ، وإن كانَ عائلًا فأغنِهِ",2],". [وفي روايةٍ]: تقعدُ الملائِكَةُ على أبوابِ المسجدِ. وقالَ أيضًا: يقولُ بعضُهُم لبعضٍ: اللَّهمَّ إن كانَ ضالًّا فاهدِهِ، وإن كانَ... إلى آخرِهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي (5930)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0g3dbqR7"},{"id":"ق-0386","fp":"b24403fc492a","stateId":250,"easy":"اتباع الكتاب والتقوى ← رحمة الله","cause":"اتباع الكتاب والتقوى","result":"رحمة الله","explicit":true,"star":true,"ref":"سورة الأنعام: 155","srcLabel":"القرآن الكريم","quran":{"s":6,"from":155,"to":155,"text":"وَهَذَا كِتَابٌ أَنْزَلْنَاهُ مُبَارَكٌ فَاتَّبِعُوهُ وَاتَّقُوا لَعَلَّكُمْ تُرْحَمُونَ (155)","hl":[[0,88,1]]}},{"id":"ق-0448","fp":"47945079a854","stateId":250,"easy":"الاستماع للقرآن والإنصات ← رحمة الله","cause":"الاستماع للقرآن والإنصات","result":"رحمة الله","explicit":true,"star":true,"ref":"سورة الأعراف: 204","srcLabel":"القرآن الكريم","quran":{"s":7,"from":204,"to":204,"text":"وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ (204)","hl":[[0,81,1]]}},{"id":"س-02099","fp":"dd50ffa5ce81","stateId":250,"easy":"إذا ختمت القرآن أول النهار ← تصلي عليك الملائكة حتى تمسي","cause":"إذا ختَمَ في أوَّلِ النَّهارِ","result":"صَلَّتْ عليه الملائكةُ حتَّى يُمْسِيَ","explicit":true,"similar":["س-02100"],"ref":"كشاف القناع 1/430","srcLabel":"الدارمي","text":["أدركْتُ أهْلَ الخيرِ مِن صَدْرِ هذه الأُمَّةِ يَستحِبُّونَ الختْمَ أوَّلَ اللَّيلِ وأوَّلَ النَّهارِ؛ يقولونَ: ",["إذا ختَمَ في أوَّلِ النَّهارِ، ",1],["صَلَّتْ عليه الملائكةُ حتَّى يُمْسِيَ",2],"، وإذا ختَمَ في أوَّلِ اللَّيلِ، صَلَّتْ عليه الملائكةُ حتَّى يُصْبِحَ."],"grade":"حسن","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارمي (3483)، وأبو نعيم في ((حلية الأولياء)) (5/26) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iuScXwCU"},{"id":"س-02100","fp":"e963b724f517","stateId":250,"easy":"إذا ختمت القرآن أول الليل ← تصلي عليك الملائكة حتى تصبح","cause":"وإذا ختَمَ في أوَّلِ اللَّيلِ","result":"صَلَّتْ عليه الملائكةُ حتَّى يُصْبِحَ","explicit":true,"repOf":"س-02099","ref":"كشاف القناع 1/430","text":["أدركْتُ أهْلَ الخيرِ مِن صَدْرِ هذه الأُمَّةِ يَستحِبُّونَ الختْمَ أوَّلَ اللَّيلِ وأوَّلَ النَّهارِ؛ يقولونَ: إذا ختَمَ في أوَّلِ النَّهارِ، صَلَّتْ عليه الملائكةُ حتَّى يُمْسِيَ، ",["وإذا ختَمَ في أوَّلِ اللَّيلِ",1],"، ",["صَلَّتْ عليه الملائكةُ حتَّى يُصْبِحَ",2],"."],"grade":"حسن","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارمي (3483)، وأبو نعيم في ((حلية الأولياء)) (5/26) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iuScXwCU"},{"id":"س-02321","fp":"294c2437c2ea","stateId":250,"easy":"إذا قرأت سورة الدخان في ليلة ← تصبح ويستغفر لك سبعون ألف ملك","cause":"مَن قَرَأ سورةَ الدُّخانِ في لَيلةٍ","result":"أصبَحَ يَستَغفِرُ له سَبعونَ ألف مَلَكٍ","explicit":true,"apply":{"k":"read","t":"سورة الدخان"},"otherNeedIds":[11],"ref":"الفوائد المجموعة 301","srcLabel":"الترمذي","text":["بلفظِ (",["مَن قَرَأ سورةَ الدُّخانِ في لَيلةٍ ",1],["أصبَحَ يَستَغفِرُ له سَبعونَ ألف مَلَكٍ) ",2],"[وفي] لَفظٍ: مَن قَرَأ حَم الدُّخانِ في لَيلةِ الجُمُعةِ غُفِرَ له"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده أبو بدر شجاع ابن الوليد وهو صدوق له أوهام","takhrij":"أخرجه الترمذي (2888)، وأبو يعلى (6232)، والبيهقي في ((الشعب)) (2246) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OKeTwLsY"},{"id":"س-08138","fp":"b618bb161883","stateId":250,"easy":"إذا قرأت سورة الكهف ← تتنزل الملائكة لسماعها","cause":"قرأ سورةَ الكهفِ","result":"تَنزَّلَتِ الملائكةُ لسماعِها كالظُّلَّةِ فيها السُّرُجُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"read","t":"سورة الكهف"},"ref":"مجموع الفتاوى 11/576","srcLabel":"مجموع الفتاوى","text":["أنَّ أُسيدَ بنَ حُضيرٍ لما ",["قرأ سورةَ الكهفِ",1]," ",["تَنزَّلَتِ الملائكةُ لسماعِها كالظُّلَّةِ فيها السُّرُجُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"ملائكة › أعمال الملائكة","dorar":"PYaLqQH6"},{"id":"س-06877","fp":"8a5d541e46e8","stateId":251,"easy":"إذا أضفت ضيفاً ليلة ← يرحمك الله","cause":"مَن يُضيفُ هذا اللَّيلةَ","result":"رَحِمَه اللهُ","explicit":true,"star":true,"ref":"صحيح مسلم 2054","srcLabel":"متفق عليه","text":["جاءَ رَجُلٌ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: إنِّي مَجهودٌ، فأرسَلَ إلى بَعضِ نِسائِه، فقالت: والذي بَعَثَكَ بالحَقِّ ما عِندي إلَّا ماءٌ، ثُمَّ أرسَلَ إلى أُخرى، فقالت مِثلَ ذلك، حتَّى قُلنَ كُلُّهنَّ مِثلَ ذلك: لا، والذي بَعَثَكَ بالحَقِّ، ما عِندي إلَّا ماءٌ، فقال: ",["مَن يُضيفُ هذا اللَّيلةَ",1]," ",["رَحِمَه اللهُ",2],"؟ فقامَ رَجُلٌ مِنَ الأنصارِ، فقال: أنا، يا رَسولَ اللهِ، فانطَلَقَ به إلى رَحلِه، فقال لامرَأتِه: هل عِندَكِ شيءٌ؟ قالت: لا إلَّا قوتُ صِبياني، قال: فعَلِّليهم بشيءٍ، فإذا دَخَلَ ضَيفُنا فأطفِئي السِّراجَ، وأريه أنَّا نَأكُلُ، فإذا أهوى ليَأكُلَ، فقومي إلى السِّراجِ حتَّى تُطفِئيه، قال: فقَعَدوا وأكَلَ الضَّيفُ، فلَمَّا أصبَحَ غَدا على النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: قد عَجِبَ اللهُ مِن صَنيعِكُما بضَيفِكُما اللَّيلةَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3798)، ومسلم (2054).","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"pdnBbPps"},{"id":"ق-0525","fp":"1d73ac4f5745","stateId":251,"easy":"الإيمان واتخاذ النفقة قربات عند الله ← قربة لهم ودخول رحمة الله","cause":"الإيمان واتخاذ النفقة قربات عند الله","result":"قربة لهم ودخول رحمة الله","explicit":true,"star":true,"otherNeedIds":[26],"ref":"سورة التوبة: 99","srcLabel":"القرآن الكريم","quran":{"s":9,"from":99,"to":99,"text":"وَمِنَ الْأَعْرَابِ مَنْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَتَّخِذُ مَا يُنْفِقُ قُرُبَاتٍ عِنْدَ اللَّهِ وَصَلَوَاتِ الرَّسُولِ أَلَا إِنَّهَا قُرْبَةٌ لَهُمْ سَيُدْخِلُهُمُ اللَّهُ فِي رَحْمَتِهِ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (99)","hl":[[0,236,1]]}},{"id":"س-02073","fp":"1320459ed59a","stateId":251,"easy":"إذا أطعمت مسكيناً ← فهو من موجبات الرحمة","cause":"إطعامُ المسلمِ المسكينِ","result":"من مُوجِباتِ الرَّحمةِ","explicit":true,"ref":"الترغيب والترهيب 2/90","srcLabel":"الحاكم","text":[["من مُوجِباتِ الرَّحمةِ",2]," ",["إطعامُ المسلمِ المسكينِ",1]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((مكارم الأخلاق)) (157)، والحاكم (3935)، والبيهقي في ((شعب الإيمان)) (3366) بمعناه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"CC89vkPX"},{"id":"س-08120","fp":"98924008824b","stateId":251,"easy":"إذا فطّرت صائماً في رمضان من حلال ← تصلي عليك الملائكة ليالي رمضان","cause":"مَن فطَّرَ صائمًا في شهرِ رمضانَ مِن كسبٍ حلالٍ","result":"صلَّت عليهِ الملائكةُ لَياليَ رمضانَ كلَّها وصافحَهُ جبريلُ لَيلةَ القدرِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الزواجر عن اقتراف الكبائر 1/198","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["مَن فطَّرَ صائمًا في شهرِ رمضانَ مِن كسبٍ حلالٍ ",1],["صلَّت عليهِ الملائكةُ لَياليَ رمضانَ كلَّها وصافحَهُ جبريلُ لَيلةَ القدرِ ، ",2],"ومَن صافحَهُ جبريلُ عليهِ السَّلامُ يرقُّ قلبُهُ وتَكثرُ دموعُهُ"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"ملائكة › أعمال الملائكة","dorar":"z0BdLphf"},{"id":"س-01609","fp":"55ded79cb30e","stateId":251,"easy":"إذا فطّرت الصائمين ← تصلّي عليك الملائكة","cause":"أفطَر عندَكم الصَّائمونَ","result":"وصلَّتْ عليكم الملائكةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[45],"ref":"صحيح ابن حبان 5296","srcLabel":"ابن ماجه","text":["أفطَر رسولُ اللهِ صلَّى اللهُ عليه وسلَّم عندَ سعدٍ فقال: ( ",["أفطَر عندَكم الصَّائمونَ",1]," ",["وصلَّتْ عليكم الملائكةُ",2]," وأكَل طعامَكم الأبرارُ )"],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (1747) والطبراني ((13/ 103)) (247) وأبو نعيم في ((معرفة الصحابة)) (4148 ) بنحوه","bab":"أطعمة › إطعام الطعام","dorar":"Di7R5ols"},{"id":"س-07566","fp":"ac2d344f893b","stateId":251,"easy":"إذا فطّرت صائماً ← تصلي عليك الملائكة","cause":"أفطَرَ عندَ","result":"وصَلَّتْ عليكمُ الملائِكَةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"star":true,"otherNeedIds":[1],"ref":"تخريج مشكل الآثار 1577","srcLabel":"مسلم","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يَزورُ الأنصارَ، فإذا جاء إلى دُورِ الأنصارِ جاءَ صِبيانُ الأنصارِ يَدورونَ حولَه، فيَدْعو لهم ويَمسَحُ رُؤوسَهم ويُسلِّمُ عليهم، فأَتى إلى بابِ سعدِ بنِ عُبادةَ، فسلَّمَ عليهم، فقال: السَّلامُ عليكم ورحمةُ اللهِ وبَركاتُه، فرَدَّ سعدٌ، فلم يَسمَعِ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ ثلاثَ مرَّاتٍ، وكان النَّبيُّ صلَّى اللهُ عليه وسلَّمَ لا يَزيدُ فوقَ ثلاثِ تَسليماتٍ، فإنْ أُذِنَ له وإلَّا انصَرَفَ، فخَرَجَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فجاءَ سعدٌ مُبادِرًا، فقال: يا رسولَ اللهِ، ما سلَّمْتَ تسليمةً إلَّا قد سَمِعتُها ورَدَدتُها، ولكنْ أرَدتُ أنْ تُكثِرَ علينا منَ السَّلامِ والرَّحمةِ، فادخُلْ يا رسولَ اللهِ، فدَخَلَ فجَلَسَ، فقرَّبَ إليه سعدٌ طعامًا، فأصابَ منه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فلمَّا أرادَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ أنْ يَنصرِفَ قال: أكَلَ طعامَكمُ الأبرارُ، و",["أفطَرَ عندَ",1],"كمُ الصائِمونَ، ",["وصَلَّتْ عليكمُ الملائِكَةُ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1577) واللفظ له، وأحمد (12406) بنحوه، وأبو داود (3854) مختصرًا.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"pcAsaTzF","merged":8,"otherRefs":["صحيح ابن حبان 5296 (صحيح)","الجامع الصغير 6574 (حسن)","خلاصة البدر المنير 2/211 (صحيح)","تخريج المسند لشعيب 12177 (صحيح)","آداب الزفاف 97 (صحيح)","الأذكار للنووي 247 (صحيح)","تحفة الذاكرين 245 (صحيح)"]},{"id":"س-02740","fp":"39803d7ce1ab","stateId":252,"easy":"إذا أُكل عندك وأنت صائم ← تصلي عليك الملائكة","cause":"الصَّائمُ إذا أُكِلَ عِندَهُ","result":"صلَّت عَليهِ الملائِكَةُ","explicit":true,"star":true,"similar":["س-02725","س-08209","س-03793"],"ref":"صحيح ابن خزيمة 3/ 536","srcLabel":"ابن خزيمة","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ دخلَ علَيها وَهيَ صائمةٌ، فقرَّبت إليهِ طعامًا، فقالَ: تعالى فَكُلي، فقالَت: إنِّي صائمةٌ، فَقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ: ",["الصَّائمُ إذا أُكِلَ عِندَهُ",1]," ",["صلَّت عَليهِ الملائِكَةُ",2]," [وفي روايةٍ]: بمثلِهِ سَواءً، وزادَ: حتَّى يفرَغوا، أو يَقضوا أَكْلَهُ"],"grade":"صحيح","narrator":"أم عمارة بنت كعب","muhaddith":"أخرجه في صحيحه","bab":"إيمان › الملائكة","dorar":"pR0M1U6w","merged":2,"otherRefs":["صحيح ابن خزيمة 3/ 536 (صحيح)"]},{"id":"س-02725","fp":"91addc76712e","stateId":252,"easy":"إذا أُكل عندك وأنت صائم ← تصلي عليك الملائكة حتى يفرغوا من طعامهم","cause":"إنَّ الصائمَ إذا أُكِلَ عندَه","result":"لم تَزَلِ تصلي عليه الملائكةُ حتى يُفْرَغَ من طعامِه","explicit":true,"repOf":"س-02740","ref":"الجامع الصغير 2032","text":[["إنَّ الصائمَ إذا أُكِلَ عندَه ",1],["لم تَزَلِ تصلي عليه الملائكةُ حتى يُفْرَغَ من طعامِه",2]],"grade":"صحيح","narrator":"أم عمارة بنت كعب الأنصارية","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (785)، وأحمد (27472) مطولاً باختلاف يسير","bab":"إيمان › الملائكة","dorar":"uoVgTGBZ"},{"id":"س-03700","fp":"adb730bd0840","stateId":252,"easy":"إذا تسحّرت ولو بجرعة ماء ← يصلي الله وملائكته عليك","cause":"السَّحورُ أكْلُه بَرَكةٌ، فلا تَدَعوه، ولو أنْ يَجرَعَ أحَدُكم جُرْعةً من ماءٍ","result":"فإنَّ اللهَ عزَّ وجلَّ وملائكتَه يُصلُّونَ على المُتَسحِّرينَ","explicit":true,"similar":["س-07568"],"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 11086","srcLabel":"أحمد","text":["\"",["السَّحورُ أكْلُه بَرَكةٌ، فلا تَدَعوه، ولو أنْ يَجرَعَ أحَدُكم جُرْعةً من ماءٍ؛ ",1],["فإنَّ اللهَ عزَّ وجلَّ وملائكتَه يُصلُّونَ على المُتَسحِّرينَ\"",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أحمد (11086) واللفظ له. وأخرجه ابن أبي شيبة (9013)، والطبراني في ((المعجم الأوسط)) (8064) مختصراً بلفظ: ((تسحروا فإن في السحور بركة))","bab":"اعتصام بالسنة › لزوم السنة","dorar":"rHHxnpR5"},{"id":"س-08209","fp":"a14eaee887e6","stateId":252,"easy":"إذا أُكل عندك وأنت صائم ← تصلي عليك الملائكة","cause":"إذا أُكِلَ عندَهُ","result":"إنَّ الصَّائمَ تصلِّي عليهِ الملائِكَةُ","explicit":true,"repOf":"س-02740","ref":"الترغيب والترهيب 1/153","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ دخلَ عليها فقدَّمت إليهِ طعامًا ، فقالَ : كُلي ، فقالَت : إنِّي صائمَةٌ ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إنَّ الصَّائمَ تصلِّي عليهِ الملائِكَةُ",2]," ",["إذا أُكِلَ عندَهُ",1]," حتَّى يفرُغوا ، وربَّما قالَ : حتَّى يشبَعوا"],"grade":"صحيح","narrator":"أم عمارة بنت كعب الأنصارية","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (785) واللفظ له، وأحمد (27472) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"LNm7PESk"},{"id":"س-03793","fp":"5ce014618d35","stateId":252,"easy":"إذا أُكل عندك وأنت صائم ← تصلي عليك الملائكة","cause":"إذا أُكِلَ عندَ الصَّائمِ الطَّعامُ","result":"صَلَّتْ عليه الملائكةُ","explicit":true,"repOf":"س-02740","ref":"تخريج سير أعلام النبلاء 2/281","text":["أتانا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقَرَّبْنا إليه طَعامًا، وكان بَعضُ مَن عندَه صائمًا، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["إذا أُكِلَ عندَ الصَّائمِ الطَّعامُ ",1],["صَلَّتْ عليه الملائكةُ",2],"."],"grade":"حسن","narrator":"أم عمارة","muhaddith":"رجاله ثقات عدا المرأة التي روت عن مولاتها أم عمارة واسمها ليلى لم يوثقها غير ابن حبان على عادته في توثيق المجاهيل","bab":"بر وصلة › إكرام الزائر","dorar":"GJihbxRx"},{"id":"س-07568","fp":"dc3f505cb4b7","stateId":252,"easy":"إذا تسحّرت ← يصلي الله عليك","cause":"المُتسحِّرِينَ","result":"صلَّى على","explicit":true,"repOf":"س-03700","ref":"مختصر زوائد البزار 1/415","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم ",["صلَّى على",2]," ",["المُتسحِّرِينَ",1],"."],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"إسناده حسن","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (217)، والطبراني (845) (22/ 337)، وأبو نعيم في ((معرفة الصحابة)) (6843) واللفظ لهم جميعا.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"P9Ihw2J7"},{"id":"س-04039","fp":"9b0f001a48d0","stateId":253,"easy":"إذا طفت أو صليت أو نظرت إلى الكعبة ← تنالك من رحمات الله النازلة كل يوم","cause":"سِتِّينَ للطَّائِفينَ، وأربَعينَ للمُصَلِّينَ، وعِشرينَ للنَّاظِرينَ","result":"يُنزِلُ على أهلِ هذا المَسجِدِ -يَعني: مَسجِدَ مَكَّةَ- في كُلِّ يَومٍ وليلةٍ عِشرينَ ومِئةَ رَحمةٍ","explicit":true,"star":true,"ref":"رحلة الصديق إلى البلد العتيق 25","srcLabel":"رحلة الصديق إلى البلد العتيق","text":["إنَّ اللَّهَ تعالى ",["يُنزِلُ على أهلِ هذا المَسجِدِ -يَعني: مَسجِدَ مَكَّةَ- في كُلِّ يَومٍ وليلةٍ عِشرينَ ومِئةَ رَحمةٍ",2],": ",["سِتِّينَ للطَّائِفينَ، وأربَعينَ للمُصَلِّينَ، وعِشرينَ للنَّاظِرينَ",1]],"grade":"حسن","narrator":"عبد الله بن عبَّاسٍ","muhaddith":"إسناده حسن","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"sLRIBu8Q","merged":4,"otherRefs":["تخريج الإحياء للعراقي 1/322 (حسن)","مختصر المقاصد 1236 (حسن)","إرشاد الساري 7/227 (حسن)"]},{"id":"ق-0078","fp":"68ff6b36229d","stateId":253,"easy":"بذل النفس ابتغاء مرضاة الله ← رأفة الله","cause":"بذل النفس ابتغاء مرضاة الله","result":"رأفة الله","explicit":true,"star":true,"otherNeedIds":[23],"ref":"سورة البقرة: 207","srcLabel":"القرآن الكريم","quran":{"s":2,"from":207,"to":207,"text":"وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ (207)","hl":[[0,97,1]]}},{"id":"ق-0083","fp":"f3eb9c179f72","stateId":253,"easy":"الإيمان والهجرة والجهاد في سبيل الله ← رجاء رحمة الله ومغفرته","cause":"الإيمان والهجرة والجهاد في سبيل الله","result":"رجاء رحمة الله ومغفرته","explicit":true,"otherNeedIds":[11],"ref":"سورة البقرة: 218","srcLabel":"القرآن الكريم","quran":{"s":2,"from":218,"to":218,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ وَاللَّهُ غَفُورٌ رَحِيمٌ (218)","hl":[[0,140,1]]}},{"id":"س-07567","fp":"e350aad90c96","stateId":253,"easy":"إذا حرست المسلمين ← رحمك الله","cause":"حارِسَ الحرَسِ","result":"رَحِمَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 2473","srcLabel":"ابن ماجه","text":[["رَحِمَ اللهُ",2]," ",["حارِسَ الحرَسِ",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (2769)، والدارمي (2445)، وأبو يعلى الموصلي (1750) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"TxZpBuen"},{"id":"س-07934","fp":"4af0fbc3133a","stateId":254,"easy":"إذا خرجت تعود مريضاً ← تخوض في الرحمة، فإذا جلست عنده غمرتك","cause":"أنَّ العائدَ إذا خرجَ من بيتِه يعودُ مريضًا","result":"كانَ يَخوضُ في الرَّحمةِ خوضًا، فإذا انتَهى إلى المريضِ فجلسَ غَمَرَتهُ الرَّحمةُ حتَّى يَرجعَ من عندِ المريضِ حينَ يرجعُ يشيِّعُه سبعونَ ألفَ ملَكٍ، يَستغفرونَ لهُ نهارًا أجمعَ، وإن كانَ ليلًا كانَ بذلك المنزلِ حتَّى يُصبِحَ، ولهُ خريفٌ في الجنَّةِ","explicit":true,"star":true,"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 2/49","srcLabel":"مسلم","text":["حديث: \"أنَّ أبا موسى انطلَقَ عائدًا للحَسَنِ [فقال لهُ: «أعائدًا جئتَ أو زائرًا؟» قال: لا، بل زائرًا، قال: أما إنَّه لا يَمنعُني وإن كانَ في نفسِكَ ما في نفسِكَ أن أُخبرَك ",["أنَّ العائدَ إذا خرجَ من بيتِه يعودُ مريضًا",1]," ",["كانَ يَخوضُ في الرَّحمةِ خوضًا، فإذا انتَهى إلى المريضِ فجلسَ غَمَرَتهُ الرَّحمةُ حتَّى يَرجعَ من عندِ المريضِ حينَ يرجعُ يشيِّعُه سبعونَ ألفَ ملَكٍ، يَستغفرونَ لهُ نهارًا أجمعَ، وإن كانَ ليلًا كانَ بذلك المنزلِ حتَّى يُصبِحَ، ولهُ خريفٌ في الجنَّةِ",2],"]\"."],"grade":"صحيح","narrator":"الحسن بن علي","muhaddith":"[سنده] صحيح على شرط مسلم","takhrij":"أخرجه ابن أبي شيبة (10944)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"iMGC6fYC","merged":5,"otherRefs":["الأحاديث المختارة 2719 (صحيح)","الجامع الصغير 5341 (صحيح)","صحيح الجامع 3963 (صحيح)","الأحاديث المختارة 637 (صحيح)"]},{"id":"س-02187","fp":"b864bbda3cca","stateId":254,"easy":"إذا عدت مريضاً ← تخوض في الرحمة وتستقر فيها إذا جلست","cause":"من عادَ مريضا","result":"خاضَ في الرحمةَ فإذا جلسَ عندهُ استَقْنَع فيها ، فإذا خرج من عندهِ خاضَ في الرحمةَ حتى يرْجِعَ بيته","explicit":true,"star":true,"similar":["س-02901","س-02272"],"ref":"التمهيد 24/273","srcLabel":"البخاري","text":[["من عادَ مريضا ",1],["خاضَ في الرحمةَ فإذا جلسَ عندهُ استَقْنَع فيها ، فإذا خرج من عندهِ خاضَ في الرحمةَ حتى يرْجِعَ بيته",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14260)، والبخاري في ((الأدب المفرد)) (522)، وابن أبي شيبة في ((المصنف)) (10939) بنحوه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"aTF0pXiO","merged":3,"otherRefs":["مجمع الزوائد 2/300 (حسن)"]},{"id":"س-07950","fp":"e7976ab96420","stateId":254,"easy":"إذا عدت أخاك المسلم ← يبعث الله سبعين ألف ملك يصلّون عليك","cause":"ما مِن مُسلِمٍ يَعودُ مُسلِمًا","result":"إلَّا ابْتَعَثَ اللهُ له سَبْعينَ ألْفَ مَلَكٍ يُصَلُّونَ عليه أيَّ ساعةٍ مِن النَّهارِ كانَتْ حتَّى يُمْسيَ، أو أيَّ ساعةٍ مِن اللَّيلِ كانَتْ حتَّى يُصبِحَ","explicit":true,"similar":["س-07954"],"ref":"الأحاديث المختارة 698","srcLabel":"البخاري","text":["«أنَّه عادَ حَسَنًا وعِنْدَه علِيٌّ، فقالَ علِيٌّ: يا عَمْرُو، أَتَعودُ حَسَنًا وفي النَّفْسِ ما فيها؟ قالَ: نَعمْ، إنَّك لسْتَ برَبِّ قَلْبي فتَصْرِفَه حيثُ شِئْتَ! فقالَ: أَمَا إنَّ ذلك لا يَمنَعُني أن أُؤَدِّيَ إليك النَّصيحةَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["ما مِن مُسلِمٍ يَعودُ مُسلِمًا",1]," ",["إلَّا ابْتَعَثَ اللهُ له سَبْعينَ ألْفَ مَلَكٍ يُصَلُّونَ عليه أيَّ ساعةٍ مِن النَّهارِ كانَتْ حتَّى يُمْسيَ، أو أيَّ ساعةٍ مِن اللَّيلِ كانَتْ حتَّى يُصبِحَ»",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"Zs9FPlUf","merged":2,"otherRefs":["تخريج صحيح ابن حبان 2958 (صحيح)"]},{"id":"س-02901","fp":"8c779853e281","stateId":254,"easy":"إذا عدت مريضاً ← تخوض في الرحمة، فإذا جلست انغمست فيها","cause":"مَنْ عادَ مَرِيضًا","result":"لمْ يَزَلْ يَخُوضُ في الرحمةِ حتى يَجْلِسَ ، فإِذَا جلسَ اغْتَمَسَ فيها","explicit":true,"repOf":"س-02187","ref":"السلسلة الصحيحة 2504","text":[["مَنْ عادَ مَرِيضًا ",1],["لمْ يَزَلْ يَخُوضُ في الرحمةِ حتى يَجْلِسَ ، فإِذَا جلسَ اغْتَمَسَ فيها",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه أحمد (14260)، والبخاري في ((الأدب المفرد)) (522)، وابن أبي شيبة في ((المصنف)) (10939) واللفظ له","bab":"إيمان › الوعد","dorar":"YbZCgY0g"},{"id":"س-07951","fp":"91ec646b5444","stateId":254,"easy":"إذا عدت مريضاً ← يصلي عليك سبعون ألف ملك","cause":"ما مِن عَبْدٍ مُسلِمٍ يَعودُ مَريضًا","result":"إلَّا صلَّى عليه سَبْعونَ ألْفَ مَلَكٍ مِن السَّاعةِ الَّتي عادَه فيها، إن كانَ نَهارًا حتَّى تَغرُبَ الشَّمْسُ، وإن كانَ لَيْلًا حتَّى تَطلُعَ الشَّمْسُ","explicit":true,"similar":["س-08111","س-02735"],"ref":"الأحاديث المختارة 414","srcLabel":"البخاري","text":["«عن الحَسَنِ بنِ علِيٍّ أنَّه مَرِضَ فعادَه عَمْرُو بنُ حُرَيثٍ ودَخَلَ عليه علِيٌّ، فقالَ: يا عَمْرُو تَعودُ الحَسَنَ وفي النَّفْسِ ما فيها؟ وكانَ يُحِبُّ عُثْمانَ بنَ عفَّانَ، فقالَ: يا علِيُّ، إنَّك لسْتَ برَبِّ قَلْبي تُصَرِّفُني حيثُ شِئْتَ! قالَ: أَمَا أنَّ ذلك ليس بمانِعي أن أرى لك النَّصيحةَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["ما مِن عَبْدٍ مُسلِمٍ يَعودُ مَريضًا",1]," ",["إلَّا صلَّى عليه سَبْعونَ ألْفَ مَلَكٍ مِن السَّاعةِ الَّتي عادَه فيها، إن كانَ نَهارًا حتَّى تَغرُبَ الشَّمْسُ، وإن كانَ لَيْلًا حتَّى تَطلُعَ الشَّمْسُ",2],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"tADka33b"},{"id":"س-07954","fp":"6d0716ec266c","stateId":254,"easy":"إذا عدت أخاك ← يبعث الله سبعين ألف ملك يصلّون عليك","cause":"ما مِن مُسلِمٍ عادَ أخاه","result":"إلَّا ابْتَعَثَ اللهُ له سَبْعينَ ألْفَ مَلَكٍ يُصَلُّونَ عليه مِن أيِّ ساعاتِ النَّهارِ كانَ حتَّى يُمْسيَ، ومِن أيِّ ساعاتِ اللَّيلِ كانَ حتَّى يُصبِحَ","explicit":true,"repOf":"س-07950","ref":"الأحاديث المختارة 699","text":["«أنَّ عَمْرَو بنَ حُرَيْثٍ عادَ الحَسَنَ بنَ علِيٍّ، فقالَ له علِيٌّ: أَتَعودُ الحَسَنَ وفي نَفْسِك ما فيها؟ فقالَ له عَمْرٌو: إنَّك لسْتَ برَبِّي فتَصْرِفَ قَلْبي حيثُ شِئْتَ! قالَ علِيٌّ: أَمَا إنَّ ذلك لا يَمنَعُنا أن نُؤَدِّيَ إليك النَّصيحةَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["ما مِن مُسلِمٍ عادَ أخاه",1]," ",["إلَّا ابْتَعَثَ اللهُ له سَبْعينَ ألْفَ مَلَكٍ يُصَلُّونَ عليه مِن أيِّ ساعاتِ النَّهارِ كانَ حتَّى يُمْسيَ، ومِن أيِّ ساعاتِ اللَّيلِ كانَ حتَّى يُصبِحَ",2],".\nقالَ له عَمْرٌو: كيف تَقولُ في المَشْيِ في الجِنازةِ بَيْنَ يَدَيها أو خَلْفَها؟ فقالَ علِيٌّ: إنَّ فَضْلَ المَشْيِ خَلْفَها على بَيْنَ يَدَيها، كفَضَلِ صَلاةِ المَكْتوبةِ في جَماعةٍ على الوَحْدةِ.\nقالَ عَمْرٌو: فإنِّي رَأيْتُ أبا بَكْرٍ وعُمَرَ يَمْشيانِ أمامَ الجِنازةِ؟!\nقالَ علِيٌّ: إنَّهما كَرِها أن يُحرِجا النَّاسَ»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"p4JwQ49A"},{"id":"س-02266","fp":"481d121f57cb","stateId":254,"easy":"إذا عدت مريضاً فجلست عنده ← تغشاك الرحمة من كل جانب","cause":"ما من رَجُلٍ يَعودُ مَريضًا فيَجلِسُ عنده","result":"إلَّا تغَشَّتْه الرَّحمةُ مِن كُلِّ جانِبٍ ما جَلَس عندَه، فإذا خرَجَ ِمن عِندِه كُتِبَ له أجرُ صِيامٍ يومٍ","explicit":true,"otherNeedIds":[45],"ref":"الضعفاء الكبير 1/202","srcLabel":"ابن عدي","text":[["ما من رَجُلٍ يَعودُ مَريضًا فيَجلِسُ عنده",1]," ",["إلَّا تغَشَّتْه الرَّحمةُ مِن كُلِّ جانِبٍ ما جَلَس عندَه، فإذا خرَجَ ِمن عِندِه كُتِبَ له أجرُ صِيامٍ يومٍ",2],"."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"ثابت من غير هذا الوجه بغير هذا اللفظ","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (2/ 416) واللفظ له.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"w7n8WThX"},{"id":"س-02272","fp":"ce7bf29dd1cc","stateId":254,"easy":"إذا عدت مريضاً ← تخوض في الرحمة، فإذا قعدت عنده غمرتك","cause":"أيُّما رَجُلٍ يَعودُ مَريضًا","result":"فإنَّما يَخوضُ في الرَّحمةِ، فإذا قَعَدَ عندَ المريضِ غَمَرَتْه الرَّحمةُ","explicit":true,"repOf":"س-02187","ref":"تخريج المسند لشعيب 12782","text":["أتَيتُ أنَسَ بنَ مالِكٍ، فقُلْتُ: يا أبا حَمزَةَ، إنَّ المكانَ بَعيدٌ ونحن يُعجِبُنا أنْ نَعودَكَ، فرَفَعَ رَأْسَه فقال: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["أيُّما رَجُلٍ يَعودُ مَريضًا، ",1],["فإنَّما يَخوضُ في الرَّحمةِ، فإذا قَعَدَ عندَ المريضِ غَمَرَتْه الرَّحمةُ",2],". قال: فقُلتُ: يا رسولَ اللهِ، هذا للصَّحيحِ الذي يَعودُ المريضَ، فالمريضُ ما له؟ قال: تُحَطُّ عنه ذُنوبُه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (12782) واللفظ له، والطبراني في ((المعجم الأوسط)) (8851)، والبيهقي في ((شعب الإيمان)) (9181)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Yt3kqORY"},{"id":"س-02738","fp":"c37754ace7fe","stateId":254,"easy":"إذا عدت مريضاً مساءً ← يخرج معك سبعون ألف ملك يستغفرون لك حتى تصبح","cause":"ما مِن رجُلٍ يَعودُ مريضًا مُمْسِيًا","result":"إلَّا خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُصبِحَ، وكان له خريفٌ في الجنَّةِ","explicit":true,"apply":{"k":"time","t":"في المساء"},"similar":["س-02739"],"otherNeedIds":[67],"ref":"تخريج سنن أبي داود 3099","srcLabel":"الترمذي","text":["عَنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ، بمعناهُ [أيْ: بمعنى حديثِ: قال: ",["ما مِن رجُلٍ يَعودُ مريضًا مُمْسِيًا ",1],["إلَّا خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُصبِحَ، وكان له خريفٌ في الجنَّةِ،",2]," ومَن أتاهُ مُصْبِحًا خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُمْسِيَ، وكان له خريفٌ في الجنَّةِ]، لم يَذكُرِ الخريفَ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح\nوقد اختلف في رفعه ووقفه","takhrij":"أخرجه الترمذي (969)، وأحمد (975) باختلاف يسير وفي أوله قصة","bab":"إيمان › الملائكة","dorar":"HHjFlyFV"},{"id":"س-02739","fp":"d8b1de7f0dab","stateId":254,"easy":"إذا عدت مريضاً صباحاً ← يخرج معك سبعون ألف ملك يستغفرون لك حتى تمسي","cause":"ومَن أتاهُ مُصْبِحًا","result":"خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُمْسِيَ، وكان له خريفٌ في الجنَّةِ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"repOf":"س-02738","otherNeedIds":[67],"ref":"تخريج سنن أبي داود 3099","text":["عَنِ النَّبيِّ صلَّى اللَّهُ عليه وسلَّمَ، بمعناهُ [أيْ: بمعنى حديثِ: قال: ما مِن رجُلٍ يَعودُ مريضًا مُمْسِيًا إلَّا خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُصبِحَ، وكان له خريفٌ في الجنَّةِ، ",["ومَن أتاهُ مُصْبِحًا",1]," ",["خرَجَ معهُ سبعونَ ألْفَ مَلَكٍ يَستغفِرونَ له حتَّى يُمْسِيَ، وكان له خريفٌ في الجنَّةِ",2],"]، لم يَذكُرِ الخريفَ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح\nوقد اختلف في رفعه ووقفه","takhrij":"أخرجه الترمذي (969)، وأحمد (975) باختلاف يسير وفي أوله قصة","bab":"إيمان › الملائكة","dorar":"HHjFlyFV"},{"id":"س-07926","fp":"aa5caef0a838","stateId":254,"easy":"إذا عدت المريض ← تخوض في الرحمة حتى تستقر فيها عنده","cause":"إذا عاد الرجلُ المريضَ","result":"خاض الرحمةَ ، حتى إذا قعَدَ عندَه قرَّت فيه","explicit":true,"similar":["س-01920"],"ref":"الاستذكار 7/426","srcLabel":"مالك","text":[["إذا عاد الرجلُ المريضَ ",1],["خاض الرحمةَ ، حتى إذا قعَدَ عندَه قرَّت فيه ",2],"، أو نحوَ هذا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"محفوظ من رواية أهل المدينة وروي من طرق","takhrij":"أخرجه مالك في ((الموطأ)) (17)، وابن عدي في ((الكامل في الضعفاء)) (4/41)","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"mCdvzW7L"},{"id":"س-08111","fp":"89a561954296","stateId":254,"easy":"إذا عدت مريضاً ← يخرج معك سبعون ألف ملك يستغفرون لك","cause":"ما مِن مُسلِمٍ يعودُ مريضًا","result":"إلَّا خرجَ معَهُ سبعونَ ألفَ ملَكٍ ، كلُّهم يَستغفرُ لَهُ ، إن كانَ مصبحًا حتَّى يُمْسيَ ، وَكانَ لَهُ خريفًا في الجنَّةِ ، وإن كانَ ممسيًا خرجَ معَهُ سبعونَ ألفَ","explicit":true,"repOf":"س-07951","ref":"تخريج المسند لشاكر 2/206","text":["عادَ أبو موسَى الأشعريُّ الحسنَ بنَ عليِّ بنِ أبي طالبٍ رضيَ اللَّهُ عنهُ فَقالَ لَهُ : عليٌّ رضيَ اللَّهُ عنهُ أعائدًا جئتَ أم زائرًا ؟ قالَ : لا ، بَل جئتُ عائدًا قالَ عليٌّ رضيَ اللَّهُ عنهُ أما إنَّهُ ",["ما مِن مُسلِمٍ يعودُ مريضًا",1]," ",["إلَّا خرجَ معَهُ سبعونَ ألفَ ملَكٍ ، كلُّهم يَستغفرُ لَهُ ، إن كانَ مصبحًا حتَّى يُمْسيَ ، وَكانَ لَهُ خريفًا في الجنَّةِ ، وإن كانَ ممسيًا خرجَ معَهُ سبعونَ ألفَ",2]," ملَكٍ ، كلُّهم يستَغفِرونَ لَهُ حتَّى يُصْبِحَ ، وَكانَ لَهُ خَريفًا في الجنَّةِ"],"grade":"صحيح","narrator":"عبدالله بن نافع","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3100) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"JKVhxGYx"},{"id":"س-01920","fp":"f547d23affb0","stateId":254,"easy":"إذا عدت المريض ← تخوض في الرحمة، فإذا جلست عنده انغمست فيها","cause":"من عادَ المريضَ","result":"خاضَ في الرَّحمةِ فإذا جلسَ عندهُ اغتَمسَ فيها","explicit":true,"repOf":"س-07926","ref":"مجمع الزوائد 2/301","text":[["من عادَ المريضَ ",1],["خاضَ في الرَّحمةِ فإذا جلسَ عندهُ اغتَمسَ فيها",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (139)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QrQ3yUDL"},{"id":"س-02735","fp":"a636812afd30","stateId":254,"easy":"إذا عدت مريضاً ← تمشي في بساتين الجنة ويستغفر لك سبعون ألف ملك","cause":"مَن عاد مريضًا، مَشى في خِرافِ الجَنَّةِ، فإذا جلَس عندَه استَنقَع في الرَّحمةِ، فإذا خرَج من عندِه","result":"وكِّلَ به سَبعونَ ألفَ مَلَكٍ يَستغفِرونَ له ذلك اليومَ","explicit":true,"repOf":"س-07951","otherNeedIds":[67],"ref":"تخريج المسند لشعيب 1166","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قال: ",["مَن عاد مريضًا، مَشى في خِرافِ الجَنَّةِ، فإذا جلَس عندَه استَنقَع في الرَّحمةِ، فإذا خرَج من عندِه ",1],["وكِّلَ به سَبعونَ ألفَ مَلَكٍ يَستغفِرونَ له ذلك اليومَ",2],"."],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن والصحيح وقفه","takhrij":"أخرجه من طرق أبو داود (3099)، والترمذي (969)، والنسائي في ((السنن الكبرى)) (7494)، وابن ماجه (1442)، وأحمد (612) باختلاف يسير، وأخرجه عبدالله بن أحمد في ((زوائد المسند)) (1166) واللفظ له","bab":"إيمان › الملائكة","dorar":"cui1UYcU"},{"id":"س-00335","fp":"ca3a90185ae1","stateId":255,"easy":"إذا كنت سمحاً في البيع والشراء والمطالبة ← يرحمك الله","cause":"رَجُلًا سَمْحًا إذا باعَ، وإذا اشْتَرى، وإذا اقْتَضى","result":"رَحِمَ اللهُ","explicit":true,"star":true,"ref":"الأحكام الوسطى 3/ 232","srcLabel":"البخاري","text":["[رَحِمَ اللهُ ",["رَجُلًا سَمْحًا إذا باعَ، وإذا اشْتَرى، وإذا اقْتَضى",1],"].\n",["رَحِمَ اللهُ",2]," رَجُلًا سَمْحًا إذا باعَ، وإذا اشْتَرى، وإذا اقْتَضى."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البخاري (2076)، واللفظ له والترمذي (1320)، وابن ماجه (2203) بنحوه","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"Z0lKoBqz","merged":2,"otherRefs":["صحيح الجامع 3495 (صحيح)"]},{"id":"ق-0512","fp":"9827d9a1f57f","stateId":255,"easy":"موالاة المؤمنين والأمر بالمعروف والنهي عن المنكر وإقامة الصلاة وإيتاء الزكاة وطاعة الله ورسوله ← رحمة الله","cause":"موالاة المؤمنين والأمر بالمعروف والنهي عن المنكر وإقامة الصلاة وإيتاء الزكاة وطاعة الله ورسوله","result":"رحمة الله","explicit":true,"ref":"سورة التوبة: 71","srcLabel":"القرآن الكريم","quran":{"s":9,"from":71,"to":71,"text":"وَالْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ يَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَيُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَيُطِيعُونَ اللَّهَ وَرَسُولَهُ أُولَئِكَ سَيَرْحَمُهُمُ اللَّهُ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ (71)","hl":[[0,233,1]]}},{"id":"ق-1247","fp":"da8d090b8418","stateId":255,"easy":"الإصلاح بين الإخوة والتقوى ← رحمة الله","cause":"الإصلاح بين الإخوة والتقوى","result":"رحمة الله","explicit":true,"otherNeedIds":[41],"ref":"سورة الحجرات: 10","srcLabel":"القرآن الكريم","quran":{"s":49,"from":10,"to":10,"text":"إِنَّمَا الْمُؤْمِنُونَ إِخْوَةٌ فَأَصْلِحُوا بَيْنَ أَخَوَيْكُمْ وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُرْحَمُونَ (10)","hl":[[0,108,1]]}},{"id":"س-00129","fp":"f28cc997f9ae","stateId":255,"easy":"إذا صافحت أخاك ← تنزل عليكما مئة رحمة، أكثرها للبادئ","cause":"فإذا تصافَحا","result":"أنزلَ اللَّهُ عليهِما مائةَ رحمَةٍ للبادئِ تِسعونَ وللمصافِحِ عشرةٌ","explicit":true,"ref":"الجامع الصغير 485","srcLabel":"البيهقي","text":["إذا التَقى المسلِمانِ فَسلَّمَ أحدُهُما عَلى صاحبِه كانَ أحبُّهُما إلى اللَّهِ أحسنَهُما بشرًا بصاحبِه ",["فإذا تصافَحا",1]," ",["أنزلَ اللَّهُ عليهِما مائةَ رحمَةٍ للبادئِ تِسعونَ وللمصافِحِ عشرةٌ",2]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"حسن","takhrij":"أخرجه البزار (308)، والبيهقي في ((الشعب)) (7692)، وابن أبي الدنيا في ((مداراه الناس)) (65) باختلاف يسير.","bab":"آداب السلام › إفشاء السلام","dorar":"6pdQN3cF"},{"id":"س-01631","fp":"3cbb32585ee9","stateId":255,"easy":"إذا أطعمت من أطعمك ← يبارك الله لك (من واقعة)","cause":"أطعِمْ مَن أطعَمَني","result":"فإذا هي حافِلةٌ، وإذا هُنَّ حُفَّلٌ كُلُّهنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"صحيح مسلم 2055","srcLabel":"أبو داود","text":["أقبَلتُ أنا وصاحِبانِ لي، وقد ذَهَبَت أسماعُنا وأبصارُنا مِنَ الجَهدِ، فجَعَلنا نَعرِضُ أنفُسَنا على أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فليس أحَدٌ منهم يَقبَلُنا، فأتَينا النَّبيَّ صلَّى اللهُ عليه وسلَّم فانطَلَقَ بنا إلى أهلِه، فإذا ثَلاثةُ أعنُزٍ، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: احتَلِبوا هذا اللَّبَنَ بينَنا، قال: فكُنَّا نَحتَلِبُ فيَشرَبُ كُلُّ إنسانٍ مِنَّا نَصيبَه، ونَرفَعُ للنَّبيِّ صلَّى اللهُ عليه وسلَّم نَصيبَه، قال: فيَجيءُ مِنَ اللَّيلِ فيُسَلِّمُ تَسليمًا لا يوقِظُ نائِمًا ويُسمِعُ اليَقظانَ، قال: ثُمَّ يَأتي المَسجِدَ فيُصَلِّي، ثُمَّ يَأتي شَرابَه فيَشرَبُ، فأتاني الشَّيطانُ ذاتَ لَيلةٍ وقد شَرِبتُ نَصيبي، فقال: مُحَمَّدٌ يَأتي الأنصارَ فيُتحِفونَه، ويُصيبُ عِندَهم، ما به حاجةٌ إلى هذه الجُرعةِ، فأتَيتُها فشَرِبتُها، فلَمَّا أن وغَلَت في بَطني، وعَلِمتُ أنَّه ليس إليها سَبيلٌ، قال: نَدَّمَني الشَّيطانُ، فقال: ويحَكَ! ما صَنَعتَ؟! أشَرِبتَ شَرابَ مُحَمَّدٍ، فيَجيءُ فلا يَجِدُه فيَدعو عليكَ، فتَهلِكُ فتَذهَبُ دُنياكَ وآخِرَتُكَ؟! وعليَّ شَملةٌ إذا وضَعتُها على قدَمَيَّ خَرَجَ رَأسي، وإذا وضَعتُها على رَأسي خَرَجَ قدَمايَ، وجَعَلَ لا يَجيئُني النَّومُ، وأمَّا صاحِبايَ فناما ولم يَصنَعا ما صَنَعتُ. قال: فجاءَ النَّبيُّ صلَّى اللهُ عليه وسلَّم، فسَلَّمَ كما كان يُسَلِّمُ، ثُمَّ أتى المَسجِدَ فصَلَّى، ثُمَّ أتى شَرابَه فكَشَفَ عنه، فلم يَجِدْ فيه شيئًا، فرَفَعَ رَأسَه إلى السَّماءِ، فقُلتُ: الآنَ يَدعو عليَّ فأهلِكُ، فقال: اللَّهمَّ ",["أطعِمْ مَن أطعَمَني",1],"، وأسقِ مَن أسقاني، قال: فعَمَدتُ إلى الشَّملةِ فشَدَدتُها عليَّ، وأخَذتُ الشَّفرةَ فانطَلَقتُ إلى الأعنُزِ أيُّها أسمَنُ؟ فأذبَحُها لرَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ",["فإذا هي حافِلةٌ، وإذا هُنَّ حُفَّلٌ كُلُّهنَّ",2],"، فعَمَدتُ إلى إناءٍ لآلِ مُحَمَّدٍ صلَّى اللهُ عليه وسلَّم ما كانوا يَطمَعونَ أن يَحتَلِبوا فيه، قال: فحَلَبتُ فيه حتَّى عَلَتْه رَغوةٌ، فجِئتُ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أشَرِبتُم شَرابَكُمُ اللَّيلةَ؟ قال: قُلتُ: يا رَسولَ اللهِ، اشرَبْ، فشَرِبَ، ثُمَّ ناولَني، فقُلتُ: يا رَسولَ اللهِ، اشرَبْ، فشَرِبَ، ثُمَّ ناولَني، فلَمَّا عَرَفتُ أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قد رَويَ وأصَبتُ دَعوتَه، ضَحِكتُ حتَّى أُلقيتُ إلى الأرضِ، قال: فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: إحدى سَوآتِكَ يا مِقدادُ! فقُلتُ: يا رَسولَ اللهِ، كان مِن أمري كَذا وكَذا وفَعَلتُ كَذا، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ما هذه إلَّا رَحمةٌ مِنَ اللهِ، أفلا كُنتَ آذَنتَني فنوقِظَ صاحِبَينا فيُصيبانِ منها، قال: فقُلتُ: والذي بَعَثَكَ بالحَقِّ، ما أُبالي إذا أصَبتَها وأصَبتُها معكَ مَن أصابَها مِنَ النَّاسِ."],"grade":"صحيح","narrator":"المقداد بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه ابن أبي شيبة (487)، وأبو داود الطيالسي (1256) واللفظ لهما، والترمذي (2719) مختصرا.","bab":"أطعمة › حلب الرجل الناقة وغيرها","dorar":"31J94X7H"},{"id":"س-08303","fp":"846586866726","stateId":256,"easy":"إذا رحمت أولادك ← رحمك الله برحمتك لهم","cause":"فشقَّتْها نِصفَيْنِ، فأعطَتْ كُلَّ صَبِيٍّ لها نِصفَ تمْرةٍ","result":"لقدْ رَحِمَها اللهُ برَحْمَتِها صِبْيَتَيْها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[41,38],"ref":"المستدرك على الصحيحين 7553","srcLabel":"البخاري","text":["جاءتِ امرأةٌ إلى عائشةَ رَضيَ اللهُ عنها تَسألُ، ومعها صَبِيَّانِ، فأعطَتْها ثَلاثَ تَمَراتٍ، فأعطَتْ كُلَّ صَبيٍّ تَمْرةً، وأمسَكَتْ لنَفْسِها تمْرةً، فأكَلَ الصَّبِيَّانِ التَّمْرَتَيْنِ، فعَمَدَتْ إلى التَّمرةِ ",["فشقَّتْها نِصفَيْنِ، فأعطَتْ كُلَّ صَبِيٍّ لها نِصفَ تمْرةٍ",1],"، فجاءَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فأخبرَتْهُ، فقالَ: وما يُعجِبُكِ مِنْها! ",["لقدْ رَحِمَها اللهُ برَحْمَتِها صِبْيَتَيْها",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البزار (6762)، والبخاري في ((الأدب المفرد)) (89)، والأصبهاني في ((الترغيب والترهيب)) (1579) بنحوه","bab":"مناقب وفضائل › بعض من شهد النبي بأنهم من أهل الجنة","dorar":"0selTMxC","merged":4,"otherRefs":["سير أعلام النبلاء 4/536 (حسن)","صحيح الأدب المفرد 66 (صحيح)","صحيح الجامع 4373 (صحيح)"]},{"id":"س-03807","fp":"6c7a4afdd7b7","stateId":256,"easy":"إذا رحمت ولدك أو صغيرك ← فالله أرحم بك منك به","cause":"أترحمُهُ ؟ قالَ: نعَم","result":"فاللَّهُ أرحَمُ بِكَ منكَ بِهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1411","srcLabel":"البخاري","text":["أتى النَّبيَّ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - رجلٌ ومعَهُ صبيٌّ ، فجعلَ يضمُّهُ إليهِ ، فقالَ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ: ",["أترحمُهُ ؟ قالَ: نعَم",1]," ، قالَ: ",["فاللَّهُ أرحَمُ بِكَ منكَ بِهِ",2]," ، وَهوَ أرحمُ الرَّاحمينَ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (377)","bab":"بر وصلة › حب الولد","dorar":"Rsy3lIUQ","merged":2,"otherRefs":["صحيح الأدب المفرد 290 (صحيح)"]},{"id":"س-00116","fp":"92f8883d15de","stateId":256,"easy":"إذا رحمت ← يرحمك الله، فإنما يرحم الله من عباده الرحماء","cause":"الرُّحَماءَ","result":"ولا يَرحَمُ اللهُ مِن عِبادِه إلَّا الرُّحَماءَ","explicit":true,"star":true,"similar":["س-05468","س-03836"],"ref":"صحيح البخاري 5655","srcLabel":"مسلم","text":["أنَّ ابنةً للنَّبيِّ صلَّى اللهُ عليه وسلَّم أرسَلَت إليه، وهو مع النَّبيِّ صلَّى اللهُ عليه وسلَّم وسَعدٌ وأُبَيٌّ -نَحسِبُ- أنَّ ابنَتي قد حُضِرَت فاشهَدْنا، فأرسَلَ إليها السَّلامَ، ويقولُ: إنَّ للَّهِ ما أخَذَ وما أعطى، وكُلُّ شَيءٍ عِندَه مُسَمًّى، فلتَحتَسِبْ ولتَصبِرْ. فأرسَلَت تُقسِمُ عليه، فقامَ النَّبيُّ صلَّى اللهُ عليه وسلَّم وقُمنا، فرُفِعَ الصَّبيُّ في حَجرِ النَّبيِّ صلَّى اللهُ عليه وسلَّم ونَفسُه تَقَعقَعُ، ففاضَت عَينا النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال له سَعدٌ: ما هذا يا رَسولَ اللهِ؟! قال: هذه رَحمةٌ وضَعَها اللهُ في قُلوبِ مَن شاءَ مِن عِبادِه، ",["ولا يَرحَمُ اللهُ مِن عِبادِه إلَّا الرُّحَماءَ",2],"."],"grade":"صحيح","narrator":"أسامة بن زيد","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (923) باختلاف يسير","bab":"آداب السلام › إفشاء السلام","dorar":"SWGH2bRl","merged":9,"otherRefs":["صحيح أبي داود 3125 (صحيح)","صحيح البخاري 6655 (صحيح)","تخريج صحيح ابن حبان 461 (صحيح)","تخريج صحيح ابن حبان 3158 (صحيح)","صحيح البخاري 1284 (صحيح)","صحيح الأدب المفرد 397 (صحيح)","صحيح ابن ماجه 1301 (صحيح)","صحيح مسلم 923 (صحيح)"]},{"id":"س-05468","fp":"b78d80672f20","stateId":256,"easy":"إذا رحمت ← يرحمك الله","cause":"مَن يَرحَمُ","result":"وإنَّما يَرحَمُ اللهُ عَزَّ وجَلَّ","explicit":true,"repOf":"س-00116","ref":"الأحاديث المختارة 13 / 191","text":["«إنَّما يَدخُلُ الجنَّةَ مَن يَرْجوها ويُجَنَّبُ مِن النَّارِ مَن يَخافُها، ",["وإنَّما يَرحَمُ اللهُ عَزَّ وجَلَّ",2]," ",["مَن يَرحَمُ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الخوف من الله","dorar":"q9Fj4rWe"},{"id":"س-07183","fp":"35e8649a557c","stateId":256,"easy":"إذا رحمت الشاة (عند ذبحها) ← يرحمك الله","cause":"والشاةَ إنْ رَحِمْتَها","result":"رَحِمَك اللهُ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 15592","srcLabel":"أحمد","text":["أنَّ رجُلًا قال: يا رسولَ اللهِ، إنِّي لَأَذبَحُ الشاةَ وأنا أَرحَمُها، أو قال: إنِّي لَأَرحَمُ الشاةَ أنْ أَذبَحَها، فقال: ",["والشاةَ إنْ رَحِمْتَها",1]," ",["رَحِمَك اللهُ",2],"، والشاةَ إنْ رَحِمْتَها رَحِمَك اللهُ."],"grade":"صحيح","narrator":"قرة بن إياس المزني","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15592) واللفظ له، وابن أبي شيبة (25870)، والطبراني (19/23) (46)","bab":"علم › حسن السؤال ونصح العالم","dorar":"IbZMul1D","merged":6,"otherRefs":["السلسلة الصحيحة 1/65 (صحيح)","صحيح الجامع 7055 (صحيح)","صحيح الأدب المفرد 287 (صحيح)","صحيح الترغيب 2264 (صحيح)","إتحاف الخيرة المهرة 5/283 (صحيح)"]},{"id":"س-03837","fp":"fad8ffc8385d","stateId":256,"easy":"إذا رحمت أهل الأرض ← يرحمك من في السماء","cause":"ارحَمُوا أهلَ الأرْضِ","result":"يَرحَمْكم أهْلُ السَّماءِ","explicit":true,"ref":"المستدرك على الصحيحين 7480","srcLabel":"أبو داود","text":["يَرفَعُه إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قالَ: الرَّاحِمون يرْحَمُهم اللهُ، ",["ارحَمُوا أهلَ الأرْضِ",1]," ",["يَرحَمْكم أهْلُ السَّماءِ",2],"، الرَّحِمُ شِجْنةٌ مِنَ الرَّحمنِ، فمَن وصَلَها وصَلَه، ومَن قَطَعَها قَطَعَه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه ابن وهب في ((الجامع)) -الآداب (146) بلفظه، وأبو داود (4941)، والترمذي (1924) باختلاف يسير.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"bWXXHOjA","merged":4,"otherRefs":["تخريج المسند لشعيب 6494 (صحيح)","صحيح الجامع 896 (صحيح)","صحيح الترمذي 1924 (صحيح)"]},{"id":"س-03836","fp":"c92f068547ac","stateId":256,"easy":"إذا رحمت ← يرحمك الله","cause":"الرَّاحِمون","result":"يرْحَمُهم اللهُ","explicit":true,"repOf":"س-00116","ref":"المستدرك على الصحيحين 7480","text":["يَرفَعُه إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ قالَ: ",["الرَّاحِمون",1]," ",["يرْحَمُهم اللهُ",2],"، ارحَمُوا أهلَ الأرْضِ يَرحَمْكم أهْلُ السَّماءِ، الرَّحِمُ شِجْنةٌ مِنَ الرَّحمنِ، فمَن وصَلَها وصَلَه، ومَن قَطَعَها قَطَعَه."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه ابن وهب في ((الجامع)) -الآداب (146) بلفظه، وأبو داود (4941)، والترمذي (1924) باختلاف يسير.","bab":"بر وصلة › صلة الرحم وتحريم قطعها","dorar":"bWXXHOjA","merged":3,"otherRefs":["تخريج المسند لشعيب 6494 (صحيح)","صحيح الترمذي 1924 (صحيح)"]},{"id":"س-03276","fp":"0340add5f384","stateId":256,"easy":"إذا رحمت ← تُرحم، وإذا غفرت يُغفر لك","cause":"ارحَموا","result":"تُرحَموا ، واغفِروا يُغفَرْ لَكُم ، ويلٌ لأقماعِ القَولِ ، ويلٌ للمُصرِّينَ","explicit":true,"otherNeedIds":[11],"ref":"عمدة التفسير 1/418","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ أنَّهُ قال وَهوَ علَى المنبرِ : ",["ارحَموا ",1],["تُرحَموا ، واغفِروا يُغفَرْ لَكُم ، ويلٌ لأقماعِ القَولِ ، ويلٌ للمُصرِّينَ",2]," الَّذينَ يُصِرُّونَ علَى ما فعلوا وَهُم يعلمونَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"أسانيده صحاح","takhrij":"أخرجه أحمد (6541)، وعبد بن حميد (320)، والطبراني (13/ 651) (14579) واللفظ لهم.","bab":"استغفار › أسباب المغفرة","dorar":"MbbhizXw","merged":2,"otherRefs":["السلسلة الصحيحة 482 (صحيح)"]},{"id":"س-02828","fp":"cdddce5ca9ce","stateId":256,"easy":"إذا رحمت ولو ذبيحة عصفور ← يرحمك الله يوم القيامة","cause":"مَن رَحِمَ ولو ذَبِيحةَ عُصْفُورٍ","result":"رَحِمَهُ اللهُ يومَ القِيامةِ","explicit":true,"ref":"الجامع الصغير 8678","srcLabel":"الطبراني","text":[["مَن رَحِمَ ولو ذَبِيحةَ عُصْفُورٍ، ",1],["رَحِمَهُ اللهُ يومَ القِيامةِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (8/ 234) (7915)، وابن عدي في ((الكامل في الضعفاء)) (8/ 362)، والبيهقي في ((شعب الإيمان)) (11070) واللفظ لهم.","bab":"إيمان › الوعد","dorar":"3Ek0nhQ8"},{"id":"س-07555","fp":"d412513ba477","stateId":256,"easy":"إذا رحمت الضعيف ← يرحمك الله","cause":"فقام وجلَسَتْ","result":"فرحمتَها رحِمَكَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 8/197","srcLabel":"الطبراني","text":["أنَّ امرأةً جاءتْ إلى النبيِّ صلَّى اللهُ عليه وسلَّم وعندَهُ أصحابُهُ فأطافَتْ بهم فلم تجدْ مكانًا ففِطِنَ لها رجلٌ ",["فقام وجلَسَتْ",1]," فقضتْ حاجتَها ثم قامَتْ فقال النبيُّ صلَّى اللهُ عليه وسلَّم للرجلِ أتعرفُها قال لا قال ",["فرحمتَها رحِمَكَ اللهُ",2]],"grade":"حسن","narrator":"سهل بن سعد الساعدي","muhaddith":"فيه عبد الحميد بن سليمان وبقية رجاله ثقات","takhrij":"أخرجه عبد بن حميد (450)، والطبراني في ((المعجم الكبير)) (6/ 161) (5854) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"pDDrhPfq"},{"id":"س-07981","fp":"1414cf367f90","stateId":257,"easy":"إذا كانت لأخيك عندك مظلمة فاستحللته قبل يوم الحساب ← يرحمك الله","cause":"كانت لأخيهِ عندَهُ مَظلِمَةٌ في عِرضٍ أو مالٍ، فجاءَهُ فاسْتَحَلَّهُ قبل أنْ يُؤخَذَ، وليسَ ثَمَّ دينارٌ ولا دِرْهَمٌ، فإنْ كانت لَه حَسَناتٌ، أُخِذَ مِن حَسَناتِهِ، وإنْ لم تَكُن لَه حَسَناتٌ حَمَّلُوهُ عليه مِن سَيِّئاتِهِم","result":"رَحِمَ اللهُ عبدًا","explicit":true,"star":true,"ref":"سنن الترمذي 2419","srcLabel":"البخاري","text":[["رَحِمَ اللهُ عبدًا",2],[" كانت لأخيهِ عندَهُ مَظلِمَةٌ في عِرضٍ أو مالٍ، فجاءَهُ فاسْتَحَلَّهُ قبل أنْ يُؤخَذَ، وليسَ ثَمَّ دينارٌ ولا دِرْهَمٌ، فإنْ كانت لَه حَسَناتٌ، أُخِذَ مِن حَسَناتِهِ، وإنْ لم تَكُن لَه حَسَناتٌ حَمَّلُوهُ عليه مِن سَيِّئاتِهِم",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه البخاري (2449) بنحوه","bab":"مظالم › التوبة ورد المظالم والحقوق","dorar":"VT5r6TEL","merged":4,"otherRefs":["حلية الأولياء 6/377 (صحيح)","صحيح الترغيب 2222 (صحيح)","صحيح ابن حبان 7362 (صحيح)"]},{"id":"س-05937","fp":"a6e7a5c72c1f","stateId":257,"easy":"إذا عرفت قدر نفسك ← يرحمك الله","cause":"عرَفَ قدْرَ نفْسِه","result":"رَحِمَ اللهُ امْرأً","explicit":true,"ref":"فتاوى نور على الدرب لابن عثيمين 2/569","srcLabel":"فتاوى نور على الدرب لابن عثيمين","text":[["رَحِمَ اللهُ امْرأً",2],[" عرَفَ قدْرَ نفْسِه",1],"."],"grade":"صحيح","muhaddith":"لا أعلم له أصلًا، لكن معناه صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"EpynduCf"},{"id":"س-01808","fp":"6d130b9b3893","stateId":257,"easy":"إذا أصلحت لسانك ← يرحمك الله","cause":"رجلًا أصلح من لسانِه","result":"رحِم اللهُ","explicit":true,"otherNeedIds":[18],"ref":"شعب الإيمان 2/727","srcLabel":"العقيلي","text":["أنَّه مرَّ على قومٍ يرْمون ، فقال : بئس ما رمَيْتم ، قالوا : إنَّا قومٌ متعلِّمون ، فقال : واللهِ لذنبُكم في لحنِكم أشدَّ عليَّ من ذنبِكم في رميِكم ، ورفع الحديثَ : ",["رحِم اللهُ",2]," ",["رجلًا أصلح من لسانِه",1]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"إسناده غير قوي","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (3/395) باختلاف يسير، وابن عدي في ((الكامل في الضعفاء)) (6/441)، وأبو علي الفارسي في ((الحجة للقراء السبعة)) (1/343) بلفظ مقارب","bab":"أيمان › لفظ اليمين وما يحلف به","dorar":"31J5nNee","merged":2,"otherRefs":["شرح كتاب الشهاب 104 (حسن)"]},{"id":"س-06987","fp":"1f91c814ccd9","stateId":257,"easy":"إذا تواضعت ← يرحمك الله","cause":"فإن تَواضَع","result":"رَحِمَه اللهُ","explicit":true,"otherNeedIds":[43],"ref":"مدح التواضع وذم الكبر 9","srcLabel":"مدح التواضع وذم الكبر","text":["\"ما مِن آدَميٍّ إلَّا في رَأسِه حِكمةٌ مُوَكَّلٌ بها مَلَكٌ، ",["فإن تَواضَع",1]," ",["رَحِمَه اللهُ",2]," وإنِ ارتَفعَ قَمَعه اللَّهُ، قال: والكِبرياءُ رِداءُ اللهِ، فمَن نازَعَ اللَّهَ قَمَعَه."],"grade":"حسن","narrator":"أنس","muhaddith":"حسن، غريب، تفرد به علي بن الحسن عن خليد بن دعلج.\nوقد روي عن أنس من وجه آخر","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"zQpOrXLy"},{"id":"س-07571","fp":"429ab1f9106a","stateId":257,"easy":"إذا عشت متواضعاً (كُفّنت في خلق ثيابك) ← رحمك الله","cause":"رَجُلًا غَسَّلَته امرَأتُه وكُفِّنَ في أخلاقِه","result":"رَحِمَ اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"ref":"فيض القدير 4/ 26","srcLabel":"البيهقي","text":[["رَحِمَ اللهُ",2]," ",["رَجُلًا غَسَّلَته امرَأتُه وكُفِّنَ في أخلاقِه",1]],"grade":"حسن","narrator":"عائشة","muhaddith":"رمز السيوطي لحسنه وليس بصواب","takhrij":"أخرجه البيهقي (6745) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"J2OwkA5G"},{"id":"س-07554","fp":"24e7c5e75841","stateId":257,"easy":"إذا وليت أمراً من أمر الأمة فرفقت بهم ← يرفق الله بك","cause":"ومَن وليَ مِن أمرِ أُمَّتي شيئًا فرَفَقَ بهِم","result":"فارفُقْ به","explicit":true,"star":true,"otherNeedIds":[54],"ref":"صحيح مسلم 1828","srcLabel":"متفق عليه","text":["أتَيتُ عائِشةَ أسألُها عن شَيءٍ، فقالت: مِمَّن أنتَ؟ فقُلتُ: رَجُلٌ مِن أهلِ مِصرَ، فقالت: كيفَ كان صاحِبُكُم لَكُم في غَزاتِكُم هذه؟ فقال: ما نَقَمنا منه شيئًا، إن كان لَيَموتُ للرَّجُلِ مِنَّا البَعيرُ فيُعطيه البَعيرَ، والعَبدُ فيُعطيه العَبدَ، ويَحتاجُ إلى النَّفَقةِ فيُعطيه النَّفَقةَ، فقالت: أما إنَّه لا يَمنَعُني الذي فعَلَ في مُحَمَّدِ بنِ أبي بَكرٍ أخي أن أُخبِرَكَ ما سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ في بَيتي هذا: اللَّهُمَّ مَن وليَ مِن أمرِ أُمَّتي شيئًا فشَقَّ عليهم فاشقُقْ عليه، ",["ومَن وليَ مِن أمرِ أُمَّتي شيئًا فرَفَقَ بهِم",1]," ",["فارفُقْ به",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"QcPWwUvF","merged":2,"otherRefs":["تخريج المسند لشعيب 24337 (صحيح)"]},{"id":"س-05653","fp":"5acf56e46acb","stateId":258,"easy":"إذا سمعت حديثاً فحفظته حتى تبلّغه ← ينضّر الله وجهك","cause":"سَمِعَ مِنَّا حَديثًا فحَفِظَه حتَّى يُبَلِّغَه غَيْرَه؛ فإنَّه رُبَّ حامِلِ فِقْهٍ ليس بفَقيهٍ، ورُبَّ حامِلِ فِقْهٍ إلى مَن هو أَفقَهُ مِنه، ثَلاثُ خِصالٍ لا يُغِلُّ عليهن قَلْبُ مُسلِمٍ أبَدًا: إخْلاصُ العَمَلِ للهِ، ومُناصَحةُ وُلاةِ الأمْرِ، ولُزومُ","result":"نَضَّرَ اللهُ امْرَأً","explicit":true,"star":true,"ref":"الصحيح المسند 351","srcLabel":"الصحيح المسند","text":["أنَّ زَيدَ بنَ ثابِتٍ خَرَجَ مِن عنْدِ مَرْوانَ نَحْوًا مِن نِصْفِ النَّهارِ، فقُلْنا: ما بَعَثَ إليه السَّاعةَ إلَّا لشيءٍ سَألَه عنه، فقُمْتُ إليه، فسَألْتُه، فقالَ: أجَلْ، سَألَنا عن أشْياءَ سَمِعْتُها مِن رَسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["نَضَّرَ اللهُ امْرَأً",2],[" سَمِعَ مِنَّا حَديثًا فحَفِظَه حتَّى يُبَلِّغَه غَيْرَه؛ فإنَّه رُبَّ حامِلِ فِقْهٍ ليس بفَقيهٍ، ورُبَّ حامِلِ فِقْهٍ إلى مَن هو أَفقَهُ مِنه، ثَلاثُ خِصالٍ لا يُغِلُّ عليهن قَلْبُ مُسلِمٍ أبَدًا: إخْلاصُ العَمَلِ للهِ، ومُناصَحةُ وُلاةِ الأمْرِ، ولُزومُ",1]," الجَماعةِ؛ فإنَّ دَعْوتُهم تُحيطُ مِن وَرائِهم»، وقالَ: «مَن كانَ هَمُّه الآخِرةَ جَمَعَ اللهُ شَمْلَه، وجَعَلَ غِناه في قَلْبِه، وأَتَتْه الدُّنْيا وهي راغِمةٌ، ومَن كانَت نِيَّتُه الدُّنْيا فَرَّقَ اللهُ عليه ضَيعتَه، وجَعَلَ فَقْرَه بَيْنَ عَيْنَيه، ولم يَأتِه مِن الدُّنْيا إلَّا ما كُتِبَ له»، وسَألْنا عن الصَّلاةِ الوُسْطى وهي الظُّهْرُ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"صحيح","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"WqH1UqRw","merged":12,"otherRefs":["تخريج صحيح ابن حبان 680 (صحيح)","تخريج المسند لشعيب 13350 (صحيح)","تخريج المسند لشعيب 16754 (صحيح)","الصحيح المسند 1161 (حسن)","هداية الرواة 224 (صحيح)","الأباطيل والمناكير 1/241 (صحيح)","صحيح الترغيب 91 (صحيح)","وجوب الأخذ بحديث الآحاد 12 (صحيح)","حلية الأولياء 7/386 (صحيح)","الفتح الرباني 6/2888 (صحيح)","تخريج سير أعلام النبلاء 17/ 670 (صحيح)"]},{"id":"س-07023","fp":"12974fd5463a","stateId":258,"easy":"إذا طلبت العلم ← تضع لك الملائكة أجنحتها رضاً","cause":"ابتغاءَ العلْمِ","result":"إنَّ الملائكةَ لَتَضَعُ أجْنِحَتَها لطالِبِ العلْمِ؛ رضًا بما يطلُبُ","explicit":true,"star":true,"otherNeedIds":[18],"ref":"سنن الترمذي 3535","srcLabel":"النسائي","text":["عن زِرِّ بنِ حُبَيشٍ، قال: أتَيْتُ صفْوانَ بنَ عسَّالٍ المُراديَّ أسأَلُه عنِ المسْحِ على الخُفَّينِ؟ فقال: ما جاء بك يا زِرُّ؟ فقلْتُ: ",["ابتغاءَ العلْمِ",1],"، فقال: ",["إنَّ الملائكةَ لَتَضَعُ أجْنِحَتَها لطالِبِ العلْمِ؛ رضًا بما يطلُبُ",2],"، فقلْتُ: إنَّه حكَّ في صَدْري المسْحُ على الخُفَّينِ بعد الغائطِ والبَولِ، وكنْتَ امرَأً مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجئْتُ أسأَلُك: هل سمِعْتَه يذكُرُ في ذلك شيئًا؟ قال: نعم، كان يأمُرُنا إذا كنَّا سَفْرًا -أو مُسافرينَ- ألَّا ننزِعَ خِفافَنا ثلاثةَ أيَّامٍ ولياليَهنَّ إلَّا مِن جَنابَةٍ، لكنْ مِن غائطٍ وبَولٍ ونومٍ. قال: فقلْتُ: هل سمِعْتَه يذكُرُ في الْهَوى شيئًا؟ قال: نعم، كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ في سَفَرٍ، فبَيْنا نحن عنده إذْ ناداهُ أعرابيٌّ بصوتٍ له جَهْوَرِيٍّ: يا محمَّدُ، فأجابه رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ نحوًا مِن صوتِه: هاؤُمُ. فقُلْنا له: اغضُضْ مِن صوتِك؛ فإنَّك عند النَّبيِّ صلَّى اللهُ عليه وسلَّمَ وقد نُهِيتَ عن هذا. فقال: واللهِ لا أغضُضُ، قال الأعرابيُّ: المرْءُ يُحِبُّ القومَ ولمَّا يلحَقْ بهم؟ قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: المرْءُ مع مَن أحَبَّ يومَ القيامةِ. فما زال يُحدِّثُنا حتَّى ذكَرَ بابًا مِن قِبَلِ المغرِبِ مَسيرةُ عَرْضِه، أو يسيرُ الرَّاكِبُ في عَرْضِه أربعينَ أو سبْعينَ عامًا- قال سفيانُ: قِبَلَ الشَّامِ- خلَقَه اللهُ يومَ خلَقَ السَّمواتِ والأرضَ مفتوحًا -يعني: للتَّوبةِ- لا يُغْلَقُ حتَّى تطْلُعَ الشَّمسُ منه."],"grade":"صحيح","narrator":"صفوان بن عسال","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (127) مختصراً باختلاف يسير، وابن ماجه (478،226) مفرقاً مختصراً باختلاف يسير، وأحمد (18095) باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"t4oA545f","merged":4,"otherRefs":["تخريج المسند لشعيب 18089 (حسن)","صحيح ابن حبان 1319 (صحيح)","الأربعون البلدانية 149 (حسن)"]},{"id":"س-08175","fp":"537f96a772a0","stateId":258,"easy":"إذا علّمت الناس الخير ← يصلي عليك الله وملائكته وأهل السماوات والأرض","cause":"مُعلِّمِ النَّاسِ الخيرَ","result":"إنَّ اللَّهَ وملائكتَهُ وأهلَ السَّماواتِ والأرضِ حتَّى النَّملةَ في جُحرِها ، وحتَّى الحوتَ ليصلُّونَ علَى","explicit":true,"similar":["س-07083"],"otherNeedIds":[18],"ref":"الترغيب والترهيب 1/80","srcLabel":"الترمذي","text":["ذُكرَ لرسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ رجلانِ أحدُهُما عابدٌ والآخرُ عالمٌ ، فقالَ عليهِ أفضلُ الصلاةِ والسَّلامِ : فضلُ العالمِ علَى العابدِ كفضلي علَى أدناكُم ثمَّ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إنَّ اللَّهَ وملائكتَهُ وأهلَ السَّماواتِ والأرضِ حتَّى النَّملةَ في جُحرِها ، وحتَّى الحوتَ ليصلُّونَ علَى",2]," ",["مُعلِّمِ النَّاسِ الخيرَ",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2685)، وتمام في ((فوائده)) (1243) باختلاف يسير، والطبراني (8/278) (7911) مختصراً.","bab":"ملائكة › أعمال الملائكة","dorar":"E9oPRle0","merged":4,"otherRefs":["صحيح الترغيب 81 (حسن)","تخريج سير أعلام النبلاء 18/ 162 (حسن)","صحيح الجامع 1838 (صحيح)"]},{"id":"س-07040","fp":"da09910a78bd","stateId":258,"easy":"إذا طلبت العلم ← يستغفر لك كل شيء حتى الحيتان في البحر","cause":"وإِنَّ طالبَ العلمِ","result":"يستغفِرُ له كلُّ شيءٍ ، حتى الحيتانِ في البحرِ","explicit":true,"otherNeedIds":[18],"ref":"صحيح الجامع 3914","srcLabel":"ابن ماجه","text":["طلبُ العلمِ فريضةٌ على كلِّ مسلمٍ ، ",["وإِنَّ طالبَ العلمِ",1]," ",["يستغفِرُ له كلُّ شيءٍ ، حتى الحيتانِ في البحرِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (224) أوله في أثناء حديث، والبزار (6746) مختصراً، وابن عبدالبر في ((جامع بيان العلم وفضله)) (17) واللفظ له","bab":"علم › الحث على طلب العلم","dorar":"rzfegNbV","merged":3,"otherRefs":["العلم لأبي خيثمة 6 (صحيح)","صحيح ابن ماجه 197 (صحيح)"]},{"id":"س-05636","fp":"7c0681b8ddd7","stateId":258,"easy":"إذا سمعت حديث النبي ﷺ فبلّغته ← يرحمك الله","cause":"مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه","result":"رَحِمَ اللهُ","explicit":true,"ref":"الترغيب والترهيب 4/162","srcLabel":"أبو داود","text":[["رَحِمَ اللهُ",2]," ",["مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه",1],": ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ: إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، واللُّزومُ لِجَماعَتِهم، فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم، إنَّه مَن تَكُنِ الدُّنيا نِيَّتَه يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له، ومَن تَكُنِ الآخِرةُ نِيَّتَه يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3660) باختلاف يسير دون قوله: \"ثلاث لا يغل ...\"، وابن ماجه (230، 4105) مفرقاً باختلاف يسير، وأحمد (21590) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"jihas9WH"},{"id":"س-07083","fp":"528532392590","stateId":258,"easy":"إذا علّمت الناس الخير ← يصلي عليك الخلق كلهم حتى الحيتان","cause":"مُعلَّمِ الخَيرِ","result":"الخَلقُ كُلُّهمْ يُصَلُّونَ على مُعلَّمِ الخَيرِ ؛ حتى حِيتَانِ البحْرِ","explicit":true,"repOf":"س-08175","otherNeedIds":[18],"ref":"صحيح الجامع 3343","text":[["الخَلقُ كُلُّهمْ يُصَلُّونَ على مُعلَّمِ الخَيرِ ؛ حتى حِيتَانِ البحْرِ",2]],"grade":"صحيح","narrator":"أبو أمامة وعائشة","muhaddith":"صحيح","bab":"علم › تعليم الناس وفضل ذلك","dorar":"D77JMUIM"},{"id":"س-07095","fp":"715696e24967","stateId":258,"easy":"إذا تعلمت فريضة أو فريضتين وعملت بهما أو علّمتهما ← يرحمك الله","cause":"تعلَّم فريضةً أو فريضتَينِ وعمِل بهما أو علَّمَهما من يعملُ بِهِما","result":"رحِم اللَّهُ رجلًا","explicit":true,"ref":"تسديد القوس 2/385","srcLabel":"الديلمي","text":[["رحِم اللَّهُ رجلًا",2],[" تعلَّم فريضةً أو فريضتَينِ وعمِل بهما أو علَّمَهما من يعملُ بِهِما",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الديلمي كما في ((زهر الفردوس)) لابن حجر (1613) بلفظه.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"z84KZCTv"},{"id":"ق-0796","fp":"ebbaf8077ae8","stateId":259,"easy":"الصبر والصلاح ← دخول رحمة الله","cause":"الصبر والصلاح","result":"دخول رحمة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"ref":"سورة الأنبياء: 85–86","srcLabel":"القرآن الكريم","quran":{"s":21,"from":85,"to":86,"text":"وَإِسْمَاعِيلَ وَإِدْرِيسَ وَذَا الْكِفْلِ كُلٌّ مِنَ الصَّابِرِينَ (85) وَأَدْخَلْنَاهُمْ فِي رَحْمَتِنَا إِنَّهُمْ مِنَ الصَّالِحِينَ (86)","hl":[[0,135,1]]}},{"id":"ق-0430","fp":"6c4de34603f0","stateId":259,"easy":"التقوى وإيتاء الزكاة والإيمان بآيات الله ← كتابة الرحمة","cause":"التقوى وإيتاء الزكاة والإيمان بآيات الله","result":"كتابة الرحمة","explicit":true,"star":true,"ref":"سورة الأعراف: 156","srcLabel":"القرآن الكريم","quran":{"s":7,"from":156,"to":156,"text":"وَاكْتُبْ لَنَا فِي هَذِهِ الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ إِنَّا هُدْنَا إِلَيْكَ قَالَ عَذَابِي أُصِيبُ بِهِ مَنْ أَشَاءُ وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ الزَّكَاةَ وَالَّذِينَ هُمْ بِآيَاتِنَا يُؤْمِنُونَ (156)","hl":[[129,264,1]]}},{"id":"ق-1038","fp":"e3d5bd61ee68","stateId":259,"easy":"اتقاء ما بين الأيدي وما خلف (التقوى) ← رحمة الله","cause":"اتقاء ما بين الأيدي وما خلف (التقوى)","result":"رحمة الله","explicit":true,"star":true,"ref":"سورة يس: 45","srcLabel":"القرآن الكريم","quran":{"s":36,"from":45,"to":45,"text":"وَإِذَا قِيلَ لَهُمُ اتَّقُوا مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ (45)","hl":[[0,93,1]]}},{"id":"ق-1307","fp":"a6579cf98e45","stateId":259,"easy":"التقوى والإيمان بالرسول ﷺ ← كِفلان من رحمة الله ونور يمشي به ومغفرة","cause":"التقوى والإيمان بالرسول ﷺ","result":"كِفلان من رحمة الله ونور يمشي به ومغفرة","explicit":true,"otherNeedIds":[15,11],"ref":"سورة الحديد: 28","srcLabel":"القرآن الكريم","quran":{"s":57,"from":28,"to":28,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ وَاللَّهُ غَفُورٌ رَحِيمٌ (28)","hl":[[0,191,1]]}},{"id":"س-08239","fp":"628f93b47281","stateId":259,"easy":"إذا التمست مرضاة الله ودمت على ذلك ← يقول الله لجبريل: رحمتي عليه، فتنزل عليك الرحمة","cause":"إنَّ العبدَ لَيَلْتَمِسُ مرضاةَ اللهِ تعالى فلا يزالُ بذلك","result":"فيقولُ اللهُ عَزَّ وجَلَّ لجبريلَ إنَّ فلانًا عبدي يلتمِسُ أن يُرْضيَني ألَا وإنَّ رحمتي عليه","explicit":true,"ref":"مجمع الزوائد 10/205","srcLabel":"مجمع الزوائد","text":[["إنَّ العبدَ لَيَلْتَمِسُ مرضاةَ اللهِ تعالى فلا يزالُ بذلك ",1],["فيقولُ اللهُ عَزَّ وجَلَّ لجبريلَ إنَّ فلانًا عبدي يلتمِسُ أن يُرْضيَني ألَا وإنَّ رحمتي عليه",2]," فيقولُ جبريلُ رحمةُ اللهِ على فلانٍ ويقولُها حَمَلةُ العرشِ ويقولُها مَن حولَهم حتَّى يقولُها أهلُ السَّماواتِ السَّبعِ ثمَّ يهبِطُ إلى الأرضِ"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"رجاله رجال الصحيح غير ميمون بن عجلان وهو ثقة","bab":"ملائكة › فضل جبريل","dorar":"Sbkyw5JV"},{"id":"س-06960","fp":"a573a6e62fee","stateId":259,"easy":"إذا استحييت من الله ← يستحيي الله منك","cause":"وأمَّا الآخَرُ فاستَحيا","result":"فاستَحيا اللهُ منه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 2176","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم بينَما هو جالِسٌ في المَسجِدِ والنَّاسُ معهُ، إذ أقبَلَ نَفَرٌ ثَلاثةٌ، فأقبَلَ اثنانِ إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وذَهَبَ واحِدٌ، قال: فوقَفا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأمَّا أحَدُهما فرَأى فُرجةً في الحَلقةِ فجَلَسَ فيها، وأمَّا الآخَرُ فجَلَسَ خَلفَهُم، وأمَّا الثَّالِثُ فأدبَرَ ذاهِبًا، فلَمَّا فرَغَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قال: ألا أُخبِرُكُم عَنِ النَّفَرِ الثَّلاثةِ؟ أمَّا أحَدُهم فأوى إلى اللهِ، فآواه اللهُ، ",["وأمَّا الآخَرُ فاستَحيا",1],"، ",["فاستَحيا اللهُ منه",2],"، وأمَّا الآخَرُ فأعرَضَ، فأعرَضَ اللهُ عنه."],"grade":"صحيح","narrator":"أبو واقد الليثي","muhaddith":"[صحيح]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"KoGQui4z","merged":3,"otherRefs":["المستدرك على الصحيحين 7862 (صحيح)","تفسير القرآن العظيم 8/73 (صحيح)"]},{"id":"س-08143","fp":"65ee87d2428b","stateId":259,"easy":"إذا التمست رضا الله ← يحبك ويرضى عنك أهل السماء (وعكسه بالسخط)","cause":"وإنَّ العبدَ ليلتمِسُ سخطَ اللهِ","result":"فيقولُ اللهُ عزَّ وجلَّ يا جبريلُ إنَّ فلانًا يستَسخَطُني ألا وإنَّ غضبي عليه فيقولُ جبريلُ غضبُ اللهِ على فلانٍ وتقولُ حملةُ العرشِ ويقولُ مَن دونَهم","explicit":true,"ref":"مجمع الزوائد 10/275","srcLabel":"مجمع الزوائد","text":["إنَّ العبدَ ليلتَمِسُ مرضاةَ اللهِ عزَّ وجلَّ فلا يزالُ كذلك فيقولُ يا جبريلُ إنَّ عبدي فلانًا يلتَمِسُ أن يُرضِيَني برضائي عليه قال فيقولُ جبريلُ صلَّى اللَّهُ عليه وسلَّم رحمةُ اللهِ على فلانٍ وتقولُ حَمَلةُ العرشِ ويقولُ الَّذين يَلُونَهم حتَّى يقولَ أهلُ السَّماواتِ السَّبعِ ثُمَّ يهبِطُ إلى الأرضِ ثُمَّ قال رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم وهي الآيةُ الَّتي أنزَل اللهُ عليكم في كتابِه {إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَيَجْعَلُ لَهُمُ الرَّحْمَنُ وُدًّا} ",["وإنَّ العبدَ ليلتمِسُ سخطَ اللهِ",1]," ",["فيقولُ اللهُ عزَّ وجلَّ يا جبريلُ إنَّ فلانًا يستَسخَطُني ألا وإنَّ غضبي عليه فيقولُ جبريلُ غضبُ اللهِ على فلانٍ وتقولُ حملةُ العرشِ ويقولُ مَن دونَهم",2]," حتَّى يقولَه أهلُ السَّماواتِ السَّبعِ ثُمَّ يهبِطُ إلى الأرضِ"],"grade":"حسن","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"رجاله ثقات","bab":"ملائكة › أعمال الملائكة","dorar":"PB9451fs"},{"id":"س-07427","fp":"bd68580968fb","stateId":259,"easy":"إذا أحببت لقاء الله رجاء عفوه ← يوجب لك عفوه ومغفرته","cause":"هل أحببتُم لقائي فيقولونَ نعم يا ربَّنا فيقولُ لِمَ فيقولونَ رجَونا عفوَكَ ومغفرتَكَ","result":"قد أوجبتُ لكم عفوي ومغفرتي","explicit":true,"star":true,"otherNeedIds":[11],"ref":"الجامع الصغير 2650","srcLabel":"أحمد","text":["إنْ شئتُم أنبأتُكم ما أوَّلُ ما يقولُ اللَّهُ تعالى للمؤمنينَ يومَ القيامةِ وما أوَّلُ ما يقولونَ لهُ فإنَّ اللَّهَ تعالى يقولُ للمؤمنينَ ",["هل أحببتُم لقائي فيقولونَ نعم يا ربَّنا فيقولُ لِمَ فيقولونَ رجَونا عفوَكَ ومغفرتَكَ",1]," فيقولُ ",["قد أوجبتُ لكم عفوي ومغفرتي",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22072)، والطيالسي (565)، والطبراني في ((الأوائل)) (66) واللفظ لهم.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"Q7Ssa7Yt","merged":2,"otherRefs":["مجمع الزوائد 10/361 (حسن)"]},{"id":"س-05095","fp":"40e57505ee08","stateId":260,"easy":"إذا سلّمت على أحد فلم يرد ← ترد عليك الملائكة","cause":"فإنْ سلَّمَ عليه فلم يَرُدَّ عليهِ، ورَدَّ عليه سَلامَهُ","result":"رَدَّتْ عليه المَلائكةُ، ورَدَّ على الآخَرِ الشَّيطانُ","explicit":true,"star":true,"otherNeedIds":[34],"ref":"تخريج المسند لشعيب 16257","srcLabel":"مسلم","text":["لا يَحِلُّ لِمُسلِمٍ أنْ يَهجُرَ مُسلِمًا فَوقَ ثَلاثِ ليالٍ، فإنْ كان تَصارَما فَوقَ ثَلاثٍ؛ فإنَّهما ناكِبانِ عن الحَقِّ ما داما على صُرامِهما، وأوَّلُهما فَيئًا فسَبْقُهُ بالفَيءِ كفَّارَتُهُ، ",["فإنْ سلَّمَ عليه فلم يَرُدَّ عليهِ، ورَدَّ عليه سَلامَهُ",1],"؛ ",["رَدَّتْ عليه المَلائكةُ، ورَدَّ على الآخَرِ الشَّيطانُ",2],"، فإنْ ماتا على صُرامِهما لم يَجتَمِعا في الجنَّةِ أبَدًا."],"grade":"صحيح","narrator":"هشام بن عامر","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16257) واللفظ له، والطيالسي (1319)، وأبو يعلى (1557)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lxjagY10","merged":3,"otherRefs":["الزواجر عن اقتراف الكبائر 2/42 (صحيح)","تخريج صحيح ابن حبان 5664 (صحيح)"]},{"id":"س-00177","fp":"d71bfb5bf265","stateId":260,"easy":"إذا عطس أخوك فحمد الله ← فحق عليك أن تقول «يرحمك الله»","cause":"فإذا عطَس أحدُكم فقال : الحمدُ للهِ","result":"فحقٌّ على مَن سمِعه أنْ يقولَ : يرحَمُك اللهُ","explicit":true,"star":true,"similar":["س-00178","س-00175"],"ref":"تخريج صحيح ابن حبان 598","srcLabel":"متفق عليه","text":["إنَّ اللهَ يُحِبُّ العُطاسَ ويكرَهُ التَّثاؤبَ فإذا تثاءَب أحدُكم فلْيرُدَّ ما استطاع ولا يقُلْ : هاو فإنَّه إذا قال : هاو ضحِك منه الشَّيطانُ ",["فإذا عطَس أحدُكم فقال : الحمدُ للهِ",1]," ",["فحقٌّ على مَن سمِعه أنْ يقولَ : يرحَمُك اللهُ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (598) واللفظ له، والبخاري (6226) بنحوه، ومسلم (2994) مختصرا بنحوه.","bab":"آداب العطاس › العطاس","dorar":"u4dfH2f0"},{"id":"س-00178","fp":"092a616e4533","stateId":260,"easy":"إذا عطست فحمدت الله ← يُقال لك «يرحمك الله»","cause":"فعطَس رجُلٌ، فحمِد اللهَ","result":"فقال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: يرحَمُكَ اللهُ","explicit":true,"repOf":"س-00177","ref":"تخريج مشكل الآثار 528","text":["كُنَّا جُلوسًا عندَ رسولِ اللهِ عليه السَّلامُ ",["فعطَس رجُلٌ، فحمِد اللهَ",1],"، ",["فقال نبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: يرحَمُكَ اللهُ",2],"، ثمَّ عطَس آخَرُ، فسكَتَ، فلمْ يَقُلْ له شيئًا، فقال: يا رسولَ اللهِ، عطَس هذا، فقُلْتَ له: يرحَمُكَ اللهُ، وعطَسْتُ أنا فلمْ تَقُلْ لي شيئًا، فقال: إنَّ هذا حمِد اللهَ، وإنَّكَ سكَتَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم، رجاله ثقات رجال الشيخين غير يزيد بن كيسان، فمن رجال مسلم","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (528) واللفظ له، والبخاري في ((الأدب المفرد)) (930)، وابن أبي شيبة في ((الأدب)) (318) كلاهما باختلاف يسير.","bab":"آداب العطاس › العطاس","dorar":"dXvUYanG"},{"id":"س-08227","fp":"f43fe327f4b7","stateId":260,"easy":"إذا عطست فقلت «الحمد لله» ← تقول الملائكة: رب العالمين","cause":"إذا عَطَسَ أحَدُكم فقالَ: الحَمْدُ للهِ","result":"قالَتِ المَلائِكةُ: رَبِّ العالَمينَ","explicit":true,"apply":{"k":"say","t":"«الحمد لله»"},"ref":"الأحاديث المختارة 10 / 289","srcLabel":"متفق عليه","text":["«",["إذا عَطَسَ أحَدُكم فقالَ: الحَمْدُ للهِ",1],"، ",["قالَتِ المَلائِكةُ: رَبِّ العالَمينَ",2],"، فإذا قالَ: رَبِّ العالَمينَ، قالَتِ المَلائِكةُ: رَحِمَك اللهُ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"snFF3pZv"},{"id":"س-08228","fp":"32c0e8d8803b","stateId":260,"easy":"إذا قلت «رب العالمين» ← تقول الملائكة: يرحمك الله","cause":"فإذا قالَ: رَبِّ العالَمينَ","result":"قالَتِ المَلائِكةُ: رَحِمَك اللهُ","explicit":true,"apply":{"k":"say","t":"«رب العالمين»"},"ref":"الأحاديث المختارة 10 / 289","srcLabel":"متفق عليه","text":["«إذا عَطَسَ أحَدُكم فقالَ: الحَمْدُ للهِ، قالَتِ المَلائِكةُ: رَبِّ العالَمينَ، ",["فإذا قالَ: رَبِّ العالَمينَ",1],"، ",["قالَتِ المَلائِكةُ: رَحِمَك اللهُ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"ملائكة › أعمال الملائكة","dorar":"snFF3pZv"},{"id":"س-07179","fp":"9cf6d3e641ed","stateId":260,"easy":"إذا عطست فحمدت الله ← تستحق التشميت","cause":"إنَّ هذا حَمِدَ اللهَ","result":"فشَمَّتَ أحدَهما","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[29],"ref":"تخريج المسند لشعيب 12798","srcLabel":"متفق عليه","text":["عَطَسَ رَجُلانِ عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ",["فشَمَّتَ أحدَهما",2]," -أو قال: فسَمَّتَ أحدَهما- وتَرَكَ الآخَرَ. فقيلَ: هُما رَجُلانِ عَطَسا، فشَمَّتَ -أو قال: فسَمَّتَ أحدَهما- وتَرَكتَ الآخَرَ، فقال: ",["إنَّ هذا حَمِدَ اللهَ",1],"، وإنَّ هذا لم يَحمَدِ اللهَ. قال سُليمانُ: أُراه نَحْوًا مِن هذا."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6221)، ومسلم (2991)، وأبو داود (5039)، والترمذي (2742)، والنسائي في ((السنن الكبرى)) (10050)، وابن ماجه (3713)، وأحمد (12798) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"AddQEBL0","merged":4,"otherRefs":["صحيح الترمذي 2742 (صحيح)","حلية الأولياء 8/183 (صحيح)","تخريج المسند لشعيب 12167 (صحيح)"]},{"id":"س-00183","fp":"147a0e0f65a6","stateId":260,"easy":"إذا عطست فقلت «الحمد لله» ← يرحمك الله","cause":"عَطِس، فقال: الحَمدُ للهِ","result":"فقال اللهُ عَزَّ وجَلَّ: يرحمُك اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«الحمد لله»"},"similar":["س-08137"],"ref":"الأحاديث المختارة 1667","srcLabel":"البخاري","text":["«لَمَّا نُفِخ في آدَمَ الرُّوحُ مارت وأطارت فصار في رأسِه -أو ارتفَعَ إلى رأسهِ- ",["عَطِس، فقال: الحَمدُ للهِ",1],"، ",["فقال اللهُ عَزَّ وجَلَّ: يرحمُك اللهُ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"آداب العطاس › العطاس","dorar":"utw1elKT"},{"id":"س-00175","fp":"8cbdd8a9aa68","stateId":260,"easy":"إذا عطست فحمدت الله ← يرحمك الله","cause":"أنْ قال : الحمدُ للهِ","result":"فقال له ربُّه : يرحَمُك اللهُ فلذلك سبَقَتْ رحمتُه غضَبَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-00177","ref":"صحيح ابن حبان 6164","text":["لمَّا خلَق اللهُ آدَمَ عطَس فألهَمه ربُّه ",["أنْ قال : الحمدُ للهِ",1]," ",["فقال له ربُّه : يرحَمُك اللهُ فلذلك سبَقَتْ رحمتُه غضَبَه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي في ((الشعب)) (8880) باختلاف يسير، والحاكم (7681)، وابن أبي عاصم في ((السنة)) (596) مختصرًا.","bab":"آداب العطاس › العطاس","dorar":"CrC5kvyT"},{"id":"س-07197","fp":"b887cb48ef55","stateId":260,"easy":"إذا ذكرت الله عند العطاس ← يذكرك الله","cause":"ثمَّ عطَسَ الآخرُ فحمِدَ اللهَ","result":"وإنَّ هذا ذَكَر اللهَ فذَكَرْتُه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[26],"ref":"المستدرك على الصحيحين 7898","srcLabel":"أحمد","text":["جَلَسَ عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ رَجُلانِ، أحَدُهُما أشْرَفُ مِن الآخَرِ، فعَطَسَ الشَّريفُ، فلَمْ يحْمَدِ اللهَ، فلَمْ يُشَمِّتْه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، ",["ثمَّ عطَسَ الآخرُ فحمِدَ اللهَ",1],"، فشَمَّتَه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقالَ الشَّريفُ: عطَسْتُ فلَمْ تُشَمِّتْني، وعطَسَ هذا فشَمَّتَّه، قالَ: إنَّكَ نَسِيتَ اللهَ فنَسِيتُكَ، ",["وإنَّ هذا ذَكَر اللهَ فذَكَرْتُه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (8346)، وابن حبان (7689)بنحوه، والطبراني في ((المعجم الأوسط ))(7580) مختصرا","bab":"علم › حسن السؤال ونصح العالم","dorar":"OBzRCApW"},{"id":"س-08137","fp":"840a2d8adf7e","stateId":260,"easy":"إذا عطست فقلت «الحمد لله رب العالمين» ← يقول الملك: يرحمك الله","cause":"فإن قالَ ربِّ العالمينَ","result":"قالَ الملَكُ يرحمُكَ اللَّهُ","explicit":true,"apply":{"k":"say","t":"«الحمد لله رب العالمين»"},"repOf":"س-00183","ref":"فتح الباري لابن حجر 10/615","text":["عن ابن عبَّاسٍ قالَ إذا عطسَ الرَّجلُ فقالَ الحمدُ للَّهِ قالَ الملَكُ ربِّ العالمينَ ",["فإن قالَ ربِّ العالمينَ",1]," ",["قالَ الملَكُ يرحمُكَ اللَّهُ",2]],"grade":"حسن","muhaddith":"إسناده لا بأس به","bab":"ملائكة › أعمال الملائكة","dorar":"1gjgn35K"},{"id":"س-08237","fp":"8336bf7c216f","stateId":260,"easy":"إذا ائتدمت بالخل ← يستغفر لك ملكان حتى تفرغ","cause":"مَن تَأدَّمَ بالخَلِّ","result":"وكَّلَ اللهُ له مَلَكَينِ يَستَغفِرانِ اللهَ له حتَّى يَفرُغَ","explicit":true,"ref":"فيض القدير 6/ 286","srcLabel":"فيض القدير","text":[["مَن تَأدَّمَ بالخَلِّ ",1],["وكَّلَ اللهُ له مَلَكَينِ يَستَغفِرانِ اللهَ له حتَّى يَفرُغَ",2]],"grade":"حسن","narrator":"أنس","muhaddith":"رواته ثقات غير الحسن بن علي الدمشقي","bab":"ملائكة › أعمال الملائكة","dorar":"u90OGfyQ"},{"id":"س-00184","fp":"e4c876e451b5","stateId":260,"easy":"إذا عطست فحمدت الله ← تستحق التشميت","cause":"إنَّ هذا حَمِدَ اللهَ","result":"شَمَّتَّ هذا","explicit":true,"star":true,"ref":"صحيح البخاري 6225","srcLabel":"متفق عليه","text":["عَطَسَ رَجُلانِ عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فشَمَّتَ أحَدَهما ولَم يُشَمِّتِ الآخَرَ، فقال الرَّجُلُ: يا رَسولَ اللهِ، ",["شَمَّتَّ هذا",2]," ولَم تُشَمِّتْني، قال: ",["إنَّ هذا حَمِدَ اللهَ",1],"، ولَم تَحمَدِ اللهَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6225)، ومسلم (2991)","bab":"آداب العطاس والتثاؤب › آداب العطاس","dorar":"DostUCbp"}]}