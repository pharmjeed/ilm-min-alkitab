{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":49,"stateIds":[487,488,489,490,491,492,493,494,495,496,497,498,499,500,501],"items":[{"id":"ق-0121","fp":"f44f85de0319","stateId":487,"easy":"التكذيب بآيات الله (دأب آل فرعون) ← أخذ الله لهم بذنوبهم","cause":"التكذيب بآيات الله (دأب آل فرعون)","result":"أخذ الله لهم بذنوبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0470"],"ref":"سورة آل عمران: 11","srcLabel":"القرآن الكريم","quran":{"s":3,"from":11,"to":11,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَذَّبُوا بِآيَاتِنَا فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَاللَّهُ شَدِيدُ الْعِقَابِ (11)","hl":[[0,137,1]]}},{"id":"ق-0165","fp":"f9e261e9679a","stateId":487,"easy":"التكذيب ← سوء العاقبة (سنن خلت)","cause":"التكذيب","result":"سوء العاقبة (سنن خلت)","explicit":true,"star":true,"similar":["ق-0347","ق-0562","ق-0671"],"ref":"سورة آل عمران: 137","srcLabel":"القرآن الكريم","quran":{"s":3,"from":137,"to":137,"text":"قَدْ خَلَتْ مِنْ قَبْلِكُمْ سُنَنٌ فَسِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ (137)","hl":[[0,109,1]]}},{"id":"ق-0346","fp":"80b4b043e724","stateId":487,"easy":"السخرية بالرسل ← يحيق بالساخرين ما كانوا به يستهزئون","cause":"السخرية بالرسل","result":"يحيق بالساخرين ما كانوا به يستهزئون","explicit":true,"star":true,"similar":["ق-0789"],"ref":"سورة الأنعام: 10","srcLabel":"القرآن الكريم","quran":{"s":6,"from":10,"to":10,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذِينَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (10)","hl":[[0,114,1]]}},{"id":"ق-0347","fp":"09524a936664","stateId":487,"easy":"التكذيب ← سوء العاقبة","cause":"التكذيب","result":"سوء العاقبة","explicit":true,"repOf":"ق-0165","ref":"سورة الأنعام: 11","quran":{"s":6,"from":11,"to":11,"text":"قُلْ سِيرُوا فِي الْأَرْضِ ثُمَّ انْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ (11)","hl":[[0,81,1]]}},{"id":"ق-0408","fp":"b8e05b02f1a7","stateId":487,"easy":"التكذيب بالآيات ← الإغراق","cause":"التكذيب بالآيات","result":"الإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["ق-0794"],"ref":"سورة الأعراف: 64","srcLabel":"القرآن الكريم","quran":{"s":7,"from":64,"to":64,"text":"فَكَذَّبُوهُ فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ فِي الْفُلْكِ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمًا عَمِينَ (64)","hl":[[62,107,1]]}},{"id":"ق-0410","fp":"f80d72e43272","stateId":487,"easy":"التكذيب بالآيات (عاد) ← قطع الدابر، ونجاة المؤمنين برحمة الله","cause":"التكذيب بالآيات (عاد)","result":"قطع الدابر، ونجاة المؤمنين برحمة الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[4],"ref":"سورة الأعراف: 72","srcLabel":"القرآن الكريم","quran":{"s":7,"from":72,"to":72,"text":"فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ بِرَحْمَةٍ مِنَّا وَقَطَعْنَا دَابِرَ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَمَا كَانُوا مُؤْمِنِينَ (72)","hl":[[0,130,1]]}},{"id":"ق-0411","fp":"9d8ecada77f1","stateId":487,"easy":"العتوّ عن أمر الله وعقر الناقة (ثمود) ← الرجفة","cause":"العتوّ عن أمر الله وعقر الناقة (ثمود)","result":"الرجفة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأعراف: 77–78","srcLabel":"القرآن الكريم","quran":{"s":7,"from":77,"to":78,"text":"فَعَقَرُوا النَّاقَةَ وَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا يَا صَالِحُ ائْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الْمُرْسَلِينَ (77) فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (78)","hl":[[0,202,1]]}},{"id":"ق-0412","fp":"8f4371ade092","stateId":487,"easy":"الفاحشة والإجرام (قوم لوط) ← مطر السوء وسوء العاقبة","cause":"الفاحشة والإجرام (قوم لوط)","result":"مطر السوء وسوء العاقبة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأعراف: 84","srcLabel":"القرآن الكريم","quran":{"s":7,"from":84,"to":84,"text":"وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُجْرِمِينَ (84)","hl":[[0,80,1]]}},{"id":"ق-0414","fp":"291799ddf90b","stateId":487,"easy":"تكذيب شعيب ← الرجفة والخسران","cause":"تكذيب شعيب","result":"الرجفة والخسران","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0945"],"otherNeedIds":[50],"ref":"سورة الأعراف: 90–92","srcLabel":"القرآن الكريم","quran":{"s":7,"from":90,"to":92,"text":"وَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ لَئِنِ اتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَخَاسِرُونَ (90) فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (91) الَّذِينَ كَذَّبُوا شُعَيْبًا كَأَنْ لَمْ يَغْنَوْا فِيهَا الَّذِينَ كَذَّبُوا شُعَيْبًا كَانُوا هُمُ الْخَاسِرِينَ (92)","hl":[[0,300,1]]}},{"id":"ق-0417","fp":"d8eb7cc0e672","stateId":487,"easy":"التكذيب ← الأخذ بما كانوا يكسبون","cause":"التكذيب","result":"الأخذ بما كانوا يكسبون","explicit":true,"otherNeedIds":[3],"ref":"سورة الأعراف: 96","srcLabel":"القرآن الكريم","quran":{"s":7,"from":96,"to":96,"text":"وَلَوْ أَنَّ أَهْلَ الْقُرَى آمَنُوا وَاتَّقَوْا لَفَتَحْنَا عَلَيْهِمْ بَرَكَاتٍ مِنَ السَّمَاءِ وَالْأَرْضِ وَلَكِنْ كَذَّبُوا فَأَخَذْنَاهُمْ بِمَا كَانُوا يَكْسِبُونَ (96)","hl":[[110,170,1]]}},{"id":"ق-0421","fp":"0719a35f063e","stateId":487,"easy":"الظلم بآيات الله (فرعون وملؤه) ← عاقبة المفسدين","cause":"الظلم بآيات الله (فرعون وملؤه)","result":"عاقبة المفسدين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأعراف: 103","srcLabel":"القرآن الكريم","quran":{"s":7,"from":103,"to":103,"text":"ثُمَّ بَعَثْنَا مِنْ بَعْدِهِمْ مُوسَى بِآيَاتِنَا إِلَى فِرْعَوْنَ وَمَلَئِهِ فَظَلَمُوا بِهَا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ (103)","hl":[[79,143,1]]}},{"id":"ق-0424","fp":"2164617eab99","stateId":487,"easy":"نكث العهد والتكذيب بالآيات والغفلة عنها ← الانتقام والإغراق","cause":"نكث العهد والتكذيب بالآيات والغفلة عنها","result":"الانتقام والإغراق","explicit":true,"ref":"سورة الأعراف: 135–136","srcLabel":"القرآن الكريم","quran":{"s":7,"from":135,"to":136,"text":"فَلَمَّا كَشَفْنَا عَنْهُمُ الرِّجْزَ إِلَى أَجَلٍ هُمْ بَالِغُوهُ إِذَا هُمْ يَنْكُثُونَ (135) فَانْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ فِي الْيَمِّ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ (136)","hl":[[0,213,1]]}},{"id":"ق-0470","fp":"6a9ff2151cae","stateId":487,"easy":"الكفر بآيات الله ← أخذ الله بالذنوب","cause":"الكفر بآيات الله","result":"أخذ الله بالذنوب","explicit":true,"repOf":"ق-0121","ref":"سورة الأنفال: 52","quran":{"s":8,"from":52,"to":52,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ (52)","hl":[[24,153,1]]}},{"id":"ق-0472","fp":"4bd2c8d40623","stateId":487,"easy":"التكذيب بآيات الله ← الإهلاك بالذنوب والإغراق","cause":"التكذيب بآيات الله","result":"الإهلاك بالذنوب والإغراق","explicit":true,"ref":"سورة الأنفال: 54","srcLabel":"القرآن الكريم","quran":{"s":8,"from":54,"to":54,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ كَذَّبُوا بِآيَاتِ رَبِّهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَغْرَقْنَا آلَ فِرْعَوْنَ وَكُلٌّ كَانُوا ظَالِمِينَ (54)","hl":[[24,168,1]]}},{"id":"ق-0549","fp":"04a77af2207b","stateId":487,"easy":"الظلم وتكذيب الرسل ← إهلاك القرون","cause":"الظلم وتكذيب الرسل","result":"إهلاك القرون","explicit":true,"ref":"سورة يونس: 13","srcLabel":"القرآن الكريم","quran":{"s":10,"from":13,"to":13,"text":"وَلَقَدْ أَهْلَكْنَا الْقُرُونَ مِنْ قَبْلِكُمْ لَمَّا ظَلَمُوا وَجَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ وَمَا كَانُوا لِيُؤْمِنُوا كَذَلِكَ نَجْزِي الْقَوْمَ الْمُجْرِمِينَ (13)","hl":[[0,173,1]]}},{"id":"ق-0556","fp":"4baf482a4fca","stateId":487,"easy":"التكذيب بما لم يحيطوا بعلمه ← عاقبة الظالمين","cause":"التكذيب بما لم يحيطوا بعلمه","result":"عاقبة الظالمين","explicit":true,"ref":"سورة يونس: 39","srcLabel":"القرآن الكريم","quran":{"s":10,"from":39,"to":39,"text":"بَلْ كَذَّبُوا بِمَا لَمْ يُحِيطُوا بِعِلْمِهِ وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُ كَذَلِكَ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ (39)","hl":[[0,168,1]]}},{"id":"ق-0562","fp":"4a9330a3d5a4","stateId":487,"easy":"التكذيب بآيات الله ← الإغراق وسوء العاقبة","cause":"التكذيب بآيات الله","result":"الإغراق وسوء العاقبة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0165","ref":"سورة يونس: 73","quran":{"s":10,"from":73,"to":73,"text":"فَكَذَّبُوهُ فَنَجَّيْنَاهُ وَمَنْ مَعَهُ فِي الْفُلْكِ وَجَعَلْنَاهُمْ خَلَائِفَ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ (73)","hl":[[82,175,1]]}},{"id":"ق-0590","fp":"2b46569c2e1f","stateId":487,"easy":"الفاحشة والظلم (قوم لوط) ← قلب الديار وحجارة من سجيل","cause":"الفاحشة والظلم (قوم لوط)","result":"قلب الديار وحجارة من سجيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0658"],"ref":"سورة هود: 82–83","srcLabel":"القرآن الكريم","quran":{"s":11,"from":82,"to":83,"text":"فَلَمَّا جَاءَ أَمْرُنَا جَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِنْ سِجِّيلٍ مَنْضُودٍ (82) مُسَوَّمَةً عِنْدَ رَبِّكَ وَمَا هِيَ مِنَ الظَّالِمِينَ بِبَعِيدٍ (83)","hl":[[0,186,1]]}},{"id":"ق-0658","fp":"8cbc54554d3f","stateId":487,"easy":"الفاحشة (قوم لوط) ← الصيحة وقلب الديار وحجارة من سجيل","cause":"الفاحشة (قوم لوط)","result":"الصيحة وقلب الديار وحجارة من سجيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0590","ref":"سورة الحجر: 73–74","quran":{"s":15,"from":73,"to":74,"text":"فَأَخَذَتْهُمُ الصَّيْحَةُ مُشْرِقِينَ (73) فَجَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِنْ سِجِّيلٍ (74)","hl":[[0,126,1]]}},{"id":"ق-0659","fp":"831abf46914c","stateId":487,"easy":"الظلم (أصحاب الأيكة) ← انتقام الله","cause":"الظلم (أصحاب الأيكة)","result":"انتقام الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الحجر: 78–79","srcLabel":"القرآن الكريم","quran":{"s":15,"from":78,"to":79,"text":"وَإِنْ كَانَ أَصْحَابُ الْأَيْكَةِ لَظَالِمِينَ (78) فَانْتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُبِينٍ (79)","hl":[[0,76,1]]}},{"id":"ق-0660","fp":"da4dd3ecc1b7","stateId":487,"easy":"تكذيب المرسلين والإعراض عن الآيات (أصحاب الحجر) ← الصيحة ولم يغن عنهم كسبهم","cause":"تكذيب المرسلين والإعراض عن الآيات (أصحاب الحجر)","result":"الصيحة ولم يغن عنهم كسبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الحجر: 80–84","srcLabel":"القرآن الكريم","quran":{"s":15,"from":80,"to":84,"text":"وَلَقَدْ كَذَّبَ أَصْحَابُ الْحِجْرِ الْمُرْسَلِينَ (80) وَآتَيْنَاهُمْ آيَاتِنَا فَكَانُوا عَنْهَا مُعْرِضِينَ (81) وَكَانُوا يَنْحِتُونَ مِنَ الْجِبَالِ بُيُوتًا آمِنِينَ (82) فَأَخَذَتْهُمُ الصَّيْحَةُ مُصْبِحِينَ (83) فَمَا أَغْنَى عَنْهُمْ مَا كَانُوا يَكْسِبُونَ (84)","hl":[[0,268,1]]}},{"id":"ق-0671","fp":"c257b94f8393","stateId":487,"easy":"التكذيب ← سوء العاقبة","cause":"التكذيب","result":"سوء العاقبة","explicit":true,"repOf":"ق-0165","ref":"سورة النحل: 36","quran":{"s":16,"from":36,"to":36,"text":"وَلَقَدْ بَعَثْنَا فِي كُلِّ أُمَّةٍ رَسُولًا أَنِ اعْبُدُوا اللَّهَ وَاجْتَنِبُوا الطَّاغُوتَ فَمِنْهُمْ مَنْ هَدَى اللَّهُ وَمِنْهُمْ مَنْ حَقَّتْ عَلَيْهِ الضَّلَالَةُ فَسِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ (36)","hl":[[171,245,1]]}},{"id":"ق-0686","fp":"ed1cf9cce800","stateId":487,"easy":"تكذيب الرسول ← أخذ العذاب","cause":"تكذيب الرسول","result":"أخذ العذاب","explicit":true,"similar":["ق-1017","ق-1026"],"ref":"سورة النحل: 113","srcLabel":"القرآن الكريم","quran":{"s":16,"from":113,"to":113,"text":"وَلَقَدْ جَاءَهُمْ رَسُولٌ مِنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ الْعَذَابُ وَهُمْ ظَالِمُونَ (113)","hl":[[0,90,1]]}},{"id":"ق-0717","fp":"662faf826ebf","stateId":487,"easy":"إخراج الرسول من أرضه ← لا يلبثون بعده إلا قليلاً (سنة الله)","cause":"إخراج الرسول من أرضه","result":"لا يلبثون بعده إلا قليلاً (سنة الله)","explicit":true,"ref":"سورة الإسراء: 76–77","srcLabel":"القرآن الكريم","quran":{"s":17,"from":76,"to":77,"text":"وَإِنْ كَادُوا لَيَسْتَفِزُّونَكَ مِنَ الْأَرْضِ لِيُخْرِجُوكَ مِنْهَا وَإِذًا لَا يَلْبَثُونَ خِلَافَكَ إِلَّا قَلِيلًا (76) سُنَّةَ مَنْ قَدْ أَرْسَلْنَا قَبْلَكَ مِنْ رُسُلِنَا وَلَا تَجِدُ لِسُنَّتِنَا تَحْوِيلًا (77)","hl":[[0,216,1]]}},{"id":"ق-0722","fp":"d6a87d4cb79d","stateId":487,"easy":"إرادة استفزاز المؤمنين من الأرض (فرعون) ← الإغراق وإسكان المستضعفين الأرض","cause":"إرادة استفزاز المؤمنين من الأرض (فرعون)","result":"الإغراق وإسكان المستضعفين الأرض","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[38],"ref":"سورة الإسراء: 103–104","srcLabel":"القرآن الكريم","quran":{"s":17,"from":103,"to":104,"text":"فَأَرَادَ أَنْ يَسْتَفِزَّهُمْ مِنَ الْأَرْضِ فَأَغْرَقْنَاهُ وَمَنْ مَعَهُ جَمِيعًا (103) وَقُلْنَا مِنْ بَعْدِهِ لِبَنِي إِسْرَائِيلَ اسْكُنُوا الْأَرْضَ فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ جِئْنَا بِكُمْ لَفِيفًا (104)","hl":[[0,155,1]]}},{"id":"ق-0784","fp":"1cfa9baa3032","stateId":487,"easy":"الإسراف (التكذيب) ← الإهلاك","cause":"الإسراف (التكذيب)","result":"الإهلاك","explicit":true,"ref":"سورة الأنبياء: 9","srcLabel":"القرآن الكريم","quran":{"s":21,"from":9,"to":9,"text":"ثُمَّ صَدَقْنَاهُمُ الْوَعْدَ فَأَنْجَيْنَاهُمْ وَمَنْ نَشَاءُ وَأَهْلَكْنَا الْمُسْرِفِينَ (9)","hl":[[63,91,1]]}},{"id":"ق-0789","fp":"c85d915b9448","stateId":487,"easy":"السخرية بالرسل ← يحيق بالساخرين ما كانوا به يستهزئون","cause":"السخرية بالرسل","result":"يحيق بالساخرين ما كانوا به يستهزئون","explicit":true,"repOf":"ق-0346","ref":"سورة الأنبياء: 41","quran":{"s":21,"from":41,"to":41,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذِينَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (41)","hl":[[0,114,1]]}},{"id":"ق-0794","fp":"d73d47cdf928","stateId":487,"easy":"التكذيب بآيات الله ← الإغراق","cause":"التكذيب بآيات الله","result":"الإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0408","ref":"سورة الأنبياء: 77","quran":{"s":21,"from":77,"to":77,"text":"وَنَصَرْنَاهُ مِنَ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ (77)","hl":[[61,122,1]]}},{"id":"ق-0834","fp":"ea4976e36e17","stateId":487,"easy":"التكذيب والظلم ← الصيحة بالحق وجعلهم غثاءً","cause":"التكذيب والظلم","result":"الصيحة بالحق وجعلهم غثاءً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المؤمنون: 39–41","srcLabel":"القرآن الكريم","quran":{"s":23,"from":39,"to":41,"text":"قَالَ رَبِّ انْصُرْنِي بِمَا كَذَّبُونِ (39) قَالَ عَمَّا قَلِيلٍ لَيُصْبِحُنَّ نَادِمِينَ (40) فَأَخَذَتْهُمُ الصَّيْحَةُ بِالْحَقِّ فَجَعَلْنَاهُمْ غُثَاءً فَبُعْدًا لِلْقَوْمِ الظَّالِمِينَ (41)","hl":[[0,192,1]]}},{"id":"ق-0835","fp":"f95d3d857b2d","stateId":487,"easy":"تكذيب الرسل أمةً بعد أمة ← إتباع بعضهم بعضاً بالهلاك وجعلهم أحاديث","cause":"تكذيب الرسل أمةً بعد أمة","result":"إتباع بعضهم بعضاً بالهلاك وجعلهم أحاديث","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة المؤمنون: 44","srcLabel":"القرآن الكريم","quran":{"s":23,"from":44,"to":44,"text":"ثُمَّ أَرْسَلْنَا رُسُلَنَا تَتْرَى كُلَّ مَا جَاءَ أُمَّةً رَسُولُهَا كَذَّبُوهُ فَأَتْبَعْنَا بَعْضَهُمْ بَعْضًا وَجَعَلْنَاهُمْ أَحَادِيثَ فَبُعْدًا لِقَوْمٍ لَا يُؤْمِنُونَ (44)","hl":[[36,176,1]]}},{"id":"ق-0877","fp":"da688e6f1858","stateId":487,"easy":"التكذيب بآيات الله ← التدمير","cause":"التكذيب بآيات الله","result":"التدمير","explicit":true,"ref":"سورة الفرقان: 36","srcLabel":"القرآن الكريم","quran":{"s":25,"from":36,"to":36,"text":"فَقُلْنَا اذْهَبَا إِلَى الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا فَدَمَّرْنَاهُمْ تَدْمِيرًا (36)","hl":[[19,94,1]]}},{"id":"ق-0878","fp":"1b9c51e59a30","stateId":487,"easy":"تكذيب الرسل (قوم نوح) ← الإغراق وعذاب أليم","cause":"تكذيب الرسل (قوم نوح)","result":"الإغراق وعذاب أليم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"سورة الفرقان: 37","srcLabel":"القرآن الكريم","quran":{"s":25,"from":37,"to":37,"text":"وَقَوْمَ نُوحٍ لَمَّا كَذَّبُوا الرُّسُلَ أَغْرَقْنَاهُمْ وَجَعَلْنَاهُمْ لِلنَّاسِ آيَةً وَأَعْتَدْنَا لِلظَّالِمِينَ عَذَابًا أَلِيمًا (37)","hl":[[0,136,1]]}},{"id":"ق-0879","fp":"eb98c668fee3","stateId":487,"easy":"تكذيب الرسل (عاد وثمود وأصحاب الرس) ← التتبير","cause":"تكذيب الرسل (عاد وثمود وأصحاب الرس)","result":"التتبير","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفرقان: 38–39","srcLabel":"القرآن الكريم","quran":{"s":25,"from":38,"to":39,"text":"وَعَادًا وَثَمُودَ وَأَصْحَابَ الرَّسِّ وَقُرُونًا بَيْنَ ذَلِكَ كَثِيرًا (38) وَكُلًّا ضَرَبْنَا لَهُ الْأَمْثَالَ وَكُلًّا تَبَّرْنَا تَتْبِيرًا (39)","hl":[[0,146,1]]}},{"id":"ق-0886","fp":"fdd946a5abe7","stateId":487,"easy":"الإعراض والتكذيب ← يأتيهم أنباء ما كانوا به يستهزئون","cause":"الإعراض والتكذيب","result":"يأتيهم أنباء ما كانوا به يستهزئون","explicit":true,"ref":"سورة الشعراء: 5–6","srcLabel":"القرآن الكريم","quran":{"s":26,"from":5,"to":6,"text":"وَمَا يَأْتِيهِمْ مِنْ ذِكْرٍ مِنَ الرَّحْمَنِ مُحْدَثٍ إِلَّا كَانُوا عَنْهُ مُعْرِضِينَ (5) فَقَدْ كَذَّبُوا فَسَيَأْتِيهِمْ أَنْبَاءُ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (6)","hl":[[0,169,1]]}},{"id":"ق-0892","fp":"99ab78d4cf69","stateId":487,"easy":"التكذيب (عاد) ← الإهلاك","cause":"التكذيب (عاد)","result":"الإهلاك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الشعراء: 139","srcLabel":"القرآن الكريم","quran":{"s":26,"from":139,"to":139,"text":"فَكَذَّبُوهُ فَأَهْلَكْنَاهُمْ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ (139)","hl":[[0,92,1]]}},{"id":"ق-0893","fp":"af4a0d537748","stateId":487,"easy":"عقر الناقة (ثمود) ← الندم وأخذ العذاب","cause":"عقر الناقة (ثمود)","result":"الندم وأخذ العذاب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الشعراء: 157–158","srcLabel":"القرآن الكريم","quran":{"s":26,"from":157,"to":158,"text":"فَعَقَرُوهَا فَأَصْبَحُوا نَادِمِينَ (157) فَأَخَذَهُمُ الْعَذَابُ إِنَّ فِي ذَلِكَ لَآيَةً وَمَا كَانَ أَكْثَرُهُمْ مُؤْمِنِينَ (158)","hl":[[0,66,1]]}},{"id":"ق-0894","fp":"7750f9449bc2","stateId":487,"easy":"عمل الفاحشة (قوم لوط) ← تدميرهم ومطر السوء ونجاة لوط وأهله","cause":"عمل الفاحشة (قوم لوط)","result":"تدميرهم ومطر السوء ونجاة لوط وأهله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[4],"ref":"سورة الشعراء: 169–173","srcLabel":"القرآن الكريم","quran":{"s":26,"from":169,"to":173,"text":"رَبِّ نَجِّنِي وَأَهْلِي مِمَّا يَعْمَلُونَ (169) فَنَجَّيْنَاهُ وَأَهْلَهُ أَجْمَعِينَ (170) إِلَّا عَجُوزًا فِي الْغَابِرِينَ (171) ثُمَّ دَمَّرْنَا الْآخَرِينَ (172) وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا فَسَاءَ مَطَرُ الْمُنْذَرِينَ (173)","hl":[[0,231,1]]}},{"id":"ق-0895","fp":"f18871ec18f7","stateId":487,"easy":"التكذيب وبخس الكيل (أصحاب الأيكة) ← عذاب يوم الظلة","cause":"التكذيب وبخس الكيل (أصحاب الأيكة)","result":"عذاب يوم الظلة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الشعراء: 189","srcLabel":"القرآن الكريم","quran":{"s":26,"from":189,"to":189,"text":"فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ الظُّلَّةِ إِنَّهُ كَانَ عَذَابَ يَوْمٍ عَظِيمٍ (189)","hl":[[0,88,1]]}},{"id":"ق-0945","fp":"6c631c15cf96","stateId":487,"easy":"تكذيب شعيب ← الرجفة","cause":"تكذيب شعيب","result":"الرجفة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0414","ref":"سورة العنكبوت: 37","quran":{"s":29,"from":37,"to":37,"text":"فَكَذَّبُوهُ فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ (37)","hl":[[0,77,1]]}},{"id":"ق-1017","fp":"24f385f2ef1f","stateId":487,"easy":"تكذيب الرسل ← النكير والأخذ","cause":"تكذيب الرسل","result":"النكير والأخذ","explicit":true,"repOf":"ق-0686","ref":"سورة سبأ: 45","quran":{"s":34,"from":45,"to":45,"text":"وَكَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ وَمَا بَلَغُوا مِعْشَارَ مَا آتَيْنَاهُمْ فَكَذَّبُوا رُسُلِي فَكَيْفَ كَانَ نَكِيرِ (45)","hl":[[0,120,1]]}},{"id":"ق-1026","fp":"45600e37e65e","stateId":487,"easy":"تكذيب الرسل بعد البينات ← أخذ الله والنكير","cause":"تكذيب الرسل بعد البينات","result":"أخذ الله والنكير","explicit":true,"repOf":"ق-0686","ref":"سورة فاطر: 25–26","quran":{"s":35,"from":25,"to":26,"text":"وَإِنْ يُكَذِّبُوكَ فَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ وَبِالزُّبُرِ وَبِالْكِتَابِ الْمُنِيرِ (25) ثُمَّ أَخَذْتُ الَّذِينَ كَفَرُوا فَكَيْفَ كَانَ نَكِيرِ (26)","hl":[[0,201,1]]}},{"id":"ق-1033","fp":"753cbb2fca68","stateId":487,"easy":"الكفر مع القوة ← عاقبة الذين من قبلهم","cause":"الكفر مع القوة","result":"عاقبة الذين من قبلهم","explicit":true,"ref":"سورة فاطر: 44","srcLabel":"القرآن الكريم","quran":{"s":35,"from":44,"to":44,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ وَكَانُوا أَشَدَّ مِنْهُمْ قُوَّةً وَمَا كَانَ اللَّهُ لِيُعْجِزَهُ مِنْ شَيْءٍ فِي السَّمَاوَاتِ وَلَا فِي الْأَرْضِ إِنَّهُ كَانَ عَلِيمًا قَدِيرًا (44)","hl":[[0,129,1]]}},{"id":"ق-1037","fp":"815a4029cea9","stateId":487,"easy":"تكذيب المرسلين (أصحاب القرية) ← صيحة واحدة فإذا هم خامدون","cause":"تكذيب المرسلين (أصحاب القرية)","result":"صيحة واحدة فإذا هم خامدون","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة يس: 28–29","srcLabel":"القرآن الكريم","quran":{"s":36,"from":28,"to":29,"text":"وَمَا أَنْزَلْنَا عَلَى قَوْمِهِ مِنْ بَعْدِهِ مِنْ جُنْدٍ مِنَ السَّمَاءِ وَمَا كُنَّا مُنْزِلِينَ (28) إِنْ كَانَتْ إِلَّا صَيْحَةً وَاحِدَةً فَإِذَا هُمْ خَامِدُونَ (29)","hl":[[0,167,1]]}},{"id":"ق-1045","fp":"f05cf5f33f9f","stateId":487,"easy":"الضلال بعد الإنذار ← سوء عاقبة المنذَرين","cause":"الضلال بعد الإنذار","result":"سوء عاقبة المنذَرين","explicit":true,"ref":"سورة الصافات: 71–73","srcLabel":"القرآن الكريم","quran":{"s":37,"from":71,"to":73,"text":"وَلَقَدْ ضَلَّ قَبْلَهُمْ أَكْثَرُ الْأَوَّلِينَ (71) وَلَقَدْ أَرْسَلْنَا فِيهِمْ مُنْذِرِينَ (72) فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِينَ (73)","hl":[[0,147,1]]}},{"id":"ق-1057","fp":"b96ad20ba76f","stateId":487,"easy":"العزة والشقاق (الكفر) ← إهلاك القرون ولات حين مناص","cause":"العزة والشقاق (الكفر)","result":"إهلاك القرون ولات حين مناص","explicit":true,"ref":"سورة ص: 2–3","srcLabel":"القرآن الكريم","quran":{"s":38,"from":2,"to":3,"text":"بَلِ الَّذِينَ كَفَرُوا فِي عِزَّةٍ وَشِقَاقٍ (2) كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ فَنَادَوْا وَلَاتَ حِينَ مَنَاصٍ (3)","hl":[[0,127,1]]}},{"id":"ق-1058","fp":"c1d1958e7911","stateId":487,"easy":"تكذيب الرسل ← حقّ العقاب","cause":"تكذيب الرسل","result":"حقّ العقاب","explicit":true,"similar":["ق-1254"],"ref":"سورة ص: 12–14","srcLabel":"القرآن الكريم","quran":{"s":38,"from":12,"to":14,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو الْأَوْتَادِ (12) وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَابُ الْأَيْكَةِ أُولَئِكَ الْأَحْزَابُ (13) إِنْ كُلٌّ إِلَّا كَذَّبَ الرُّسُلَ فَحَقَّ عِقَابِ (14)","hl":[[0,205,1]]}},{"id":"ق-1084","fp":"881ba9fdb303","stateId":487,"easy":"التكذيب ← العذاب من حيث لا يشعرون وخزي الدنيا وعذاب الآخرة أكبر","cause":"التكذيب","result":"العذاب من حيث لا يشعرون وخزي الدنيا وعذاب الآخرة أكبر","explicit":true,"otherNeedIds":[39,57],"ref":"سورة الزمر: 25–26","srcLabel":"القرآن الكريم","quran":{"s":39,"from":25,"to":26,"text":"كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَأَتَاهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (25) فَأَذَاقَهُمُ اللَّهُ الْخِزْيَ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَكْبَرُ لَوْ كَانُوا يَعْلَمُونَ (26)","hl":[[0,204,1]]}},{"id":"ق-1102","fp":"77f2e5f4161c","stateId":487,"easy":"الجدال في آيات الله بالباطل وهمّ الأمم برسلها ← الأخذ والعقاب وحقّت عليهم كلمة العذاب","cause":"الجدال في آيات الله بالباطل وهمّ الأمم برسلها","result":"الأخذ والعقاب وحقّت عليهم كلمة العذاب","explicit":true,"otherNeedIds":[57],"ref":"سورة غافر: 4–6","srcLabel":"القرآن الكريم","quran":{"s":40,"from":4,"to":6,"text":"مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلَادِ (4) كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَالْأَحْزَابُ مِنْ بَعْدِهِمْ وَهَمَّتْ كُلُّ أُمَّةٍ بِرَسُولِهِمْ لِيَأْخُذُوهُ وَجَادَلُوا بِالْبَاطِلِ لِيُدْحِضُوا بِهِ الْحَقَّ فَأَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ (5) وَكَذَلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا أَنَّهُمْ أَصْحَابُ النَّارِ (6)","hl":[[0,409,1]]}},{"id":"ق-1107","fp":"855e950bacbd","stateId":487,"easy":"الكفر بعد مجيء البينات ← أخذ الله بالذنوب ولا واقي","cause":"الكفر بعد مجيء البينات","result":"أخذ الله بالذنوب ولا واقي","explicit":true,"ref":"سورة غافر: 21–22","srcLabel":"القرآن الكريم","quran":{"s":40,"from":21,"to":22,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ كَانُوا مِنْ قَبْلِهِمْ كَانُوا هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ (21) ذَلِكَ بِأَنَّهُمْ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَكَفَرُوا فَأَخَذَهُمُ اللَّهُ إِنَّهُ قَوِيٌّ شَدِيدُ الْعِقَابِ (22)","hl":[[0,380,1]]}},{"id":"ق-1125","fp":"0c288c35b3c5","stateId":487,"easy":"الفرح بما عندهم من العلم وردّ البينات ← يحيق بهم ما كانوا به يستهزئون ولا يغني عنهم كسبهم","cause":"الفرح بما عندهم من العلم وردّ البينات","result":"يحيق بهم ما كانوا به يستهزئون ولا يغني عنهم كسبهم","explicit":true,"ref":"سورة غافر: 82–83","srcLabel":"القرآن الكريم","quran":{"s":40,"from":82,"to":83,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ كَانُوا أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَمَا أَغْنَى عَنْهُمْ مَا كَانُوا يَكْسِبُونَ (82) فَلَمَّا جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَرِحُوا بِمَا عِنْدَهُمْ مِنَ الْعِلْمِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (83)","hl":[[0,351,1]]}},{"id":"ق-1129","fp":"7ccc96013b8d","stateId":487,"easy":"الاستكبار في الأرض بغير الحق وجحود الآيات (عاد) ← ريح صرصر وعذاب الخزي في الدنيا وعذاب الآخرة أخزى","cause":"الاستكبار في الأرض بغير الحق وجحود الآيات (عاد)","result":"ريح صرصر وعذاب الخزي في الدنيا وعذاب الآخرة أخزى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"سورة فصلت: 15–16","srcLabel":"القرآن الكريم","quran":{"s":41,"from":15,"to":16,"text":"فَأَمَّا عَادٌ فَاسْتَكْبَرُوا فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَقَالُوا مَنْ أَشَدُّ مِنَّا قُوَّةً أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةً وَكَانُوا بِآيَاتِنَا يَجْحَدُونَ (15) فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِي أَيَّامٍ نَحِسَاتٍ لِنُذِيقَهُمْ عَذَابَ الْخِزْيِ فِي الْحَيَاةِ الدُّنْيَا وَلَعَذَابُ الْآخِرَةِ أَخْزَى وَهُمْ لَا يُنْصَرُونَ (16)","hl":[[0,396,1]]}},{"id":"ق-1130","fp":"b8078d034a45","stateId":487,"easy":"استحباب العمى على الهدى (ثمود) ← صاعقة العذاب الهُون","cause":"استحباب العمى على الهدى (ثمود)","result":"صاعقة العذاب الهُون","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة فصلت: 17","srcLabel":"القرآن الكريم","quran":{"s":41,"from":17,"to":17,"text":"وَأَمَّا ثَمُودُ فَهَدَيْنَاهُمْ فَاسْتَحَبُّوا الْعَمَى عَلَى الْهُدَى فَأَخَذَتْهُمْ صَاعِقَةُ الْعَذَابِ الْهُونِ بِمَا كَانُوا يَكْسِبُونَ (17)","hl":[[0,142,1]]}},{"id":"ق-1156","fp":"cf26be78ca96","stateId":487,"easy":"كسب الأيدي من الذنوب ← المصيبة (ويعفو عن كثير)","cause":"كسب الأيدي من الذنوب","result":"المصيبة (ويعفو عن كثير)","explicit":true,"ref":"سورة الشورى: 30","srcLabel":"القرآن الكريم","quran":{"s":42,"from":30,"to":30,"text":"وَمَا أَصَابَكُمْ مِنْ مُصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو عَنْ كَثِيرٍ (30)","hl":[[0,84,1]]}},{"id":"ق-1166","fp":"e4dbd36300fe","stateId":487,"easy":"تقليد الآباء في الباطل وتكذيب الرسل ← الانتقام وسوء العاقبة","cause":"تقليد الآباء في الباطل وتكذيب الرسل","result":"الانتقام وسوء العاقبة","explicit":true,"ref":"سورة الزخرف: 25","srcLabel":"القرآن الكريم","quran":{"s":43,"from":25,"to":25,"text":"فَانْتَقَمْنَا مِنْهُمْ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ (25)","hl":[[0,72,1]]}},{"id":"ق-1198","fp":"e9891aed6d1d","stateId":487,"easy":"التكذيب واستعجال العذاب (عاد) ← ريح تدمّر كل شيء","cause":"التكذيب واستعجال العذاب (عاد)","result":"ريح تدمّر كل شيء","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الأحقاف: 25","srcLabel":"القرآن الكريم","quran":{"s":46,"from":25,"to":25,"text":"تُدَمِّرُ كُلَّ شَيْءٍ بِأَمْرِ رَبِّهَا فَأَصْبَحُوا لَا يُرَى إِلَّا مَسَاكِنُهُمْ كَذَلِكَ نَجْزِي الْقَوْمَ الْمُجْرِمِينَ (25)","hl":[[0,126,1]]}},{"id":"ق-1214","fp":"81c1b91ad263","stateId":487,"easy":"إخراج الرسول ← الإهلاك بلا ناصر","cause":"إخراج الرسول","result":"الإهلاك بلا ناصر","explicit":true,"ref":"سورة محمد: 13","srcLabel":"القرآن الكريم","quran":{"s":47,"from":13,"to":13,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ هِيَ أَشَدُّ قُوَّةً مِنْ قَرْيَتِكَ الَّتِي أَخْرَجَتْكَ أَهْلَكْنَاهُمْ فَلَا نَاصِرَ لَهُمْ (13)","hl":[[0,120,1]]}},{"id":"ق-1254","fp":"754ca8f89184","stateId":487,"easy":"تكذيب الرسل ← حقّ الوعيد","cause":"تكذيب الرسل","result":"حقّ الوعيد","explicit":true,"repOf":"ق-1058","ref":"سورة ق: 12–14","quran":{"s":50,"from":12,"to":14,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَأَصْحَابُ الرَّسِّ وَثَمُودُ (12) وَعَادٌ وَفِرْعَوْنُ وَإِخْوَانُ لُوطٍ (13) وَأَصْحَابُ الْأَيْكَةِ وَقَوْمُ تُبَّعٍ كُلٌّ كَذَّبَ الرُّسُلَ فَحَقَّ وَعِيدِ (14)","hl":[[0,194,1]]}},{"id":"ق-1259","fp":"0497d172f019","stateId":487,"easy":"الإجرام والإسراف (قوم لوط) ← حجارة من طين","cause":"الإجرام والإسراف (قوم لوط)","result":"حجارة من طين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الذاريات: 32–34","srcLabel":"القرآن الكريم","quran":{"s":51,"from":32,"to":34,"text":"قَالُوا إِنَّا أُرْسِلْنَا إِلَى قَوْمٍ مُجْرِمِينَ (32) لِنُرْسِلَ عَلَيْهِمْ حِجَارَةً مِنْ طِينٍ (33) مُسَوَّمَةً عِنْدَ رَبِّكَ لِلْمُسْرِفِينَ (34)","hl":[[0,147,1]]}},{"id":"ق-1261","fp":"4cdfca7b1072","stateId":487,"easy":"التولي والتكذيب (فرعون) ← النبذ في اليمّ","cause":"التولي والتكذيب (فرعون)","result":"النبذ في اليمّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الذاريات: 39–40","srcLabel":"القرآن الكريم","quran":{"s":51,"from":39,"to":40,"text":"فَتَوَلَّى بِرُكْنِهِ وَقَالَ سَاحِرٌ أَوْ مَجْنُونٌ (39) فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ وَهُوَ مُلِيمٌ (40)","hl":[[0,127,1]]}},{"id":"ق-1262","fp":"5d954eaafeca","stateId":487,"easy":"الكفر (عاد) ← الريح العقيم","cause":"الكفر (عاد)","result":"الريح العقيم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الذاريات: 41–42","srcLabel":"القرآن الكريم","quran":{"s":51,"from":41,"to":42,"text":"وَفِي عَادٍ إِذْ أَرْسَلْنَا عَلَيْهِمُ الرِّيحَ الْعَقِيمَ (41) مَا تَذَرُ مِنْ شَيْءٍ أَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِ (42)","hl":[[0,134,1]]}},{"id":"ق-1263","fp":"62473462bd7f","stateId":487,"easy":"العتوّ عن أمر الله (ثمود) ← الصاعقة","cause":"العتوّ عن أمر الله (ثمود)","result":"الصاعقة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الذاريات: 44–45","srcLabel":"القرآن الكريم","quran":{"s":51,"from":44,"to":45,"text":"فَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ الصَّاعِقَةُ وَهُمْ يَنْظُرُونَ (44) فَمَا اسْتَطَاعُوا مِنْ قِيَامٍ وَمَا كَانُوا مُنْتَصِرِينَ (45)","hl":[[0,143,1]]}},{"id":"ق-1276","fp":"36e3fc749173","stateId":487,"easy":"الظلم والطغيان ← الإهلاك","cause":"الظلم والطغيان","result":"الإهلاك","explicit":true,"ref":"سورة النجم: 50–53","srcLabel":"القرآن الكريم","quran":{"s":53,"from":50,"to":53,"text":"وَأَنَّهُ أَهْلَكَ عَادًا الْأُولَى (50) وَثَمُودَ فَمَا أَبْقَى (51) وَقَوْمَ نُوحٍ مِنْ قَبْلُ إِنَّهُمْ كَانُوا هُمْ أَظْلَمَ وَأَطْغَى (52) وَالْمُؤْتَفِكَةَ أَهْوَى (53)","hl":[[0,169,1]]}},{"id":"ق-1279","fp":"374b06f048bf","stateId":487,"easy":"التكذيب (عاد) ← ريح صرصر في يوم نحس","cause":"التكذيب (عاد)","result":"ريح صرصر في يوم نحس","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القمر: 18–20","srcLabel":"القرآن الكريم","quran":{"s":54,"from":18,"to":20,"text":"كَذَّبَتْ عَادٌ فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ (18) إِنَّا أَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِي يَوْمِ نَحْسٍ مُسْتَمِرٍّ (19) تَنْزِعُ النَّاسَ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ مُنْقَعِرٍ (20)","hl":[[0,193,1]]}},{"id":"ق-1280","fp":"a040fb875949","stateId":487,"easy":"تكذيب النذر وعقر الناقة (ثمود) ← صيحة واحدة فكانوا كهشيم المحتظر","cause":"تكذيب النذر وعقر الناقة (ثمود)","result":"صيحة واحدة فكانوا كهشيم المحتظر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القمر: 23–31","srcLabel":"القرآن الكريم","quran":{"s":54,"from":23,"to":31,"text":"كَذَّبَتْ ثَمُودُ بِالنُّذُرِ (23) فَقَالُوا أَبَشَرًا مِنَّا وَاحِدًا نَتَّبِعُهُ إِنَّا إِذًا لَفِي ضَلَالٍ وَسُعُرٍ (24) أَأُلْقِيَ الذِّكْرُ عَلَيْهِ مِنْ بَيْنِنَا بَلْ هُوَ كَذَّابٌ أَشِرٌ (25) سَيَعْلَمُونَ غَدًا مَنِ الْكَذَّابُ الْأَشِرُ (26) إِنَّا مُرْسِلُو النَّاقَةِ فِتْنَةً لَهُمْ فَارْتَقِبْهُمْ وَاصْطَبِرْ (27) وَنَبِّئْهُمْ أَنَّ الْمَاءَ قِسْمَةٌ بَيْنَهُمْ كُلُّ شِرْبٍ مُحْتَضَرٌ (28) فَنَادَوْا صَاحِبَهُمْ فَتَعَاطَى فَعَقَرَ (29) فَكَيْفَ كَانَ عَذَابِي وَنُذُرِ (30) إِنَّا أَرْسَلْنَا عَلَيْهِمْ صَيْحَةً وَاحِدَةً فَكَانُوا كَهَشِيمِ الْمُحْتَظِرِ (31)","hl":[[0,575,1]]}},{"id":"ق-1281","fp":"bb9ffbed80a4","stateId":487,"easy":"التكذيب بالنذر (قوم لوط) ← الحاصب","cause":"التكذيب بالنذر (قوم لوط)","result":"الحاصب","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1365"],"ref":"سورة القمر: 33–34","srcLabel":"القرآن الكريم","quran":{"s":54,"from":33,"to":34,"text":"كَذَّبَتْ قَوْمُ لُوطٍ بِالنُّذُرِ (33) إِنَّا أَرْسَلْنَا عَلَيْهِمْ حَاصِبًا إِلَّا آلَ لُوطٍ نَجَّيْنَاهُمْ بِسَحَرٍ (34)","hl":[[0,78,1]]}},{"id":"ق-1283","fp":"17bdebab305a","stateId":487,"easy":"التكذيب بالآيات كلها (آل فرعون) ← أخذ عزيز مقتدر","cause":"التكذيب بالآيات كلها (آل فرعون)","result":"أخذ عزيز مقتدر","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القمر: 42","srcLabel":"القرآن الكريم","quran":{"s":54,"from":42,"to":42,"text":"كَذَّبُوا بِآيَاتِنَا كُلِّهَا فَأَخَذْنَاهُمْ أَخْذَ عَزِيزٍ مُقْتَدِرٍ (42)","hl":[[0,72,1]]}},{"id":"ق-1341","fp":"ae2746cf08e1","stateId":487,"easy":"الكفر بالرسل والتولي عنهم ← ذوق وبال الأمر وعذاب أليم","cause":"الكفر بالرسل والتولي عنهم","result":"ذوق وبال الأمر وعذاب أليم","explicit":true,"otherNeedIds":[57],"ref":"سورة التغابن: 5–6","srcLabel":"القرآن الكريم","quran":{"s":64,"from":5,"to":6,"text":"أَلَمْ يَأْتِكُمْ نَبَأُ الَّذِينَ كَفَرُوا مِنْ قَبْلُ فَذَاقُوا وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ (5) ذَلِكَ بِأَنَّهُ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَقَالُوا أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا وَتَوَلَّوْا وَاسْتَغْنَى اللَّهُ وَاللَّهُ غَنِيٌّ حَمِيدٌ (6)","hl":[[0,280,1]]}},{"id":"ق-1365","fp":"8cf26c1e8eef","stateId":487,"easy":"التكذيب ← الخسف أو الحاصب والنكير","cause":"التكذيب","result":"الخسف أو الحاصب والنكير","explicit":true,"repOf":"ق-1281","ref":"سورة الملك: 16–18","quran":{"s":67,"from":16,"to":18,"text":"أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ (16) أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ (17) وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ (18)","hl":[[0,261,1]]}},{"id":"ق-1372","fp":"9261a0bb491e","stateId":487,"easy":"التكذيب بالقارعة (ثمود وعاد) ← الإهلاك بالطاغية وبريح صرصر عاتية","cause":"التكذيب بالقارعة (ثمود وعاد)","result":"الإهلاك بالطاغية وبريح صرصر عاتية","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الحاقة: 4–6","srcLabel":"القرآن الكريم","quran":{"s":69,"from":4,"to":6,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ (4) فَأَمَّا ثَمُودُ فَأُهْلِكُوا بِالطَّاغِيَةِ (5) وَأَمَّا عَادٌ فَأُهْلِكُوا بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ (6)","hl":[[0,148,1]]}},{"id":"ق-1373","fp":"1cc4910e547f","stateId":487,"easy":"الخاطئة وعصيان رسول الله (فرعون ومن قبله والمؤتفكات) ← أخذة رابية","cause":"الخاطئة وعصيان رسول الله (فرعون ومن قبله والمؤتفكات)","result":"أخذة رابية","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-1391"],"ref":"سورة الحاقة: 9–10","srcLabel":"القرآن الكريم","quran":{"s":69,"from":9,"to":10,"text":"وَجَاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِ (9) فَعَصَوْا رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَابِيَةً (10)","hl":[[0,132,1]]}},{"id":"ق-1391","fp":"7f1da43816f3","stateId":487,"easy":"عصيان الرسول (فرعون) ← أخذ وبيل","cause":"عصيان الرسول (فرعون)","result":"أخذ وبيل","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1373","ref":"سورة المزمل: 15–16","quran":{"s":73,"from":15,"to":16,"text":"إِنَّا أَرْسَلْنَا إِلَيْكُمْ رَسُولًا شَاهِدًا عَلَيْكُمْ كَمَا أَرْسَلْنَا إِلَى فِرْعَوْنَ رَسُولًا (15) فَعَصَى فِرْعَوْنُ الرَّسُولَ فَأَخَذْنَاهُ أَخْذًا وَبِيلًا (16)","hl":[[108,168,1]]}},{"id":"ق-1440","fp":"850965774d07","stateId":487,"easy":"الطغيان وتكذيب الرسول وعقر الناقة (ثمود) ← الدمدمة عليهم بذنبهم","cause":"الطغيان وتكذيب الرسول وعقر الناقة (ثمود)","result":"الدمدمة عليهم بذنبهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الشمس: 11–15","srcLabel":"القرآن الكريم","quran":{"s":91,"from":11,"to":15,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا (11) إِذِ انْبَعَثَ أَشْقَاهَا (12) فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا (13) فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا (14) وَلَا يَخَافُ عُقْبَاهَا (15)","hl":[[0,244,1]]}},{"id":"س-07763","fp":"1953b25e04c6","stateId":487,"easy":"إذا عاند القوم الحق ← قد يصيبهم القحط (من واقعة)","cause":"دَعا عليهم بسِنينَ كَسِني يوسُفَ","result":"فأصابَهم قَحطٌ وجَهدٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 2798","srcLabel":"البخاري","text":["جاءَ إلى عبدِ اللهِ رَجُلٌ فقال: تَرَكتُ في المَسجِدِ رَجُلًا يُفَسِّرُ القُرآنَ برَأيِه، يُفَسِّرُ هذه الآيةَ: {يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ} قال: يَأتي النَّاسَ يَومَ القيامةِ دُخانٌ، فيَأخُذُ بأنفاسِهم حتَّى يَأخُذَهم منه كَهَيئةِ الزُّكامِ، فقال عبدُ اللهِ: مَن عَلِمَ عِلمًا فليَقُلْ به، ومَن لم يَعلَم فليَقُلْ: اللهُ أعلَمُ؛ فإنَّ مِن فِقهِ الرَّجُلِ أن يَقولَ لما لا عِلمَ له به: اللهُ أعلَمُ، إنَّما كان هذا أنَّ قُرَيشًا لَمَّا استَعصَت على النَّبيِّ صلَّى اللهُ عليه وسلَّم، ",["دَعا عليهم بسِنينَ كَسِني يوسُفَ",1],"، ",["فأصابَهم قَحطٌ وجَهدٌ",2],"، حتَّى جَعَلَ الرَّجُلُ يَنظُرُ إلى السَّماءِ فيَرى بينَه وبينَها كَهَيئةِ الدُّخانِ مِنَ الجَهدِ، وحتَّى أكَلوا العِظامَ، فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فقال: يا رَسولَ اللهِ، استَغفِرِ اللهَ لمُضَرَ؛ فإنَّهم قد هَلَكوا، فقال: لمُضَرَ! إنَّكَ لَجَريءٌ، قال: فدَعا اللهَ لهم، فأنزَلَ اللهُ عَزَّ وجَلَّ: {إنَّا كاشِفو العَذابِ قَليلًا إنَّكُم عائِدونَ} قال: فمُطِروا، فلَمَّا أصابَتهُمُ الرَّفاهيةُ، قال: عادوا إلى ما كانوا عليه، قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {فارتَقِب يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ يَغشى النَّاسَ هذا عَذابٌ أليمٌ} {يَومَ نَبطِشُ البَطشةَ الكُبرى إنَّا مُنتَقِمونَ} قال: يَعني يَومَ بَدرٍ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4774) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"y1W3eAC3"},{"id":"س-07713","fp":"3e5e71a80f0f","stateId":487,"easy":"إذا كفرت بالله وعاندت ← قد تنزل عليك صاعقة (من واقعة)","cause":"هذا الَّذي تَدعوني إليهِ من ذَهَبٍ أو فضَّه أو نحاسٍ","result":"وأرسلَ اللَّهُ تبارَكَ وتعالى صاعقةً منَ السَّماءِ فأَهْلَكَتهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"الصحيح المسند 91","srcLabel":"البيهقي","text":["أرسلَ رسولُ اللَّهِ - صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ - رجُلًا مِن أصحابِهِ إلى رأسِ المشرِكينَ يدعوهُ إلى اللَّهِ تعالى فقالَ المشرِكُ : ",["هذا الَّذي تَدعوني إليهِ من ذَهَبٍ أو فضَّه أو نحاسٍ",1]," فتَعاظمَ مقالتُهُ في صدرِ رسولِ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فرجعَ إلى رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ فأخبرَهُ فقالَ : ارجِع إليهِ فرجعَ إليهِ بمثلِ ذلِكَ ",["وأرسلَ اللَّهُ تبارَكَ وتعالى صاعقةً منَ السَّماءِ فأَهْلَكَتهُ",2]," ورسولُ رسولِ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ في الطريق فقال : لا يَدري فقالَ لَهُ النَّبيُّ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ : إنَّ اللَّهَ قد أَهْلَكَ صاحبَكَ بعدَكَ ونزلَت على رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ : وَيُرْسِلُ الصَّوَاعِقَ فَيُصِيبُ بِهَا مَنْ يَشَاءُ ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي عاصم في ((السنة)) (692) واللفظ له، والبيهقي في ((الأسماء والصفات)) (605)","bab":"قرآن › أسباب النزول","dorar":"QbK1MxlL","merged":2,"otherRefs":["مجمع الزوائد 7/45 (صحيح)"]},{"id":"س-04594","fp":"fd7912c31dd5","stateId":488,"easy":"إذا تُرك الشريف إذا سرق وأُقيم الحد على الضعيف ← فهو ما أهلك من قبلكم","cause":"إذا سَرَقَ فيهمِ الشَّريفُ تَرَكوه","result":"فإنَّما أهلَكَ الذينَ مِن قَبلِكُم","explicit":true,"star":true,"ref":"صحيح مسلم 1688","srcLabel":"البخاري","text":["أنَّ قُرَيشًا أهَمَّهُم شَأنُ المَرأةِ التي سَرَقَت في عَهدِ النَّبيِّ صلَّى اللهُ عليه وسلَّم في غَزوةِ الفَتحِ، فقالوا: مَن يُكَلِّمُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم؟ فقالوا: ومَن يَجتَرِئُ عليه إلَّا أُسامةُ بنُ زَيدٍ حِبُّ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأُتيَ بها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فكَلَّمَه فيها أُسامةُ بنُ زَيدٍ، فتَلَوَّنَ وجْهُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: أتَشفَعُ في حَدٍّ مِن حُدودِ اللهِ؟ فقال له أُسامةُ: استَغفِرْ لي يا رَسولَ اللهِ، فلَمَّا كان العَشيُّ قامَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فاختَطَبَ، فأثنى على اللهِ بما هو أهلُه، ثُمَّ قال: أمَّا بَعدُ، ",["فإنَّما أهلَكَ الذينَ مِن قَبلِكُم",2]," أنَّهُم كانوا ",["إذا سَرَقَ فيهمِ الشَّريفُ تَرَكوه",1],"، وإذا سَرَقَ فيهمِ الضَّعيفُ أقاموا عليه الحَدَّ، وإنِّي والذي نَفسي بيَدِه، لو أنَّ فاطِمةَ بنتَ مُحَمَّدٍ سَرَقَت لَقَطَعتُ يَدَها، ثُمَّ أمَرَ بتلك المَرأةِ التي سَرَقَت، فقُطِعَت يَدُها. قال يونُسُ: قال ابنُ شِهابٍ: قال عُروةُ: قالت عائِشةُ: فحَسُنَت تَوبَتُها بَعدُ وتَزَوَّجَت، وكانَت تَأتيني بَعدَ ذلك فأرفَعُ حاجَتَها إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6788)، وأبو داود (4373)، والترمذي (1430)، والنسائي (4901) جميعا باختلاف يسير.","bab":"حدود › حد السرقة ونصابها","dorar":"jtczzCMO","merged":7,"otherRefs":["تخريج مشكل الآثار 2301 (صحيح)","صحيح النسائي 4912 (صحيح)","صحيح النسائي 4915 (صحيح)","صحيح البخاري 6787 (صحيح)","صحيح النسائي 4910 (صحيح)","صحيح البخاري 3733 (صحيح)"]},{"id":"س-07720","fp":"edcfe5a3dec6","stateId":488,"easy":"إذا كثر سؤالكم واختلافكم على أنبيائكم ← فبذلك هلك من قبلكم","cause":"بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم","result":"فإنَّما هلَك الَّذينَ قبْلكم","explicit":true,"star":true,"similar":["س-03745"],"ref":"تخريج صحيح ابن حبان 3704","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم خطَب فقال ( يا أيُّها النَّاسُ إنَّ اللهَ قد افتَرض عليكم الحجَّ ) فقام رجلٌ فقال أكُلَّ عامٍ يا رسولَ اللهِ ؟ قال: فسكَت عنه حتَّى أعادها ثلاثَ مرَّاتٍ قال: ( لو قُلْتُ: نَعم، لوجَبَت، ولو وجَبَت ما قُمْتُم بها ذَرُوني ما تُرِكْتُم ",["فإنَّما هلَك الَّذينَ قبْلكم",2]," ",["بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم",1]," فإذا نهَيْتُكم عن شيءٍ فاجتنِبوه وإذا أمَرْتُكم بشيءٍ فأتوا منه ما استطَعْتُم ) وذكَر أنَّ هذه الآيةَ الَّتي في المائدةِ نزَلت في ذلك: {يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَسْأَلُوا عَنْ أَشْيَاءَ إِنْ تُبْدَ لَكُمْ تَسُؤْكُمْ} [المائدة: 101]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (3704) واللفظ له، والبخاري (7288) بنحوه، دون: يا أيها الناس، إن الله فرض عليكم الحج...، ومسلم (1337) بنحوه.","bab":"قرآن › أسباب النزول","dorar":"BinpXJ0i","merged":6,"otherRefs":["تخريج صحيح ابن حبان 3705 (صحيح)","صحيح مسلم 1337 (صحيح)","تخريج المسند لشعيب 10531 (صحيح)","صحيح النسائي 2618 (صحيح)","صحيح أسباب النزول 103 (صحيح)"]},{"id":"س-07776","fp":"f2bab9941355","stateId":488,"easy":"إذا اختلفتم في القراءة ← فإنما أهلك من قبلكم الاختلاف","cause":"اخْتَلَفْنا في قِراءتِنا","result":"إنَّما أهْلَكَ مَنْ كان قَبْلَكُم الاخْتِلافُ","explicit":true,"star":true,"similar":["س-07373"],"otherNeedIds":[20,39],"ref":"المستدرك على الصحيحين 2926","srcLabel":"البخاري","text":["نحوَهُ: [أَقْرأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سورةَ {حم}، ورُحتُ إلى المسجدِ عَشِيَّةً، فجَلَسَ إليَّ رَهْطٌ، فقلتُ لرجُلٍ مِنَ الرَّهْطِ: اقرأْ علَيَّ، فإذا هو يَقرأُ حروفًا لا أقْرؤها، فقلتُ له: مَنْ أقْرَأَكَها؟ قالَ: أَقْرأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ. فانطَلَقْنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وإذا عنده رجُلٌ فقلتُ: ",["اخْتَلَفْنا في قِراءتِنا",1],". وإذا وجْهُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ قد تغَيَّرَ، ووَجَدَ في نفْسِهِ، حين ذكَرْتُ له الاخْتِلافَ، فقالَ: «",["إنَّما أهْلَكَ مَنْ كان قَبْلَكُم الاخْتِلافُ",2],"». ثُمَّ أَسَرَّ إلى عَليٍّ، فقالَ عَليٌّ: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَأمُرُكم أنْ يَقرأَ علَيَّ كُلُّ رجُلٍ منكم كما عُلِّمَ، فانطَلَقْنا وكُلُّ رجُلٍ منَّا يَقرأُ حروفًا لا يَقرَؤها صاحِبُهُ.] قالَ فيه: فانطَلَقْنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وإذا عنده رجُلٌ، قالَ زِرٌّ: إنَّهم يَلْعَنونَهُ؛ يعني عليًّا."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي شيبة ((مسنده)) (318)، وابن حبان (747)، باختلاف يسير، والبخاري (3476) مختصرا","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"5eqj2f3K","merged":12,"otherRefs":["صحيح الترمذي 2133 (حسن)","تخريج المسند لشاكر 6/39 (صحيح)","مجمع الزوائد 7/202 (حسن)","تفسير الطبري 1/17 (صحيح)","تخريج كتاب السنة 133 (حسن)","صحيح مسلم 2666 (صحيح)","تخريج المسند لشعيب 4322 (صحيح)","صحيح البخاري 5062 (صحيح)","تخريج المسند لشاكر 6/169 (صحيح)","تفسير الطبري 1/16 (صحيح)","تخريج المسند لشاكر 5/306 (صحيح)"]},{"id":"س-07373","fp":"5deed491265e","stateId":488,"easy":"إذا اختلفتم ← فإن من قبلكم اختلفوا فهلكوا","cause":"لا تَختلِفوا","result":"فإنَّ مَن قبلَكم اختلَفوا فيه فهلَكوا","explicit":true,"repOf":"س-07776","otherNeedIds":[39],"ref":"تخريج المسند لشعيب 3908","text":["سَمِعتُ رَجُلًا يَقرَأُ آيةً على غيرِ ما أقرَأَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذتُ بيَدِه، فأتَيتُ به النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فقال: كِلاكما قد أحسَنَ، قال: وغَضِبَ حتى عُرِفَ الغَضبُ في وَجهِه، قال شُعبَةُ: أكبرُ ظنِّي أنَّه قال: ",["لا تَختلِفوا؛ ",1],["فإنَّ مَن قبلَكم اختلَفوا فيه فهلَكوا",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (2410)، والنسائي في ((السنن الكبرى)) (8095)، وأحمد (3908) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"ek6Ln4Bl","merged":4,"otherRefs":["صحيح البخاري 3476 (صحيح)","صحيح البخاري 2410 (صحيح)","تخريج المسند لشاكر 6/5 (صحيح)"]},{"id":"س-03647","fp":"356b2dfbab63","stateId":488,"easy":"إذا كثرت المسائل والاختلاف على الأنبياء ← فهو ما أهلك من كان قبلكم","cause":"كَثرةُ مَسائِلِهم، واختِلافُهم على أنبيائِهم","result":"فإنَّما أهلَكَ الذينَ مِن قَبلِكُم","explicit":true,"star":true,"ref":"صحيح مسلم 1337","srcLabel":"البخاري","text":["أنَّه سَمِعَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ما نَهَيتُكُم عنه فاجتَنِبوه، وما أمَرتُكُم به فافعَلوا منه ما استَطَعتُم؛ ",["فإنَّما أهلَكَ الذينَ مِن قَبلِكُم",2]," ",["كَثرةُ مَسائِلِهم، واختِلافُهم على أنبيائِهم",1],". [وفي روايةٍ]: ذَروني ما تَرَكتُكُم. وفي حَديثِ هَمَّامٍ: ما تُرِكتُم؛ فإنَّما هَلَكَ مَن كان قَبلَكُم، ثُمَّ ذَكَروا نَحوَ: حَديثِ الزُّهريِّ، عن سَعيدٍ وأبي سَلَمةَ، عن أبي هُرَيرةَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7288)، وابن ماجة (2)، وابن حبان (2106) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"5lb9a0SH","merged":2,"otherRefs":["مجمع الزوائد 1/163 (حسن)"]},{"id":"س-03745","fp":"01df8b719eec","stateId":488,"easy":"إذا أكثرت السؤال واختلفت على النبي ﷺ ← فبذلك هلك من كان قبلكم","cause":"ذَرُوني ما ترَكْتُكم","result":"فإنَّما هلَك مَن كان قبْلَكم بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم ما نهَيْتُكم عنه فانتَهوا وما أمَرْتُكم به فَأْتُوا منه ما استطَعْتُم","explicit":true,"repOf":"س-07720","ref":"تخريج صحيح ابن حبان 18","text":[["ذَرُوني ما ترَكْتُكم ",1],["فإنَّما هلَك مَن كان قبْلَكم بكثرةِ سؤالِهم واختلافِهم على أنبيائِهم ما نهَيْتُكم عنه فانتَهوا وما أمَرْتُكم به فَأْتُوا منه ما استطَعْتُم )",2]," قال ابنُ عَجْلانَ : فحدَّثْتُ به أَبَانَ بنَ صالحٍ فقال لي : ما أجودَ هذه الكلمةَ قولَه : ( فَأْتُوا منه ما استطَعْتُم )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله رجال الشيخين ما عدا إبراهيم بن بشار الرمادي، وهو حافظ ثقة","takhrij":"أخرجه ابن حبان (3705) واللفظ له، والبخاري (7288) بنحوه مختصرا، ومسلم (1337) باختلاف يسير.","bab":"اعتصام بالسنة › ما يكره من كثرة السؤال وتكلف ما لا يعنيه","dorar":"4HQ0o04A","merged":2,"otherRefs":["تخريج صحيح ابن حبان 2106 (صحيح)"]},{"id":"س-04371","fp":"27d31d690d9e","stateId":488,"easy":"إذا لم يغزُ أهل بيت ولم يجهزوا غازياً ولم يخلفوه ← يصيبهم الله بقارعة قبل يوم القيامة","cause":"ما مِن أهْلِ بَيْتٍ لم يَغْزُ فيهم غازٍ أو يُجَهِّزوا غازِيًا أو يَخلُفوه في أهْلِه","result":"إلَّا أصابَهم اللهُ عَزَّ وجَلَّ بقارِعةٍ قبَلْ يَوْمِ القِيامةِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 2666","srcLabel":"متفق عليه","text":["«",["ما مِن أهْلِ بَيْتٍ لم يَغْزُ فيهم غازٍ أو يُجَهِّزوا غازِيًا أو يَخلُفوه في أهْلِه،",1]," ",["إلَّا أصابَهم اللهُ عَزَّ وجَلَّ بقارِعةٍ قبَلْ يَوْمِ القِيامةِ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › الترغيب في الجهاد","dorar":"rt3tldB7"},{"id":"س-01557","fp":"63862224dc7c","stateId":488,"easy":"إذا شربت الأمة الخمر وأكلت الربا واتخذت القينات وقطعت الرحم ← يُمسخون خنازير","cause":"شُرْبَهم الخمْرَ، وأكْلَهم الرِّبا، ولُبْسَهم الحريرَ، واتِّخاذَهم القَيْناتِ، وقَطيعتَهم الرَّحِمَ","result":"فيُصبِحون قدْ مُسِخوا خَنازيرَ","explicit":true,"ref":"المستدرك على الصحيحين 8797","srcLabel":"مسلم","text":["يَبِيتُ قومٌ مِن هذه الأُمَّةِ على طَعامٍ وشَرابٍ ولَهْوٍ، ",["فيُصبِحون قدْ مُسِخوا خَنازيرَ",2],"، ولَيُخْسَفَنَّ بقَبائلَ فيها وفي دُورٍ فيها، حتَّى يُصبِحوا فيَقولُون: خُسِفَ اللَّيلةَ ببَني فُلانٍ، خُسِف اللَّيلةَ بدارِ بَني فُلانٍ، ولَيُرْسَلَنَّ عليهم حَصْباءُ حِجارةٍ كما أُرسِلَت على قَومِ لُوطٍ، على قَبائلَ فيها وعلى دُورٍ منها، ولَيُرْسَلَنَّ عليهم الرِّيحُ، قال: وإنَّ ",["شُرْبَهم الخمْرَ، وأكْلَهم الرِّبا، ولُبْسَهم الحريرَ، واتِّخاذَهم القَيْناتِ، وقَطيعتَهم الرَّحِمَ",1],"، قال: وذكَرَ خَصَلةً أُخرى، فنَسِيتُها."],"grade":"صحيح","narrator":"أبو  أمامة","muhaddith":"صحيح على شرط مسلم لجعفر، فأما فرقد فإنهما لم يخرجاه","takhrij":"أخرجه أبو داود الطيالسي في ((المسند)) (1233)، والخرائطي في ((مساوئ الأخلاق)) (271)، وأبو نعيم في ((حلية الأولياء)) (6/ 295) باختلاف يسير.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"DoNtKbmI","merged":2,"otherRefs":["تحريم آلات الطرب 67 (صحيح)"]},{"id":"س-04975","fp":"fcddd37341c9","stateId":488,"easy":"إذا نقض قوم العهد ← يكون القتل بينهم","cause":"ما نَقَضَ قومٌ العَهْدَ قَطُّ","result":"إلَّا كان القَتْلُ بيْنَهم","explicit":true,"ref":"المستدرك على الصحيحين 2613","srcLabel":"مسلم","text":[["ما نَقَضَ قومٌ العَهْدَ قَطُّ؛",1]," ",["إلَّا كان القَتْلُ بيْنَهم",2],"، ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ؛ إلَّا سَلَّطَ اللهُ عليهم الموتَ، ولا مَنَعَ قومٌ الزَّكاةَ؛ إلَّا حَبَسَ اللهُ عنهم القَطْرَ."],"grade":"صحيح","narrator":"[بريدة]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (4463)، والبيهقي (6469) كلاهما بلفظه، وابن المنذر في ((الأوسط)) (6692) ببعض لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"R29oTLvs"},{"id":"س-04976","fp":"7516b4918136","stateId":488,"easy":"إذا ظهرت الفاحشة في قوم ← يسلط الله عليهم الموت","cause":"ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ","result":"إلَّا سَلَّطَ اللهُ عليهم الموتَ","explicit":true,"similar":["س-06151","س-08253"],"ref":"المستدرك على الصحيحين 2613","srcLabel":"مسلم","text":["ما نَقَضَ قومٌ العَهْدَ قَطُّ؛ إلَّا كان القَتْلُ بيْنَهم، ",["ولا ظَهَرَتِ الفاحشةُ في قومٍ قَطُّ",1],"؛ ",["إلَّا سَلَّطَ اللهُ عليهم الموتَ",2],"، ولا مَنَعَ قومٌ الزَّكاةَ؛ إلَّا حَبَسَ اللهُ عنهم القَطْرَ."],"grade":"صحيح","narrator":"[بريدة]","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البزار (4463)، والبيهقي (6469) كلاهما بلفظه، وابن المنذر في ((الأوسط)) (6692) ببعض لفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"R29oTLvs"},{"id":"س-05220","fp":"e35b74ab4177","stateId":488,"easy":"إذا خذفت (رميت الحصى بين الأصابع) ← قد تكسر السن وتفقأ العين","cause":"يَخذِفُ","result":"قد تَكسِرُ السِّنَّ، وتَفقَأُ العَينَ","explicit":true,"ref":"صحيح البخاري 5479","srcLabel":"مسلم","text":["أنَّه رَأى رَجُلًا ",["يَخذِفُ",1],"، فقال له: لا تَخذِفْ؛ فإنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم نَهى عَنِ الخَذفِ -أو كان يَكرَهُ الخَذفَ- وقال: إنَّه لا يُصادُ به صَيدٌ ولا يُنكى به عَدوٌّ، ولَكِنَّها ",["قد تَكسِرُ السِّنَّ، وتَفقَأُ العَينَ",2],". ثُمَّ رَآهُ بَعدَ ذلك يَخذِفُ، فقال له: أُحَدِّثُكَ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه نَهى عَنِ الخَذفِ -أو كَرِهَ الخَذفَ- وأنتَ تَخذِفُ! لا أُكَلِّمُكَ كَذا وكَذا."],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1954)، وابن ماجة (3226)، وابن حبان (5949) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1pzELIPm"},{"id":"س-07780","fp":"db9fd6099c54","stateId":488,"easy":"إذا اختلفتم على أنبيائكم وضربتم الكتاب بعضه ببعض ← فبهذا أُهلكت الأمم قبلكم","cause":"باختِلافِهم على أنبيائِهم، وضَربِهمُ الكُتُبَ بَعضَها ببَعضٍ","result":"بهذا أُهلِكَتِ الأُمُمَ مِن قَبلِكُم","explicit":true,"otherNeedIds":[19,20],"ref":"تخريج شرح الطحاوية 168","srcLabel":"أحمد","text":["«لَقد جَلَستُ أنا وأخي مَجلسًا ما أحِبُّ أنَّ لي به حُمْرَ النَّعَمِ، أقبَلتُ أنا وأخي، وإذا مَشيَخةٌ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم جُلوسٌ عِندَ بابٍ مِن أبوابِه، فكَرِهنا أن نُفرِّقَ بَينَهم، فجَلَسنا حُجرةً، إذ ذَكَروا آيةً مِنَ القُرآنِ، فتَمارَوا فيها، حَتَّى ارتَفعَت أصواتُهم، فخَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مُغضَبًا، قدِ احمَرَّ وجهُه، يَرميهم بالتُّرابِ، ويَقولُ: مَهلًا يا قَومِ! ",["بهذا أُهلِكَتِ الأُمُمَ مِن قَبلِكُم",2],"؛ ",["باختِلافِهم على أنبيائِهم، وضَربِهمُ الكُتُبَ بَعضَها ببَعضٍ",1],"، إنَّ القُرآنَ لَم يَنزِلْ يُكَذِّبُ بَعضُه بَعضًا، بَل يُصَدِّقُ بَعضُه بَعضًا، فما عَرَفتُم مِنه فاعمَلوا به، وما جَهِلتُم مِنه فرُدُّوه إلى عالِمِه»"],"grade":"صحيح","narrator":"جد عمرو بن شعيب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (6702)، وابن أبي أسامة في ((مسند الحارث)) (735) واللفظ لهما.","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"zaO2NpcS","merged":7,"otherRefs":["اقتضاء الصراط المستقيم 1/163 (صحيح)","صحيح الجامع 1322 (صحيح)","مجموع الفتاوى 24/171 (صحيح)","تخريج المسند لشاكر 11/26 (صحيح)","تخريج سير أعلام النبلاء 16/ 241 (حسن)","تخريج سير أعلام النبلاء 3/78 (حسن)"]},{"id":"س-08077","fp":"44b42450f025","stateId":488,"easy":"إذا لم يُؤخذ للضعيف من القوي ← فكيف يقدّس الله قوماً","cause":"لا يُؤخَذُ لضعيفِهم مِن شديدِهم","result":"كيف يُقدِّسُ اللهُ قومًا","explicit":true,"otherNeedIds":[27],"ref":"صحيح ابن حبان 5058","srcLabel":"ابن ماجه","text":["لمَّا رجَعتْ مُهاجِرةُ الحبشةِ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم قال: ( ألَا تُحدِّثوني بأعجَبِ ما رأَيْتُم بأرضِ الحبشةِ ؟ ) قال فتيةٌ منهم: يا رسولَ اللهِ بينما نحنُ جلوسٌ مرَّت علينا عجوزٌ مِن عجائزِهم تحمِلُ على رأسِها قُلَّةً مِن ماءٍ فمرَّت بفتًى منهم فجعَل إحدى يدَيْه بيْنَ كتِفَيْها ثمَّ دفَعها على رُكبتَيْها فانكسَرتْ قُلَّتُها فلمَّا ارتفعَتِ التفتَت إليه ثمَّ قالت: ستعلَمُ يا غُدَرُ إذا وضَع اللهُ الكُرسيَّ وجمَع الأوَّلينَ والآخِرينَ وتكلَّمتِ الأيدي والأرجُلُ بما كانا يكسِبونَ فسوف تعلَمُ أمري وأمرَك عندَه غدًا فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( صدَقتْ ثمَّ صدَقتْ ",["كيف يُقدِّسُ اللهُ قومًا",2]," ",["لا يُؤخَذُ لضعيفِهم مِن شديدِهم",1]," )"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن ماجه (4010)، وابن أبي الدنيا في ((الأهوال)) (243)، وأبو يعلى (2003) واللفظ لهم جميعا.","bab":"مظالم › قصاص المظالم","dorar":"nMT6V3cy","merged":10,"otherRefs":["صحيح الجامع 1858 (صحيح)","مجمع الزوائد 4/143 (صحيح)","صحيح الترغيب 2191 (صحيح)","تخريج كتاب السنة 582 (صحيح)","هداية الرواة 2937 (صحيح)","مجمع الزوائد 5/212 (حسن)","صحيح الترغيب 1816 (صحيح)","مجمع الزوائد 4/200 (حسن)","صحيح الجامع 1857 (صحيح)"]},{"id":"ق-0017","fp":"9d6c5c1c5516","stateId":488,"easy":"تبديل أمر الله والفسق ← رجز من السماء","cause":"تبديل أمر الله والفسق","result":"رجز من السماء","explicit":true,"similar":["ق-0944"],"ref":"سورة البقرة: 59","srcLabel":"القرآن الكريم","quran":{"s":2,"from":59,"to":59,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَنْزَلْنَا عَلَى الَّذِينَ ظَلَمُوا رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ (59)","hl":[[0,153,1]]}},{"id":"ق-0021","fp":"8455dff62476","stateId":488,"easy":"الاعتداء على حدود الله بالحيلة (السبت) ← المسخ قردة خاسئين","cause":"الاعتداء على حدود الله بالحيلة (السبت)","result":"المسخ قردة خاسئين","explicit":true,"ref":"سورة البقرة: 65","srcLabel":"القرآن الكريم","quran":{"s":2,"from":65,"to":65,"text":"وَلَقَدْ عَلِمْتُمُ الَّذِينَ اعْتَدَوْا مِنْكُمْ فِي السَّبْتِ فَقُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ (65)","hl":[[0,108,1]]}},{"id":"ق-0079","fp":"d7378ee8a057","stateId":488,"easy":"تبديل نعمة الله كفراً ← شدة العقاب","cause":"تبديل نعمة الله كفراً","result":"شدة العقاب","explicit":true,"ref":"سورة البقرة: 211","srcLabel":"القرآن الكريم","quran":{"s":2,"from":211,"to":211,"text":"سَلْ بَنِي إِسْرَائِيلَ كَمْ آتَيْنَاهُمْ مِنْ آيَةٍ بَيِّنَةٍ وَمَنْ يُبَدِّلْ نِعْمَةَ اللَّهِ مِنْ بَعْدِ مَا جَاءَتْهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (211)","hl":[[63,157,1]]}},{"id":"ق-0274","fp":"e56f85eb080c","stateId":488,"easy":"سؤال رؤية الله جهرة (ظلم) ← الصاعقة","cause":"سؤال رؤية الله جهرة (ظلم)","result":"الصاعقة","explicit":true,"ref":"سورة النساء: 153","srcLabel":"القرآن الكريم","quran":{"s":4,"from":153,"to":153,"text":"يَسْأَلُكَ أَهْلُ الْكِتَابِ أَنْ تُنَزِّلَ عَلَيْهِمْ كِتَابًا مِنَ السَّمَاءِ فَقَدْ سَأَلُوا مُوسَى أَكْبَرَ مِنْ ذَلِكَ فَقَالُوا أَرِنَا اللَّهَ جَهْرَةً فَأَخَذَتْهُمُ الصَّاعِقَةُ بِظُلْمِهِمْ ثُمَّ اتَّخَذُوا الْعِجْلَ مِنْ بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ فَعَفَوْنَا عَنْ ذَلِكَ وَآتَيْنَا مُوسَى سُلْطَانًا مُبِينًا (153)","hl":[[159,199,1]]}},{"id":"ق-0296","fp":"005a03f49c29","stateId":488,"easy":"النكول عن أمر الله والجبن عن الجهاد ← التيه أربعين سنة والحرمان","cause":"النكول عن أمر الله والجبن عن الجهاد","result":"التيه أربعين سنة والحرمان","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"سورة المائدة: 24–26","srcLabel":"القرآن الكريم","quran":{"s":5,"from":24,"to":26,"text":"قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ (24) قَالَ رَبِّ إِنِّي لَا أَمْلِكُ إِلَّا نَفْسِي وَأَخِي فَافْرُقْ بَيْنَنَا وَبَيْنَ الْقَوْمِ الْفَاسِقِينَ (25) قَالَ فَإِنَّهَا مُحَرَّمَةٌ عَلَيْهِمْ أَرْبَعِينَ سَنَةً يَتِيهُونَ فِي الْأَرْضِ فَلَا تَأْسَ عَلَى الْقَوْمِ الْفَاسِقِينَ (26)","hl":[[0,247,1]]}},{"id":"ق-0338","fp":"37b7aa1a9fd7","stateId":488,"easy":"العود إلى المعصية بعد العفو ← انتقام الله","cause":"العود إلى المعصية بعد العفو","result":"انتقام الله","explicit":true,"ref":"سورة المائدة: 95","srcLabel":"القرآن الكريم","quran":{"s":5,"from":95,"to":95,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقْتُلُوا الصَّيْدَ وَأَنْتُمْ حُرُمٌ وَمَنْ قَتَلَهُ مِنْكُمْ مُتَعَمِّدًا فَجَزَاءٌ مِثْلُ مَا قَتَلَ مِنَ النَّعَمِ يَحْكُمُ بِهِ ذَوَا عَدْلٍ مِنْكُمْ هَدْيًا بَالِغَ الْكَعْبَةِ أَوْ كَفَّارَةٌ طَعَامُ مَسَاكِينَ أَوْ عَدْلُ ذَلِكَ صِيَامًا لِيَذُوقَ وَبَالَ أَمْرِهِ عَفَا اللَّهُ عَمَّا سَلَفَ وَمَنْ عَادَ فَيَنْتَقِمُ اللَّهُ مِنْهُ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ (95)","hl":[[337,377,1]]}},{"id":"ق-0355","fp":"524772bf069e","stateId":488,"easy":"الظلم ← الهلاك","cause":"الظلم","result":"الهلاك","explicit":true,"similar":["ق-0391"],"ref":"سورة الأنعام: 47","srcLabel":"القرآن الكريم","quran":{"s":6,"from":47,"to":47,"text":"قُلْ أَرَأَيْتَكُمْ إِنْ أَتَاكُمْ عَذَابُ اللَّهِ بَغْتَةً أَوْ جَهْرَةً هَلْ يُهْلَكُ إِلَّا الْقَوْمُ الظَّالِمُونَ (47)","hl":[[74,118,1]]}},{"id":"ق-0384","fp":"a6046745a1e2","stateId":488,"easy":"الإجرام ← لا يُردّ بأس الله عنهم","cause":"الإجرام","result":"لا يُردّ بأس الله عنهم","explicit":true,"similar":["ق-0617"],"ref":"سورة الأنعام: 147","srcLabel":"القرآن الكريم","quran":{"s":6,"from":147,"to":147,"text":"فَإِنْ كَذَّبُوكَ فَقُلْ رَبُّكُمْ ذُو رَحْمَةٍ وَاسِعَةٍ وَلَا يُرَدُّ بَأْسُهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ (147)","hl":[[58,110,1]]}},{"id":"ق-0391","fp":"670fdddc2444","stateId":488,"easy":"الظلم ← الهلاك بياتاً أو قائلين","cause":"الظلم","result":"الهلاك بياتاً أو قائلين","explicit":true,"repOf":"ق-0355","ref":"سورة الأعراف: 4–5","quran":{"s":7,"from":4,"to":5,"text":"وَكَمْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا فَجَاءَهَا بَأْسُنَا بَيَاتًا أَوْ هُمْ قَائِلُونَ (4) فَمَا كَانَ دَعْوَاهُمْ إِذْ جَاءَهُمْ بَأْسُنَا إِلَّا أَنْ قَالُوا إِنَّا كُنَّا ظَالِمِينَ (5)","hl":[[0,184,1]]}},{"id":"ق-0434","fp":"e279e3533ff7","stateId":488,"easy":"تبديل القول ظلماً ← رجز من السماء","cause":"تبديل القول ظلماً","result":"رجز من السماء","explicit":true,"ref":"سورة الأعراف: 162","srcLabel":"القرآن الكريم","quran":{"s":7,"from":162,"to":162,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا مِنْهُمْ قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَظْلِمُونَ (162)","hl":[[0,148,1]]}},{"id":"ق-0435","fp":"2a9a1afa540e","stateId":488,"easy":"الفسق ← شدة الابتلاء","cause":"الفسق","result":"شدة الابتلاء","explicit":true,"ref":"سورة الأعراف: 163","srcLabel":"القرآن الكريم","quran":{"s":7,"from":163,"to":163,"text":"وَاسْأَلْهُمْ عَنِ الْقَرْيَةِ الَّتِي كَانَتْ حَاضِرَةَ الْبَحْرِ إِذْ يَعْدُونَ فِي السَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَ لَا تَأْتِيهِمْ كَذَلِكَ نَبْلُوهُمْ بِمَا كَانُوا يَفْسُقُونَ (163)","hl":[[194,240,1]]}},{"id":"ق-0437","fp":"7d5a4e43d289","stateId":488,"easy":"الظلم والفسق والعتوّ عمّا نُهوا عنه ← عذاب بئيس والمسخ قردة","cause":"الظلم والفسق والعتوّ عمّا نُهوا عنه","result":"عذاب بئيس والمسخ قردة","explicit":true,"ref":"سورة الأعراف: 165–166","srcLabel":"القرآن الكريم","quran":{"s":7,"from":165,"to":166,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ أَنْجَيْنَا الَّذِينَ يَنْهَوْنَ عَنِ السُّوءِ وَأَخَذْنَا الَّذِينَ ظَلَمُوا بِعَذَابٍ بَئِيسٍ بِمَا كَانُوا يَفْسُقُونَ (165) فَلَمَّا عَتَوْا عَنْ مَا نُهُوا عَنْهُ قُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ (166)","hl":[[82,245,1]]}},{"id":"ق-0452","fp":"cf6a17acd528","stateId":488,"easy":"مشاقّة الله ورسوله ← شدة العقاب","cause":"مشاقّة الله ورسوله","result":"شدة العقاب","explicit":true,"otherNeedIds":[57],"ref":"سورة الأنفال: 13","srcLabel":"القرآن الكريم","quran":{"s":8,"from":13,"to":13,"text":"ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِقِ اللَّهَ وَرَسُولَهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (13)","hl":[[48,119,1]]}},{"id":"ق-0464","fp":"3e0f411f2c91","stateId":488,"easy":"العود إلى الكفر والعدوان ← مضيّ سنة الأولين فيهم","cause":"العود إلى الكفر والعدوان","result":"مضيّ سنة الأولين فيهم","explicit":true,"ref":"سورة الأنفال: 38","srcLabel":"القرآن الكريم","quran":{"s":8,"from":38,"to":38,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ (38)","hl":[[73,125,1]]}},{"id":"ق-0504","fp":"a5c62bb6d75f","stateId":488,"easy":"النفاق ← التعذيب بالأموال والأولاد في الحياة الدنيا","cause":"النفاق","result":"التعذيب بالأموال والأولاد في الحياة الدنيا","explicit":true,"otherNeedIds":[3],"ref":"سورة التوبة: 55","srcLabel":"القرآن الكريم","quran":{"s":9,"from":55,"to":55,"text":"فَلَا تُعْجِبْكَ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ إِنَّمَا يُرِيدُ اللَّهُ لِيُعَذِّبَهُمْ بِهَا فِي الْحَيَاةِ الدُّنْيَا وَتَزْهَقَ أَنْفُسُهُمْ وَهُمْ كَافِرُونَ (55)","hl":[[0,165,1]]}},{"id":"ق-0524","fp":"dc14bb7cd854","stateId":488,"easy":"عدّ النفقة مغرماً والتربص بالمؤمنين ← دائرة السوء عليهم","cause":"عدّ النفقة مغرماً والتربص بالمؤمنين","result":"دائرة السوء عليهم","explicit":true,"ref":"سورة التوبة: 98","srcLabel":"القرآن الكريم","quran":{"s":9,"from":98,"to":98,"text":"وَمِنَ الْأَعْرَابِ مَنْ يَتَّخِذُ مَا يُنْفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ الدَّوَائِرَ عَلَيْهِمْ دَائِرَةُ السَّوْءِ وَاللَّهُ سَمِيعٌ عَلِيمٌ (98)","hl":[[0,122,1]]}},{"id":"ق-0551","fp":"956c378ba5c4","stateId":488,"easy":"المكر في آيات الله بعد الرحمة ← مكر الله أسرع","cause":"المكر في آيات الله بعد الرحمة","result":"مكر الله أسرع","explicit":true,"ref":"سورة يونس: 21","srcLabel":"القرآن الكريم","quran":{"s":10,"from":21,"to":21,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُمْ إِذَا لَهُمْ مَكْرٌ فِي آيَاتِنَا قُلِ اللَّهُ أَسْرَعُ مَكْرًا إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ (21)","hl":[[0,176,1]]}},{"id":"ق-0552","fp":"389f527db14a","stateId":488,"easy":"البغي في الأرض بغير الحق بعد النجاة ← البغي على النفس","cause":"البغي في الأرض بغير الحق بعد النجاة","result":"البغي على النفس","explicit":true,"ref":"سورة يونس: 23","srcLabel":"القرآن الكريم","quran":{"s":10,"from":23,"to":23,"text":"فَلَمَّا أَنْجَاهُمْ إِذَا هُمْ يَبْغُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ يَا أَيُّهَا النَّاسُ إِنَّمَا بَغْيُكُمْ عَلَى أَنْفُسِكُمْ مَتَاعَ الْحَيَاةِ الدُّنْيَا ثُمَّ إِلَيْنَا مَرْجِعُكُمْ فَنُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ (23)","hl":[[0,134,1]]}},{"id":"ق-0589","fp":"7f17233b13df","stateId":488,"easy":"الظلم ← الصيحة","cause":"الظلم","result":"الصيحة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0596"],"ref":"سورة هود: 67","srcLabel":"القرآن الكريم","quran":{"s":11,"from":67,"to":67,"text":"وَأَخَذَ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ (67)","hl":[[0,79,1]]}},{"id":"ق-0596","fp":"48f0898c1226","stateId":488,"easy":"الظلم ← الصيحة","cause":"الظلم","result":"الصيحة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0589","ref":"سورة هود: 94","quran":{"s":11,"from":94,"to":94,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا شُعَيْبًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَأَخَذَتِ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ (94)","hl":[[91,172,1]]}},{"id":"ق-0597","fp":"d5f3008600b7","stateId":488,"easy":"ظلم القرى ← الأخذ الأليم الشديد","cause":"ظلم القرى","result":"الأخذ الأليم الشديد","explicit":true,"ref":"سورة هود: 102","srcLabel":"القرآن الكريم","quran":{"s":11,"from":102,"to":102,"text":"وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ (102)","hl":[[0,95,1]]}},{"id":"ق-0602","fp":"374f21632298","stateId":488,"easy":"اتباع الترف ← الإجرام والهلاك","cause":"اتباع الترف","result":"الإجرام والهلاك","explicit":true,"ref":"سورة هود: 116","srcLabel":"القرآن الكريم","quran":{"s":11,"from":116,"to":116,"text":"فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُو بَقِيَّةٍ يَنْهَوْنَ عَنِ الْفَسَادِ فِي الْأَرْضِ إِلَّا قَلِيلًا مِمَّنْ أَنْجَيْنَا مِنْهُمْ وَاتَّبَعَ الَّذِينَ ظَلَمُوا مَا أُتْرِفُوا فِيهِ وَكَانُوا مُجْرِمِينَ (116)","hl":[[151,223,1]]}},{"id":"ق-0617","fp":"ef6d35b6bed2","stateId":488,"easy":"الإجرام ← لا يُردّ بأس الله عنهم","cause":"الإجرام","result":"لا يُردّ بأس الله عنهم","explicit":true,"repOf":"ق-0384","ref":"سورة يوسف: 110","quran":{"s":12,"from":110,"to":110,"text":"حَتَّى إِذَا اسْتَيْأَسَ الرُّسُلُ وَظَنُّوا أَنَّهُمْ قَدْ كُذِبُوا جَاءَهُمْ نَصْرُنَا فَنُجِّيَ مَنْ نَشَاءُ وَلَا يُرَدُّ بَأْسُنَا عَنِ الْقَوْمِ الْمُجْرِمِينَ (110)","hl":[[112,165,1]]}},{"id":"ق-0630","fp":"7e02a7cfb5f4","stateId":488,"easy":"الكفر وسوء الصنيع ← قوارع تصيبهم أو تحلّ قريباً من دارهم","cause":"الكفر وسوء الصنيع","result":"قوارع تصيبهم أو تحلّ قريباً من دارهم","explicit":true,"ref":"سورة الرعد: 31","srcLabel":"القرآن الكريم","quran":{"s":13,"from":31,"to":31,"text":"وَلَوْ أَنَّ قُرْآنًا سُيِّرَتْ بِهِ الْجِبَالُ أَوْ قُطِّعَتْ بِهِ الْأَرْضُ أَوْ كُلِّمَ بِهِ الْمَوْتَى بَلْ لِلَّهِ الْأَمْرُ جَمِيعًا أَفَلَمْ يَيْأَسِ الَّذِينَ آمَنُوا أَنْ لَوْ يَشَاءُ اللَّهُ لَهَدَى النَّاسَ جَمِيعًا وَلَا يَزَالُ الَّذِينَ كَفَرُوا تُصِيبُهُمْ بِمَا صَنَعُوا قَارِعَةٌ أَوْ تَحُلُّ قَرِيبًا مِنْ دَارِهِمْ حَتَّى يَأْتِيَ وَعْدُ اللَّهِ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ (31)","hl":[[227,333,1]]}},{"id":"ق-0665","fp":"d4a72dcf3edb","stateId":488,"easy":"المكر ← إتيان البنيان من القواعد وسقوط السقف والعذاب من حيث لا يشعرون","cause":"المكر","result":"إتيان البنيان من القواعد وسقوط السقف والعذاب من حيث لا يشعرون","explicit":true,"ref":"سورة النحل: 26","srcLabel":"القرآن الكريم","quran":{"s":16,"from":26,"to":26,"text":"قَدْ مَكَرَ الَّذِينَ مِنْ قَبْلِهِمْ فَأَتَى اللَّهُ بُنْيَانَهُمْ مِنَ الْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ السَّقْفُ مِنْ فَوْقِهِمْ وَأَتَاهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (26)","hl":[[0,181,1]]}},{"id":"ق-0670","fp":"b387494f7252","stateId":488,"easy":"الظلم والاستهزاء بالحق ← إصابة سيئات ما عملوا وحاق بهم ما استهزؤوا به","cause":"الظلم والاستهزاء بالحق","result":"إصابة سيئات ما عملوا وحاق بهم ما استهزؤوا به","explicit":true,"ref":"سورة النحل: 33–34","srcLabel":"القرآن الكريم","quran":{"s":16,"from":33,"to":34,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ أَوْ يَأْتِيَ أَمْرُ رَبِّكَ كَذَلِكَ فَعَلَ الَّذِينَ مِنْ قَبْلِهِمْ وَمَا ظَلَمَهُمُ اللَّهُ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ (33) فَأَصَابَهُمْ سَيِّئَاتُ مَا عَمِلُوا وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (34)","hl":[[86,285,1]]}},{"id":"ق-0673","fp":"8a7d61bc26bf","stateId":488,"easy":"مكر السيئات ← الخسف أو العذاب من حيث لا يشعرون أو الأخذ في التقلب","cause":"مكر السيئات","result":"الخسف أو العذاب من حيث لا يشعرون أو الأخذ في التقلب","explicit":true,"ref":"سورة النحل: 45–47","srcLabel":"القرآن الكريم","quran":{"s":16,"from":45,"to":47,"text":"أَفَأَمِنَ الَّذِينَ مَكَرُوا السَّيِّئَاتِ أَنْ يَخْسِفَ اللَّهُ بِهِمُ الْأَرْضَ أَوْ يَأْتِيَهُمُ الْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ (45) أَوْ يَأْخُذَهُمْ فِي تَقَلُّبِهِمْ فَمَا هُمْ بِمُعْجِزِينَ (46) أَوْ يَأْخُذَهُمْ عَلَى تَخَوُّفٍ فَإِنَّ رَبَّكُمْ لَرَءُوفٌ رَحِيمٌ (47)","hl":[[0,280,1]]}},{"id":"ق-0695","fp":"33e3a821cc54","stateId":488,"easy":"العود إلى الإفساد ← عود العقوبة","cause":"العود إلى الإفساد","result":"عود العقوبة","explicit":true,"ref":"سورة الإسراء: 8","srcLabel":"القرآن الكريم","quran":{"s":17,"from":8,"to":8,"text":"عَسَى رَبُّكُمْ أَنْ يَرْحَمَكُمْ وَإِنْ عُدْتُمْ عُدْنَا وَجَعَلْنَا جَهَنَّمَ لِلْكَافِرِينَ حَصِيرًا (8)","hl":[[34,57,1]]}},{"id":"ق-0700","fp":"78db36aa5f97","stateId":488,"easy":"فسق المترفين ← حقّ القول وتدمير القرية","cause":"فسق المترفين","result":"حقّ القول وتدمير القرية","explicit":true,"ref":"سورة الإسراء: 16","srcLabel":"القرآن الكريم","quran":{"s":17,"from":16,"to":16,"text":"وَإِذَا أَرَدْنَا أَنْ نُهْلِكَ قَرْيَةً أَمَرْنَا مُتْرَفِيهَا فَفَسَقُوا فِيهَا فَحَقَّ عَلَيْهَا الْقَوْلُ فَدَمَّرْنَاهَا تَدْمِيرًا (16)","hl":[[0,136,1]]}},{"id":"ق-0714","fp":"665aed71bb19","stateId":488,"easy":"الإعراض وكفران النجاة ← الخسف أو الحاصب أو الإغراق","cause":"الإعراض وكفران النجاة","result":"الخسف أو الحاصب أو الإغراق","explicit":true,"ref":"سورة الإسراء: 67–69","srcLabel":"القرآن الكريم","quran":{"s":17,"from":67,"to":69,"text":"وَإِذَا مَسَّكُمُ الضُّرُّ فِي الْبَحْرِ ضَلَّ مَنْ تَدْعُونَ إِلَّا إِيَّاهُ فَلَمَّا نَجَّاكُمْ إِلَى الْبَرِّ أَعْرَضْتُمْ وَكَانَ الْإِنْسَانُ كَفُورًا (67) أَفَأَمِنْتُمْ أَنْ يَخْسِفَ بِكُمْ جَانِبَ الْبَرِّ أَوْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا ثُمَّ لَا تَجِدُوا لَكُمْ وَكِيلًا (68) أَمْ أَمِنْتُمْ أَنْ يُعِيدَكُمْ فِيهِ تَارَةً أُخْرَى فَيُرْسِلَ عَلَيْكُمْ قَاصِفًا مِنَ الرِّيحِ فَيُغْرِقَكُمْ بِمَا كَفَرْتُمْ ثُمَّ لَا تَجِدُوا لَكُمْ عَلَيْنَا بِهِ تَبِيعًا (69)","hl":[[78,469,1]]}},{"id":"ق-0735","fp":"a3b5eb8a6c1e","stateId":488,"easy":"الظلم ← إهلاك القرى بموعد","cause":"الظلم","result":"إهلاك القرى بموعد","explicit":true,"similar":["ق-0819","ق-0923"],"ref":"سورة الكهف: 59","srcLabel":"القرآن الكريم","quran":{"s":18,"from":59,"to":59,"text":"وَتِلْكَ الْقُرَى أَهْلَكْنَاهُمْ لَمَّا ظَلَمُوا وَجَعَلْنَا لِمَهْلِكِهِمْ مَوْعِدًا (59)","hl":[[0,86,1]]}},{"id":"ق-0785","fp":"45ea78e04b55","stateId":488,"easy":"الظلم ← قصم القرى وجعلها حصيداً خامدين","cause":"الظلم","result":"قصم القرى وجعلها حصيداً خامدين","explicit":true,"ref":"سورة الأنبياء: 11–15","srcLabel":"القرآن الكريم","quran":{"s":21,"from":11,"to":15,"text":"وَكَمْ قَصَمْنَا مِنْ قَرْيَةٍ كَانَتْ ظَالِمَةً وَأَنْشَأْنَا بَعْدَهَا قَوْمًا آخَرِينَ (11) فَلَمَّا أَحَسُّوا بَأْسَنَا إِذَا هُمْ مِنْهَا يَرْكُضُونَ (12) لَا تَرْكُضُوا وَارْجِعُوا إِلَى مَا أُتْرِفْتُمْ فِيهِ وَمَسَاكِنِكُمْ لَعَلَّكُمْ تُسْأَلُونَ (13) قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ (14) فَمَا زَالَتْ تِلْكَ دَعْوَاهُمْ حَتَّى جَعَلْنَاهُمْ حَصِيدًا خَامِدِينَ (15)","hl":[[0,386,1]]}},{"id":"ق-0819","fp":"6f0d36a4a8ac","stateId":488,"easy":"الظلم ← إهلاك القرى وخواء العروش","cause":"الظلم","result":"إهلاك القرى وخواء العروش","explicit":true,"repOf":"ق-0735","ref":"سورة الحج: 45","quran":{"s":22,"from":45,"to":45,"text":"فَكَأَيِّنْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا وَهِيَ ظَالِمَةٌ فَهِيَ خَاوِيَةٌ عَلَى عُرُوشِهَا وَبِئْرٍ مُعَطَّلَةٍ وَقَصْرٍ مَشِيدٍ (45)","hl":[[0,129,1]]}},{"id":"ق-0870","fp":"4a7747feb02a","stateId":488,"easy":"مخالفة أمر الرسول ﷺ ← فتنة أو عذاب أليم","cause":"مخالفة أمر الرسول ﷺ","result":"فتنة أو عذاب أليم","explicit":true,"otherNeedIds":[57,19],"ref":"سورة النور: 63","srcLabel":"القرآن الكريم","quran":{"s":24,"from":63,"to":63,"text":"لَا تَجْعَلُوا دُعَاءَ الرَّسُولِ بَيْنَكُمْ كَدُعَاءِ بَعْضِكُمْ بَعْضًا قَدْ يَعْلَمُ اللَّهُ الَّذِينَ يَتَسَلَّلُونَ مِنْكُمْ لِوَاذًا فَلْيَحْذَرِ الَّذِينَ يُخَالِفُونَ عَنْ أَمْرِهِ أَنْ تُصِيبَهُمْ فِتْنَةٌ أَوْ يُصِيبَهُمْ عَذَابٌ أَلِيمٌ (63)","hl":[[139,247,1]]}},{"id":"ق-0900","fp":"62281f380feb","stateId":488,"easy":"جحود الآيات ظلماً وعلواً ← عاقبة المفسدين","cause":"جحود الآيات ظلماً وعلواً","result":"عاقبة المفسدين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة النمل: 14","srcLabel":"القرآن الكريم","quran":{"s":27,"from":14,"to":14,"text":"وَجَحَدُوا بِهَا وَاسْتَيْقَنَتْهَا أَنْفُسُهُمْ ظُلْمًا وَعُلُوًّا فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ (14)","hl":[[0,115,1]]}},{"id":"ق-0903","fp":"3257a4ce2cf5","stateId":488,"easy":"المكر والإفساد في الأرض ← تدميرهم وقومهم أجمعين وخواء البيوت بما ظلموا","cause":"المكر والإفساد في الأرض","result":"تدميرهم وقومهم أجمعين وخواء البيوت بما ظلموا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة النمل: 50–52","srcLabel":"القرآن الكريم","quran":{"s":27,"from":50,"to":52,"text":"وَمَكَرُوا مَكْرًا وَمَكَرْنَا مَكْرًا وَهُمْ لَا يَشْعُرُونَ (50) فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ مَكْرِهِمْ أَنَّا دَمَّرْنَاهُمْ وَقَوْمَهُمْ أَجْمَعِينَ (51) فَتِلْكَ بُيُوتُهُمْ خَاوِيَةً بِمَا ظَلَمُوا إِنَّ فِي ذَلِكَ لَآيَةً لِقَوْمٍ يَعْلَمُونَ (52)","hl":[[0,208,1]]}},{"id":"ق-0906","fp":"1addddcbf3a1","stateId":488,"easy":"الإجرام ← سوء العاقبة","cause":"الإجرام","result":"سوء العاقبة","explicit":true,"ref":"سورة النمل: 69","srcLabel":"القرآن الكريم","quran":{"s":27,"from":69,"to":69,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُجْرِمِينَ (69)","hl":[[0,76,1]]}},{"id":"ق-0911","fp":"8a21fe75694d","stateId":488,"easy":"العلوّ في الأرض وتفريق الناس واستضعافهم والإفساد ← الهلاك (عاقبة المفسدين)","cause":"العلوّ في الأرض وتفريق الناس واستضعافهم والإفساد","result":"الهلاك (عاقبة المفسدين)","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة القصص: 4","srcLabel":"القرآن الكريم","quran":{"s":28,"from":4,"to":4,"text":"إِنَّ فِرْعَوْنَ عَلَا فِي الْأَرْضِ وَجَعَلَ أَهْلَهَا شِيَعًا يَسْتَضْعِفُ طَائِفَةً مِنْهُمْ يُذَبِّحُ أَبْنَاءَهُمْ وَيَسْتَحْيِي نِسَاءَهُمْ إِنَّهُ كَانَ مِنَ الْمُفْسِدِينَ (4)","hl":[[0,179,1]]}},{"id":"ق-0919","fp":"f9c45946559e","stateId":488,"easy":"الاستكبار في الأرض بغير الحق وإنكار الرجوع إلى الله ← النبذ في اليم ولعنة في الدنيا ويوم القيامة من المقبوحين","cause":"الاستكبار في الأرض بغير الحق وإنكار الرجوع إلى الله","result":"النبذ في اليم ولعنة في الدنيا ويوم القيامة من المقبوحين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[27],"ref":"سورة القصص: 39–42","srcLabel":"القرآن الكريم","quran":{"s":28,"from":39,"to":42,"text":"وَاسْتَكْبَرَ هُوَ وَجُنُودُهُ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَظَنُّوا أَنَّهُمْ إِلَيْنَا لَا يُرْجَعُونَ (39) فَأَخَذْنَاهُ وَجُنُودَهُ فَنَبَذْنَاهُمْ فِي الْيَمِّ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الظَّالِمِينَ (40) وَجَعَلْنَاهُمْ أَئِمَّةً يَدْعُونَ إِلَى النَّارِ وَيَوْمَ الْقِيَامَةِ لَا يُنْصَرُونَ (41) وَأَتْبَعْنَاهُمْ فِي هَذِهِ الدُّنْيَا لَعْنَةً وَيَوْمَ الْقِيَامَةِ هُمْ مِنَ الْمَقْبُوحِينَ (42)","hl":[[0,411,1]]}},{"id":"ق-0923","fp":"7790bad8c03d","stateId":488,"easy":"بطر المعيشة والظلم ← إهلاك القرى","cause":"بطر المعيشة والظلم","result":"إهلاك القرى","explicit":true,"repOf":"ق-0735","otherNeedIds":[3],"ref":"سورة القصص: 58–59","quran":{"s":28,"from":58,"to":59,"text":"وَكَمْ أَهْلَكْنَا مِنْ قَرْيَةٍ بَطِرَتْ مَعِيشَتَهَا فَتِلْكَ مَسَاكِنُهُمْ لَمْ تُسْكَنْ مِنْ بَعْدِهِمْ إِلَّا قَلِيلًا وَكُنَّا نَحْنُ الْوَارِثِينَ (58) وَمَا كَانَ رَبُّكَ مُهْلِكَ الْقُرَى حَتَّى يَبْعَثَ فِي أُمِّهَا رَسُولًا يَتْلُو عَلَيْهِمْ آيَاتِنَا وَمَا كُنَّا مُهْلِكِي الْقُرَى إِلَّا وَأَهْلُهَا ظَالِمُونَ (59)","hl":[[0,325,1]]}},{"id":"ق-0938","fp":"297864188ed3","stateId":488,"easy":"الظلم ← الطوفان","cause":"الظلم","result":"الطوفان","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة العنكبوت: 14","srcLabel":"القرآن الكريم","quran":{"s":29,"from":14,"to":14,"text":"وَلَقَدْ أَرْسَلْنَا نُوحًا إِلَى قَوْمِهِ فَلَبِثَ فِيهِمْ أَلْفَ سَنَةٍ إِلَّا خَمْسِينَ عَامًا فَأَخَذَهُمُ الطُّوفَانُ وَهُمْ ظَالِمُونَ (14)","hl":[[0,140,1]]}},{"id":"ق-0944","fp":"41a19a24a8e0","stateId":488,"easy":"الفسق ← رجز من السماء","cause":"الفسق","result":"رجز من السماء","explicit":true,"repOf":"ق-0017","ref":"سورة العنكبوت: 34","quran":{"s":29,"from":34,"to":34,"text":"إِنَّا مُنْزِلُونَ عَلَى أَهْلِ هَذِهِ الْقَرْيَةِ رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ (34)","hl":[[0,100,1]]}},{"id":"ق-0962","fp":"670703393035","stateId":488,"easy":"الشرك بالله ← سوء العاقبة","cause":"الشرك بالله","result":"سوء العاقبة","explicit":true,"ref":"سورة الروم: 42","srcLabel":"القرآن الكريم","quran":{"s":30,"from":42,"to":42,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلُ كَانَ أَكْثَرُهُمْ مُشْرِكِينَ (42)","hl":[[0,114,1]]}},{"id":"ق-0966","fp":"21ab3d722b0e","stateId":488,"easy":"الإجرام ← انتقام الله","cause":"الإجرام","result":"انتقام الله","explicit":true,"ref":"سورة الروم: 47","srcLabel":"القرآن الكريم","quran":{"s":30,"from":47,"to":47,"text":"وَلَقَدْ أَرْسَلْنَا مِنْ قَبْلِكَ رُسُلًا إِلَى قَوْمِهِمْ فَجَاءُوهُمْ بِالْبَيِّنَاتِ فَانْتَقَمْنَا مِنَ الَّذِينَ أَجْرَمُوا وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ (47)","hl":[[89,129,1]]}},{"id":"ق-0982","fp":"ab72d703c7e3","stateId":488,"easy":"الإعراض عن آيات الله بعد التذكير ← انتقام الله","cause":"الإعراض عن آيات الله بعد التذكير","result":"انتقام الله","explicit":true,"ref":"سورة السجدة: 22","srcLabel":"القرآن الكريم","quran":{"s":32,"from":22,"to":22,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ ثُمَّ أَعْرَضَ عَنْهَا إِنَّا مِنَ الْمُجْرِمِينَ مُنْتَقِمُونَ (22)","hl":[[0,112,1]]}},{"id":"ق-1000","fp":"9ddbab9dbd93","stateId":488,"easy":"عدم انتهاء المنافقين والمرجفين ← التسليط عليهم واللعن والأخذ (سنة الله)","cause":"عدم انتهاء المنافقين والمرجفين","result":"التسليط عليهم واللعن والأخذ (سنة الله)","explicit":true,"otherNeedIds":[27],"ref":"سورة الأحزاب: 60–62","srcLabel":"القرآن الكريم","quran":{"s":33,"from":60,"to":62,"text":"لَئِنْ لَمْ يَنْتَهِ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْمُرْجِفُونَ فِي الْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَا إِلَّا قَلِيلًا (60) مَلْعُونِينَ أَيْنَمَا ثُقِفُوا أُخِذُوا وَقُتِّلُوا تَقْتِيلًا (61) سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا (62)","hl":[[0,343,1]]}},{"id":"ق-1011","fp":"5ed50a6bdbe6","stateId":488,"easy":"البطر وظلم النفس ← التمزيق كل ممزق وجعلهم أحاديث","cause":"البطر وظلم النفس","result":"التمزيق كل ممزق وجعلهم أحاديث","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39],"ref":"سورة سبأ: 19","srcLabel":"القرآن الكريم","quran":{"s":34,"from":19,"to":19,"text":"فَقَالُوا رَبَّنَا بَاعِدْ بَيْنَ أَسْفَارِنَا وَظَلَمُوا أَنْفُسَهُمْ فَجَعَلْنَاهُمْ أَحَادِيثَ وَمَزَّقْنَاهُمْ كُلَّ مُمَزَّقٍ إِنَّ فِي ذَلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ (19)","hl":[[0,130,1]]}},{"id":"ق-1032","fp":"8b35714aae5f","stateId":488,"easy":"الاستكبار في الأرض ومكر السيئ ← يحيق المكر السيئ بأهله (سنة الله)","cause":"الاستكبار في الأرض ومكر السيئ","result":"يحيق المكر السيئ بأهله (سنة الله)","explicit":true,"ref":"سورة فاطر: 43","srcLabel":"القرآن الكريم","quran":{"s":35,"from":43,"to":43,"text":"اسْتِكْبَارًا فِي الْأَرْضِ وَمَكْرَ السَّيِّئِ وَلَا يَحِيقُ الْمَكْرُ السَّيِّئُ إِلَّا بِأَهْلِهِ فَهَلْ يَنْظُرُونَ إِلَّا سُنَّتَ الْأَوَّلِينَ فَلَنْ تَجِدَ لِسُنَّتِ اللَّهِ تَبْدِيلًا وَلَنْ تَجِدَ لِسُنَّتِ اللَّهِ تَحْوِيلًا (43)","hl":[[0,234,1]]}},{"id":"ق-1170","fp":"00600a154527","stateId":488,"easy":"الفسق وطاعة الطاغية المستخِفّ ← إغضاب الله والانتقام والإغراق","cause":"الفسق وطاعة الطاغية المستخِفّ","result":"إغضاب الله والانتقام والإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الزخرف: 54–56","srcLabel":"القرآن الكريم","quran":{"s":43,"from":54,"to":56,"text":"فَاسْتَخَفَّ قَوْمَهُ فَأَطَاعُوهُ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ (54) فَلَمَّا آسَفُونَا انْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ (55) فَجَعَلْنَاهُمْ سَلَفًا وَمَثَلًا لِلْآخِرِينَ (56)","hl":[[0,199,1]]}},{"id":"ق-1176","fp":"8aca792cd0a6","stateId":488,"easy":"العود إلى الكفر بعد كشف العذاب ← البطشة الكبرى والانتقام","cause":"العود إلى الكفر بعد كشف العذاب","result":"البطشة الكبرى والانتقام","explicit":true,"ref":"سورة الدخان: 15–16","srcLabel":"القرآن الكريم","quran":{"s":44,"from":15,"to":16,"text":"إِنَّا كَاشِفُو الْعَذَابِ قَلِيلًا إِنَّكُمْ عَائِدُونَ (15) يَوْمَ نَبْطِشُ الْبَطْشَةَ الْكُبْرَى إِنَّا مُنْتَقِمُونَ (16)","hl":[[0,121,1]]}},{"id":"ق-1177","fp":"b90ccd60c5a0","stateId":488,"easy":"العلوّ والإسراف (فرعون وقومه) ← الإغراق وسلب النعم وتوريثها قوماً آخرين","cause":"العلوّ والإسراف (فرعون وقومه)","result":"الإغراق وسلب النعم وتوريثها قوماً آخرين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"سورة الدخان: 25–29","srcLabel":"القرآن الكريم","quran":{"s":44,"from":25,"to":29,"text":"كَمْ تَرَكُوا مِنْ جَنَّاتٍ وَعُيُونٍ (25) وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ (26) وَنَعْمَةٍ كَانُوا فِيهَا فَاكِهِينَ (27) كَذَلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ (28) فَمَا بَكَتْ عَلَيْهِمُ السَّمَاءُ وَالْأَرْضُ وَمَا كَانُوا مُنْظَرِينَ (29)","hl":[[0,238,1]]}},{"id":"ق-1179","fp":"64094df466c4","stateId":488,"easy":"الإجرام ← الإهلاك","cause":"الإجرام","result":"الإهلاك","explicit":true,"similar":["ق-1405"],"ref":"سورة الدخان: 37","srcLabel":"القرآن الكريم","quran":{"s":44,"from":37,"to":37,"text":"أَهُمْ خَيْرٌ أَمْ قَوْمُ تُبَّعٍ وَالَّذِينَ مِنْ قَبْلِهِمْ أَهْلَكْنَاهُمْ إِنَّهُمْ كَانُوا مُجْرِمِينَ (37)","hl":[[62,107,1]]}},{"id":"ق-1199","fp":"dd87e68eeff9","stateId":488,"easy":"جحود آيات الله ← لا يغني السمع والبصر والفؤاد ويحيق بهم ما استهزؤوا به","cause":"جحود آيات الله","result":"لا يغني السمع والبصر والفؤاد ويحيق بهم ما استهزؤوا به","explicit":true,"otherNeedIds":[19],"ref":"سورة الأحقاف: 26","srcLabel":"القرآن الكريم","quran":{"s":46,"from":26,"to":26,"text":"وَلَقَدْ مَكَّنَّاهُمْ فِيمَا إِنْ مَكَّنَّاكُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْعًا وَأَبْصَارًا وَأَفْئِدَةً فَمَا أَغْنَى عَنْهُمْ سَمْعُهُمْ وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ مِنْ شَيْءٍ إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ (26)","hl":[[108,284,1]]}},{"id":"ق-1200","fp":"263b1f9c8461","stateId":488,"easy":"اتخاذ آلهة من دون الله ← الإهلاك وخذلان الآلهة","cause":"اتخاذ آلهة من دون الله","result":"الإهلاك وخذلان الآلهة","explicit":true,"otherNeedIds":[39],"ref":"سورة الأحقاف: 27–28","srcLabel":"القرآن الكريم","quran":{"s":46,"from":27,"to":28,"text":"وَلَقَدْ أَهْلَكْنَا مَا حَوْلَكُمْ مِنَ الْقُرَى وَصَرَّفْنَا الْآيَاتِ لَعَلَّهُمْ يَرْجِعُونَ (27) فَلَوْلَا نَصَرَهُمُ الَّذِينَ اتَّخَذُوا مِنْ دُونِ اللَّهِ قُرْبَانًا آلِهَةً بَلْ ضَلُّوا عَنْهُمْ وَذَلِكَ إِفْكُهُمْ وَمَا كَانُوا يَفْتَرُونَ (28)","hl":[[0,249,1]]}},{"id":"ق-1203","fp":"3bc4507b35c5","stateId":488,"easy":"الفسق ← الهلاك","cause":"الفسق","result":"الهلاك","explicit":true,"similar":["ق-1264"],"ref":"سورة الأحقاف: 35","srcLabel":"القرآن الكريم","quran":{"s":46,"from":35,"to":35,"text":"فَاصْبِرْ كَمَا صَبَرَ أُولُو الْعَزْمِ مِنَ الرُّسُلِ وَلَا تَسْتَعْجِلْ لَهُمْ كَأَنَّهُمْ يَوْمَ يَرَوْنَ مَا يُوعَدُونَ لَمْ يَلْبَثُوا إِلَّا سَاعَةً مِنْ نَهَارٍ بَلَاغٌ فَهَلْ يُهْلَكُ إِلَّا الْقَوْمُ الْفَاسِقُونَ (35)","hl":[[176,222,1]]}},{"id":"ق-1209","fp":"fba70a6dca5c","stateId":488,"easy":"الكفر ← تدمير الله عليهم (ولأمثالهم مثلها)","cause":"الكفر","result":"تدمير الله عليهم (ولأمثالهم مثلها)","explicit":true,"ref":"سورة محمد: 10","srcLabel":"القرآن الكريم","quran":{"s":47,"from":10,"to":10,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ دَمَّرَ اللَّهُ عَلَيْهِمْ وَلِلْكَافِرِينَ أَمْثَالُهَا (10)","hl":[[0,151,1]]}},{"id":"ق-1264","fp":"19dbf8f4ea17","stateId":488,"easy":"الفسق ← الهلاك (قوم نوح)","cause":"الفسق","result":"الهلاك (قوم نوح)","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-1203","ref":"سورة الذاريات: 46","quran":{"s":51,"from":46,"to":46,"text":"وَقَوْمَ نُوحٍ مِنْ قَبْلُ إِنَّهُمْ كَانُوا قَوْمًا فَاسِقِينَ (46)","hl":[[0,63,1]]}},{"id":"ق-1271","fp":"e808a52bf21d","stateId":488,"easy":"الظلم ← عذاب دون عذاب الآخرة","cause":"الظلم","result":"عذاب دون عذاب الآخرة","explicit":true,"otherNeedIds":[59],"ref":"سورة الطور: 47","srcLabel":"القرآن الكريم","quran":{"s":52,"from":47,"to":47,"text":"وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَلِكَ وَلَكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ (47)","hl":[[8,88,1]]}},{"id":"ق-1317","fp":"6991368d76e7","stateId":488,"easy":"مشاقّة الله ورسوله ← إتيان الله من حيث لم يحتسبوا وقذف الرعب والجلاء وعذاب النار","cause":"مشاقّة الله ورسوله","result":"إتيان الله من حيث لم يحتسبوا وقذف الرعب والجلاء وعذاب النار","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[39,57],"ref":"سورة الحشر: 2–4","srcLabel":"القرآن الكريم","quran":{"s":59,"from":2,"to":4,"text":"هُوَ الَّذِي أَخْرَجَ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ مِنْ دِيَارِهِمْ لِأَوَّلِ الْحَشْرِ مَا ظَنَنْتُمْ أَنْ يَخْرُجُوا وَظَنُّوا أَنَّهُمْ مَانِعَتُهُمْ حُصُونُهُمْ مِنَ اللَّهِ فَأَتَاهُمُ اللَّهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ يُخْرِبُونَ بُيُوتَهُمْ بِأَيْدِيهِمْ وَأَيْدِي الْمُؤْمِنِينَ فَاعْتَبِرُوا يَا أُولِي الْأَبْصَارِ (2) وَلَوْلَا أَنْ كَتَبَ اللَّهُ عَلَيْهِمُ الْجَلَاءَ لَعَذَّبَهُمْ فِي الدُّنْيَا وَلَهُمْ فِي الْآخِرَةِ عَذَابُ النَّارِ (3) ذَلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ وَمَنْ يُشَاقِّ اللَّهَ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ (4)","hl":[[0,613,1]]}},{"id":"ق-1355","fp":"63dc085cad65","stateId":488,"easy":"العتوّ عن أمر الله ورسله ← حساب شديد وعذاب نُكر وخسران العاقبة","cause":"العتوّ عن أمر الله ورسله","result":"حساب شديد وعذاب نُكر وخسران العاقبة","explicit":true,"otherNeedIds":[50,57],"ref":"سورة الطلاق: 8–10","srcLabel":"القرآن الكريم","quran":{"s":65,"from":8,"to":10,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ عَتَتْ عَنْ أَمْرِ رَبِّهَا وَرُسُلِهِ فَحَاسَبْنَاهَا حِسَابًا شَدِيدًا وَعَذَّبْنَاهَا عَذَابًا نُكْرًا (8) فَذَاقَتْ وَبَالَ أَمْرِهَا وَكَانَ عَاقِبَةُ أَمْرِهَا خُسْرًا (9) أَعَدَّ اللَّهُ لَهُمْ عَذَابًا شَدِيدًا فَاتَّقُوا اللَّهَ يَا أُولِي الْأَلْبَابِ الَّذِينَ آمَنُوا قَدْ أَنْزَلَ اللَّهُ إِلَيْكُمْ ذِكْرًا (10)","hl":[[0,98,1]]}},{"id":"ق-1405","fp":"eab5a2c804b6","stateId":488,"easy":"الإجرام ← الإهلاك (كذلك نفعل بالمجرمين)","cause":"الإجرام","result":"الإهلاك (كذلك نفعل بالمجرمين)","explicit":true,"repOf":"ق-1179","ref":"سورة المرسلات: 16–18","quran":{"s":77,"from":16,"to":18,"text":"أَلَمْ نُهْلِكِ الْأَوَّلِينَ (16) ثُمَّ نُتْبِعُهُمُ الْآخِرِينَ (17) كَذَلِكَ نَفْعَلُ بِالْمُجْرِمِينَ (18)","hl":[[0,105,1]]}},{"id":"ق-1411","fp":"f90772970a6d","stateId":488,"easy":"الطغيان والتكذيب والعصيان وادعاء الربوبية (فرعون) ← نكال الآخرة والأولى","cause":"الطغيان والتكذيب والعصيان وادعاء الربوبية (فرعون)","result":"نكال الآخرة والأولى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"سورة النازعات: 17–26","srcLabel":"القرآن الكريم","quran":{"s":79,"from":17,"to":26,"text":"اذْهَبْ إِلَى فِرْعَوْنَ إِنَّهُ طَغَى (17) فَقُلْ هَلْ لَكَ إِلَى أَنْ تَزَكَّى (18) وَأَهْدِيَكَ إِلَى رَبِّكَ فَتَخْشَى (19) فَأَرَاهُ الْآيَةَ الْكُبْرَى (20) فَكَذَّبَ وَعَصَى (21) ثُمَّ أَدْبَرَ يَسْعَى (22) فَحَشَرَ فَنَادَى (23) فَقَالَ أَنَا رَبُّكُمُ الْأَعْلَى (24) فَأَخَذَهُ اللَّهُ نَكَالَ الْآخِرَةِ وَالْأُولَى (25) إِنَّ فِي ذَلِكَ لَعِبْرَةً لِمَنْ يَخْشَى (26)","hl":[[0,374,1]]}},{"id":"ق-1433","fp":"7105123afd87","stateId":488,"easy":"الطغيان في البلاد وإكثار الفساد (عاد وثمود وفرعون) ← سوط عذاب وربك بالمرصاد","cause":"الطغيان في البلاد وإكثار الفساد (عاد وثمود وفرعون)","result":"سوط عذاب وربك بالمرصاد","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفجر: 6–14","srcLabel":"القرآن الكريم","quran":{"s":89,"from":6,"to":14,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ (6) إِرَمَ ذَاتِ الْعِمَادِ (7) الَّتِي لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِ (8) وَثَمُودَ الَّذِينَ جَابُوا الصَّخْرَ بِالْوَادِ (9) وَفِرْعَوْنَ ذِي الْأَوْتَادِ (10) الَّذِينَ طَغَوْا فِي الْبِلَادِ (11) فَأَكْثَرُوا فِيهَا الْفَسَادَ (12) فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ (13) إِنَّ رَبَّكَ لَبِالْمِرْصَادِ (14)","hl":[[0,364,1]]}},{"id":"ق-1460","fp":"1a37d474794b","stateId":488,"easy":"الكيد لبيت الله ← تضليل الكيد والإهلاك","cause":"الكيد لبيت الله","result":"تضليل الكيد والإهلاك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة الفيل: 1–5","srcLabel":"القرآن الكريم","quran":{"s":105,"from":1,"to":5,"text":"أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِأَصْحَابِ الْفِيلِ (1) أَلَمْ يَجْعَلْ كَيْدَهُمْ فِي تَضْلِيلٍ (2) وَأَرْسَلَ عَلَيْهِمْ طَيْرًا أَبَابِيلَ (3) تَرْمِيهِمْ بِحِجَارَةٍ مِنْ سِجِّيلٍ (4) فَجَعَلَهُمْ كَعَصْفٍ مَأْكُولٍ (5)","hl":[[0,222,1]]}},{"id":"س-06139","fp":"ac7e5598d398","stateId":488,"easy":"إذا منعت الزكاة ← تُؤخذ منك وشطر مالك عزمة من عزمات ربنا","cause":"ومن منعَها","result":"فإنَّا آخِذُها وشطرَ إبلِهِ عزمةٌ من عزماتِ ربِّنا","explicit":true,"ref":"صحيح ابن خزيمة 4/ 31","srcLabel":"النسائي","text":["في كلِّ إبلٍ سائمةٍ في كلِّ أربعينَ بنتُ لبونٍ، لا يفرَّقُ إبلٌ مِن حسابِها، مَن أعطاها مؤتَجرًا فلَهُ أجرُها، ",["ومن منعَها",1],"، ",["فإنَّا آخِذُها وشطرَ إبلِهِ عزمةٌ من عزماتِ ربِّنا",2],"، لا يحلُّ لآلِ مُحمَّدٍ منها شيءٌ . [وفي روايةٍ]: مِن كلِّ أربعينَ بنتُ لبونٍ . [وفي رِوايةٍ]: ومن أبى فأَنا آخِذُها وشطرَ مالِهِ، وقالَ: لا يفرَّقُ إبلٌ مِن حسابِها"],"grade":"صحيح","narrator":"معاوية بن حيدة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي (2444)، وأحمد (20016)، والدارمي (1719) واللفظ لهم.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"ZSBa2M5g","merged":5,"otherRefs":["تهذيب السنن 4/453 (صحيح)","تخريج مشكل الآثار 15/ 101 (حسن)","تخريج سير أعلام النبلاء 15/ 257- 258 (حسن)","الطرق الحكمية 226 (صحيح)"]},{"id":"س-07488","fp":"79289fa322f1","stateId":488,"easy":"إذا استحل قوم الزنا والحرير والخمر والمعازف ← يمسخ الله بعضهم قردة وخنازير","cause":"يَسْتَحِلُّونَ الحِرَ والحَرِيرَ، والخَمْرَ والمَعازِفَ","result":"ويَمْسَخُ آخَرِينَ قِرَدَةً وخَنازِيرَ","explicit":true,"ref":"مدارج السالكين 2/101","srcLabel":"مدارج السالكين","text":["حديث  تحريمِ أصواتِ المعازفِ وأن في الأُمَّةِ من سيستحلُّها [يعني حديث:  لَيَكونَنَّ مِن أُمَّتي أقْوامٌ ",["يَسْتَحِلُّونَ الحِرَ والحَرِيرَ، والخَمْرَ والمَعازِفَ",1],"، ولَيَنْزِلَنَّ أقْوامٌ إلى جَنْبِ عَلَمٍ، يَرُوحُ عليهم بسارِحَةٍ لهمْ، يَأْتِيهِمْ -يَعْنِي الفقِيرَ- لِحاجَةٍ، فيَقولونَ: ارْجِعْ إلَيْنا غَدًا، فيُبَيِّتُهُمُ اللَّهُ ، ويَضَعُ العَلَمَ، ",["ويَمْسَخُ آخَرِينَ قِرَدَةً وخَنازِيرَ",2]," إلى يَومِ القِيامَةِ.]"],"grade":"صحيح","narrator":"[أبو مالك الأشعري]","muhaddith":"صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"gS2jAEJW","merged":4,"otherRefs":["تخريج سنن أبي داود 4039 (صحيح)","صحيح الترغيب 1864 (حسن)","صحيح الجامع 5466 (صحيح)"]},{"id":"س-01736","fp":"195431f68b74","stateId":488,"easy":"إذا غللت ← تُرد عنك الراية والنصر (من قصة)","cause":"بغُلولِ رأسِ غَزالٍ مِن ذَهَبٍ","result":"فرُدَّتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 529","srcLabel":"متفق عليه","text":["«بَعَثَ نَبيٌّ صلَّى اللهُ عليه وسلَّمَ جَيْشًا ",["فرُدَّتْ",2]," رايتُه، ثُمَّ بَعَثَ فرُدَّتْ، ثُمَّ بَعَثَ فرُدَّتْ ",["بغُلولِ رأسِ غَزالٍ مِن ذَهَبٍ",1],"، فنَزَلَتْ: {وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أنبياء › عام","dorar":"JJUKsTPP"},{"id":"س-06164","fp":"858489f78d0f","stateId":488,"easy":"إذا كنت أميراً فتظالم الناس ولم تأخذ لبعضهم من بعض ← ينتقم الله منك","cause":"إذا كانَ أميرًا فتظالَمَ النَّاسُ بينَهم، فلم يأخُذْ لبعضِهم مِن بعضٍ","result":"انتقَمَ اللهُ منه","explicit":true,"ref":"مجمع الزوائد 5/204","srcLabel":"البخاري","text":["بعَثَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عَمرَو بنَ العاصِ على جيشِ ذاتِ السلاسلِ، فبعَثَ معه في ذلك الجَيشِ  أبا بَكْرٍ وعُمَرَ وسَراةَ أصحابِه، فانطَلَقوا حتى نزَلوا جبلَ طَيِّئٍ، فقال عَمرٌو: انظُروا إلى رجُلٍ دليلٍ بالطَّريقِ. فقالوا: ما نعلَمُه إلَّا رافعَ بنَ عَمرٍو؛ فإنَّه كان رَبيلًا، فسأَلتُ طارقًا: ما الرَّبيلُ؟ قال: اللِّصُ الذي يَغْزو القومَ وحْدَه فيسرِقُ. قال رافعٌ: فلمَّا قضَيْنا غَزاتَنا، وانتهَيتُ إلى المكانِ الذي كنَّا خرَجْنا منه توسَّمتُ أبا بَكْرٍ فأتَيتُه، فقلتُ: يا صاحبَ [الخلال] ، إنِّي توسَّمتُكَ مِن بينِ أصحابِكَ، فائْتِني بشيءٍ إذا حفِظتُه كنتُ منكم ومِثلَكم. فقال: أتحفَظُ أصابِعَكَ الخمْسَ؟ قلتُ: نعَمْ. قال: أشهدُ أنْ لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له، وأنَّ مُحمَّدًا عبدُه ورسولُه، وتقيمُ الصَّلاةَ، وتُؤتي الزكاةَ إنْ كان لكَ مالٌ، وتحُجُّ البَيتَ، وتصومُ رمضانَ. حفِظتَ؟ فقلتُ: نعَمْ. قال: وأُخرى: لا تأمَّرنَّ على اثنينِ. قلتُ: وهل تكونُ الإمْرةُ إلَّا فيكم أهلَ بدرٍ؟ قال: يوشِكُ أنْ تفشوَ حتى تبلُغَكَ ومَن هو دونَكَ، إنَّ اللهَ عزَّ وجلَّ لمَّا بعَثَ نبيَّه صلَّى اللهُ عليه وسلَّمَ دخَلَ النَّاسُ في الإسلامِ، فمنهم مَن دخَلَ فهداه اللهُ، ومنهم مَن أكرَهَه السَّيفُ، فهم عُوَّادُ اللهِ عزَّ وجلَّ وجيرانُ اللهِ في خِفارةِ اللهِ، إنَّ الرجُلَ ",["إذا كانَ أميرًا فتظالَمَ النَّاسُ بينَهم، فلم يأخُذْ لبعضِهم مِن بعضٍ",1]," ",["انتقَمَ اللهُ منه",2],"، إنَّ الرجُلَ منكم لتؤخَذُ شاةُ جارِه، فيظَلُّ ناتِئَ عَضَلتِه غَضبًا لجارِه، واللهُ مِن وراءِ جارِه. قال رافعٌ: فمكَثتُ سنةً، ثمَّ إنَّ أبا بَكْرٍ استُخلِفَ، فركَنتُ إليه، قلتُ: أنا رافعٌ، كنتُ نَقيبَكَ بمكانِ كذا وكذا. قال: عرَفتُ. قال: كنتَ نهَيتَني عن الإمارةِ، ثمَّ ركبِتَ أعظَمَ مِن ذلكَ، أُمَّةَ مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ؟! قال: نعَمْ، فمَن لم يُقِمْ فيهم كتابَ اللهِ، فعليه بَهلةُ اللهِ. يَعْني: لعنةَ اللهِ."],"grade":"حسن","narrator":"رافع بن عمرو الطائي","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (5/ 21) (4467) واللفظ له، والبخاري في ((التاريخ الكبير)) (6/ 24)، والنسائي في ((فضائل الصحابة)) (16) مختصرا.","bab":"زكاة › فرض الزكاة","dorar":"S9eBzz3d"},{"id":"س-07375","fp":"e910123963c6","stateId":488,"easy":"إذا مزّقت كتاب الحق ← يمزّق الله ملكك (من واقعة)","cause":"خرَقهُ","result":"أنْ يُمَزَّقوا كلَّ مُمَزَّقٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 515","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بعَث بكتابِهِ إلى كِسْرى مع عبدِ اللهِ بنِ حُذافةَ السَّهْميِّ، وأمَرهُ أنْ يدفَعَهُ إلى عظيمِ البَحرَيْنِ، فدفَعهُ عظيمُ البَحرَيْنِ إلى كِسْرى، فلمَّا قرَأهُ ",["خرَقهُ",1],"، قال ابنُ شِهابٍ فحسِبْتُ أنَّ ابنَ المُسَيِّبِ قال: فدعا عليهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أنْ يُمَزَّقوا كلَّ مُمَزَّقٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2939) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › أحوال النبي","dorar":"KukLHLMR"},{"id":"س-07475","fp":"3ed38ef12a64","stateId":488,"easy":"إذا قاتلت في الفتنة اليوم ← يقتلك الله غداً","cause":"يُقاتِلُ في الفِتْنةِ اليومَ","result":"ويَقتُلُه اللهُ غدًا","explicit":true,"ref":"المستدرك على الصحيحين 2705","srcLabel":"الطبراني","text":["عنْ أَبي ثَوْرٍ الحُدَّانيِّ قالَ: بَعَثَ عُثمانُ بنُ عَفَّانَ يومَ الجَرَعَةِ سعيدَ بنَ العاصِ إلى الكوفةِ، قالَ: فخَرَجوا إليه فرَدُّوه، قالَ: وكنتُ قاعِدًا مع ابنِ مسعودٍ وحُذَيفَةَ، فقالَ ابنُ مسعودٍ: ما كنتُ أَرى أنْ يَرجِعَ هؤلاء، ولمْ يُهْرَقْ فيها مِحْجَمةٌ مِن دَمٍ، وما عَلِمتُ مِن ذلك شيئًا إلَّا شيئًا عَلِمتُه، ومُحمَّدٌ صلَّى اللهُ عليه وسلَّمَ حَيٌّ أنَّ الرَّجلَ يُصبِحُ مؤمِنًا، ويُمسي وما معه شيءٌ، ويُمسي مؤمِنًا، ويُصبِحُ وما معه شيءٌ، ",["يُقاتِلُ في الفِتْنةِ اليومَ",1],"، ",["ويَقتُلُه اللهُ غدًا",2],"، يَنكُسُ قَلبُه وتَعْلوهُ استُه، قلتُ: أسفَلُه، قالَ: بل استُه."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (17/ 253)، (703) باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"uvgVUtjx","merged":3,"otherRefs":["مجمع الزوائد 7/236 (صحيح)","المستدرك على الصحيحين 8570 (صحيح)"]},{"id":"س-07298","fp":"53c28a0ffa53","stateId":488,"easy":"إذا مشت الأمة مشية الخيلاء وخدمها أبناء الملوك ← سُلّط شرارها على خيارها","cause":"إذا مَشت أُمَّتي الْمُطَيطَاءَ ، و خدَمَها أبناءُ الملوكِ أبناءُ فارسٍ و الرومِ","result":"سُلِّطَ شرارُها على خيارِها","explicit":true,"ref":"صحيح الجامع 801","srcLabel":"الترمذي","text":[["إذا مَشت أُمَّتي الْمُطَيطَاءَ ، و خدَمَها أبناءُ الملوكِ أبناءُ فارسٍ و الرومِ",1]," ، ",["سُلِّطَ شرارُها على خيارِها",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2261)، وابن المبارك في ((الزهد)) (2/51)، وأبو نعيم في ((تاريخ أصبهان)) (1/362) باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"fKz7B1zT","merged":2,"otherRefs":["الترغيب والترهيب 4/42 (صحيح)"]},{"id":"س-07493","fp":"4eb530cc2bc2","stateId":488,"easy":"إذا تعلم الناس القرآن فتأولوه على غير ما أنزل الله ← فهو هلاك الأمة","cause":"يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ","result":"هلاكُ أُمَّتي","explicit":true,"otherNeedIds":[19],"ref":"السلسلة الصحيحة 2778","srcLabel":"أحمد","text":[["هلاكُ أُمَّتي",2]," في الكِتابِ واللَّبَنِ، قالوا: يا رسولَ اللهِ، ما الكِتابُ واللَّبَنُ؟ قال: ",["يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ",1]," عزَّ وجلَّ، ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17415)، وأبو يعلى (1746)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (2359)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PDj6GIAR","merged":2,"otherRefs":["تخريج العواصم والقواصم 6/ 178 (حسن)"]},{"id":"س-08278","fp":"9caca151c589","stateId":488,"easy":"إذا ظهر الربا والزنا في قوم ← فقد أحلّوا بأنفسهم عقاب الله","cause":"ما ظهَرَ في قَومٍ الرِّبا والزِّنا","result":"إلَّا أحَلُّوا بأنفُسِهم عِقابَ اللهِ عزَّ وجلَّ","explicit":true,"similar":["س-06955","س-08074"],"ref":"تخريج المسند لشعيب 3809","srcLabel":"الترمذي","text":["\"لعَنَ اللهُ آكِلَ الرِّبا، ومُوكِلَه، وشاهدَيْه، وكاتبَه\"،\nقال: وقال: \"",["ما ظهَرَ في قَومٍ الرِّبا والزِّنا،",1]," ",["إلَّا أحَلُّوا بأنفُسِهم عِقابَ اللهِ عزَّ وجلَّ\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (1206)، وابن ماجه (2277) باختلاف يسير، والنسائي (3416) مطولاً باختلاف يسير، وأحمد (3809) واللفظ له","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"FLufTdL7","merged":2,"otherRefs":["صحيح ابن حبان 4410 (صحيح)"]},{"id":"س-01565","fp":"27a4e2345880","stateId":488,"easy":"إذا شربوا الخمور واتخذوا القينات وضربوا بالمعازف ← يكون الخسف والقذف والمسخ","cause":"إذا شرِبُوا الخمورَ ، و اتَّخذوا القَيْناتِ ، و ضربُوا بالمعازفِ","result":"خسفٌ ، و قذفٌ ، و مسخٌ","explicit":true,"similar":["س-07483"],"ref":"السلسلة الصحيحة 2203","srcLabel":"ابن أبي الدنيا","text":["لَيكوننَّ في هذه الأُمَّةِ ",["خسفٌ ، و قذفٌ ، و مسخٌ",2]," ، و ذلك ",["إذا شرِبُوا الخمورَ ، و اتَّخذوا القَيْناتِ ، و ضربُوا بالمعازفِ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن أبي الدنيا في ((ذم الملاهي)) (7)","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"uCcQgvFT"},{"id":"س-01701","fp":"b8f57c485098","stateId":488,"easy":"إذا ظهرت الفاحشة في قوم حتى أعلنوها ← يظهر فيهم الطاعون والأوجاع التي لم تكن في أسلافهم","cause":"لم تَظهَرِ الفاحشةُ في قومٍ قطُّ حتَّى يَعمَلوها","result":"إلَّا ظَهَر فيهم الطَّاعونُ والأوجاعُ الَّتي لم تكُنْ مَضَت في أسلافِهم، ولم يَنقُصوا المِكيالَ والميزانَ إلَّا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ عليهم، ولم يَمنَعوا زكاةَ أموالِهم إلَّا مُنِعوا القطْرَ","explicit":true,"similar":["س-02677"],"otherNeedIds":[3],"ref":"المستدرك على الصحيحين 8848","srcLabel":"الحاكم","text":["عن عَطاءِ بنِ أبي رَباحٍ، قال: كُنتُ مع عبدِ اللهِ بنِ عُمرَ، فأتاهُ فتًى يَسألُه عن إسدالِ العِمامةِ، فقال ابنُ عُمرَ: سأُخبِرُك عن ذلكَ بعِلمٍ إنْ شاء اللهُ: كُنتُ عاشرَ عَشَرةٍ في مَسجدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: أبو بَكرٍ، وعُمرُ، وعُثمانُ، وعلِيٌّ، وابنُ مَسعودٍ، وحُذَيفةُ، وابنُ عَوفٍ، وأبو سَعيدٍ الخُدْريُّ رَضيَ اللهُ عنهم، فجاء فتًى مِنَ الأنصارِ فسَلَّم على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ثمَّ جلَسَ، فقال: يا رَسولَ اللهِ، أيُّ المُؤمنينَ أفضلُ؟ قال: أحسَنُهم خُلقًا، قال: فأيُّ المُؤمنينَ أكيَسُ؟ قال: أكثَرُهم للموتِ ذِكرًا وأحسَنُهم له استعدادًا قبْلَ أنْ يَنزِلَ بهم، أولئكَ مِنَ الأكياسِ، ثمَّ سَكَت الفَتى. وأقبَلَ عليه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا مَعشَرَ المهاجِرين، خمسٌ إنِ ابتُلِيتُم بهنَّ، ونزَلَ فيكم، أعوذُ باللهِ أنْ تُدْرِكُوهنَّ: ",["لم تَظهَرِ الفاحشةُ في قومٍ قطُّ حتَّى يَعمَلوها",1]," ",["إلَّا ظَهَر فيهم الطَّاعونُ والأوجاعُ الَّتي لم تكُنْ مَضَت في أسلافِهم، ولم يَنقُصوا المِكيالَ والميزانَ إلَّا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ عليهم، ولم يَمنَعوا زكاةَ أموالِهم إلَّا مُنِعوا القطْرَ",2]," مِنَ السَّماءِ، ولوْلا البهائمُ لم يُمْطَروا، ولم يَنقُضوا عهْدَ اللهِ وعهْدَ رَسولِه إلَّا سُلِّطَ عليهم عدُوُّهم مِن غيرِهم وأَخَذوا بعضَ ما كان في أيْديهم، وما لم يَحكُمْ أئمَّتُهم بكتابِ اللهِ إلَّا ألْقى اللهُ بأسهُمٍ بيْنهم. ثمَّ أمَرَ عبدَ الرَّحمنِ بنَ عَوفٍ يَتجهَّزُ لسَرِيَّةٍ بَعَثه عليها، وأصبَحَ عبْدُ الرَّحمنِ قدِ اعتَمَّ بعِمامةٍ مِن كَرابيسَ سَوداءَ، فأدْناه النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ نَقَضه وعمَّمه بعِمامةٍ بَيضاءَ، وأرسَلَ مِن خلْفِه أربعَ أصابعَ أو نحْوَ ذلكَ، وقال: هكذا يا ابنَ عَوفٍ اعتَمَّ؛ فإنَّه أعرَبُ وأحسَنُ. ثمَّ أمَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ بِلالًا أنْ يَدفَعَ إليه اللِّواءَ، فحَمِد اللهَ وصلَّى على النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، ثمَّ قال: خُذِ ابنَ عَوفٍ فاغْزُوا جميعًا في سَبيلِ اللهِ، فقاتِلوا مَن كَفَر باللهِ، لا تَغُلُّوا ولا تَغدِروا، ولا تُمثِّلوا، ولا تَقْتُلوا وَليدًا، فهذا عهْدُ اللهِ وسِيرةُ نبيِّه صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد، ولم يخرجاه","bab":"أقضية وأحكام › الحكم بالكتاب والسنة ثم باجتهاد الحاكم، والخطأ معذور","dorar":"uPcbS7uR"},{"id":"س-02677","fp":"9bb218fe3a47","stateId":488,"easy":"إذا ظهرت الفاحشة في قوم وأعلنوها ← فشا فيهم الطاعون والأوجاع الجديدة","cause":"لم تَظْهرِ الفاحِشةُ في قومٍ قطُّ حتى يُعلِنُوا بِها","result":"إلا فَشَا فِيهمُ الطاعونُ و الأَوجاعُ التِي لم تكنْ مَضتْ في أسلافِهم الَّذين مَضَوَا","explicit":true,"repOf":"س-01701","ref":"صحيح الترغيب 2419","text":["يا مَعشَرَ المُهاجِرينَ ! خَمسُ خِصالٍ إذا ابْتُلِيتُم بِهنَّ ، وأَعوذُ باللهِ أنْ تُدْرِكُوهُنَّ : ",["لم تَظْهرِ الفاحِشةُ في قومٍ قطُّ حتى يُعلِنُوا بِها ؛",1]," ",["إلا فَشَا فِيهمُ الطاعونُ و الأَوجاعُ التِي لم تكنْ مَضتْ في أسلافِهم الَّذين مَضَوَا",2],".. الحديثُ ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019)، والطبراني في ((المعجم الأوسط)) (4671)، والحاكم (8623) باختلاف يسير.","bab":"إيمان › الحكم بما أنزل الله","dorar":"QaIEK7rb"},{"id":"س-04361","fp":"977a5ed054f7","stateId":488,"easy":"إذا لم تغزُ ولم تجهز غازياً ولم تخلفه بخير ← يصيبك الله بقارعة","cause":"مَن لم يَغْزُ، أو يُجهِّزْ غازيًا، أو يَخلُفْ غازيًا في أهلِه بخيرٍ","result":"أصابَه اللهُ بقارعةٍ","explicit":true,"similar":["س-05246"],"ref":"تخريج سنن أبي داود 2503","srcLabel":"أبو داود","text":[["مَن لم يَغْزُ، أو يُجهِّزْ غازيًا، أو يَخلُفْ غازيًا في أهلِه بخيرٍ، ",1],["أصابَه اللهُ بقارعةٍ",2],". قال يزيدُ بنُ عبدِ ربِّه في حديثِه: قبلَ يومِ القيامةِ."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2503)، وابن ماجه (2762)، والدارمي (2462) جميعا بلفظه،","bab":"جهاد › الترغيب في الجهاد","dorar":"UmM2xlCk"},{"id":"س-05165","fp":"f502c6fb0639","stateId":488,"easy":"إذا ترك قوم الجهاد ← يعمهم الله بالعذاب","cause":"ما تركَ قومٌ الجِهادَ","result":"إلَّا عَمَّهُمُ اللهُ بِالعذابِ","explicit":true,"otherNeedIds":[39],"ref":"السلسلة الصحيحة 2663","srcLabel":"الطبراني","text":[["ما تركَ قومٌ الجِهادَ",1]," ",["إلَّا عَمَّهُمُ اللهُ بِالعذابِ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"يشهد له حديث العينة وهو حديث صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (3839)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"lLYOWtR7"},{"id":"س-05234","fp":"00680fb431db","stateId":488,"easy":"إذا فشا ولد الزنا في الأمة ← يوشك أن يعمهم الله بعذاب","cause":"ما لم يفشِ فيهم ولدُ الزنا فإذا فشا فيهم ولدُ الزنا فأوشك أن يعمَّهم اللهُ بعذابٍ","result":"لا تزال أمتي بخيرٍ","explicit":true,"ref":"مجمع الزوائد 6/260","srcLabel":"أحمد","text":[["لا تزال أمتي بخيرٍ",2]," ",["ما لم يفشِ فيهم ولدُ الزنا فإذا فشا فيهم ولدُ الزنا فأوشك أن يعمَّهم اللهُ بعذابٍ",1]],"grade":"صحيح","narrator":"ميمونة بنت الحارث أم المؤمنين","muhaddith":"صحيح أو حسن","takhrij":"أخرجه أحمد (26830)، والطبراني (24/ 23) (55)، وأبو يعلى في ((المسند)) (7091) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"wVMVfWBC"},{"id":"س-05651","fp":"be7f41b5b5c5","stateId":488,"easy":"إذا أبغض المسلمون علماءهم وعمروا أسواقهم وتناكحوا على جمع المال ← رماهم الله بالقحط وجور السلطان وخيانة الولاة وصولة العدو","cause":"إذا أبغَضَ المُسلِمونَ عُلماءَهُم، وأظْهَروا عِمارةَ أَسواقِهِم، وتَناكَحوا على جمْعِ الدَّراهِمِ","result":"رَماهُم اللهُ عزَّ وجلَّ بأربعِ خِصالٍ: بالقَحْطِ مِن الزَّمانِ، والجَوْرِ مِن السُّلْطانِ، والخيانةِ مِن وُلاةِ الأحكامِ، والصَّولةِ مِن العَدُوِّ","explicit":true,"ref":"المستدرك على الصحيحين 8136","srcLabel":"الحاكم","text":[["إذا أبغَضَ المُسلِمونَ عُلماءَهُم، وأظْهَروا عِمارةَ أَسواقِهِم، وتَناكَحوا على جمْعِ الدَّراهِمِ",1],"، ",["رَماهُم اللهُ عزَّ وجلَّ بأربعِ خِصالٍ: بالقَحْطِ مِن الزَّمانِ، والجَوْرِ مِن السُّلْطانِ، والخيانةِ مِن وُلاةِ الأحكامِ، والصَّولةِ مِن العَدُوِّ",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح الإسناد إن كان عبد الله بن أبي مليكة سمع من أمير المؤمنين عليه السلام","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"NnOABwBY"},{"id":"س-06130","fp":"c3ec50cdd921","stateId":488,"easy":"إذا بخس قوم المكيال والميزان ← أُخذوا بالسنين وشدة المؤونة وجور السلطان","cause":"وما بخَس قومٌ المكيالَ والميزانَ","result":"إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ","explicit":true,"otherNeedIds":[3],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، ",["وما بخَس قومٌ المكيالَ والميزانَ",1]," ؛ ",["إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ",2]," ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06131","fp":"aabd50b9e571","stateId":488,"easy":"إذا حكم الأمراء بغير ما أنزل الله ← سلط الله عليهم عدوهم","cause":"ولا حكم أمراؤهم بغير ما أنزل اللهُ","result":"إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم","explicit":true,"otherNeedIds":[39],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ",["ولا حكم أمراؤهم بغير ما أنزل اللهُ",1]," ؛ ",["إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم",2]," ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06151","fp":"820a84fb2654","stateId":488,"easy":"إذا فشت الفاحشة في قوم ← أخذهم الله بالموت","cause":"ولا فشتِ الفاحشةُ في قومٍ","result":"إلا أخذهم اللهُ بالموتِ","explicit":true,"repOf":"س-04976","ref":"السلسلة الصحيحة 1/219","text":["عن ابنِ عباسٍ قال : ما نقض قومٌ العهدَ إلا سلَّط اللهُ عليهم عدوَّهم ",["ولا فشتِ الفاحشةُ في قومٍ",1]," ",["إلا أخذهم اللهُ بالموتِ",2]," وما طفَّف قومٌ الميزانَ إلا أخذَهم اللهُ بالسِّنينَ وما منع قومٌ الزكاةَ إلا منعَهم اللهُ القطرَ من السماءِ وما جار قومٌ في حكمٍ إلا كان البأسُ بينهم أظنُّه قال : والقتلُ"],"grade":"صحيح","narrator":"عبدالله بن بريدة بن الحصيب الأسلمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي (6470) واللفظ له.","bab":"زكاة › عقوبة مانع الزكاة","dorar":"4yZchCL2"},{"id":"س-06955","fp":"7b437d9e4092","stateId":488,"easy":"إذا شاع الزنا والربا في قرية ← فقد أحلّت بنفسها غضب الله","cause":"إذا شاعَ الزِّنا والرِّبا في قريةٍ","result":"فقد أحلَّت بنَفسِها غضبَ اللهِ","explicit":true,"repOf":"س-08278","ref":"فقه السيرة 342","text":[["إذا شاعَ الزِّنا والرِّبا في قريةٍ ",1],["فقد أحلَّت بنَفسِها غضبَ اللهِ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (1/179) (462)، والحاكم (2261) باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"wCyBInaA"},{"id":"س-07276","fp":"cf3eb5461129","stateId":488,"easy":"إذا كان أمراؤكم شراركم وأغنياؤكم بخلاءكم وأموركم إلى نسائكم ← فبطن الأرض خير لكم من ظهرها","cause":"وإذا كانت أمراؤكم شرارُكم وكان أغنياؤكم بخلاءكم وكانت أمورُكم إلى نسائِكم","result":"فبطنُ الأرضِ خيرٌ لكم من ظهْرها","explicit":true,"ref":"مسند عمر 1/113","srcLabel":"الترمذي","text":["إذا كانت أمراؤكم خيارَكم وكان أغنياؤكم سمحاءَكم وكانت أموركُم شورى بينكم فظَهْرُ الأرضُ خيرٌ لكم من بطنها ",["وإذا كانت أمراؤكم شرارُكم وكان أغنياؤكم بخلاءكم وكانت أمورُكم إلى نسائِكم",1]," ",["فبطنُ الأرضِ خيرٌ لكم من ظهْرها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (2266)، والبزار (9529)، وأبو نعيم في ((حلية الأولياء)) (6/176)","bab":"فتن › ظهور الفتن","dorar":"LkxtpFNP"},{"id":"س-07297","fp":"9cb625d3463e","stateId":488,"easy":"إذا فعلت الأمة خمس عشرة خصلة (من المنكرات) ← حل بها البلاء","cause":"إذا فعلتْ أمَّتي خمسَ عشرةَ خَصلةً","result":"فقد حلَّ بها البلاءُ","explicit":true,"ref":"الترغيب والترهيب 4/75","srcLabel":"الترمذي","text":[["إذا فعلتْ أمَّتي خمسَ عشرةَ خَصلةً ",1],["فقد حلَّ بها البلاءُ ",2],". قيل : وما هي يا رسولَ اللهِ ؟ قال : إذا كان المغنَمُ دُوَلًا ، وإذا كانت الأمانةُ مَغنمًا ، والزَّكاةُ مَغرمًا ، وأطاع الرَّجلُ زوجتَه ، وعقَّ أمَّه ، وبرَّ صديقَه ، وجفا أباه ، وارتفعت الأصواتُ في المساجدِ ، وكان زعيمُ القومِ أرذلَهم ، وأُكرِم الرَّجلُ مخافةَ شرِّه ، وشُرِبتِ الخمرُ ، ولُبِس الحريرُ ، واتُّخِذتِ القَيناتُ والمعازفُ ، ولعن آخرُ هذه الأمَّةِ أوَّلَها ، فليرتقِبوا عند ذلك ريحًا حمراءَ ، أو خسفًا ، أو مسخًا"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2210)، وابن أبي الدنيا في ((ذم الملاهي)) (5)، وابن حبان في ((المجروحين)) (2/138)، والطبراني في ((المعجم الأوسط)) (469","bab":"فتن › ظهور الفتن","dorar":"bjtKhOK0"},{"id":"س-07483","fp":"082bfe7ddcb8","stateId":488,"easy":"إذا ظهرت المعازف والقينات واستُحلت الخمر ← يكون الخسف والقذف والمسخ","cause":"إذا ظَهَرَتِ المعازِفُ والقَيْناتُ ، واسْتُحِلَّتِ الخمْرُ","result":"خَسْفُ وقذفٌ ومَسْخٌ","explicit":true,"repOf":"س-01565","ref":"صحيح الجامع 3665","text":["سيكونُ في آخرِ الزمانِ ",["خَسْفُ وقذفٌ ومَسْخٌ",2]," ، ",["إذا ظَهَرَتِ المعازِفُ والقَيْناتُ ، واسْتُحِلَّتِ الخمْرُ",1]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي وأبو سعيد الخدري وعمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (6/ 150) (5810) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"vdr2mKh4"},{"id":"س-07494","fp":"6125cadf386f","stateId":488,"easy":"إذا أحب الناس اللبن (البادية) فتركوا الجماعات والجمع ← فهو هلاك الأمة","cause":"ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ","result":"هلاكُ أُمَّتي","explicit":true,"ref":"السلسلة الصحيحة 2778","srcLabel":"أحمد","text":[["هلاكُ أُمَّتي",2]," في الكِتابِ واللَّبَنِ، قالوا: يا رسولَ اللهِ، ما الكِتابُ واللَّبَنُ؟ قال: يتعلَّمونَ القرآنَ فيتأوَّلونَهُ على غيرِ ما أنزَلَ اللهُ عزَّ وجلَّ، ",["ويُحِبُّونَ اللَّبَنَ فيَدَعونَ الجماعاتِ والجُمَعَ ويَبْدُونَ",1],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17415)، وأبو يعلى (1746)، وابن عبدالبر في ((جامع بيان العلم وفضله)) (2359)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"PDj6GIAR"},{"id":"س-08253","fp":"068668bf31fe","stateId":488,"easy":"إذا أشاع قوم الفاحشة ← يعمهم الله بالبلاء","cause":"ولا يشيعُ قومٌ قطُّ الفاحشةَ","result":"إلا عمَّهم اللهُ بالبلاء","explicit":true,"repOf":"س-04976","ref":"البداية والنهاية 5/218","text":["عن أنسِ بنِ مالكٍ قال لما بُويعَ أبو بكرٍ في السَّقيفةِ وكان الغدُ جلس أبو بكرٍ على المنبرِ وقام عمرُ فتكلَّم قبل أبي بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أيها الناسُ إني قد كنتُ قلتُ لكم بالأمسِ مقالةً ما كانت وما وجدتُها في كتاب اللهِ ولا كانت عهدًا عهِدها إليَّ رسولُ اللهِ ولكني كنتُ أرى أنَّ رسولَ اللهِ سيُدبِرُ أمرَنا يقول يكون آخرَنا واللهِ قد أبقى فيكم كتابَه الذي هدى به رسولَ اللهِ فإن اعتصمتُم به هداكم اللهُ لما كان هداه اللهُ له وأنَّ اللهَ قد جمع أمرَكم على خيرِكم صاحبِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وثاني اثنين إذ هما في الغار فقوموا فبايِعوه فبايع الناسُ أبا بكرٍ بيعةَ العامةِ بعد بيعةِ السَّقيفةِ ثم تكلم أبو بكرٍ فحمد اللهَ وأثنى عليه بما هو أهلُه ثم قال أما بعد أيها الناسُ فإني قد وُلِّيتُ عليكم ولستُ بخيرِكم فإن أحسنتُ فأَعِينوني وإن أسأتُ فقوِّموني الصدقُ أمانةٌ والكذبُ خيانةٌ والضعيفُ منكم قويٌّ عندي حتى أزيحَ عِلَّتَه إن شاء اللهُ والقويُّ فيكم ضعيفٌ حتى آخذَ منه الحقَّ إن شاء اللهُ لا يدعُ قومٌ الجهادَ في سبيل اللهِ إلا ضربَهم اللهُ بالذُّلِّ ",["ولا يشيعُ قومٌ قطُّ الفاحشةَ",1]," ",["إلا عمَّهم اللهُ بالبلاء",2]," أَطيعوني ما أَطعتُ اللهَ ورسولَه فإذا عصيتُ اللهَ ورسولَه فلا طاعةَ لي عليكم قوموا إلى صلاتِكم يرحمْكم اللهُ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه محمد بن إسحاق كما في ((السيرة)) لابن هشام (6/ 82)، والطبري في ((التاريخ)) (3/ 210) كلاهما بلفظه.","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"Fk8YWRPX"},{"id":"س-03907","fp":"ff9c8b186b65","stateId":488,"easy":"إذا كدت لنبي أو صالح ← يخسف الله بك (من قصة قارون)","cause":"أنْ أُرسِلَ إلى بَغِيِّ بني إسرائيلَ فنُرسِلَها إليه فتَرمِيهِ","result":"فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 3582","srcLabel":"ابن أبي شيبة","text":["عنِ ابنِ عبَّاسٍ رَضيَ اللهُ عنهُما قالَ: لمَّا أَتى موسى قومَهُ أَمَرَهُم بالزَّكاةِ فجَمَعَهم قارونُ، فقالَ لهم: جاءكم بالصَّلاةِ وجاءكم بأشياءَ، فاحْتَمَلتُموها فتحَمَّلوا أنْ تُعطوهُ أموالَكُم. فقالوا: لا نَحتَمِلُ أنْ نُعطيَهُ أموالَنا، فما تَرى؟ فقالَ لهم: أرى ",["أنْ أُرسِلَ إلى بَغِيِّ بني إسرائيلَ فنُرسِلَها إليه فتَرمِيهِ",1]," بأنَّه أرادَها على نَفسِها، فدعا اللهَ موسى عليهم، فأَمَرَ اللهُ الأرضَ أنْ تُطيعَهُ، فقالَ موسى للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعْقابِهم. فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى رُكَبِهِم، فجَعَلوا يقولونَ: يا موسى يا موسى، ثُمَّ قالَ للأرضِ: خُذيهِم، فأَخَذَتْهم إلى أعناقِهِم. فجعلوا يقولونَ: يا موسى يا موسى، فقالَ للأرضِ: خُذيهِم فأَخَذَتْهم فغَيَّبَتْهم، فأَوْحى اللهُ إلى موسى: يا موسى سَأَلكَ عِبادي وتضَرَّعوا إليكَ فلمْ تُجِبْهُم، وعِزَّتي لوْ أنَّهم دَعَوْني لأجَبْتُهم. قالَ ابنُ عبَّاسٍ: وذلك قولُ اللهِ عزَّ وجلَّ: {",["فَخَسَفْنَا بِهِ وَبِدَارِهِ الْأَرْضَ",2],"} [القصص: 81]، خَسَفَ به إلى الأرضِ السُّفلى."],"grade":"صحيح","narrator":"عبدالله بن الحارث","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن أبي شيبة (31843)، وابن أبي الدنيا في ((العقوبات)) (233) بلفظ مقارب","bab":"تفسير آيات › سورة القصص","dorar":"91tvWhgT","merged":2,"otherRefs":["فتح الباري لابن حجر 517/6 (صحيح)"]},{"id":"س-05140","fp":"05541e8857f3","stateId":488,"easy":"إذا تثاقلت عن الجهاد ← يُمسك عنك المطر (أثر ابن عباس)","cause":"فتَثاقَلوا","result":"فأُمسِكَ عنهم المطرُ؛ وكان عذابَهُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 2539","srcLabel":"أبو داوود","text":["سَألتُ ابنَ عبَّاسٍ رَضيَ اللهُ عنهُما عنْ قولِ اللهِ عزَّ وجلَّ: {إِلَّا تَنفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا} [التوبة: 39]، قالَ: استَنْفَرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ حَيًّا مِن أَحياءِ العربِ، ",["فتَثاقَلوا",1],"، ",["فأُمسِكَ عنهم المطرُ؛ وكان عذابَهُم",2],"."],"grade":"صحيح","narrator":"نجدة بن نفيع","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داوود (2506)، والطبري، وابن أبي حاتم في ((تفسيره)) (10033) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"rJCuAuU2","merged":2,"otherRefs":["المستدرك على الصحيحين 2588 (صحيح)"]},{"id":"س-07331","fp":"2eac58116cee","stateId":488,"easy":"إذا تركت الجهاد للأموال ← فهي التهلكة","cause":"الإقامةَ في أمْوالِنا، وإصلاحَها، وتَرْكَنا الغَزوَ","result":"فكانتِ التَّهلُكةُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 30/429","srcLabel":"أبو داود","text":["كنَّا بمَدينةِ الرُّومِ، فأخرَجوا إلينا صَفًّا عَظيمًا مِن الرُّومِ، وخَرَجَ مِثلُه أو أكثرُ، وعلى أهلِ مِصرَ عُقْبةُ بنُ عامرٍ صاحِبُ رسولِ اللهِ صلي الله عليه وسلم فحَمَلَ رَجُلٌ مِن المُسلمينَ على صَفِّ الرُّومِ حتى دَخَلَ فيهم، فصاح به النَّاسُ، وقالوا: سُبحانَ اللهِ! تُلقي بيَدِكَ إلى التَّهلُكةِ؟! فقام أبو أيُّوبَ الأنصاريُّ، فقال: أيُّها النَّاسُ، إنَّكم تَتأوَّلونَ هذه الآيةَ على هذا التَّأْويلِ؛ إنَّما نَزَلَتْ هذه الآيةُ فينا مَعشرَ الأنصارِ، إنَّا لمَّا أعَزَّ اللهُ الإسلامَ، وكَثَّرَ ناصريه، قُلْنا بعضُنا لبعضٍ سِرًّا مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ أمْوالَنا قد ضاعتْ، وإنَّ اللهَ قد أعَزَّ الإسلامَ، وكَثَّرَ ناصريه، فلو أقَمْنا في أمْوالِنا، فأصلَحْنا ما ضاع منَّا، فأنزَلَ اللهُ على نَبيِّه صلَّى اللهُ عليه وسلَّمَ يَرُدُّ علينا ما قُلْنا: {وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ} [البقرة: 195]، ",["فكانتِ التَّهلُكةُ",2]," ",["الإقامةَ في أمْوالِنا، وإصلاحَها، وتَرْكَنا الغَزوَ",1],"، قال: وما زال أبو أيُّوبَ شاخصًا في سَبيلِ اللهِ، حتى دُفِنَ بأرضِ الرُّومِ."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2512)، والترمذي (2972)، والنسائي في ((السنن الكبرى)) (11029) باختلاف يسير، وابن حبان (4711) واللفظ له","bab":"فتن › فتنة المال","dorar":"mL3pbkWE","merged":2,"otherRefs":["تخريج مشكل الآثار 4685 (صحيح)"]},{"id":"س-03953","fp":"5382cf5daf8b","stateId":488,"easy":"إذا عصيت أمر الجهاد جبناً ← تُحرم الخير وتتيه (من قصة بني إسرائيل)","cause":"إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا","result":"فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[50],"ref":"إتحاف الخيرة المهرة 6/234","srcLabel":"النسائي","text":["سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه رِيحُ فَمِ الصَّائمِ، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ أطيبُ عندي مِن رِيحِ المِسْكِ؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، فاعتَرَفوا بها، وفعَلوا ما أُمِروا، وغفَرَ اللهُ للقاتِلِ والمقتولِ. ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى ",["إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا",1]," إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، ",["فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ",2],"؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11263)، وأبو يعلى (2618)، والطحاوي في ((شرح مشكل الآثار)) (66) بنحوه.","bab":"تفسير آيات › سورة طه","dorar":"n97bkyvU"},{"id":"س-04841","fp":"1f2b9f2e3d8a","stateId":488,"easy":"إذا بات قوم على أكل ولهو ولعب (بالمحرمات) ← يصبحون قردة وخنازير","cause":"لَيَبيتَنَّ أقوامٌ مِنَ أُمَّتِي على أكلٍ ولَهْوٍ ولعِبٍ","result":"ثُمَّ لَيُصْبِحُنَّ قردةً وخنازيرَ","explicit":true,"ref":"صحيح الجامع 5354","srcLabel":"الطبراني","text":[["لَيَبيتَنَّ أقوامٌ مِنَ أُمَّتِي على أكلٍ ولَهْوٍ ولعِبٍ",1]," ، ",["ثُمَّ لَيُصْبِحُنَّ قردةً وخنازيرَ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/ 256) (7997) واللفظ له، وابن أبي الدنيا في ((ذم الملاهي)) (3)، والبيهقي في ((شعب الإيمان)) (5226) مطولا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"RbPbPF7m"},{"id":"س-05202","fp":"0e67ea6e481a","stateId":488,"easy":"إذا تداويت بحرام ← لم يجعل الله لك فيه شفاء","cause":"من تداوى بحرامٍ","result":"لم يجعلِ اللهُ له فيه شفاءً","explicit":true,"ref":"السلسلة الصحيحة 2881","srcLabel":"أبو نعيم","text":[["من تداوى بحرامٍ ",1],["لم يجعلِ اللهُ له فيه شفاءً",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن بجموع الطرق","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (53)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"TqMn9LWI"},{"id":"س-05246","fp":"7ce455c00848","stateId":488,"easy":"إذا لم تغزُ أو تجهز غازياً أو تخلفه بخير ← يصيبك الله بقارعة قبل الموت","cause":"ما مِن مُسلِمٍ لا يَغْزو، أو يُجهِّزُ غازيًا، أو يَخلُفُه بخَيرٍ","result":"إلَّا أصابَهُ اللهُ بقارِعةٍ قبْلَ المَوتِ","explicit":true,"repOf":"س-04361","ref":"تخريج سير أعلام النبلاء 4/247","text":[["ما مِن مُسلِمٍ لا يَغْزو، أو يُجهِّزُ غازيًا، أو يَخلُفُه بخَيرٍ،",1]," ",["إلَّا أصابَهُ اللهُ بقارِعةٍ قبْلَ المَوتِ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رجاله ثقات خلا عبد الملك","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (796)، وابن عساكر في ((تاريخ دمشق)) (37/ 111) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"8fu8SWyZ"},{"id":"س-05932","fp":"c72b73c6645f","stateId":488,"easy":"إذا تفرقتم ← فالفرقة عذاب","cause":"والفُرقةُ","result":"عذابٌ","explicit":true,"otherNeedIds":[39],"ref":"تخريج كتاب السنة 895","srcLabel":"أبن","text":["أن النبيَّ خطب فقال : الجماعةُ رحمةٌ ",["والفُرقةُ",1]," ",["عذابٌ",2]],"grade":"حسن","narrator":"النعمان بن بشير","muhaddith":"إسناده حسن","takhrij":"أخرجه أبن أبي عاصم في ((السنة)) (895)، وابن بطة في ((الإبانة)) (117)، والقضاعي في ((مسند الشهاب)) (15) جميعا بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"4oZliEJJ"},{"id":"س-06430","fp":"092901fad1cb","stateId":488,"easy":"إذا شربت الخمر ← فهي مفتاح كل شر","cause":"ولا تشربنَ خمرًا","result":"فإِنَّها مِفْتَاحُ كلِّ شَرٍّ","explicit":true,"otherNeedIds":[12],"ref":"صحيح الترغيب 571","srcLabel":"صحيح الترغيب","text":["لا تُشْرِكْ باللهِ شيئًا ، و إنْ قُطِّعْتَ و حُرِّقْتَ ، و لا تَعْصِ و الدَيْكَ ، وإنْ أمرَاكَ أنْ تُخَلِّيَ من أهلِكَ ودُنياكَ فتخلَ ، ",["ولا تشربنَ خمرًا ، ",1],["فإِنَّها مِفْتَاحُ كلِّ شَرٍّ",2]," ، و لا تَتْرُكَنَّ صَّلاةَ مُتَعَمِّدًا ، فمَنْ فعلَ ذلكَ فقد بَرِئَتْ مِنْهُ ذِمَّةُ رَسُولِه الحديث"],"grade":"حسن","narrator":"أميمة مولاة النبي وقيل هي أم أيمن","muhaddith":"حسن لغيره","bab":"صلاة › تارك الصلاة","dorar":"ZhFLBH14"},{"id":"س-06931","fp":"f3ed4016d3bc","stateId":488,"easy":"إذا زنيت ← ففيه ست خصال: ثلاث في الدنيا (ذهاب البهاء والفقر وقصر العمر) وثلاث في الآخرة","cause":"إياكم والزنا","result":"فإنَّ في الزنا ستَّ خصالٍ ثلاثٌ في الدنيا وثلاثٌ في الآخرةِ ، فأما اللواتي في دارِ الدنيا فذهابُ نورِ الوجهِ ، وانقطاعُ الرزقِ ، وسرعةُ الفناءِ ، وأما اللواتي في الآخرةِ فغضبُ الربِّ ، وسوءُ الحسابِ ، والحلولُ في النارِ","explicit":true,"otherNeedIds":[3,57],"ref":"تاريخ بغداد 12/491","srcLabel":"ابن الجوزي","text":[["إياكم والزنا ",1],["فإنَّ في الزنا ستَّ خصالٍ ثلاثٌ في الدنيا وثلاثٌ في الآخرةِ ، فأما اللواتي في دارِ الدنيا فذهابُ نورِ الوجهِ ، وانقطاعُ الرزقِ ، وسرعةُ الفناءِ ، وأما اللواتي في الآخرةِ فغضبُ الربِّ ، وسوءُ الحسابِ ، والحلولُ في النارِ",2]," ، إلا أنْ يشاءَ اللهُ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده كلهم ثقات سوى كعب","takhrij":"أخرجه ابن الجوزي في ((الموضوعات)) (3/107)، والسيوطي في ((اللآلىء المصنوعة)) (2/162) واللفظ لهما.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"F5vneFcQ"},{"id":"س-07423","fp":"0ab892959664","stateId":488,"easy":"إذا داهن خياركم فجاركم وصار الفقه في شراركم ← تلبسكم الفتنة","cause":"إذا دَاهَنَ خيارُكُم فجارَكم وصار الفقهُ في شرارِكم","result":"فعندَ ذلِكَ تَلْبِسُكُم فتنةٌ","explicit":true,"otherNeedIds":[15],"ref":"مجمع الزوائد 7/289","srcLabel":"الطبراني","text":["قلتُ للنَّبِيِّ صلَّى اللهُ عليه وسلَّم يا رسولَ اللهِ متى يُتْرَكُ الأمرُ بالمعروفِ والنَّهْيُ عنِ المنكرِ وهما سيِّدَا أعمالِ أهلِ البرِّ قال إذا أصابَكم ما أَصابَ بني إسرائيلَ قلْتُ يا رسولَ اللهِ وما أَصابَ بني إسرائيلَ قال ",["إذا دَاهَنَ خيارُكُم فجارَكم وصار الفقهُ في شرارِكم",1]," وصار الملْكُ في صغارِكم ",["فعندَ ذلِكَ تَلْبِسُكُم فتنةٌ",2]," تَكِرُّونَ ويُكَرُّ علَيْكُمْ"],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"فيه عمار بن سيف وبقية رجاله ثقات وفي بعضهم خلاف","takhrij":"أخرجه الطبراني في ((الأوسط)) (144) واللفظ له.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"xEI82IWL"},{"id":"س-07540","fp":"9ecade33b770","stateId":488,"easy":"إذا تتبعت آثار الأنبياء لتتخذها مساجد ← فبهذا هلك بنو إسرائيل","cause":"أتريدونَ أن تتَّخذوا آثارَ أنبيائِكم مساجدَ","result":"إنَّما هلَكَ بنو إسرائيلَ بِهذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجموع الفتاوى 27/171","srcLabel":"مجموع الفتاوى","text":["أنَّهُ كانَ في سفرٍ فرأى قومًا ينتابونَ بقعةً يصلُّونَ فيها فقالَ ما هذا فقالوا هذا مَكانٌ صلَّى فيهِ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّم. فقالَ ومَكانٌ صلَّى بِهِ رسولُ اللَّهِ صلَّى اللَّهُ عليْهِ وسلَّمَ ",["أتريدونَ أن تتَّخذوا آثارَ أنبيائِكم مساجدَ",1],"؟ ",["إنَّما هلَكَ بنو إسرائيلَ بِهذا",2],". من أدرَكتْهُ فيهِ الصَّلاةُ فليصلِّ وإلَّا فليمضِ"],"grade":"صحيح","muhaddith":"ثابت عن عمر","bab":"فضائل النبي وصفته ودلائل النبوة › تبرك الناس به","dorar":"MefojJmT"},{"id":"س-07657","fp":"a14db20b5bc6","stateId":488,"easy":"إذا كذبت الأمة بالقدر ← يكون فيها خسف ومسخ","cause":"في المُكَذِّبينَ بالقدَرِ","result":"يَكونُ في أمَّتي خَسفٌ ، ومَسخٌ","explicit":true,"ref":"هداية الرواة 102","srcLabel":"الترمذي","text":[["يَكونُ في أمَّتي خَسفٌ ، ومَسخٌ",2]," ، وذلِكَ ",["في المُكَذِّبينَ بالقدَرِ",1]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"إسناده حسن","takhrij":"أخرجه الترمذي (2153) واللفظ له، وابن ماجه (4061) باختلاف يسير، وأحمد (6208) بنحوه","bab":"قدر › التكذيب بالقدر","dorar":"zReyhSqi"},{"id":"س-08074","fp":"b9fe7f65ca77","stateId":488,"easy":"إذا ظهر الزنا والربا في قرية ← فقد أحلّوا بأنفسهم عقاب الله","cause":"إذا ظهَرَ الزِّنَى والرِّبَا في قريَةٍ","result":"فقدْ أَحَلُّوا بِأَنْفُسِهِمْ عِقَابَ اللهِ عزَّ وجلَّ","explicit":true,"repOf":"س-08278","ref":"مجمع الزوائد 4/121","text":[["إذا ظهَرَ الزِّنَى والرِّبَا في قريَةٍ",1]," ",["فقدْ أَحَلُّوا بِأَنْفُسِهِمْ عِقَابَ اللهِ عزَّ وجلَّ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"فيه هاشم بن مرزوق ولم أجد من ترجمه وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (1/179) (462)، والحاكم (2261) باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"d0DGDVzA"},{"id":"س-01671","fp":"0390545d3802","stateId":488,"easy":"إذا لم يكن في الأمة من يأخذ للضعيف حقه ← لا يقدّسها الله","cause":"ليس فيه مَن يأخُذُ للضَّعيفِ حَقَّه","result":"إنَّ اللهَ لا يُقدِّسُ أُمَّةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"similar":["س-01670"],"otherNeedIds":[27],"ref":"خلاصة البدر المنير 2/425","srcLabel":"مسلم","text":[["إنَّ اللهَ لا يُقدِّسُ أُمَّةً",2]," ",["ليس فيه مَن يأخُذُ للضَّعيفِ حَقَّه",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده على شرط مسلم","takhrij":"أخرجه ابن ماجة (4010)، وابن حبان (5058)، وأبو يعلى (2003) بلفظه في آخر حديث طويل.","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"b4HsV2tE"},{"id":"س-06232","fp":"3751ed24d4a5","stateId":488,"easy":"إذا أصبت شيئاً بغير إذن ← تأتي بما غللت يوم القيامة","cause":"لا تُصيبنَّ شيئًا بغيرِ إذني","result":"يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"العلل الكبير 200","srcLabel":"الترمذي","text":["بعثني رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فلمَّا سِرتُ أرسَل في أثري فرددْتُ فقال : أتدري لم بعثتُ إليك ؟ ",["لا تُصيبنَّ شيئًا بغيرِ إذني",1]," فإنَّه غُلولٌ { وَمَنْ يَغْلُلْ ",["يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ",2]," } لهذا دعوْتُك فامضِ لعملِك"],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أخرجه الترمذي (1335) واللفظ له، والبزار (2673)، والطبراني (20/128) (259)","bab":"سرايا › تأمير الأمراء على البعوث والسرايا ووصيتهم","dorar":"65J5adXY"},{"id":"س-07346","fp":"45f33534f49c","stateId":488,"easy":"إذا اختلفتم في الغنيمة وساءت أخلاقكم ← ينتزعها الله منكم","cause":"اختلَفنا في الغنيمةِ وساءت أخلاقُنا","result":"انتزعَها اللَّهُ منَّا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح الباري لابن حجر 730/6","srcLabel":"فتح الباري لابن حجر","text":["عن عُبادةَ بنِ الصَّامتِ قالَ: فلمَّا ",["اختلَفنا في الغنيمةِ وساءت أخلاقُنا",1]," ",["انتزعَها اللَّهُ منَّا",2]," فجعلَها لرسولِهِ فقَسمَها على النَّاسِ سواءٍ"],"grade":"حسن","muhaddith":"إسناده حسن يحتج بمثله","bab":"فتن › كراهية الاختلاف","dorar":"b4oHy0bU"},{"id":"س-01670","fp":"1b23c74031f3","stateId":488,"easy":"إذا لم يأخذ الضعيف حقه من القوي ← لا يقدّس الله الأمة","cause":"لا يَأْخَذُ ضعيفُها حقَّهُ من قَوِيِّها","result":"كيفَ يُقَدِّسُ اللهُ أُمَّةً","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01671","otherNeedIds":[27],"ref":"صحيح الجامع 4597","text":[["كيفَ يُقَدِّسُ اللهُ أُمَّةً",2]," ",["لا يَأْخَذُ ضعيفُها حقَّهُ من قَوِيِّها",1]," ، و هو غيرُ متَعْتَعٍ ؟"],"grade":"صحيح","narrator":"بريدة بن الحصيب وأبو سعيد الخدري وأبو سفيان","muhaddith":"صحيح","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"c8sMtynO"},{"id":"س-07284","fp":"fd631e886813","stateId":488,"easy":"إذا اقتتل المسلمون ← يركبون سنن من كان قبلهم في الهلاك","cause":"وإنْ يَقتَتِلوا","result":"يَركَبوا سُنَنَ مَن كان قبلَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج مشكل الآثار 1612","srcLabel":"أبو داود","text":["إنَّ رَحى الإسلامِ ستَزولُ بعدَ خَمسٍ وثلاثينَ، فإنْ يَصطَلِحوا فيما بينَهم على غيرِ قتالٍ يَأكُلوا الدُّنيا سَبعين عامًا رَغدًا، ",["وإنْ يَقتَتِلوا",1]," ",["يَركَبوا سُنَنَ مَن كان قبلَهم",2],"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4254)، وأحمد (3707) باختلاف يسير","bab":"فتن › ظهور الفتن","dorar":"UyCZBOkr"},{"id":"ق-0185","fp":"2e31fe320642","stateId":489,"easy":"مخالفة الأمر والمعصية ← المصيبة والهزيمة (هو من عند أنفسكم)","cause":"مخالفة الأمر والمعصية","result":"المصيبة والهزيمة (هو من عند أنفسكم)","explicit":true,"star":true,"otherNeedIds":[39],"ref":"سورة آل عمران: 165","srcLabel":"القرآن الكريم","quran":{"s":3,"from":165,"to":165,"text":"أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّى هَذَا قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ إِنَّ اللَّهَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (165)","hl":[[0,119,1]]}},{"id":"ق-0226","fp":"10e821698127","stateId":489,"easy":"الإعراض عن حكم الله ورسوله ← المصيبة بما قدمت الأيدي","cause":"الإعراض عن حكم الله ورسوله","result":"المصيبة بما قدمت الأيدي","explicit":true,"star":true,"ref":"سورة النساء: 62","srcLabel":"القرآن الكريم","quran":{"s":4,"from":62,"to":62,"text":"فَكَيْفَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ ثُمَّ جَاءُوكَ يَحْلِفُونَ بِاللَّهِ إِنْ أَرَدْنَا إِلَّا إِحْسَانًا وَتَوْفِيقًا (62)","hl":[[0,66,1]]}},{"id":"ق-0232","fp":"fd4a3eea2aad","stateId":489,"easy":"ذنب العبد (من نفسه) ← السيئة والمصيبة","cause":"ذنب العبد (من نفسه)","result":"السيئة والمصيبة","explicit":true,"star":true,"ref":"سورة النساء: 79","srcLabel":"القرآن الكريم","quran":{"s":4,"from":79,"to":79,"text":"مَا أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ اللَّهِ وَمَا أَصَابَكَ مِنْ سَيِّئَةٍ فَمِنْ نَفْسِكَ وَأَرْسَلْنَاكَ لِلنَّاسِ رَسُولًا وَكَفَى بِاللَّهِ شَهِيدًا (79)","hl":[[43,89,1]]}},{"id":"ق-0294","fp":"bf7648bdb975","stateId":489,"easy":"الذنوب مع دعوى القرب من الله ← التعذيب بها","cause":"الذنوب مع دعوى القرب من الله","result":"التعذيب بها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة المائدة: 18","srcLabel":"القرآن الكريم","quran":{"s":5,"from":18,"to":18,"text":"وَقَالَتِ الْيَهُودُ وَالنَّصَارَى نَحْنُ أَبْنَاءُ اللَّهِ وَأَحِبَّاؤُهُ قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ بَلْ أَنْتُمْ بَشَرٌ مِمَّنْ خَلَقَ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا وَإِلَيْهِ الْمَصِيرُ (18)","hl":[[75,114,1]]}},{"id":"ق-0312","fp":"054051523b21","stateId":489,"easy":"التولي عن حكم الله ← الإصابة ببعض الذنوب","cause":"التولي عن حكم الله","result":"الإصابة ببعض الذنوب","explicit":true,"star":true,"ref":"سورة المائدة: 49","srcLabel":"القرآن الكريم","quran":{"s":5,"from":49,"to":49,"text":"وَأَنِ احْكُمْ بَيْنَهُمْ بِمَا أَنْزَلَ اللَّهُ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ وَاحْذَرْهُمْ أَنْ يَفْتِنُوكَ عَنْ بَعْضِ مَا أَنْزَلَ اللَّهُ إِلَيْكَ فَإِنْ تَوَلَّوْا فَاعْلَمْ أَنَّمَا يُرِيدُ اللَّهُ أَنْ يُصِيبَهُمْ بِبَعْضِ ذُنُوبِهِمْ وَإِنَّ كَثِيرًا مِنَ النَّاسِ لَفَاسِقُونَ (49)","hl":[[152,242,1]]}},{"id":"ق-0345","fp":"41645c49663b","stateId":489,"easy":"الذنوب مع التمكين والنعمة ← الإهلاك واستبدال قرن آخر","cause":"الذنوب مع التمكين والنعمة","result":"الإهلاك واستبدال قرن آخر","explicit":true,"ref":"سورة الأنعام: 6","srcLabel":"القرآن الكريم","quran":{"s":6,"from":6,"to":6,"text":"أَلَمْ يَرَوْا كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ مَكَّنَّاهُمْ فِي الْأَرْضِ مَا لَمْ نُمَكِّنْ لَكُمْ وَأَرْسَلْنَا السَّمَاءَ عَلَيْهِمْ مِدْرَارًا وَجَعَلْنَا الْأَنْهَارَ تَجْرِي مِنْ تَحْتِهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَنْشَأْنَا مِنْ بَعْدِهِمْ قَرْنًا آخَرِينَ (6)","hl":[[210,288,1]]}},{"id":"ق-0419","fp":"19a35f989bf7","stateId":489,"easy":"الذنوب ← الإصابة بها والطبع على القلوب","cause":"الذنوب","result":"الإصابة بها والطبع على القلوب","explicit":true,"otherNeedIds":[19],"ref":"سورة الأعراف: 100","srcLabel":"القرآن الكريم","quran":{"s":7,"from":100,"to":100,"text":"أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ الْأَرْضَ مِنْ بَعْدِ أَهْلِهَا أَنْ لَوْ نَشَاءُ أَصَبْنَاهُمْ بِذُنُوبِهِمْ وَنَطْبَعُ عَلَى قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ (100)","hl":[[69,166,1]]}},{"id":"ق-0694","fp":"09ecd3c69c7e","stateId":489,"easy":"الإساءة ← وبالها على النفس","cause":"الإساءة","result":"وبالها على النفس","explicit":true,"ref":"سورة الإسراء: 7","srcLabel":"القرآن الكريم","quran":{"s":17,"from":7,"to":7,"text":"إِنْ أَحْسَنْتُمْ أَحْسَنْتُمْ لِأَنْفُسِكُمْ وَإِنْ أَسَأْتُمْ فَلَهَا فَإِذَا جَاءَ وَعْدُ الْآخِرَةِ لِيَسُوءُوا وُجُوهَكُمْ وَلِيَدْخُلُوا الْمَسْجِدَ كَمَا دَخَلُوهُ أَوَّلَ مَرَّةٍ وَلِيُتَبِّرُوا مَا عَلَوْا تَتْبِيرًا (7)","hl":[[46,71,1]]}},{"id":"ق-0920","fp":"f9bf79644c36","stateId":489,"easy":"ما قدمت الأيدي ← المصيبة","cause":"ما قدمت الأيدي","result":"المصيبة","explicit":true,"similar":["ق-0957","ق-1164"],"ref":"سورة القصص: 47","srcLabel":"القرآن الكريم","quran":{"s":28,"from":47,"to":47,"text":"وَلَوْلَا أَنْ تُصِيبَهُمْ مُصِيبَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَيَقُولُوا رَبَّنَا لَوْلَا أَرْسَلْتَ إِلَيْنَا رَسُولًا فَنَتَّبِعَ آيَاتِكَ وَنَكُونَ مِنَ الْمُؤْمِنِينَ (47)","hl":[[0,64,1]]}},{"id":"ق-0946","fp":"44947f78c84d","stateId":489,"easy":"الاستكبار والذنوب ← أخذ كلٍّ بذنبه: حاصب وصيحة وخسف وإغراق","cause":"الاستكبار والذنوب","result":"أخذ كلٍّ بذنبه: حاصب وصيحة وخسف وإغراق","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة العنكبوت: 40","srcLabel":"القرآن الكريم","quran":{"s":29,"from":40,"to":40,"text":"فَكُلًّا أَخَذْنَا بِذَنْبِهِ فَمِنْهُمْ مَنْ أَرْسَلْنَا عَلَيْهِ حَاصِبًا وَمِنْهُمْ مَنْ أَخَذَتْهُ الصَّيْحَةُ وَمِنْهُمْ مَنْ خَسَفْنَا بِهِ الْأَرْضَ وَمِنْهُمْ مَنْ أَغْرَقْنَا وَمَا كَانَ اللَّهُ لِيَظْلِمَهُمْ وَلَكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ (40)","hl":[[0,260,1]]}},{"id":"ق-0957","fp":"37b11eded901","stateId":489,"easy":"ما قدمت الأيدي ← السيئة تصيبهم","cause":"ما قدمت الأيدي","result":"السيئة تصيبهم","explicit":true,"repOf":"ق-0920","ref":"سورة الروم: 36","quran":{"s":30,"from":36,"to":36,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً فَرِحُوا بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ إِذَا هُمْ يَقْنَطُونَ (36)","hl":[[51,106,1]]}},{"id":"ق-0961","fp":"3145bccd4201","stateId":489,"easy":"كسب أيدي الناس من الذنوب ← ظهور الفساد في البر والبحر","cause":"كسب أيدي الناس من الذنوب","result":"ظهور الفساد في البر والبحر","explicit":true,"otherNeedIds":[3],"ref":"سورة الروم: 41","srcLabel":"القرآن الكريم","quran":{"s":30,"from":41,"to":41,"text":"ظَهَرَ الْفَسَادُ فِي الْبَرِّ وَالْبَحْرِ بِمَا كَسَبَتْ أَيْدِي النَّاسِ لِيُذِيقَهُمْ بَعْضَ الَّذِي عَمِلُوا لَعَلَّهُمْ يَرْجِعُونَ (41)","hl":[[0,136,1]]}},{"id":"ق-0981","fp":"638764cd5e2c","stateId":489,"easy":"المعصية ← العذاب الأدنى دون الأكبر ليرجعوا","cause":"المعصية","result":"العذاب الأدنى دون الأكبر ليرجعوا","explicit":true,"ref":"سورة السجدة: 21","srcLabel":"القرآن الكريم","quran":{"s":32,"from":21,"to":21,"text":"وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ الْأَدْنَى دُونَ الْعَذَابِ الْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ (21)","hl":[[0,98,1]]}},{"id":"ق-1157","fp":"706a4b37f642","stateId":489,"easy":"الكسب السيئ ← الإيباق (الإهلاك) في البحر","cause":"الكسب السيئ","result":"الإيباق (الإهلاك) في البحر","explicit":true,"ref":"سورة الشورى: 34","srcLabel":"القرآن الكريم","quran":{"s":42,"from":34,"to":34,"text":"أَوْ يُوبِقْهُنَّ بِمَا كَسَبُوا وَيَعْفُ عَنْ كَثِيرٍ (34)","hl":[[0,54,1]]}},{"id":"ق-1164","fp":"2a539a97f025","stateId":489,"easy":"ما قدمت الأيدي ← السيئة تصيبهم","cause":"ما قدمت الأيدي","result":"السيئة تصيبهم","explicit":true,"repOf":"ق-0920","ref":"سورة الشورى: 48","quran":{"s":42,"from":48,"to":48,"text":"فَإِنْ أَعْرَضُوا فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا إِنْ عَلَيْكَ إِلَّا الْبَلَاغُ وَإِنَّا إِذَا أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً فَرِحَ بِهَا وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ الْإِنْسَانَ كَفُورٌ (48)","hl":[[157,212,1]]}},{"id":"ق-1165","fp":"ce6e4984ba08","stateId":489,"easy":"الاستهزاء بالأنبياء ← إهلاك من هم أشد بطشاً","cause":"الاستهزاء بالأنبياء","result":"إهلاك من هم أشد بطشاً","explicit":true,"ref":"سورة الزخرف: 6–8","srcLabel":"القرآن الكريم","quran":{"s":43,"from":6,"to":8,"text":"وَكَمْ أَرْسَلْنَا مِنْ نَبِيٍّ فِي الْأَوَّلِينَ (6) وَمَا يَأْتِيهِمْ مِنْ نَبِيٍّ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ (7) فَأَهْلَكْنَا أَشَدَّ مِنْهُمْ بَطْشًا وَمَضَى مَثَلُ الْأَوَّلِينَ (8)","hl":[[0,49,1]]}},{"id":"ق-1380","fp":"71e17953ea5c","stateId":489,"easy":"الخطايا ← الإغراق ودخول النار بلا أنصار","cause":"الخطايا","result":"الإغراق ودخول النار بلا أنصار","explicit":true,"otherNeedIds":[57,59],"ref":"سورة نوح: 25","srcLabel":"القرآن الكريم","quran":{"s":71,"from":25,"to":25,"text":"مِمَّا خَطِيئَاتِهِمْ أُغْرِقُوا فَأُدْخِلُوا نَارًا فَلَمْ يَجِدُوا لَهُمْ مِنْ دُونِ اللَّهِ أَنْصَارًا (25)","hl":[[0,105,1]]}},{"id":"س-06887","fp":"4c7c4e5842c6","stateId":489,"easy":"إذا جحدت نعمة الله ← يصيّرك الله إلى ما كنت (من قصة الأبرص والأقرع والأعمى)","cause":"فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ","result":"إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"صحيح مسلم 2964","srcLabel":"البخاري","text":["إنَّ ثَلاثةً في بَني إسرائيلَ: أبرَصَ، وأقرَعَ، وأعمى، فأرادَ اللهُ أن يَبتَليَهم، فبَعَثَ إليهم مَلَكًا، فأتى الأبرَصَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: لَونٌ حَسَنٌ، وجِلدٌ حَسَنٌ، ويَذهَبُ عَنِّي الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه قَذَرُه، وأُعطيَ لَونًا حَسَنًا وجِلدًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الإبِلُ أو قال البَقَرُ، شَكَّ إسحاقُ، إلَّا أنَّ الأبرَصَ أوِ الأقرَعَ، قال أحَدُهما: الإبِلُ، وقال الآخَرُ: البَقَرُ، قال: فأُعطيَ ناقةً عُشَراءَ، فقال: بارَك اللهُ لك فيها، قال: فأتى الأقرَعَ، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: شَعَرٌ حَسَنٌ، ويَذهَبُ عَنِّي هذا الذي قد قَذِرَني النَّاسُ، قال: فمَسَحَه فذَهَبَ عنه، وأُعطيَ شَعَرًا حَسَنًا، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: البَقَرُ، فأُعطيَ بَقَرةً حامِلًا، فقال: بارَك اللهُ لك فيها، قال: فأتى الأعمى، فقال: أيُّ شيءٍ أحَبُّ إلَيك؟ قال: أن يَرُدَّ اللهُ إلَيَّ بَصَري، فأُبصِرَ به النَّاسَ، قال: فمَسَحَه فرَدَّ اللهُ إليه بَصَرَه، قال: فأيُّ المالِ أحَبُّ إلَيك؟ قال: الغَنَمُ، فأُعطيَ شاةً والِدًا، فأُنتِجَ هذانِ وولَّدَ هذا، قال: فكانَ لهذا وادٍ مِنَ الإبِلِ، ولهذا وادٍ مِنَ البَقَرِ، ولهذا وادٍ مِنَ الغَنَمِ. قال: ثُمَّ إنَّه أتى الأبرَصَ في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ، قدِ انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ ثُمَّ بك، أسألُك بالذي أعطاك اللَّونَ الحَسَنَ والجِلدَ الحَسَنَ والمالَ، بَعيرًا أتَبَلَّغُ عليه في سَفَري، فقال: الحُقوقُ كَثيرةٌ، فقال له: كَأنِّي أعرِفُك، ألَم تَكُنْ أبرَصَ يَقذَرُك النَّاسُ؟ فقيرًا فأعطاك اللهُ؟ ",["فقال: إنَّما ورِثتُ هذا المالَ كابِرًا عن كابِرٍ",1],"، فقال: ",["إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ",2],". قال: وأتى الأقرَعَ في صورَتِه، فقال له مِثلَ ما قال لهذا، ورَدَّ عليه مِثلَ ما رَدَّ على هذا، فقال: إن كُنتَ كاذِبًا فصَيَّرَك اللهُ إلى ما كُنتَ، قال: وأتى الأعمى في صورَتِه وهَيئَتِه، فقال: رَجُلٌ مِسكينٌ وابنُ سَبيلٍ، انقَطَعَت بيَ الحِبالُ في سَفَري، فلا بَلاغَ لي اليومَ إلَّا باللهِ، ثُمَّ بك، أسألُك بالذي رَدَّ عليك بَصَرَك شاةً أتَبَلَّغُ بها في سَفَري، فقال: قد كُنتُ أعمى فرَدَّ اللهُ إلَيَّ بَصَري، فخُذْ ما شِئتَ، ودَعْ ما شِئتَ، فواللهِ لا أجهَدُك اليومَ شيئًا أخَذتَه للَّهِ، فقال: أمسِكْ مالَك، فإنَّما ابتُليتُم فقد رُضيَ عَنك وسُخِطَ على صاحِبَيك."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3464) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"xELD1ioR"},{"id":"س-00516","fp":"25de884cfcb4","stateId":489,"easy":"إذا استهنت بمحقرات الذنوب ← تجتمع عليك حتى تهلكك","cause":"إيَّاكُم ومحقَّراتِ الذُّنوبِ","result":"فإنَّهنَّ يجتَمعنَ على الرَّجلِ حتَّى يُهْلِكْنَه","explicit":true,"otherNeedIds":[12],"ref":"صحيح الترغيب 2470","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ قال : ",["إيَّاكُم ومحقَّراتِ الذُّنوبِ ، ",1],["فإنَّهنَّ يجتَمعنَ على الرَّجلِ حتَّى يُهْلِكْنَه",2]," وإنَّ رسولَ اللهِ ضرَبَ لهنَّ مثلًا : كمَثلِ قومٍ نزَلوا أرضَ فلاةٍ ، فحضَر صَنيعُ القَومِ ، فجعَل الرَّجلُ ينطَلقُ فيجيءُ بالعودِ ، والرَّجلُ يَجيءُ بالعودِ ، حتَّى جمعوا سَوادًا ، وأجَّجوا نارًا ، وأنضَجوا ما قذَفوا فيها"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (3818)، والطبراني (10/261) (10500)، والبيهقي في ((شعب الإيمان)) (7263) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"5ZPXSuXC","merged":2,"otherRefs":["الجامع الصغير 2902 (حسن)"]},{"id":"س-07749","fp":"f310f2b8405e","stateId":489,"easy":"إذا آثرت الدنيا على أمر الله ← تُعاقب","cause":"مِن أَخْذِهِمُ الفِداءَ","result":"عُوقِبوا بما صنَعوا يومَ بَدْرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح أسباب النزول 61","srcLabel":"مسلم","text":["حدَّثني عمرُ بنُ الخطَّابِ رَضِيَ اللهُ عنه، قال: لمَّا كان يومُ بَدْرٍ، قال: نظر النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ إلى أصحابِهِ وهُمْ ثلاثُ مئةٍ ونَيِّفٌ، ونظر إلى المشركينَ فإذا هُمْ ألفٌ وزيادةٌ، فاستقبَلَ النبيُّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ القِبلةَ، ثم مَدَّ يديْهِ وعليه رِداؤُهُ وإزارُهُ، ثم قال: اللَّهمَّ أينَ ما وَعَدْتَني؟ اللَّهمَّ أَنْجِزْ لي ما وَعَدْتَني، اللَّهمَّ إنَّكَ إنْ تُهلِكْ هذهِ العِصابةَ مِن أهلِ الإسلامِ، فلا تُعْبَدُ في الأرضِ أبدًا، قال: فما زال يَستَغيثُ ربَّهُ عزَّ وجلَّ ويَدْعوه حتى سَقَطَ رِداؤُهُ، فأتاهُ أبو بكرٍ رَضِيَ اللهُ عنه، فأخذ رِداءَهُ فرَدَّاهُ، ثم الْتَزَمَهُ مِن وَرائِهِ، ثم قال: يا نَبيَّ اللهِ، كَفاكَ مُناشَدَتُكَ ربَّكَ؛ فإنَّهُ سيُنْجِزُ لكَ ما وَعَدَكَ، وأنزل اللهُ عزَّ وجلَّ: {إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ} [الأنفال: 9]، فلمَّا كان يومئذٍ والْتَقَوْا، فهزم اللهُ عزَّ وجلَّ المشركينَ، فقُتِلَ مِنهُم سبعونَ رجُلًا، وأُسِرَ منهم سبعونَ رجُلًا، فاستشار رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ أبا بكرٍ وعليًّا وعُمرَ رَضِيَ اللهُ عنهم، فقال أبو بكرٍ رَضِيَ اللهُ عنه: يا رسولَ اللهِ، هؤلاءِ بَنو العَمِّ والعشيرةِ والإخوانِ؛ فإنِّي أرى أنْ تأخُذَ منهُمُ الفِديةَ، فيكونَ ما أخَذْنا منهم قُوَّةً لنا على الكُفَّارِ، وعسى اللهُ أنْ يَهديَهم؛ فيكونوا لنا عَضُدًا، فقال رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: ما ترى يا بنَ الخطَّابِ؟ قلتُ: واللهِ، ما أرى ما رأى أبو بكرٍ، ولكنِّي أرى أنْ تُمَكِّنَني مِن فُلانٍ -قريبًا لعُمرَ- فأضرِبَ عُنُقَهُ، وتُمَكِّنَ عليًّا رَضِيَ اللهُ عنه مِن عَقيلٍ فيضرِبَ عُنُقَهُ، وتُمَكِّنَ حمزةَ مِن فُلانٍ أخيه فيضرِبَ عُنُقَهُ؛ حتى يعلَمَ اللهُ أنَّه ليستْ في قُلوبِنا هَوادَةٌ للمشركينَ، هؤلاءِ صَناديدُهم وأئمَّتُهم وقادتُهم، فهَوِيَ رسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ ما قال أبو بكرٍ رَضِيَ اللهُ عنه، ولم يَهْوَ ما قلتُ؛ فأخَذَ مِنهُمُ الفِداءَ، فلمَّا أنْ كان مِنَ الغَدِ قال عمرُ رَضِيَ اللهُ عنه: غَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا هو قاعدٌ وأبو بكرٍ رَضِيَ اللهُ عنه، وإذا هما يبكيانِ، فقلتُ: يا رسولَ اللهِ، أَخبِرْني ماذا يُبكيكَ أنتَ وصاحبَكَ، فإنْ وجدْتُ بُكاءً بكيْتُ، وإنْ لم أجِدْ تَباكَيْتُ لبكائِكما، قال: فقال النبيُّ صلَّى اللهُ عليه وعلى آلِهِ وسلَّمَ: الذي عَرَضَ عليَّ أَصحابُكَ مِنَ الفِداءِ، لقد عُرِضَ عليَّ عذابُهم أَدْنَى مِن هذهِ الشَّجرةِ -لشجرةٍ قريبةٍ-، وأنزل اللهُ عزَّ وجلَّ: {مَا كَانَ لِنَبِيٍّ أَنْ يَكونَ لَهُ أَسْرَى حَتَّى يُثْخِنَ فِي الْأَرْضِ} [الأنفال: 67] إلى قولِهِ: {لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ} [الأنفال: 68] مِنَ الفِداءِ، ثُمَّ أحَلَّ اللهُ لهُمُ الغنائِمَ، فلمَّا كان يومُ أُحُدٍ مِنَ العامِ المُقْبِلِ ",["عُوقِبوا بما صنَعوا يومَ بَدْرٍ",2]," ",["مِن أَخْذِهِمُ الفِداءَ",1],"، فقُتِلَ مِنهُم سبعونَ، وفَرَّ أصحابُ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ عَنِ النبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، وكُسِرَتْ رَباعِيَتُهُ، وهُشِّمَتِ البَيْضةُ على رأسِهِ، وسال الدَّمُ على وجهِهِ، وأنزل اللهُ عزَّ وجلَّ: {أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا} [آل عمران: 165] بأخْذِكُمُ الفِداءَ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه مسلم (1763) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"FGoysDoa"},{"id":"س-03470","fp":"08207db1399a","stateId":489,"easy":"إذا ظهرت المعاصي في الأمة ← يعمهم الله بعذاب من عنده","cause":"إذا ظَهَرتِ المعاصي في أمَّتي","result":"عمَّهمُ اللَّهُ بعذابٍ من عندِهِ","explicit":true,"otherNeedIds":[57],"ref":"بذل الماعون 129","srcLabel":"أحمد","text":[["إذا ظَهَرتِ المعاصي في أمَّتي ",1],["عمَّهمُ اللَّهُ بعذابٍ من عندِهِ",2]," فقلتُ : يا رسولَ اللَّهِ أما فيهِم صالِحونَ ؟ قال : بلَى يصيبُهم ما أصابَ النَّاسُ ثُمَّ يصيرونَ إلى مغفِرةٍ من اللَّهِ ورضوانٍ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (26638)، والطبراني (23/325) (747) باختلاف يسير.","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"ppygNXk6"},{"id":"س-03902","fp":"6cd305a886c9","stateId":489,"easy":"إذا كفرت النعم ← تحل بك النقم","cause":"إيَّاكم وكُفرَ النِّعمِ","result":"فتَحِلَّ بكم النِّقمُ","explicit":true,"otherNeedIds":[3],"ref":"المستدرك على الصحيحين 3725","srcLabel":"الخطيب","text":["قالَ: خرَجْنا مع عَليِّ بنِ أبي طالبٍ حين توجَّهَ إلى معاويةَ بنِ أبي سُفيانَ قالَ: وجَريرُ بنُ سَهْمٍ التَّيْميُّ أمامَهُ يقولُ:\nيا فَرَسي سِيري، وأُمِّي الشَّاما ... واقْطَعِي الأحْقافَ والأعْلامَا\nوقاتِلي مَنْ خالَفَ الإماما ... إنِّي لأَرْجو إنْ لَقِينا العامَا\nجَمْعَ بني أُميَّةَ الطِّغاما ... أنْ نَقتُلَ القاضيَ والهُمامَا\nوأنْ نُزِيلَ مِن رِجالٍ هامَا\nفلمَّا وصَلْنا إلى المدائنِ قالَ جريرٌ:\nعَفَتِ الرِّياحُ على رُسومِ ديارِهِم ... فكأنَّهم كانوا على مِيعادِ\nقالَ: فقالَ لي عَليٌّ: كيف قلتَ يا أخا بني تَميمٍ؟ قالَ: فردَّ عليه البيتَ فقالَ عَليٌّ: ألا قلتَ: {كَمْ تَرَكُوا مِن جَنَّاتٍ وَعُيُونٍ (25) وَزُرُوعٍ وَمَقَامٍ كَرِيمٍ (26) وَنَعْمَةٍ كَانُوا فِيهَا فَاكِهِينَ (27) كَذَلِكَ وَأَوْرَثْنَاهَا قَوْمًا آخَرِينَ} [الدخان: 25- 28]، أيْ أخي، هؤلاء كانوا وارثينَ، فأصبحوا مَوْروثينَ، إنَّ هؤلاء كفروا النِّعَمَ فحلَّتْ بهم النِّقَمُ. ثُمَّ قالَ: ",["إيَّاكم وكُفرَ النِّعمِ",1]," ",["فتَحِلَّ بكم النِّقمُ",2],". قالَ أبو حاتمٍ: قلتُ لمُحمَّدِ بنِ يزيدَ بنِ سِنانٍ: جدُّكَ سِنانٌ كان كبيرَ السِّنِّ، أَدركَ عَليًّا؟ قالَ: نَعَمْ، شَهِدَ معه المشاهِدَ."],"grade":"صحيح","narrator":"سنان بن يزيد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الخطيب في ((تاريخ بغداد)) (10/ 294) باختلاف يسير.","bab":"تفسير آيات › سورة الدخان","dorar":"AFgurSpN"},{"id":"س-04010","fp":"c0aa98e6af5c","stateId":489,"easy":"إذا اعترفت بالذنوب ولم تتب ← فلن يعذب الله أمة حتى يُعذر إليها","cause":"يَعترِفون بالذُّنوبِ ولا يَتوبون","result":"ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ","explicit":true,"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ فإنْ تابوا تابَ اللهُ عليهم، قال: وإنْ عادوا أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ",["ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ",2],"، قالوا: وما عُذرُها؟ قال: ",["يَعترِفون بالذُّنوبِ ولا يَتوبون",1],"، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"س-03641","fp":"278ab58e435c","stateId":489,"easy":"إذا عصيت أمر النبي ﷺ ← ترى ما تكره (من واقعة)","cause":"فعصاه فتيانِ","result":"فكِلاهما رأى ما يكرَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشاكر 8/117","srcLabel":"الطبراني","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  نزل العقيقَ فنهى عن طُرُوقِ النساءِ الليلةَ التي يأتي فيها ",["فعصاه فتيانِ",1]," ",["فكِلاهما رأى ما يكرَه",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار والطبراني كما في ((مجمع الزوائد)) للهيثمي (4/333)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"LcGtYl1E","merged":3,"otherRefs":["الإفصاح عن أحاديث النكاح 175 (حسن)","تخريج الإحياء للعراقي 2/59 (حسن)"]},{"id":"س-00559","fp":"2bc0a8e04802","stateId":489,"easy":"إذا غيّرتم (أحدثتم) ← يبعث الله عليكم من يلحاكم كما يُلحى القضيب","cause":"فإذا غيَّرتُم","result":"بعثَ اللهُ عليكُم مَن يَلحاكُم كما يُلحَى القَضيبُ","explicit":true,"ref":"فتح الباري لابن حجر 13/125","srcLabel":"أحمد","text":["يا معشرَ قريشٍ إنَّكم أهلُ هذا الأمرِ ما لم تُحدِثوا ",["فإذا غيَّرتُم",1]," ",["بعثَ اللهُ عليكُم مَن يَلحاكُم كما يُلحَى القَضيبُ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"رجاله ثقات لكن عبيد الله لم يدرك عم أبيه","takhrij":"أخرجه أحمد (4380)، وأبو يعلى (5024)، والطبراني في ((المعجم الأوسط)) (8513) مطولاً باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"1Q7kB8ZU"},{"id":"س-03759","fp":"7081ff31a179","stateId":489,"easy":"إذا أنكرت زمانك ← فبما غيّرتم من أعمالكم","cause":"فبِما غيَّرتُم من أعمالِكم","result":"ما أنكرتم من زمانِكم","explicit":true,"ref":"مجمع الزوائد 10/234","srcLabel":"الطبراني","text":[["ما أنكرتم من زمانِكم",2]," ",["فبِما غيَّرتُم من أعمالِكم",1]," فإن يكُ خيرًا فواهًا واهًا وإن يكُ شرًّا فآهًا آهًا هكذا سمعت من نبيِّكم صلَّى اللهُ عليه وسلَّم"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الشاميين)) (26)، والبيهقي في ((الزهد الكبير)) (709)، وأبو نعيم في ((الحلية)) (5/ 249) واللفظ لهم.","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"ejteHFHo"},{"id":"س-04825","fp":"f295a33b5c68","stateId":489,"easy":"إذا عملت السيئات في زمن البلاء ← فهي الهلكة","cause":"أن تعمَلَ السَّيِّئاتِ في زمانِ البلاءِ","result":"إنَّ الهَلَكةَ","explicit":true,"ref":"مجمع الزوائد 10/239","srcLabel":"سعيد","text":["سمِعْتُ النُّعمانَ بنَ بَشيرٍ وهو يخطُبُ بحِمْصَ وهو يقولُ ألَا ",["إنَّ الهَلَكةَ",2]," ",["أن تعمَلَ السَّيِّئاتِ في زمانِ البلاءِ",1]],"grade":"حسن","narrator":"الوليد بن أيمن الألهاني","muhaddith":"إسناده حسن","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (5567)، وابن أبي الدنيا في ((العقوبات)) (327) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"P3ZIzrZf"},{"id":"س-08057","fp":"d879a2cab3de","stateId":489,"easy":"إذا أصابتك نكبة ← فبذنب (وما يعفو الله أكثر)","cause":"بذنبٍ","result":"لا يُصِيبُ عبدًا نَكْبَةٌ ، فما فوقَها أو دونَها إلا","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 7732","srcLabel":"الترمذي","text":[["لا يُصِيبُ  عبدًا نَكْبَةٌ ، فما فوقَها أو دونَها إلا",2]," ",["بذنبٍ",1]," ، وما يَعْفُو اللهُ عنه أَكْثَرُ"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3252) بزيادة قصة في أوله","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"sA3NmLDj"},{"id":"س-07734","fp":"ed86b60d3ddf","stateId":489,"easy":"إذا بدّلت نعمة الله كفراً ← يقطع الله دابرك","cause":"الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا","result":"فقطع اللهُ دابرَهم يومَ بدرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 7/47","srcLabel":"الحاكم","text":["عن عليٍّ: (",["الَّذِينَ بَدَّلُوا نِعْمَتَ اللَّهِ كُفْرًا",1]," وَأَحَلُّوا قَوْمَهُمْ دَارَ الْبَوَارِ) الآية قال نزلت في الأفخرِينَ من بني مخزومٍ وبني أميةَ ",["فقطع اللهُ دابرَهم يومَ بدرٍ",2]," وأما بنو أميةَ فمُتِّعوا إلى حينٍ"],"grade":"حسن","narrator":"عمرو ذي مر","muhaddith":"فيه عمرو ذو مر ولم يرو عنه غير أبي إسحاق السبيعي وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (776) بلفظه، والطبري في ((جامع البيان)) (13/ 675)، والحاكم (3343) كلاهما بنحوه .","bab":"قرآن › أسباب النزول","dorar":"fLUI6uGa"},{"id":"س-03493","fp":"6e0efd375af8","stateId":489,"easy":"إذا اختلج عرقك أو عينك ← فبذنب، وما يدفع الله أكثر","cause":"بذنبٍ","result":"ما اختلجَ عِرْقٌ و لا عَينٌ إلا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[12],"ref":"الجامع الصغير 7778","srcLabel":"الطبراني","text":[["ما اختلجَ عِرْقٌ و لا عَينٌ إلا",2]," ",["بذنبٍ",1],"، و ما يدفعُ اللهُ عنهُ أكثرُ"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الصغير)) (1053)، وأبو نعيم الأصبهاني في تاريخ أصبهان (2/217) كلاهما بلفظه.","bab":"استغفار › مكفرات الذنوب","dorar":"R5VQntes"},{"id":"س-04009","fp":"567834369496","stateId":489,"easy":"إذا عاد الناس إلى المعاصي ← أعاد الله عليهم العذاب","cause":"وإنْ عادوا","result":"أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ فإنْ تابوا تابَ اللهُ عليهم، قال: ",["وإنْ عادوا",1]," ",["أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ",2],"، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ، قالوا: وما عُذرُها؟ قال: يَعترِفون بالذُّنوبِ ولا يَتوبون، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"س-08013","fp":"a423bcdb7053","stateId":490,"easy":"إذا ظلمت ← يُملي الله لك حتى إذا أخذك لم يفلتك","cause":"للظَّالِمِ","result":"حتَّى إذا أخذَه لم يُفلِتْهُ","explicit":true,"star":true,"similar":["ق-0821"],"ref":"صحيح الترمذي 3110","srcLabel":"البخاري","text":["إنَّ اللهَ تبارَك وتعالَى يُملي ، - وربَّما قال : يمهلُ ",["للظَّالِمِ",1]," ، ",["حتَّى إذا أخذَه لم يُفلِتْهُ",2]," ، ثمَّ قرأ :  وَكَذَلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَى وَهِيَ ظَالِمَةٌ  الآيةَ"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"أخرجه البخاري (4686)، والترمذي (3110)، وابن ماجه (4018)، والبزار (3183)، والنسائي في ((السنن الكبرى)) (11181) واللفظ لهم.","bab":"مظالم › تحريم الظلم","dorar":"fH5ksFpW"},{"id":"ق-0191","fp":"7e597b5d8697","stateId":490,"easy":"الكفر مع الإمهال ← الإملاء ليزدادوا إثماً وعذاب مهين","cause":"الكفر مع الإمهال","result":"الإملاء ليزدادوا إثماً وعذاب مهين","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة آل عمران: 178","srcLabel":"القرآن الكريم","quran":{"s":3,"from":178,"to":178,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ كَفَرُوا أَنَّمَا نُمْلِي لَهُمْ خَيْرٌ لِأَنْفُسِهِمْ إِنَّمَا نُمْلِي لَهُمْ لِيَزْدَادُوا إِثْمًا وَلَهُمْ عَذَابٌ مُهِينٌ (178)","hl":[[0,153,1]]}},{"id":"ق-0354","fp":"921ffc803ddf","stateId":490,"easy":"قسوة القلب وترك التضرع عند البلاء ونسيان التذكير ← الاستدراج بفتح أبواب كل شيء ثم الأخذ بغتة وقطع الدابر","cause":"قسوة القلب وترك التضرع عند البلاء ونسيان التذكير","result":"الاستدراج بفتح أبواب كل شيء ثم الأخذ بغتة وقطع الدابر","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة الأنعام: 43–45","srcLabel":"القرآن الكريم","quran":{"s":6,"from":43,"to":45,"text":"فَلَوْلَا إِذْ جَاءَهُمْ بَأْسُنَا تَضَرَّعُوا وَلَكِنْ قَسَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا يَعْمَلُونَ (43) فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّى إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ (44) فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ (45)","hl":[[0,387,1]]}},{"id":"ق-0415","fp":"cb67e31554dc","stateId":490,"easy":"ترك التضرع عند البأساء والاغترار بالنعمة بعدها ← الأخذ بغتة","cause":"ترك التضرع عند البأساء والاغترار بالنعمة بعدها","result":"الأخذ بغتة","explicit":true,"ref":"سورة الأعراف: 94–95","srcLabel":"القرآن الكريم","quran":{"s":7,"from":94,"to":95,"text":"وَمَا أَرْسَلْنَا فِي قَرْيَةٍ مِنْ نَبِيٍّ إِلَّا أَخَذْنَا أَهْلَهَا بِالْبَأْسَاءِ وَالضَّرَّاءِ لَعَلَّهُمْ يَضَّرَّعُونَ (94) ثُمَّ بَدَّلْنَا مَكَانَ السَّيِّئَةِ الْحَسَنَةَ حَتَّى عَفَوْا وَقَالُوا قَدْ مَسَّ آبَاءَنَا الضَّرَّاءُ وَالسَّرَّاءُ فَأَخَذْنَاهُمْ بَغْتَةً وَهُمْ لَا يَشْعُرُونَ (95)","hl":[[0,300,1]]}},{"id":"ق-0445","fp":"e3da6d1b27d7","stateId":490,"easy":"التكذيب بآيات الله ← الاستدراج من حيث لا يعلمون والإملاء","cause":"التكذيب بآيات الله","result":"الاستدراج من حيث لا يعلمون والإملاء","explicit":true,"similar":["ق-1370"],"ref":"سورة الأعراف: 182–183","srcLabel":"القرآن الكريم","quran":{"s":7,"from":182,"to":183,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ (182) وَأُمْلِي لَهُمْ إِنَّ كَيْدِي مَتِينٌ (183)","hl":[[0,125,1]]}},{"id":"ق-0631","fp":"b9c5b90efeba","stateId":490,"easy":"الاستهزاء بالرسل ← الإملاء ثم الأخذ والعقاب","cause":"الاستهزاء بالرسل","result":"الإملاء ثم الأخذ والعقاب","explicit":true,"similar":["ق-0818"],"ref":"سورة الرعد: 32","srcLabel":"القرآن الكريم","quran":{"s":13,"from":32,"to":32,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَأَمْلَيْتُ لِلَّذِينَ كَفَرُوا ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ عِقَابِ (32)","hl":[[0,118,1]]}},{"id":"ق-0753","fp":"288f3cb5984d","stateId":490,"easy":"الضلالة ← مدّ الرحمن له (استدراج) حتى يرى العذاب","cause":"الضلالة","result":"مدّ الرحمن له (استدراج) حتى يرى العذاب","explicit":true,"ref":"سورة مريم: 75","srcLabel":"القرآن الكريم","quran":{"s":19,"from":75,"to":75,"text":"قُلْ مَنْ كَانَ فِي الضَّلَالَةِ فَلْيَمْدُدْ لَهُ الرَّحْمَنُ مَدًّا حَتَّى إِذَا رَأَوْا مَا يُوعَدُونَ إِمَّا الْعَذَابَ وَإِمَّا السَّاعَةَ فَسَيَعْلَمُونَ مَنْ هُوَ شَرٌّ مَكَانًا وَأَضْعَفُ جُنْدًا (75)","hl":[[0,203,1]]}},{"id":"ق-0818","fp":"0cfd84e48e0a","stateId":490,"easy":"تكذيب الرسل ← الإملاء ثم الأخذ والنكير","cause":"تكذيب الرسل","result":"الإملاء ثم الأخذ والنكير","explicit":true,"repOf":"ق-0631","ref":"سورة الحج: 44","quran":{"s":22,"from":44,"to":44,"text":"وَأَصْحَابُ مَدْيَنَ وَكُذِّبَ مُوسَى فَأَمْلَيْتُ لِلْكَافِرِينَ ثُمَّ أَخَذْتُهُمْ فَكَيْفَ كَانَ نَكِيرِ (44)","hl":[[38,107,1]]}},{"id":"ق-0821","fp":"f1d82b23cc90","stateId":490,"easy":"الظلم ← الإملاء ثم الأخذ","cause":"الظلم","result":"الإملاء ثم الأخذ","explicit":true,"repOf":"س-08013","ref":"سورة الحج: 48","quran":{"s":22,"from":48,"to":48,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ أَمْلَيْتُ لَهَا وَهِيَ ظَالِمَةٌ ثُمَّ أَخَذْتُهَا وَإِلَيَّ الْمَصِيرُ (48)","hl":[[0,77,1]]}},{"id":"ق-0836","fp":"8ccdb011ae21","stateId":490,"easy":"الكفر مع الإمداد بالمال والبنين ← استدراج لا مسارعة في الخيرات","cause":"الكفر مع الإمداد بالمال والبنين","result":"استدراج لا مسارعة في الخيرات","explicit":true,"ref":"سورة المؤمنون: 55–56","srcLabel":"القرآن الكريم","quran":{"s":23,"from":55,"to":56,"text":"أَيَحْسَبُونَ أَنَّمَا نُمِدُّهُمْ بِهِ مِنْ مَالٍ وَبَنِينَ (55) نُسَارِعُ لَهُمْ فِي الْخَيْرَاتِ بَلْ لَا يَشْعُرُونَ (56)","hl":[[0,120,1]]}},{"id":"ق-0840","fp":"24c9a846266f","stateId":490,"easy":"ترك الاستكانة والتضرع عند العذاب ← فتح باب عذاب شديد والإبلاس","cause":"ترك الاستكانة والتضرع عند العذاب","result":"فتح باب عذاب شديد والإبلاس","explicit":true,"otherNeedIds":[10],"ref":"سورة المؤمنون: 76–77","srcLabel":"القرآن الكريم","quran":{"s":23,"from":76,"to":77,"text":"وَلَقَدْ أَخَذْنَاهُمْ بِالْعَذَابِ فَمَا اسْتَكَانُوا لِرَبِّهِمْ وَمَا يَتَضَرَّعُونَ (76) حَتَّى إِذَا فَتَحْنَا عَلَيْهِمْ بَابًا ذَا عَذَابٍ شَدِيدٍ إِذَا هُمْ فِيهِ مُبْلِسُونَ (77)","hl":[[0,182,1]]}},{"id":"ق-1370","fp":"91842d29a576","stateId":490,"easy":"التكذيب بالقرآن ← الاستدراج من حيث لا يعلمون والإملاء","cause":"التكذيب بالقرآن","result":"الاستدراج من حيث لا يعلمون والإملاء","explicit":true,"repOf":"ق-0445","ref":"سورة القلم: 44–45","quran":{"s":68,"from":44,"to":45,"text":"فَذَرْنِي وَمَنْ يُكَذِّبُ بِهَذَا الْحَدِيثِ سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ (44) وَأُمْلِي لَهُمْ إِنَّ كَيْدِي مَتِينٌ (45)","hl":[[0,136,1]]}},{"id":"س-00583","fp":"5fcc51f04f61","stateId":491,"easy":"إذا تُرك السفهاء وأمرهم ← هلك الجميع","cause":"فإنْ تَرَكوهم وأمْرَهم","result":"هَلَكوا جَميعًا","explicit":true,"star":true,"similar":["س-02179"],"ref":"تخريج المسند لشعيب 18370","srcLabel":"البخاري","text":["مَثلُ القائمِ على حُدودِ اللهِ، والواقعِ فيها،  المُدْهِنِ فيها، مَثلُ قَومٍ رَكِبوا سَفينةً، فأصابَ بعضُهم أسفلَها، وأوْعرَها، وشَرَّها، وأصابَ بعضُهم أعلاها، فكان الذين في أسفلِها إذا استَقَوُا الماءَ، مَرُّوا على مَن فوقَهم، فآذَوْهم، فقالوا: لو خَرَقْنا في نَصيبِنا خَرقًا، فاستقَيْنا منه، ولم نُؤذِ مَن فوقَنا، ",["فإنْ تَرَكوهم وأمْرَهم",1],"؛ ",["هَلَكوا جَميعًا",2],"، وإنْ أخَذوا على أيْديهم؛ نَجَوْا جَميعًا."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2493)، والترمذي (2173)، وأحمد (18370) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"pyDjRbxb","merged":2,"otherRefs":["أحكام القرآن لابن العربي 4/305 (صحيح)"]},{"id":"س-02179","fp":"7b891acabd10","stateId":491,"easy":"إذا تُرك السفهاء وما أرادوا ← هلك الجميع","cause":"فإنْ يَتركُوهمْ وما أرادُوا","result":"هلَكُوا جميعًا","explicit":true,"repOf":"س-00583","ref":"صحيح الجامع 5832","text":["مَثلُ القائِمِ على حُدودِ اللهِ ، والمدَّهِنِ فيها ، كمَثلِ قومٍ اسْتهَمُوا على سفينةٍ في البحْرِ ، فأصابَ بعضُهمْ أعلَاها ، وأصابَ بعضُهمْ أسفَلَها ، فكانَ الّذينَ في أسفلِها إذا استَقَوا من الماءِ مَرُّوا على مَنْ فوقَهُمْ ، فقال الّذينَ في أعْلاها : لا نَدعُكُمْ تَصعدُونَ فتُؤذُونا ، فقالُوا : لوْ أنّا خرقْنا في نَصيبِنا خرْقًا ولمْ نُؤْذِ مَنْ فوقَنا ، ",["فإنْ يَتركُوهمْ وما أرادُوا",1]," ، ",["هلَكُوا جميعًا",2]," ، وإنْ أخذُوا على أيدِيهمْ ، نَجَوْا ونَجَوْا جميعًا"],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361) باختلاف يسير، وأخرجه البخاري (2686) بلفظ مقارب","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1vc7R5ao"},{"id":"ق-0458","fp":"e1fcaf5f3ae5","stateId":491,"easy":"ترك إنكار الظلم إذا شاع ← فتنة تعمّ ولا تخصّ الظالمين","cause":"ترك إنكار الظلم إذا شاع","result":"فتنة تعمّ ولا تخصّ الظالمين","explicit":true,"star":true,"ref":"سورة الأنفال: 25","srcLabel":"القرآن الكريم","quran":{"s":8,"from":25,"to":25,"text":"وَاتَّقُوا فِتْنَةً لَا تُصِيبَنَّ الَّذِينَ ظَلَمُوا مِنْكُمْ خَاصَّةً وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ (25)","hl":[[0,71,1]]}},{"id":"س-02481","fp":"4238f4d5475d","stateId":491,"easy":"إذا هابت الأمة أن تقول للظالم «أنت ظالم» ← فقد تُودّع منها","cause":"إذا رأيتُمْ أمَّتي تَهابُ الظَّالمَ أن تَقولَ لَهُ : إنَّكَ أنتَ ظالمٌ","result":"فقد توُدِّعَ مِنهُم","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 10/30","srcLabel":"أحمد","text":[["إذا رأيتُمْ أمَّتي تَهابُ الظَّالمَ أن تَقولَ لَهُ : إنَّكَ أنتَ ظالمٌ ، ",1],["فقد توُدِّعَ مِنهُم",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6521) واللفظ له، والبزار (2375)، وابن أبي الدنيا في ((الأمر بالمعروف)) (3)، والعقيلي في ((الضعفاء الكبير)) (4/290)، والطبراني (13/454) (14314)  باختلاف يسير","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"3lNNSmKJ","merged":3,"otherRefs":["تخريج المسند لشاكر 11/47 (صحيح)","مجمع الزوائد 7/273 (صحيح)"]},{"id":"س-01564","fp":"026a46b2d95b","stateId":491,"easy":"إذا كثر الخبث ← يُخسف بالأرض","cause":"إذا كان أكثرُ أهلِها الخبَثُ","result":"يُخْسَفُ بأرضٍ","explicit":true,"star":true,"ref":"مجمع الزوائد 7/272","srcLabel":"الطبراني","text":["ذُكِرَ في زمنِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم خَسْفٌ قِبَلَ المشرقِ فقال رجلٌ يا رسولَ اللهِ ",["يُخْسَفُ بأرضٍ",2]," فيها المسلمون فقال نعم ",["إذا كان أكثرُ أهلِها الخبَثُ",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1841)، والداني في ((السنن الواردة في الفتن)) (342)واللفظ لهما.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"vb45TU5A","merged":2,"otherRefs":["صحيح الترمذي 2185 (صحيح)"]},{"id":"س-01783","fp":"e1bf33c5019a","stateId":491,"easy":"إذا لم تأمروا بالمعروف وتنهوا عن المنكر وتأخذوا على يد المسيء ← يضرب الله قلوب بعضكم ببعض ويلعنكم","cause":"لتأمرُنَّ بالمعروفِ ولتَنْهُنَّ عنِ المنكرِ ولتأخذُنَّ على أيدي المسيءِ ولتأطِرُنَّهُ على الحقِّ أطْرًا","result":"أو ليضرِبَنَّ اللهُ بقلوبِ بعضِكم على بعضٍ ويلعنُكم كما لَعَنَهُمْ","explicit":true,"otherNeedIds":[29],"ref":"مجمع الزوائد 7/272","srcLabel":"الطحاوي","text":["إنَّهُ من كان قَبْلَكُمْ مِنْ بني إسرائيلَ إذا عَمِلَ فيهم العامِلُ الخطيئةَ فنَهَاهُ الناهِي تَعْذِيرًا فإذا كان من الغدِ جالَسَهُ ووَاكلَهُ وشارَبَهُ كأَنَّهُ لم يرَهُ على خَطِيئَةٍ بالأمْسِ فلمَّا رأَى اللهُ تعالى ذلِكَ منهم ضَرَبَ قلوبَ بعضِهم على بعضٍ على لسانِ داودَ وعيسى بنِ مريمَ  ذَلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ  والذي نفْسِي بيدِهِ ",["لتأمرُنَّ بالمعروفِ ولتَنْهُنَّ عنِ المنكرِ ولتأخذُنَّ على أيدي المسيءِ ولتأطِرُنَّهُ على الحقِّ أطْرًا",1]," ",["أو ليضرِبَنَّ اللهُ بقلوبِ بعضِكم على بعضٍ ويلعنُكم كما لَعَنَهُمْ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1163) واللفظ له.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"VqidmtBS","merged":2,"otherRefs":["عمدة التفسير 1/715 (صحيح)"]},{"id":"س-02985","fp":"53da09cc39e7","stateId":491,"easy":"إذا رأى الناس الظالم فلم يأخذوا على يديه ← أوشك أن يعمهم الله بعقاب","cause":"إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه","result":"أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ","explicit":true,"similar":["س-02483"],"ref":"الصحيح المسند 707","srcLabel":"أبو داود","text":["قالَ أبو بَكْرٍ بَعْدَ أن حَمِدَ اللهَ وأَثْنى عليه: يا أيُّها النَّاسُ، إنَّكم تَقرَؤونَ هذه الآيةَ، وتَضَعونَها على غَيْرِ مَواضِعِها: {عَلَيْكُمْ أَنْفُسَكُمْ لا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ}.\nقالَ عن خالِدٍ: وإنَّا سَمِعْنا النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه، ",1],["أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ»",2],".\nوقالَ عَمْرٌو عن هُشَيمٍ: وإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا، إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ».\nقالَ أبو داودُ: ورَواه كما قالَ خالِدٌ: أبو أُسامةَ وجَماعةٌ، وقالَ شُعْبةُ فيه: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي هُمْ أَكثَرُ ممَّن يَعمَلُه»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح على شرط الشَّيْخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، وابن ماجه (4005)، وأحمد (1) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"oNv8xwNw","merged":2,"otherRefs":["تخريج المسند لشعيب 29 (صحيح)"]},{"id":"س-04771","fp":"856a96e291eb","stateId":491,"easy":"إذا رأى الناس المنكر بينهم فلم يغيروه ← يعذب الله العامة والخاصة","cause":"إذا رأَوا المنكرَ بين ظَهرانَيهم فلم يُغيِّروه","result":"عذَّبَ اللهُ عزَّ وجلَّ العامَّةَ والخاصَّةَ","explicit":true,"ref":"شرح مشكل الآثار 3/214","srcLabel":"شرح مشكل الآثار","text":["إنَّ اللهَ عزَّ وجلَّ لا يهلكُ العامةَ بعملِ الخاصَّةِ ولكن ",["إذا رأَوا المنكرَ بين ظَهرانَيهم فلم يُغيِّروه",1]," ",["عذَّبَ اللهُ عزَّ وجلَّ العامَّةَ والخاصَّةَ",2]],"grade":"صحيح","narrator":"عدي بن عميرة الكندي","muhaddith":"صحيح","takhrij":"لم نقف عليه إلا في الطحاوي في ((شرح مشكل الآثار)) (1175)","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"AyoJQ0vt","merged":2,"otherRefs":["إرشاد الساري 10/167 (حسن)"]},{"id":"س-00104","fp":"86cc9aa96599","stateId":491,"easy":"إذا رأى الناس المنكر فلم يغيروه ← يوشك أن يعمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رَأَوُا المُنكَرَ لا يُغَيِّرُوهُ","result":"أَوْشَكَ أنْ يَعُمَّهُمُ اللهُ بعِقابِه","explicit":true,"similar":["س-03023"],"ref":"تخريج مسند أبي بكر 88","srcLabel":"أبو داود","text":["قام أبو بَكرٍ رضيَ اللهُ عنه فحَمِدَ اللهَ وأَثنَى علَيهِ، وقال: يا أيُّها النَّاسُ، إنَّكُم تَقرَؤُونَ هذِه الآيةَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105]، وإنَّا سمِعْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["إنَّ النَّاسَ إذا رَأَوُا المُنكَرَ لا يُغَيِّرُوهُ",1],"، ",["أَوْشَكَ أنْ يَعُمَّهُمُ اللهُ بعِقابِه",2],"». قال أبو أُسامةَ: وقال مرَّةً أُخرى: وإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ..."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، والنسائي في ((السنن الكبرى)) (11157)، وابن ماجه (4005)، وأحمد (16) باختلاف يسير، والمروزي في ((مسند أبي بكر)) (88) واللفظ له","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"zw6Sc8Dx"},{"id":"س-02483","fp":"38ef138a80a6","stateId":491,"easy":"إذا رأى الناس الظالم فلم يأخذوا على يديه ← عمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رأَوُا الظَّالمَ فلم يأخُذوا على يدَيهِ","result":"عمَّهم اللهُ بعقابِه","explicit":true,"repOf":"س-02985","ref":"تخريج صحيح ابن حبان 304","text":["قرَأ أبو بكرٍ الصِّدِّيقُ هذه الآيةَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105] قال: إنَّ النَّاسَ يضَعون هذه الآيةَ على غيرِ موضعِها ألَا وإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["إنَّ النَّاسَ إذا رأَوُا الظَّالمَ فلم يأخُذوا على يدَيهِ",1]," - أو قال: المنكَرَ فلم يُغيِّروه - ",["عمَّهم اللهُ بعقابِه",2]," )"],"grade":"صحيح","narrator":"أبوبكر الصديق","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168) باختلاف يسير، وابن ماجه (4005) بنحوه","bab":"إمامة وخلافة › الإنكار على الأمراء فيما خالفوا الشرع فيه","dorar":"j92f9iyb"},{"id":"س-02986","fp":"3d3455f30d7f","stateId":491,"easy":"إذا عُملت المعاصي في قوم يقدرون على تغييرها فلم يغيروا ← يوشك أن يعمهم الله بعقاب","cause":"ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا","result":"إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ","explicit":true,"similar":["س-04889","س-05125"],"ref":"الصحيح المسند 707","srcLabel":"أبو داود","text":["قالَ أبو بَكْرٍ بَعْدَ أن حَمِدَ اللهَ وأَثْنى عليه: يا أيُّها النَّاسُ، إنَّكم تَقرَؤونَ هذه الآيةَ، وتَضَعونَها على غَيْرِ مَواضِعِها: {عَلَيْكُمْ أَنْفُسَكُمْ لا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ}.\nقالَ عن خالِدٍ: وإنَّا سَمِعْنا النَّبيَّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «إنَّ النَّاسَ إذا رأَوا الظَّالِمَ فلم يَأخُذوا على يَدَيه، أَوشَكَ أن يَعُمَّهم اللهُ بعِقابٍ».\nوقالَ عَمْرٌو عن هُشَيمٍ: وإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ يقولُ: «",["ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي، ثُمَّ يَقدِرونَ على أن يُغيِّروا ثُمَّ لا يُغَيِّروا،",1]," ",["إلَّا يوشِكُ أن يَعُمَّهم اللهُ مِنه بعِقابٍ»",2],".\nقالَ أبو داودُ: ورَواه كما قالَ خالِدٌ: أبو أُسامةَ وجَماعةٌ، وقالَ شُعْبةُ فيه: «ما مِن قَوْمٍ يُعمَلُ فيهم بالمَعاصي هُمْ أَكثَرُ ممَّن يَعمَلُه»."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح على شرط الشَّيْخين","takhrij":"أخرجه أبو داود (4338)، والترمذي (2168)، وابن ماجه (4005)، وأحمد (1) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"oNv8xwNw"},{"id":"س-03023","fp":"d049cec83980","stateId":491,"easy":"إذا رأى الناس منكراً فلم يغيروه ← أوشك أن يعمهم الله بعقابه","cause":"إنَّ النَّاسَ إذا رأَوْا مُنكَرًا لا يُغيِّرونَهُ","result":"أوشَك أنْ يعُمَّهمُ اللهُ بعقابِهِ","explicit":true,"repOf":"س-00104","ref":"تخريج مشكل الآثار 1169","text":["حدَّثني قَيْسُ بنُ أبي حازمٍ، عن أبي بكْرٍ، قال: سمِعْتُهُ حمِد اللهَ وأثْنى عليه، ثمَّ قال: أيُّها النَّاسُ، ثمَّ ذكَر بَقِيَّةَ هذا الحديثِ. يعني حديثَ: أيُّها النَّاسُ، إنَّكم تَقرَؤُونَ هذه الآيةَ، وتضَعونَها على غيْرِ موضِعها: {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105]، ثمَّ قال: إنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["إنَّ النَّاسَ إذا رأَوْا مُنكَرًا لا يُغيِّرونَهُ ",1],["أوشَك أنْ يعُمَّهمُ اللهُ بعقابِهِ",2],"."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (16)، والطحاوي في ((شرح مشكل الآثار)) (1169) كلاهما بلفظه، وابن أبي شيبة (37583)، والبيهقي (20214) كلاهما بلفظ مقارب.","bab":"إيمان › الوعيد","dorar":"g45bIPyR"},{"id":"س-04889","fp":"d83cad708653","stateId":491,"easy":"إذا عُملت المعاصي في قوم هم أعز ممن يعملها ثم لم يغيروا ← يعمهم الله بعقاب","cause":"ما منْ قومٍ يعملُ فيهم بالمعاصي، همْ أعزُّ و أكثرُ ممنْ يعملُهُ، ثمَّ لمْ يغيرُوه","result":"إلا عمَّهمُ اللهُ تعالى منهُ بعقابٍ","explicit":true,"repOf":"س-02986","ref":"الجامع الصغير 8066","text":[["ما منْ قومٍ يعملُ فيهم بالمعاصي،  همْ أعزُّ و أكثرُ ممنْ يعملُهُ،  ثمَّ لمْ يغيرُوه،",1],"  ",["إلا عمَّهمُ اللهُ تعالى منهُ بعقابٍ",2]],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (4009) واللفظ له، وأبو داود (4339)، وأحمد (19216) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"vzRfEfgW"},{"id":"س-05315","fp":"1e10a8e2e794","stateId":491,"easy":"إذا تمادى القوم في المعاصي ولم ينههم العلماء ← تأخذهم العقوبات","cause":"تَمادَوا في المعاصي ولم يَنهَهُمُ الرَّبَّانيُّونَ والأحبارُ","result":"أخذتْهمُ العقوباتُ","explicit":true,"ref":"عمدة التفسير 1/705","srcLabel":"ابن أبي حاتم","text":["خطبَ عليُّ بنُ أبي طالبٍ فحمِدَ اللَّهَ وأثنى عليهِ ، ثمَّ قالَ : أيُّها النَّاسُ ، إنَّما هلَكَ مَن كانَ قبلَكُم برُكوبِ المعاصي ، ولم ينهَهُمُ الرَّبَّانيُّونَ والأحبارُ ، فلمَّا ",["تَمادَوا في المعاصي ولم يَنهَهُمُ الرَّبَّانيُّونَ والأحبارُ",1]," ",["أخذتْهمُ العقوباتُ",2]," . فَمُروا بالمعروفِ وانهَوا عنِ المنكرِ ، قبلَ أن يَنزلَ بِكُم مثلُ الَّذي نزلَ بِهِم ، واعلَموا أنَّ الأمرَ بالمعروفِ والنَّهيَ عنِ المنكرِ لا يَقطعُ رزقًا ولا يقرِّبُ أجلًا"],"grade":"صحيح","narrator":"يحيى بن يعمر","muhaddith":"إسناده صحيح ، ولكن في سماع يحيى بن يعمر من علي كلام","takhrij":"أخرجه ابن أبي حاتم في ((التفسير)) (6571)، وعبد الغني المقدسي في ((الأمر بالمعروف)) (54) واللفظ لهما.","bab":"رقائق وزهد › التوكل واليقين","dorar":"xykckZNK"},{"id":"س-04775","fp":"82365d8d7bb2","stateId":491,"easy":"إذا عملت الخاصة منكراً تقدر العامة على تغييره فلم تفعل ← يأذن الله في هلاك الجميع","cause":"حتى تَعْمَلَ الخاصَّةُ بعملٍ تَقْدِرُ العامَّةُ أنْ تُغَيِّرَهُ ولَا تُغَيِّرُهُ","result":"فذاكَ حين يأذَنُ اللهُ في هلاكِ العامَّةِ والخاصَّةِ","explicit":true,"ref":"مجمع الزوائد 7/271","srcLabel":"أحمد","text":["إنَّ اللهَ لا يعذِّبُ العامَّةَ بعملِ الخاصَّةِ ",["حتى تَعْمَلَ الخاصَّةُ بعملٍ تَقْدِرُ العامَّةُ أنْ تُغَيِّرَهُ ولَا تُغَيِّرُهُ",1]," ",["فذاكَ حين يأذَنُ اللهُ في هلاكِ العامَّةِ والخاصَّةِ",2]],"grade":"حسن","narrator":"العرس بن عميرة الكندي","muhaddith":"رجاله ثقات","takhrij":"أخرجه أحمد (17720)، وابن أبي عاصم في ((الآحاد والمثاني)) (2431)، والطبراني (343) (17/ 138)، وابن الأثير في ((أسد الغابة)) (1322) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من الأخلاق والأفعال المذمومة","dorar":"ObtC9sF7"},{"id":"س-04865","fp":"70c8d4740e97","stateId":491,"easy":"إذا كان بينكم من يعمل المعاصي وأنتم أعز منه فلم تغيروا ← يصيبكم الله بعقاب","cause":"ما من قومٍ يَكونُ بينَ أظهرِهم رجلٌ يعملُ بالمعاصي هم أمنعُ منهُ وأعزُّ لا يغيِّرونَ عليهِ","result":"إلَّا أصابَهمُ اللَّهُ بعقابٍ","explicit":true,"ref":"هداية الرواة 4/486","srcLabel":"ابن ماجه","text":[["ما من قومٍ يَكونُ بينَ أظهرِهم رجلٌ يعملُ بالمعاصي هم أمنعُ منهُ وأعزُّ لا يغيِّرونَ عليهِ",1]," ",["إلَّا أصابَهمُ اللَّهُ بعقابٍ",2]],"grade":"حسن","narrator":"جرير بن عبدالله","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الطبراني (2/331) (2380) واللفظ له، وأخرجه ابن ماجه (4009)، وأحمد (19192) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hG2Fjcyv"},{"id":"س-05125","fp":"ffd099b35c80","stateId":491,"easy":"إذا عُملت المعاصي في قوم أعز ممن يعملها ← يعمهم الله بعقاب","cause":"ما مِن قومٍ يُعمَلُ فيهم بالمَعاصي أعزُّ وأكثرُ مِمَّا يَعمَلُهُ وهو عندي، واللهُ أعلَمُ مِمَّن يَعمَلُهُ، لا يُغَيِّرونَهُ عليهم","result":"إلَّا عمَّهمُ اللهُ عزَّ وجلَّ بعقابٍ","explicit":true,"repOf":"س-02986","ref":"تخريج مشكل الآثار 1174","text":[["ما مِن قومٍ يُعمَلُ فيهم بالمَعاصي أعزُّ وأكثرُ مِمَّا يَعمَلُهُ وهو عندي، واللهُ أعلَمُ مِمَّن يَعمَلُهُ، لا يُغَيِّرونَهُ عليهم",1]," ",["إلَّا عمَّهمُ اللهُ عزَّ وجلَّ بعقابٍ",2],"."],"grade":"حسن","narrator":"جرير","muhaddith":"إسناده حسن","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Pcz7a5BV"},{"id":"س-07422","fp":"ed09b7a4d721","stateId":491,"easy":"إذا كثر الخبث ← يكون الخسف","cause":"إذا أكثَر أهلُها الخَبَثَ","result":"سيكونُ بعدي خسفٌ","explicit":true,"ref":"مجمع الزوائد 8/14","srcLabel":"الطبراني","text":[["سيكونُ بعدي خسفٌ",2]," بالمشرقِ وخسفٌ بالمغربِ في جزيرةِ العربِ قُلْتُ يا رسولَ اللهِ أيُخسَفُ بالأرضِ وفيها الصَّالِحونَ قال لها رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["إذا أكثَر أهلُها الخَبَثَ",1]],"grade":"حسن","narrator":"أم سلمة أم المؤمنين","muhaddith":"فيه حكيم بن نافع وبقية رجاله ثقات","takhrij":"أخرجه الطبراني (23/271) (580) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"4PvCR9IH"},{"id":"س-00575","fp":"023f1c7fd7a0","stateId":491,"easy":"إذا خرقتم السفينة (تركتم المنكر) ← تهلكون جميعاً","cause":"نكسِرُ دَفَّ السَّفينةِ فنستقي","result":"فإنَّك إذًا تهلِكُ ونهلِكُ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج صحيح ابن حبان 301","srcLabel":"البخاري","text":["مَثَلُ المداهنِ في حدودِ اللهِ والآمِرِ بها والنَّاهي عنها كمَثَلِ قومٍ استَهَموا سفينةً مِن سُفنِ البحرِ فصار بعضُهم في مؤخَّرِ السَّفينةِ وأبعدَهم مِن المِرفَقِ وبعضُهم في أعلى السَّفينةِ فكانوا إذا أرادوا الماءَ وهم في آخِرِ السَّفينةِ آذَوْا رحالَهم فقال بعضُهم: نحنُ أقربُ مِن المِرفَقِ وأبعدُ مِن الماءِ نخرِقُ دفَّةَ السَّفينةِ ونستقي فإذا استغنَيْنا عنه سدَدْناه فقال السُّفهاءُ منهم: افعَلوا قال: فأخَذ الفأسَ فضرَب عرضَ السَّفينةِ فقال رجلٌ منهم رشيدٌ: ما تصنَعُ ؟ قال: نحنُ أقرَبُ مِن المِرفَقِ وأبعدُ مِن الماءِ ",["نكسِرُ دَفَّ السَّفينةِ فنستقي",1]," فإذا استغنَيْنا عنه سدَدْناه فقال: لا تفعَلْ ",["فإنَّك إذًا تهلِكُ ونهلِكُ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه ابن حبان (301) بلفظه، وأخرجه البخاري ( 2686) بنحوه، والطبراني  (34) (21 / 50) بلفظ مقارب، وأخرجه الترمذي (2173)، وأحمد (18361) كلاهما بمعناه","bab":"آداب عامة › ضرب الأمثال","dorar":"PKXdXqZ9"},{"id":"س-00584","fp":"1764aa977446","stateId":491,"easy":"إذا تُرك أهل المعاصي ← غرق الجميع","cause":"وإنْ تَرَكوهم","result":"غَرِقوا جَميعًا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 18361","srcLabel":"البخاري","text":["مَثلُ القائمِ على حُدودِ اللهِ،  والمُدْهِنِ فيها، كمَثلِ قَومٍ استَهَموا على سَفينةٍ في البحرِ، فأصابَ بعضُهم أسفلَها، وأصابَ بعضُهم أعلاها، فكان الذين في أسفلِها يَصعَدونَ، فيَستَقونَ الماءَ، فيَصُبُّونَ على الذين في أعلاها، فقال الذين في أعلاها: لا نَدَعُكم تَصعَدون، فتُؤذونَنا، فقال الذين في أسفلِها: فإنَّنا نَنقُبُها مِن أسفلِها، فنَستَقي؟ قال: فإنْ أخَذوا على أيديهم، فمَنَعوهم؛ نَجَوا جَميعًا، ",["وإنْ تَرَكوهم",1],"؛ ",["غَرِقوا جَميعًا",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2493)، والترمذي (2173)، وأحمد (18361) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"M3mlQNHT"},{"id":"س-02071","fp":"d24e7883d457","stateId":491,"easy":"إذا تُرك العاصي يخرق السفينة ← أهلكه وأهلك نفسه","cause":"وإن تَرَكوه","result":"أهلَكوه وأهلَكوا أنفُسَهم","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح البخاري 2686","srcLabel":"الترمذي","text":["مَثَلُ المُدهِنِ في حُدودِ اللهِ والواقِعِ فيها مَثَلُ قَومٍ استَهَموا سَفينةً، فصارَ بَعضُهم في أسفَلِها وصارَ بَعضُهم في أعلاها، فكان الذي في أسفَلِها يَمُرُّونَ بالماءِ على الذينَ في أعلاها، فتَأذَّوا به، فأخَذَ فأسًا فجَعَلَ يَنقُرُ أسفَلَ السَّفينةِ، فأتَوه فقالوا: ما لَكَ؟ قال: تَأذَّيتُم بي، ولا بُدَّ لي مِنَ الماءِ، فإن أخَذوا على يَدَيه أنجَوه ونَجَّوا أنفُسَهم، ",["وإن تَرَكوه",1]," ",["أهلَكوه وأهلَكوا أنفُسَهم",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"[صحيح]","takhrij":"أخرجه الترمذي (2173)، وأحمد (18361)، والبزار (3248) جميعا باختلاف","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"7uPzGbPt"},{"id":"س-08435","fp":"7ce097ddeb14","stateId":492,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فليس بينها وبين الله حجاب","cause":"اتَّقِ دعوةَ المظلومِ","result":"فإنَّها ليسَ بينَها وبينَ اللَّهِ حجابٌ","explicit":true,"star":true,"similar":["س-08045","س-05577","س-08026","س-08036"],"otherNeedIds":[28],"ref":"صحيح ابن خزيمة 4/ 101","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ لمَّا بعثَ معاذًا إلى اليمَنِ واليًا قالَ: إنَّكَ تأتي قَومًا مِن أَهْلَ كتابٍ، فادعُهُم إلى شَهادةِ أن لا إلَهَ إلَّا اللَّهُ، وأنِّي رسولُ اللَّهِ، فإذا هُم أطاعوا لذلِكَ فأعلِمهُم أنَّ اللَّهَ افترضَ عليهم خمسَ صلواتٍ في يومٍ وليلةٍ، فإن هم أطاعوا لذلِكَ، فأعلِمهُم أنَّ اللَّهَ افترضَ عليهم صدقةً في أموالِهِم تُؤخَذُ من أغنيائِهِم فتردُّ في فقرائِهِم فإن هم أطاعوا لذلِكَ، فإيَّاكَ وَكَرائمَ أموالِهِم، و",["اتَّقِ دعوةَ المظلومِ",1],"، ",["فإنَّها ليسَ بينَها وبينَ اللَّهِ حجابٌ",2]," . [وفي روايةٍ]: إنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ بعثَ معاذَ بنَ جبلٍ إلى اليمنِ فقالَ: ادعُهُم إلى شَهادةِ أن لا إلَهَ إلَّا اللَّهُ، وأنِّي رسولُ اللَّهِ، فإن هم أجابوا لذلِكَ، فأخبِرهُم أنَّ اللَّهَ افترضَ عليهم"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (4090)، ومسلم (19)، وأبو داود (1584) بلفظ مقارب","bab":"مناقب وفضائل › معاذ بن جبل","dorar":"QFwi9ZkE","merged":3,"otherRefs":["الفتح الرباني 1/402 (صحيح)","صحيح البخاري 4347 (صحيح)"]},{"id":"س-07336","fp":"2ad0e4a112d3","stateId":492,"easy":"إذا تعلقت بالدينار والدرهم ← أهلكا من قبلكم وهما مهلكاكم","cause":"إنَّ هذا الدِّينارَ و الدِّرْهَمَ","result":"أَهْلكَا مَنْ كان قبلَكُمْ ، و هُما مُهْلِكَاكُمْ","explicit":true,"star":true,"ref":"السلسلة الصحيحة 1703","srcLabel":"مسلم","text":[["إنَّ هذا الدِّينارَ و الدِّرْهَمَ",1]," ",["أَهْلكَا مَنْ كان قبلَكُمْ ، و هُما مُهْلِكَاكُمْ",2]],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه المخلص في ((المخلصيات)) (2368) واللفظ له، وأخرجه ابن حبان (694)، والطبراني في ((المعجم الأوسط)) (2022) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"2INriEJr","merged":3,"otherRefs":["صحيح الجامع 2245 (صحيح)","صحيح الترغيب 3258 (صحيح)"]},{"id":"س-01757","fp":"85bd01ccb5b8","stateId":492,"easy":"إذا قطعت رحماً أو حلفت يميناً فاجرة ← ترى وباله قبل أن تموت","cause":"من قطع رَحِمًا ، أو حلف على يمينٍ فاجرةٍ","result":"رأى وبالَه قبل أن يموتَ","explicit":true,"star":true,"ref":"صحيح الجامع 6475","srcLabel":"البخاري","text":[["من قطع رَحِمًا ، أو حلف على يمينٍ فاجرةٍ ، ",1],["رأى وبالَه قبل أن يموتَ",2]],"grade":"صحيح","narrator":"القاسم بن عبدالرحمن","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((التاريخ الكبير)) (6/207)","bab":"أيمان › تعظيم شأن الأيمان","dorar":"ULMvrA6m"},{"id":"س-04924","fp":"f54961e6ac84","stateId":492,"easy":"إذا أخذت أموال الناس تريد إتلافها ← يتلفك الله","cause":"ومَن أخَذَها يُريدُ -يَعني- تَلَفَها","result":"أتلَفَه اللهُ","explicit":true,"star":true,"otherNeedIds":[3],"ref":"تخريج المسند لشعيب 9407","srcLabel":"البخاري","text":["مَن أخَذَ أموالَ النَّاسِ يُريدُ أداءَها، أدَّى اللهُ عنه، ",["ومَن أخَذَها يُريدُ -يَعني- تَلَفَها",1],"، ",["أتلَفَه اللهُ",2]," عزَّ وجلَّ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2387) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"m1Lb2310"},{"id":"س-05268","fp":"c5b1ab25a79b","stateId":492,"easy":"إذا احتكرت على المسلمين طعامهم ← يضربك الله بالجذام والإفلاس","cause":"مِن احْتَكَرَ على المُسلِمينَ طَعامَهم","result":"ضَرَبَه اللهُ بالجُذامِ والفالِجِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 263","srcLabel":"البخاري","text":["«خَرَجَ عُمَرُ بنُ الخَطَّابِ مِن المَسجِدِ فرأى طَعامًا مَزْبورًا، فقالَ: ما هذا الطَّعامُ؟ فقالوا: هذا طَعامٌ جُلِبَ إلينا، قالَ: بارَكَ اللهُ فيه وفيمَن جَلَبَه، قالوا: يا أميرَ المُؤمِنينَ، فإنَّه قد احْتُكِرَ، قالَ: مَن احْتَكَرَه؟ قالوا: فَرُّوخٌ مَوْلى عُثْمانَ، ومَوْلًى لعُمَرَ، فدَعاهما فقالَ: ما حَمَلَكما على احْتِكارِ طَعامِ المُسلِمينَ؟ فقالا: يا أميرَ المُؤمِنينَ نَشْتَري بأمْوالِنا ونَبيعُ في السُّوقِ، قالَ: فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["مِن احْتَكَرَ على المُسلِمينَ طَعامَهم",1]," ",["ضَرَبَه اللهُ بالجُذامِ والفالِجِ",2],".\nوقالَ: أمَّا فَرُّوخٌ فإنَّه قالَ: واللهِ لا أَبيعُ طَعامًا بَعْدَه ولا أَشْتَريه فتَحَوَّلَ إلى البَزِّ، وأمَّا مَوْلى عُمَرَ فثَبَتَ.\nقالَ أبو يَحْيى المَكِيُّ: فرَأيْتُه مَخْدوجًا مَجْذومًا»."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mGIQkkDT"},{"id":"س-07553","fp":"4ef3278de869","stateId":492,"easy":"إذا وليت أمر الأمة فشققت عليهم ← يشقق الله عليك","cause":"مَن وليَ مِن أمرِ أُمَّتي شيئًا فشَقَّ عليهم","result":"فاشقُقْ عليه","explicit":true,"otherNeedIds":[39],"ref":"صحيح مسلم 1828","srcLabel":"متفق عليه","text":["أتَيتُ عائِشةَ أسألُها عن شَيءٍ، فقالت: مِمَّن أنتَ؟ فقُلتُ: رَجُلٌ مِن أهلِ مِصرَ، فقالت: كيفَ كان صاحِبُكُم لَكُم في غَزاتِكُم هذه؟ فقال: ما نَقَمنا منه شيئًا، إن كان لَيَموتُ للرَّجُلِ مِنَّا البَعيرُ فيُعطيه البَعيرَ، والعَبدُ فيُعطيه العَبدَ، ويَحتاجُ إلى النَّفَقةِ فيُعطيه النَّفَقةَ، فقالت: أما إنَّه لا يَمنَعُني الذي فعَلَ في مُحَمَّدِ بنِ أبي بَكرٍ أخي أن أُخبِرَكَ ما سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ في بَيتي هذا: اللَّهُمَّ ",["مَن وليَ مِن أمرِ أُمَّتي شيئًا فشَقَّ عليهم",1]," ",["فاشقُقْ عليه",2],"، ومَن وليَ مِن أمرِ أُمَّتي شيئًا فرَفَقَ بهِم فارفُقْ به."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"QcPWwUvF"},{"id":"س-08045","fp":"cbf75e8f0cac","stateId":492,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم ولو كان كافراً","cause":"اتَّقوا دَعوةَ المَظْلومِ وإن كانَ كافِرًا","result":"فإنَّه ليس دونَه حِجابٌ","explicit":true,"repOf":"س-08435","otherNeedIds":[28],"ref":"الأحاديث المختارة 2747","text":["«",["اتَّقوا دَعوةَ المَظْلومِ وإن كانَ كافِرًا؛ ",1],["فإنَّه ليس دونَه حِجابٌ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"مظالم › تحريم الظلم","dorar":"gy8yWcpg"},{"id":"س-08075","fp":"6372b5a58b1c","stateId":492,"easy":"إذا قطعت ود أبيك ← يطفئ الله نورك","cause":"احفَظ وُدَّ أبيكَ ، لا تقطعهُ","result":"فيُطْفِئَ اللَّهُ نورَكَ","explicit":true,"ref":"الفتوحات الربانية 4/106","srcLabel":"البخاري","text":[["احفَظ وُدَّ أبيكَ ، لا تقطعهُ",1]," ",["فيُطْفِئَ اللَّهُ نورَكَ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (40)، والطبراني في ((المعجم الأوسط)) (8633)، والبيهقي في ((شعب الإيمان)) (7898)","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"Hd5O4Lzj"},{"id":"س-05100","fp":"cc24562eaddc","stateId":492,"easy":"إذا بغيت أو قطعت رحمك ← فلا ذنب أحرى بتعجيل العقوبة في الدنيا مع ما يُدخر في الآخرة","cause":"بَغْيٍ، أو قَطيعةِ رَحِمٍ","result":"ما مِن ذَنبٍ أحْرى أنْ يُعَجَّلَ لِصاحِبِهِ العُقوبةُ مع ما يُؤَخَّرُ له في الآخِرَةِ","explicit":true,"similar":["س-04802"],"otherNeedIds":[39,57],"ref":"تخريج المسند لشعيب 20374","srcLabel":"أبو داود","text":[["ما مِن ذَنبٍ أحْرى أنْ يُعَجَّلَ لِصاحِبِهِ العُقوبةُ مع ما يُؤَخَّرُ له في الآخِرَةِ",2],"، مِن ",["بَغْيٍ، أو قَطيعةِ رَحِمٍ",1],"، قال وَكيعٌ: أنْ يُعَجِّلَ اللهُ، وقالَ يَزيدُ: يُعَجِّلُ اللهُ، وقالَ: مع ما يَدَّخِرُ له."],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4902)، والترمذي (2511)، وابن ماجه (4211)، وأحمد (20374) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"UuoYCl8S","merged":7,"otherRefs":["تخريج مشكل الآثار 5998 (صحيح)","صحيح الأدب المفرد 459 (صحيح)","صحيح الجامع 2810 (صحيح)","تخريج المسند لشعيب 20380 (صحيح)","المستدرك على الصحيحين 7496 (صحيح)","صحيح الأدب المفرد 687 (صحيح)"]},{"id":"س-01755","fp":"a1eea1ca3c3f","stateId":492,"easy":"إذا حلفت يميناً فاجرة ← تدع الديار بلاقع","cause":"واليمينُ الفاجرةُ","result":"تدَعُ الدِّيارَ بَلاقِعَ","explicit":true,"similar":["س-05247"],"otherNeedIds":[3],"ref":"السلسلة الصحيحة 2/670","srcLabel":"الطبراني","text":["ثلاثٌ مَن كنَّ فيه رأى وبالَهنَّ قبل موتِه فذكرَهن وفي آخرِهن ",["واليمينُ الفاجرةُ",1]," ",["تدَعُ الدِّيارَ بَلاقِعَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1092)، والقضاعي في ((مسند الشهاب)) (255)، والبيهقي (20364) مطولاً بنحوه","bab":"أيمان › تعظيم شأن الأيمان","dorar":"BogJovW6","merged":3,"otherRefs":["شرح مسند أبي حنيفة 535 (حسن)","صحيح الترغيب 1836 (حسن)"]},{"id":"س-04802","fp":"eb30c5a18866","stateId":492,"easy":"إذا بغيت أو قطعت رحمك ← فلا شيء أعجل عقوبة منهما","cause":"البَغْيِ و قَطِيعَةِ الرَّحِمِ","result":"و ليس شيءٌ أَعْجَلَ عِقَابًا","explicit":true,"repOf":"س-05100","ref":"السلسلة الصحيحة 978","text":["ليس شيءٌ أُطِيعَ اللهُ فيهِ أَعْجَلَ ثَوَابًا من صِلَةِ الرَّحِمِ ، ",["و ليس شيءٌ أَعْجَلَ عِقَابًا",2]," مِنَ ",["البَغْيِ و قَطِيعَةِ الرَّحِمِ",1]," ، و اليَمِينُ الفَاجِرَةُ تَدَعُ الدِّيارَ بَلا قِعَ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت بجموع الطرق","takhrij":"أخرجه أبو نعيم في ((مسند أبي حنيفة)) (ص243) باختلاف يسير، والقضاعي في ((مسند الشهاب)) (255) مختصراً، والبيهقي (20364) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"3PzvX6VT","merged":3,"otherRefs":["شرح مسند أبي حنيفة 535 (حسن)","فيض القدير 1017 (حسن)"]},{"id":"س-05509","fp":"2b79e1954255","stateId":492,"easy":"إذا شاققت المسلمين ← يشقق الله عليك يوم القيامة","cause":"ومَن يُشاقِقْ","result":"يَشقُقِ اللهُ عليه يَومَ القيامةِ","explicit":true,"otherNeedIds":[57],"ref":"صحيح البخاري 7152","srcLabel":"البيهقي","text":["شَهِدتُ صَفوانَ وجُندَبًا وأصحابَه وهو يوصيهم، فقالوا: هل سَمِعتَ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم شيئًا؟ قال: سَمِعتُه يقولُ: مَن سَمَّعَ سَمَّعَ اللهُ به يَومَ القيامةِ، قال: ",["ومَن يُشاقِقْ",1]," ",["يَشقُقِ اللهُ عليه يَومَ القيامةِ",2],"، فقالوا: أوصِنا، فقال: إنَّ أوَّلَ ما يُنتِنُ مِنَ الإنسانِ بَطنُه، فمَنِ استَطاعَ أن لا يَأكُلَ إلَّا طَيِّبًا فليَفعَلْ، ومَنِ استَطاعَ أن لا يُحالَ بينَه وبينَ الجَنَّةِ بمِلءِ كَفِّه مِن دَمٍ أهراقَه فليَفعَلْ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5369)، وابن الحداد في ((جامع الصحيحين)) (2227)، والبغوي في ((معجم الصحابة)) (362) واللفظ لهم.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"kVcAd8Nq","merged":3,"otherRefs":["صحيح الجامع 6304 (صحيح)","المستدرك على الصحيحين 2380 (صحيح)"]},{"id":"س-00454","fp":"2d4671bbbff9","stateId":492,"easy":"إذا ماطلت وأنت واجد ← يحل عرضك وعقوبتك","cause":"ليُّ الواجِدِ","result":"ظُلمٌ يُحِلُّ عِرْضَه وعُقوبَتُه","explicit":true,"otherNeedIds":[39],"ref":"نيل المرام 394","srcLabel":"نيل المرام","text":["«",["ليُّ الواجِدِ",1]," ",["ظُلمٌ يُحِلُّ عِرْضَه وعُقوبَتُه",2],"»"],"grade":"صحيح","muhaddith":"ثابت.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"csMVnFlv","merged":2,"otherRefs":["الجامع الصغير 7724 (صحيح)"]},{"id":"س-05577","fp":"68e372e5609b","stateId":492,"easy":"إذا ظلمت ← فاحذر دعوة المظلوم فإنها تُستجاب","cause":"دعواتِ المظلومِ","result":"فإنَّها تُستجابُ","explicit":true,"repOf":"س-08435","otherNeedIds":[28],"ref":"المطالب العالية 3/347","text":["شهدتُّ أبَا الدرداءِ رضي اللهُ عنه حينَ حضَرَهُ المَوْتُ ، فقالَ: إني محدِّثُكم حديثًا سمعتُه من رسولِ الله صلَّى اللهُ عليه وسلَّم يقولُ: اعبدِ اللهَ – تعالى – كأنكَ تراهُ ، فإن لم تكن تراهُ فإنه يراكَ ، وعُدَّ نفسَكَ في المَوْتَى ، واتَّقِ ",["دعواتِ المظلومِ",1]," ",["فإنَّها تُستجابُ",2]," ، ومن استطاع منكم أن يشهدَ العِشَاءَ الآخرةَ وصلاةَ الغداةِ في جماعةٍ فليفعلْ ولو حَبْوًا"],"grade":"صحيح","narrator":"رجل من النخع","muhaddith":"صحيح لولا المبهم","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (68/ 112) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"icCrh1nl","merged":2,"otherRefs":["الترغيب والترهيب 4/202 (صحيح)"]},{"id":"س-00275","fp":"411aa20b3990","stateId":492,"easy":"إذا أكلت طعام البخيل ← فهو داء","cause":"طَعامُ البَخيلِ","result":"داءٌ","explicit":true,"ref":"الأحكام الوسطى 4/ 146","srcLabel":"الأحكام الوسطى","text":[["طَعامُ البَخيلِ",1]," ",["داءٌ",2],"، وطَعامُ السَّخِيِّ شِفاءٌ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"S4rnQbbf"},{"id":"س-00383","fp":"066f31b337f5","stateId":492,"easy":"إذا شححت ← فالشح أهلك من قبلكم أمرهم بالظلم والقطيعة والفجور","cause":"إيَّاكم والشُّحَّ","result":"فإنَّه أهلَكَ مَن كان قبلَكم، أمَرَهم بالظُّلمِ فظلَموا، وأمَرَهم بالقَطيعةِ فقطَعوا، وأمَرَهم بالفُجورِ ففجَروا، وإيَّاكم والظُّلمَ؛ فإنَّ الظُّلمَ ظُلماتٌ يومَ القيامةِ، وإيَّاكم والفُحشَ؛ فإنَّ اللهَ لا يحِبُّ الفُحشَ","explicit":true,"similar":["س-00440"],"otherNeedIds":[12,26],"ref":"تخريج المسند لشعيب 6792","srcLabel":"أبو داود","text":[["إيَّاكم والشُّحَّ؛ ",1],["فإنَّه أهلَكَ مَن كان قبلَكم، أمَرَهم بالظُّلمِ فظلَموا، وأمَرَهم بالقَطيعةِ فقطَعوا، وأمَرَهم بالفُجورِ ففجَروا، وإيَّاكم والظُّلمَ؛ فإنَّ الظُّلمَ ظُلماتٌ يومَ القيامةِ، وإيَّاكم والفُحشَ؛ فإنَّ اللهَ لا يحِبُّ الفُحشَ",2]," ولا التَّفحُّشَ، قال: فقام إليه رَجُلٌ، فقال: يا رسولَ اللهِ، أَيُّ المُسلمينَ أفضلُ؟ قال: مَن سلِمَ المُسلمونَ مِن لِسانِه ويدِه، قال: فقام هو أو آخَرُ، فقال: يا رسولَ اللهِ، أَيُّ الجهادِ أفضلُ؟ قال: مَن عُقِرَ جَوادُه، وأُهريقَ دَمُه.\n[قال عبدُ اللهِ بنُ أحمدَ]: قال أبي: وقال يزيدُ بنُ هارونَ في حديثِه: ثُمَّ ناداه هذا أو غيرُه، فقال: يا رسولَ اللهِ، أَيُّ الهِجرةِ أفضلُ؟ قال: أنْ تهجُرَ ما كرِهَ ربُّكَ، وهما هِجرتانِ: هِجرةٌ لِلبادي، وهِجرةٌ لِلحاضرِ، فأمَّا هِجرةُ البادي: فيُطيعُ إذا أُمِرَ، ويُجيبُ إذا دُعيَ، وأمَّا هِجرةُ الحاضرِ: فهي أشدُّهما بَليَّةً، وأعظمُهما أَجرًا."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1698)، والنسائي في ((السنن الكبرى)) (11583) مختصراً، وأحمد (6792) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"V9A7Jpxn"},{"id":"س-00411","fp":"23be03d6ecaf","stateId":492,"easy":"إذا بخلت ← فالبخل دعا قوماً فمنعوا زكاتهم وقطعوا أرحامهم وسفكوا دماءهم","cause":"إياكم والبخلُ","result":"فإنَّ البخلَ دعا قومًا فمنعوا زكاتَهم ودعاهم فقطعوا أرحامَهم ودعاهم فسفكوا دماءَهم","explicit":true,"ref":"مسند عمر 1/105","srcLabel":"أحمد","text":[["إياكم والبخلُ ",1],["فإنَّ البخلَ دعا قومًا فمنعوا زكاتَهم ودعاهم فقطعوا أرحامَهم ودعاهم فسفكوا دماءَهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9569)، وابن حبان (5177) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"bYiKzVmY"},{"id":"س-00440","fp":"f0dea4864e6a","stateId":492,"easy":"إذا شححت ← فالشح أهلك الأمم قبلكم","cause":"إياكم والشحُّ","result":"فإنَّهُ أهلكَ من كان قبلكم من الأممِ دعاهم فسفكوا دماءَهم ودعاهم فقتلوا أولادَهم","explicit":true,"repOf":"س-00383","ref":"مسند عمر 1/105","text":[["إياكم والشحُّ ",1],["فإنَّهُ أهلكَ من كان قبلكم من الأممِ دعاهم فسفكوا دماءَهم ودعاهم فقتلوا أولادَهم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (9569)، وابن حبان (5177) بنحوه.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"T83o0cjd"},{"id":"س-05155","fp":"966aa29e2f09","stateId":492,"easy":"إذا عققت والديك ← يعجّل الله لك العقوبة في حياتك قبل مماتك","cause":"عُقوقَ الوالِدَيْنِ","result":"يُعجِّلُه لِصاحبِه في الحياةِ قبْلَ المماتِ","explicit":true,"ref":"المستدرك على الصحيحين 7469","srcLabel":"البيهقي","text":["كُلُّ الذُّنوبِ يُؤخِّرُ اللهُ ما شاءَ مِنها إلى يومِ القِيامةِ إلَّا ",["عُقوقَ الوالِدَيْنِ",1],"؛ فإنَّ اللهَ تَعالَى ",["يُعجِّلُه لِصاحبِه في الحياةِ قبْلَ المماتِ",2],"."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه يعقوب بن سفيان الفسوي في ((مشيخته)) (14)، وقوام السنة الأصفهاني في ((الترغيب والترهيب)) (468)، والبيهقي في ((شعب الإيمان)) (7505) مطولا، وجميعا بلفظه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FbFOvRiV"},{"id":"س-06128","fp":"5362bc22f4c2","stateId":492,"easy":"إذا ظهرت الفاحشة في قوم علانية ← يظهر فيهم الطاعون والأوجاع الجديدة","cause":"ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً","result":"إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم","explicit":true,"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ",["ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛",1]," ",["إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم",2]," ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06129","fp":"dec4d7857cc4","stateId":492,"easy":"إذا منع قوم الزكاة ← مُنعوا القطر من السماء ولولا البهائم لم يُمطروا","cause":"وما منع قومٌ الزكاةَ","result":"إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا","explicit":true,"otherNeedIds":[3],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، ",["وما منع قومٌ الزكاةَ",1]," ؛ ",["إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا",2]," ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه ؛ إلا جعل اللهُ بأسَهم بينهم"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-06132","fp":"90efe83e9a47","stateId":492,"easy":"إذا عطّلوا كتاب الله وسنة نبيه ← جعل الله بأسهم بينهم","cause":"وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه","result":"إلا جعل اللهُ بأسَهم بينهم","explicit":true,"otherNeedIds":[39],"ref":"صحيح الترغيب 2187","srcLabel":"ابن ماجه","text":["كيف أنتم إذا وقعت فيكم خمسٌ ؟ وأعوذ باللهِ أن تكون فيكم أو تُدرِكوها : ما ظهرتِ الفاحشةُ في قومٍ قطُّ يعملُ بها فيهم علانيةً ؛ إلا ظهر فيهم الطاعونُ والأوجاعُ التي لم تكن في أسلافِهم ، وما منع قومٌ الزكاةَ ؛ إلا مُنِعوا القطرَ من السماءِ ولولا البهائمُ لم يُمطَروا ، وما بخَس قومٌ المكيالَ والميزانَ ؛ إلا أُخِذوا بالسِّنينَ وشِدَّةِ المؤْنةِ وجَوْرِ السُّلطانِ ، ولا حكم أمراؤهم بغير ما أنزل اللهُ ؛ إلا سلَّطَ اللهُ عليهم عدوَّهم فاستنقَذوا بعضَ ما في أيديهم ، ",["وما عطَّلوا كتابَ اللهِ وسنَّةَ نبيِّه",1]," ؛ ",["إلا جعل اللهُ بأسَهم بينهم",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (4019) باختلاف يسير، والطبراني (12/446) (13619) مختصراً، والحاكم (8623) مطولاً باختلاف يسير","bab":"زكاة › عقوبة مانع الزكاة","dorar":"xjvYry2k"},{"id":"س-08026","fp":"92c22d16844f","stateId":492,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فإنها تصعد إلى السماء كأنها شرارة","cause":"اتَّقُوا دعوةَ المظلومِ","result":"فإنَّها تَصْعَدُ إلى السَّماءِ كأنَّها شَرَارَةٌ","explicit":true,"repOf":"س-08435","otherNeedIds":[28],"ref":"صحيح الترغيب 2228","text":[["اتَّقُوا دعوةَ المظلومِ ؛ ",1],["فإنَّها تَصْعَدُ إلى السَّماءِ كأنَّها شَرَارَةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (81)، والديلمي (307)","bab":"مظالم › تحريم الظلم","dorar":"sB3HOK4r"},{"id":"س-08035","fp":"3f4caa37538d","stateId":492,"easy":"إذا بغيت ولو على جبل ← لدُكّ الباغي","cause":"بغَى على جبلٍ","result":"لدُكَّ الباغي","explicit":true,"ref":"صحيح الأدب المفرد 457","srcLabel":"البخاري (الأدب المفرد)","text":["عن ابنِ عبَّاسٍ قال لو أنَّ جبلًا ",["بغَى على جبلٍ",1]," ",["لدُكَّ الباغي",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"مظالم › تحريم الظلم","dorar":"kBpK8fAt"},{"id":"س-08044","fp":"0276b16b02f6","stateId":492,"easy":"إذا بغيت ← فإنما بغيك على نفسك","cause":"لا تَبْغِ ولا [تعنْ] باغِيًا","result":"إنَّما بَغْيُكم على أنْفُسِكم","explicit":true,"ref":"المستدرك على الصحيحين 3340","srcLabel":"البيهقي","text":[["لا تَبْغِ ولا [تعنْ] باغِيًا",1],"؛ فإنَّ اللهَ يقولُ: {",["إنَّما بَغْيُكم على أنْفُسِكم",2],"}."],"grade":"صحيح","narrator":"أبو بكرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6244) بلفظه.","bab":"مظالم › تحريم الظلم","dorar":"jTLbDpxR"},{"id":"س-08070","fp":"f6544fb35119","stateId":492,"easy":"إذا قطعت رحمك أو خنت أو كذبت ← فلا ذنب أجدر بتعجيل العقوبة","cause":"قطيعةِ الرَّحِمِ ، والخيانةِ ، والكذبِ","result":"ما من ذنبٍ أجدرُ أن يُعجِّلَ اللهُ تعالى لصاحبِه العقوبةَ في الدنيا ، مع ما يَدِّخِرُه له في الآخرةِ","explicit":true,"otherNeedIds":[57],"ref":"صحيح الجامع 5705","srcLabel":"أبو داود","text":[["ما من ذنبٍ أجدرُ أن يُعجِّلَ اللهُ تعالى لصاحبِه العقوبةَ في الدنيا ، مع ما يَدِّخِرُه له في الآخرةِ",2]," من ",["قطيعةِ الرَّحِمِ ، والخيانةِ ، والكذبِ",1]," ، وإنَّ أَعجلَ الطاعةِ ثوابًا لصلَةُ الرَّحِمِ ، حتى إنَّ أهلَ البيتِ ليكونوا فجَرةً ، فتنمو أموالُهم ، ويكثُرُ عددُهم ، إذا تواصَلوا"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4902)، والترمذي (2511)، وابن ماجه (4211)، وأحمد (20374) مختصراً، وابن حبان (440، 455) مفرقاً باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"YEtGOzfj"},{"id":"س-01621","fp":"f645a70bee6e","stateId":492,"easy":"إذا شبعت وجارك جائع ← يعاقبك الله (من قصة يعقوب)","cause":"وذبحتَ أنت وأهلُك شاةً فأكلتموها ولم تطعِموه","result":"أتدري لم أذهبتُ بصرَك وحنَيْتُ ظهرَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[21],"ref":"الترغيب والترهيب 3/316","srcLabel":"الحاكم","text":["أنَّ رجلًا قال ليعقوبَ عليه السَّلامُ ما الَّذي أذهب بصرَك وحنَى ظهرَك قال أمَّا الَّذي أذهب بصري فالبكاءُ على يوسفَ وأمَّا الَّذي حنَى ظهري فالحزنُ على أخيه بنيامينَ فأتاه جبريلُ عليه السَّلامُ فقال أتشكو اللهَ عزَّ وجلَّ قال إنَّما أشكو بثِّي وحُزني إلى اللهِ قال جبريلُ عليه السَّلامُ اللهُ أعلمُ بما قلتَ منك قال ثمَّ انطلق جبريلُ عليه السَّلامُ ودخل يعقوبُ عليه السَّلامُ بيتَه فقال أيْ ربِّ أما ترحمُ الشَّيخَ الكبيرَ أذهبتَ بصري وحنَيْتَ ظهري فاردُدْ عليَّ ريحانتَيَّ فأشُمَّهما شمَّةً واحدةً ثمَّ اصنَعْ بي بعد ما شئتَ فأتاه جبريلُ فقال يا يعقوبُ إنَّ اللهَ عزَّ وجلَّ يُقرِئُك السَّلامَ ويقولُ أبشِرْ فإنَّهما لو كانا ميِّتَيْن لنشرتُهما لك لأُقِرَّ بهما عينَك ويقولُ لك يا يعقوبُ ",["أتدري لم أذهبتُ بصرَك وحنَيْتُ ظهرَك",2]," ولِمَ فعل إخوةُ يوسفَ بيوسفَ ما فعلوه قال لا قال إنَّه أتاك يتيمٌ مسكينٌ وهو صائمٌ جائعٌ ",["وذبحتَ أنت وأهلُك شاةً فأكلتموها ولم تطعِموه",1]," ويقولُ إنِّي لم أحبَّ شيئًا من خلقي حبِّي اليتامَى والمساكينَ فاصنَعْ طعامًا وادْعُ المساكينَ قال أنسٌ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان يعقوبُ كلَّما أمسَى نادَى مناديه من كان صائمًا فليحضُرْ طعامَ يعقوبَ وإذا أصبح نادَى مناديه من كان مُفطرًا فليفطِرْ على طعامِ يعقوبَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((الأوسط)) (6/170)، ووالحاكم (2/378)، والبيهقي في ((الشعب)) (3/230) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"DmIQUj0a"},{"id":"س-04835","fp":"372575ce34c7","stateId":492,"easy":"إذا أضررت بأحد ← يضرّ الله بك","cause":"من ضارَّ","result":"ضارَّ اللهُ به","explicit":true,"ref":"صحيح الجامع 6372","srcLabel":"أبو داود","text":[["من ضارَّ ، ",1],["ضارَّ اللهُ به",2]," ، و من شاقَّ ، شاقَّ اللهُ عليه"],"grade":"حسن","narrator":"أبو صرمة مالك بن قيس المازني","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3635)، والترمذي (1940) واللفظ له، وابن ماجه (2342)، وأحمد (15755)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mRTQPa2f"},{"id":"س-05247","fp":"d49bb4a516f4","stateId":492,"easy":"إذا حلفت يميناً غموساً ← تدع الديار بلاقع","cause":"اليَمينُ الغَموسُ","result":"تدَعُ الدِّيارَ بَلاقِعَ","explicit":true,"repOf":"س-01755","otherNeedIds":[3],"ref":"تخريج شرح السنة 1/85","text":[["اليَمينُ الغَموسُ",1]," ",["تدَعُ الدِّيارَ بَلاقِعَ",2],"."],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"حسن","takhrij":"أخرجه خيثمة الأطرابلسي في (( المنتخب من الفوائد)) (ص 70) بلفظه، والدولابي في (( الكنى والأسماء)) (2072)، والخطيب في (( تلخيص المتشابه في الرسم )) (2/ 702)  كلاهما بلفظه وزادا : ((الْكَاذِبَةُ))","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NaxarNaA"},{"id":"س-08036","fp":"69f90839d90a","stateId":492,"easy":"إذا ظلمت ← فاتقِ دعوة المظلوم فإنما يسأل الله حقه","cause":"اتَّقِ دعوةَ المظلومِ","result":"فإنَّما يسألُ اللهَ حقَّه ، وإنَّ اللهَ لم يمنعْ ذا حقٍّ حقَّه","explicit":true,"repOf":"س-08435","ref":"حلية الأولياء 3/235","text":["يا عليُّ ! ",["اتَّقِ دعوةَ المظلومِ ، ",1],["فإنَّما يسألُ اللهَ حقَّه ، وإنَّ اللهَ لم يمنعْ ذا حقٍّ حقَّه",2]],"grade":"حسن","narrator":"علي بن علي بن أبي طالب","muhaddith":"غريب من حديث جعفر بن محمد عن آبائه متصلا تفرد به منصور عن صالح عنه","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7464) والخطيب في ((الموضح)) (223) والديلمي في ((مسند الفردوس)) كما في ((الغرائب الملتقطة)) (1047) باختلاف يسير.","bab":"مظالم › تحريم الظلم","dorar":"07da3Syq"},{"id":"س-03899","fp":"14b8b2482fbd","stateId":492,"easy":"إذا قطعت رحمك وأسأت جوارها ← قد تعجّل لك العقوبة (من قصة)","cause":"فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه","result":"تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، ",["فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه",1],"، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها ",["تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها",2],"، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\nفسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-03900","fp":"0b7dbc4c563a","stateId":492,"easy":"إذا أكلت مال قريبك وشتمت عرضه ← قد تعجّل لك العقوبة (من قصة)","cause":"فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه","result":"انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[28],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، ",["فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه",1],"، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ ",["انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه",2],"، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\nفسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-03901","fp":"cc88f22c02e1","stateId":492,"easy":"إذا ظلمت قريبك ← قد يسلّط الله عليك ما يهلكك (من قصة)","cause":"فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه","result":"فسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فضائل الأوقات 12","srcLabel":"البيهقي","text":["بَينا نحن عِندَ عُمَرَ بنِ الخَطَّابِ رَضيَ اللهُ عنه في يَومٍ يَعرِضُ فيه الدِّيوانَ إذْ مَرَّ به رَجُلٌ أعمى، أعرَجُ، قد عَنَّى قائِدَه، فقالَ عُمَرُ حين رآه وأعجَبَه شَأنُه: مَن يَعرِفُ هذا؟ قال رَجُلٌ مِنَ القَومِ: هذا رَجُلٌ مِن بَني صَبغاءَ، بَهلةَ بَريقٍ، قال: وما بَريقٌ؟ قال: رَجُلٌ مِن أهلِ اليَمَنِ؟ قال: أشاهِدٌ هو؟ قال: نَعَمْ. فأُتيَ به عُمَرُ فقال: ما شَأنُكَ وشَأنُ بَني صَبغاءَ؟ قال: إنَّ بَني صَبغاءَ كانوا اثنَيْ عَشَرَ رَجُلًا، وإنَّهم جاوَروني في الجاهليَّةِ، فجَعَلوا يَأكُلونَ مالي، ويَشتِمونَ عِرْضي، وأنا أشتَهيهم، وناشَدتُهمُ اللهَ والرَّحِمَ، فأبَوْا علَيَّ، فأمهَلتُهم حتى إذا كان الشَّهرُ الحَرامُ دَعَوتُ اللهَ عليهم، وقُلتُ: \nاللَّهمَّ أدعوكَ دُعاءً جاهِدَا *** اقتُلْ بَني صَبغاءَ إلَّا واحِدًا\nثم اضرِبِ الرَّجُلَ فذَره قاعِدَا *** أعمى إذا ما قيدَ عَنَّى القائِدا\nفلم يَحُلِ الحَولُ حتى هَلَكوا غَيرَ واحِدٍ، وهو هذا كما ترى قد عَنَّى قائِدَه. فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبَرًا وعَجَبًا. فقالَ رَجُلٌ آخَرُ مِنَ القَومِ: ألَا أُحَدِّثُكَ يا أميرَ المُؤمِنينَ مِثلَ هذا وأعجَبَ منه؟ فقال: بلى. قال: فإنَّ رِجالًا مِن خُزاعةَ جاوَروا رَجُلًا منهم، فقَطَعوا رَحِمَه، وأساؤوا مُجاوَرَتَه، وإنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا أعفَوْه مِمَّا يَكرَهُ، فأبَوْا عليه، فأمهَلَهم حتى إذا جاءَ الشَّهرُ الحَرامُ دعا عليهم فقالَ:\nاللَّهمَّ رَبَّ كُلِّ آمِنٍ وخائِفْ *** وسامِعًا هُتافَ كُلِّ هاتِفْ\nإنَّ الخُزاعِيَّ أبا تَقاصُفْ *** لم يُعطِني الحَقَّ ولم يُناصِفْ\nفاجمَعْ له الأحِبَّةَ ‌[الألاطف]* بَني قِرانٍ ثَمَّ والنَّواصِفْ\nاجمَعْهم في جَوفِ كُلِّ راجِفْ\nقال: فبَينا هم عِندَ قَليبٍ يَنزِفونَها، فمنهم مَن هو فيها، ومنهم مَن هو فَوقَها تَهَوَّرَ القَليبُ بمَن كان عليها وعلى مَن كانَ فيها، وصارَتْ قُبورُهم حتى الساعةِ، قال عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، فقالَ رَجُلٌ مِنَ القَومِ آخَرُ: يا أميرَ المُؤمِنينَ ألَا أُخبِرُكَ بمِثلِ هذا وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن هُذَيلٍ وَرِثَ فَخِذَه التي هو فيها، حتى لم يَبقَ منهم أحَدٌ غَيرُه، فجَمَعَ مالًا كَثيرًا فعَمَدَ إلى رَهطٍ مِن قَومِه، يُقالُ لهم: بَنو المُؤَمَّلِ، فجاوَرَهم لِيَمنَعوه، ولِيرُدُّوا عليه ماشِيَتَه، وإنَّهم حَسَدوه على مالِه ونَفَسوه مالَه، فجَعَلوا يَأكُلونَ مِن مالِه، ويَشتِمونَ عِرضَه، وأنَّه ناشَدَهمُ اللهَ والرَّحِمَ إلَّا عَدَلوا عنه ما يَكرَه، فأبَوْا عليه، فجَعَلَ رَجُلٌ منهم يُقالُ له: رَباحٌ، أو رياحٌ، يُكَلِّمُهم فيه، ويَقولُ: يا بَني المُؤَمَّلِ، ابنُ عَمَّتِكمُ اختارَ مُجاوَرَتَكم على مَن سِواكم، فأحسِنوا مُجاوَرَتَه، فأبَوْا عليه، فأمهَلَهم حتى إذا كانَ الشَّهرُ الحَرامُ دعا عليهم، فقال:\nاللَّهمَّ أزِلْ عَنِّي بَني المُؤَمَّلِ *** وارْمِ على أقفائِهم بمَنكِلِ\nبصَخرةٍ أو عَرضِ جَيشٍ جَحفَلِ *** إلَّا رَباحًا إنَّه لم يَفعَلِ\nقال: فبَينَما هم ذاتَ يَومٍ نُزولٌ إلى أصلِ جَبَلٍ انحَطَّتْ عليهم صَخرةٌ مِنَ الجَبَلِ، لا تَمُرُّ بشَيءٍ إلَّا طَحَنَتْه، حتى مَرَّتْ بأبياتِهم فطَحَنَتْها طَحنةً واحِدةً، إلَّا رَباحًا الذي استَثْناهُ. فقال: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا. فقالَ رَجُلٌ مِنَ القَومِ: ألَا أُخبِرُكَ يا أميرَ المُؤمِنينَ مِثلَه وأعجَبَ منه؟ قال: بلى. قال: فإنَّ رَجُلًا مِن جُهَينةَ جاوَرَ قَومًا مِن بَني ضَمرةَ في الجاهليَّةِ، وكانَ رَجُلٌ مِن بَني ضَمرةَ يُقالُ له: ريشةُ، يَعدو عليه، ",["فلا يَزالُ يَنحَرُ بَعيرًا مِن إبِلِه",1]," وإنَّه كَلَّمَ قَومَه فيه، فقالوا: إنَّا خَلَعْناه، فانظُرْ أنْ نَقتُلَه. فلَمَّا رآه لا يَنتَهي أمهَلَه حتى إذا كانَ الشَّهرُ الحَرامُ دَعا عليه، فقالَ:\nأصادِقٌ ريشةُ بلا ضَمرةْ *** أنْ يُسيِّرَ اللهُ عليه قَدَرَهْ\nأمَا يَزالُ شارِفٌ أو بَكْرَةْ *** يَطعُنُ منها في سَواءِ الثُّغرةْ\nبصارِمٍ ذي رَونَقٍ أو شَفرةْ *** اللَّهمَّ إنْ كان بَعدي فَجرَهْ\nفاجعَلْ أمامَ العَينِ منه حَذرَهْ *** يَأكُلُه حتى يُوافى الحُفرةْ\n",["فسَلَّطَ الله عليه أكَلةً فأكَلَتْه حتى ماتَ قَبلَ الحَولِ",2],". فقالَ عُمَرُ: سُبحانَ اللهِ! إنَّ في هذا لَعِبرةً وعَجَبًا، وإنْ كانَ اللهُ لَيَصنَعُ هذا بالناسِ في جاهليَّتِهم لِيَنزِعَ بَعضَهم مِن بَعضٍ، فلَمَّا أتى اللهُ بالإسلامِ أخَّرَ اللهُ العُقوبةَ إلى يَومِ القِيامةِ، وذلك أنَّ اللهَ تَعالى قالَ: {إِنَّ يَوْمَ الْفَصْلِ مِيقَاتُهُمْ أَجْمَعِينَ} [الدخان: 40]، {بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ أَدْهَى وَأَمَرُّ} [القمر: 46]، وقال: {وَلَوْ يُؤَاخِذُ اللَّهُ النَّاسَ بِظُلْمِهِمْ مَا تَرَكَ عَلَيْهَا مِنْ دَابَّةٍ وَلَكِنْ يُؤَخِّرُهُمْ إِلَى أَجَلٍ مُسَمًّى} [النحل: 61]."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3529) واللفظ له، وابن أبي الدنيا في ((مجابو الدعوة)) (20)، وابن عساكر في ((فضل رجب)) (4) بنحوه.","bab":"تفسير آيات › سورة الدخان","dorar":"5hVa44Z0"},{"id":"س-01603","fp":"d6a433ff2b69","stateId":492,"easy":"إذا دعوت الأغنياء ومنعت الفقراء ← فطعامك شر الطعام","cause":"يُدعَى إليها من يَأْبَاها ويُمنعُ منها من يَأْتِيها","result":"شَرُّ الطعامِ طعامُ الوليمةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[12],"ref":"إرواء الغليل 7/4","srcLabel":"متفق عليه","text":["كان أبو هريرةَ يُدْعَى إلى طعامٍ فيذهبُ إليهِ ونذهبُ معهُ فيُنادي ",["شَرُّ الطعامِ طعامُ الوليمةِ",2]," ",["يُدعَى إليها من يَأْبَاها ويُمنعُ منها من يَأْتِيها",1]],"grade":"حسن","narrator":"ميمون بن ميسرة","muhaddith":"رجاله ثقات معروفون غير ميمون بن ميسرة","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (3016) واللفظ له، وسعيد بن منصور في ((سننه)) (526) بنحوه، والبخاري (5177)، ومسلم (1432) وزادا:\"فمن لم يجب فقد عصى الله ورسوله\".","bab":"أطعمة › إجابة الدعوة","dorar":"FZjzjNSa"},{"id":"س-01774","fp":"f20d855a90d8","stateId":493,"easy":"إذا تبخترت في مشيتك ← يغضب الله عليك وقد يخسف بك","cause":"يتبَختَرُ بَينَ بُردَيْنِ","result":"فغضِبَ اللهُ عليه، فأمَرَ الأرضَ فبلَعَتْهُ، فوالذي نَفْسي بيَدِهِ؛ إنَّهُ ليتجَلجَلُ إلى يَومِ القيامةِ","explicit":true,"star":true,"otherNeedIds":[59],"ref":"تخريج المسند لشعيب 10455","srcLabel":"متفق عليه","text":["بينا رَجُلٌ ممَّن كان قَبلَكم، ",["يتبَختَرُ بَينَ بُردَيْنِ",1],"، ",["فغضِبَ اللهُ عليه، فأمَرَ الأرضَ فبلَعَتْهُ، فوالذي نَفْسي بيَدِهِ؛ إنَّهُ ليتجَلجَلُ إلى يَومِ القيامةِ",2],". اذهَبْ أيُّها الرَّجُلُ إلى يَومِ القيامةِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه من طرق البخاري (5789)، ومسلم (2088)، والنسائي في ((السنن الكبرى)) (9679)، وأحمد (10455) واللفظ له","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"m4ThKEwB"},{"id":"س-04818","fp":"7ac09e4f93d1","stateId":493,"easy":"إذا دعوت على نفسك أو أولادك أو مالك ← قد توافق ساعة إجابة فيُستجاب لك","cause":"لا تَدعوا على أنفُسِكُم، ولا تَدعوا على أولادِكُم، ولا تَدعوا على أموالِكُم","result":"لا توافِقوا مِنَ اللهِ ساعةً يُسألُ فيها عَطاءٌ فيَستَجيبُ لَكُم","explicit":true,"star":true,"ref":"صحيح مسلم 3009","srcLabel":"مسلم","text":["سِرنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم في غَزوةِ بَطنِ بواطٍ، وهو يَطلُبُ المَجديَّ بنَ عَمرٍو الجُهَنيَّ، وكان النَّاضِحُ يَعتَقِبُه مِنَّا الخَمسةُ والسِّتَّةُ والسَّبعةُ، فدارَت عُقبةُ رَجُلٍ مِنَ الأنصارِ على ناضِحٍ له، فأناخَه فرَكِبَه، ثُمَّ بَعَثَه فتَلَدَّنَ عليه بَعضَ التَّلَدُّنِ، فقال له: شَأ، لَعَنَكَ اللهُ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن هذا اللَّاعِنُ بَعيرَه؟ قال: أنا، يا رَسولَ اللهِ، قال: انزِلْ عنه، فلا تَصحَبنا بمَلعونٍ، ",["لا تَدعوا على أنفُسِكُم، ولا تَدعوا على أولادِكُم، ولا تَدعوا على أموالِكُم",1],"، ",["لا توافِقوا مِنَ اللهِ ساعةً يُسألُ فيها عَطاءٌ فيَستَجيبُ لَكُم",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (3009).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"1sojxw0Q"},{"id":"س-08249","fp":"97c939f0c25e","stateId":493,"easy":"إذا مشيت معجباً بنفسك ← قد يخسف الله بك","cause":"يَمشي في حُلَّةٍ قد أَعجَبتْهُ نفسُه","result":"خَسف اللهُ تعالى بهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[59,26],"ref":"المطالب العالية 4/221","srcLabel":"مسلم","text":["دخلتِ امرأَةٌ النَّارَ في هِرَّةٍ . . الحَديثَ . وفيه : [ ويَشْهَدُ ] على ذلكَ أبو بكرٍ وعمرُ وليسَ ثَمَّةَ أبو بكرٍ ولا عُمرُ قال صلَّى اللهُ عليهِ وسلَّمَ : وبينَما رجلٌ في غَنمِه إذْ جاءهُ الذئْبُ ، فأخذ شاةً . . الحديثَ . وفيه : ويَشْهدُ علَى ذلكَ أبو بَكرٍ وعُمَرُ رضيَ الله عنهُما مِثلَهُ . وبينَما رجلٌ راكِبٌ بَقرةً . . الحديثُ . وفيه : ويَشْهدُ على ذلكَ أبو بكرٍ وعمرُ ، وليسَ ثَمَّةَ أبو بكرٍ ولا عمرُ رضيَ الله عنهُما . قال : وبينَما رُجلٌ ",["يَمشي في حُلَّةٍ قد أَعجَبتْهُ نفسُه",1]," ",["خَسف اللهُ تعالى بهِ",2]," . . الحديثَ . قال : وفيهِ : يَشْهَدُ علَى ذلكَ أبو بكرٍ وعمرُ وليسَ ثَمَّةَ أبو بَكرٍ ولا عُمرُ رضيَ اللهُ عنهُما ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أصله في الصحيح وغيره متفرقا","takhrij":"أخرجه مسلم (2619)، وابن ماجه (4256)، وأحمد (7547)  مقتصرا على قصة الهرة دون بقية الحديث","bab":"مناقب وفضائل › أبو بكر الصديق","dorar":"vKXlyWhw","merged":15,"otherRefs":["السلسلة الصحيحة 4/12 (حسن)","صحيح الجامع 2875 (صحيح)","مجمع الزوائد 5/129 (صحيح)","تخريج المسند لشعيب 7074 (صحيح)","صحيح مسلم 2088 (صحيح)","اجتماع الجيوش الإسلامية 52 (صحيح)","تخريج المسند لشعيب 10383 (صحيح)","تخريج المسند لشعيب 11356 (صحيح)","أحكام القرآن لابن العربي 3/530 (صحيح)","صحيح الترمذي 2491 (صحيح)","الترغيب والترهيب 4/41 (صحيح)","تنبيه الغافلين 216 (صحيح)","تخريج صحيح ابن حبان 5684 (صحيح)"]},{"id":"س-05694","fp":"11947567b997","stateId":493,"easy":"إذا دعت عليك أمك ← قد تُستجاب (من قصة جريج)","cause":"يا ربِّ أمي وصلاتي، فأقبَل على صلاتِه","result":"اللهم لا تُمِتْه حتى يَرى أو ينظُرَ في وُجوهِ المومِساتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[39],"ref":"الآداب للبيهقي 477","srcLabel":"متفق عليه","text":["لم يتكلَّمْ في المهدِ إلا ثلاثةٌ : عيسى بنُ مريمَ، قال : وكان في بني إسرائيلَ رجلٌ يُقالُ له : جُرَيجٌ وكان عابدًا، فابتَنى صومَعةً فجعَل يصلِّي فيها، فأتَتْه أمُّه فقالتْ : يا جُرَيْجُ، فقال : ",["يا ربِّ أمي وصلاتي، فأقبَل على صلاتِه",1]," فانصرفَتْ، ثم جاءَتْ يومًا آخَرَ ففعَل مثلَ ذلك، ثم جاءتْه يومًا ثالثًا ففعَل مثلَ ذلك، فقالتْ أمُّه : ",["اللهم لا تُمِتْه حتى يَرى أو ينظُرَ في وُجوهِ المومِساتِ",2]," . قال : فذكَر يومًا بنو إسرائيلَ جُرَيجًا وفضلَه فقالتْ بغِيٌّ من بَغايا بني إسرائيلَ : إن شئتُم لأفتنَنَّه لكم، فقالوا : قد شئنا، فانطلقَتْ فتعرضَتْ لجُرَيجٍ فلم يلتفِتْ إليها، فأتَتْ راعيًا وكان يأوي إلى صومعَةِ جُرَيجٍ بغنمِه فأمكنَتْه من نفسِها فحملَتْ فولدَتْ غُلامًا، فقالتْ : هو من جُرَيجٍ، فأتاه بنو إسرائيلَ فضرَبوه وشتَموه وهدَموا صَومعتَه، فقال : ما شأنُكم ؟ فقالوا : زنَيتَ بهذه البغِيِّ وولدَتْ غُلامًا . قال : فأينَ الغُلامُ ؟ قال : فجيءَ به فقام وصلَّى ودعا ثم انصرَف إلى الغُلامِ فطعَنه بإصبَعِه وقال : باللهِ يا غُلامُ مَن أبوك ؟ قال : أبي الراعي . قال : فوثَب الناسُ إليه فجعَلوا يُقَبِّلونَه وقالوا : نبني صومعتَك من ذهبٍ . قال : لا حاجةَ لي في ذلك ابنوها كما كانتْ . قال : وبينا امرأةٌ جالسةٌ وفي حَجرِها ابنٌ لها تُرضِعُه إذ مرَّ بها راكبٌ ذو شارَةٍ، فقالتْ : اللهم اجعَلِ ابني مثلَ هذا، فترَك ثديَها ثم أقبَل إلى الراكبِ فنظَر إليه فقال : اللهم لا تجعَلْني مثلَ هذا، ثم أقبَل على ثديِها يمُصُّه . قال أبو هُرَيرَةَ : لكأني أنظُرُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم يحكي مصَّه ووضْعَ إصبَعِه في فيه فجعَل يمُصُّها . ثم مرَّ بأَمةٍ معَها الناسُ تضرِبُها فقالتْ : اللهم لا تجعَلْ ابني مثلَ هذه، فترَك ثديَها ثم نظَر إليها وقال : اللهم اجعَلْني مثلَها . فعِندَ ذلك تراجَعا الحديثَ فقالتْ : خلفي أي بني مرَّ بي الراكبُ ذو شارَةٍ فقلتُ : اللهم اجعَلِ ابني مثلَ هذا، قلتَ : اللهم لا تجعلني مثلَه، ثم مرَّ بي هذه الأَمةُ فقلتُ : اللهم لا تجعَلِ ابني مثلَ هذه الأَمةِ، فقلتُ : اللهم اجعَلْني مثلَها . فقال : يا أُمَّتاه إن الراكبَ الذي مرَّ بكِ جبَّارٌ فدعوتِ اللهَ أن يجعلَني مثلَه، فقلتُ : اللهم لا تجعَلْني مثلَه . وهذه يقولونَ سَرقَتْ، ولم تسرِقْ، وزنَتْ، ولم تزْنِ وهي تقولُ : حسبيَ اللهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3436)، ومسلم (2550)، وأحمد (8071)، والبيهقي في ((الآداب)) (764) واللفظ له","bab":"رقائق وزهد › الكبر والتواضع","dorar":"in6ZBEq7","merged":2,"otherRefs":["صحيح البخاري 3436 (صحيح)"]},{"id":"س-08284","fp":"551b1d85e4ec","stateId":493,"easy":"إذا لعنت راحلتك ← تُترك (فإنها ملعونة)","cause":"لعَنَتْ راحلتَها","result":"ضَعُوا عنها فإنَّها ملعونةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 5741","srcLabel":"مسلم","text":["بيْنَما رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في بعضِ أسفارِه إذ سمِع لعنةً فقال: مَن هذا ؟ فقيل: هذه فلانةُ ",["لعَنَتْ راحلتَها",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["ضَعُوا عنها فإنَّها ملعونةٌ",2]," ) قال: فوُضِع عنها قال عِمرانُ: فكأنِّي أنظُرُ إليها ناقةً وَرْقاءَ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2595) باختلاف يسير","bab":"مناقب وفضائل › بعض من ذمهم النبي وذم أفعالهم","dorar":"Oyb1qz9H","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5740 (صحيح)"]},{"id":"س-00394","fp":"f3d7e56dc8d3","stateId":493,"easy":"إذا أظهرت الشماتة بأخيك ← يرحمه الله ويبتليك","cause":"لا تُظهِرِ الشَّماتةَ على أخيك","result":"فيَرحَمُه اللهُ ويَبْتَليك","explicit":true,"similar":["س-03166"],"ref":"الأحكام الوسطى 4/ 248","srcLabel":"الترمذي","text":["\"",["لا تُظهِرِ الشَّماتةَ على أخيك",1],"؛ ",["فيَرحَمُه اللهُ ويَبْتَليك",2],"\"."],"grade":"صحيح","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه الترمذي (2506)، والطبراني في ((الأوسط)) (3739)، وابن الأعرابي في ((معجمه)) (1612) واللفظ لهم.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"AeCSUW0f","merged":2,"otherRefs":["الترغيب والترهيب 3/287 (صحيح)"]},{"id":"س-05190","fp":"214a0734f698","stateId":493,"easy":"إذا سببت الموتى ← فأنت كالمشرف على الهلكة","cause":"سِبابُ الميِّتِ وقال مرَّةً الموتى","result":"كالمُشرِفَ على الهَلَكةِ","explicit":true,"otherNeedIds":[12],"ref":"مجمع الزوائد 8/79","srcLabel":"الطبراني","text":[["سِبابُ الميِّتِ وقال مرَّةً الموتى",1]," ",["كالمُشرِفَ على الهَلَكةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه البزار كما في ((سلسلة الأحاديث الصحيحة)) للألباني (4/377)، والطبراني (13/527) (14411) واللفظ له، والديلمي في ((الفردوس)) (3530).","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"LvYZfmmE","merged":2,"otherRefs":["الجامع الصغير 4597 (صحيح)"]},{"id":"س-00281","fp":"eb049f4910ad","stateId":493,"easy":"إذا عنفت ← فالخرق شؤم","cause":"وإنَّ الخُرقَ","result":"شُؤمٌ","explicit":true,"ref":"المصابيح في الأحاديث المتواترة 592","srcLabel":"المصابيح في الأحاديث المتواترة","text":["إنَّ الرِّفقَ يُمنٌ، ",["وإنَّ الخُرقَ",1]," ",["شُؤمٌ",2],"، وإنَّ اللهَ إذا أراد بأهلِ بَيتٍ خيرًا أدخل عليهم بابَ الرِّفقِ؛ وإنَّ الرِّفقَ لم يكُنْ في شيءٍ إلَّا زانه، وإنَّ الخُرقَ لم يكُنْ في شيءٍ إلَّا شانه"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"l5YQX3WT"},{"id":"س-00611","fp":"c75d4d7352d7","stateId":493,"easy":"إذا ختلت الدنيا بالدين ولبست للناس جلود الضأن ← يبعث الله عليك فتنة تدع الحليم حيران","cause":"يختلونَ الدُّنيا بالدِّينِ يَلبسونَ للنَّاسِ جلودَ الضَّأنِ منَ اللِّينِ ، ألسنتُهُم أحلَى منَ العسلِ ، وقلوبُهُم قلوبُ الذِّئابِ","result":"لأبعثنَّ علَى أولئِكَ منهُم فتنةً تدعُ الحليمَ حيرانَ","explicit":true,"otherNeedIds":[31],"ref":"الترغيب والترهيب 1/50","srcLabel":"الترمذي","text":["يخرجُ في آخرِ الزَّمانِ رجالٌ ",["يختلونَ الدُّنيا بالدِّينِ يَلبسونَ للنَّاسِ جلودَ الضَّأنِ منَ اللِّينِ ، ألسنتُهُم أحلَى منَ العسلِ ، وقلوبُهُم قلوبُ الذِّئابِ",1]," ، يقولُ اللَّهُ عزَّ وجلَّ : أبي يغترُّونَ ، أم عليَّ يجترِئونَ ؟ فبي حلفتُ ",["لأبعثنَّ علَى أولئِكَ منهُم فتنةً تدعُ الحليمَ حيرانَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (2404)، وابن المبارك في ((الزهد والرقائق)) (50)، وهناد في ((الزهد)) (2/437) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"pP8JNQUb"},{"id":"س-07397","fp":"15e458c8df57","stateId":493,"easy":"إذا دعوت بتعجيل العقوبة في الدنيا ← قد تهلك (فلا تدعُ بها)","cause":"اللَّهُمَّ ما كُنتَ مُعاقِبي به في الآخِرةِ فعَجِّلْه لي في الدُّنيا","result":"قد خَفَتَ فصارَ مِثلَ الفَرخِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[33,28],"ref":"صحيح مسلم 2688","srcLabel":"النسائي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم عادَ رَجُلًا مِنَ المُسلِمينَ ",["قد خَفَتَ فصارَ مِثلَ الفَرخِ",2],"، فقال له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: هل كُنتَ تَدعو بشَيءٍ، أو تَسألُه إيَّاهُ؟ قال: نَعَم، كُنتُ أقولُ: ",["اللَّهُمَّ ما كُنتَ مُعاقِبي به في الآخِرةِ فعَجِّلْه لي في الدُّنيا",1],"، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: سُبحانَ اللهِ! لا تُطيقُه -أو لا تَستَطيعُه- أفلا قُلتَ: اللَّهُمَّ آتِنا في الدُّنيا حَسَنةً، وفي الآخِرةِ حَسَنةً، وقِنا عَذابَ النَّارِ، قال: فدَعا اللهَ له، فشَفاهُ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه عبد بن حميد (1397)، والنسائي في ((السنن الكبرى)) (10825)، وأبو يعلى (3759) جميعهم باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إجابة دعاء النبي","dorar":"4t47yqMQ","merged":3,"otherRefs":["تخريج المسند لشعيب 14067 (صحيح)","علل ابن أبي حاتم 2071 (صحيح)"]},{"id":"س-03166","fp":"ec61cedb8fc9","stateId":493,"easy":"إذا أظهرت الشماتة بأخيك ← يعافيه الله ويبتليك","cause":"لا تُظْهِرِ الشَّماتةَ بأخيكَ","result":"فيُعافيَهُ اللَّهُ ويَبتليَكَ","explicit":true,"repOf":"س-00394","ref":"النقد الصحيح للعلائي 40","text":[["لا تُظْهِرِ الشَّماتةَ بأخيكَ",1],"؛ ",["فيُعافيَهُ اللَّهُ ويَبتليَكَ",2],"."],"grade":"حسن","narrator":"واثلة بن الأسقع الليثي أبو فسيلة","muhaddith":"[حسن غريب]","takhrij":"أخرجه الخرائطي في ((اعتلال القلوب)) (813) واللفظ له، وأخرجه الترمذي (2506)، والطبراني (22/53) (127) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"bLr6o4Lg","merged":2,"otherRefs":["مختصر المقاصد 1184 (حسن)"]},{"id":"س-00509","fp":"30b0447a7b30","stateId":493,"easy":"إذا كان لسانك أحلى من العسل وقلبك أمرّ من الصبر ← يبعث الله عليك فتنة تدع الحليم حيران","cause":"ألسِنَتُهم أحْلى مِن العسَلِ، وقُلوبُهم أمَرُّ مِن الصَّبْرِ","result":"لَأُتِيحَنَّهم فِتنةً تدَعُ الحليمَ منهم حَيرانًا","explicit":true,"otherNeedIds":[31],"ref":"سنن الترمذي 2405","srcLabel":"الطبراني","text":["إنَّ اللهَ تعالى قال: لقد خلَقْتُ خلْقًا ",["ألسِنَتُهم أحْلى مِن العسَلِ، وقُلوبُهم أمَرُّ مِن الصَّبْرِ",1],"، فَبِي حلَفْتُ: ",["لَأُتِيحَنَّهم فِتنةً تدَعُ الحليمَ منهم حَيرانًا",2],"؛ فَبِي يغترُّونَ أمْ عليَّ يجْتَرِئونَ؟!"],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8931)، والديلمي في ((الفردوس)) (4473) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"C1R0AY3s"},{"id":"س-04858","fp":"64d9d0b4cc6b","stateId":493,"easy":"إذا لعنت ناقتك ← قد يُستجاب فيها","cause":"فلعَن رجلٌ ناقةً","result":"أخِّرْها فقد أُجِبْتَ فيها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 8/80","srcLabel":"النسائي","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم في مسيرٍ ",["فلعَن رجلٌ ناقةً",1]," فقال أين صاحبُ النَّاقةِ فقال الرَّجلُ أنا فقال ",["أخِّرْها فقد أُجِبْتَ فيها",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8815)، وأحمد (9522) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"sQHL6AFT"},{"id":"س-04902","fp":"e4d6d7c675c5","stateId":493,"easy":"إذا عيّرت أخاك بذنب ← لا تموت حتى تعمله","cause":"من عيَّرَ أخاهُ بِذَنبٍ","result":"لَمْ يَمُتْ حتَّى يعمَلَه","explicit":true,"ref":"الجامع الصغير 8850","srcLabel":"الترمذي","text":[["من عيَّرَ أخاهُ بِذَنبٍ ",1],["لَمْ يَمُتْ حتَّى يعمَلَه",2]],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن","takhrij":"أخرجه الترمذي (2505)، والطبراني في ((الأوسط)) (7244) واللفظ لهما، والبيهقي في ((الشعب)) (6356) باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mbofCiH0"},{"id":"س-00648","fp":"5f0214d941a4","stateId":493,"easy":"إذا سببت المسلم ← فأنت كالمشرف على الهلكة","cause":"سِبابُ المُسلمِ","result":"كالمُشرِفِ على الهَلَكةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[12],"ref":"تنبيه الغافلين 198","srcLabel":"البزار","text":["«",["سِبابُ المُسلمِ",1]," ",["كالمُشرِفِ على الهَلَكةِ",2],"»"],"grade":"حسن","narrator":"عبد الله بن عمرو","muhaddith":"إسناده جيد.","takhrij":"أخرجه البزار كما في ((كشف الأستار)) (2036) واللفظ له.","bab":"آداب عامة › ضرب الأمثال","dorar":"WLpFWcAp"},{"id":"ق-0071","fp":"e58e0984b704","stateId":494,"easy":"ترك الإنفاق في سبيل الله ← التهلكة","cause":"ترك الإنفاق في سبيل الله","result":"التهلكة","explicit":true,"star":true,"ref":"سورة البقرة: 195","srcLabel":"القرآن الكريم","quran":{"s":2,"from":195,"to":195,"text":"وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ وَأَحْسِنُوا إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ (195)","hl":[[0,81,1]]}},{"id":"ق-0491","fp":"b13bb72e1fb0","stateId":494,"easy":"تقديم محبة الأهل والمال والتجارة على الله ورسوله والجهاد ← التربص بأمر الله والحرمان من الهداية","cause":"تقديم محبة الأهل والمال والتجارة على الله ورسوله والجهاد","result":"التربص بأمر الله والحرمان من الهداية","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة التوبة: 24","srcLabel":"القرآن الكريم","quran":{"s":9,"from":24,"to":24,"text":"قُلْ إِنْ كَانَ آبَاؤُكُمْ وَأَبْنَاؤُكُمْ وَإِخْوَانُكُمْ وَأَزْوَاجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَالٌ اقْتَرَفْتُمُوهَا وَتِجَارَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَاكِنُ تَرْضَوْنَهَا أَحَبَّ إِلَيْكُمْ مِنَ اللَّهِ وَرَسُولِهِ وَجِهَادٍ فِي سَبِيلِهِ فَتَرَبَّصُوا حَتَّى يَأْتِيَ اللَّهُ بِأَمْرِهِ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ (24)","hl":[[5,343,1]]}},{"id":"س-03584","fp":"79f079532e7f","stateId":494,"easy":"إذا رفضت الأكل باليمين كبراً ← قد تُعاقب (من واقعة)","cause":"قال : لا أستطيعُ","result":"لا استطَعْتَ فما رفَعها إلى فيه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح ابن حبان 6513","srcLabel":"مسلم","text":["أنَّ رجُلًا كان يأكُلُ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم بشِمالِه فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم : ( كُلْ بيمينِك ) ",["قال : لا أستطيعُ",1]," فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم : ) ",["لا استطَعْتَ ) فما رفَعها إلى فيه",2]],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم  (2021) بزيادة \"ما منعه إلا الكبر\"  وأحمد (16530) والدارمي (2075) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"M5UkYgfq","merged":3,"otherRefs":["صحيح مسلم 2021 (صحيح)","زاد المعاد 2/369 (صحيح)"]},{"id":"س-05215","fp":"3e7394de95c1","stateId":494,"easy":"إذا وصلت شعرك (اتخذت القُصة) ← فبه هلكت بنو إسرائيل","cause":"اتَّخذَ هذِهِ نساؤُهُم","result":"إنَّما هلَكَت بنو إسرائيلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"غاية المرام 100","srcLabel":"مسلم","text":["قدمَ معاويةُ المدينةَ، آخرَ قَدمةٍ قدمَها، فخطبَنا فأخرجَ كَبَّةً من شَعرٍ قالَ : ما كُنتُ أرى أحدًا يفعلُ هذا غيرَ اليَهودِ إنَّ النبي سمَّاهُ الزُّورَ. يعني الواصِلةَ في الشَّعرِ وفي روايَةٍ أنَّهُ قال لأهلِ المدينَةِ أينَ عُلَماؤُكُم ؟ سَمِعْتُ رسولَ اللَّهِ ينهَى عَن مثلِ هذِهِ، ويقولُ ",["إنَّما هلَكَت بنو إسرائيلَ",2]," حينَ ",["اتَّخذَ هذِهِ نساؤُهُم",1]],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16934)، وابن الجعد في ((مسنده)) (94) كلاهما بلفظه دون قوله: ((في الشعر))، ومسلم (2127) بلفظ مقارب .","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"mFeyM2Uk","merged":3,"otherRefs":["صحيح البخاري 5932 (صحيح)","صحيح النسائي 5260 (صحيح)"]},{"id":"س-07738","fp":"73c3ea5bb2fa","stateId":494,"easy":"إذا قُتل نبي أو خليفة ← قُتل به خلق كثير","cause":"لم يُقتَلْ نبيٌّ فيما مضى","result":"إلَّا قُتِل به سبعونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به ولا قُتِل خليفةٌ قطُّ إلَّا قُتِل به خمسةٌ وثلاثونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به","explicit":true,"otherNeedIds":[12],"ref":"مجمع الزوائد 9/95","srcLabel":"البخاري","text":["أقبَل عبدُ اللهِ بنُ سلامٍ وعثمانُ محصورٌ فانطَلَق فدخَل عليه فوسَّعوا له حتَّى دخَل فقال السَّلامُ عليك يا أميرَ المؤمنينَ فقال وعليك السَّلامُ ما جاء بك يا عبدَ اللهِ بنَ سلامٍ قال قد جِئْتُ لأثبُتَ حتَّى أستشهِدَ أو يفتَحَ اللهُ لك ولا أرى هؤلاءِ القومَ إلَّا قاتِلوك فإن يقتُلوك فذاك خيرٌ لك وشرٌّ لهم فقال عثمانُ أسأَلُك بالَّذي لي عليك من الحقِّ لَمَا خرَجْتَ إليهم خيرًا يسوقُه اللهُ بك وشرًّا يدفَعُه بك اللهُ فسمِع وأطاع فخرَج عليهم فلمَّا رأَوْه اجتَمَعوا وظنُّوا أنَّه قد جاءهم ببعضِ ما يُسَرُّونَ به فقام خطيبًا فحمِد اللهَ وأثنى عليه ثُمَّ قال أمَّا بعدُ فإنَّ اللهَ عزَّ وجلَّ بعَث محمَّدًا صلَّى اللَّهُ عليه وسلَّم بشيرًا ونذيرًا يُبشِّرُ بالجنَّةِ مَن أطاعه ويُنذِرُ بالنَّارِ مَن عصاه وأظهَر مَن اتَّبَعه على الدِّينِ كلِّه ولو كرِه المشركونَ ثُمَّ اختار له المساكنَ فاختار له المدينةَ فجعَلها دارَ الهجرةِ وجعَلها دارَ الإيمانِ فواللهِ ما زالتِ الملائكةُ حافِّينَ بالمدينةِ مذ قدِمها رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم إلى اليومِ وما زال سيفُ اللهِ مغمودًا عنكم مذ قدِمها رسولُ اللهِ صلَّى اللَّهُ عليه وسلَّم إلى اليوم ثُمَّ قال إنَّ اللهَ بعَث محمَّدًا صلَّى اللَّهُ عليه وسلَّم بالحقِّ فمَنِ اهتدى فإنَّما يهتَدي بهدى اللهِ ومَن ضلَّ فإنَّما يضِلُّ بعدِ البيانِ والحجَّةِ وإنَّه ",["لم يُقتَلْ نبيٌّ فيما مضى",1]," ",["إلَّا قُتِل به سبعونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به ولا قُتِل خليفةٌ قطُّ إلَّا قُتِل به خمسةٌ وثلاثونَ ألفَ مقاتلٍ كلُّهم يُقتَلُ به",2]," فلا تعجَلوا على هذا الشَّيخِ بقتلٍ فواللهِ لا يقتُلُه رجلٌ منكم إلَّا لقي اللهَ يومَ القيامةِ ويدُه مقطوعةٌ مشلولةٌ واعلَموا أنَّه ليس لولدٍ على والدٍ حقٌّ إلَّا ولهذا الشَّيخِ عليكم مثلُه قال فقالوا كذَبَتِ اليهودُ كذَبَتِ اليهودُ فقال كذَبْتُم واللهِ وأنتم آثِمون ما أنا بيهوديٍّ وإنِّي لأحدُ المسلمينَ يعلَمُ اللهُ بذلك ورسولُه والمؤمنونَ وقد أنزَل اللهُ في القرآنِ {قُلْ كَفَى بِاللَّهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ وَمَنْ عِنْدَهُ عِلْمُ الْكِتَابِ} وقد أنزَل الآيةَ الأخرى { قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ وَكَفَرْتُمْ بِهِ وَشَهِدَ شَاهِدٌ مِنْ بَنِي إِسْرَائِيلَ عَلَى مِثْلِهِ فَآمَنَ وَاسْتَكْبَرْتُمْ} قال فقاموا فدخَلوا على عثمانَ فذبَحوه كما يُذبَحُ الحُلَّانُ قال شُعَيبٌ فقُلْتُ لعبدِ الملكِ بنِ عُمَيرٍ ما الحُلَّانُ قال الحَمَلُ قال وقد قال عثمانُ لكَثيرِ بنِ الصَّلْتِ يا كَثيرُ أنا واللهِ مقتولٌ غدًا قال بل يُعلِي اللهُ كعبَك ويكبِتُ عدوَّك قال ثُمَّ أعادها الثَّالثةَ فقال مثلَ ذلك قال عمَّ يقولُ يا أميرَ المؤمنينَ قال رأَيْتُ رسولَ اللهِ صلَّى اللَّهُ عليه وسلَّم ومعه أبو بكرٍ وعمرُ فقال لي يا عثمانُ أنت عندَنا غدًا وأنت مقتولٌ غدًا فأنا واللهِ مقتولٌ قال فقُتِل فخرَج عبدُ اللهِ بنِ سلامٍ إلى القومِ قبلَ أن يتفرَّقوا فقال يا أهلَ مصرَ يا قتلةَ عثمانَ قتَلْتُم أميرَ المؤمنينَ أمَا واللهِ لا يزالُ عهدٌ منكوثٌ ودمٌ مسفوحٌ ومالٌ مقسومٌ لا سُقِيتُم"],"grade":"حسن","narrator":"محمد بن يوسف بن عبدالله بن سلام","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (13/ 155) (379) بلفظه، والبخاري في ((التاريخ الكبير)) (1/ 262)، وابن شبة في ((تاريخ المدينة)) (4/ 1227) مختصرا.","bab":"قرآن › أسباب النزول","dorar":"Vu1gdwiq"},{"id":"س-00821","fp":"101b804b4606","stateId":494,"easy":"إذا رفضت السنة كبراً ← قد تُعاقب في الدنيا (من واقعة)","cause":"يَأكُلُ بِشِمالِهِ، فقال: كُلْ بِيَمينِكَ. فقال: لا أستَطيعُ","result":"لا استَطَعتَ. قال: فما وصَلَتْ يَمينُهُ إلى فَمِهِ بَعدُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 16499","srcLabel":"مسلم","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يَقولُ لِرَجُلٍ يُقالُ له: بُسْرُ، ابنُ راعي العيرِ، أبصَرَهُ ",["يَأكُلُ بِشِمالِهِ، فقال: كُلْ بِيَمينِكَ. فقال: لا أستَطيعُ",1],". فقال: ",["لا استَطَعتَ. قال: فما وصَلَتْ يَمينُهُ إلى فَمِهِ بَعدُ",2],". وقال أبو النَّضْرِ في حَديثِهِ: ابنُ راعي العيرِ مِن أشْجَعَ."],"grade":"صحيح","narrator":"سلمة بن الأكوع","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (16499) واللفظ له، وعبد بن حميد (388)، وأبو عوانة في ((المستخرج)) (8249)","bab":"أدعية وأذكار › دعاء النبي على بعض الأشخاص والأشياء والأمور","dorar":"HgTBzdnW","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6512 (صحيح)"]},{"id":"س-05918","fp":"c91ea93a7cc6","stateId":494,"easy":"إذا لم تزوجوا من ترضون دينه وخلقه ← تكن فتنة في الأرض وفساد عريض","cause":"إلَّا تَفْعَلوا","result":"تَكنْ فِتنةٌ في الأرضِ وفسادٌ عَريضٌ","explicit":true,"otherNeedIds":[35],"ref":"المستدرك على الصحيحين 2732","srcLabel":"الترمذي","text":["إذا أَتاكُم مَنْ تَرْضَوْنَ خُلُقَه ودينَه، فأَنكِحوهُ، ",["إلَّا تَفْعَلوا",1],"؛ ",["تَكنْ فِتنةٌ في الأرضِ وفسادٌ عَريضٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن ماجه (1967) بلفظه، والترمذي (1084)، والطبراني في ((المعجم الأوسط)) (2695) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"cjkNUsHm"},{"id":"س-01293","fp":"46d4fd6da1a1","stateId":494,"easy":"إذا قتلت حية البيوت قبل إنذارها ← قد يصيبك ضرر (من واقعة)","cause":"فطَعَنَ الحيَّةَ فمَاتَتْ","result":"وماتَ الرجلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 4-51","srcLabel":"الطبراني","text":["أنَّ رجلًا كان حديثَ عهدٍ بُعُرْسٍ فبعثَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم بعْثًا وبعَثَ فيهم ذلِكَ الرجلَ فلمَّا جاءَ القومُ تعجَّلَ إلى أهلِهِ فإذا هو بامرأَتِهِ قائمَةٍ على بابِها فدخلَتْهُ غَيَرَةٌ فهيَّأَ إِلَيْها الرمْحَ لِيَطْعَنَها فقالَتْ لا تعْجَلْ وانظُرْ ما في البيتِ فدخلَ البيتَ فإِذَا هو بحيَّةٍ مُنطَوِيَةٍ علَى فراشِها ",["فطَعَنَ الحيَّةَ فمَاتَتْ",1]," ",["وماتَ الرجلُ",2]," فبلَغَ ذلكَ النبيَّ صلَّى اللهُ عليه وسلَّم فقال إنَّ لهذِهِ البيوتِ عوامِرَ مِنَ الجِنِّ ونَهَى عنْ قَتْلِهِنَّ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4528) واللفظ له، والطحاوي في ((شرح مشكل الآثار)) (2936) مختصرا.","bab":"نكاح › الغيرة","dorar":"cJE25aO8"},{"id":"س-01725","fp":"70346027ba69","stateId":494,"easy":"إذا تعلقت بالمخلوق دون الله ← تطول محنتك (من قصة يوسف)","cause":"اذكُرْني عندَ ربِّك","result":"ما لبِث","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح ابن حبان 6206","srcLabel":"النسائي","text":["رحِم اللهُ يوسُفَ لولا الكلمةُ الَّتي قالها : ",["اذكُرْني عندَ ربِّك",1]," ",["ما لبِث",2]," في السِّجنِ ما لبِث ورحِم اللهُ لوطًا إنْ كان لَيأوي إلى رُكنٍ شديدٍ إذ قال لقومِه : {لَوْ أَنَّ لِي بِكُمْ قُوَّةً أَوْ آوِي إِلَى رُكْنٍ شَدِيدٍ} [هود: 80]، قال : فما بعَث اللهُ نَبيًّا بعدَه إلَّا في ثَروةٍ مِن قومِه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (8391)، والنسائي في ((السنن الكبرى)) (10984)، وابن أبي حاتم في ((التفسير)) (11634) بنحوه.","bab":"أنبياء › عام","dorar":"kkdiaJjL"},{"id":"س-01737","fp":"d218de8857fa","stateId":494,"easy":"إذا أعجبت بكثرتكم ← تُعاقبون (من قصة)","cause":"أعجَبَته أُمَّتُه","result":"فماتَ في ثَلاثٍ سَبعونَ ألفًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 18933","srcLabel":"أحمد","text":["إنَّ نَبيًّا كان فيمَن كان قَبلَكُم ",["أعجَبَته أُمَّتُه",1],"، فقال: لَن يَرومَ هؤلاء شَيءٌ! فأوحى اللهُ إليه: أن خَيِّرْهم بَينَ إحدى ثَلاثٍ: إمَّا أن أُسَلِّطَ عليهم عَدوًّا مِن غَيرِهم فيَستَبيحَهم، أوِ الجوعَ، أوِ المَوتَ، قال: فقالوا: أمَّا القَتلُ أوِ الجوعُ فلا طاقةَ لَنا به، ولَكِنِ المَوتُ، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: «",["فماتَ في ثَلاثٍ سَبعونَ ألفًا",2],"»، قال: فقال: فأنا أقولُ الآنَ: اللهُمَّ بكَ أُحاوِلُ، وبكَ أصولُ، وبكَ أُقاتِلُ"],"grade":"صحيح","narrator":"صهيب بن سنان","muhaddith":"إسناده صحيح","bab":"أنبياء › عام","dorar":"OyeQOXkP"},{"id":"س-05966","fp":"cff8154fd1fc","stateId":494,"easy":"إذا نظرت إلى فرج زوجتك (على رواية ضعيفة) ← يورث العمى","cause":"يَنظُرْ إلى فرجِها","result":"فإنَّ ذلك يورِثُ العَمى","explicit":true,"ref":"سبل الهدى والرشاد 12/135","srcLabel":"ابن حبان","text":["«إذا جامَعَ أحَدُكُم زَوجَتَه أو جاريَتَه فلا ",["يَنظُرْ إلى فرجِها",1],"؛ ",["فإنَّ ذلك يورِثُ العَمى",2],"»"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده جيد.","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/ 231)، وابن عدي في ((الكامل في الضعفاء)) (2/ 265)، والبيهقي (13671)، وابن عساكر في ((تاريخ دمشق)) (46/ 303)، وابن الجوزي في ((الموضوعات)) (2/ 271) جميعا بلفظه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"0bQeMCym"},{"id":"س-03714","fp":"769663ae84fd","stateId":494,"easy":"إذا أكلت بشمالك ← قد يصيبك سوء (من واقعة)","cause":"تأكُلُ بشِمالِها","result":"فأصابَها طاعونٌ فماتَتْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"فتح الباري لابن حجر 9/433","srcLabel":"البيهقي","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ رأى سُبَيعَةَ الأسْلَميَّةَ ",["تأكُلُ بشِمالِها",1]," فقالَ: أخذَها داءُ غزَّةَ. فقالَ: إنَّ بها قُرحةً. قالَ: وإن. فمرَّت بغَزَّةَ ",["فأصابَها طاعونٌ فماتَتْ",2]],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"إسناده حسن","takhrij":"أخرجه البيهقي في ((دلائل النبوة)) (6/ 239) بنحوه ، والروياني في ((مسنده)) (270) مقتصرا على أوله .","bab":"اعتصام بالسنة › لزوم السنة","dorar":"x9kkLK6P"},{"id":"س-07733","fp":"c557ab372304","stateId":494,"easy":"إذا وعدت ولم تستثنِ «إن شاء الله» ← قد تُحرم حاجتك (من واقعة)","cause":"فقالَ : غدًا أجِيبُكُم ولم يَسْتَثْنِ","result":"فمَكَثَ خمسَ عشرَةَ ليلةً لا يُحْدِثُ اللهُ إليهِ في ذلكَ وحيًا","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[10],"ref":"موافقة الخبر الخبر 2/70","srcLabel":"الترمذي","text":["عن ابنِ عباسٍ رضيَ اللهُ عنهمَا أنَّ مُشْرِكِي قريشٍ بعثوا النَّضْرَ بنَ الحارثِ ، وعقْبَةَ بنَ أبي مُعَيْطٍ إلى أحبَارِ اليهودِ بالمدينةِ فقالوا لهُمْ : سَلُوهُمْ عن أَمْرِهِ وأَخْبِروهم خَبَرَهُ وصِفُوا لهم مَقَالَتَه ، فإنهم أهلُ الكتابِ الأولِّ ، وعندَهُمْ علْمٌ ما ليسَ عندنَا من علمِ الأنبياءِ ، فقَدِمَا المدينةَ فسألا أحبارَ اليهودِ عنهُ ، وأخبرُوهم بمَا يقولُ ، فقالوا لهُم : سَلُوهُ عن ثلاثٍ فإنْ أخْبَرَكُم بهنَّ فهوَ نبيٌّ مرسَلٌ ، وإلا فهوَ رجلٌ مُتَقَوِّلٌ ، سلُوهُ عن فِتْيَةٍ ذهبوا في الدهْرِ الأوَّلِ ما كانَ من أمرِهِم ؟ فإنَّهُم كانَ لهمْ حديثٌ عجِيبٌ ، وسلُوهُ عن رجلٍ طوَّافٍ طافَ مشارِقَ الأرضِ ومغارِبَها ما كان نَبَؤُهُ ؟ وسلُوهُ عن الرُّوحِ ماهُوَ ؟ فانْطَلَقَا فقَدِمَا مكةَ فقالا : يا معشَرَ قريشٍ قدْ جئْنَاكُم بفَصْلِ ما بينكم وبينَ محمدٍ ، أمَرَنَا أحبارُ اليهودِ أنْ نسْأَلَهُ عن ثلاثٍ ، فذكَرَ القصَّةَ ، فجاءوا إلى رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ فسأَلُوهُ عن ذلكَ ",["فقالَ : غدًا أجِيبُكُم ولم يَسْتَثْنِ",1]," ، ",["فمَكَثَ خمسَ عشرَةَ ليلةً لا يُحْدِثُ اللهُ إليهِ في ذلكَ وحيًا",2]," ، ولا يأتِيهِ جبريلُ صلَّى اللهُ عليهِ وسلَّمَ ، حتَّى أحْزَنَ ذلكَ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ، وأَرْجَفَ بهِ أهلُ مكةَ ، فقالُوا : وعَدَنَا أنْ يجيبَنَا غدًا وقدْ مَضَتْ خمسِ عشرةَ ليلةً ، أصبحْنَا منْها اليومَ لا يخبِرُنَا عمَّا سأَلنَاهُ عنهُ ، فنزلَ عليهِ جبريلُ بسورةِ الكهفِ ، فعَاتَبَهُ في أوَّلِهَا على حزْنِهِ عليهمْ ثمَّ أخبَرَهُ بخبَرِ أهلِ الكهفِ ، وأخبَرَهُ عن الرجلِ الطوَّافِ ، ونزلَ قولُهُ تعالى : { وَيَسْأَلُونَكَ عَنِ الرُّوحِ } الآيةَ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"غريب، لولا هذا المبهم لكان سنده حسنا","takhrij":"أخرجه الترمذي (3140)، وأحمد (2309) مختصرا، والبيهقي في ((دلائل النبوة)) (2/ 269) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"SsKsa3Mi"},{"id":"س-01709","fp":"aa3b0875f77c","stateId":494,"easy":"إذا عجزت ← فإن الله يلوم على العجز","cause":"علَى العجزِ","result":"إنَّ اللَّهَ يلومُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"عمدة التفسير 1/441","srcLabel":"عمدة التفسير","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قضَى بينَ رجُلَيْنِ فقالَ المقضيُّ عليهِ لما أدبرَ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ردُّوا عليَّ الرَّجلَ . فقالَ : ما قلتَ ؟ . قالَ : قلتُ : حسبيَ اللَّهُ ونعمَ الوَكيلُ . فقالَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إنَّ اللَّهَ يلومُ",2]," ",["علَى العجزِ",1]," ، ولَكِن عليكَ بالكَيسِ ، فإذا غلبَكَ أمرٌ فقُلْ : حسبيَ اللَّهُ ونعمَ الوَكيلُ"],"grade":"صحيح","narrator":"عوف بن مالك الأشجعي","muhaddith":"إسناده صحيح","bab":"أقضية وأحكام › قضايا حكم فيها النبي صلى الله عليه وسلم","dorar":"crgAnxGW"},{"id":"س-01179","fp":"09401edbf38e","stateId":494,"easy":"إذا ضيّعت التسبيح ← فما صيد صيد ولا قطعت شجرة إلا بتضييعه","cause":"بتَضييعٍ مِنَ التَّسبيحِ","result":"ما صِيدَ صَيدٌ ولا قُطِعَت شَجَرةٌ إلَّا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"فيض القدير 5/ 452","srcLabel":"أبو نعيم","text":[["ما صِيدَ صَيدٌ ولا قُطِعَت شَجَرةٌ إلَّا",2]," ",["بتَضييعٍ مِنَ التَّسبيحِ",1]],"grade":"حسن","narrator":"أبو هريرةَ","muhaddith":"رمز السيوطي لحسنه غير صواب","takhrij":"أخرجه أبو نعيم في ((حلية الأولياء)) (9663)، والديلمي في ((مسند الفردوس)) كما في (الغرائب الملتقطة) لابن حجر (ص: 2333)، باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"6bA1JkKb"},{"id":"س-07007","fp":"98c66f98d75f","stateId":495,"easy":"إذا غلوت في الدين ← فإنما هلك من قبلكم بالغلو","cause":"إيَّاكم والغُلوَّ","result":"فإنَّما هلَكَ مَن كان قَبلَكم بالغُلوِّ في الدِّينِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 3248","srcLabel":"مسلم","text":["قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ غَداةَ العَقَبةِ، وهو واقِفٌ على راحِلَتِه: هاتِ، القُطْ لي. فلقَطتُ له حَصَياتٍ هُنَّ حَصى الخَذفِ، فوضَعَهن في يَدِه، فقال: بأَمثالِ هؤلاء. مَرَّتَيْنِ، وقال بيَدِه -فأَشارَ يَحيى أنَّه رفَعَها- وقال: ",["إيَّاكم والغُلوَّ؛ ",1],["فإنَّما هلَكَ مَن كان قَبلَكم بالغُلوِّ في الدِّينِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس أو الفضل بن عباس","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه النسائي (3057)، وابن ماجه (3029)، وأحمد (3248) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"4bgDhA7B","merged":4,"otherRefs":["الأحاديث المختارة 10 / 32 (صحيح)","المستدرك على الصحيحين 1732 (صحيح)","تخريج المسند لشعيب 1851 (صحيح)"]},{"id":"س-06456","fp":"d634e689cc3c","stateId":495,"easy":"إذا شددت على نفسك ← يُشدّد عليك","cause":"لا تُشَدِّدوا على أنفُسِكم فيُشَدَّدَ عليكم","result":"فإنَّ قَومًا شَدَّدوا على أنفُسِهم فشُدِّد عليهم","explicit":true,"star":true,"ref":"الأحاديث المختارة 2178","srcLabel":"البخاري","text":["«أنَّه دخل هو وأبوه على أنَسِ بنِ مالِكٍ بالمدينةِ زَمانَ عُمَرَ بنِ عَبدِ العزيزِ وهو أميرٌ، وهو يُصَلِّي صلاةً خَفيفةً [دفيفةً] كأنهَّا صلاةُ مُسافِرٍ، أو قريبًا منها، فلمَّا سَلَّم قال: يَرْحمُك اللهُ، أرأيتَ هذه الصَّلاةُ المكتوبةُ أم شَيءٌ تنَفَّلْتَه؟ قال: إنَّها المكتوبةُ، وإنَّها صلاةُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم ما أخطَأْتُ إلَّا شيئًا سَهَوتُ عنه، إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان يَقولُ: ",["لا تُشَدِّدوا على أنفُسِكم فيُشَدَّدَ عليكم؛ ",1],["فإنَّ قَومًا شَدَّدوا على أنفُسِهم فشُدِّد عليهم",2],"، فتلك بقاياهم في الصَّوامِعِ والدِّياراتِ، {وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ}.\nثمَّ غَدَوا مِنَ الغَدِ فقالوا: نركَبُ فنَنظُرُ ونعتَبِرُ، قال: نَعَم، فرَكِبوا جميعًا فإذا هم بديارٍ قَفرٍ قد باد أهْلُها وانقَرَضوا وفَنُوا خاويةً على عُروشِها، قالوا: أتعرِفُ هذه الدِّيارَ؟ قال: ما أعرَفَني بها وبأهْلِها! هؤلاء أهلُ الدِّيارِ، أهلَكَهم البَغْيُ والحَسَدُ، إنَّ الحَسَدَ يُطفِئُ نورَ الحَسَناتِ، والبَغْيَ يُصَدِّقُ ذلك أو يُكَذِّبُه، والعَينُ تَزْني والكَفُّ والقَدَمُ والجسَدُ واللِّسانُ، والفَرْجُ يُصَدِّقُ ذلك أو يُكَذِّبُه»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"ZSzCyCiM"},{"id":"س-04385","fp":"59de5623f1c9","stateId":495,"easy":"إذا صمت الدهر وقمت الليل كله ← تنفه نفسك وتضعف عينك","cause":"تَصومُ الدَّهرَ وتَقومُ اللَّيلَ","result":"نفِهَتْ لَهُ النَّفسُ وَهَجَمَت لَهُ العينُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"نخب الافكار 8/471","srcLabel":"متفق عليه","text":["قالَ لي رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ألَم أنبَّأ أنَّكَ ",["تَصومُ الدَّهرَ وتَقومُ اللَّيلَ",1]," ؟ قالَ: قُلتُ إنِّي أقوَى قالَ إنَّكَ إذا فَعلتُ ",["نفِهَتْ لَهُ النَّفسُ وَهَجَمَت لَهُ العينُ",2]," قالَ: قُلتُ: إنِّي أقوَى قالَ فصُم ثلاثةَ أيَّامٍ مِن كلِّ شَهْرٍ قالَ: قُلتُ: إنِّي أقوَى قالَ فصُم صَومَ أَخي داودَ عليه السَّلامُ كانَ يَصومُ يومًا ويُفطرُ يومًا ولا يَفرُّ إذا لاقَى"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح [وله] طريقان [آخران]","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (3353) واللفظ له، وأخرجه البخاري (1979)، ومسلم (1159) باختلاف يسير دون ذكر \"أخي\"","bab":"جهاد › التولي والفرار من الزحف","dorar":"loO39fRC","merged":2,"otherRefs":["صحيح البخاري 1153 (صحيح)"]},{"id":"س-06762","fp":"d4c1fd92f347","stateId":495,"easy":"إذا أجهدت نفسك فوق طاقتها ← فقد عذّبت نفسك","cause":"ما أَكلْتُ طَعامًا بنَهارٍ مُنْذُ بايَعْتُك","result":"مَن أمَرَك أن تُعذِّبَ نَفْسَك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 9 / 229","srcLabel":"متفق عليه","text":["«أتَيْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقُلْتُ: يا رَسولَ اللهِ أنا الرَّجُلُ الَّذي جِئْتُك عامَ أوَّلَ، قالَ: فما بالي أرى جِسْمَك ناحِلًا، قُلْتُ: يا رَسولَ اللهِ ",["ما أَكلْتُ طَعامًا بنَهارٍ مُنْذُ بايَعْتُك",1],"، فقالَ: ",["مَن أمَرَك أن تُعذِّبَ نَفْسَك",2],"؟ قُلْتُ: يا رَسولَ اللهِ إنِّي أَقْوى، قالَ: صُمْ شَهْرَ الصَّبْرِ ويَوْمَينِ بَعْدَه، قُلْتُ: إنِّي أَقْوى، قالَ: صُمْ شَهْرَ الصَّبْرِ وثَلاثةَ أيَّامٍ بَعْدَه، وصُمْ أَشْهُرَ الحُرُمِ»."],"grade":"صحيح","narrator":"أبو أو عم مجيبة الباهلية","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"صيام › فضل الصيام","dorar":"28PfhL5O","merged":2,"otherRefs":["تخريج المسند لشعيب 20323 (حسن)"]},{"id":"س-02694","fp":"08b63b0d8eed","stateId":495,"easy":"إذا شددت على نفسك ← فإنما هلك من قبلكم بتشديدهم على أنفسهم","cause":"لا تشدِّدوا على أنفسِكم","result":"فإنما هلكَ من قَبلَكم بتشديدِهم على أنفسِهم ، وستجدون بقاياهم في الصوامعِ والدِّياراتِ","explicit":true,"ref":"جلباب المرأة 20","srcLabel":"جلباب المرأة","text":[["لا تشدِّدوا على أنفسِكم ؛ ",1],["فإنما هلكَ من قَبلَكم بتشديدِهم على أنفسِهم ، وستجدون بقاياهم في الصوامعِ والدِّياراتِ ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › الدين يسر","dorar":"D2KiKBAJ"},{"id":"س-06655","fp":"a3b17baba086","stateId":496,"easy":"إذا تخلّف أهل بيت عن الجماعة ← هم النبي ﷺ أن يحرقها عليهم","cause":"تخَلَّفَ أهلوها عن هذه الصَّلاةِ","result":"فأُضرِمُها عليهم بالنِّيرانِ","explicit":true,"star":true,"otherNeedIds":[12,27],"ref":"تخريج المسند لشعيب 10935","srcLabel":"متفق عليه","text":["أخَّرَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ العِشاءِ، حتى تهَوَّرَ اللَّيلُ، فذهَبَ ثُلُثُهُ أو قَرابَتُهُ، ثم خرَجَ إلى المَسجِدِ، فإذا النَّاسُ عِزون، وإذا هم قَليلٌ، قال: فغضِبَ غَضَبًا ما أعلَمُ أنِّي رأيتُه غضِبَ غَضَبًا قَطُّ أشَدَّ منه، ثم قال: لو أنَّ رَجُلًا دعا النَّاسَ إلى عَرْقٍ أو مِرماتَيْنِ؛ أتَوْهُ لذلك، ولم يتخَلَّفوا، وهم يتخَلَّفون عن هذه الصَّلاةِ، لقد همَمتُ أنْ آمُرَ رَجُلًا يُصَلِّي بالنَّاسِ، وأتتَبَّعَ هذه الدُّورَ التي ",["تخَلَّفَ أهلوها عن هذه الصَّلاةِ",1]," ",["فأُضرِمُها عليهم بالنِّيرانِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (644)، ومسلم (651)، وأبو داود (548)، والترمذي (217)، والنسائي (848)، وابن ماجه (791) بنحوه، وأحمد (10935) واللفظ له","bab":"صلاة › مواقيت الصلاة","dorar":"0lEgv25O","merged":20,"otherRefs":["تخريج المسند لشعيب 10803 (صحيح)","صحيح مسلم 651 (صحيح)","تخريج المسند لشعيب 8890 (صحيح)","صحيح ابن خزيمة 3/ 16 (صحيح)","صحيح الترمذي 217 (صحيح)","تخريج المسند لشعيب 10217 (صحيح)","تخريج مشكل الآثار 5874 (حسن)","صحيح البخاري 644 (صحيح)","مجمع الزوائد 2/46 (صحيح)","الأحاديث المختارة 1310 (صحيح)","صحيح أبي داود 549 (صحيح)","المحلى 4/250 (صحيح)","تخريج المسند لشعيب 7328 (صحيح)","المستدرك على الصحيحين 822 (صحيح)","تخريج المسند لشعيب 8903 (صحيح)","تخريج صحيح ابن حبان 2097 (صحيح)","تخريج المسند لشعيب 3743 (صحيح)","الفتح الرباني 7/3324 (صحيح)","الصحيح المسند 887 (صحيح)"]},{"id":"س-04812","fp":"0f8c3ba27cca","stateId":496,"easy":"إذا رفعت رأسك قبل الإمام ← أما تخشى أن يجعل الله رأسك رأس حمار","cause":"إذا رَفَعَ رَأسَه قَبلَ الإمامِ","result":"أن يَجعَلَ اللهُ رَأسَه رَأسَ حِمارٍ؟! أو يَجعَلَ اللهُ صورَتَه صورةَ حِمارٍ","explicit":true,"star":true,"ref":"صحيح البخاري 691","srcLabel":"مسلم","text":["أما يَخشى أحَدُكُم -أو: لا يَخشى أحَدُكُم- ",["إذا رَفَعَ رَأسَه قَبلَ الإمامِ",1]," ",["أن يَجعَلَ اللهُ رَأسَه رَأسَ حِمارٍ؟! أو يَجعَلَ اللهُ صورَتَه صورةَ حِمارٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (427) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Sz583dCX","merged":6,"otherRefs":["صحيح مسلم 427 (صحيح)","الزواجر عن اقتراف الكبائر 1/146 (حسن)","تخريج المسند لشعيب 7535 (صحيح)","التمهيد 24/365 (صحيح)","صحيح أبي داود 623 (صحيح)"]},{"id":"س-06695","fp":"b73f90057da1","stateId":496,"easy":"إذا صليت وأنت ناعس ← قد تذهب تستغفر فتسب نفسك","cause":"إذا وجَدَ أحَدُكُم النَّومَ وهو يُصلِّي","result":"عسى أنْ يَذهَبَ يَستَغْفِرُ اللهَ فيَسُبَّ نَفْسَه","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 26231","srcLabel":"مسلم","text":[["إذا وجَدَ أحَدُكُم النَّومَ وهو يُصلِّي",1]," فليَرْقُدْ حتى يَذهَبَ نَومُه، إنَّ أحَدَكُم ",["عسى أنْ يَذهَبَ يَستَغْفِرُ اللهَ فيَسُبَّ نَفْسَه",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (26231) واللفظ له، والدارمي (1383)، والطحاوي في ((شرح مشكل الآثار)) (3436)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"F4sfbdr2"},{"id":"س-03593","fp":"042faeb3380b","stateId":496,"easy":"إذا رفعت بصرك إلى السماء في صلاتك ← يوشك أن يُخطف بصرك","cause":"يرفعونَ أبصارَهُم إلى السَّماءِ في صلاتِهِم","result":"لينتَهُنَّ عن ذلِكَ أو لتُخطَفنَّ أبصارُهُم","explicit":true,"similar":["س-06691","س-03069"],"ref":"صحيح ابن خزيمة 1/ 535","srcLabel":"ابن خزيمة","text":["ما بالُ أقوامٍ ",["يرفعونَ أبصارَهُم إلى السَّماءِ في صلاتِهِم",1],"، فاشتدَّ قولُهُ في ذلِكَ حتَّى قالَ: ",["لينتَهُنَّ عن ذلِكَ أو لتُخطَفنَّ أبصارُهُم",2]," [وفي روايةٍ] بمثلِهِ سواءً غيرَ أنَّهُ قال: فاشتَدَّ قولُ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ في ذلِكَ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"1a3s75rx","merged":8,"otherRefs":["صحيح الترغيب 551 (صحيح)","درء تعارض العقل والنقل 7/24 (صحيح)","تخريج المسند لشعيب 8802 (صحيح)","صحيح ابن ماجه 863 (صحيح)","صحيح الجامع 5479 (صحيح)","أصل صفة الصلاة 1/234 (صحيح)","مجمع الزوائد 10/170 (صحيح)"]},{"id":"س-06429","fp":"9584e1590cf7","stateId":496,"easy":"إذا حضرت الصلاة بغير طهور ← تلبّس على الناس صلاتهم","cause":"يَحْضُرونَ معَنا الصَّلاةَ بغَيْرِ طُهورٍ","result":"أولئك الَّذين يَلبِسونَ علينا صَلاتَنا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأحاديث المختارة 1497","srcLabel":"البخاري","text":["«صلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الفَجْرَ فقَرَأَ فيهما بالرُّومِ، فالْتَبَسَ عليه في القِراءةِ، فلمَّا صلَّى قالَ: ما بالُ رِجالٍ ",["يَحْضُرونَ معَنا الصَّلاةَ بغَيْرِ طُهورٍ",1],"، ",["أولئك الَّذين يَلبِسونَ علينا صَلاتَنا",2],"، مَن شَهِدَ معَنا الصَّلاةَ فلْيُحسِنِ الطُّهورَ»."],"grade":"صحيح","narrator":"رجل من أصحاب النبي صلى الله عليه وسلم","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"صلاة › الوضوء والتطهر للصلاة","dorar":"CouhXOF1"},{"id":"س-06691","fp":"66bd867f8004","stateId":496,"easy":"إذا رفعت بصرك إلى السماء في الصلاة ← تخشى أن يُخطف","cause":"تَرْفَعُوا أَبْصارَكُمْ إلى السَّماءِ","result":"مَخَافَةَ أنْ تَلْتَمِعَ","explicit":true,"repOf":"س-03593","ref":"صحيح الموارد 399","text":["لا ",["تَرْفَعُوا أَبْصارَكُمْ إلى السَّماءِ",1]," ؛ ",["مَخَافَةَ أنْ تَلْتَمِعَ",2]," ، يعني : في الصلاةِ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1043)، وابن حبان كما في ((موارد الظمآن)) للهيثمي (477) واللفظ له، والطبراني (12/287) (13139)","bab":"صلاة الجماعة والإمامة › الخشوع في الصلاة","dorar":"IstSIzal","merged":3,"otherRefs":["الصحيح المسند 1472 (صحيح)","تخريج المسند لشعيب 20876 (صحيح)"]},{"id":"س-01388","fp":"2fe307519373","stateId":496,"easy":"إذا لم تحسن الوضوء ← يلبّس على الإمام قراءته","cause":"يُصَلُّون معنا لا يُحسِنون الوضوءَ","result":"إنَّه يُلَبَّسُ علينا القرآنَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 8/503","srcLabel":"أحمد","text":["«صلَّى بنا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم صلاةً، فقرأ فيها سورةَ الرُّومِ فتردَّد في آيةٍ، فلمَّا انصَرَف قال: «",["إنَّه يُلَبَّسُ علينا القرآنَ",2],"، إنَّ أقوامًا منكم ",["يُصَلُّون معنا لا يُحسِنون الوضوءَ",1],"، فمن شَهِد الصَّلاةَ معنا فليُحسِنِ الوُضوءَ»"],"grade":"صحيح","narrator":"أبو روح الكلاعي","muhaddith":"[رجاله] رجال الصحيح","takhrij":"أخرجه أحمد (15874)، وابن قانع في ((معجم الصحابة)) (1/ 346) بنحوه.","bab":"وضوء › إسباغ الوضوء","dorar":"o4oO1LJb","merged":3,"otherRefs":["الأحكام الوسطى 1/ 385 (صحيح)","تخريج زاد المعاد 1/202 (حسن)"]},{"id":"س-05031","fp":"d1d949f196a6","stateId":496,"easy":"إذا نشدت الضالة في المسجد ← لا وجدتها","cause":"مَن دَعا إلى الجَمَلِ الأحمَرِ","result":"لا وجَدتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 569","srcLabel":"ابن ماجه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم لَمَّا صَلَّى قامَ رَجُلٌ فقال: ",["مَن دَعا إلى الجَمَلِ الأحمَرِ",1],"؟ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["لا وجَدتَ",2],"، إنَّما بُنيَتِ المَساجِدُ لِما بُنيَت له."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه ابن ماجه (765)، وأحمد (23044)، وابن حبان (1652) واللفظ لهم جميعا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Gi2BtrCi"},{"id":"س-05053","fp":"8cbf1af8987a","stateId":496,"easy":"إذا تركت الجمعة بلا عذر ← لا جمع الله شملك ولا بارك لك في أمرك","cause":"من ترَكَها من غيرِ عذرٍ معَ إمامٍ عادلٍ أو إمامٍ جائرٍ","result":"فلا جمعَ اللَّهُ لَه شملَه ولا بورِك لَه في أمرِه ألا ولا صلاةَ لَه ألا ولا حجَّ لَه ألا ولا برَّ لَه ألا ولا صدقةَ لَه","explicit":true,"otherNeedIds":[45],"ref":"مجمع الزوائد 2/172","srcLabel":"الطبراني","text":["خطَبَنا النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ ذاتَ يومٍ فقالَ إنَّ اللَّهَ كتبَ عليكمُ الجمعةَ في مقامي هذا في ساعتي هذِه في شَهري هذا في عامي هذا إلى يومِ القيامةِ ",["من ترَكَها من غيرِ عذرٍ معَ إمامٍ عادلٍ أو إمامٍ جائرٍ",1]," ",["فلا جمعَ اللَّهُ لَه شملَه ولا بورِك لَه في أمرِه ألا ولا صلاةَ لَه ألا ولا حجَّ لَه ألا ولا برَّ لَه ألا ولا صدقةَ لَه",2]],"grade":"حسن","narrator":"أبو سعيد الخدري","muhaddith":"فيه موسى بن عطية الباهلي ولم أجد من ترجمه وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7246)","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"4Aq9K7g5"},{"id":"س-03069","fp":"8e65818fc160","stateId":496,"easy":"إذا رفعت بصرك إلى السماء في الصلاة ← قد يُخطف بصرك","cause":"رفعِ أبصارِهم عِندَ الدعاءِ إلى السماءِ","result":"حتى لتُخطفَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03593","ref":"المحلى 4/16","text":["ليَنتهينَّ أناسٌ عن ",["رفعِ أبصارِهم عِندَ الدعاءِ إلى السماءِ",1]," ",["حتى لتُخطفَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه مسلم (429) باختلاف يسير","bab":"إيمان › الوعيد","dorar":"IsEpd4hV"},{"id":"س-01383","fp":"a20e11e1e113","stateId":496,"easy":"إذا لم تنظّف أظفارك ← يُوهم الإمام في صلاته","cause":"ورُفْغُ أحدِكم بين ظفرِهِ وأنملتِهِ","result":"ما لي لا أوهَمُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-01469"],"ref":"فتح الباري لابن حجر 10/357","srcLabel":"الطبراني","text":["صلَّى النبيُّ صلَّى اللهُ عليْهِ وسلَّمَ فأوْهمَ فيها ، فسُئِلَ فقال : ",["ما لي لا أوهَمُ",2]," ",["ورُفْغُ أحدِكم بين ظفرِهِ وأنملتِهِ",1]],"grade":"حسن","narrator":"قيس بن أبي حازم","muhaddith":"رجاله ثقات مع إرساله ، وقد وصله الطبراني من وجه آخر","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/ 221)، والبيهقي في ((شعب الإيمان)) (2511) كلاهما بلفظ مقارب.","bab":"وضوء › إسباغ الوضوء","dorar":"mB0PH1cY"},{"id":"س-01469","fp":"778c5eb0e0f6","stateId":496,"easy":"إذا لم تتنظف ← يُوهم الإمام في صلاته","cause":"فذَكَرَ الرَّفْغَ، ومعنى قَولِه: إنَّكم لستُم بمُتنَظِّفينَ","result":"فأوهَمَ فيها، فقال: وما يَمنَعُني","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01383","ref":"تخريج المسند لشعيب 23125","text":["عن رَجُلٍ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه صلَّى الصُّبحَ، فقَرَأَ فيها بالرُّومِ ",["فأوهَمَ فيها، فقال: وما يَمنَعُني",2],". قال شُعْبةُ: ",["فذَكَرَ الرَّفْغَ، ومعنى قَولِه: إنَّكم لستُم بمُتنَظِّفينَ",1],"."],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"إسناده حسن.","takhrij":"أخرجه أحمد (23125)، والضياء في ((الأحاديث المختارة)) (1498)","bab":"وضوء › فضل الوضوء","dorar":"t41Ex6I6"},{"id":"س-05768","fp":"8f3225c28ac1","stateId":497,"easy":"إذا أُعطيت الإمارة عن مسألة ← وُكلت إليها","cause":"أُعطيتَها عن مَسألةٍ","result":"وُكِلتَ إليها","explicit":true,"star":true,"ref":"صحيح البخاري 7147","srcLabel":"مسلم","text":["قال لي رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا عَبدَ الرَّحمَنِ بنَ سَمُرةَ، لا تَسألِ الإمارةَ، فإن ",["أُعطيتَها عن مَسألةٍ",1]," ",["وُكِلتَ إليها",2],"، وإن أُعطيتَها عن غيرِ مَسألةٍ أُعِنتَ عليها، وإذا حَلَفتَ على يَمينٍ فرَأيتَ غَيرَها خَيرًا منها، فأْتِ الذي هو خَيرٌ، وكَفِّرْ عن يَمينِكَ."],"grade":"صحيح","narrator":"عبدالرحمن بن سمرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1652) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"2HzJm5NS","merged":2,"otherRefs":["صحيح مسلم 1652 (صحيح)"]},{"id":"س-00413","fp":"89d3c597a759","stateId":497,"easy":"إذا لزمت أبواب السلطان ← افتُتنت","cause":"ومن أتى السلطانَ","result":"افتُتِنَ","explicit":true,"ref":"التمهيد 18/144","srcLabel":"الترمذي","text":["مَنْ لزِمَ الباديةَ جفا [يعني حديث: من سكنَ الباديةَ جفَا، ومنِ اتَّبع الصيدَ غفِلَ، ",["ومن أتى السلطانَ",1]," ",["افتُتِنَ",2],".]"],"grade":"صحيح","narrator":"[عبدالله بن عباس]","muhaddith":"صحيح","takhrij":"أخرجه أبو داوود (2859)، وأحمد (3362)بلفظه، والترمذي (2256)باختلاف يسير.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"7jRjv7NN","merged":2,"otherRefs":["صحيح الجامع 6296 (صحيح)"]},{"id":"س-06773","fp":"44392371e60e","stateId":497,"easy":"إذا تداويت بحرام ← فالله لم يجعل شفاءكم فيما حرّم عليكم","cause":"في حرامٍ","result":"إنَّ اللهَ لم يجعَلْ شفاءَكم","explicit":true,"ref":"صحيح ابن حبان 1391","srcLabel":"ابن حبان","text":["قالت أمُّ سَلمةَ: اشتكتِ ابنةٌ لي فنبَذْتُ لها في كوزٍ فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم وهو يغلي فقال: ( ما هذا ) ؟ فقالت: إنَّ ابنتي اشتكتْ فنبَذْنا لها هذا فقال صلَّى اللهُ عليه وسلَّم: ( ",["إنَّ اللهَ لم يجعَلْ شفاءَكم",2]," ",["في حرامٍ",1]," )"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"أخرجه في صحيحه","bab":"طهارة › النبيذ","dorar":"W94yIC7Q","merged":2,"otherRefs":["إرشاد الساري 8/328 (صحيح)"]},{"id":"س-01668","fp":"290211973ed1","stateId":497,"easy":"إذا توليت القضاء ← فقد ذُبحت بغير سكين","cause":"من تولَّى القضاءَ","result":"فقد ذُبِحَ بغيرِ سكينٍ","explicit":true,"similar":["س-01675"],"ref":"مجموع فتاوى ابن باز 209/23","srcLabel":"مجموع فتاوى ابن باز","text":[["من تولَّى القضاءَ",1]," ",["فقد ذُبِحَ بغيرِ سكينٍ",2]],"grade":"حسن","muhaddith":"لا بأس به جيد ومعروف","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"tYytKcxy"},{"id":"س-01675","fp":"969c26c792ed","stateId":497,"easy":"إذا وُلّيت القضاء ← فقد ذُبحت بغير سكين","cause":"مَنْ وُلِّيَ للقضاءِ","result":"فقد ذُبحَ بغيرِ سِكِّينٍ","explicit":true,"repOf":"س-01668","ref":"البدر المنير 9/547","text":[["مَنْ وُلِّيَ للقضاءِ",1]," ",["فقد ذُبحَ بغيرِ سِكِّينٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه أبو داود (3571) واللفظ له، والترمذي (1325) مطولاً","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"LcP3nqIB"},{"id":"س-08408","fp":"166133e212f0","stateId":498,"easy":"إذا دخلت مساكن الظالمين فادخلها باكياً ← حذراً أن يصيبك مثل ما أصابهم","cause":"لا تَدخُلوا مَساكِنَ الذينَ ظَلَموا أنفُسَهُم، إلَّا أن تَكونوا باكينَ","result":"حَذَرًا أن يُصيبَكُم مِثلُ ما أصابَهُم","explicit":true,"star":true,"ref":"صحيح مسلم 2980","srcLabel":"البخاري","text":["مَرَرنا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم على الحِجرِ، فقال لَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا تَدخُلوا مَساكِنَ الذينَ ظَلَموا أنفُسَهُم، إلَّا أن تَكونوا باكينَ",1],"؛ ",["حَذَرًا أن يُصيبَكُم مِثلُ ما أصابَهُم",2],"، ثُمَّ زَجَرَ فأسرَعَ حتَّى خَلَّفَها."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3380، 3381) مفرقاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"az5WHIeY","merged":5,"otherRefs":["صحيح البخاري 4419 (صحيح)","صحيح البخاري 3380 (صحيح)","تخريج المسند لشعيب 5645 (صحيح)","حلية الأولياء 5/124 (صحيح)"]},{"id":"س-07399","fp":"048e0bc88b34","stateId":498,"easy":"إذا كنت في قوم نزل بهم الخسف ← تُبعث على نيتك","cause":"وفيهم أسواقُهم ومَن ليس منهم","result":"ثُمَّ يُبعَثونَ على نيَّاتِهم","explicit":true,"star":true,"otherNeedIds":[44],"ref":"صحيح البخاري 2118","srcLabel":"متفق عليه","text":["يَغزو جَيشٌ الكَعبةَ، فإذا كانوا ببَيداءَ مِنَ الأرضِ يُخسَفُ بأوَّلِهم وآخِرِهم. قالت: قُلتُ: يا رَسولَ اللهِ، كيفَ يُخسَفُ بأوَّلِهم وآخِرِهم ",["وفيهم أسواقُهم ومَن ليس منهم",1],"؟ قال: يُخسَفُ بأوَّلِهم وآخِرِهم، ",["ثُمَّ يُبعَثونَ على نيَّاتِهم",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2118)، ومسلم (2884)","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"a5YVgrjE","merged":4,"otherRefs":["تخريج صحيح ابن حبان 7314 (صحيح)","تخريج صحيح ابن حبان 6755 (صحيح)","فيض القدير 2/ 202 (صحيح)"]},{"id":"س-07478","fp":"b29c32806be0","stateId":498,"easy":"إذا خرجت مكرهاً مع قوم أُهلكوا ← تُبعث على نيتك يوم القيامة","cause":"كيْف بمَن يَخرُجُ كارهًا","result":"ولكنَّه يُبعَثُ على نيَّتِه يَومَ القيامةِ","explicit":true,"otherNeedIds":[44,53,17],"ref":"المستدرك على الصحيحين 8541","srcLabel":"مسلم","text":["عن عُبيدِ اللهِ بنِ القِبْطيَّةِ، قال: دخَلَ الحارثُ بنُ أبي رَبيعةَ وعبدُ اللهِ بنُ صَفْوانَ وأنا معهما على أُمِّ سَلَمةَ رَضيَ اللهُ عنها، فسَألاها عن الجيشِ الَّذي يُخسَفُ به، وكان ذلكَ في أيَّامِ ابنِ الزُّبيرِ، فقالت أُمُّ سَلَمةَ رَضيَ اللهُ عنها: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: يَعوُذُ عائذٌ بالحرمِ، فيُبعَثُ إليه بجيشٍ، فإذا كانوا ببَيْداءَ مِنَ الأرضِ يُخسَفُ بهم، فقُلتُ: يا رَسولَ اللهِ، ",["كيْف بمَن يَخرُجُ كارهًا",1],"؟ قال: يُخسَفُ به معهم، ",["ولكنَّه يُبعَثُ على نيَّتِه يَومَ القيامةِ",2],"، ثمَّ قالت: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يَعوُذُ عائذٌ بالبيتِ."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"صحيح الإسناد على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه مسلم (2882)، وأحمد (26487) كلاهما باختلاف يسير، وأبو داوود (4289) بعضه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"mdVAel0R","merged":4,"otherRefs":["تخريج صحيح ابن حبان 6756 (صحيح)","صحيح الجامع 7465 (صحيح)","صحيح أبي داود 4289 (صحيح)"]},{"id":"س-06188","fp":"cd4ef97c0f98","stateId":498,"easy":"إذا ظهر التلاعن ولبس الحرير واتخاذ القينات وشرب الخمر واكتفى الرجال بالرجال ← فعليهم الدمار","cause":"إذا استعملَتْ أمَّتي خمسًا","result":"فعليهم الدَّمارُ : إذا ظهر فيهم التَّلاعُنُ ، ولُبسُ الحريرِ ، واتَّخذوا القَيْناتِ ، وشرِبوا الخمورَ ، واكتفَى الرِّجالُ بالرِّجالِ والنِّساءُ بالنِّساءِ","explicit":true,"ref":"شعب الإيمان 4/1912","srcLabel":"الطبراني","text":[["إذا استعملَتْ أمَّتي خمسًا ",1],["فعليهم الدَّمارُ : إذا ظهر فيهم التَّلاعُنُ ، ولُبسُ الحريرِ ، واتَّخذوا القَيْناتِ ، وشرِبوا الخمورَ ، واكتفَى الرِّجالُ بالرِّجالِ والنِّساءُ بالنِّساءِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي وإذا ضم إلى غيره أخذ قوة","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (519)، وأبو نعيم في ((حلية الأولياء)) (6/123)، والبيهقي في ((شعب الإيمان)) (5467) واللفظ له","bab":"زينة اللباس › إباحة الذهب والحرير للنساء دون الرجال","dorar":"hhdtmjxp"},{"id":"س-08054","fp":"9d97c7ea71af","stateId":498,"easy":"إذا كان أحد يُقتل ظلماً فلا تحضر مكانه ← لئلا تنزل السخطة فتصيبك","cause":"فلا تحضُروا مكانَه","result":"فلعَلَّه يُقتَلُ ظُلمًا فتَنزِلُ السُّخطةُ فتُصيبُكم","explicit":true,"otherNeedIds":[27],"ref":"فيض القدير 636","srcLabel":"فيض القدير","text":["إذا رأيتُم الرَّجُلَ يُقتَلُ صَبرًا ",["فلا تحضُروا مكانَه",1]," ",["فلعَلَّه يُقتَلُ ظُلمًا فتَنزِلُ السُّخطةُ فتُصيبُكم",2],"."],"grade":"حسن","narrator":"خرشة بن الحارث","muhaddith":"حسن.","bab":"مظالم › تحريم الظلم","dorar":"mwBZK1EO"},{"id":"س-07295","fp":"2ec9bf1a162b","stateId":498,"easy":"إذا تعرضت للفتن ← تنسفك (أثر حذيفة)","cause":"شَخِصَ منها أحدٌ","result":"إلَّا نَسَفَتْه كما يَنسِفُ السَّيلُ الدَّمِنَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8605","srcLabel":"معمر","text":["عن حُذَيفةَ، قال: إيَّاكَ والفِتَنَ، لا يَشخَصْ لها أحدٌ، فواللهِ ما ",["شَخِصَ منها أحدٌ",1]," ",["إلَّا نَسَفَتْه كما يَنسِفُ السَّيلُ الدَّمِنَ",2],"، إنَّها مُشْبِهةٌ مُقْبِلةٌ، حتَّى يَقولَ الجاهلُ: هذه تُشبِهُ مُقْبِلةٌ، وتَتبيَّنُ مُدْبِرةً، فإذا رأيْتُموها، فاحْتُموا في بُيوتِكم، واكْسِروا سُيوفَكم، وقَطِّعوا أوْتارَكم، وغَطُّوا وُجوهَكم."],"grade":"صحيح","narrator":"عمارة بن عبد","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه معمر بن راشد في ((الجامع)) (20740)، وعبد الرزاق (21817)، ونعيم بن حماد في ((الفتن)) (343) جميعا باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"Nmx8Hwsn"},{"id":"س-03646","fp":"79100f145f66","stateId":499,"easy":"إذا اكتويت ← فما أفلحت ولا أنجحت (أثر عمران)","cause":"حتى اكتَويتُ","result":"فما أفلحتُ ولا أنجحتُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"الاستذكار 7/422","srcLabel":"مسلم","text":["سمعت النبيَّ صلَّى اللهُ عليهِ وسلمَ  يَنهَى عن الكيِّ ، قال : فما زال البلاءُ بي ",["حتى اكتَويتُ",1]," ، ",["فما أفلحتُ ولا أنجحتُ ،",2]," قال عمرانُ : وكان يُسلِّمُ علَيَّ ، فلما اكتويتُ ، فقدتُ ذلكَ ثم راجعَه بعدَ ذلكَ السلامَ"],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3865)، والترمذي (2049)، وابن ماجه (3490) باختلاف يسير دون قوله عمران. وقول عمران أخرجه مسلم (1226) بلفظ مقارب","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"WVvYefMV","merged":8,"otherRefs":["صحيح ابن ماجه 2828 (صحيح)","المجموع للنووي 9/63 (صحيح)","الصحيح المسند 1022 (صحيح)","تخريج المسند لشعيب 19989 (صحيح)","تخريج المسند لشعيب 20004 (صحيح)","تخريج سنن أبي داود 3865 (صحيح)","تخريج زاد المعاد 4/59 (صحيح)"]},{"id":"س-03614","fp":"5af62df6c512","stateId":499,"easy":"إذا أرضعت وأنت حامل (الغيل) ← يضر الولد حتى يُسقطه عن فرسه كبيراً","cause":"لا تقتُلوا أولادَكُم سرًّا","result":"فإنَّ قتلَ الغَيلِ يدرِكُ الفارسَ فيُدَعْثرُهُ عن ظَهْرِ فرسِهِ","explicit":true,"star":true,"ref":"نخب الافكار 10/465","srcLabel":"أبو داود","text":[["لا تقتُلوا أولادَكُم سرًّا ",1],["فإنَّ قتلَ الغَيلِ يدرِكُ الفارسَ فيُدَعْثرُهُ عن ظَهْرِ فرسِهِ",2]],"grade":"صحيح","narrator":"أسماء بنت يزيد أم سلمة الأنصارية","muhaddith":"طريقه صحيح","takhrij":"أخرجه أبو داود (3881) واللفظ له، وابن ماجه (2012)، وأحمد (27590) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"7hhavOl5","merged":2,"otherRefs":["صحيح الجامع 7391 (حسن)"]},{"id":"س-01674","fp":"258c902b56de","stateId":499,"easy":"إذا وليت القضاء ← فقد ذُبحت بغير سكين","cause":"من ولِيَ القَضَاءَ أو جُعِلَ قاضيًا بين النَّاسِ","result":"فقدْ ذُبِحَ بغيرِ سِكِّينٍ","explicit":true,"ref":"صحيح الترغيب 2171","srcLabel":"أبو داود","text":[["من ولِيَ القَضَاءَ أو جُعِلَ قاضيًا بين النَّاسِ ؛ ",1],["فقدْ ذُبِحَ بغيرِ سِكِّينٍ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (3571) مختصراً، والترمذي (1325) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"p1T3mOjf"},{"id":"س-05319","fp":"05951187be2c","stateId":499,"easy":"إذا علّقت تميمة ← فلا أتم الله لك","cause":"من تعلَّقَ تميمةً","result":"فلا أتمَّ اللهُ له","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 1/341","srcLabel":"أحمد","text":[["من تعلَّقَ تميمةً ",1],["فلا أتمَّ اللهُ له ",2],"ومن تعلقَ ودعةً فلا ودعَ اللهُ له وفي روايةٍ عنه أنه قال: من تعلَّقَ تميمةً فقد أشرك."],"grade":"صحيح","narrator":"[عقبة بن عامر ]","muhaddith":"ثابت","takhrij":"أخرجه أحمد (17404)، وأبو يعلى (1759)، والطبراني في ((مسند الشاميين)) (234)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ySo0C7r5"},{"id":"س-05320","fp":"8fd65e44ca31","stateId":499,"easy":"إذا علّقت ودعة ← فلا ودع الله لك","cause":"ومن تعلقَ ودعةً","result":"فلا ودعَ اللهُ له","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 1/341","srcLabel":"أحمد","text":["من تعلَّقَ تميمةً فلا أتمَّ اللهُ له ",["ومن تعلقَ ودعةً ",1],["فلا ودعَ اللهُ له",2]," وفي روايةٍ عنه أنه قال: من تعلَّقَ تميمةً فقد أشرك."],"grade":"صحيح","narrator":"[عقبة بن عامر ]","muhaddith":"ثابت","takhrij":"أخرجه أحمد (17404)، وأبو يعلى (1759)، والطبراني في ((مسند الشاميين)) (234)","bab":"رقائق وزهد › التوكل واليقين","dorar":"ySo0C7r5"},{"id":"س-05370","fp":"04716012f056","stateId":499,"easy":"إذا تطيرت ← فالطيرة على من تطير","cause":"مَن تطيَّر","result":"والطِّيَرةُ على","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح ابن حبان 6123","srcLabel":"متفق عليه","text":["لا طِيَرةَ ",["والطِّيَرةُ على",2]," ",["مَن تطيَّر",1]," وإنْ تَكُ في شيءٍ ففي الدَّارِ والفرَسِ والمرأةِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2323) واللفظ له، والبخاري (5756)، ومسلم (2224) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"ltiDNP07"},{"id":"س-05123","fp":"0e08ccf0b183","stateId":500,"easy":"إذا شربت قائماً ← فلو علمت ما في جوفك لاستقأت","cause":"يَشرَبُ قائمًا","result":"ما في جَوفِه لاستَقاءَ","explicit":true,"star":true,"otherNeedIds":[12,33],"ref":"تخريج مشكل الآثار 2100","srcLabel":"مسلم","text":["لو يَعلَمُ الذي ",["يَشرَبُ قائمًا",1]," ",["ما في جَوفِه لاستَقاءَ",2],"، فبَلَغَ ذلك عليَّ بنَ أبي طالبٍ رضِيَ اللهُ عنه، فقام فشَرِبَ قائمًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2100) واللفظ له، ومسلم (2026) بمعناه، وأحمد (7808) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"gev9mY8F","merged":2,"otherRefs":["تخريج المسند لشعيب 7808 (صحيح)"]},{"id":"س-00593","fp":"64868885da4c","stateId":500,"easy":"إذا جُعلت قاضياً ← فكأنما ذُبحت بغير سكين","cause":"مَن جُعِلَ قاضِيًا","result":"فكأنَّما ذُبِحَ بغيرِ سِكِّينٍ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 7213","srcLabel":"أبو داود","text":[["مَن جُعِلَ قاضِيًا",1]," ",["فكأنَّما ذُبِحَ بغيرِ سِكِّينٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (3571)، وابن ماجة (2308)، وأحمد (7145) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"OPcCSTJx","merged":2,"otherRefs":["حاشية الإلمام لابن عبد الهادي 638 (حسن)"]},{"id":"س-05773","fp":"3867bb835c42","stateId":500,"easy":"إذا بتّ وفي يدك ريح الطعام (غمر) فأصابك شيء ← فلا تلومن إلا نفسك","cause":"يبيتُ و في يدِه رِيحُ غِمرٍ","result":"لا يلومنَّ امرؤٌ إلا نفسَه","explicit":true,"similar":["س-05903"],"otherNeedIds":[32],"ref":"صحيح الجامع 2658","srcLabel":"ابن ماجة","text":["ألا ",["لا يلومنَّ امرؤٌ إلا نفسَه",2]," ؛ ",["يبيتُ و في يدِه رِيحُ غِمرٍ",1]],"grade":"صحيح","narrator":"فاطمة بنت رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (3296)، وأبو يعلى (6748) واللفظ لهما.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"UpMOM4ea"},{"id":"س-05800","fp":"4ac1c18cf28b","stateId":500,"easy":"إذا أطلت الجلوس في الشمس ← تُبلي الثوب وتنتن الريح وتظهر الداء الدفين","cause":"إيَّاكمْ و الجلوسَ في الشمسِ","result":"فإنها تبُلِي الثوبَ، و تُنتنُ الريحَ، و تُظهِرُ الداءَ الدفينَ","explicit":true,"ref":"الجامع الصغير 2907","srcLabel":"الحاكم","text":[["إيَّاكمْ و الجلوسَ في الشمسِ،  ",1],["فإنها تبُلِي الثوبَ،  و تُنتنُ الريحَ،  و تُظهِرُ الداءَ الدفينَ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8264)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"XNs3QU7j"},{"id":"س-05903","fp":"a59a02d68e89","stateId":500,"easy":"إذا نمت وفي يدك غمر ولم تغسله فأصابك شيء ← فلا تلومن إلا نفسك","cause":"مَن نامَ وفي يَدِه غَمرٌ، ولم يَغسِلْه","result":"فأصابَه شَيءٌ، فلا يَلومَنَّ إلَّا نَفْسَه","explicit":true,"repOf":"س-05773","ref":"تخريج سنن أبي داود 3852","text":["قال: قال رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: ",["مَن نامَ وفي يَدِه غَمرٌ، ولم يَغسِلْه، ",1],["فأصابَه شَيءٌ، فلا يَلومَنَّ إلَّا نَفْسَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1859) مطولاً باختلاف يسير، وأحمد (7569)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"sHqxvb8a"},{"id":"س-06192","fp":"748cfc4a06f1","stateId":500,"easy":"إذا تركت الخلال ← يوهن أسنانك","cause":"تَرْكُ الخِلالِ","result":"يوهِنُ الأسنانَ","explicit":true,"ref":"إرواء الغليل 1974","srcLabel":"الطبراني","text":["[ عنِ ] ابنِ عُمَرَ: ",["تَرْكُ الخِلالِ",1]," ",["يوهِنُ الأسنانَ",2]],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"صحيح","takhrij":"أخرجه أبو نعيم في ((الطب النبوي)) (331)، والمستغفري في ((الطب النبوي)) (461) واللفظ لهما، والطبراني في ((المعجم الكبير)) (12/ 265) (13065) بنحوه.","bab":"زينة اللباس › اللباس الحسن والنظافة","dorar":"7eF0DlJT"},{"id":"س-05950","fp":"c645379e898e","stateId":500,"easy":"إذا قاربت الوباء (القرف) ← فقد يكون منه التلف","cause":"القَرَفِ","result":"التَّلَفَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"سفر السعادة 281","srcLabel":"سفر السعادة","text":["أنَّ من ",["القَرَفِ",1]," ",["التَّلَفَ",2]],"grade":"صحيح","muhaddith":"ثابت","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Zyd9SG41"},{"id":"س-05111","fp":"5cb13749624b","stateId":501,"easy":"إذا اطلع أحد على بيتك بغير إذنك ← فلا جناح عليك","cause":"اطَّلَعَ- بِغَيْرِ إذْنِك","result":"ففقَأْتَ عَيْنَه؛ ما كان عليك جُناحٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 7313","srcLabel":"متفق عليه","text":["لو أنَّ رَجُلًا اطَّلَعَ -وقال مرَّةً: لو أنَّ امْرَأً ",["اطَّلَعَ- بِغَيْرِ إذْنِك",1],"، فخذَفْتَه بِـحَصاةٍ ",["ففقَأْتَ عَيْنَه؛ ما كان عليك جُناحٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (6888)، ومسلم (2158) بلفظ مقارب","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"hlKsY48f","merged":8,"otherRefs":["إرواء الغليل 7/284 (صحيح)","صحيح البخاري 6888 (صحيح)","صحيح النسائي 4876 (صحيح)","تخريج المسند لشعيب 9525 (صحيح)","تخريج سنن الدارقطني 4274 (صحيح)","تخريج صحيح ابن حبان 6003 (صحيح)","تخريج مشكل الآثار 932 (حسن)"]},{"id":"س-05774","fp":"993c6655fab0","stateId":501,"easy":"إذا خذفت ← تكسر السن وتفقأ العين ولا تنكي العدو","cause":"إياكم والخذْفَ","result":"فإِنَّها تَكْسِرُ السِّنَّ ، وتَفْقَأُ العَيْنَ ، ولَا تُنْكِي العدُوَّ","explicit":true,"ref":"صحيح الجامع 2676","srcLabel":"مسلم","text":[["إياكم والخذْفَ ، ",1],["فإِنَّها تَكْسِرُ السِّنَّ ، وتَفْقَأُ العَيْنَ ، ولَا تُنْكِي العدُوَّ",2]],"grade":"صحيح","narrator":"عبدالله بن مغفل","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (18/ 227) (566) واللفظ له، ومسلم (1954)، وابن ماجة (3226) بنحوه مطولًا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"wb1u52gk"},{"id":"س-05124","fp":"4d4a25d1e71d","stateId":501,"easy":"إذا اطلعت في بيت غيرك بغير إذن ← تستحق فقء عينك","cause":"فأَلقَم عيْنَيْهِ خَصاصةَ البابِ","result":"أمَا إنَّكَ لو ثبَتَّ لَفقَأْتُ عيْنَكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 937","srcLabel":"متفق عليه","text":["أنَّ أعرابيًّا أتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["فأَلقَم عيْنَيْهِ خَصاصةَ البابِ",1],"، فبَصُر به رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأخَذ سَهمًا، أو عودًا مُحدَّدًا، وجاء به لِيفقَأَ عيْنَ الأعرابيِّ، فانقمَع الأعرابيُّ، وذهَب، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أمَا إنَّكَ لو ثبَتَّ لَفقَأْتُ عيْنَكَ",2],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (937) واللفظ له، والبخاري (6242)، ومسلم (2157) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"6E1VcZU3","merged":3,"otherRefs":["صحيح الأدب المفرد 815 (صحيح)","الأحاديث المختارة 1531 (صحيح)"]},{"id":"س-00223","fp":"dfa409f095f7","stateId":501,"easy":"إذا لعنت دابتك ← لا تركبها","cause":"ركِبَتْ جَملًا، فلعَنَتْه","result":"لا تَرْكَبيهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[12],"ref":"تخريج المسند لشعيب 25074","srcLabel":"أحمد","text":["أنَّها ",["ركِبَتْ جَملًا، فلعَنَتْه",1],"، فقال لها النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["لا تَرْكَبيهِ",2],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (25074) واللفظ له، وأبو يعلى (4735)","bab":"آداب المجلس › الركوب على الدابة","dorar":"tjchn3hK"}]}