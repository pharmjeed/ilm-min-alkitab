{"schema":1,"kind":"sunan-chunk","version":"sunan-3f5fd6b9930a","needId":49,"stateIds":[511,512,513,514,515,516,517,518,519,520,521,522,523,524,525,526,527,528,529,530,531,532,533],"items":[{"id":"س-00853","fp":"bb16b4db9650","stateId":511,"easy":"إذا قلت «لا إله إلا الله وحده...» مئة مرة ← تعدل عشر رقاب وتُكتب مئة حسنة وتُمحى مئة سيئة","cause":"مَن قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَومٍ مِائةَ مَرَّةٍ","result":"كانَت له عَدلَ عَشرِ رِقابٍ، وكُتِبَت له مِائةُ حَسَنةٍ، ومُحيَت عنه مِائةُ سَيِّئةٍ، وكانَت له حِرزًا مِنَ الشَّيطانِ يَومَه ذلك حتَّى يُمسيَ، ولم يَأتِ أحَدٌ أفضَلَ ممَّا جاءَ به، إلَّا أحَدٌ عَمِلَ أكثَرَ مِن ذلك","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَوم» · العدد: مئة مرة"},"otherNeedIds":[45,11],"ref":"صحيح مسلم 2691","srcLabel":"متفق عليه","text":[["مَن قال: لا إلَهَ إلَّا اللهُ وحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قديرٌ، في يَومٍ مِائةَ مَرَّةٍ؛ ",1],["كانَت له عَدلَ عَشرِ رِقابٍ، وكُتِبَت له مِائةُ حَسَنةٍ، ومُحيَت عنه مِائةُ سَيِّئةٍ، وكانَت له حِرزًا مِنَ الشَّيطانِ يَومَه ذلك حتَّى يُمسيَ، ولم يَأتِ أحَدٌ أفضَلَ ممَّا جاءَ به، إلَّا أحَدٌ عَمِلَ أكثَرَ مِن ذلك",2],"، ومَن قال: سُبحانَ اللهِ وبحَمدِه في يَومٍ مِائةَ مَرَّةٍ، حُطَّت خَطاياه ولو كانَت مِثلَ زَبَدِ البَحرِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3293)، ومسلم (2691) واللفظ له","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"nO8HQkLK"},{"id":"س-01168","fp":"c707307e4e9f","stateId":511,"easy":"إذا جلست مع الذاكرين من الفجر حتى تطلع الشمس ← أحب من عتق أربعة","cause":"لأنْ أجْلِسَ معَ قَوْمٍ يَذكُرونَ اللهَ عَزَّ وجَلَّ مِن صَلاةِ الغَداةِ حتَّى تَطلُعَ الشَّمْسُ","result":"أحَبُّ إليَّ مِن أن أعْتِقَ أرْبَعةَ رِقابٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"similar":["س-00883"],"ref":"الأحاديث المختارة 2419","srcLabel":"متفق عليه","text":["«",["لأنْ أجْلِسَ معَ قَوْمٍ يَذكُرونَ اللهَ عَزَّ وجَلَّ مِن صَلاةِ الغَداةِ حتَّى تَطلُعَ الشَّمْسُ",1]," ",["أحَبُّ إليَّ مِن أن أعْتِقَ أرْبَعةَ رِقابٍ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"4J0xD4jy"},{"id":"س-01034","fp":"be09e88d5fc0","stateId":511,"easy":"إذا ذكرت الله بعد العصر حتى الغروب ← فهو أحب من عتق أربع رقاب","cause":"ومنَ العصرِ حتى تغرُبَ الشمسُ","result":"أحبُّ إليَّ من أن أُعتِقَ أربعَ رِقابٍ من ولدِ إسماعيلَ","explicit":true,"ref":"كشف اللثام 2/28","srcLabel":"أحمد","text":["لَأنْ أقعُدَ أذكُرُ اللهُ وأكبِّرُه وأحمَدُه وأسبِّحُه وأهلِّلُه حتى تطلُعَ الشمسُ أحبُّ إليَّ من أنْ أُعتِقَ رقبتَينِ من ولدِ إسماعيلَ ",["ومنَ العصرِ حتى تغرُبَ الشمسُ",1]," ",["أحبُّ إليَّ من أن أُعتِقَ أربعَ رِقابٍ من ولدِ إسماعيلَ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22185) باختلاف يسير، والطحاوي في ((شرح مشكل الآثار)) (3909) مختصراً، والطبراني (8/317) (8028) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"ik91cntO","merged":3,"otherRefs":["مختصر الأحكام 3/151 (حسن)","صحيح الترغيب 466 (حسن)"]},{"id":"س-01033","fp":"036d4613646e","stateId":511,"easy":"إذا قعدت تذكر الله بعد الصبح حتى الشروق ← فهو أحب من عتق رقبتين من ولد إسماعيل","cause":"لَأنْ أقعُدَ أذكُرُ اللهُ وأكبِّرُه وأحمَدُه وأسبِّحُه وأهلِّلُه حتى تطلُعَ الشمسُ","result":"أحبُّ إليَّ من أنْ أُعتِقَ رقبتَينِ من ولدِ إسماعيلَ","explicit":true,"ref":"كشف اللثام 2/28","srcLabel":"أحمد","text":[["لَأنْ أقعُدَ أذكُرُ اللهُ وأكبِّرُه وأحمَدُه وأسبِّحُه وأهلِّلُه حتى تطلُعَ الشمسُ",1]," ",["أحبُّ إليَّ من أنْ أُعتِقَ رقبتَينِ من ولدِ إسماعيلَ",2]," ومنَ العصرِ حتى تغرُبَ الشمسُ أحبُّ إليَّ من أن أُعتِقَ أربعَ رِقابٍ من ولدِ إسماعيلَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (22185) باختلاف يسير، والطحاوي في ((شرح مشكل الآثار)) (3909) مختصراً، والطبراني (8/317) (8028) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"ik91cntO","merged":2,"otherRefs":["صحيح الترغيب 466 (حسن)"]},{"id":"س-01059","fp":"7eaae8528cb9","stateId":511,"easy":"إذا قلت صباحاً «لا إله إلا الله وحده...» ← فلك عدل رقبة من ولد إسماعيل وعشر حسنات","cause":"مَن قال إذا أصبَحَ: لا إلهَ إلَّا اللهُ وَحْدَه، لا شريكَ له، له المُلكُ، وله الحَمدُ، وهو على كُلِّ شَيءٍ قَديرٌ","result":"كان له عَدلُ رَقَبةٍ من وَلَدِ إسماعيلَ، وكُتِبَ له عَشرُ حَسَناتٍ، وحُطَّ عنه عَشرُ سيِّئاتٍ، ورُفِعَ له عَشرُ دَرَجاتٍ، وكان في حِرزٍ من الشَّيطانِ حتى يُمسيَ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحْدَه، لا شريكَ له، له المُلكُ، وله الحَمدُ، وهو على كُلِّ شَيءٍ قَديرٌ» · الوقت: في الصباح"},"similar":["س-01055"],"otherNeedIds":[45,11],"ref":"تخريج سنن أبي داود 5077","srcLabel":"ابن ماجه","text":[["مَن قال إذا أصبَحَ: لا إلهَ إلَّا اللهُ وَحْدَه، لا شريكَ له، له المُلكُ، وله الحَمدُ، وهو على كُلِّ شَيءٍ قَديرٌ",1],"، ",["كان له عَدلُ رَقَبةٍ من وَلَدِ إسماعيلَ، وكُتِبَ له عَشرُ حَسَناتٍ، وحُطَّ عنه عَشرُ سيِّئاتٍ، ورُفِعَ له عَشرُ دَرَجاتٍ، وكان في حِرزٍ من الشَّيطانِ حتى يُمسيَ",2],"، وإنْ قالها إذا أمْسى كان له مِثلُ ذلك حتى يُصبِحَ.\nقال في حديثِ حمَّادٍ: فرأى رَجُلٌ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فيما يَرى النَّائمُ، فقال: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، إنَّ أبا عيَّاشٍ يُحدِّثُ عنكَ بكذا وكذا، قال: صَدَقَ أبو عيَّاشٍ."],"grade":"صحيح","narrator":"أبو عائش أو أبو عياش الزرقي","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (3867)، وأحمد (16583) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"kU8TzYBO","merged":2,"otherRefs":["تخريج مشكل الآثار 3905 (صحيح)"]},{"id":"س-00851","fp":"462ebc82f47e","stateId":511,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← فهو كعتق نسمة","cause":"ومَن قال : لا إله إلا اللهُ وحدَه لا شريكَ له ، له الملكُ وله الحمدُ ، وهو على كلِّ شيءٍ قديرٌ","result":"فهُو كعِتْقِ نَسَمَةٍ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا اللهُ وحدَه لا شريكَ له ، له الملكُ وله الحمدُ ، وهو على كلِّ شيءٍ قديرٌ»"},"similar":["س-00925"],"ref":"صحيح الترغيب 1535","srcLabel":"الترمذي","text":["مَن منح مَنيحَةَ ورِقٍ ، أو منيحةَ لَبَنٍ ، أو هَدَى زِقاقًا ؛ فهو كعِتاقِ نَسَمَةٍ . ",["ومَن قال : ( لا إله إلا اللهُ وحدَه لا شريكَ له ، له الملكُ وله الحمدُ ، وهو على كلِّ شيءٍ قديرٌ",1]," ) ",["فهُو كعِتْقِ نَسَمَةٍ",2]," ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1957)، وأحمد (18516) باختلاف يسير.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"5lm8cF3s"},{"id":"س-00925","fp":"a3dfc74b0add","stateId":511,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← فهو كعتق نسمة","cause":"من قال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شَيءٍ قديرٌ عَشْرَ مرَّاتٍ","result":"فهو كعِتاقِ نَسَمةٍ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شَيءٍ قدير»"},"repOf":"س-00851","otherNeedIds":[24],"ref":"الضعفاء الكبير 4/86","text":["مَن مَنَح مَنيحةَ وَرِقٍ أو مَنيحةَ لَبَنٍ أو هَدَى زِقاقًا، فهو كعِتاقِ نَسَمةٍ، ",["من قال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شَيءٍ قديرٌ عَشْرَ مرَّاتٍ، ",1],["فهو كعِتاقِ نَسَمةٍ",2],"، قال: وكان يأتي ناحيةَ الصَّفِّ يُسَوِّي بين صُدورِهم ومناكِبِهم يقولُ: لا تختَلِفوا فتختَلِفَ قُلوبُكم، وكان يقولُ: إنَّ اللهَ وملائِكَتَه يُصَلُّونَ على الصُّفوفِ الأُوَلِ، وكان يقولُ: زَيِّنوا القُرآنَ بأصواتِكم"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1957)، وأحمد (18516) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (4/86) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"CE1hixY2"},{"id":"س-01055","fp":"33945fbb48e9","stateId":511,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← فلك عدل رقبة","cause":"ومَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قَديرٌ، عَشْرَ مِرارٍ","result":"كان له عِدلُ رَقبةٍ أو نَسَمةٍ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قَديرٌ»"},"repOf":"س-01059","ref":"تخريج المسند لشعيب 18704","text":["مَن مَنَحَ مَنيحةَ وَرِقٍ، أو هَدى زُقاقًا، أو سَقى لَبَنًا؛ كان له  عِدلُ رَقبةٍ أو نَسَمةٍ، ",["ومَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قَديرٌ، عَشْرَ مِرارٍ؛ ",1],["كان له  عِدلُ رَقبةٍ أو نَسَمةٍ",2],". وكان يَأتينا إذا قُمْنا إلى الصَّلاةِ، فيَمسَحُ صُدورَنا أو عَواتِقَنا، يقولُ: لا تَختلِفْ صُفوفُكم؛ فتَختلِفَ قُلوبُكم. وكان يقولُ: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ الأوَّلِ أو الصُّفوفِ الأُوَلِ. وقال: زَيِّنوا القُرآنَ بأصْواتِكم، كنتُ نَسيتُها، فذَكَّرَنيها الضَّحَّاكُ بنُ مُزاحِمٍ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (664، 1468) مفرقاً بنحوه، والنسائي (811، 1015) مفرقاً بنحوه، وابن ماجه (1342) مختصراً، وأحمد (18704) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"LmO01swC"},{"id":"س-01066","fp":"fa97b76b11fa","stateId":511,"easy":"إذا قلت صباحاً عشر مرات «لا إله إلا الله وحده...» ← تعدل عشر رقاب ويجيرك الله من الشيطان يومك","cause":"مَن قال حينَ يُصبِحُ عَشْرَ مراتٍ: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، كتَبَ اللهُ بها عَشْرَ حَسَناتٍ، ومَحا عنه بها عَشْرَ سيِّئاتٍ","result":"وكانت كعَدلِ عَشْرِ رِقابٍ، وأجارَه اللهُ يَومَه منَ الشيطانِ الرجيمِ، وإذا أمْسى فمثلُ ذلك حتى يُصبِحَ","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ» · العدد: عشر مرات · الوقت: في الصباح"},"otherNeedIds":[31],"ref":"تخريج زاد المعاد 2/344","srcLabel":"أبو داود","text":[["مَن قال حينَ يُصبِحُ عَشْرَ مراتٍ: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، كتَبَ اللهُ بها عَشْرَ حَسَناتٍ، ومَحا عنه بها عَشْرَ سيِّئاتٍ، ",1],["وكانت كعَدلِ عَشْرِ رِقابٍ، وأجارَه اللهُ يَومَه منَ الشيطانِ الرجيمِ، وإذا أمْسى فمثلُ ذلك حتى يُصبِحَ",2],"."],"grade":"صحيح","narrator":"أبو عياش الزرقي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5077) بنحوه، والدولابي في ((الكنى والأسماء)) (279)، وابن السني في ((عمل اليوم والليلة)) (64) باختلاف يسير دون قوله: \"عشر مرات\"","bab":"أدعية وأذكار › فضل الذكر","dorar":"juVBjYvx"},{"id":"س-01083","fp":"cedbc699af64","stateId":511,"easy":"إذا كبّرت وحمدت وسبّحت مئة مرة ← فهو خير لك من مئة بدنة ومئة فرس في سبيل الله","cause":"كَبِّري اللهَ مائةَ مرَّةٍ، واحمَدِي اللهَ مائةَ مرَّةٍ، وسبِّحي اللهَ مائةَ مرَّةٍ","result":"فهو خيرٌ لكِ مِن مائةِ بَدَنةٍ مُتقبَّلةٍ، وخيرٌ مِن مائةِ فرَسٍ مُسْرَجٍ مُلْجَمٍ في سبيلِ اللهِ، وخيرٌ مِن مائةِ رَقَبةٍ مُتقبَّلةٍ","explicit":true,"apply":{"k":"count","t":"مئة مرة"},"similar":["س-01151"],"ref":"المستدرك على الصحيحين 1917","srcLabel":"الحاكم","text":["يا نَبيَّ اللهِ، إنِّي امرأةٌ قد كَبِرتُ وضَعُفتُ، فدُلَّني على عَمَلٍ، قالَ: ",["كَبِّري اللهَ مائةَ مرَّةٍ، واحمَدِي اللهَ مائةَ مرَّةٍ، وسبِّحي اللهَ مائةَ مرَّةٍ",1],"؛ ",["فهو خيرٌ لكِ مِن مائةِ بَدَنةٍ مُتقبَّلةٍ، وخيرٌ مِن مائةِ فرَسٍ مُسْرَجٍ مُلْجَمٍ في سبيلِ اللهِ، وخيرٌ مِن مائةِ رَقَبةٍ مُتقبَّلةٍ",2],"، وقولُ لا إلَهَ إلَّا اللهُ لا يَترُكُ ذنبًا، ولا يُشبِهُها عَملٌ."],"grade":"صحيح","narrator":"أم هانئ بنت أبي طالب","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › فضل الذكر","dorar":"HoHh5PmN"},{"id":"س-06294","fp":"85c44dbfa6fb","stateId":511,"easy":"إذا قلت «لا إله إلا الله وحده لا شريك له...» ← فكأنك أعتقت رقبة","cause":"مَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ، وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، أو مَنَحَ مِنحةً، أو هَدى زُقاقًا","result":"كان كمَن أعتَقَ رَقبةً","explicit":true,"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ، وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، أو مَنَحَ مِنحةً، أو هَدى زُقاقًا؛ كان كمَن أعتَقَ رَقبة»"},"ref":"تخريج المسند لشعيب 18531","srcLabel":"أبو داود","text":[["مَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ، وله الحَمدُ، وهو على كلِّ شيءٍ قَديرٌ، أو مَنَحَ مِنحةً، أو هَدى زُقاقًا؛ ",1],["كان كمَن أعتَقَ رَقبةً",2],". قال أبو عبدِ الرَّحمنِ: سَمِعتُ أبي يقولُ: كان يَحيى بنُ آدَمَ قَليلَ الذِّكرِ للنَّاسِ، ما سَمِعتُه ذَكَرَ أحَدًا غيرَ قَنانٍ، قال: قال لنا يومًا: ليس هذا مِن بابتِكم."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (664، 1468) مفرقاً بنحوه، والنسائي (811، 1015) مفرقاً بنحوه، وابن ماجه (1342) مختصراً، وأحمد (18531) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"yNthCPyv"},{"id":"س-07246","fp":"30e5c7d824f2","stateId":511,"easy":"إذا قعدت في مجلس ذكر ← فهو أحب من عتق أربع رقاب","cause":"أقعدَ في مثلِ هذا المجلسِ","result":"أحبُّ إليَّ من أن أعتقَ أربعَ رقابٍ","explicit":true,"ref":"مجمع الزوائد 1/195","srcLabel":"أحمد","text":["لأن ",["أقعدَ في مثلِ هذا المجلسِ",1]," ",["أحبُّ إليَّ من أن أعتقَ أربعَ رقابٍ",2]," قال شعبةُ فقلت أيَّ مجلسٍ يعني قال كان قاصًّا"],"grade":"صحيح","narrator":"رجل من أهل بدر","muhaddith":"فيه كردوس بن قيس وثقه ابن حبان وبقية رجاله رجال الصحيح","takhrij":"أخرجه أحمد (15899)، والدارمي (2822)، والبيهقي (20195) واللفظ لهم جميعا.","bab":"علم › فضل مجالس العلم والذكر","dorar":"PZqCtfdl"},{"id":"س-01203","fp":"91f3fdac9c77","stateId":511,"easy":"إذا سبّحت الله مئة تسبيحة ← تعدل مئة رقبة تعتقها","cause":"سبِّحِي اللهَ مئةَ تسبيحةٍ","result":"فإنها تعدلُ لكِ مئةَ رقبةٍ تعتِقِيها من ولدِ إسماعيلَ","explicit":true,"ref":"مجمع الزوائد 10/95","srcLabel":"النسائي","text":["مرَّ بي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ فقلت يا رسولَ اللهِ قد كبُرْت وضعُفْتُ أو كما قالت فمُرْني بعملٍ أعملُ وأنا جالسةٌ قال ",["سبِّحِي اللهَ مئةَ تسبيحةٍ",1]," ",["فإنها تعدلُ لكِ مئةَ رقبةٍ تعتِقِيها من ولدِ إسماعيلَ",2]," واحمَدِي اللهَ مئةَ تحميدةٍ فإنها تعدلُ مئةَ فرسٍ مسرجةٍ ملجمةٍ تحملينَ عليها في سبيلِ اللهِ وكبِّرِي اللهَ مئةَ تكبيرةٍ فإنها تعدلُ لك مئةَ بدنةٍ مقلدةٍ متَقبَّلةٍ وهلِّلي اللهَ مئةً قال ابنُ خلفٍ أحسبُه قال تملأُ ما بينَ السماءِ والأرضِ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ إلا أن يأتِيَ بمثلِ ما أتيت [ وفي روايةٍ ] قلت يا رسولَ اللهِ كبُرَت سنِّي ورقَّ عظمِي فدُلَّنِي على عملٍ يُدخِلُني الجنةَ فقال بخٍ بخٍ لقد سألت وقال خيرٌ لك من مئةِ بدنةٍ مقلدةٍ مجللةٍ تٌهديها إلى بيتِ اللهِ تعالَى وقولِي لا إلهَ إلا اللهُ مئةَ مرةٍ فهو خيرٌ لكِ مما أطبقت عليه السماءُ والأرضُ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ أفضلُ مما رُفِع لك إلا مَن قال مثلَ ما قلتَ أو زادَ"],"grade":"حسن","narrator":"فاختة بنت أبي طالب أم هانئ","muhaddith":"أسانيدهم حسنة","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10680)، وابن ماجه (3810)، وأحمد (26911) باختلاف يسير. والرواية أخرجها الطبراني في ((المعجم الأوسط)) (6313)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"PQazsOpK","merged":2,"otherRefs":["تخريج شرح السنة 1280 (حسن)"]},{"id":"س-01204","fp":"8b7fbdf81e37","stateId":511,"easy":"إذا حمدت الله مئة تحميدة ← تعدل مئة فرس مسرجة في سبيل الله","cause":"واحمَدِي اللهَ مئةَ تحميدةٍ","result":"فإنها تعدلُ مئةَ فرسٍ مسرجةٍ ملجمةٍ تحملينَ عليها في سبيلِ اللهِ","explicit":true,"ref":"مجمع الزوائد 10/95","srcLabel":"النسائي","text":["مرَّ بي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ فقلت يا رسولَ اللهِ قد كبُرْت وضعُفْتُ أو كما قالت فمُرْني بعملٍ أعملُ وأنا جالسةٌ قال سبِّحِي اللهَ مئةَ تسبيحةٍ فإنها تعدلُ لكِ مئةَ رقبةٍ تعتِقِيها من ولدِ إسماعيلَ ",["واحمَدِي اللهَ مئةَ تحميدةٍ",1]," ",["فإنها تعدلُ مئةَ فرسٍ مسرجةٍ ملجمةٍ تحملينَ عليها في سبيلِ اللهِ",2]," وكبِّرِي اللهَ مئةَ تكبيرةٍ فإنها تعدلُ لك مئةَ بدنةٍ مقلدةٍ متَقبَّلةٍ وهلِّلي اللهَ مئةً قال ابنُ خلفٍ أحسبُه قال تملأُ ما بينَ السماءِ والأرضِ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ إلا أن يأتِيَ بمثلِ ما أتيت [ وفي روايةٍ ] قلت يا رسولَ اللهِ كبُرَت سنِّي ورقَّ عظمِي فدُلَّنِي على عملٍ يُدخِلُني الجنةَ فقال بخٍ بخٍ لقد سألت وقال خيرٌ لك من مئةِ بدنةٍ مقلدةٍ مجللةٍ تٌهديها إلى بيتِ اللهِ تعالَى وقولِي لا إلهَ إلا اللهُ مئةَ مرةٍ فهو خيرٌ لكِ مما أطبقت عليه السماءُ والأرضُ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ أفضلُ مما رُفِع لك إلا مَن قال مثلَ ما قلتَ أو زادَ"],"grade":"حسن","narrator":"فاختة بنت أبي طالب أم هانئ","muhaddith":"أسانيدهم حسنة","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10680)، وابن ماجه (3810)، وأحمد (26911) باختلاف يسير. والرواية أخرجها الطبراني في ((المعجم الأوسط)) (6313)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"PQazsOpK","merged":2,"otherRefs":["تخريج شرح السنة 1280 (حسن)"]},{"id":"س-01205","fp":"a97886609bac","stateId":511,"easy":"إذا كبّرت الله مئة تكبيرة ← تعدل مئة بدنة مقلّدة متقبّلة","cause":"وكبِّرِي اللهَ مئةَ تكبيرةٍ","result":"فإنها تعدلُ لك مئةَ بدنةٍ مقلدةٍ متَقبَّلةٍ","explicit":true,"ref":"مجمع الزوائد 10/95","srcLabel":"النسائي","text":["مرَّ بي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذاتَ يومٍ فقلت يا رسولَ اللهِ قد كبُرْت وضعُفْتُ أو كما قالت فمُرْني بعملٍ أعملُ وأنا جالسةٌ قال سبِّحِي اللهَ مئةَ تسبيحةٍ فإنها تعدلُ لكِ مئةَ رقبةٍ تعتِقِيها من ولدِ إسماعيلَ واحمَدِي اللهَ مئةَ تحميدةٍ فإنها تعدلُ مئةَ فرسٍ مسرجةٍ ملجمةٍ تحملينَ عليها في سبيلِ اللهِ ",["وكبِّرِي اللهَ مئةَ تكبيرةٍ",1]," ",["فإنها تعدلُ لك مئةَ بدنةٍ مقلدةٍ متَقبَّلةٍ",2]," وهلِّلي اللهَ مئةً قال ابنُ خلفٍ أحسبُه قال تملأُ ما بينَ السماءِ والأرضِ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ إلا أن يأتِيَ بمثلِ ما أتيت [ وفي روايةٍ ] قلت يا رسولَ اللهِ كبُرَت سنِّي ورقَّ عظمِي فدُلَّنِي على عملٍ يُدخِلُني الجنةَ فقال بخٍ بخٍ لقد سألت وقال خيرٌ لك من مئةِ بدنةٍ مقلدةٍ مجللةٍ تٌهديها إلى بيتِ اللهِ تعالَى وقولِي لا إلهَ إلا اللهُ مئةَ مرةٍ فهو خيرٌ لكِ مما أطبقت عليه السماءُ والأرضُ ولا يُرفعُ يومئذٍ لأحدٍ عملٌ أفضلُ مما رُفِع لك إلا مَن قال مثلَ ما قلتَ أو زادَ"],"grade":"حسن","narrator":"فاختة بنت أبي طالب أم هانئ","muhaddith":"أسانيدهم حسنة","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10680)، وابن ماجه (3810)، وأحمد (26911) باختلاف يسير. والرواية أخرجها الطبراني في ((المعجم الأوسط)) (6313)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"PQazsOpK","merged":2,"otherRefs":["تخريج شرح السنة 1280 (حسن)"]},{"id":"س-01118","fp":"6a6ffb23e2a2","stateId":511,"easy":"إذا قلت «سبحان الله وبحمده» أو «الحمد لله» أو «الله أكبر» مئة مرة ← تعدل مئة بدنة تُنحر بمكة","cause":"من قال سبحانَ اللهِ وبحمدِه كان مثلَ مئةِ بدنةٍ إذا قالها مئةَ مرةٍ ومن قال الحمدُ للهِ مئةَ مرةٍ كان عِدلَ مئةِ فرسٍ مسرجٍ مُلجَمٍ في سبيلِ اللهِ ومن","result":"قال اللهُ أكبرُ مئةَ مرةٍ كان كعِدلِ مئةِ بدنةٍ تُنحَرُ بمكةَ","explicit":true,"apply":{"k":"say","t":"«سبحان الله وبحمده» ثم «الحمد لله» ثم «الله أكبر» · العدد: مئة مرة"},"ref":"مجمع الزوائد 10/94","srcLabel":"الطبراني","text":[["من قال سبحانَ اللهِ وبحمدِه كان مثلَ مئةِ بدنةٍ إذا قالها مئةَ مرةٍ ومن قال الحمدُ للهِ مئةَ مرةٍ كان عِدلَ مئةِ فرسٍ مسرجٍ مُلجَمٍ في سبيلِ اللهِ ومن ",1],["قال اللهُ أكبرُ مئةَ مرةٍ كان كعِدلِ مئةِ بدنةٍ تُنحَرُ بمكةَ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/135) (7534) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (3/318) مختصراً، والبيهقي في ((شعب الإيمان)) (4396، 4397، 4398) مفرقاً","bab":"أدعية وأذكار › فضل الذكر","dorar":"bDgHWlPn"},{"id":"س-01207","fp":"6960772d4186","stateId":511,"easy":"إذا سبّحت الله مئة بالغداة ومئة بالعشي ← فكأنك حججت مئة حجة","cause":"من سبحَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ","result":"كان كمن حجَّ مائةَ حجةٍ","explicit":true,"ref":"سنن الترمذي 3471","srcLabel":"أبو الفضل","text":[["من سبحَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، ",1],["كان كمن حجَّ مائةَ حجةٍ ، ",2],"ومن حمد اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حمل على مائةِ فرسٍ في سبيلِ اللهِ – أو قال - : غزا مائةَ غزوةٍ . ومن هلَّلَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن أعتقَ مائةَ رقبةٍ من ولدِ إسماعيلَ . ومن كَبَّرَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، لم يأتِ في ذلك اليومِ أَحَدٌ بأكثرَ ممَّا أَتَى بهِ إلَّا من قال مثلَ ما قال ، أو زاد على ما قال"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن غريب","takhrij":"أخرجه أبو الفضل البغدادي  في ((حديث الزهري)) (701)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"dzswlZPl"},{"id":"س-01208","fp":"997af974a12c","stateId":511,"easy":"إذا حمدت الله مئة بالغداة ومئة بالعشي ← فكأنك حملت على مئة فرس في سبيل الله","cause":"ومن حمد اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ","result":"كان كمن حمل على مائةِ فرسٍ في سبيلِ اللهِ","explicit":true,"ref":"سنن الترمذي 3471","srcLabel":"أبو الفضل","text":["من سبحَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حجَّ مائةَ حجةٍ ، ",["ومن حمد اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، ",1],["كان كمن حمل على مائةِ فرسٍ في سبيلِ اللهِ –",2]," أو قال - : غزا مائةَ غزوةٍ . ومن هلَّلَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن أعتقَ مائةَ رقبةٍ من ولدِ إسماعيلَ . ومن كَبَّرَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، لم يأتِ في ذلك اليومِ أَحَدٌ بأكثرَ ممَّا أَتَى بهِ إلَّا من قال مثلَ ما قال ، أو زاد على ما قال"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن غريب","takhrij":"أخرجه أبو الفضل البغدادي  في ((حديث الزهري)) (701)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"dzswlZPl"},{"id":"س-01209","fp":"09f6fcd170d7","stateId":511,"easy":"إذا هلّلت الله مئة بالغداة ومئة بالعشي ← فكأنك أعتقت مئة رقبة","cause":"ومن هلَّلَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ","result":"كان كمن أعتقَ مائةَ رقبةٍ من ولدِ إسماعيلَ","explicit":true,"ref":"سنن الترمذي 3471","srcLabel":"أبو الفضل","text":["من سبحَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حجَّ مائةَ حجةٍ ، ومن حمد اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، كان كمن حمل على مائةِ فرسٍ في سبيلِ اللهِ – أو قال - : غزا مائةَ غزوةٍ . ",["ومن هلَّلَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، ",1],["كان كمن أعتقَ مائةَ رقبةٍ من ولدِ إسماعيلَ ",2],". ومن كَبَّرَ اللهَ مائةً بالغداةِ ، ومائةً بالعشيِّ ، لم يأتِ في ذلك اليومِ أَحَدٌ بأكثرَ ممَّا أَتَى بهِ إلَّا من قال مثلَ ما قال ، أو زاد على ما قال"],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن غريب","takhrij":"أخرجه أبو الفضل البغدادي  في ((حديث الزهري)) (701)","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"dzswlZPl"},{"id":"س-00883","fp":"97a97ec5a7e6","stateId":511,"easy":"إذا جلست تذكر الله من الفجر حتى تشرق الشمس ← أحب من عتق أربع رقاب","cause":"لأن أقعُدَ هذا المقعدَ من غُدوةٍ حتَّى تُشرِقَ الشَّمسُ","result":"أحبَّ إليَّ من أن أعتِقَ أربعَ رقابٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-01168","ref":"مختصر الأحكام 3/151","text":["خرج رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ورجلٌ يقصُّ فسكت الرَّجلُ ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : قُصَّ ، ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["لأن أقعُدَ هذا المقعدَ من غُدوةٍ حتَّى تُشرِقَ الشَّمسُ",1]," ",["أحبَّ إليَّ من أن أعتِقَ أربعَ رقابٍ",2]," ، ولأن أقعُدَ هذا المقعدَ بعد العصرِ حتَّى تغرُبَ الشَّمسُ أحبَّ إليَّ من أن أعتِقَ أربعَ رقابٍ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"يقال : هذا حديث حسن غريب من حديث شعبة","takhrij":"أخرجه أحمد (22308)، والطوسي في ((مختصر الأحكام)) (417) واللفظ له، والطبراني (8/312) (8013)","bab":"أدعية وأذكار › فضل الذكر","dorar":"Ef0T7bw2"},{"id":"س-01151","fp":"d718d22c30ea","stateId":511,"easy":"إذا كبّرت وحمدت وسبّحت مائة ← فهو خير من عتق ومن جهاد","cause":"كبِّري اللَّهَ مائةَ مرَّةٍ ، واحمَدي اللَّهَ مائةَ مرَّةٍ ، وسبِّحي اللَّهَ مائةَ مرَّةٍ خيرٌ من مائةِ فرَسٍ مُلجَمٍ مُسرَجٍ في سبيلِ اللَّهِ ، وخيرٌ من مائةِ بدَنةٍ ، وخيرٌ من مائةِ رقبةٍ","result":"دُلَّني على عملٍ فإنِّي قد كَبِرْتُ وضعفتُ وبدَّنتُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-01083","ref":"صحيح ابن ماجه 3087","text":["أتيتُ إلى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ، فقُلتُ : يا رسولَ اللَّهِ ، ",["دُلَّني على عملٍ فإنِّي قد كَبِرْتُ وضعفتُ وبدَّنتُ ،",2]," فقالَ : ",["كبِّري اللَّهَ مائةَ مرَّةٍ ، واحمَدي اللَّهَ مائةَ مرَّةٍ ، وسبِّحي اللَّهَ مائةَ مرَّةٍ خيرٌ من مائةِ فرَسٍ مُلجَمٍ مُسرَجٍ في سبيلِ اللَّهِ ، وخيرٌ من مائةِ بدَنةٍ ، وخيرٌ من مائةِ رقبةٍ",1]],"grade":"حسن","narrator":"فاختة بنت أبي طالب أم هانئ","muhaddith":"حسن","takhrij":"أخرجه ابن ماجه (3810)","bab":"أدعية وأذكار › فضل الذكر","dorar":"dkfh5k6j"},{"id":"س-00884","fp":"fef4004b9ef2","stateId":512,"easy":"إذا عجزت عن قيام الليل وبخلت بالمال وجبنت عن العدو ← فأكثر ذكر الله","cause":"فليُكثر ذِكرَ اللَّهِ","result":"من عجزَ منكم عنِ اللَّيلِ أن يُكابدَه ، وبخلَ بالمالِ أن ينفقَه ، وجبنَ عنِ العدوِّ أن يجاهدَه","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"الوهم والإيهام 5/333","srcLabel":"الطبراني","text":[["من عجزَ منكم عنِ اللَّيلِ أن يُكابدَه ، وبخلَ بالمالِ أن ينفقَه ، وجبنَ عنِ العدوِّ أن يجاهدَه",2],"، ",["فليُكثر ذِكرَ اللَّهِ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"حسن أو صحيح","takhrij":"أخرجه البزار (4904) واللفظ له، والطبراني (11/84) (11121) مختصراً، والبيهقي في ((شعب الإيمان)) (508) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"faDSdiHp","merged":2,"otherRefs":["المصابيح في الأحاديث المتواترة 622 (صحيح)"]},{"id":"س-00847","fp":"1fdbc49dda55","stateId":512,"easy":"إذا سبّحت وحمدت وكبّرت وهلّلت وأمرت بالمعروف ونهيت عن المنكر ← فكله صدقة منك على نفسك","cause":"التَّسبيحُ ، والتَّحميدُ والتَّكبيرُ، والتَّهليلُ ، والأمرُ بالمعروفِ والنَّهيُ عن المنكرِ ، وتُميطُ الأذَى عن الطَّريقِ ، وتُسمِعُ الأصَّمَّ ، وتَهدي الأعمَى ، وتُدِلَّ المستدِلَّ على حاجتِه ، وتسعَى بشدَّةِ ساقَيْك مع اللَّهفانِ المستغيثِ ، وتحمِلُ بشدَّةِ ذراعَيْك مع الضَّعيفِ","result":"فهذا كلُّه صدقةٌ منك على نفسِك","explicit":true,"ref":"الترغيب والترهيب 4/63","srcLabel":"النسائي","text":["ليس من نفسِ ابنِ آدمَ إلَّا عليها صدقةٌ في كلِّ يومٍ طلَعت فيه الشَّمسُ ، قيل : يا رسولَ اللهِ من أين لنا صدقةٌ نتصدَّقُ بها ؟ فقال : إنَّ أبوابَ الخيرِ لكثيرةٌ : ",["التَّسبيحُ ، والتَّحميدُ والتَّكبيرُ، والتَّهليلُ ، والأمرُ بالمعروفِ والنَّهيُ عن المنكرِ ، وتُميطُ الأذَى عن الطَّريقِ ، وتُسمِعُ الأصَّمَّ ، وتَهدي الأعمَى ، وتُدِلَّ المستدِلَّ على حاجتِه ، وتسعَى بشدَّةِ ساقَيْك مع اللَّهفانِ المستغيثِ ، وتحمِلُ بشدَّةِ ذراعَيْك مع الضَّعيفِ",1]," ، ",["فهذا كلُّه صدقةٌ منك على نفسِك",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (3377) واللفظ له، وأخرجه أحمد (21484)، والنسائي في ((السنن الكبرى)) (8978) مطولاً باختلاف يسير","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"7J3s1ocL"},{"id":"س-01136","fp":"08437db5d45c","stateId":512,"easy":"إذا بخلت بالمال وعجزت عن قيام الليل ← فعليك بـ«سبحان الله وبحمده»","cause":"من ضنَّ بالمالِ أن يُنفِقَه ، و بالليلِ أن يُكابِدَه","result":"فعليه بسبحانَ اللهِ و بحمدِه","explicit":true,"apply":{"k":"time","t":"في الليل"},"ref":"صحيح الجامع 6377","srcLabel":"صحيح الجامع","text":[["من ضنَّ بالمالِ أن يُنفِقَه ، و بالليلِ أن يُكابِدَه ، ",1],["فعليه بسبحانَ اللهِ و بحمدِه",2]],"grade":"صحيح","narrator":"عبدالله بن خبيب وابن مسعود وأبو أمامة","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل الذكر","dorar":"3cOHACo7"},{"id":"س-01025","fp":"cfef4f802fe2","stateId":512,"easy":"إذا ذكرت الله ← فما صدقة أفضل من ذكر الله","cause":"ذكرُ اللهَ","result":"ما صدقةٌ أفضلُ","explicit":true,"ref":"الترغيب والترهيب 2/330","srcLabel":"الطبراني","text":["لو أنَّ رجلًا في حجرِه دراهمُ يقسِمُها وآخرُ ي",["ذكرُ اللهَ",1]," كان الذَّاكرُ للهِ أفضلُ وفي روايةٍ ",["ما صدقةٌ أفضلُ",2]," من ذكرِ اللهِ"],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"رواته حديثهم حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (5969)","bab":"أدعية وأذكار › فضل الذكر","dorar":"4fSn6dTT"},{"id":"س-01249","fp":"ff1cabafc69b","stateId":512,"easy":"إذا عجزت عن القرآن فقل «سبحان الله والحمد لله ولا إله إلا الله والله أكبر...» ← تجزئك","cause":"قُل: سبحانَ اللَّهِ، والحمدُ للَّهِ، ولا إلَهَ إلَّا اللَّهُ، واللَّهُ أَكْبرُ، ولا إلَهَ إلَّا اللَّهُ، ولا حولَ ولا قوَّةَ إلَّا باللَّهِ","result":"يجزئُني منَ القرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر...»"},"similar":["س-01200"],"ref":"صحيح ابن خزيمة 1/589","srcLabel":"أبو داود","text":["جاءَ رجلٌ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ: يا رَسولَ اللَّهِ، علِّمني شيئًا يجزئُني منَ القرآنِ، فإنِّي لا أقرأُ، فقالَ: ",["قُل: سبحانَ اللَّهِ، والحمدُ للَّهِ، ولا إلَهَ إلَّا اللَّهُ، واللَّهُ أَكْبرُ، ولا إلَهَ إلَّا اللَّهُ، ولا حولَ ولا قوَّةَ إلَّا باللَّهِ",1]," قالَ: فضمَّ عليها الرَّجلُ بيدِهِ قالَ: هذا لربِّي، فما لي؟ قالَ: قلِ: اللَّهمَّ اغفر لي، وارحَمني، واهدِني، وارزُقني، وعافِني قالَ: فضمَّ عليها بيدِهِ الأخرى وقامَ وفي روايةٍ: فقالَ: علِّمني شيئًا ",["يجزئُني منَ القرآنِ",2],"، [ وليسَ فيها ]: فضمَّ عليها الرَّجلُ بيدِهِ"],"grade":"صحيح","narrator":"عبدالله بن أبي أوفى","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن حبان (1781) باختلاف يسير، وأبو داود (832)، والنسائي (924) بنحوه","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"5RnrfHc2","merged":3,"otherRefs":["تخريج المسند لشعيب 19138 (حسن)","الأحاديث المختارة 13 / 102 (صحيح)"]},{"id":"س-01212","fp":"7f17b17cb32d","stateId":512,"easy":"إذا ضننت بالمال وجبنت عن العدو فأكثر من «سبحان الله والحمد لله...» ← تنال أجرهما","cause":"فليُكثِرْ مِن قَولِ: سُبحانَ اللَّهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللَّهُ","result":"فمَن ضَنَّ بالمالِ أن يُنفِقَه، وخاف العَدوُّ أن يُجاهدَه، وهابَ اللَّيلَ أن يُكابدَه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله...»"},"ref":"القضاء والقدر 367","srcLabel":"أحمد","text":["«إنَّ اللَّهَ قَسَّمَ بَينَكُم أخلاقَكُم كَما قَسَّمَ بَينَكُم أرزاقَكُم، وإنَّ اللَّهَ يُعطي الدُّنيا مَن يُحِبُّ ومَن لا يُحِبُّ، ولا يُعطي الإيمانَ إلَّا مَن يُحِبُّ» زادَ جُنَيدُ بنُ حَكيمٍ في رِوايَتِه: \"",["فمَن ضَنَّ بالمالِ أن يُنفِقَه، وخاف العَدوُّ أن يُجاهدَه، وهابَ اللَّيلَ أن يُكابدَه",2],"، ",["فليُكثِرْ مِن قَولِ: سُبحانَ اللَّهِ، والحَمدُ للهِ، ولا إلهَ إلَّا اللَّهُ",1],"، واللَّهُ وأكبَرُ\""],"grade":"صحيح","narrator":"عبد الله [بن مسعود]","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أحمد (3672)، والعدني في ((الإيمان)) (64)، والطبراني (9/ 203) (8990) واللفظ لهم.","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"RPojkTBK","merged":2,"otherRefs":["صحيح الترغيب 1571 (صحيح)"]},{"id":"س-01200","fp":"be2b1893036b","stateId":512,"easy":"إذا عجزت عن حفظ القرآن فقل «سبحان الله والحمد لله ولا إله إلا الله والله أكبر» ← تجزئك","cause":"قل : سبحان اللهِ ، والحمدُ لله ، ولا إله إلا اللهُ ، واللهُ أكبرُ","result":"يُجزئُ من القرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سبحان الله والحمد لله ولا إله إلا الله والله أكبر»"},"repOf":"س-01249","ref":"صحيح الترغيب 1561","text":["قال أعرابيٌّ يا رسولَ اللهِ إني قد عالجتُ القرآنَ فلم أستطِعْه فعلِّمْني شيئًا ",["يُجزئُ من القرآنِ",2]," ؟ ",["قل : ( سبحان اللهِ ، والحمدُ لله ، ولا إله إلا اللهُ ، واللهُ أكبرُ",1]," ) . فقالها ، وأمسكَها بأصبعِه ، فقال : يا رسولَ اللهِ ! هذا لربي ، فما لي ؟ قال : تقول : اللهمَّ اغفِرْ لي ، وارْحمني ، وعافني ، وارزُقني ، وأحسبُه قال : - واهدِني . ومضى الأعرابيُّ ، فقال رسولُ اللهِ : ذهب الأعرابيُّ وقد ملأ يدَيه خيرًا ."],"grade":"حسن","narrator":"عبدالله بن أبي أوفى","muhaddith":"حسن","takhrij":"أخرجه أبو داود (832)، وأحمد (19110) باختلاف يسير، والنسائي (924) مختصراً باختلاف يسير","bab":"أدعية وأذكار › فضل سبحان الله والحمد لله ولا إله إلا الله والله أكبر","dorar":"2jfIR1ab"},{"id":"س-00772","fp":"cb6e6248365b","stateId":512,"easy":"إذا قلت «اللهم أعنا على ذكرك وشكرك وحسن عبادتك» ← تنال ثواب الاجتهاد","cause":"قولوا: اللَّهُمَّ أَعِنَّا على ذِكرِكَ وشُكرِكَ وحُسنِ عِبادتِكَ","result":"أَتُحبُّونَ أيُّها النَّاسُ أنْ تَجتهِدوا في الدُّعاءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللهم أعنا على ذكرك وشكرك وحسن عبادتك»"},"ref":"المستدرك على الصحيحين 1862","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ لهم: ",["أَتُحبُّونَ أيُّها النَّاسُ أنْ تَجتهِدوا في الدُّعاءِ",2],"؟ قالوا: نَعَمْ يا رسولَ اللهِ، قالَ: ",["قولوا: اللَّهُمَّ أَعِنَّا على ذِكرِكَ وشُكرِكَ وحُسنِ عِبادتِكَ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (7982)، وابن الأعرابي في ((معجمه)) (1180)، وأبو نعيم في ((الحلية)) (9/ 223) واللفظ لهم.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"3tkhayOC","merged":2,"otherRefs":["صحيح الجامع 81 (صحيح)"]},{"id":"س-03127","fp":"6463e9051817","stateId":513,"easy":"إذا قلت في التشهد «السلام علينا وعلى عباد الله الصالحين» ← تصيب كل عبد صالح في السماء والأرض","cause":"السَّلامُ علَينا وعلى عبادِ اللَّهِ الصَّالِحينَ","result":"أصابَت كلَّ عبدٍ صالحٍ في السَّماءِ والأرضِ","explicit":true,"star":true,"apply":{"k":"say","t":"«السلام علينا وعلى عباد الله الصالحين»"},"ref":"صحيح ابن خزيمة 1/ 699","srcLabel":"متفق عليه","text":["كنَّا إذا جلَسنا معَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ في التَّشَهُّدِ قُلنا: السَّلامُ على اللَّهِ مِن عبادِهِ، السَّلامُ على فلانٍ وفلانٍ، فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: لا تَقولوا السَّلامُ علَى اللَّهِ ؛ فإنَّ اللَّهَ هوَ السَّلامُ، ولَكِن إذا جلسَ أحدُكُم فليقُلِ: التَّحيَّاتُ للَّهِ والصَّلواتُ والطَّيِّباتُ، والسَّلامُ عليكَ أيُّها النَّبيُّ ورحمةُ اللَّهِ وبرَكاتُهُ، ",["السَّلامُ علَينا وعلى عبادِ اللَّهِ الصَّالِحينَ",1],"، فإنَّكم إذا قلتُمْ ذلِكَ ",["أصابَت كلَّ عبدٍ صالحٍ في السَّماءِ والأرضِ",2],"، أشهدُ أن لا إلَهَ إلَّا اللَّهُ، وأشهدُ أنَّ محمَّدًا عبدُهُ ورسولُهُ، ثمَّ ليتخيَّر أحدُكُم منَ الدُّعاءِ أعجبَهُ إليهِ فليدْعُ بِه هذا لفظُ حديثِ بُندارٍ، وانتَهَى حديثُ ابنِ فُضَيْلٍ، وعبثرٍ، وابنِ إدريسَ عندَ قولِهِ: ورسولُهُ، ولم يقولوا: ثمَّ ليتخيَّر أحدُكُم منَ الدُّعاءِ إلى آخرَهِ [وفي روايةٍ] إلى قولِهِ: ورسولِهِ، [وفي روايةٍ] ثمَّ يتخيَّرُ في المسألةِ ما شاءَ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (797)، ومسلم (402)، وابن ماجه (899) بنحوه","bab":"إيمان › توحيد الأسماء والصفات","dorar":"V7vFd4EE","merged":4,"otherRefs":["صحيح مسلم 402 (صحيح)","تخريج المسند لشعيب 3920 (صحيح)","تخريج المسند لشعيب 4017 (صحيح)"]},{"id":"س-01213","fp":"4ee2f43f4a69","stateId":513,"easy":"إذا قلت «سبحان الله وبحمده عدد خلقه ورضا نفسه وزنة عرشه ومداد كلماته» ← لو وُزنت بالأذكار الطويلة لوزنتها","cause":"سُبحانَ اللَّهِ وبحمدِهِ، عددَ خلقِهِ، ورِضا نفسِهِ، وزنةَ عرشِهِ، ومدادَ كلماتِهِ","result":"لو وُزِنَّ بما قلتِ لوَزنتهنَّ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله وبحمده عدد خلقه ورضا نفسه وزنة عرشه ومداد كلماته»"},"ref":"صحيح ابن خزيمة 1/ 733","srcLabel":"مسلم","text":["قالت جوَيْريةُ بنتُ الحارثِ - وَكانَ اسمُها برَّةَ - فحوَّلَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ اسمَها، وسمَّاها جوَيْريةَ، وَكَرِهَ أن يقالَ: خرجَ من عِندِ برَّةَ - قالَت: خرجَ النَّبيُّ صلَّى اللَّهُ عليهِ وسلَّمَ وأَنا في مُصلَّاي فرجعَ حينَ تعالى النَّهارُ وأَنا فيهِ، فقالَ: لم تَزالي في مُصلَّاكِ منذُ خرجتُ؟ قلتُ: نعَم قالَ: قد قُلتُ أربعَ كلماتٍ ثلاثَ مرَّاتٍ ",["لو وُزِنَّ بما قلتِ لوَزنتهنَّ",2],": ",["سُبحانَ اللَّهِ وبحمدِهِ، عددَ خلقِهِ، ورِضا نفسِهِ، وزنةَ عرشِهِ، ومدادَ كلماتِهِ",1],". [وفي روايةٍ]: عنِ ابنِ عبَّاسٍ، أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ حينَ خرجَ إلى صلاةِ الصُّبحِ وجوَيْريةُ جالِسةٌ في المسجدِ، فذَكَرَ الحديثَ ولم يذكُر ما قبلَ هذا منَ الكلامِ"],"grade":"صحيح","narrator":"جويرية بنت الحارث","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2726) بلفظ مقارب، والترمذي (3555)، وابن ماجه (3808)","bab":"أدعية وأذكار › فضل سبحان الله وبحمده","dorar":"PsQGa2ms","merged":5,"otherRefs":["صحيح مسلم 2726 (صحيح)","صحيح ابن حبان 832 (صحيح)","تخريج المسند لشاكر 4/97 (صحيح)","تخريج مشكل الآثار 6033 (صحيح)"]},{"id":"س-00977","fp":"b08d824fe94b","stateId":513,"easy":"إذا قلت «سبحان الله عدد خلقه ورضا نفسه وزنة عرشه ومداد كلماته» ← فهن أفضل من الذكر الطويل","cause":"سبحانَ اللهِ عَددَ خَلْقِه، وسبحانَ اللهِ رِضاءَ نَفْسِه، وسبحانَ اللهِ زِنَةَ عَرْشِه، وسبحانَ اللهِ مِدادَ كَلِماتِه","result":"هن أَفضَلُ ممَّا قلتِ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله عدد خلقه ورضا نفسه وزنة عرشه ومداد كلماته»"},"ref":"تخريج المسند لشعيب 3308","srcLabel":"مسلم","text":["كان اسمُ جُوَيريةَ بنتِ الحارِثِ بَرَّةَ، فحوَّلَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ اسمَها، فسمَّاها جُوَيريةَ، فمرَّ بها النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، فإذا هي في مُصلَّاها تُسَبِّحُ اللهَ وتَدعوه، فانطلَقَ لِحاجَتِه، ثم رجَعَ إليها بَعدَما ارتفَعَ النَّهارُ، فقال: يا جُوَيريةُ ما زلتِ في مَكانِك؟ قالت: ما زلتُ في مَكاني هذا، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: لقد تكلَّمتُ بأَربعِ كَلِماتٍ، أَعُدُّهنَّ ثَلاثَ مَرَّاتٍ، ",["هن أَفضَلُ ممَّا قلتِ",2],": ",["سبحانَ اللهِ عَددَ خَلْقِه، وسبحانَ اللهِ رِضاءَ نَفْسِه، وسبحانَ اللهِ زِنَةَ عَرْشِه، وسبحانَ اللهِ مِدادَ كَلِماتِه",1],"، والحَمدُ للهِ مِثلَ ذلك."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1503) باختلاف يسير، وقوله: \"كان اسمُ جُوَيريةَ بنتِ الحارِثِ بَرَّةَ\" أخرجه مسلم (2140) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"VxCEDNa0","merged":2,"otherRefs":["ما تمس إليه الحاجة 84 (صحيح)"]},{"id":"س-01158","fp":"7c1174c1050d","stateId":513,"easy":"إذا قلت «سبحان الله عدد خلقه» و«زنة عرشه» ثلاثاً ← لو وُزنت بما سواها لعدلتها","cause":"سُبحانَ اللهِ عدَدَ خَلْقِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ زِنَةَ عرشِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ رضَا نفسِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ مِدادَ كلماتِه - ثلاثَ مرَّاتٍ","result":"لو عُدِلْنَ بهنَّ عدَلَتْهنَّ","explicit":true,"star":true,"apply":{"k":"say","t":"«سبحان الله عدد خلقه» ثم «زنة عرشه»"},"ref":"تخريج صحيح ابن حبان 828","srcLabel":"مسلم","text":["أتى علَيَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم وأنا أُسبِّحُ ثمَّ انطلَق لحاجتِه ثمَّ رجَع مِن نصفِ النَّهارِ فقال : ( ما زِلْتِ قاعدةً ) ؟ قالت : قُلْتُ : نَعم قال : ( ألَا أُعلِّمُكِ كلماتٍ ",["لو عُدِلْنَ بهنَّ عدَلَتْهنَّ",2]," أو لو وُزِنَّ بهنَّ وزَنَتْهنَّ ؟ ",["سُبحانَ اللهِ عدَدَ خَلْقِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ زِنَةَ عرشِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ رضَا نفسِه - ثلاثَ مرَّاتٍ - سُبحانَ اللهِ مِدادَ كلماتِه - ثلاثَ مرَّاتٍ",1]," - )"],"grade":"صحيح","narrator":"جويرية بنت الحارث أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (828)، وأبو يعلى (7068) واللفظ لهما، ومسلم (2726)، والترمذي (3555) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"ucdnn7D9","merged":2,"otherRefs":["صحيح الأدب المفرد 503 (صحيح)"]},{"id":"س-01081","fp":"fa1cd543e7a5","stateId":513,"easy":"إذا قلت عند نومك «الحمد لله الذي كفاني وآواني...» ← فقد حمدت الله بجميع محامد الخلق","cause":"مَنْ قالَ إذا أَوى إلى فِراشِه: الحمدُ للهِ الَّذي كَفاني وآواني، الحمدُ للهِ الَّذي أَطْعَمني وسَقاني، الحمدُ للهِ الَّذي مَنَّ عَلَيَّ فأَفضلَ، اللَّهُمَّ إنِّي أَسألُكَ بعِزَّتِكَ أنْ تُنجِيَني مِنَ النَّارِ","result":"فقد حَمِدَ اللهَ بجميعِ محامِدِ الخَلْقِ كُلِّهِم","explicit":true,"apply":{"k":"say","t":"«الحمدُ للهِ الَّذي كَفاني وآواني، الحمدُ للهِ الَّذي أَطْعَمني وسَقاني، الحمدُ للهِ الَّذي مَنَّ عَلَيَّ فأَفضلَ، اللَّهُمَّ إنِّي أَسألُكَ بعِزَّتِكَ أنْ تُنجِيَني مِنَ النَّارِ؛ فقد حَمِدَ اللهَ بجميعِ محامِدِ الخَلْقِ كُلِّهِم»"},"ref":"المستدرك على الصحيحين 2027","srcLabel":"مسلم","text":[["مَنْ قالَ إذا أَوى إلى فِراشِه: الحمدُ للهِ الَّذي كَفاني وآواني، الحمدُ للهِ الَّذي أَطْعَمني وسَقاني، الحمدُ للهِ الَّذي مَنَّ عَلَيَّ فأَفضلَ، اللَّهُمَّ إنِّي أَسألُكَ بعِزَّتِكَ أنْ تُنجِيَني مِنَ النَّارِ",1],"؛ ",["فقد حَمِدَ اللهَ بجميعِ محامِدِ الخَلْقِ كُلِّهِم",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الضياء في ((المختارة)) (1574) واللفظ له، ومسلم (2715)، وأبو داود (5053) مختصرا","bab":"أدعية وأذكار › فضل الذكر","dorar":"IJyQTHs8"},{"id":"س-00661","fp":"1e9a31278ab6","stateId":513,"easy":"إذا قلت صباحاً «اللهم ما أصبح بي من نعمة... فمنك وحدك لا شريك لك» ← فقد أديت شكر يومك (ومساءً شكر ليلتك)","cause":"اللهُمَّ ما أصبحَ بي من نِعْمَةٍ أوْ بِأَحَدٍ مَنّ خَلْقِكَ ، فَمِنْكَ وحْدَكَ لا شريكَ لكَ ، فلكَ الحمدُ ولكَ الشّكْرُ ومَنْ قال ذلكَ حينَ يُمسي","result":"فقد أَدَّى شُكْرَ لَيْلَتِه","explicit":true,"apply":{"k":"say","t":"«اللهُمَّ ما أصبحَ بي من نِعْمَةٍ أوْ بِأَحَدٍ مَنّ خَلْقِكَ ، فَمِنْكَ وحْدَكَ لا شريكَ لك» · الوقت: في الصباح"},"ref":"الفتح الرباني 11/5477","srcLabel":"أبو داود","text":["أنَّ العبدَ إذا قال في صباحِ يومِهِ : ",["اللهُمَّ ما أصبحَ بي من نِعْمَةٍ أوْ بِأَحَدٍ مَنّ خَلْقِكَ ، فَمِنْكَ وحْدَكَ لا شريكَ لكَ ، فلكَ الحمدُ ولكَ الشّكْرُ ومَنْ قال ذلكَ حينَ يُمسي",1]," ",["فقد أَدَّى شُكْرَ لَيْلَتِه",2]],"grade":"صحيح","narrator":"عبدالله بن غنام البياضي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5073)، والنسائي في ((السنن الكبرى)) (9835)، والبيهقي في ((شعب الإيمان)) (4368) باختلاف يسير","bab":"أدعية وأذكار › أذكار الصباح","dorar":"zCiGklbh"},{"id":"س-07097","fp":"129b89fc4e55","stateId":513,"easy":"إذا قلت «سبحان الله عدد خلقه» ← فهو أكثر مما سبّحت طويلاً","cause":"سبحانَ اللهِ عددَ خلقِه","result":"بأكثرَ ممَّا سبَّحتِ به","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«سبحان الله عدد خلقه»"},"similar":["س-01074","س-00987"],"ref":"الترغيب والترهيب 2/360","srcLabel":"الترمذي","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم دخلَ عليها وبين يدَيْها أربعةُ آلافِ نواةٍ تُسبِّحُ بهنَّ فقال ألا أُعلِمُك ",["بأكثرَ ممَّا سبَّحتِ به",2]," فقلتُ بلى علِّمْني فقال قُولي ",["سبحانَ اللهِ عددَ خلقِه",1]],"grade":"صحيح","narrator":"صفية أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الترمذي (3554)، وأبو يعلى (7118)، والطبراني (24/ 74) (195)، وابن عدي في ((الكامل في الضعفاء)) (8/ 419)، والحاكم (2008) واللفظ لهم.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"ZdjqY15S","merged":2,"otherRefs":["تخريج مشكل الآثار 6036 (حسن)"]},{"id":"س-00680","fp":"9bb7f02c3f8e","stateId":513,"easy":"إذا قلت «الحمد لله رب العالمين حمداً يوافي نعمه ويكافئ مزيده» ← فهو مجامع الحمد والتسبيح","cause":"الحمدُ للهِ ربِّ العالمين حمدًا يوافي نعمَه ويكافئُ مزيدَه","result":"فذلك مجامعُ الحمدِ والتسبيحِ","explicit":true,"apply":{"k":"say","t":"«الحمد لله رب العالمين حمداً يوافي نعمه ويكافئ مزيده»"},"ref":"نتائج الأفكار 3/289","srcLabel":"ابن الصلاح","text":["قال آدمُ عليه الصلاة والسلام : يا ربِّ شغلتني بكسبِ يدي ، فعلِّمني شيئًا فيه مجامعُ الحمدِ والتسبيحِ ، فأوحى اللهُ تبارك وتعالى إليه : يا آدمُ إذا أصبحتَ فقل ثلاثًا وإذا أمسيتَ فقل ثلاثًا : ",["الحمدُ للهِ ربِّ العالمين حمدًا يوافي نعمَه ويكافئُ مزيدَه",1]," ، ",["فذلك مجامعُ الحمدِ والتسبيحِ",2]],"grade":"حسن","narrator":"محمد بن النضر الحارثي","muhaddith":"رجاله ثقات، لكن محمد بن النضر لم يكن صاحب حديث، ولم يجئ عنه شيء مسند","takhrij":"أخرجه ابن الصلاح كما في ((التلخيص الحبير)) لابن حجر (6/ 3125) بلفظه.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"CPZr607m"},{"id":"س-00920","fp":"608785fc9f61","stateId":513,"easy":"إذا قلتهن حين تمسي ← تدرك ما فاتك في ليلتك","cause":"من قالَهنَّ حينَ يمسي","result":"أدرَك ما فاتَه في ليلتِهِ","explicit":true,"apply":{"k":"time","t":"في المساء"},"ref":"هداية الرواة 2/471","srcLabel":"أبو داود","text":["من قالَ حينَ يصبحُ { فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ } إلى قوله { وَكَذَلِكَ تُخْرَجُونَ } أدرَك ما فاتَه في يومِه ذلِك و",["من قالَهنَّ حينَ يمسي",1]," ",["أدرَك ما فاتَه في ليلتِهِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5076)، والعقيلي في ((الضعفاء الكبير)) (2/100)، والطبراني (12/239) (12991) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"ohzc3hxT"},{"id":"س-01074","fp":"b9ef53b5c11b","stateId":513,"easy":"إذا قلت «سبحان الله عدد ما خلق من شيء» ← فهي أكثر مما سبّحت طويلاً","cause":"قولي سُبحانَ اللهِ عَدَدَ ما خَلَقَ مِن شيءٍ","result":"قد سَبَّحتُ منذُ قُمتُ على رأسِكِ أكثرَ مِن هذا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«سبحان الله عدد ما خلق من شيء»"},"repOf":"س-07097","ref":"المستدرك على الصحيحين 2034","text":["دَخَلَ عَلَيَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وبيْنَ يدَيَّ أربعةُ آلافِ نواةٍ أُسبِّحُ بهِنَّ، فقالَ: يا بنتَ حُيَيٍّ، ما هذا؟ قلتُ: أُسبِّحُ بهِنَّ، قالَ: ",["قد سَبَّحتُ منذُ قُمتُ على رأسِكِ أكثرَ مِن هذا",2],". قلتُ: علِّمْني يا رسولَ اللهِ، قالَ: ",["قولي سُبحانَ اللهِ عَدَدَ ما خَلَقَ مِن شيءٍ",1],"."],"grade":"صحيح","narrator":"صفية","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (24/ 74) (195) بلفظه، والترمذي (3554) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"gyBe5PDx"},{"id":"س-00987","fp":"19a94adfda96","stateId":513,"easy":"إذا قلت «سبحان الله عدد ما خلق...» ← فهو أكثر من ذكرك الليل والنهار","cause":"أن تقولَ: سُبحانَ اللَّهِ عَددَ ما خلقَ، وسُبحانَ اللَّهِ مِلءَ ما خلقَ، وسبحانَ اللَّهِ عددَ ما في الأرضِ والسَّماءِ، وسبحانَ اللَّهِ مِلءَ ما في الأرضِ والسَّماءِ، وسُبحانَ اللَّهِ عددَ ما أحصَى كتابُهُ، وسبحانَ اللَّهِ عددَ كلِّ شيءٍ، وسبحانَ اللَّهِ ملءَ كلِّ شيءٍ","result":"بأَكْثرَ - أو أفضلَ - مِن ذِكْرِكَ اللَّيلَ معَ النَّهارِ، والنَّهارَ معَ اللَّيلِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«سُبحانَ اللَّهِ عَددَ ما خلقَ، وسُبحانَ اللَّهِ مِلءَ ما خلقَ، وسبحانَ اللَّهِ عددَ ما في الأرضِ والسَّماءِ، وسبحانَ اللَّهِ مِلءَ ما في الأرضِ والسَّماءِ، وسُبحانَ اللَّهِ عددَ ما أحصَى كتابُهُ، وسبحانَ اللَّهِ عددَ كلِّ شيءٍ، وسبحانَ اللَّهِ ملءَ كلِّ شيءٍ، وتقولُ الحَمدُ مثلَ ذلِك»"},"repOf":"س-07097","ref":"صحيح ابن خزيمة 1/ 734","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ مرَّ بِهِ وَهوَ يحرِّكُ شفتيهِ، فقالَ: ماذا تقولُ يا أبا أمامةَ؟ قالَ: أذكرُ ربِّي قالَ: أفلا أخبرُكَ ",["بأَكْثرَ - أو أفضلَ - مِن ذِكْرِكَ اللَّيلَ معَ النَّهارِ، والنَّهارَ معَ اللَّيلِ",2],"؟ ",["أن تقولَ: سُبحانَ اللَّهِ عَددَ ما خلقَ، وسُبحانَ اللَّهِ مِلءَ ما خلقَ، وسبحانَ اللَّهِ عددَ ما في الأرضِ والسَّماءِ، وسبحانَ اللَّهِ مِلءَ ما في الأرضِ والسَّماءِ، وسُبحانَ اللَّهِ عددَ ما أحصَى كتابُهُ، وسبحانَ اللَّهِ عددَ كلِّ شيءٍ، وسبحانَ اللَّهِ ملءَ كلِّ شيءٍ",1],"، وتقولُ الحَمدُ مثلَ ذلِكَ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9921)، والروياني في ((المسند)) (1235)، وابن خزيمة (754) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"EenYhHG9"},{"id":"س-01104","fp":"a22c54faa535","stateId":513,"easy":"إذا قلت «الحمد لله عدد ما أحصى كتابه...» ← فهو أفضل من دأبك الليل والنهار","cause":"تقول : الحَمدُ للهِ عددَ ما أحصَى كتابَه ، والحمدُ للهِ عددَ ما في كتابِه ، والحمدُ للهِ عددَ ما أحصَى خَلْقَه ، والحمدُ للهِ مِلْءَ ما في خَلْقِه ، والحمدُ للهِ مِلْءَ سَمواتِه وأرضِه ، والحمدُ للهِ عددَ كلِّ شيءٍ ، والحمدُ للهِ على كلِّ شيءٍ","result":"إذا قلتَه ثمَّ دأبتَ اللَّيلَ والنَّهارَ لَم تبلُغْه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«الحَمدُ للهِ عددَ ما أحصَى كتابَه ، والحمدُ للهِ عددَ ما في كتابِه ، والحمدُ للهِ عددَ ما أحصَى خَلْقَه ، والحمدُ للهِ مِلْءَ ما في خَلْقِه ، والحمدُ للهِ مِلْءَ سَمواتِه وأرضِه ، والحمدُ للهِ عددَ كلِّ شيءٍ ، والحمدُ للهِ على كلِّ شيءٍ ، وتُسبِّحُ مثلَ ذلكَ ، وتُكَبِّرُ مثلَ ذلكَ»"},"ref":"صحيح الترغيب 1575","srcLabel":"الطبراني","text":["أفلا أُخْبِرُك بشيءٍ ",["إذا قلتَه ثمَّ دأبتَ اللَّيلَ والنَّهارَ لَم تبلُغْه",2]," . قُلتُ : بلَى . قال : ",["تقول : الحَمدُ للهِ عددَ ما أحصَى كتابَه ، والحمدُ للهِ عددَ ما في كتابِه ، والحمدُ للهِ عددَ ما أحصَى خَلْقَه ، والحمدُ للهِ مِلْءَ ما في خَلْقِه ، والحمدُ للهِ مِلْءَ سَمواتِه وأرضِه ، والحمدُ للهِ عددَ كلِّ شيءٍ ، والحمدُ للهِ على كلِّ شيءٍ",1]," ، وتُسبِّحُ مثلَ ذلكَ ، وتُكَبِّرُ مثلَ ذلكَ ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (8/351) (8122)","bab":"أدعية وأذكار › فضل الذكر","dorar":"orJ3a7J7"},{"id":"س-07082","fp":"1a2f4da61570","stateId":513,"easy":"إذا قلت «الحمد لله عدد ما خلق، الحمد لله ملء ما خلق...» ← فهو أكثر من ذكرك","cause":"تقولُ : الحمدُ لله عددَ ما خلق ، الحمدُ لله مِلْءَ ما خلق ، الحمدُ لله عددَ ما في السمواتِ وما في الأرضِ ، الحمدُ للهِ عددَ ما أحصى كتابُه ، والحمدُ لله على ما أحصى كتابُه ، والحمدُ لله عدَدَ كلِّ شيءٍ ، والحمدُ لله مِلْءَ كلِّ شيءٍ","result":"ألا أدُلُّك على ما هو أكثرُ من ذكرِك اللهَ الليلَ مع النهارِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«الحمدُ لله عددَ ما خلق ، الحمدُ لله مِلْءَ ما خلق ، الحمدُ لله عددَ ما في السمواتِ وما في الأرضِ ، الحمدُ للهِ عددَ ما أحصى كتابُه ، والحمدُ لله على ما أحصى كتابُه ، والحمدُ لله عدَدَ كلِّ شيءٍ ، والحمدُ لله مِلْءَ كلِّ شيءٍ ، وتسبِّحُ اللهَ مثلهنَّ»"},"ref":"صحيح الجامع 2615","srcLabel":"النسائي","text":[["ألا أدُلُّك على ما هو أكثرُ من ذكرِك اللهَ الليلَ مع النهارِ ",2],"؟",[" تقولُ : الحمدُ لله عددَ ما خلق ، الحمدُ لله مِلْءَ ما خلق ، الحمدُ لله عددَ ما في السمواتِ وما في الأرضِ ، الحمدُ للهِ عددَ ما أحصى كتابُه ، والحمدُ لله على ما أحصى كتابُه ، والحمدُ لله عدَدَ كلِّ شيءٍ ، والحمدُ لله مِلْءَ كلِّ شيءٍ",1]," ، وتسبِّحُ اللهَ مثلهنَّ . تَعَلْمهنَّ وعَلِّمْهنَّ عقِبَك مِن بعدِك"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9921)، والروياني في ((المسند)) (1235)، وابن خزيمة (754)، وابن حبان (539) واللفظ لهم.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"rgFp5wPN"},{"id":"س-00919","fp":"66b3934e990d","stateId":513,"easy":"إذا قلت صباحاً «فسبحان الله حين تمسون...» ← تدرك ما فاتك في يومك","cause":"من قالَ حينَ يصبحُ فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ إلى قوله وَكَذَلِكَ تُخْرَجُونَ","result":"أدرَك ما فاتَه في يومِه ذلِك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ } إلى قوله { وَكَذَلِكَ تُخْرَجُونَ } أدرَك ما فاتَه في يومِه ذلِك» · الوقت: في الصباح"},"ref":"هداية الرواة 2/471","srcLabel":"أبو داود","text":[["من قالَ حينَ يصبحُ { فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ } إلى قوله { وَكَذَلِكَ تُخْرَجُونَ",1]," } ",["أدرَك ما فاتَه في يومِه ذلِك",2]," ومن قالَهنَّ حينَ يمسي أدرَك ما فاتَه في ليلتِهِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أبو داود (5076)، والعقيلي في ((الضعفاء الكبير)) (2/100)، والطبراني (12/239) (12991) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"ohzc3hxT"},{"id":"س-00667","fp":"30b31845d8fb","stateId":513,"easy":"إذا قلت «اللهم إنا نسألك من خير ما سألك منه نبيك...» ← يجمع لك ذلك كله","cause":"تَقولُ : اللهُمَّ ! إِنَّا نَسألُكَ من خَيرِ ما سَأَلَكَ مِنهُ نَبيُّكَ مُحمدٍ","result":"ما يَجمعُ ذلِكَ كُلَّهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"star":true,"apply":{"k":"say","t":"«اللهم إنا نسألك من خير ما سألك منه نبيك...»"},"ref":"سنن الترمذي 3521","srcLabel":"البخاري","text":["دعَا رسولُ اللهِ صلَّى اللهُ عليه وسَلَّمَ ، بِدعاءٍ كَثيرٍ لمْ نَحْفَظْ مِنهُ شيئًا ، قُلْنا : يا رسولَ اللهِ ، دَعْوتَ بِدعاءٍ كثيرٍ لَمْ نَحفظْ مِنهُ شيئًا ؟ قال : ألا أدُلُّكُمْ على ",["ما يَجمعُ ذلِكَ كُلَّهُ",2]," . ",["تَقولُ : اللهُمَّ ! إِنَّا نَسألُكَ من خَيرِ ما سَأَلَكَ مِنهُ نَبيُّكَ مُحمدٍ",1]," صَلَّى اللهُ عليه وسَلَّمَ ، ونَعوذُ بِكَ من شَرِّ ما اسْتعاذَ مِنهُ نبيُّكَ مُحمدٌ صلَّى اللهُ عليه وسلَّمَ ، وأنتَ المُستعانُ ، وعليكَ البَلاغُ ، ولا حولَ ولا قُوَّةَ إلا بِاللهِ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (3521) واللفظ له، والبخاري في ((الأدب المفرد)) (679)، والطبراني (8/226) (7791)","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"eKIKrbaI"},{"id":"س-06163","fp":"7bbb585ac520","stateId":514,"easy":"إذا أقمت الصلاة وآتيت الزكاة ← فأنت مهاجر ولو مت في بلدك","cause":"إذا أقَمتَ الصَّلاةَ وآتيتَ الزَّكاةَ","result":"فأنتَ مُهاجرٌ ، وإن مِتَّ بالحضرمةِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 11/114","srcLabel":"الطيالسي","text":["جاءَ رجلٌ من قومِكُما ، أعرابيٌّ جافٍ جريءٌ ، فقالَ : يا رسولَ اللَّهِ ، أينَ الهِجرةُ ، إليكَ حيثُما كنتَ ، أم إلى أرضٍ مَعلومةٍ ، أو لقومٍ خاصَّةً ، أم إذا مِتَّ انقطَعت ؟ قالَ : فسَكَتَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ساعةً ، ثمَّ قالَ : أينَ السَّائلُ عنِ الهجرةِ ؟ قالَ : ها أَنا ذا يا رسولَ اللَّهِ ، قالَ : ",["إذا أقَمتَ الصَّلاةَ وآتيتَ الزَّكاةَ",1]," ",["فأنتَ مُهاجرٌ ، وإن مِتَّ بالحضرمةِ",2]," - قالَ : يعني أرضًا باليَمامةِ قالَ : ثمَّ قامَ رجلٌ ، فقالَ : يا رسولَ اللَّهِ ، أرأيتَ ثيابَ أَهْلِ الجنَّةِ ، أتُنسَجُ نَسجًا ، أم تشقَّقُ مِن ثمرُ الجنَّةِ ؟ قالَ : فَكَأنَّ القومَ تعجَّبوا مِن مسألةِ الأعرابيِّ فقالَ : ما تَعجَبونَ من جاهلٍ يسألُ عالِمًا ؟ قالَ : فسَكَتَ هُنَيَّةً ، ثمَّ قالَ : أينَ السَّائلُ عن ثِيابِ الجنَّةِ ؟ ، قالَ : أَنا ، قالَ لا ، بل تشقَّقُ مِن ثَمرِ الجنَّةِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطيالسي (2391)، والبزار (2434) واللفظ لهما.","bab":"زكاة › فرض الزكاة","dorar":"2nIdXHs3","merged":2,"otherRefs":["تخريج المسند لشاكر 12/45 (صحيح)"]},{"id":"س-06383","fp":"c531358b7890","stateId":514,"easy":"إذا صليت ركعتين من الضحى ← تجزئ عن صدقات مفاصلك كلها","cause":"رَكعتانِ منَ الضُّحى","result":"ويجزئُ من ذلِك كلِّهِ","explicit":true,"star":true,"apply":{"k":"count","t":"ركعتين · الوقت: الضحى"},"similar":["س-02105","س-00769"],"ref":"صحيح أبي داود 1285","srcLabel":"مسلم","text":["يصبحُ علَى كلِّ سلامى منَ ابنِ آدمَ صدقةٌ تسليمُه علَى من لقيَ صدقةٌ وأمرُه بالمعروفِ صدقةٌ ونَهيُه عنِ المنكرِ صدقةٌ وإماطتُه الأذى عنِ الطَّريقِ صدقةٌ وبضعةُ أهلِه صدقةٌ ",["ويجزئُ من ذلِك كلِّهِ",2]," ",["رَكعتانِ منَ الضُّحى",1]," قالَ أبو داودَ وحديثُ عبَّادٍ أتمُّ ولم يذكر مسدَّدٌ الأمرَ والنَّهيَ زادَ في حديثِه وقالَ كذا وَكذا وزادَ ابنُ منيعٍ في حديثِه قالوا يا رسولَ اللَّهِ أحدنا يقضي شَهوتَه وتَكونُ لَه صدقةٌ قالَ أرأيتَ لَو وضعَها في غيرِ حلِّها ألم يَكن يأثمُ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (720)، وأبو داود (1285) واللفظ له، وأحمد (21475)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"uWgwA59f","merged":3,"otherRefs":["صحيح مسلم 720 (صحيح)","صحيح ابن خزيمة 2/ 387 (صحيح)"]},{"id":"س-05620","fp":"1f0fc1cd6ff6","stateId":514,"easy":"إذا صليت الركعتين عند طلوع الفجر ← فهما أحب إلى النبي ﷺ من الدنيا جميعاً","cause":"الرَّكعَتَينِ عِندَ طُلوعِ الفَجرِ","result":"لهما أحَبُّ إليَّ مِنَ الدُّنيا جَميعًا","explicit":true,"star":true,"apply":{"k":"count","t":"ركعتين"},"ref":"صحيح مسلم 725","srcLabel":"النسائي","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، أنَّه قال في شَأنِ ",["الرَّكعَتَينِ عِندَ طُلوعِ الفَجرِ",1],": ",["لهما أحَبُّ إليَّ مِنَ الدُّنيا جَميعًا",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (24241)، والنسائي في ((الكبرى)) (458)، والحاكم (1151) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Jby7YrMg","merged":2,"otherRefs":["صحيح الترغيب 391 (صحيح)"]},{"id":"س-00986","fp":"b888493da58b","stateId":514,"easy":"إذا صليت ست ركعات بعد المغرب لا تتكلم بينهن إلا بخير ← تُعدل لك بعبادة اثنتي عشرة سنة","cause":"مَن صلَّى ستَّ رَكَعاتٍ بعدَ المغربِ لا يتَكَلَّمُ بينَهُنَّ بشَيءٍ إلَّا بذِكْرِ اللَّهِ","result":"عُدِلنَ لَهُ بعبادةِ اثنتَي عشرةَ سنةً","explicit":true,"apply":{"k":"count","t":"ست ركعات"},"ref":"صحيح ابن خزيمة 2/ 357","srcLabel":"الترمذي","text":[["مَن صلَّى ستَّ رَكَعاتٍ بعدَ المغربِ لا يتَكَلَّمُ بينَهُنَّ بشَيءٍ إلَّا بذِكْرِ اللَّهِ",1]," ",["عُدِلنَ لَهُ بعبادةِ اثنتَي عشرةَ سنةً",2]," [وفي روايةٍ]: لا يتَكَلَّمُ بينَهُما بسوءٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (435)، وابن ماجة (1167)، وأبو يعلى (6022) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"6dhNWlTO"},{"id":"س-01896","fp":"7227114ab140","stateId":514,"easy":"إذا صليت في مسجد قباء ← فهي كعدل عمرة","cause":"من صلَّى فيه","result":"كان كعِدلِ عُمرةٍ","explicit":true,"ref":"صحيح الترغيب 1184","srcLabel":"ابن حبان","text":["أنه شهد جنازةً في الأوساطِ في دارِ سعدِ بنِ عُبادةَ فأقبل ماشيًا إلى بني عَمرو بنِ عوفٍ بفناءِ الحارثِ بنِ الخزرجِ فقيل له أين تَؤُمُّ يا أبا عبدِ الرحمنِ قال أؤُمُّ هذا المسجدَ في بني عَمرو بنِ عوفٍ فإني سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ : ",["من صلَّى فيه ",1],["كان كعِدلِ عُمرةٍ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن حبان (1627)، والضياء في ((الأحاديث المختارة)) (280) باختلاف يسير، وأخرجه العقيلي في ((الضعفاء الكبير)) (1/98) بنحوه دون القصة في أوله","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KtjG541L"},{"id":"س-02284","fp":"4bdeb334e367","stateId":514,"easy":"إذا صليت ركعتي الفجر ← فهما خير من حمر النعم","cause":"الرَّكْعَتانِ قبلَ صَلاةِ الفَجرِ","result":"هي خَيرٌ من حُمْرِ النَّعَمِ","explicit":true,"ref":"تنقيح التحقيق 2/412","srcLabel":"البيهقي","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إنَّ اللهَ عزَّ وجلَّ زادَكم صَلاةً إلى صَلاتِكم، ",["هي خَيرٌ من حُمْرِ النَّعَمِ",2],"، ألَا وهي ",["الرَّكْعَتانِ قبلَ صَلاةِ الفَجرِ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((السنن الصغير)) (564)، وابن عساكر في ((تاريخ دمشق)) (45/318)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"SJpTo4mC"},{"id":"س-06025","fp":"f1a9f9ca65c5","stateId":514,"easy":"إذا صليت التطوع حيث لا يراك الناس ← تعدل صلاتك أمامهم خمساً وعشرين","cause":"صلاةُ الرجلِ تَطوُّعًا حيث لا يَراهُ الناسُ","result":"تَعدِلُ صلاتَهُ على أعْيُنِ الناسِ خمسًا وعِشرينَ","explicit":true,"ref":"صحيح الجامع 3821","srcLabel":"ابن نقطة","text":[["صلاةُ الرجلِ تَطوُّعًا حيث لا يَراهُ الناسُ ",1],["تَعدِلُ صلاتَهُ على أعْيُنِ الناسِ خمسًا وعِشرينَ",2]],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"صحيح","takhrij":"أخرجه ابن نقطة في ((تكملة الإكمال)) (3311)، وأبو يعلى كما في ((المطالب العالية)) (574) واللفظ لهما.","bab":"رقائق وزهد › عمل السر","dorar":"G3pd3tLU"},{"id":"س-07614","fp":"0b4eeba07dee","stateId":514,"easy":"إذا صليت الخمس ← فلك بكل صلاة عشر فهي خمسون صلاة","cause":"إنَّهنَّ خَمسُ صَلَواتٍ كُلَّ يَومٍ ولَيلةٍ","result":"لكُلِّ صَلاةٍ عَشرٌ، فذلك خَمسونَ صَلاةً","explicit":true,"ref":"صحيح مسلم 162","srcLabel":"النسائي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: أُتيتُ بالبُراقِ، وهو دابَّةٌ أبيَضُ طَويلٌ فوقَ الحِمارِ، ودونَ البَغلِ، يَضَعُ حافِرَه عِندَ مُنتَهى طَرْفِه، قال: فرَكِبتُه حتَّى أتَيتُ بَيتَ المَقدِسِ، قال: فرَبَطتُه بالحَلقةِ التي يَربِطُ به الأنبياءُ، قال: ثُمَّ دَخَلتُ المَسجِدَ، فصَلَّيتُ فيه رَكعَتَينِ، ثُمَّ خَرَجتُ فجاءَني جِبريلُ عليه السَّلامُ بإناءٍ مِن خَمرٍ، وإناءٍ مِن لَبَنٍ، فاختَرتُ اللَّبَنَ، فقال جِبريلُ صلَّى اللهُ عليه وسلَّم: اختَرتَ الفِطرةَ، ثُمَّ عُرِجَ بنا إلى السَّماءِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بآدَمَ، فرَحَّبَ بي، ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الثَّانيةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بابنَيِ الخالةِ عيسى ابنِ مَريَمَ، ويَحيى بنِ زَكَريَّا، صَلَواتُ اللهِ عليهما، فرَحَّبا ودَعَوا لي بخَيرٍ، ثُمَّ عَرَجَ بي إلى السَّماءِ الثَّالِثةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بيوسُفَ صلَّى اللهُ عليه وسلَّم، إذا هو قد أُعطيَ شَطرَ الحُسنِ، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الرَّابِعةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قال: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإدريسَ، فرَحَّبَ ودَعا لي بخَيرٍ، قال اللهُ عزَّ وجلَّ: {ورَفَعناه مَكانًا عَليًّا} [مريم: 57]، ثُمَّ عُرِجَ بنا إلى السَّماءِ الخامِسةِ، فاستَفتَحَ جِبريلُ، قيلَ: مَن هذا؟ فقال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بهارونَ صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّادِسةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بموسى صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّابِعةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإبراهيمَ صلَّى اللهُ عليه وسلَّم مُسنِدًا ظَهرَه إلى البَيتِ المَعمورِ، وإذا هو يَدخُلُه كُلَّ يَومٍ سَبعونَ ألفَ مَلَكٍ لا يَعودونَ إليه، ثُمَّ ذَهَبَ بي إلى السِّدرةِ المُنتَهى، وإذا ورَقُها كَآذانِ الفيَلةِ، وإذا ثَمَرُها كالقِلالِ، قال: فلَمَّا غَشيَها مِن أمرِ اللهِ ما غَشيَ تَغَيَّرَت، فما أحَدٌ مِن خَلقِ اللهِ يَستَطيعُ أن يَنعَتَها مِن حُسنِها، فأوحى اللهُ إلَيَّ ما أوحى، ففَرَضَ عليَّ خَمسينَ صَلاةً في كُلِّ يَومٍ ولَيلةٍ، فنَزَلتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فقال: ما فرَضَ رَبُّك على أُمَّتِك؟ قُلتُ: خَمسينَ صَلاةً، قال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ؛ فإنَّ أُمَّتَك لا يُطيقونَ ذلك، فإنِّي قد بَلَوتُ بَني إسرائيلَ وخَبَرتُهم، قال: فرَجَعتُ إلى رَبِّي، فقُلتُ: يا رَبِّ، خَفِّفْ على أُمَّتي، فحَطَّ عَنِّي خَمسًا، فرَجَعتُ إلى موسى، فقُلتُ: حَطَّ عَنِّي خَمسًا، قال: إنَّ أُمَّتَك لا يُطيقونَ ذلك، فارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، قال: فلَم أزَلْ أرجِعُ بينَ رَبِّي تَبارَك وتَعالى وبينَ موسى عليه السَّلامُ، حتَّى قال: يا مُحَمَّدُ، ",["إنَّهنَّ خَمسُ صَلَواتٍ كُلَّ يَومٍ ولَيلةٍ",1],"، ",["لكُلِّ صَلاةٍ عَشرٌ، فذلك خَمسونَ صَلاةً",2],"، ومَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها كُتِبَت له حَسَنةً، فإن عَمِلَها كُتِبَت له عَشرًا، ومَن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها لَم تُكتَبْ شيئًا، فإن عَمِلَها كُتِبَت سَيِّئةً واحِدةً، قال: فنَزَلتُ حتَّى انتَهَيتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فأخبَرتُه، فقال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فقُلتُ: قد رَجَعتُ إلى رَبِّي حتَّى استَحيَيتُ منه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أبو محمد البغوي في ((شرح السنة)) (3753) بلفظه، والنسائي (450) بنحوه مطولا، وأبو يعلى (3375) مختصرا ببعض لفظه،","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"jwUaVu3q"},{"id":"س-02328","fp":"bd699b16024d","stateId":514,"easy":"إذا صليت أربعاً قبل الظهر ← تعدل أربعاً بعد العشاء، والأربع بعد العشاء كمثلهن من ليلة القدر","cause":"وأربَعٌ بَعدَ العِشاءِ كعَدلِهنَّ من ليلةِ القَدرِ","result":"أربَعٌ قَبلَ الظُّهرِ كعَدلِهنَّ بعدَ العِشاءِ","explicit":true,"ref":"فيض القدير 924","srcLabel":"فيض القدير","text":[["أربَعٌ قَبلَ الظُّهرِ كعَدلِهنَّ بعدَ العِشاءِ",2],"،",[" وأربَعٌ بَعدَ العِشاءِ كعَدلِهنَّ من ليلةِ القَدرِ.",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"رمز المصنف لحسنه وليس ذا منه بحسن","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"tIHdVHLN"},{"id":"س-06506","fp":"0fcb4852f3b8","stateId":514,"easy":"إذا صليت أربعاً قبل الظهر ← ففضلهن على صلاة النهار كفضل الجماعة على الفرد","cause":"أربَعًا قَبلَ الظُّهرِ","result":"وفَضلُهُنَّ على صَلاةِ النَّهارِ كفَضلِ صَلاةِ الجَماعةِ على صَلاةِ الوَحدةِ","explicit":true,"ref":"الترغيب والترهيب 1/274","srcLabel":"الطبراني","text":["قال عَبدُ اللهِ: ليس شَيءٌ يَعدِلُ صَلاةَ اللَّيلِ مِن صَلاةِ النَّهارِ إلَّا ",["أربَعًا قَبلَ الظُّهرِ",1],"، ",["وفَضلُهُنَّ على صَلاةِ النَّهارِ كفَضلِ صَلاةِ الجَماعةِ على صَلاةِ الوَحدةِ",2],"."],"grade":"حسن","narrator":"الأسود ومرة ومسروق","muhaddith":"لا بأس به","takhrij":"أخرجه الطبراني (9/ 287)، (9446) بلفظه، والطبري في ((تهذيب الآثار))- مسند عمر (1098) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"1X87MLEm"},{"id":"س-06725","fp":"0949db95d6e9","stateId":514,"easy":"إذا مشيت إلى صلاة تطوع ← فهي كعمرة","cause":"ومَن مَشَى إلى صلاةِ تَطَوُّعٍ","result":"فهي كعُمْرَةٍ","explicit":true,"ref":"صحيح الجامع 6556","srcLabel":"أبو داود","text":["مَن مَشَى إلى صلاةٍ مكتوبةٍ في الجماعةِ ، فهي كَحَجَّةٍ ، ",["ومَن مَشَى إلى صلاةِ تَطَوُّعٍ ، ",1],["فهي كعُمْرَةٍ",2]],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه أبو داود (558)، وأحمد (22304) بنحوه، والطبراني (8/149) (7578) واللفظ له.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"8jwOolUD"},{"id":"س-02105","fp":"f346170d352b","stateId":514,"easy":"إذا صليت ركعتي الضحى ← تجزئك عن صدقة مفاصلك الثلاثمائة والستين","cause":"فركعتَيِ الضُّحى","result":"على كلِّ مَفصِلٍ صدقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"time","t":"الضحى"},"repOf":"س-06383","ref":"تخريج صحيح ابن حبان 2540","text":["في الإنسانِ ثلاثُمئةٍ وستُّون مَفصِلًا ",["على كلِّ مَفصِلٍ صدقةٌ",2]," ) قالوا: يا رسولَ اللهِ فمَن يُطيقُ ذلك ؟ قال: ( تُنحِّي الأذى وإلَّا ",["فركعتَيِ الضُّحى",1]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"إسناده قوي على شرط مسلم","takhrij":"أخرجه ابن حبان (1642) واللفظ له، وأبو داود (5242)، وأحمد (22998)، والبزار (4417)، وابن خزيمة (1226) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"MxB2yOb4"},{"id":"س-00769","fp":"e1cdac45dbec","stateId":514,"easy":"إذا صليت ركعتي الضحى ← تجزئك عن صدقة كل مفاصلك","cause":"رَكعتا الضُّحى","result":"يجزئُ أحدَكم من ذلِك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"الضحى"},"repOf":"س-06383","ref":"صحيح أبي داود 1286","text":["أبو ذرٍّ قالَ :يصبحُ علَى كلِّ سلامى من أحدِكم في كلِّ يومٍ صدقةٌ فلَه بِكلِّ صلاةٍ صدقةٌ وصيامٍ صدقةٌ وحجٍّ صدقةٌ وتسبيحٍ صدقةٌ وتَكبيرٍ صدقةٌ وتحميدٍ صدقةٌ فعدَّ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ من هذِه الأعمالِ الصَّالحةِ ثمَّ قالَ ",["يجزئُ أحدَكم من ذلِك",2]," ",["رَكعتا الضُّحى",1]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1286)","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"hD07WDSk"},{"id":"س-03881","fp":"74139e3cb501","stateId":514,"easy":"إذا أوترت ← فهو أحب من حمر النعم (أثر ابن عمر)","cause":"الوَتْرَ","result":"ما أحبُّ أَنِّي تركْتُ الوَتْرَ و أنَّ لِي حُمُرَ النَّعَمِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"عمدة القاري 7/16","srcLabel":"عمدة القاري","text":["عن ابنِ عمرَ ",["ما أحبُّ أَنِّي تركْتُ الوَتْرَ و أنَّ لِي حُمُرَ النَّعَمِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"tdSBIRr2"},{"id":"س-03875","fp":"cdb25b6ffe72","stateId":514,"easy":"إذا صليت صلاة الهجير (قبل الظهر) ← فهي مثل صلاة الليل","cause":"صلاةُ الهَجيرِ","result":"مثلُ صلاةِ اللَّيل","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"مجمع الزوائد 2/224","srcLabel":"الطبراني","text":[["صلاةُ الهَجيرِ",1]," ",["مثلُ صلاةِ اللَّيل",2]," فسألتُ عبدَ الرَّحمنِ بنَ حميدٍ عنِ الهجيرِ فقالَ إذا زالتِ الشَّمسُ"],"grade":"حسن","narrator":"[عبد الرحمن بن عوف]","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1/ 134) (282)، والدارقطني في ((الأفراد)) (534) واللفظ لهما.","bab":"تراويح وتهجد وقيام ليل › فضل قيام الليل","dorar":"Q5ailzTq"},{"id":"س-01902","fp":"d1fd767d3c9a","stateId":514,"easy":"إذا صليت ركعتين خفيفتين ← فهما أحب إلى الميت من بقية دنياكم","cause":"ركعتانِ خفيفتانَ مما تحقرونَ وتنفلونَ","result":"أحبُّ إليهِ من بقيَّةِ دُنياكُم","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"السلسلة الصحيحة 1388","srcLabel":"الطبراني","text":[["ركعتانِ خفيفتانَ مما تحقرونَ وتنفلونَ",1]," يزيدهُما هذا - يشيرُ إلى قبرٍ - في عملهِ ",["أحبُّ إليهِ من بقيَّةِ دُنياكُم",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه ابن المبارك في ((الزهد)) (31) واللفظ له، وابن أبي شيبة في ((المصنف)) (7715) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (920) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iW0PHTwb"},{"id":"س-01978","fp":"39f8b4d17bc7","stateId":514,"easy":"إذا صليت ركعتي الضحى ← تجزئك عن صدقات مفاصلك","cause":"فرَكْعتا الضُّحى","result":"تُجزِئُكَ","explicit":true,"apply":{"k":"time","t":"الضحى"},"ref":"تخريج المسند لشعيب 23037","srcLabel":"أبو داود","text":["في الإنسانِ ثلاثُ مِئَةٍ وسِتُّونَ مَفصِلًا، فعليه أنْ يَتَصدَّقَ عن كُلِّ مَفصِلٍ في كُلِّ يَومٍ بصَدَقةٍ، قالوا: ومَن يُطيقُ ذلك يا رسولَ اللهِ؟ قال: النُّخاعةُ تَراها في المَسجِدِ فتَدفِنُها، أو الشَّيءُ تُنحِّيهِ عن الطَّريقِ، فإنْ لم تَقدِرْ ",["فرَكْعتا الضُّحى",1]," ",["تُجزِئُكَ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5242)، وأحمد (23037) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZTjF1XZT","merged":2,"otherRefs":["هداية الرواة 1266 (صحيح)"]},{"id":"س-07601","fp":"e1e0d4ffe735","stateId":515,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من ألف صلاة فيما سواه إلا المسجد الحرام","cause":"صلاةٌ في مسجِدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم","result":"أفضَلُ مِن ألفِ صلاةٍ فيما سواه مِن المساجِدِ إلَّا المسجِدَ الحرامَ","explicit":true,"star":true,"similar":["س-08411","س-02201"],"otherNeedIds":[45],"ref":"تخريج صحيح ابن حبان 1621","srcLabel":"متفق عليه","text":[["صلاةٌ في مسجِدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم",1]," ",["أفضَلُ مِن ألفِ صلاةٍ فيما سواه مِن المساجِدِ إلَّا المسجِدَ الحرامَ",2]," فإنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم آخِرُ الأنبياءِ وإنَّ مسجِدَه آخِرُ المساجِدِ. قال أبو سلَمةَ وأبو عبدِ اللهِ لَمْ نشُكَّ أنَّ أبا هُرَيْرَةَ كان يقولُ عن حديثِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فمنَعَنا ذلكَ أنْ نستثبِتَ أبا هُرَيْرَةَ عن ذلكَ الحديثِ حتَّى إذا تُوفِّي أبو هُرَيْرَةَ تذاكَرْنا ذلكَ وتلاوَمْنا ألَّا نكونَ كلَّمْنا أبا هُرَيْرَةَ في ذلكَ حتَّى يُسنِدَه إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم إنْ كان سمِعه منه فبَيْنَا نحنُ على ذلكَ إذ جالَسْنا عبدَ اللهِ بنَ إبراهيمَ بنِ قارظٍ فذكَرْنا ذلكَ الحديثَ والَّذي فرَّطْنا فيه مِن نصِّ أبي هُرَيْرَةَ فيه فقال لنا عبدُ اللهِ بنُ إبراهيمَ بنِ قارظٍ أشهَدُ أنِّي سمِعْتُ أبا هُرَيْرَةَ يقولُ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: \"فإنِّي آخِرُ الأنبياءِ وإنَّه آخِرُ المساجِدِ\""],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (1190) دون قوله: \"فإن رسول الله صلى الله عليه وسلم آخر الأنبياء ...\"، ومسلم (1394)","bab":"فضائل النبي وصفته ودلائل النبوة › ما اختص به النبي على الأنبياء عليهم الصلاة والسلام","dorar":"LPPMmrbE","merged":8,"otherRefs":["الفروع لابن مفلح 2/ 455 (حسن)","تخريج المسند لشعيب 10299 (صحيح)","تخريج سير أعلام النبلاء 9/230 (صحيح)","تخريج المسند لشعيب 9154 (صحيح)","الترغيب والترهيب 2/205 (صحيح)","مجمع الزوائد 9-4 (صحيح)","الجامع الصغير 5850 (صحيح)"]},{"id":"س-08411","fp":"0ab20eadfc1b","stateId":515,"easy":"إذا صليت في المسجد النبوي ← فهي أفضل من ألف صلاة في غيره إلا المسجد الحرام","cause":"لَصَلاةٌ في هذا المَسجِدِ","result":"أفضَلُ -يَعْني- من أَلْفِ صَلاةٍ في غَيرِه، إلَّا المَسجِدَ الحَرامَ","explicit":true,"repOf":"س-07601","ref":"تخريج المسند لشعيب 11734","text":["[وَدَّع رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ رجُلًا فقال له: أينَ تُريدُ؟ قال: أُريدُ بيتَ المَقدِسِ، فقال له النبيُّ صلَّى اللهُ عليه وسلَّمَ:] ",["لَصَلاةٌ في هذا المَسجِدِ",1]," ",["أفضَلُ -يَعْني- من أَلْفِ صَلاةٍ في غَيرِه، إلَّا المَسجِدَ الحَرامَ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (11734) واللفظ له، وأبو يعلى (1165)، وابن حبان (1624) باختلاف يسير","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"BDx9tiYv"},{"id":"س-08444","fp":"d33794bfe8f2","stateId":515,"easy":"إذا صليت في المسجد الحرام ← فهي أفضل من صلاة في المسجد النبوي بمئة مرة","cause":"و صلاةٌ في المسْجِدِ الحرامِ","result":"أفضلُ من صلاةٍ في مَسْجِدِي هذا بِمِائةِ مَرَّةً","explicit":true,"otherNeedIds":[45],"ref":"صحيح الجامع 3841","srcLabel":"أحمد","text":["صلاةٌ في مسجِدِي هذا أفْضَلُ من ألْفِ صلاةٍ فِيما سِواهُ من المساجِدِ إلا المسْجِدَ الحرامَ ، ",["و صلاةٌ في المسْجِدِ الحرامِ",1]," ",["أفضلُ من صلاةٍ في مَسْجِدِي هذا بِمِائةِ مَرَّةً",2]],"grade":"صحيح","narrator":"عبدالله بن الزبير","muhaddith":"صحيح","takhrij":"أخرجه أحمد (16117)، وابن حبان (1620)، والبيهقي (10577) باختلاف يسير","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"HF0jsBbn","merged":5,"otherRefs":["المصابيح في الأحاديث المتواترة 610 (صحيح)","الترغيب والترهيب 2/205 (صحيح)","مجموع الشروح الفقهية. 388/3 (صحيح)","الجامع الصغير 5850 (صحيح)"]},{"id":"س-01475","fp":"5817c08b4527","stateId":515,"easy":"إذا تطهرت في بيتك ثم أتيت مسجد قباء لا تريد إلا الصلاة ← فهي كعمرة","cause":"من تطَهَّرَ في بيتِهِ ثمَّ أتى إلى مسجدَ قباءَ لا يريدُ إلَّا الصَّلاةَ فيهِ","result":"كانَ كعُمرةٍ","explicit":true,"ref":"الزيارة الشرعية والبدعية 11","srcLabel":"الزيارة الشرعية والبدعية","text":[["من تطَهَّرَ في بيتِهِ ثمَّ أتى إلى مسجدَ قباءَ لا يريدُ إلَّا الصَّلاةَ فيهِ",1]," ",["كانَ كعُمرةٍ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"وضوء › فضل الوضوء","dorar":"CgwTk4rM","merged":3,"otherRefs":["الفوائد العلمية من الدروس البازية 5/126 (حسن)","الأحاديث المختارة 1472 (صحيح)"]},{"id":"س-01384","fp":"286264d64382","stateId":515,"easy":"إذا أحسنت الوضوء ثم صليت في مسجد قباء أربع ركعات ← تعدل رقبة","cause":"من توضَّأ فأحسن الوضوءَ ثمَّ دخل مسجدَ قُباءَ فيركعُ فيه أربعَ ركعاتٍ","result":"كان ذلك عدْلَ رقبةٍ","explicit":true,"apply":{"k":"count","t":"أربع ركعات · الوقت: بعد الوضوء"},"ref":"الترغيب والترهيب 2/207","srcLabel":"الطبراني","text":[["من توضَّأ فأحسن الوضوءَ ثمَّ دخل مسجدَ قُباءَ فيركعُ فيه أربعَ ركعاتٍ",1]," ",["كان ذلك عدْلَ رقبةٍ",2]],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (5560) (6/75) باختلاف يسير","bab":"وضوء › إسباغ الوضوء","dorar":"Vv9HgbT9"},{"id":"س-02201","fp":"f7d0b1b36ca2","stateId":515,"easy":"إذا صليت الجمعة في المسجد النبوي ← فهي أفضل من ألف جمعة فيما سواه إلا المسجد الحرام","cause":"والجمعةُ في مسجدي هذا","result":"أفضلُ من ألفِ جمعةٍ فيما سواه إلَّا المسجدَ الحرامَ","explicit":true,"repOf":"س-07601","ref":"الترغيب والترهيب 2/207","text":["الصَّلاةُ في مسجدي هذا أفضلُ من ألفِ صلاةٍ فيما سواه إلَّا المسجدَ الحرامَ ",["والجمعةُ في مسجدي هذا",1]," ",["أفضلُ من ألفِ جمعةٍ فيما سواه إلَّا المسجدَ الحرامَ",2]," وشهرُ رمضانَ في مسجدي هذا أفضلُ من ألفِ شهرِ رمضانَ فيما سواه إلَّا المسجدَ الحرامَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4147)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QV9x0Mtn"},{"id":"س-06512","fp":"6e75ea6a6e7b","stateId":515,"easy":"إذا صليت في مسجد قباء ← فهي كعمرة","cause":"الصَّلاةُ فيه","result":"كعُمرَةٍ","explicit":true,"similar":["س-08412"],"ref":"شرح فتح القدير 3/173","srcLabel":"شرح فتح القدير","text":[["الصَّلاةُ فيه",1]," ",["كعُمرَةٍ",2],". [يعني: مسجِدَ قُباءٍ]."],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"uarlVHkM"},{"id":"س-06516","fp":"930ea26cc122","stateId":515,"easy":"إذا صليت في مسجد القبائل ← فبخمس وعشرين، وفي الجامع بخمسمئة","cause":"وصلاتُه في مسجدِ القبائِلِ","result":"بخمسٍ وعشرينَ صلاةً وصلاتُهُ في المسجدِ الذي يُجَمِّعُ فيه بخمسمئةِ صلاةٍ وصلاتُه في المسجدِ الأقصى بخمسين ألف صلاةٍ وصلاتُهُ في مسجدي هذا بخمسينَ ألفِ صلاةٍ وصلاتُهُ في المسجدِ الحرامِ بمئةِ ألفِ صلاةٍ","explicit":true,"ref":"الجامع الصغير 5062","srcLabel":"ابن ماجه","text":["صلاةُ الرجلِ في بيتِه بصلاةٍ ",["وصلاتُه في مسجدِ القبائِلِ",1]," ",["بخمسٍ وعشرينَ صلاةً وصلاتُهُ في المسجدِ الذي يُجَمِّعُ فيه بخمسمئةِ صلاةٍ وصلاتُه في المسجدِ الأقصى بخمسين ألف صلاةٍ وصلاتُهُ في مسجدي هذا بخمسينَ ألفِ صلاةٍ وصلاتُهُ في المسجدِ الحرامِ بمئةِ ألفِ صلاةٍ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1413)، وابن عدي في ((الكامل في الضعفاء)) (8/ 35)، وابن الجوزي في ((العلل المتناهية)) (946) جميعا بلفظه، والطبراني في ((المعجم الأوسط)) (7008) باختلاف يسير .","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"s8mHJsni"},{"id":"س-06586","fp":"323d48f6d660","stateId":515,"easy":"إذا صليت في المسجد الأقصى ← تعدل خمسمئة صلاة","cause":"إنَّ الصَّلاةَ فيه","result":"تَعْدِلُ خَمسَمِائَةِ صلاةٍ","explicit":true,"ref":"كشف الخفاء 2/566","srcLabel":"كشف الخفاء","text":[["إنَّ الصَّلاةَ فيه ",1],["تَعْدِلُ خَمسَمِائَةِ صلاةٍ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"zupaAL16"},{"id":"س-08407","fp":"8c83e8975008","stateId":515,"easy":"إذا صليت في بيت المقدس (أرض المحشر) ← فصلاة فيه كألف صلاة في غيره","cause":"أرضُ المحشَرِ والمنشَرِ ائتوهُ فصلُّوا فيهِ","result":"فإنَّ صلاةً فيهِ كألفِ صلاةٍ في غيرِهِ","explicit":true,"ref":"الصحيح المسند 1643","srcLabel":"أبو داود","text":["يا رسولَ اللَّهِ أفتِنا في بيتِ المقدسِ ؟ قالَ : ",["أرضُ المحشَرِ والمنشَرِ ائتوهُ فصلُّوا فيهِ ",1],["فإنَّ صلاةً فيهِ كألفِ صلاةٍ في غيرِهِ",2]," قلتُ أرأيتَ إن لم أستطع أن أتحمَّلَ إليهِ قالَ فتُهْدي لَه زيتًا يُسرَجُ فيهِ فمن فعلَ ذلِكَ فَهوَ كَمن أتاهُ ."],"grade":"صحيح","narrator":"ميمونة مولاة النبي صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (457)، وابن ماجه (1407)، وابن أبي عاصم في ((الآحاد والمثاني)) (3448) واللفظ لهم.","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"xPdZykW4"},{"id":"س-08409","fp":"0c0331483c49","stateId":515,"easy":"إذا صليت في مكة ← فهي خير من ألف صلاة","cause":"فالصلاةُ هاهنا وأوْمَأَ إلى مكةَ","result":"خيرٌ من ألفِ صلاةٍ","explicit":true,"ref":"السلسلة الصحيحة 6/952","srcLabel":"أحمد","text":["وَدَّعَ رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ رجلًا فقال لهُ أينَ تُريدُ قال أُريدُ بيتَ المقدِسِ فقال لهُ النبيُّ صلَّى اللهُ عليهِ وسلَّمَ ",["فالصلاةُ هاهنا وأوْمَأَ إلى مكةَ",1]," ",["خيرٌ من ألفِ صلاةٍ",2]," وأومَأَ بيدِهِ إلى الشامِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (11734)  بلفظ مقارب، وأبو يعلى (1165)، وابن حبان (1623) وعندهما: ((أفضل من مائة)).","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"0VN9TgUV"},{"id":"س-08412","fp":"62f2a801e778","stateId":515,"easy":"إذا أتيت مسجد قباء فصليت فيه ← فهي كعدل عمرة","cause":"مَن خرَجَ حتَّى يأْتيَ هذا المَسجِدَ -يَعني مَسجِدَ قُباءَ- فيُصلِّي فيه","result":"كان كعَدْلِ عُمْرةٍ","explicit":true,"repOf":"س-06512","ref":"المستدرك على الصحيحين 4331","text":["«",["مَن خرَجَ حتَّى يأْتيَ هذا المَسجِدَ -يَعني مَسجِدَ قُباءَ- فيُصلِّي فيه ",1],["كان كعَدْلِ عُمْرةٍ»",2],"."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح الإسناد","takhrij":"أخرجه النسائي (699)، وأحمد (15981) بلفظه.","bab":"مناقب وفضائل › فضائل أماكن متعددة من الأرض وما ورد ذمه","dorar":"UfM5Bq7a"},{"id":"س-01889","fp":"0d223656e8e6","stateId":515,"easy":"إذا أتيت مسجد قباء فصليت فيه ← فلك عدل عمرة","cause":"من خرجَ حتَّى يأتيَ هذا المسجدَ - مسجدَ قباءَ - فصلَّى فيهِ","result":"كانَ لَهُ عدلَ عُمرَةٍ","explicit":true,"ref":"صحيح النسائي 698","srcLabel":"النسائي","text":[["من خرجَ حتَّى يأتيَ هذا المسجدَ - مسجدَ قباءَ - فصلَّى فيهِ ، ",1],["كانَ لَهُ عدلَ عُمرَةٍ",2]],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"صحيح","takhrij":"أخرجه النسائي (699)، وأحمد (15981)، والحاكم (4279) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"amjGl6oK","merged":2,"otherRefs":["تخريج الإحياء للعراقي 1/347 (صحيح)"]},{"id":"س-06716","fp":"e836902b6e51","stateId":516,"easy":"إذا صليت العشاء في جماعة ← فهو كقيام نصف ليلة","cause":"من صلَّى العشاءَ في جماعةٍ","result":"فَهوَ كقيامِ نِصفِ ليلةٍ","explicit":true,"star":true,"similar":["س-00496","س-06715","س-06708"],"ref":"تخريج المسند لشاكر 1/202","srcLabel":"مسلم","text":["مَن صلَّى صلاةَ العشاءِ والصُّبحِ في جماعةٍ فَهوَ كقيامِ ليلةٍ ، وقالَ عبدُ الرَّحمنِ : ",["من صلَّى العشاءَ في جماعةٍ ",1],["فَهوَ كقيامِ نِصفِ ليلةٍ ",2],"ومن صلَّى الصُّبحَ في جماعةٍ فَهوَ كَقيامِ ليلةٍ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (656)، وأبو داود (555)، والترمذي (221)، وأحمد (408) واللفظ له","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"Y2e588Hy","merged":3,"otherRefs":["صحيح الترمذي 221 (صحيح)","صحيح الترغيب 415 (صحيح)"]},{"id":"س-00496","fp":"b1fc4c00d32c","stateId":516,"easy":"إذا شهدت العشاء في جماعة ← فلك قيام نصف ليلة","cause":"مَن شَهِدَ العشاءَ في جَماعةٍ","result":"كانَ لَهُ قيامُ نِصفِ ليلَةٍ","explicit":true,"repOf":"س-06716","ref":"صحيح الترمذي 221","text":[["مَن شَهِدَ العشاءَ في جَماعةٍ ",1],["كانَ لَهُ قيامُ نِصفِ ليلَةٍ ، ",2],"ومَن صلَّى العشاءَ والفَجرَ في جماعةٍ كانَ لَهُ كقيامِ ليلةٍ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه مسلم (656)، وأبو داود (555)، والترمذي (221) واللفظ له، وأحمد (408)","bab":"آداب عامة › ضرب الأمثال","dorar":"W2Ddwzd5","merged":2,"otherRefs":["النفح الشذي 4/197 (صحيح)"]},{"id":"س-06715","fp":"f08113270295","stateId":516,"easy":"إذا صليت العشاء والصبح في جماعة ← فهو كقيام ليلة","cause":"مَن صلَّى صلاةَ العشاءِ والصُّبحِ في جماعةٍ","result":"فَهوَ كقيامِ ليلةٍ","explicit":true,"repOf":"س-06716","ref":"تخريج المسند لشاكر 1/202","text":[["مَن صلَّى صلاةَ العشاءِ والصُّبحِ في جماعةٍ ",1],["فَهوَ كقيامِ ليلةٍ ",2],"، وقالَ عبدُ الرَّحمنِ : من صلَّى العشاءَ في جماعةٍ فَهوَ كقيامِ نِصفِ ليلةٍ ومن صلَّى الصُّبحَ في جماعةٍ فَهوَ كَقيامِ ليلةٍ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (656)، وأبو داود (555)، والترمذي (221)، وأحمد (408) واللفظ له","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"Y2e588Hy"},{"id":"س-06717","fp":"ca589d279589","stateId":516,"easy":"إذا صليت الصبح في جماعة ← فهو كقيام ليلة","cause":"ومن صلَّى الصُّبحَ في جماعةٍ","result":"فَهوَ كَقيامِ ليلةٍ","explicit":true,"ref":"تخريج المسند لشاكر 1/202","srcLabel":"مسلم","text":["مَن صلَّى صلاةَ العشاءِ والصُّبحِ في جماعةٍ فَهوَ كقيامِ ليلةٍ ، وقالَ عبدُ الرَّحمنِ : من صلَّى العشاءَ في جماعةٍ فَهوَ كقيامِ نِصفِ ليلةٍ ",["ومن صلَّى الصُّبحَ في جماعةٍ ",1],["فَهوَ كَقيامِ ليلةٍ",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (656)، وأبو داود (555)، والترمذي (221)، وأحمد (408) واللفظ له","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"Y2e588Hy"},{"id":"س-06540","fp":"a935f4cf3a9e","stateId":516,"easy":"إذا صليت العشاء في جماعة في رمضان ← فقد أدركت ليلة القدر (من حظها)","cause":"مَن صلَّى العشاءَ الآخرةَ في جماعةٍ في رمضانَ","result":"فقد أدرَكَ ليلةَ القدرِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"صحيح ابن خزيمة 3/ 580","srcLabel":"البيهقي","text":[["مَن صلَّى العشاءَ الآخرةَ في جماعةٍ في رمضانَ",1]," ",["فقد أدرَكَ ليلةَ القدرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البيهقي في ((الشعب)) (3432) واللفظ له.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"jlBZBFgW","merged":2,"otherRefs":["الجامع الصغير 8777 (حسن)"]},{"id":"س-06708","fp":"35ecee335f39","stateId":516,"easy":"إذا صليت العشاء في جماعة ← فكأنما قمت نصف الليل","cause":"مَن صَلَّى العِشاءَ في جَماعةٍ","result":"فكَأنَّما قامَ نِصفَ اللَّيلِ","explicit":true,"repOf":"س-06716","ref":"صحيح مسلم 656","text":["دَخَلَ عُثمانُ بنُ عَفَّانَ المَسجِدَ بَعدَ صَلاةِ المَغرِبِ، فقَعَدَ وحدَه، فقَعَدتُ إليه فقال: يا ابنَ أخي، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن صَلَّى العِشاءَ في جَماعةٍ ",1],["فكَأنَّما قامَ نِصفَ اللَّيلِ، ",2],"ومَن صَلَّى الصُّبحَ في جَماعةٍ فكَأنَّما صَلَّى اللَّيلَ كُلَّه."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (2060) بهذا اللفظ ولكن قال: \"وقعدت\" بدل\"فقعدت\"  وأبو داود (555) والترمذي (221) مختصرا","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"hO9SfyTe","merged":2,"otherRefs":["تخريج صحيح ابن حبان 2058 (صحيح)"]},{"id":"س-06649","fp":"0a8f4ec5292a","stateId":516,"easy":"إذا صليت الفجر في جماعة ← تعدل قيام نصف ليلة","cause":"وصَلاةُ الفجرِ في جَماعةٍ","result":"تَعدِلُ قيامَ نِصفِ لَيلةٍ","explicit":true,"ref":"النفح الشذي 4/197","srcLabel":"ابن عبد","text":["صَلاةُ العِشاءِ في جَماعةٍ تَعدِلُ قيامَ لَيلةٍ، ",["وصَلاةُ الفجرِ في جَماعةٍ",1]," ",["تَعدِلُ قيامَ نِصفِ لَيلةٍ",2],"."],"grade":"صحيح","narrator":"عثمان","muhaddith":"[ثابت]","takhrij":"أخرجه ابن عبد البر في ((التمهيد)) (23/ 354) بلفظه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"aLRS2bmc"},{"id":"س-06709","fp":"a01cb0f454a8","stateId":516,"easy":"إذا صليت الصبح في جماعة ← فكأنما صليت الليل كله","cause":"ومَن صَلَّى الصُّبحَ في جَماعةٍ","result":"فكَأنَّما صَلَّى اللَّيلَ كُلَّه","explicit":true,"ref":"صحيح مسلم 656","srcLabel":"أبو داود","text":["دَخَلَ عُثمانُ بنُ عَفَّانَ المَسجِدَ بَعدَ صَلاةِ المَغرِبِ، فقَعَدَ وحدَه، فقَعَدتُ إليه فقال: يا ابنَ أخي، سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: مَن صَلَّى العِشاءَ في جَماعةٍ فكَأنَّما قامَ نِصفَ اللَّيلِ، ",["ومَن صَلَّى الصُّبحَ في جَماعةٍ ",1],["فكَأنَّما صَلَّى اللَّيلَ كُلَّه",2],"."],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"[صحيح]","takhrij":"أخرجه ابن حبان (2060) بهذا اللفظ ولكن قال: \"وقعدت\" بدل\"فقعدت\"  وأبو داود (555) والترمذي (221) مختصرا","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"hO9SfyTe"},{"id":"س-08200","fp":"e40fae201b8f","stateId":517,"easy":"إذا اغتسلت يوم الجمعة ثم رحت في الساعة الأولى ← فكأنما قرّبت بدنة","cause":"مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ","result":"فكَأنَّما قَرَّبَ بَدَنةً","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"ref":"صحيح البخاري 881","srcLabel":"متفق عليه","text":[["مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ، ",1],["فكَأنَّما قَرَّبَ بَدَنةً، ",2],"ومَن راحَ في السَّاعةِ الثَّانيةِ فكَأنَّما قَرَّبَ بَقَرةً، ومَن راحَ في السَّاعةِ الثَّالِثةِ فكَأنَّما قَرَّبَ كَبشًا أقرَنَ، ومَن راحَ في السَّاعةِ الرَّابِعةِ فكَأنَّما قَرَّبَ دَجاجةً، ومَن راحَ في السَّاعةِ الخامِسةِ فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (881)، ومسلم (850)","bab":"ملائكة › أعمال الملائكة","dorar":"7lDSmKFE"},{"id":"س-08201","fp":"fa73d25e5685","stateId":517,"easy":"إذا رحت في الساعة الثانية ← فكأنما قرّبت بقرة","cause":"ومَن راحَ في السَّاعةِ الثَّانيةِ","result":"فكَأنَّما قَرَّبَ بَقَرةً","explicit":true,"similar":["س-08202","س-08203","س-08204"],"ref":"صحيح البخاري 881","srcLabel":"متفق عليه","text":["مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ، فكَأنَّما قَرَّبَ بَدَنةً، ",["ومَن راحَ في السَّاعةِ الثَّانيةِ ",1],["فكَأنَّما قَرَّبَ بَقَرةً، ",2],"ومَن راحَ في السَّاعةِ الثَّالِثةِ فكَأنَّما قَرَّبَ كَبشًا أقرَنَ، ومَن راحَ في السَّاعةِ الرَّابِعةِ فكَأنَّما قَرَّبَ دَجاجةً، ومَن راحَ في السَّاعةِ الخامِسةِ فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (881)، ومسلم (850)","bab":"ملائكة › أعمال الملائكة","dorar":"7lDSmKFE"},{"id":"س-08202","fp":"59972410067c","stateId":517,"easy":"إذا رحت في الساعة الثالثة ← فكأنما قرّبت كبشاً أقرن","cause":"ومَن راحَ في السَّاعةِ الثَّالِثةِ","result":"فكَأنَّما قَرَّبَ كَبشًا أقرَنَ","explicit":true,"repOf":"س-08201","ref":"صحيح البخاري 881","text":["مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ، فكَأنَّما قَرَّبَ بَدَنةً، ومَن راحَ في السَّاعةِ الثَّانيةِ فكَأنَّما قَرَّبَ بَقَرةً، ",["ومَن راحَ في السَّاعةِ الثَّالِثةِ ",1],["فكَأنَّما قَرَّبَ كَبشًا أقرَنَ، ",2],"ومَن راحَ في السَّاعةِ الرَّابِعةِ فكَأنَّما قَرَّبَ دَجاجةً، ومَن راحَ في السَّاعةِ الخامِسةِ فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (881)، ومسلم (850)","bab":"ملائكة › أعمال الملائكة","dorar":"7lDSmKFE"},{"id":"س-08203","fp":"0111b912fa97","stateId":517,"easy":"إذا رحت في الساعة الرابعة ← فكأنما قرّبت دجاجة","cause":"ومَن راحَ في السَّاعةِ الرَّابِعةِ","result":"فكَأنَّما قَرَّبَ دَجاجةً","explicit":true,"repOf":"س-08201","ref":"صحيح البخاري 881","text":["مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ، فكَأنَّما قَرَّبَ بَدَنةً، ومَن راحَ في السَّاعةِ الثَّانيةِ فكَأنَّما قَرَّبَ بَقَرةً، ومَن راحَ في السَّاعةِ الثَّالِثةِ فكَأنَّما قَرَّبَ كَبشًا أقرَنَ، ",["ومَن راحَ في السَّاعةِ الرَّابِعةِ ",1],["فكَأنَّما قَرَّبَ دَجاجةً، ",2],"ومَن راحَ في السَّاعةِ الخامِسةِ فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (881)، ومسلم (850)","bab":"ملائكة › أعمال الملائكة","dorar":"7lDSmKFE"},{"id":"س-08204","fp":"c59c6844c517","stateId":517,"easy":"إذا رحت في الساعة الخامسة ← فكأنما قرّبت بيضة","cause":"ومَن راحَ في السَّاعةِ الخامِسةِ","result":"فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ","explicit":true,"repOf":"س-08201","ref":"صحيح البخاري 881","text":["مَنِ اغتَسَلَ يَومَ الجُمُعةِ غُسلَ الجَنابةِ ثُمَّ راحَ، فكَأنَّما قَرَّبَ بَدَنةً، ومَن راحَ في السَّاعةِ الثَّانيةِ فكَأنَّما قَرَّبَ بَقَرةً، ومَن راحَ في السَّاعةِ الثَّالِثةِ فكَأنَّما قَرَّبَ كَبشًا أقرَنَ، ومَن راحَ في السَّاعةِ الرَّابِعةِ فكَأنَّما قَرَّبَ دَجاجةً، ",["ومَن راحَ في السَّاعةِ الخامِسةِ ",1],["فكَأنَّما قَرَّبَ بَيضةً، فإذا خَرَجَ الإمامُ حَضَرَتِ المَلائِكةُ يَستَمِعونَ الذِّكرَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (881)، ومسلم (850)","bab":"ملائكة › أعمال الملائكة","dorar":"7lDSmKFE"},{"id":"س-00569","fp":"2c675257a9cc","stateId":517,"easy":"إذا هجّرت إلى الصلاة ← فكأنما أهديت بدنة","cause":"المُهَجِّرِ إلى الصَّلاةِ","result":"كمَثلِ الَّذي يُهْدي بَدنةً، ثمَّ الَّذي على إثرِهِ كمَثلِ الَّذي يُهْدي بقَرةً، ثمَّ الَّذي علَى إثرِهِ كالَّذي يُهْدي الكَبشَ، ثمَّ الَّذي على إثرِهِ كالَّذي يُهْدي دَجاجَةً، ثمَّ الَّذي على إثرِهِ كالَّذي يُهْدي البَيضةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"نخب الافكار 12/554","srcLabel":"الطحاوي","text":["سَمِعْتُ رَسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: مَثلُ ",["المُهَجِّرِ إلى الصَّلاةِ",1]," ",["كمَثلِ الَّذي يُهْدي بَدنةً، ثمَّ الَّذي على إثرِهِ كمَثلِ الَّذي يُهْدي بقَرةً، ثمَّ الَّذي علَى إثرِهِ كالَّذي يُهْدي الكَبشَ، ثمَّ الَّذي على إثرِهِ كالَّذي يُهْدي دَجاجَةً، ثمَّ الَّذي على إثرِهِ كالَّذي يُهْدي البَيضةَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح معاني الآثار)) (6245) واللفظ له.","bab":"آداب عامة › ضرب الأمثال","dorar":"Qyx904SG"},{"id":"س-00100","fp":"bda816777dcc","stateId":518,"easy":"إذا صليت ثم قعدت في مصلاك تنتظر الصلاة ← فأنت في صلاة","cause":"إذا صلَّى ثُمَّ قَعَدَ في مُصَلَّاه لا يَحبِسُه إلَّا انْتِظارُ الصَّلاةِ","result":"إنَّ العَبْدَ المُسلِمَ في صَلاةٍ","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 444","srcLabel":"متفق عليه","text":["«قُلْتُ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ جالِسٌ: إنَّا نَجِدُ في كِتابِ اللهِ في يَوْمِ الجُمُعةِ ساعةً لا يُوافِقُها عَبْدٌ مُسلِمٌ وهو في الصَّلاةِ فيَسأَلُ اللهَ عَزَّ وجَلَّ شَيئًا إلَّا أَعْطاه ما سَأَلَه، فأَشارَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: بعضُ ساعةٍ قالَ: فقُلْتُ: صَدَقَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالَ أبو النَّضْرِ: قالَ أبو سَلَمةَ: سَألْتُه أيَّةُ ساعةٍ هي؟ قالَ: آخِرُ ساعاتِ النَّهارِ، فقُلْتُ: إنَّها ليست ساعةَ صَلاةٍ، فقالَ: بَلى، ",["إنَّ العَبْدَ المُسلِمَ في صَلاةٍ",2]," ",["إذا صلَّى ثُمَّ قَعَدَ في مُصَلَّاه لا يَحبِسُه إلَّا انْتِظارُ الصَّلاةِ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن سلام","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب الدعاء › استجابة الدعاء","dorar":"kxaFk5PB"},{"id":"س-06647","fp":"4a4644934e5f","stateId":518,"easy":"إذا صليت في جماعة ← تعدل خمساً وعشرين صلاة فرد","cause":"صَلاةُ الجَماعةِ","result":"تَعدِلُ خَمسةً وعِشرينَ صَلاةً مِن صَلاةِ الفذِّ","explicit":true,"star":true,"similar":["س-02218"],"ref":"النفح الشذي 4/165","srcLabel":"متفق عليه","text":[["صَلاةُ الجَماعةِ ",1],["تَعدِلُ خَمسةً وعِشرينَ صَلاةً مِن صَلاةِ الفذِّ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه السراج في ((المسند)) (1191) بلفظه، والبخاري (477)، ومسلم (649) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"drHE8zOG"},{"id":"س-01505","fp":"8eb89cc0b74b","stateId":518,"easy":"إذا سمعت المؤذن فقلت مثل ما يقول ← فلك مثل أجره","cause":"مَن سَمِعَ المؤذِّنَ فقالَ مثلَ ما يقولُ","result":"فلَه مثلُ أجرِهِ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[45],"ref":"الجامع الصغير 8739","srcLabel":"البخاري","text":[["مَن سَمِعَ المؤذِّنَ فقالَ مثلَ ما يقولُ، ",1],["فلَه مثلُ أجرِهِ",2]],"grade":"حسن","narrator":"معاوية بن أبي سفيان","muhaddith":"حسن","takhrij":"أخرجه الطبراني (802) (19/ 346) واللفظ له، وأحمد (16922) دزن قوله:\"فله مثل أجره\"، وأصل الحديث في البخاري (914) في ترديد النبي صلى الله عليه وسلم الأذان.","bab":"أذان › فضل التأذين","dorar":"WP9vVj7H"},{"id":"س-01159","fp":"a6482fe04706","stateId":518,"easy":"إذا صليت الصبح ثم قعدت تذكر الله حتى الشروق ← فكأنك أعتقت أربعة من ولد إسماعيل","cause":"مَن صلَّى صلاةَ الصُّبحِ، ثمَّ قعَدَ يذكُرُ اللهَ عزَّ وجلَّ حتى تطلُعَ الشَّمسُ","result":"كان له كمَن أعتَقَ أربعةً مِن ولدِ إسماعيلَ","explicit":true,"ref":"تخريج مشكل الآثار 3909","srcLabel":"مسلم","text":[["مَن صلَّى صلاةَ الصُّبحِ، ثمَّ قعَدَ يذكُرُ اللهَ عزَّ وجلَّ حتى تطلُعَ الشَّمسُ، ",1],["كان له كمَن أعتَقَ أربعةً مِن ولدِ إسماعيلَ",2],"."],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"[فيه] أبو الجعد يغلب على ظني أنه رافع الأشجعي الغطفاني الكوفي والد سالم\nوهو ثقة من رجال مسلم، وباقي رجاله ثقات","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (3909) واللفظ له، وأحمد (22194)، والطبراني (8028) (8/ 265) كلاهما بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"MmxieNBy"},{"id":"س-02218","fp":"0ea6b5c35f1f","stateId":518,"easy":"إذا صليت في جماعة ← تعدل خمساً وعشرين صلاة، وفي الفلاة بإتمام خمسين","cause":"الصَّلاةُ في جماعةٍ","result":"تعدلُ خمسًا وعشرينَ صلاةً فإذا صلَّاها في فلاةٍ فأتمَّ رُكوعَها وسجودَها بلغت خمسينَ صلاةً","explicit":true,"repOf":"س-06647","ref":"صحيح أبي داود 560","text":[["الصَّلاةُ في جماعةٍ ",1],["تعدلُ خمسًا وعشرينَ صلاةً فإذا صلَّاها في فلاةٍ فأتمَّ رُكوعَها وسجودَها بلغت خمسينَ صلاةً",2]," قالَ أبو داودَ قالَ عبدُ الواحدِ بنُ زيادٍ في هذا الحديثِ صلاةُ الرَّجلِ في الفلاةِ تُضاعفُ علَى صلاتِه في الجماعةِ وساقَ الحديثَ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (560) واللفظ له، والحاكم (753)، والبيهقي في ((شعب الإيمان)) (2831)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6WayTisB"},{"id":"س-06066","fp":"2d889db2236e","stateId":518,"easy":"إذا خطوت إلى الصلاة ← فكل خطوة صلاة","cause":"كلَّ خطوةٍ يخطوها أحدُكم إلى صلاةٍ","result":"صلاةٌ","explicit":true,"ref":"السلسلة الصحيحة 2/120","srcLabel":"الطبراني","text":["على كلِّ مِيسمٍ من الإنسانِ صلاةٌ ( وفي روايةٍ يصبحُ على كلِّ ميسمٍ من ابنِ آدم كلَّ يومٍ صدقةٌ ) فقال رجلٌ من القومِ : ومن يطيقُ هذا ؟ فقال : أمرٌ بالمعروفِ ونهيٌ عن المنكرِ صلاةٌ , وإنَّ حملًا عن الضعيفِ صلاةٌ , وإنَّ ",["كلَّ خطوةٍ يخطوها أحدُكم إلى صلاةٍ",1]," ",["صلاةٌ",2]],"grade":"صحيح","narrator":"عبد الله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (2434)، وابن خزيمة (1497)، والطبراني (11/297) (11791)","bab":"رقائق وزهد › ما جاء في السعي لقضاء حوائج الخلق","dorar":"jCcOFvxQ"},{"id":"س-06225","fp":"5d87084dd5bc","stateId":518,"easy":"إذا توضأت ثم غدوت إلى المسجد لصلاة الضحى ← فهو أقرب مغزى وأكثر غنيمة وأسرع رجعة","cause":"مَن توَضَّأ ثم غَدا إلى المَسجِدِ لِسُبحَةِ الضُّحَى","result":"فهو أقرَبُ مَغزًى وأكثَرُ غَنيمَةً وأَوشَكُ رَجعَةً","explicit":true,"apply":{"k":"time","t":"الضحى"},"otherNeedIds":[45],"ref":"تخريج المسند لشاكر 10/125","srcLabel":"أحمد","text":["بعَث رسولُ اللهِ صلَّى اللهُ عليه وسلَّم سَرِيَّةً فغنِموا وأَسرَعوا الرَّجعَةَ فتحَدَّث الناسُ بقُربِ مَغزاهم وكثرَةِ غَنيمَتِهم وسُرعَةِ رَجعَتِهم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ألَا أدُلُّكم على أقرَبَ منه مَغزًى وأكثرَ غَنيمَةً وأَوشَكَ رَجعَةً ",["مَن توَضَّأ ثم غَدا إلى المَسجِدِ لِسُبحَةِ الضُّحَى",1]," ",["فهو أقرَبُ مَغزًى وأكثَرُ غَنيمَةً وأَوشَكُ رَجعَةً",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6638) واللفظ له، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/401)، والطبراني (14/78) (14684).","bab":"سرايا › السرايا","dorar":"FagPciwa"},{"id":"س-07120","fp":"717ab7a7f06b","stateId":518,"easy":"إذا نحّيت الأذى أو دفنت البزاق في المسجد ← تؤدي صدقة مفاصلك","cause":"أَلَيْسَ يُنَحِّي أحدُكم الأذى عن الطريقِ ؟ ويُبْزَقُ في المسجدِ فَيَدْفِنُهَا ؟ فَإِنْ لم يفعلْ فإِنَّ رَكْعَتَيِ الضُّحَى تُجْزِيهِ","result":"على كلِّ مِفْصَلٍ منها صدقَةٌ","explicit":true,"ref":"الإمتاع لابن حجر 1/126","srcLabel":"أبو داود","text":["في الإنسانِ ثلاثمائةٍ وستونَ مِفْصَلًا ، ",["على كلِّ مِفْصَلٍ منها صدقَةٌ",2]," . قالوا : يا رسولَ اللهِ ! وأَيُّنَا يُطِيقُ ذَلِكَ ؟ قال : ",["أَلَيْسَ يُنَحِّي أحدُكم الأذى عن الطريقِ ؟ ويُبْزَقُ في المسجدِ فَيَدْفِنُهَا ؟ فَإِنْ لم يفعلْ فإِنَّ رَكْعَتَيِ الضُّحَى تُجْزِيهِ",1]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"حسن صحيح","takhrij":"أخرجه أبو داود (5242)، وأحمد (23037) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"mHnG5tlG"},{"id":"س-08156","fp":"9a0e2b824919","stateId":518,"easy":"إذا انتظرت الصلاة بعد الصلاة ← فأنت كفارس اشتد به فرسه في سبيل الله","cause":"مُنتظرُ الصَّلاةِ مِن بعدِ الصَّلاةِ","result":"كَفارسٍ اشتدَّ بِهِ فرَسُهُ في سَبيلِ اللَّهِ على كَشحِهِ ، تُصلِّي علَيهِ ملائِكَةُ اللَّهِ ، ما لَم يُحدِثْ أو يَقومُ ، وَهوَ في الرِّباطِ الأَكْبرِ","explicit":true,"apply":{"k":"time","t":"دبر كل صلاة"},"otherNeedIds":[24],"ref":"تخريج المسند لشاكر 16/257","srcLabel":"أحمد","text":[["مُنتظرُ الصَّلاةِ مِن بعدِ الصَّلاةِ",1]," ، ",["كَفارسٍ اشتدَّ بِهِ فرَسُهُ في سَبيلِ اللَّهِ على كَشحِهِ ، تُصلِّي علَيهِ ملائِكَةُ اللَّهِ ، ما لَم يُحدِثْ أو يَقومُ ، وَهوَ في الرِّباطِ الأَكْبرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8625) واللفظ له، والطبراني في ((المعجم الأوسط)) (8144)، والديلمي في ((الفردوس)) (6484)","bab":"ملائكة › أعمال الملائكة","dorar":"4u5wnpSW"},{"id":"س-00922","fp":"8f64a595263b","stateId":518,"easy":"إذا صليت الصبح في جماعة وذكرت الله حتى الشروق ثم صليت ركعتين ← تعدل حجة وعمرة تامتين","cause":"من صلَّى صلاةَ الصبحِ في جماعةٍ وجلس يذكرُ اللهَ حتى تطلُعَ الشمسُ ثم صلَّى ركعتينِ","result":"فإن ذلك يعدلُ حجةً وعمرةً تامتينِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[45],"ref":"مجموع فتاوى ابن باز 378/11","srcLabel":"مجموع فتاوى ابن باز","text":[["من صلَّى صلاةَ الصبحِ في جماعةٍ وجلس يذكرُ اللهَ حتى تطلُعَ الشمسُ ثم صلَّى ركعتينِ، ",1],["فإن ذلك يعدلُ حجةً وعمرةً تامتينِ",2]],"grade":"حسن","muhaddith":"حسن لكثرة طرقه","bab":"أدعية وأذكار › فضل الذكر","dorar":"ungN1d9L","merged":2,"otherRefs":["مجموع فتاوى ابن باز 404/11 (حسن)"]},{"id":"س-05756","fp":"034b344e2cce","stateId":518,"easy":"إذا أحسنت الوضوء ثم خرجت إلى المسجد فوجدتهم قد صلوا ← يعطيك الله مثل أجر من حضر","cause":"مَن تَوَضأَ، فأَحْسَنَ وضوءَه، ثم خَرَجَ إلى المسجدِ، فوَجَدَ الناسَ قد صَلَّوْا","result":"أَعْطاه اللهُ مثلَ أَجْرِ مَن صلَّى وحَضَرَ ، لا يَنْقُصُ ذلك مِن أَجْرِه شيئًا","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[45],"ref":"فتح الباري لابن حجر 159/6","srcLabel":"أبو داود","text":[["مَن تَوَضأَ، فأَحْسَنَ وضوءَه، ثم خَرَجَ إلى المسجدِ، فوَجَدَ الناسَ قد صَلَّوْا؛ ",1],["أَعْطاه اللهُ مثلَ أَجْرِ مَن صلَّى وحَضَرَ ، لا يَنْقُصُ ذلك مِن أَجْرِه شيئًا",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده قوي","takhrij":"أخرجه أبو داود (564)، والنسائي (855)، وأحمد (8947) باختلاف يسير.","bab":"رقائق وزهد › النية","dorar":"iJTeGe16"},{"id":"س-06724","fp":"6744697d18aa","stateId":518,"easy":"إذا مشيت إلى صلاة مكتوبة في الجماعة ← فهي كحجة","cause":"مَن مَشَى إلى صلاةٍ مكتوبةٍ في الجماعةِ","result":"فهي كَحَجَّةٍ","explicit":true,"ref":"صحيح الجامع 6556","srcLabel":"أبو داود","text":[["مَن مَشَى إلى صلاةٍ مكتوبةٍ في الجماعةِ ، ",1],["فهي كَحَجَّةٍ ، ",2],"ومَن مَشَى إلى صلاةِ تَطَوُّعٍ ، فهي كعُمْرَةٍ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه أبو داود (558)، وأحمد (22304) بنحوه، والطبراني (8/149) (7578) واللفظ له.","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"8jwOolUD"},{"id":"س-01456","fp":"61bf3a8d6051","stateId":518,"easy":"إذا أحسنت الوضوء ثم ذهبت فوجدت الناس قد صلوا ← يعطيك الله مثل أجر من حضرها","cause":"مَن تَوَضَّأَ فأَحسَنَ وُضوءَه، ثُمَّ راحَ فوَجَدَ النَّاسَ قد صَلَّوا","result":"أَعْطاه اللهُ عَزَّ وجَلَّ مِثلَ أجْرِ مَن صَلَّاها وحَضَرَها، لا يَنقُصُ ذلك مِن أجورِهم شَيئًا","explicit":true,"star":true,"apply":{"k":"time","t":"بعد الوضوء"},"otherNeedIds":[45],"ref":"الأحكام الوسطى 1/ 282","srcLabel":"أبو داود","text":[["مَن تَوَضَّأَ فأَحسَنَ وُضوءَه، ثُمَّ راحَ فوَجَدَ النَّاسَ قد صَلَّوا، ",1],["أَعْطاه اللهُ عَزَّ وجَلَّ مِثلَ أجْرِ مَن صَلَّاها وحَضَرَها، لا يَنقُصُ ذلك مِن أجورِهم شَيئًا",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (564)، وأحمد (8947)، والبيهقي (5074) بلفظه.","bab":"وضوء › فضل الوضوء","dorar":"HJRn2jM9"},{"id":"س-01516","fp":"849a5c4ee55a","stateId":518,"easy":"إذا أذّنت محتسباً ← تكون كالشهيد المتشحط في دمه","cause":"المؤذِّنُ المُحتسِبُ","result":"كالشَّهيدِ المُتشَحِّطِ في دمِهِ ، يتمنَّى على اللَّهِ ما يشتَهي بينَ الأذانِ والإقامةِ","explicit":true,"otherNeedIds":[29],"ref":"الترغيب والترهيب 1/147","srcLabel":"الطبراني","text":[["المؤذِّنُ المُحتسِبُ",1]," ",["كالشَّهيدِ المُتشَحِّطِ في دمِهِ ، يتمنَّى على اللَّهِ ما يشتَهي بينَ الأذانِ والإقامةِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1221).","bab":"أذان › فضل التأذين","dorar":"7deaaam3","merged":2,"otherRefs":["الترغيب والترهيب 1/147 (صحيح)"]},{"id":"س-05906","fp":"4d1b7f4d9a6f","stateId":519,"easy":"إذا قرأت «قل هو الله أحد» ← فهي ثلث القرآن","cause":"اللهُ الواحِدُ الصَّمَدُ، لمْ يَلِدْ، ولمْ يولَدْ، ولمْ يكنْ لهُ كُفُوًا أحَدٌ","result":"ثُلُثُ القُرآنِ","explicit":true,"star":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"similar":["س-07642","س-07625","س-00758"],"ref":"تخريج مشكل الآثار 1215","srcLabel":"البخاري","text":["أيعجِزُ أحَدُكم أو يُغلَبُ أنْ يقرَأَ كلَّ ليلةٍ ثُلُثَ القُرآنِ، فكأنَّه ثقُل عليهم، فقال: (",["اللهُ الواحِدُ الصَّمَدُ، لمْ يَلِدْ، ولمْ يولَدْ، ولمْ يكنْ لهُ كُفُوًا أحَدٌ",1],") ",["ثُلُثُ القُرآنِ",2],"."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه أحمد (17109)، والنسائي في ((السنن الكبرى)) (10462)، والطبراني (17/254) (706) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"SVRgDxeJ"},{"id":"س-02062","fp":"1a7e1cf6c667","stateId":519,"easy":"إذا فاتك حزبك من الليل فقرأته بين الفجر والظهر ← فكأنما قرأته من ليلتك","cause":"فَقرأَهُ ما بينَ صَلاةِ الفَجرِ إلى الظُّهرِ","result":"فَكَأنَّما قرأَهُ من لَيلتِهِ","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 1/118","srcLabel":"مسلم","text":["مَن فاتَهُ شيءٌ مِن وِردِهِ أو قالَ : مِن جزئِهِ منَ اللَّيلِ ، ",["فَقرأَهُ ما بينَ صَلاةِ الفَجرِ إلى الظُّهرِ",1]," ، ",["فَكَأنَّما قرأَهُ من لَيلتِهِ",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (747)، وأبو داود (1313)، والترمذي (581) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Y5vrEm8U"},{"id":"س-07642","fp":"3465bb7bb017","stateId":519,"easy":"إذا قرأت «قل هو الله أحد» كل يوم ← فكأنك قرأت ثلث القرآن","cause":"فقُلْ هوَ اللهُ أحدٌ","result":"أنْ يقْرَأَ كلَّ يومٍ ثُلُثَ القُرآنِ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"repOf":"س-05906","ref":"تخريج المسند لشعيب 27522","text":["أيَعْجِزُ أحدُكُمْ ",["أنْ يقْرَأَ كلَّ يومٍ ثُلُثَ القُرآنِ",2],"؟. قالوا: يا رسولَ اللهِ، نحنُ أضعفُ من ذاكَ وأعجَزُ. قالَ: فإنَّ اللهَ جزَّأَ القرآنَ ثلاثةَ أجزاءٍ، ",["فقُلْ هوَ اللهُ أحدٌ",1]," جُزءٌ من أجزائِهِ."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه مسلم (811)، والنسائي في ((السنن الكبرى)) (10537)، وأحمد (27522) واللفظ له","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"FeXmMsNC"},{"id":"س-07646","fp":"48eb329b6020","stateId":519,"easy":"إذا قرأت الإخلاص والمعوذتين ← فكأنك قرأت ثلث القرآن","cause":"أنْ يَقرأَ: قُلْ هُوَ اللَّهُ أَحَدٌ، وقُلْ أَعُوذُ بِرَبِّ الْفَلَقِ، وقُلْ أَعُوذُ بِرَبِّ النَّاسِ","result":"حتَّى يَقرأَ ثُلثَ القرآنِ","explicit":true,"star":true,"apply":{"k":"read","t":"الإخلاص والمعوذتين"},"similar":["س-02225"],"ref":"المستدرك على الصحيحين 2112","srcLabel":"مسلم","text":["لا يَنامنَّ أَحدُكُم ",["حتَّى يَقرأَ ثُلثَ القرآنِ",2],"، قالوا: يا رسولَ اللهِ، وكيف يَستطيعُ أَحدُنا أنْ يَقرأَ بثُلثِ القرآنِ؟ قالَ: لا يَستطيعُ ",["أنْ يَقرأَ: {قُلْ هُوَ اللَّهُ أَحَدٌ}، و{قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ}، و{قُلْ أَعُوذُ بِرَبِّ النَّاسِ",1],"}؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطيالسي (2601) واللفظ له، ومسلم (812)، وابن ماجة (3787) بنحوه دون ذكر المعوذتين.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"Oy02gHkr"},{"id":"س-07625","fp":"4210245b10a8","stateId":519,"easy":"إذا قرأت «قل هو الله أحد» ← فكأنما قرأت ثلث القرآن","cause":"وإذا قَرَأتَ قُلْ هُوَ اللَّهُ أَحَدٌ","result":"فكأنَّما قَرَأتَ ثُلُثَ القُرْآنِ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"repOf":"س-05906","ref":"مجمع الزوائد 8/295","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان في مَحفَلٍ من أصْحابِه، إذ جاءَ أعرابيٌّ من بني سُلَيمٍ قد صادَ ضَبًّا، وجَعَلَه في كُمِّه، فذَهَبَ به إلى رَحْلِه، فرَأى جَماعَةً، فقال: على مَن هذه الجَماعَةُ؟ فقالوا: على هذا الذي يَزعُمُ أنَّه النَّبيُّ، فشَقَّ النَّاسَ، ثم أقبَلَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا مُحمَّدُ، ما اشْتَمَلتِ النِّساءُ على ذي لَهجَةٍ أكْذَبَ منك ولا أبغَضَ، ولولا أنْ تُسمِّيَني العَرَبُ عَجولًا؛ لَعَجِلتُ عليك فقَتَلتُكَ، فسَرَرتُ بقَتْلِكَ الناسَ أجمعينَ، فقال عُمَرُ: يا رسولَ اللهِ، دَعْني أقْتُلُه، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَا عَلِمتَ أنَّ الحليمَ كادَ يكونُ نَبيًّا، ثم أقبَلَ الأعْرابيُّ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: واللَّاتِ والعُزَّى لا آمَنتُ بِكَ، وقد قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا أعْرابيُّ ما حَمَلَك على أنْ قُلتَ ما قُلتَ، وقُلتَ غيرَ الحَقِّ، ولم تُكرِمْ مَجلِسي؟ قال: وتُكَلِّمُني أيضًا -استخفافًا برسولِ اللهِ صلَّى اللهُ عليه وسلَّم- واللَّاتِ والعُزَّى لا آمَنتُ بِكَ حتى يُؤمِنَ بك هذا الضَّبُّ، فأخْرَجَ الضَّبَّ من كُمِّه، فطَرَحَه بين يَدَيْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: إنْ آمَنَ بك هذا الضَّبُّ آمَنتُ بِكَ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا ضَبُّ، فكَلَّمَه الضَّبُّ بلِسانٍ عَرَبيٍّ مُبينٍ يَفهَمُه القَومُ جميعًا: لَبَّيكَ وسَعْدَيكَ يا رسولَ ربِّ العالَمين! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن تَعبُدُ؟ قال: الذي في السَّماءِ عَرشُه، وفي الأرضِ سُلطانُه، وفي البَحرِ سَبيلُه، وفي الجَنَّةِ رَحمَتُه، وفي النَّارِ عَذابُه، قال: فمَن أنا يا ضَبُّ؟ قال: أنتَ رسولُ ربِّ العالَمين، وخاتَمُ النَّبيِّينَ، قد أفلَحَ مَن صدَّقك، وقد خابَ مَن كذَّبك، فقال الأعْرابيُّ: أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّك رسولُ اللهِ حَقًّا، واللهِ لقد أَتَيتُك وما على وَجْهِ الأرْضِ أحَدٌ هو أبغَضُ إليَّ مِنكَ، وواللهِ لأنتَ الساعَةَ أحَبُّ إليَّ من نَفْسي، ومن وَلَدي، فقد آمَنتُ بِكَ، شَعْري، وبَشَري، وداخِلي، وخارِجي، وسِرِّي، وعَلانيتي، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الحَمدُ للهِ الذي هَدى هذا إلى الذي يَعلو ولا يُعلى، لا يَقبَلُه اللهُ تعالى إلَّا بصَلاةٍ، ولا تُقبَلُ الصَّلاةُ إلَّا بقُرْآنٍ، فعلَّمه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: {الحَمْدُ} و {قُلْ هُوَ اللَّهُ أَحَدٌ} فقال: يا رسولَ اللهِ، ما سَمِعتُ في البَسيطِ ولا في الرَّجَزِ أحسَنَ من هذا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ هذا كلامُ ربِّ العالَمين، وليس بشِعْرٍ، ",["وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} ",1],["فكأنَّما قَرَأتَ ثُلُثَ القُرْآنِ،",2]," وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} مرَّتينِ، فكأنَّما قَرَأتَ ثُلُثَيِ القُرْآنِ، وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} ثَلاثَ مَرَّاتٍ، فكأنَّما قَرَأتَ القُرْآنَ كُلَّه، فقال الأعْرابيُّ: نِعْمَ الإلهُ؛ فإنَّ إلَهَنا يَقبَلُ اليَسيرَ ويُعطي الجَزيلَ، ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أعْطُوا الأعْرابيَّ فأعْطَوْه حتى أبْطَروه، فقام عبدُ الرحمنِ بنُ عَوفٍ، فقال: يا رسولَ اللهِ، إنِّي أُريدُ أنْ أُعطِيَه ناقَةً أتقرَّبُ بها إلى اللهِ عزَّ وجلَّ دون البُخْتيِّ، وفوقَ الأعْرابيِّ، وهي عُشَراءُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد وَصَفتَ ما تُعْطي وأَصِفُ لك ما يُعْطيك اللهُ تَعالى جَزاءً؟ قال: نَعَمْ، قال: لك ناقَةٌ من دُرَّةٍ جَوْفاءَ، قَوائِمُها من زُمُرُّدٍ أخْضَرَ وعُنُقُها من زَبَرْجَدٍ أصْفَرَ، عليها هَودَجٌ، وعلى الهَودَجِ السُّنْدُسُ والإسْتَبْرقُ، تمُرُّ بك على الصِّراطِ كالبَرْقِ الخاطِفِ، فخَرَجَ الأعْرابيُّ من عِندِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فتَلَقَّاه ألْفُ أعْرابيٌّ على أَلْفِ دابَّةٍ، بأَلْفِ رُمْحٍ، وَأَلْفِ سَيفٍ، فقال لهم: أين تُريدونَ؟ فقالوا: نُقاتِلُ هذا الذي يَكذِبُ ويَزعُمُ أنَّه نَبيٌّ، فقال الأعْرابيُّ: إنِّي أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا له: صَبَوتَ؟ فقال لهم: ما صَبَوتُ وحدَّثَهم هذا الحديثَ، فقالوا بأَجْمَعِهم: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فبَلَغَ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّم فتَلَقَّاهم في رِداءٍ، فنَزَلوا عن رُكابِهم، يُقَبِّلون ما وَلَوْا عنه إلَّا وهم يَقولونَ: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فقالوا: مُرْنا بأَمْرِكَ يا رسولَ اللهِ، قال: تَدْخُلون تحت رايَةِ خالدِ بنِ الوليدٍ، قال: فليس أحَدٌ من العَرَبِ آمَنَ منهم أَلْفٌ جميعًا إلَّا بنو سُلَيمٍ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[فيه] محمد بن علي بن الوليد البصري قال البيهقي الحمل في هذا الحديث عليه قلت وبقية رجاله رجال الصحيح","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"Vw04c0tX","merged":22,"otherRefs":["صحيح الترغيب 1481 (صحيح)","صحيح الموارد 551 (صحيح)","الترغيب والترهيب 2/323 (صحيح)","التمهيد 19/229 (صحيح)","تخريج مشكل الآثار 1218 (صحيح)","صحيح البخاري 6643 (صحيح)","تخريج المسند لشعيب 11053 (صحيح)","اللطائف من دقائق المعارف 700 (صحيح)","البلدانيات 293 (حسن)","تخريج المسند لشعيب 23554 (صحيح)","المصابيح في الأحاديث المتواترة 604 (صحيح)","تخريج صحيح ابن حبان 2576 (صحيح)","التمهيد 7/252 (صحيح)","صحيح الترمذي 2900 (صحيح)","الجامع الصغير 654 (صحيح)","تخريج المسند لشعيب 21275 (صحيح)","صحيح الترمذي 2893 (حسن)","تخريج المسند لشاكر 10/110 (صحيح)","صحيح مسلم 812 (صحيح)","تخريج المسند لشعيب 11392 (صحيح)","كشف الخفاء 2/565 (صحيح)"]},{"id":"س-00758","fp":"f9ef07dcb57b","stateId":519,"easy":"إذا قرأت «قل هو الله أحد» في ليلة ← فقد قرأت ثلث القرآن","cause":"اللَّهُ الواحدُ الصَّمَدُ","result":"فقد قرأ ليلتَه ثُلُثَ القرآنِ","explicit":true,"apply":{"k":"say","t":"«قل هو الله أحد»"},"repOf":"س-05906","ref":"حلية الأولياء 2/138","text":["أيعجزُ أحدُكم أن يقرأَ ليلتَه بثُلُثِ القرآنِ ، فأشفقنا أن يأمرَنا بأمرٍ نعجزُ عنه ، قال : فسكتنا ، فقالها ثلاثَ مرَّاتٍ : أن يقرأَ بثُلُثِ القرآنِ, فإنَّه من قرأ[",["اللَّهُ الواحدُ الصَّمَدُ",1],"]  ",["فقد قرأ ليلتَه ثُلُثَ القرآنِ",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"متفق عليه [أي:بين العلماء]","takhrij":"أخرجه الترمذي (2896)، وأحمد (23554) باختلاف يسير، والنسائي (996) مختصراً باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"vlaoRI0r","merged":3,"otherRefs":["صحيح ابن ماجه 3071 (صحيح)","تخريج مشكل الآثار 1216 (صحيح)"]},{"id":"س-07815","fp":"873b5ad133b0","stateId":519,"easy":"إذا غدوت إلى المسجد فتعلمت أو قرأت آيتين ← فهو خير لك من ناقتين وكل آية خير من ناقة","cause":"أفلا يَغدو أحَدُكُم إلى المَسجِدِ فيَعلَمُ أو يَقرَأُ آيَتَينِ مِن كِتابِ اللهِ عَزَّ وجَلَّ","result":"خَيرٌ له مِن ناقَتَينِ، وثَلاثٌ خَيرٌ له مِن ثَلاثٍ، وأربَعٌ خَيرٌ له مِن أربَعٍ، ومِن أعدادِهنَّ مِنَ الإبِلِ","explicit":true,"star":true,"otherNeedIds":[18],"ref":"صحيح مسلم 803","srcLabel":"أبو داود","text":["خَرَجَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ونَحنُ في الصُّفَّةِ، فقال: أيُّكُم يُحِبُّ أن يَغدوَ كُلَّ يَومٍ إلى بُطحانَ أو إلى العَقيقِ، فيَأتيَ منه بناقَتَينِ كَوماوينِ في غيرِ إثمٍ ولا قَطعِ رَحِمٍ؟ فقُلنا: يا رَسولَ اللهِ، نُحِبُّ ذلك، قال: ",["أفلا يَغدو أحَدُكُم إلى المَسجِدِ فيَعلَمُ أو يَقرَأُ آيَتَينِ مِن كِتابِ اللهِ عَزَّ وجَلَّ",1],"، ",["خَيرٌ له مِن ناقَتَينِ، وثَلاثٌ خَيرٌ له مِن ثَلاثٍ، وأربَعٌ خَيرٌ له مِن أربَعٍ، ومِن أعدادِهنَّ مِنَ الإبِلِ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (1456)، وأحمد (17408)، وابن حبان (115) جميعهم بلفظه.","bab":"قرآن › فضل قراءة القرآن","dorar":"c9fu5Av3","merged":3,"otherRefs":["تخريج صحيح ابن حبان 115 (صحيح)","صحيح أبي داود 1456 (صحيح)"]},{"id":"س-00793","fp":"3d6c807cd003","stateId":519,"easy":"إذا قرأت المسبّحات قبل نومك ← ففيهن آية خير من ألف آية","cause":"يقرأُ المسبِّحاتِ قَبلَ أن يرقدَ","result":"إنَّ فيهنَّ آيةً خيرٌ من أَلفِ آيةٍ","explicit":true,"ref":"الترغيب والترهيب 1/283","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ كانَ ",["يقرأُ المسبِّحاتِ قَبلَ أن يرقدَ",1]," ويقولُ : ",["إنَّ فيهنَّ آيةً خيرٌ من أَلفِ آيةٍ",2]],"grade":"صحيح","narrator":"العرباض بن سارية","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (5057)، والترمذي (3406) كلاهما بلفظه، وأحمد (17160) باختلاف يسير.","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"qhijgACE","merged":2,"otherRefs":["صحيح الترمذي 3406 (حسن)"]},{"id":"س-02225","fp":"0b8c762568c8","stateId":519,"easy":"إذا قرأت سورة الإخلاص ← فقد قرأت ثلث القرآن","cause":"من قرأ سورةَ الإخلاصِ","result":"فقد قرأ ثُلُثَ القرآنِ","explicit":true,"apply":{"k":"read","t":"سورة الإخلاص"},"repOf":"س-07646","ref":"تخريج الإحياء للعراقي 5/62","text":[["من قرأ سورةَ الإخلاصِ ",1],["فقد قرأ ثُلُثَ القرآنِ ",2],"."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (21275)، والضياء في ((الأحاديث المختارة)) (1239) على الشك في راويه أبي بن كعب أو رجل من الأنصار، والنسائي في ((السنن الكبرى)) (10454) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"syE0Ur0e"},{"id":"س-06375","fp":"1853c0314100","stateId":519,"easy":"إذا أسررت بالقرآن ← فأنت كالمسرّ بالصدقة","cause":"والَّذي يُسرُّ بالقرآنِ","result":"كالَّذي يُسرُّ بالصَّدقةِ","explicit":true,"similar":["س-00543"],"ref":"صحيح النسائي 1662","srcLabel":"الترمذي","text":["إنَّ الَّذي يجهرُ بالقرآنِ ، كالَّذي يجهرُ بالصَّدقةِ ",["والَّذي يُسرُّ بالقرآنِ",1]," ",["كالَّذي يُسرُّ بالصَّدقةِ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1663) بلفظه ، وأبو داوود (1333) ، والترمذي (2919) ، وأحمد (17268) ثلاثتهم بمعناه .","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"YS04dpGZ"},{"id":"س-07626","fp":"d80d36d6ef03","stateId":519,"easy":"إذا قرأتها مرتين ← فكأنما قرأت ثلثي القرآن","cause":"وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} مرَّتينِ","result":"فكأنَّما قَرَأتَ ثُلُثَيِ القُرْآنِ","explicit":true,"apply":{"k":"count","t":"مرتين"},"ref":"مجمع الزوائد 8/295","srcLabel":"البيهقي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان في مَحفَلٍ من أصْحابِه، إذ جاءَ أعرابيٌّ من بني سُلَيمٍ قد صادَ ضَبًّا، وجَعَلَه في كُمِّه، فذَهَبَ به إلى رَحْلِه، فرَأى جَماعَةً، فقال: على مَن هذه الجَماعَةُ؟ فقالوا: على هذا الذي يَزعُمُ أنَّه النَّبيُّ، فشَقَّ النَّاسَ، ثم أقبَلَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا مُحمَّدُ، ما اشْتَمَلتِ النِّساءُ على ذي لَهجَةٍ أكْذَبَ منك ولا أبغَضَ، ولولا أنْ تُسمِّيَني العَرَبُ عَجولًا؛ لَعَجِلتُ عليك فقَتَلتُكَ، فسَرَرتُ بقَتْلِكَ الناسَ أجمعينَ، فقال عُمَرُ: يا رسولَ اللهِ، دَعْني أقْتُلُه، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَا عَلِمتَ أنَّ الحليمَ كادَ يكونُ نَبيًّا، ثم أقبَلَ الأعْرابيُّ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: واللَّاتِ والعُزَّى لا آمَنتُ بِكَ، وقد قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا أعْرابيُّ ما حَمَلَك على أنْ قُلتَ ما قُلتَ، وقُلتَ غيرَ الحَقِّ، ولم تُكرِمْ مَجلِسي؟ قال: وتُكَلِّمُني أيضًا -استخفافًا برسولِ اللهِ صلَّى اللهُ عليه وسلَّم- واللَّاتِ والعُزَّى لا آمَنتُ بِكَ حتى يُؤمِنَ بك هذا الضَّبُّ، فأخْرَجَ الضَّبَّ من كُمِّه، فطَرَحَه بين يَدَيْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: إنْ آمَنَ بك هذا الضَّبُّ آمَنتُ بِكَ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا ضَبُّ، فكَلَّمَه الضَّبُّ بلِسانٍ عَرَبيٍّ مُبينٍ يَفهَمُه القَومُ جميعًا: لَبَّيكَ وسَعْدَيكَ يا رسولَ ربِّ العالَمين! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن تَعبُدُ؟ قال: الذي في السَّماءِ عَرشُه، وفي الأرضِ سُلطانُه، وفي البَحرِ سَبيلُه، وفي الجَنَّةِ رَحمَتُه، وفي النَّارِ عَذابُه، قال: فمَن أنا يا ضَبُّ؟ قال: أنتَ رسولُ ربِّ العالَمين، وخاتَمُ النَّبيِّينَ، قد أفلَحَ مَن صدَّقك، وقد خابَ مَن كذَّبك، فقال الأعْرابيُّ: أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّك رسولُ اللهِ حَقًّا، واللهِ لقد أَتَيتُك وما على وَجْهِ الأرْضِ أحَدٌ هو أبغَضُ إليَّ مِنكَ، وواللهِ لأنتَ الساعَةَ أحَبُّ إليَّ من نَفْسي، ومن وَلَدي، فقد آمَنتُ بِكَ، شَعْري، وبَشَري، وداخِلي، وخارِجي، وسِرِّي، وعَلانيتي، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الحَمدُ للهِ الذي هَدى هذا إلى الذي يَعلو ولا يُعلى، لا يَقبَلُه اللهُ تعالى إلَّا بصَلاةٍ، ولا تُقبَلُ الصَّلاةُ إلَّا بقُرْآنٍ، فعلَّمه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: {الحَمْدُ} و {قُلْ هُوَ اللَّهُ أَحَدٌ} فقال: يا رسولَ اللهِ، ما سَمِعتُ في البَسيطِ ولا في الرَّجَزِ أحسَنَ من هذا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ هذا كلامُ ربِّ العالَمين، وليس بشِعْرٍ، وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} فكأنَّما قَرَأتَ ثُلُثَ القُرْآنِ، ",["وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} مرَّتينِ",1],"، ",["فكأنَّما قَرَأتَ ثُلُثَيِ القُرْآنِ",2],"، وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} ثَلاثَ مَرَّاتٍ، فكأنَّما قَرَأتَ القُرْآنَ كُلَّه، فقال الأعْرابيُّ: نِعْمَ الإلهُ؛ فإنَّ إلَهَنا يَقبَلُ اليَسيرَ ويُعطي الجَزيلَ، ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أعْطُوا الأعْرابيَّ فأعْطَوْه حتى أبْطَروه، فقام عبدُ الرحمنِ بنُ عَوفٍ، فقال: يا رسولَ اللهِ، إنِّي أُريدُ أنْ أُعطِيَه ناقَةً أتقرَّبُ بها إلى اللهِ عزَّ وجلَّ دون البُخْتيِّ، وفوقَ الأعْرابيِّ، وهي عُشَراءُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد وَصَفتَ ما تُعْطي وأَصِفُ لك ما يُعْطيك اللهُ تَعالى جَزاءً؟ قال: نَعَمْ، قال: لك ناقَةٌ من دُرَّةٍ جَوْفاءَ، قَوائِمُها من زُمُرُّدٍ أخْضَرَ وعُنُقُها من زَبَرْجَدٍ أصْفَرَ، عليها هَودَجٌ، وعلى الهَودَجِ السُّنْدُسُ والإسْتَبْرقُ، تمُرُّ بك على الصِّراطِ كالبَرْقِ الخاطِفِ، فخَرَجَ الأعْرابيُّ من عِندِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فتَلَقَّاه ألْفُ أعْرابيٌّ على أَلْفِ دابَّةٍ، بأَلْفِ رُمْحٍ، وَأَلْفِ سَيفٍ، فقال لهم: أين تُريدونَ؟ فقالوا: نُقاتِلُ هذا الذي يَكذِبُ ويَزعُمُ أنَّه نَبيٌّ، فقال الأعْرابيُّ: إنِّي أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا له: صَبَوتَ؟ فقال لهم: ما صَبَوتُ وحدَّثَهم هذا الحديثَ، فقالوا بأَجْمَعِهم: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فبَلَغَ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّم فتَلَقَّاهم في رِداءٍ، فنَزَلوا عن رُكابِهم، يُقَبِّلون ما وَلَوْا عنه إلَّا وهم يَقولونَ: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فقالوا: مُرْنا بأَمْرِكَ يا رسولَ اللهِ، قال: تَدْخُلون تحت رايَةِ خالدِ بنِ الوليدٍ، قال: فليس أحَدٌ من العَرَبِ آمَنَ منهم أَلْفٌ جميعًا إلَّا بنو سُلَيمٍ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[فيه] محمد بن علي بن الوليد البصري قال البيهقي الحمل في هذا الحديث عليه قلت وبقية رجاله رجال الصحيح","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"Vw04c0tX"},{"id":"س-07627","fp":"7f7caecec7ff","stateId":519,"easy":"إذا قرأتها ثلاث مرات ← فكأنما قرأت القرآن كله","cause":"وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} ثَلاثَ مَرَّاتٍ","result":"فكأنَّما قَرَأتَ القُرْآنَ كُلَّه","explicit":true,"apply":{"k":"count","t":"ثلاث مرات"},"ref":"مجمع الزوائد 8/295","srcLabel":"البيهقي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم كان في مَحفَلٍ من أصْحابِه، إذ جاءَ أعرابيٌّ من بني سُلَيمٍ قد صادَ ضَبًّا، وجَعَلَه في كُمِّه، فذَهَبَ به إلى رَحْلِه، فرَأى جَماعَةً، فقال: على مَن هذه الجَماعَةُ؟ فقالوا: على هذا الذي يَزعُمُ أنَّه النَّبيُّ، فشَقَّ النَّاسَ، ثم أقبَلَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فقال: يا مُحمَّدُ، ما اشْتَمَلتِ النِّساءُ على ذي لَهجَةٍ أكْذَبَ منك ولا أبغَضَ، ولولا أنْ تُسمِّيَني العَرَبُ عَجولًا؛ لَعَجِلتُ عليك فقَتَلتُكَ، فسَرَرتُ بقَتْلِكَ الناسَ أجمعينَ، فقال عُمَرُ: يا رسولَ اللهِ، دَعْني أقْتُلُه، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أمَا عَلِمتَ أنَّ الحليمَ كادَ يكونُ نَبيًّا، ثم أقبَلَ الأعْرابيُّ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: واللَّاتِ والعُزَّى لا آمَنتُ بِكَ، وقد قال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا أعْرابيُّ ما حَمَلَك على أنْ قُلتَ ما قُلتَ، وقُلتَ غيرَ الحَقِّ، ولم تُكرِمْ مَجلِسي؟ قال: وتُكَلِّمُني أيضًا -استخفافًا برسولِ اللهِ صلَّى اللهُ عليه وسلَّم- واللَّاتِ والعُزَّى لا آمَنتُ بِكَ حتى يُؤمِنَ بك هذا الضَّبُّ، فأخْرَجَ الضَّبَّ من كُمِّه، فطَرَحَه بين يَدَيْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: إنْ آمَنَ بك هذا الضَّبُّ آمَنتُ بِكَ! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: يا ضَبُّ، فكَلَّمَه الضَّبُّ بلِسانٍ عَرَبيٍّ مُبينٍ يَفهَمُه القَومُ جميعًا: لَبَّيكَ وسَعْدَيكَ يا رسولَ ربِّ العالَمين! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن تَعبُدُ؟ قال: الذي في السَّماءِ عَرشُه، وفي الأرضِ سُلطانُه، وفي البَحرِ سَبيلُه، وفي الجَنَّةِ رَحمَتُه، وفي النَّارِ عَذابُه، قال: فمَن أنا يا ضَبُّ؟ قال: أنتَ رسولُ ربِّ العالَمين، وخاتَمُ النَّبيِّينَ، قد أفلَحَ مَن صدَّقك، وقد خابَ مَن كذَّبك، فقال الأعْرابيُّ: أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّك رسولُ اللهِ حَقًّا، واللهِ لقد أَتَيتُك وما على وَجْهِ الأرْضِ أحَدٌ هو أبغَضُ إليَّ مِنكَ، وواللهِ لأنتَ الساعَةَ أحَبُّ إليَّ من نَفْسي، ومن وَلَدي، فقد آمَنتُ بِكَ، شَعْري، وبَشَري، وداخِلي، وخارِجي، وسِرِّي، وعَلانيتي، فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الحَمدُ للهِ الذي هَدى هذا إلى الذي يَعلو ولا يُعلى، لا يَقبَلُه اللهُ تعالى إلَّا بصَلاةٍ، ولا تُقبَلُ الصَّلاةُ إلَّا بقُرْآنٍ، فعلَّمه رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: {الحَمْدُ} و {قُلْ هُوَ اللَّهُ أَحَدٌ} فقال: يا رسولَ اللهِ، ما سَمِعتُ في البَسيطِ ولا في الرَّجَزِ أحسَنَ من هذا، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ هذا كلامُ ربِّ العالَمين، وليس بشِعْرٍ، وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} فكأنَّما قَرَأتَ ثُلُثَ القُرْآنِ، وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} مرَّتينِ، فكأنَّما قَرَأتَ ثُلُثَيِ القُرْآنِ، ",["وإذا قَرَأتَ {قُلْ هُوَ اللَّهُ أَحَدٌ} ثَلاثَ مَرَّاتٍ",1],"، ",["فكأنَّما قَرَأتَ القُرْآنَ كُلَّه",2],"، فقال الأعْرابيُّ: نِعْمَ الإلهُ؛ فإنَّ إلَهَنا يَقبَلُ اليَسيرَ ويُعطي الجَزيلَ، ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أعْطُوا الأعْرابيَّ فأعْطَوْه حتى أبْطَروه، فقام عبدُ الرحمنِ بنُ عَوفٍ، فقال: يا رسولَ اللهِ، إنِّي أُريدُ أنْ أُعطِيَه ناقَةً أتقرَّبُ بها إلى اللهِ عزَّ وجلَّ دون البُخْتيِّ، وفوقَ الأعْرابيِّ، وهي عُشَراءُ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قد وَصَفتَ ما تُعْطي وأَصِفُ لك ما يُعْطيك اللهُ تَعالى جَزاءً؟ قال: نَعَمْ، قال: لك ناقَةٌ من دُرَّةٍ جَوْفاءَ، قَوائِمُها من زُمُرُّدٍ أخْضَرَ وعُنُقُها من زَبَرْجَدٍ أصْفَرَ، عليها هَودَجٌ، وعلى الهَودَجِ السُّنْدُسُ والإسْتَبْرقُ، تمُرُّ بك على الصِّراطِ كالبَرْقِ الخاطِفِ، فخَرَجَ الأعْرابيُّ من عِندِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فتَلَقَّاه ألْفُ أعْرابيٌّ على أَلْفِ دابَّةٍ، بأَلْفِ رُمْحٍ، وَأَلْفِ سَيفٍ، فقال لهم: أين تُريدونَ؟ فقالوا: نُقاتِلُ هذا الذي يَكذِبُ ويَزعُمُ أنَّه نَبيٌّ، فقال الأعْرابيُّ: إنِّي أشهَدُ أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم، فقالوا له: صَبَوتَ؟ فقال لهم: ما صَبَوتُ وحدَّثَهم هذا الحديثَ، فقالوا بأَجْمَعِهم: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فبَلَغَ ذلك النَّبيَّ صلَّى اللهُ عليه وسلَّم فتَلَقَّاهم في رِداءٍ، فنَزَلوا عن رُكابِهم، يُقَبِّلون ما وَلَوْا عنه إلَّا وهم يَقولونَ: لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، فقالوا: مُرْنا بأَمْرِكَ يا رسولَ اللهِ، قال: تَدْخُلون تحت رايَةِ خالدِ بنِ الوليدٍ، قال: فليس أحَدٌ من العَرَبِ آمَنَ منهم أَلْفٌ جميعًا إلَّا بنو سُلَيمٍ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[فيه] محمد بن علي بن الوليد البصري قال البيهقي الحمل في هذا الحديث عليه قلت وبقية رجاله رجال الصحيح","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"Vw04c0tX"},{"id":"س-07640","fp":"1346f39e0268","stateId":519,"easy":"إذا قرأت «إذا زلزلت» ← تعدل نصف القرآن","cause":"إِذَا زُلْزلَتُ","result":"تَعدِلُ نصفَ القُرآنِ","explicit":true,"apply":{"k":"say","t":"«إذا زلزلت»"},"similar":["س-07651"],"ref":"الجامع الصغير 654","srcLabel":"الترمذي","text":[["إِذَا زُلْزلَتُ",1],"  ",["تَعدِلُ نصفَ القُرآنِ",2],"،  وَ  قُلْ يَا أَيُّهَا الْكَافِرُونَ  تَعْدِلُ رُبْعَ القُرْآنَ،  وَ  قُلْ هُوَ اللهُ أَحَدٌ  تَعْدِلُ ثُلُثَ القُرْآنَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2894)، والحاكم (2078)، والبيهقي في ((شعب الإيمان)) (2514) باختلاف يسير","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"OQS7H4o2"},{"id":"س-07641","fp":"14333d256f4b","stateId":519,"easy":"إذا قرأت «قل يا أيها الكافرون» ← تعدل ربع القرآن","cause":"قُلْ يَا أَيُّهَا الْكَافِرُونَ","result":"تَعْدِلُ رُبْعَ القُرْآنَ","explicit":true,"apply":{"k":"say","t":"«قل يا أيها الكافرون»"},"similar":["س-07652"],"ref":"الجامع الصغير 654","srcLabel":"الترمذي","text":["إِذَا زُلْزلَتُ  تَعدِلُ نصفَ القُرآنِ،  وَ  ",["قُلْ يَا أَيُّهَا الْكَافِرُونَ",1],"  ",["تَعْدِلُ رُبْعَ القُرْآنَ",2],"،  وَ  قُلْ هُوَ اللهُ أَحَدٌ  تَعْدِلُ ثُلُثَ القُرْآنَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2894)، والحاكم (2078)، والبيهقي في ((شعب الإيمان)) (2514) باختلاف يسير","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"OQS7H4o2"},{"id":"س-07035","fp":"bd607a31e7fb","stateId":519,"easy":"إذا غدوت فتعلمت آية من كتاب الله ← فهو خير لك من مئة ركعة","cause":"لأن تغدوَ فتعلَّمَ آيةً من كتابِ اللَّهِ","result":"خيرٌ لَكَ من أن تصلِّيَ مئةَ رَكْعةٍ","explicit":true,"otherNeedIds":[18],"ref":"الترغيب والترهيب 1/77","srcLabel":"ابن ماجه","text":["يا أبا ذرٍّ ",["لأن تغدوَ فتعلَّمَ آيةً من كتابِ اللَّهِ",1]," ",["خيرٌ لَكَ من أن تصلِّيَ مئةَ رَكْعةٍ",2]," ولأن تغدوَ فتعلَّمَ بابًا منَ العلمِ عُمِلَ بِهِ أو لم يُعمَلْ بهِ خيرٌ لكَ من أن تصلِّيَ ألفَ رَكْعةٍ"],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (219)، وابن شاهين في ((شرح مذاهب أهل السنة)) (54)، والديلمي في ((الفردوس)) (8362) باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"mdOmwQ7H"},{"id":"س-07651","fp":"27a61989505c","stateId":519,"easy":"إذا قرأت «إذا زلزلت» ← عُدلت لك بنصف القرآن","cause":"مَن قرأَ : إِذَا زُلْزِلَتْ","result":"عُدِلَت لَهُ بنصفِ القُرآنِ","explicit":true,"apply":{"k":"say","t":"«إذا زلزلت»"},"repOf":"س-07640","ref":"صحيح الترمذي 2893","text":[["مَن قرأَ : ( إِذَا زُلْزِلَتْ ) ",1],["عُدِلَت لَهُ بنصفِ القُرآنِ ",2],". ومن قرأَ ( قُلْ يَا أَيُّهَا الْكَافِرُونَ ) . عُدِلَت لَهُ بربعِ القرآنِ. ومن قرأَ : ( قُلْ هُوَ اللَّهُ أَحَدٌ ) عُدِلَت لَهُ بثُلُثِ القُرآنِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن دون فضل زلزلت","takhrij":"أخرجه الترمذي (2893)، وابن حبان في ((المجروحين)) (1/272) واللفظ لهما، والعقيلي في ((الضعفاء الكبير)) (1/243) باختلاف يسير","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"AIlxn0F9"},{"id":"س-07652","fp":"fb2524959351","stateId":519,"easy":"إذا قرأت «قل يا أيها الكافرون» ← عُدلت لك بربع القرآن","cause":"ومن قرأَ قُلْ يَا أَيُّهَا الْكَافِرُونَ","result":"عُدِلَت لَهُ بربعِ القرآنِ","explicit":true,"apply":{"k":"say","t":"«قل يا أيها الكافرون»"},"repOf":"س-07641","ref":"صحيح الترمذي 2893","text":["مَن قرأَ : ( إِذَا زُلْزِلَتْ ) عُدِلَت لَهُ بنصفِ القُرآنِ . ",["ومن قرأَ ( قُلْ يَا أَيُّهَا الْكَافِرُونَ ) . ",1],["عُدِلَت لَهُ بربعِ القرآنِ",2],". ومن قرأَ : ( قُلْ هُوَ اللَّهُ أَحَدٌ ) عُدِلَت لَهُ بثُلُثِ القُرآنِ"],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن دون فضل زلزلت","takhrij":"أخرجه الترمذي (2893)، وابن حبان في ((المجروحين)) (1/272) واللفظ لهما، والعقيلي في ((الضعفاء الكبير)) (1/243) باختلاف يسير","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"AIlxn0F9"},{"id":"س-00728","fp":"224c8f3ea048","stateId":519,"easy":"إذا قرأت ثلاث آيات في صلاتك ← فهي خير لك من ثلاث نوق عظام","cause":"فثَلاثُ آياتٍ يَقرَأُ بهِنَّ أحَدُكُم في صَلاتِه","result":"خَيرٌ له مِن ثَلاثِ خَلِفاتٍ عِظامٍ سِمانٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح مسلم 802","srcLabel":"متفق عليه","text":["أيُحِبُّ أحَدُكُم إذا رَجَعَ إلى أهلِه أن يَجِدَ فيه ثَلاثَ خَلِفاتٍ عِظامٍ سِمانٍ؟ قُلنا: نَعَم، قال: ",["فثَلاثُ آياتٍ يَقرَأُ بهِنَّ أحَدُكُم في صَلاتِه",1]," ",["خَيرٌ له مِن ثَلاثِ خَلِفاتٍ عِظامٍ سِمانٍ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"PVsGnctE"},{"id":"س-05574","fp":"070099d16872","stateId":519,"easy":"إذا تعلمت خمس آيات ← فهي أفضل من غنيمة كبيرة","cause":"تَعلَّمْ خَمْسَ آياتٍ","result":"ما غَنِم فُلانٌ أفضَلَ مِمَّا غَنِمتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[18],"ref":"المطالب العالية 4/74","srcLabel":"الحارث","text":["أنَّ رجُلًا أصابَ مِن مَغنَمٍ خَمْسةً وعِشْرينَ أوقيَّةً مِن ذَهبٍ، فأتى النَّبيَّ صلَّى اللهُ عليهِ وسلَّم لِيَدعُوَ له، فأَعرَضَ عنه، ثمَّ عادَ فأَعرَضَ عنه، ثُمَّ عاد فأَعرَض عنه ، وَقال: ",["ما غَنِم فُلانٌ أفضَلَ مِمَّا غَنِمتَ",2],"، ",["تَعلَّمْ خَمْسَ آياتٍ",1],"."],"grade":"حسن","narrator":"[أبو عثمان النهدي]","muhaddith":"إسناده حسن","takhrij":"أخرجه الحارث كما في ((بغية الباحث)) للهيثمي (729)","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"GvCDpscx"},{"id":"س-00543","fp":"849359c2b8be","stateId":519,"easy":"إذا أسررت بالقرآن ← فأنت كالمسرّ بالصدقة","cause":"المُسِرُّ بالقُرآنِ","result":"كالمُسِرِّ بالصَّدَقةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-06375","ref":"تخريج المسند لشعيب 17796","text":[["المُسِرُّ بالقُرآنِ",1]," ",["كالمُسِرِّ بالصَّدَقةِ",2],"، والمُجهِرُ بالقُرآنِ كالمُجهِرُ بالصَّدَقةِ."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1333)، والترمذي (2919)، والنسائي (2561)، وأحمد (17796) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"VQWgcOkQ","merged":3,"otherRefs":["مجموع فتاوى ابن باز 382 /24 (حسن)","أصل صفة الصلاة 2/427 (صحيح)"]},{"id":"س-00700","fp":"8a31ea5d31f1","stateId":519,"easy":"إذا تعلمت آيتين من كتاب الله ← فهما خير لك من ناقتين","cause":"وآيتانِ من كتابِ اللَّهِ فيخرُجُ بِهِما إلى أَهْلِهِ","result":"خَيرٌ لَهُ مِن خَلِفَتينِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشاكر 16/249","srcLabel":"أحمد","text":["أيفرحُ أحدُكُم أن ينقَلِبَ إلى أَهْلِهِ بخَلِفَتينِ ؟ قالوا : نعَم ، قالَ ",["وآيتانِ من كتابِ اللَّهِ فيخرُجُ بِهِما إلى أَهْلِهِ",1]," ",["خَيرٌ لَهُ مِن خَلِفَتينِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8606) بلفظه، والفريابي في ((فضائل القرآن)) (66) بلفظ مقارب.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"LWbXHAuK"},{"id":"س-07046","fp":"338d77beb65e","stateId":519,"easy":"إذا تعلمت عشر آيات ← فهو أكثر ربحاً من التجارة","cause":"رَجلٌ تَعلَّمَ عَشْرَ آياتٍ","result":"بما هو أَكثرُ منه رِبحًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 2070","srcLabel":"الطبراني","text":["أنَّ رَجلًا جاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا نبيَّ اللهِ، اشتريتُ مِقسَمَ بني فلانٍ في تَخْتٍ فيه كذا وكذا، قالَ: أفلا أُنبئُكَ ",["بما هو أَكثرُ منه رِبحًا",2],"؟ قالَ: وهل يُوجدُ؟ قالَ: ",["رَجلٌ تَعلَّمَ عَشْرَ آياتٍ",1],"، فذَهَبَ الرَّجلُ فتَعلَّمَ عَشْرَ آياتٍ، فأَتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ، فأَخبَرَهُ."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"إن كان عمرو بن خالد حفظ في إسناده سالم بن أبي الجعد فإنَّه صحيح على شرط الشيخين غير أن البصريين من أصحاب المعتمر خالفوه فيه","takhrij":"أخرجه الطبراني (8/ 260) (8012)، والبيهقي في ((شعب الإيمان)) (1794) باختلاف يسير.","bab":"علم › الحث على طلب العلم","dorar":"AIk1rrbK"},{"id":"س-05790","fp":"3704a2fb9f20","stateId":519,"easy":"إذا قرأت آية الكرسي ← فهي ربع القرآن","cause":"آيةُ الكُرْسِيِّ","result":"رُبْعُ القرآنِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"read","t":"آية الكرسي"},"ref":"الجامع الصغير 21","srcLabel":"أحمد","text":[["آيةُ الكُرْسِيِّ",1]," ",["رُبْعُ القرآنِ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه أبو الشيخ في ((الثواب)) (1) واللفظ له، وأحمد (13309)، وابن عدي في ((الكامل في الضعفاء)) (5/388) بمعناه مطولا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"xy2znLNj"},{"id":"س-01868","fp":"07c774b94097","stateId":520,"easy":"إذا أقرضت مرتين ← فكأنك تصدقت مرة","cause":"مَنْ أقْرضَ ورِقًا مرَّتيْنِ","result":"كان كعِدْلِ صدَقةٍ مَرَّةً","explicit":true,"apply":{"k":"count","t":"مرتين"},"otherNeedIds":[45],"ref":"صحيح الجامع 6080","srcLabel":"ابن ماجه","text":[["مَنْ أقْرضَ ورِقًا مرَّتيْنِ ، ",1],["كان كعِدْلِ صدَقةٍ مَرَّةً",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2430)، وابن حبان (5040)، وابن عدي في ((الكامل في الضعفاء)) (3/271) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fvhFJbdu"},{"id":"س-01892","fp":"6a62571fdb65","stateId":520,"easy":"إذا أقرضت ← فهو كشطر الصدقة","cause":"إنَّ السَّلَفَ","result":"يَجري مَجْرى شطرِ الصدقةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"السلسلة الصحيحة 1553","srcLabel":"أحمد","text":[["إنَّ السَّلَفَ",1]," ",["يَجري مَجْرى شطرِ الصدقةِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح بمجموع طرقه","takhrij":"أخرجه أحمد (3911)، وابن أبي شيبة في ((المسند)) (387)، وأبو يعلى (5366) وفيه قصة","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"KBa2UjBQ"},{"id":"س-07125","fp":"2eb893d1519f","stateId":520,"easy":"إذا تصدقت بدرهم من درهمين ← سبق درهمك مئة ألف درهم","cause":"ورجلٌ ليس له إلا دِرهمانِ، فأخَذَ أحدَهما فتصدَّقَ به","result":"سبَقَ دِرهمٌ مئةَ ألفِ دِرهمٍ","explicit":true,"star":true,"otherNeedIds":[47],"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":[["سبَقَ دِرهمٌ مئةَ ألفِ دِرهمٍ",2],"، فقال رجُلٌ: كيف ذاك يا رسولَ اللهِ؟ فقال: رجلٌ له مالٌ كثيرٌ، أخَذَ مِن عُرضِه مئةَ ألفِ دِرهمٍ وتصدَّقَ بها، ",["ورجلٌ ليس له إلا دِرهمانِ، فأخَذَ أحدَهما فتصدَّقَ به",1],"."],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"علم › حسن السؤال ونصح العالم","dorar":"lmC7BhaB","merged":6,"otherRefs":["المحلى 8/14 (صحيح)","المستدرك على الصحيحين 1539 (صحيح)","المحلى 9/139 (صحيح)","الأحكام الشرعية الصغرى 370 (صحيح)","الترغيب والترهيب 2/66 (صحيح)"]},{"id":"س-00924","fp":"97b30ec5a0f4","stateId":520,"easy":"إذا منحت منيحة ورق أو لبن أو هديت طريقاً ← فهو كعتق نسمة","cause":"مَن مَنَح مَنيحةَ وَرِقٍ أو مَنيحةَ لَبَنٍ أو هَدَى زِقاقًا","result":"فهو كعِتاقِ نَسَمةٍ","explicit":true,"star":true,"ref":"الضعفاء الكبير 4/86","srcLabel":"الترمذي","text":[["مَن مَنَح مَنيحةَ وَرِقٍ أو مَنيحةَ لَبَنٍ أو هَدَى زِقاقًا، ",1],["فهو كعِتاقِ نَسَمةٍ، ",2],"من قال: لا إلهَ إلَّا اللهُ وَحْدَه لا شَريكَ له، له المُلكُ وله الحَمدُ وهو على كُلِّ شَيءٍ قديرٌ عَشْرَ مرَّاتٍ، فهو كعِتاقِ نَسَمةٍ، قال: وكان يأتي ناحيةَ الصَّفِّ يُسَوِّي بين صُدورِهم ومناكِبِهم يقولُ: لا تختَلِفوا فتختَلِفَ قُلوبُكم، وكان يقولُ: إنَّ اللهَ وملائِكَتَه يُصَلُّونَ على الصُّفوفِ الأُوَلِ، وكان يقولُ: زَيِّنوا القُرآنَ بأصواتِكم"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1957)، وأحمد (18516) باختلاف يسير، والعقيلي في ((الضعفاء الكبير)) (4/86) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"CE1hixY2","merged":2,"otherRefs":["صحيح الترغيب 1535 (صحيح)"]},{"id":"س-01054","fp":"99ea6554e919","stateId":520,"easy":"إذا منحت منيحة ورق أو هديت طريقاً أو سقيت لبناً ← فلك عدل رقبة","cause":"مَن مَنَحَ مَنيحةَ وَرِقٍ، أو هَدى زُقاقًا، أو سَقى لَبَنًا","result":"كان له عِدلُ رَقبةٍ أو نَسَمةٍ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 18704","srcLabel":"أبو داود","text":[["مَن مَنَحَ مَنيحةَ وَرِقٍ، أو هَدى زُقاقًا، أو سَقى لَبَنًا؛ ",1],["كان له  عِدلُ رَقبةٍ أو نَسَمةٍ، ",2],"ومَن قال: لا إلهَ إلَّا اللهُ، وَحدَه لا شَريكَ له، له المُلكُ وله الحَمدُ، وهو على كُلِّ شيءٍ قَديرٌ، عَشْرَ مِرارٍ؛ كان له  عِدلُ رَقبةٍ أو نَسَمةٍ. وكان يَأتينا إذا قُمْنا إلى الصَّلاةِ، فيَمسَحُ صُدورَنا أو عَواتِقَنا، يقولُ: لا تَختلِفْ صُفوفُكم؛ فتَختلِفَ قُلوبُكم. وكان يقولُ: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ الأوَّلِ أو الصُّفوفِ الأُوَلِ. وقال: زَيِّنوا القُرآنَ بأصْواتِكم، كنتُ نَسيتُها، فذَكَّرَنيها الضَّحَّاكُ بنُ مُزاحِمٍ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (664، 1468) مفرقاً بنحوه، والنسائي (811، 1015) مفرقاً بنحوه، وابن ماجه (1342) مختصراً، وأحمد (18704) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"LmO01swC","merged":2,"otherRefs":["صحيح ابن حبان 5096 (صحيح)"]},{"id":"س-02191","fp":"aa6c52c0db4d","stateId":520,"easy":"إذا أقرضت مرتين ← لك مثل أجر أحدهما لو تصدقت به","cause":"منْ أقرضَ اللهَ مرتينِ","result":"كانَ له مثلُ أجرِ أحَدِهما لو تصَدَّقَ بهِ","explicit":true,"apply":{"k":"count","t":"مرتين"},"otherNeedIds":[45],"ref":"تحفة المحتاج 2/249","srcLabel":"ابن ماجه","text":[["منْ أقرضَ اللهَ مرتينِ ",1],["كانَ له مثلُ أجرِ أحَدِهما لو تصَدَّقَ بهِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه ابن ماجه (2430) بنحوه، وابن حبان (5040) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (4/159) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qoIM98aV"},{"id":"س-06315","fp":"6dd177897f0a","stateId":520,"easy":"إذا أعطت المرأة من بيت زوجها بطيب نفس غير مفسدة ← فلها مثل أجره ولها ما نوت","cause":"إذا أعطَتِ المرأةُ من بيتِ زوجِها بطِيبِ نفْسٍ، غيرَ مُفسِدةٍ","result":"فإن لها مِثلَ أجرِه، لها ما نوتْ حسَنًا، وللخازنِ مثلُ ذلك","explicit":true,"otherNeedIds":[45],"ref":"سنن الترمذي 672","srcLabel":"الترمذي","text":[["إذا أعطَتِ المرأةُ من بيتِ زوجِها بطِيبِ نفْسٍ، غيرَ مُفسِدةٍ، ",1],["فإن لها مِثلَ أجرِه، لها ما نوتْ حسَنًا، وللخازنِ مثلُ ذلك",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (672)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"pbgDQfsH"},{"id":"س-06373","fp":"c13e8e0d33b3","stateId":520,"easy":"إذا عملت بيدك فنفعت نفسك وتصدقت ← فهي صدقة","cause":"يَعتَمِلُ بيَدَيه فيَنفَعُ نَفسَه ويَتَصَدَّقُ، قال، قيلَ: أرَأيتَ إن لَم يَستَطِع؟ قال: يُعينُ ذا الحاجةِ المَلهوفَ، قال: قيلَ له: أرَأيتَ إن لَم يَستَطِعْ؟ قال: يَأمُرُ بالمَعروفِ أوِ الخَيرِ، قال: أرَأيتَ إن لَم يَفعَلْ؟ قال: يُمسِكُ عَنِ الشَّرِّ","result":"فإنَّها صَدَقةٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"otherNeedIds":[45],"ref":"صحيح مسلم 1008","srcLabel":"متفق عليه","text":["على كُلِّ مُسلِمٍ صَدَقةٌ، قيلَ: أرَأيتَ إن لَم يَجِدْ؟ قال: ",["يَعتَمِلُ بيَدَيه فيَنفَعُ نَفسَه ويَتَصَدَّقُ، قال، قيلَ: أرَأيتَ إن لَم يَستَطِع؟ قال: يُعينُ ذا الحاجةِ المَلهوفَ، قال: قيلَ له: أرَأيتَ إن لَم يَستَطِعْ؟ قال: يَأمُرُ بالمَعروفِ أوِ الخَيرِ، قال: أرَأيتَ إن لَم يَفعَلْ؟ قال: يُمسِكُ عَنِ الشَّرِّ",1],"؛ ",["فإنَّها صَدَقةٌ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6022)، ومسلم (1008).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"2omJhCvk","merged":4,"otherRefs":["صحيح الأدب المفرد 166 (صحيح)","صحيح البخاري 1445 (صحيح)","تخريج المسند لشعيب 19686 (صحيح)"]},{"id":"س-02207","fp":"2b9ee9a21ac7","stateId":520,"easy":"إذا أقرضت مرتين ← تعدل صدقة مرة","cause":"قرضُ مرَّتينِ","result":"يعدِلُ صدقةَ مرَّةٍ","explicit":true,"apply":{"k":"count","t":"مرتين"},"otherNeedIds":[45],"ref":"الوهم والإيهام 5/775","srcLabel":"الطبراني","text":[["قرضُ مرَّتينِ ",1],["يعدِلُ صدقةَ مرَّةٍ",2]],"grade":"حسن","narrator":"[عبدالله بن مسعود]","muhaddith":"حسن","takhrij":"أخرجه البزار (1607) واللفظ له، والطبراني في ((المعجم الأوسط)) (3498)، وابن عدي في ((الكامل في الضعفاء)) (2/143) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"RN7ROwVw"},{"id":"س-02096","fp":"f0dd588928fb","stateId":520,"easy":"إذا تصدقت ولو بخاتم على مسكين ← أحب من ألف درهم تُهدى للبيت (أثر عائشة)","cause":"أتصدَّقَ بخاتَمي هذا على مسكينٍ","result":"أحَبُّ إليَّ مِن ألفِ درهمٍ أُهديها إلى البيتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إتحاف الخيرة المهرة 3/34","srcLabel":"الطبراني","text":["عن عائشةَ ، رضي اللهُ عنها ، قالتْ : لأن ",["أتصدَّقَ بخاتَمي هذا على مسكينٍ",1]," ",["أحَبُّ إليَّ مِن ألفِ درهمٍ أُهديها إلى البيتِ",2]],"grade":"حسن","narrator":"[القاسم بن عبدالرحمن بن عبدالله بن مسعود]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (1501)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Qyiv7x1m"},{"id":"س-01846","fp":"34177ac2b9e2","stateId":520,"easy":"إذا أعرت أخاك أرضك ← فهو خير لك من أن تأخذ عليها أجرة","cause":"يعيرَ أحدُكم أخاه أرضَه","result":"خيرٌ له مِن أن يأخُذَ عليها كذا وكذا","explicit":true,"otherNeedIds":[55],"ref":"إتحاف الخيرة المهرة 3/355","srcLabel":"متفق عليه","text":["إنما قال النبيُّ صلَّى اللهُ عليه وسلَّم : لأن ",["يعيرَ أحدُكم أخاه أرضَه",1]," ، ",["خيرٌ له مِن أن يأخُذَ عليها كذا وكذا",2]," ، لشيءٍ معلومٍ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"سنده رجاله ثقات","takhrij":"أخرجه البخاري (2330) بنحوه، ومسلم (1550) باختلاف يسير.","bab":"إحسان › الأخذ بالرخصة","dorar":"cfe5Noqk"},{"id":"س-01570","fp":"c07e804336bf","stateId":520,"easy":"إذا منحت منيحة ورق أو ذهب أو سقيت لبناً أو هديت طريقاً ← فهو كعدل رقبة","cause":"مَن مَنَحَ مَنيحةً وَرِقًا، أو ذَهبًا، أو سَقى لَبَنًا، أو هَدى زِقاقًا","result":"فهو كعَدلِ رَقبةٍ","explicit":true,"ref":"تخريج المسند لشعيب 18403","srcLabel":"أحمد","text":[["مَن مَنَحَ مَنيحةً وَرِقًا، أو ذَهبًا، أو سَقى لَبَنًا، أو هَدى زِقاقًا؛ ",1],["فهو كعَدلِ رَقبةٍ",2],"."],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18403) واللفظ له، والبزار (3225)، والطبراني (21/115) (134)","bab":"أشربة › اللبن","dorar":"uPh0EpXl"},{"id":"س-01952","fp":"dc4bdb4e5e3e","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فهو صيام الدهر","cause":"صِيامُ ثلاثةٍ أيَّامٍ من كُلِّ شهرٍ","result":"صِيامُ الدَّهْرِ","explicit":true,"star":true,"ref":"الجامع الصغير 5097","srcLabel":"البيهقي","text":[["صِيامُ ثلاثةٍ أيَّامٍ من كُلِّ شهرٍ",1]," ",["صِيامُ الدَّهْرِ",2]," ، و هِيَ أيامُ البِيضُ : صَبيحةُ ثلاثِ عَشْرَةَ ، و أربعِ عَشْرَةَ و خمسُ عَشْرَةَ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى (7504)، والطبري في ((تهذيب الآثار)) (539)، والبيهقي في ((شعب الإيمان)) (3853)، واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iipCd33X","merged":3,"otherRefs":["تخريج سير أعلام النبلاء 10/477 (حسن)","شرح الإلمام 3/172 (صحيح)"]},{"id":"س-01864","fp":"e0371455b329","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فقد تم لك صوم الشهر","cause":"مَنْ صامَ ثلاثَةَ أيامٍ من كلِّ شهرٍ","result":"فقد تَمَّ لهُ صَوْمُ الشَّهْرِ","explicit":true,"ref":"صحيح الترغيب 1035","srcLabel":"الترمذي","text":[["مَنْ صامَ ثلاثَةَ أيامٍ من كلِّ شهرٍ",1]," ، ",["فقد تَمَّ لهُ صَوْمُ الشَّهْرِ",2]," ، أوْ فَلهُ صَوْمُ الشَّهْرِ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (762)، والنسائي (2410)، وفي ((السنن الكبرى)) (2718) واللفظ له، وابن ماجه (1708)، وأحمد (21301)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Cow3XYJ3"},{"id":"س-06740","fp":"0ae91bf87a07","stateId":521,"easy":"إذا صمت رمضان ثم ستة من شوال ← فكأنما صمت الدهر","cause":"مَن صامَ رمضانَ ثمَّ أتبعَهُ ستَّةَ أيَّامٍ من شوَّالٍ","result":"فَكَأنَّما صامَ الدَّهرَ","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-02138","س-02298"],"ref":"صحيح ابن خزيمة 3/ 518","srcLabel":"مسلم","text":[["مَن صامَ رمضانَ ثمَّ أتبعَهُ ستَّةَ أيَّامٍ من شوَّالٍ، ",1],["فَكَأنَّما صامَ الدَّهرَ",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (1164)، والترمذي (759)، وأحمد (23533) باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"xxp27fSK","merged":2,"otherRefs":["تخريج المسند لشعيب 14710 (صحيح)"]},{"id":"س-00546","fp":"32b86a094488","stateId":521,"easy":"إذا صمت رمضان وستاً بعده ← فذلك صيام السنة","cause":"مَن صام رَمَضانَ وسِتًّا بعدَه","result":"فذلك صيامُ السَّنَةِ","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-06741"],"ref":"تخريج مشكل الآثار 2337","srcLabel":"مسلم","text":[["مَن صام رَمَضانَ وسِتًّا بعدَه",1],"، ",["فذلك صيامُ السَّنَةِ",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2337) واللفظ له، ومسلم (1164)، والترمذي (759) بنحوه.","bab":"آداب عامة › ضرب الأمثال","dorar":"JEjOEx7Z"},{"id":"س-06747","fp":"d0bc183eba65","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فقد صمت الشهر كله","cause":"مَن صام ثلاثةَ أيَّامٍ مِن كلِّ شهرٍ","result":"فقد صام الشَّهرَ كلَّه وقد صُمْتُ ثلاثةَ أيَّامٍ مِن كلِّ شهرٍ وإنِّي الشَّهرَ كلَّه صائمٌ ووجَدْتُ تصديقَ ذلك في كتابِ اللهِ جلَّ وعلا","explicit":true,"star":true,"similar":["س-04056"],"ref":"تخريج صحيح ابن حبان 3659","srcLabel":"مسلم","text":["أنَّ أبا هُرَيرةَ كان في سفرٍ فلمَّا نزَلوا ووُضِعت السُّفرةُ بعَثوا إليه وهو يُصلِّي فقال: إنِّي صائمٌ فلمَّا كادوا أنْ يفرُغُوا جاء فجعَل يأكُلُ فنظَر القومُ إلى رسولِهم فقال: ما تنظُرون إليَّ قد - واللهِ - أخبَرني أنَّه صائمٌ فقال أبو هريرةَ: صدَق سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن صام ثلاثةَ أيَّامٍ مِن كلِّ شهرٍ ",1],["فقد صام الشَّهرَ كلَّه ) وقد صُمْتُ ثلاثةَ أيَّامٍ مِن كلِّ شهرٍ وإنِّي الشَّهرَ كلَّه صائمٌ ووجَدْتُ تصديقَ ذلك في كتابِ اللهِ جلَّ وعلا ",2],"{مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا} [الأنعام: 160]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (10663)، والبزار (9522)، وأبو يعلى (6650) باختلاف يسير","bab":"صيام › فضل الصيام","dorar":"JArAu0sp"},{"id":"س-06741","fp":"fd8af6a09b0a","stateId":521,"easy":"إذا صمت رمضان (بعشرة أشهر) والست (بشهرين) ← فذلك صيام السنة","cause":"صيامُ رَمضانَ بعَشرةِ أشهرٍ، وصيامُ السِّتَّةِ أيَّامٍ بشَهْرينِ","result":"فذلِكَ صيامُ السَّنةِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-00546","ref":"صحيح ابن خزيمة 3/ 519","text":[["صيامُ رَمضانَ بعَشرةِ أشهرٍ، وصيامُ السِّتَّةِ أيَّامٍ بشَهْرينِ",1],"، ",["فذلِكَ صيامُ السَّنةِ",2],"، يَعني رَمضانَ وستَّةَ أيَّامٍ بعدَهُ"],"grade":"صحيح","narrator":"ثوبان","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (2873) باختلاف يسير، وابن ماجه (1715) بنحوه، وأحمد (22412)","bab":"صيام › فضل الصيام","dorar":"jvRo0Vlp","merged":8,"otherRefs":["صحيح الجامع 3851 (صحيح)","تخريج المسند لشعيب 22412 (صحيح)","صحيح الجامع 3094 (صحيح)","صحيح الترغيب 1007 (صحيح)","تخريج مشكل الآثار 2348 (صحيح)","تخريج مشكل الآثار 2349 (صحيح)","صحيح ابن ماجه 1402 (صحيح)"]},{"id":"س-06745","fp":"4a1c66cfdf55","stateId":521,"easy":"إذا صمت رمضان وثلاثة أيام من كل شهر ← فهو صوم الدهر","cause":"صومُ شهرِ الصبرِ وثلاثةِ أيامٍ منَ الشهرِ","result":"صومُ الدهرِ","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-06748","س-07741"],"otherNeedIds":[5],"ref":"إتحاف الخيرة المهرة 3/72","srcLabel":"أحمد","text":["كنا مع أبي هريرةَ في سفَرٍ ، فحضَر الطعامُ ، فبعَثْنا إلى أبي هريرةَ وهو يصلِّي ، فجاء الرسولُ ، فذكَر أنه صائمٌ ، فوُضِع الطعامُ ليؤكَلَ ، وجاء أبو هريرةَ وقد كادوا يُفرِغونَ منه ، فتناوَل فجعَل يأكلُ ، فنظَروا إلى الرجلِ الذي أرسَلوه إلى أبي هريرةَ ، فقال : ما تنظُرونَ إليَّ ، قد واللهِ أخبَرني أنه صائمٌ ! قال : صدَق ، ثم قال أبو هريرةَ : سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ",["صومُ شهرِ الصبرِ وثلاثةِ أيامٍ منَ الشهرِ",1]," ",["صومُ الدهرِ",2]," , فأنا صائمٌ في تضعيفِ اللهِ , عزَّ وجلَّ , ومُفطِرٌ في تخفيفِه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سنده صحيح","takhrij":"أخرجه أحمد (8986)، والطيالسي (2515)، والبيهقي في ((شعب الإيمان)) (3574) واللفظ له","bab":"صيام › فضل الصيام","dorar":"kVOCtaNa","merged":7,"otherRefs":["تخريج المسند لشعيب 6862 (صحيح)","صحيح الجامع 3802 (صحيح)","تخريج صحيح ابن حبان 6226 (صحيح)","تخريج المسند لشعيب 21364 (صحيح)","تخريج المسند لشعيب 8986 (صحيح)","تخريج المسند لشعيب 10663 (صحيح)"]},{"id":"س-03585","fp":"f054ec0153a6","stateId":521,"easy":"إذا صمت الأيام البيض ← فهي صيام الدهر","cause":"بصيامِ البِيضِ","result":"هي صيامُ الدَّهرِ","explicit":true,"similar":["س-02164"],"ref":"تخريج صحيح ابن حبان 3651","srcLabel":"ابن ماجه","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّم يأمُرُهم ",["بصيامِ البِيضِ",1]," ويقولُ: ( ",["هي صيامُ الدَّهرِ",2]," )"],"grade":"صحيح","narrator":"[أبو المنهال قتادة بن ملحان]","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (1321)، وابن حبان (3651) واللفظ لهما، وابن ماجه (1707)، وأحمد (17513)، والبغوي في ((معجم الصحابة)) (5/ 50) بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"LgMttVhE","merged":4,"otherRefs":["تخريج المسند لشعيب 20316 (حسن)","تخريج المسند لشعيب 20319 (حسن)","تخريج المسند لشعيب 17514 (حسن)"]},{"id":"س-06748","fp":"cf329ba80384","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فهو مثل صيام الدهر","cause":"وصُمْ مِن الشَّهرِ ثلاثةَ أيَّامٍ","result":"فإنَّ الحسنةَ بعَشْرِ أمثالِها وذلك مِثْلُ صيامِ الدَّهرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06745","ref":"تخريج صحيح ابن حبان 352","text":["( أُخبِر رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه قال - يعني نفسَه - لأقومَنَّ اللَّيلَ ولأصومَنَّ النَّهارَ ما عِشْتُ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( أنتَ الَّذي تقولُ ذلك ) ؟ فقُلْتُ له: قد قُلْتُه يا رسولَ اللهِ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( فإنَّك لا تستطيعُ ذلك صُمْ وأفطِرْ ونَمْ وقُمْ ",["وصُمْ مِن الشَّهرِ ثلاثةَ أيَّامٍ",1]," ",["فإنَّ الحسنةَ بعَشْرِ أمثالِها وذلك مِثْلُ صيامِ الدَّهرِ",2]," ) قال: قُلْتُ: إنِّي أُطيقُ أفضَلَ مِن ذلك قال: ( صُمْ يومًا وأفطِرْ يومينِ ) قال: قُلْتُ: إنِّي أُطيقُ أفضَلَ مِن ذلك قال: ( صُمْ يومًا وأفطِرْ يومًا وذلك صيامُ داودَ وهو أعدَلُ الصِّيامِ ) قال: فقُلْتُ: فإنِّي أُطيقُ أفضَلَ مِن ذلك قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( لا أفضَلَ مِن ذلك ) قال عبدُ اللهِ: ولأنْ أكونَ قبِلْتُ الثَّلاثةَ الأيَّامَ الَّتي قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم كان أحَبَّ إليَّ مِن أهلي ومالي )"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3418)، ومسلم (1159) باختلاف يسير","bab":"صيام › فضل الصيام","dorar":"WPfWzuVB"},{"id":"س-02164","fp":"374e47cf6a05","stateId":521,"easy":"إذا صمت الأيام البيض ← فهي صيام الشهر","cause":"الأيامِ الثلاثةِ البيضِ","result":"هنَّ صيامُ الشهرِ","explicit":true,"repOf":"س-03585","ref":"صحيح الترغيب 1039","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّم كان يأمُرنا بهذه ",["الأيامِ الثلاثةِ البيضِ",1]," ويقول ",["هنَّ صيامُ الشهرِ",2]],"grade":"صحيح","narrator":"[قتادة] بن ملحان","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (2430) بلفظه، وأحمد (20319) بلفظ مقارب، وأبو داود (2449)، وابن ماجه (1707) كلاهما بنحوه مطولا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1UAHhI3V","merged":2,"otherRefs":["تخريج المسند لشعيب 20321 (حسن)"]},{"id":"س-02138","fp":"b8d830a09458","stateId":521,"easy":"إذا صمت رمضان ثم ستة أيام من شوال ← فكأنما صمت السنة","cause":"مَن صام شَهرَ رَمَضانَ ثم أتْبَعَه بسِتَّةِ أيامٍ من شوَّالٍ","result":"فكأنَّما صام السَّنَةَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06740","ref":"تخريج مشكل الآثار 2347","text":["عن أبي أيُّوبَ الأنصاريِّ، ولم يَرفَعْه أنَّه قال: ",["مَن صام شَهرَ رَمَضانَ ثم أتْبَعَه بسِتَّةِ أيامٍ من شوَّالٍ، ",1],["فكأنَّما صام السَّنَةَ",2],"."],"grade":"صحيح","narrator":"عمر بن ثابت","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2347) واللفظ له، والنسائي في ((الكبرى)) (2878)، والحميدي (384) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"aEd89ue8"},{"id":"س-02202","fp":"dd93541705f9","stateId":521,"easy":"إذا صمت رمضان في المسجد النبوي ← فهو أفضل من ألف رمضان فيما سواه إلا المسجد الحرام","cause":"وشهرُ رمضانَ في مسجدي هذا","result":"أفضلُ من ألفِ شهرِ رمضانَ فيما سواه إلَّا المسجدَ الحرامَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الترغيب والترهيب 2/207","srcLabel":"البيهقي","text":["الصَّلاةُ في مسجدي هذا أفضلُ من ألفِ صلاةٍ فيما سواه إلَّا المسجدَ الحرامَ والجمعةُ في مسجدي هذا أفضلُ من ألفِ جمعةٍ فيما سواه إلَّا المسجدَ الحرامَ ",["وشهرُ رمضانَ في مسجدي هذا",1]," ",["أفضلُ من ألفِ شهرِ رمضانَ فيما سواه إلَّا المسجدَ الحرامَ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4147)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"QV9x0Mtn"},{"id":"س-02298","fp":"49d650711048","stateId":521,"easy":"إذا صمت رمضان ثم أتبعته ستة أيام من شوال ← فذلك صيام الدهر","cause":"مَن صامَ رَمَضانَ، ثُمَّ أَتبَعَه بسِتَّةِ أيَّامٍ مِن شَوَّالٍ","result":"فذلك صِيامُ الدَّهْرِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-06740","ref":"علل ابن أبي حاتم 775","text":["حَديثٌ اخْتُلِفَ في الرِّوايةِ على بَكْرِ بنِ مُضَرَ: فرَواه قُتَيْبةُ بنُ سَعيدٍ، عن بَكْرِ بنِ مُضَرَ، عن عَمْرِو بنِ جابِرٍ، عن جابِرِ بنِ عَبْدِ اللهِ، مَوْقوف، قالَ: ",["مَن صامَ رَمَضانَ، ثُمَّ أَتبَعَه بسِتَّةِ أيَّامٍ مِن شَوَّالٍ ",1],["فذلك صِيامُ الدَّهْرِ",2],". رَواه مَوْقوف. \nورَواه يَحْيى بنُ عَبْدِ اللهِ بنِ بُكَيْرٍ، ويَزيدُ بنُ مَوهَبٍ، عن بَكْرِ بنِ مُضَرَ، عن عَمْرِو بنِ جابِرٍ، عن جابِرٍ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم، مَرْفوع؟"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"المَرْفوعُ صَحيحٌ.","takhrij":"أخرجه أحمد (14302)، والطبراني في ((الأوسط)) (3192), والبزار كما في ((كشف الأستار)) (1062)، وتمام في ((فوائده (935) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"4K4B5yHK"},{"id":"س-07741","fp":"6903e92707b9","stateId":521,"easy":"إذا صمت ثلاثة أيام من كل شهر ← فذلك صوم الدهر","cause":"مَن صامَ ثلاثةَ أيَّامٍ مِن كلِّ شَهرٍ","result":"فذلِكَ صَومُ الدَّهرِ فأنزلَ اللَّهُ عزَّ وجلَّ تَصديقَ ذلِكَ في كتابِهِ مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا فاليومُ بعَشرةِ أيَّامٍ","explicit":true,"repOf":"س-06745","otherNeedIds":[45],"ref":"صحيح ابن ماجه 1396","text":[["مَن صامَ ثلاثةَ أيَّامٍ مِن كلِّ شَهرٍ ",1],["فذلِكَ صَومُ الدَّهرِ فأنزلَ اللَّهُ عزَّ وجلَّ تَصديقَ ذلِكَ في كتابِهِ  مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا  فاليومُ بعَشرةِ أيَّامٍ",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (762)، والنسائي (2409)، وابن ماجه (1708) واللفظ له، وأحمد (21301)","bab":"قرآن › أسباب النزول","dorar":"kur94GGb"},{"id":"س-01945","fp":"fca17be3503a","stateId":521,"easy":"إذا صمت رمضان وما يليه وكل أربعاء وخميس ← فكأنك صمت الدهر","cause":"صُم رَمضانَ والَّذي يليهِ، وَكلَّ أربعاءَ وخميسٍ","result":"فإذا أنتَ قد صمتَ الدَّهرَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"الجامع الصغير 5021","srcLabel":"أبو داود","text":[["صُم رَمضانَ والَّذي يليهِ، وَكلَّ أربعاءَ وخميسٍ",1],"، ",["فإذا أنتَ قد صمتَ الدَّهرَ",2]],"grade":"حسن","narrator":"مسلم القرشي","muhaddith":"حسن","takhrij":"أخرجه أبو داود (2432)، والترمذي (748)، والبيهقي في ((شعب الإيمان)) (3586) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JOSTvLTJ"},{"id":"س-02257","fp":"304f8165f419","stateId":521,"easy":"إذا فطّرت صائماً فأطعمته وسقيته ← فلك مثل أجره","cause":"من فَطَّر صائمًا أطعَمَه","result":"وسقاه، كان له مِثْلُ أجْرِه","explicit":true,"otherNeedIds":[45],"ref":"الضعفاء الكبير 1/225","srcLabel":"البيهقي","text":[["من فَطَّر صائمًا أطعَمَه ",1],["وسقاه، كان له مِثْلُ أجْرِه",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"لا يبين ابن جريج شيئاً فيه السماع من صالح","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (1/225)، وأبو نعيم في ((تاريخ أصبهان)) (2/192)، والبيهقي في ((شعب الإيمان)) (3954)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"HNCpVV8H"},{"id":"س-06758","fp":"00f77fcbc43c","stateId":521,"easy":"إذا صمت أيام العشر (قبل الأضحى) ← فكل يوم كالشهر","cause":"صيامُ الأضحَى كلَّ يومٍ منها","result":"كالشَّهرِ","explicit":true,"ref":"مختصر الأحكام 3/410","srcLabel":"الطوسي","text":[["صيامُ الأضحَى كلَّ يومٍ منها",1]," ",["كالشَّهرِ",2]],"grade":"حسن","narrator":"عبادة بن الصامت","muhaddith":"حسن غريب","takhrij":"أخرجه الطوسي في ((مختصر الأحكام)) (3/ 409) واللفظ له.","bab":"صيام › فضل الصيام","dorar":"m6pHuMdf"},{"id":"س-04056","fp":"060cb89c348f","stateId":521,"easy":"إذا صمت ثلاثة أيام من الشهر ← وجب لك أجره كله","cause":"إنِّي صُمْتُ ثلاثةَ أيامٍ من هذا الشهْرِ","result":"فوجَبَ لي أجْرُه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-06747","ref":"تخريج المسند لشعيب 21339","text":["أتَيْتُ أبا ذَرٍّ، فلم أجِدْه، ورَأيْتُ المرأةَ فسأَلْتُها، فقالت: هو ذاك في ضَيْعةٍ له، فجاءَ يَقودُ، أو يَسوقُ بَعيرَيْنِ، قاطرًا أحَدَهما في عَجُزِ صاحِبِه، في عُنُقِ كلِّ واحدٍ منهما قِربةٌ، فوضَعَ القِربَتيْنِ، قُلْتُ: يا أبا ذَرٍّ، ما كان منَ الناسِ أحَدٌ أحَبَّ إليَّ أنْ أَلْقاهُ منكَ، ولا أبغَضَ أنْ أَلْقاهُ منكَ، قال: للهِ أبوكَ، وما يَجمَعُ هذا؟ قال: قُلْتُ: إنِّي كُنْتُ وَأدْتُ في الجاهليَّةِ، وكُنْتُ أَرْجو في لِقائِكَ أنْ تُخبِرَني أنَّ لي تَوبةً ومَخرَجًا، وكُنْتُ أَخْشى في لِقائِكَ أنْ تُخبِرَني أنَّه لا تَوبةَ لي، فقال: أفي الجاهليَّةِ؟ قُلْتُ: نَعَمْ، فقال: عَفا اللهُ عمَّا سلَفَ، ثُم عاجَ برأسِه إلى المرأةِ، فأمَرَ لي بطَعامٍ، فالتَوَتْ عليه، ثُم أمَرَها فالتَوَتْ عليه، حتى ارتَفَعَتْ أصواتُهما، قال: إيهًا، دَعينا عنكِ؛ فإنَّكُنَّ لن تَعْدُونَ ما قال لنا فيكُنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُلْتُ: وما قال لكم فيهِنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: المرأةُ ضِلَعٌ، فإنْ تَذهَبْ تُقَوِّمُها تَكسِرْها، وإنْ تَدَعْها ففيها أَوَدٌ وبُلْغةٌ، فوَلَّتْ فجاءَتْ بثَريدةٍ كأنَّها قَطاةٌ، فقال: كُلْ ولا أَهولَنَّكَ، إنِّي صائمٌ، ثُم قامَ يُصلِّي، فجعَلَ يُهذِّبُ الركوعَ ويُخفِّفُه، ورَأيْتُه يَتَحرَّى أنْ أشبَعَ أو أُقارِبَ، ثُم جاءَ فوضَعَ يَدَه معي، فقُلْتُ: إنَّا للهِ وإنَّا إليه راجِعونَ، فقال: ما لكَ؟ فقُلْتُ: مَن كُنْتُ أَخْشى منَ الناسِ أنْ يَكذِبَني، فما كُنْتُ أَخْشى أنْ تَكذِبَني، قال: للهِ أبوكَ، إنْ كذَبْتُكَ كَذْبةً منذ لَقيتَني، فقال: ألم تُخبِرْني أنَّكَ صائمٌ، ثُم أراكَ تأكُلُ؟ قال: بَلى، ",["إنِّي صُمْتُ ثلاثةَ أيامٍ من هذا الشهْرِ",1],"، ",["فوجَبَ لي أجْرُه",2],"، وحَلَّ لي الطعامُ معكَ."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9152) المرفوع منه، وأحمد (21339) واللفظ له","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"pfpPzGmr"},{"id":"س-02010","fp":"a46500887f95","stateId":521,"easy":"إذا صمت رمضان ثم أتبعته ستاً من شوال ← كأنك صمت الدهر","cause":"مَن صامَ رَمَضانَ ثُمَّ أتْبَعَهُ سِتًّا مِن شَوَّالٍ","result":"كانَ كَصِيامِ الدَّهْرِ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"ref":"مجموع رسائل العلائي 1/322","srcLabel":"مسلم","text":["حديث أبي أيُّوبَ رَضِي اللهُ عنه في صِيامِ السِّتَّةِ أيَّامٍ مِن شَوَّالٍ [يعني حديث: ",["مَن صامَ رَمَضانَ ثُمَّ أتْبَعَهُ سِتًّا مِن شَوَّالٍ، ",1],["كانَ كَصِيامِ الدَّهْرِ",2],".]"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح محتج به لا مطعن لأحد فيه","takhrij":"أخرجه مسلم (1164)، والترمذي (759)، وأحمد (23533) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OvIrgeT8"},{"id":"س-01998","fp":"5bd7c040e180","stateId":521,"easy":"إذا صمت يوم عرفة ← يكفّر سنتين: ماضية ومقبلة","cause":"صَوْمُ يومِ عرَفةَ","result":"بسنَتَينِ: سنَةٍ مُقبِلةٍ، وسنَةٍ متأخِّرةٍ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"ref":"التنوير شرح الجامع الصغير 7/219","srcLabel":"ابن جميع","text":["عدَلَ ",["صَوْمُ يومِ عرَفةَ",1]," ",["بسنَتَينِ: سنَةٍ مُقبِلةٍ، وسنَةٍ متأخِّرةٍ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"ثابت المتن","takhrij":"أخرجه ابن جميع الصيداوي في ((معجم الشيوخ)) (ص238)، وتمام في ((الفوائد)) (1584) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"kzGQXspO"},{"id":"س-01579","fp":"5bf5d33b1798","stateId":521,"easy":"إذا صمت يوم عرفة ← يعدل ألف يوم (أثر)","cause":"يومَ عرفةَ","result":"كان يعدله بألفِ يومٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"يوم عرفة"},"ref":"المتجر الرابح 139","srcLabel":"الطبراني","text":["عن مسروقٍ: أنه دخل على عائشةَ رضي الله عنها ",["يومَ عرفةَ",1]," فقال: أسقوني فقالت عائشةُ رضي الله عنها: يا غلامُ اسقِهِ عسلًا ثم قالت عائشةُ: وما أنت يا مسروقُ بصائمٍ؟ قال: لا، إني أخافُ أن يكونَ يومَ الأضحى فقالت عائشةُ: ليس ذلك إنما عرفةُ يومَ يعرِّفُ الإمامُ، ويومُ النحرِ يومَ ينحرُ الإمامُ، أوما سمعتَ يا مسروقُ أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ",["كان يعدله بألفِ يومٍ",2],"؟!"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه الطبراني في ((الأوسط)) (6802)، وابن حجر في ((الأمالي المطلقة)) (صـ142) باختلاف يسير، والطحاوي في ((مشكل الآثار)) (339) بنحوه.","bab":"أشربة › ما يحل من الأشربة","dorar":"C7V8r1ZN"},{"id":"س-07528","fp":"1d6b92c64d8a","stateId":522,"easy":"إذا اعتمرت في رمضان ← تعدل حجة مع النبي ﷺ","cause":"أَقرِئْها السَّلامَ ورَحْمةَ اللهِ وأَخْبِرْها أنَّه","result":"تَعدِلُ حَجَّةً معي عُمْرةٌ في رَمضانَ","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"similar":["س-02066","س-02193","س-07233","س-02157","س-03575"],"ref":"الأحاديث المختارة 9 / 514","srcLabel":"متفق عليه","text":["«أرادَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الحَجَّ، فقالَتِ امْرأةٌ لزَوْجِها: احْجُجْني معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: ما عِنْدي ما أُحِجُّك به عليه، قالَت: احْجُجْني على جَمَلِك فُلانٍ، فقالَ: ذاك حَبيسٌ في سَبيلِ اللهِ، قالَت: احْجُجْني على ناضِحِك، قالَ: ذاك نَعْتَقِبُه أنا وأنتِ، قالَت: فبِعْ ثَمَرتَك، قالَ: ذاك قُوتي وقُوتُك، فلمَّا قَدِمَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أَرسَلَتْ زَوْجَها إليه، فقالَتْ: أَقرِئْه السَّلامَ ورَحْمةَ اللهِ، وسَلْه ما يَعدِلُ حَجَّةً معَك؟ فأتى رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقالَ: يا رَسولَ اللهِ امْرَأتي تَقرَأُ عليك السَّلامَ ورَحْمةَ اللهِ، وإنَّها كانَتْ سَألَتْني الحَجَّ معَك، فقُلْتُ: ما عِنْدي ما أُحِجُّك عليه، فقالَتْ: أَحِجَّني على جَمَلِك فُلانٍ، فقُلْتُ: ذاك حَبيسٌ في سَبيلِ اللهِ، قالَ: أَمَا إنَّك لو أَحْجَجْتَها عليه كانَت في سَبيلِ اللهِ، قالَتْ: فأَحِجَّني على ناضِحِك، قُلْتُ: ذاك نَعْتَقِبُه أنا وأنتِ، قالَتْ فبِعْ ثَمَرتَك، قُلْتُ: ذاك قُوتي وقُوتُك، فضَحِكَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مِن حِرْصِها على الحَجِّ، قالَ: فإنَّها أَمَرَتْني أن أَسأَلَك ما يُجزِئُ حَجَّةً معَك؟ فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["أَقرِئْها السَّلامَ ورَحْمةَ اللهِ وأَخْبِرْها أنَّه ",1],["تَعدِلُ حَجَّةً معي عُمْرةٌ في رَمضانَ»",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › اختصام المؤمنين إليه صلى الله عليه وسلم وحكمه عليهم","dorar":"YuXGPJ6s","merged":3,"otherRefs":["صحيح ابن خزيمة 4/ 604 (صحيح)","المجموع للنووي 6/212 (صحيح)"]},{"id":"س-02066","fp":"c9e21e808cb0","stateId":522,"easy":"إذا اعتمرت في رمضان ← تعدل حجة مع النبي ﷺ","cause":"فعُمرةٌ في رَمَضانَ","result":"تَقضي حَجَّةً، أو حَجَّةً مَعي","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-07528","ref":"صحيح مسلم 1256","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم قال لامرَأةٍ مِنَ الأنصارِ يُقالُ لَها أُمُّ سِنانٍ: ما مَنَعَكِ أن تَكوني حَجَجتِ معنا؟ قالت: ناضِحانِ كانا لأبي فُلانٍ، زَوجِها، حَجَّ هو وابنُه على أحَدِهما، وكان الآخَرُ يَسقي عليه غُلامُنا، قال: ",["فعُمرةٌ في رَمَضانَ",1]," ",["تَقضي حَجَّةً، أو حَجَّةً مَعي",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1863) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Ug1vm2hP"},{"id":"س-02193","fp":"36d9f0a82573","stateId":522,"easy":"إذا اعتمرت في رمضان ← تعدل حجة","cause":"فإذا جاءَ رَمَضانُ فاعتَمِري","result":"فإنَّ عُمرةً فيه تَعدِلُ حَجَّةً","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-07528","ref":"صحيح مسلم 1256","text":["سَمِعتُ ابنَ عَبَّاسٍ يُحَدِّثُنا، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لامرَأةٍ مِنَ الأنصارِ، سَمَّاها ابنُ عَبَّاسٍ فنَسيتُ اسمَها: ما مَنَعَكِ أن تَحُجِّي معنا؟ قالت: لَم يَكُنْ لَنا إلَّا ناضِحانِ، فحَجَّ أبو ولَدِها وابنُها على ناضِحٍ وتَرَكَ لَنا ناضِحًا نَنضِحُ عليه، قال: ",["فإذا جاءَ رَمَضانُ فاعتَمِري؛ ",1],["فإنَّ عُمرةً فيه تَعدِلُ حَجَّةً",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1863) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"3R0bG4xo"},{"id":"س-02240","fp":"31e6cce7b3cb","stateId":522,"easy":"إذا اعتمرت في رمضان ← فهي كحجة","cause":"فإذا كان رَمَضانُ اعتَمِري فيه","result":"فإنَّ عُمرةً في رَمَضانَ حَجَّةٌ، أو نَحوًا ممَّا قال","explicit":true,"star":true,"apply":{"k":"time","t":"في رمضان"},"ref":"صحيح البخاري 1782","srcLabel":"مسلم","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لامرَأةٍ مِنَ الأنصارِ -سَمَّاها ابنُ عَبَّاسٍ فنَسيتُ اسمَها-: ما مَنَعَكِ أن تَحُجِّينَ معنا؟ قالت: كان لَنا ناضِحٌ، فرَكِبَه أبو فُلانٍ وابنُه -لزَوجِها وابنِها- وتَرَكَ ناضِحًا نَنضَحُ عليه، قال: ",["فإذا كان رَمَضانُ اعتَمِري فيه؛ ",1],["فإنَّ عُمرةً في رَمَضانَ حَجَّةٌ، أو نَحوًا ممَّا قال",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1256) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Vbcr6heb"},{"id":"س-07233","fp":"42ac1625514a","stateId":522,"easy":"إذا اعتمرت في رمضان ← تعدل حجة","cause":"عمرةً في رمضانَ","result":"تعْدِلُ حجةً","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-07528","ref":"المجموع للنووي 6/212","text":["أرادَ رسولُ اللهِ صلى الله عليه وسلم الحجّ فقالتْ امرأةٌ لزوجها : أحججنِي مع رسولِ اللهِ صلى الله عليه وسلم فقال : ما عندِي ما أحجّكِ عليهِ . فقالت : أحججني على جملِكَ فلان . قال : ذلكَ حبيسِي في سبيلِ اللهِ عز وجلَ . فأتى رسولَ اللهِ صلى الله عليه وسلم فقال : إن امرأتِي تقرأ عليكَ السلامُ ورحمةُ اللهِ ، إنها سألتني الحجّ معكَ قالت : أحججْني مع رسولِ اللهِ صلى الله عليه وسلم فقلت : ما عندي ما أحجّكِ عليهِ . فقالت : أحجُجْني على جملكَ فلان . فقلت : ذلكَ حبيسي في سبيلِ اللهِ فقال : أما إنكَ لو حججْتها عليهِ كانَ في سبيلِ اللهِ وإنها أمرتنِي أن أسألكَ ما يعدِلُ حجّةٌ معكَ . قال رسولُ اللهِ صلى الله عليه وسلم : أقرئها السلامَ ورحمةُ اللهِ وبركاتهُ وأخبرها أنها ",["تعْدِلُ حجةً",2]," – يعني ",["عمرةً في رمضانَ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1990)، والطبراني (12/208) (12911)","bab":"علم › سؤال العالم عما لا يعلم","dorar":"kRQ4fsBf","merged":5,"otherRefs":["المستدرك على الصحيحين 1797 (صحيح)","تخريج المسند لشعيب 27106 (صحيح)","تخريج المسند لشعيب 27291 (صحيح)","الصحيح المسند 1234 (حسن)"]},{"id":"س-02023","fp":"de57a9cb316f","stateId":522,"easy":"إذا اغتسلت يوم الجمعة وبكّرت ومشيت ولم تركب ← لك بكل خطوة عمل سنة صيامها وقيامها","cause":"مَن غَسَّلَ يَوْمَ الجُمُعةِ واغْتَسَلَ، ثُمَّ بَكَّرَ وابْتَكَرَ، ومَشى ولم يَركَبْ، ودَنا مِن الإمامِ فاسْتَمَعَ ولم يَلْغُ","result":"كانَ له بكلِّ خُطْوةٍ عَمَلُ سَنَةٍ، أجْرُ صِيامِها وقِيامِها","explicit":true,"apply":{"k":"time","t":"يوم الجمعة أو ليلتها"},"otherNeedIds":[45],"ref":"الأحكام الوسطى 2/ 97","srcLabel":"أبو داود","text":[["مَن غَسَّلَ يَوْمَ الجُمُعةِ واغْتَسَلَ، ثُمَّ بَكَّرَ وابْتَكَرَ، ومَشى ولم يَركَبْ، ودَنا مِن الإمامِ فاسْتَمَعَ ولم يَلْغُ؛ ",1],["كانَ له بكلِّ خُطْوةٍ عَمَلُ سَنَةٍ، أجْرُ صِيامِها وقِيامِها",2],"."],"grade":"صحيح","narrator":"أوس بن أوس","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (345)، والترمذي (496)، وابن ماجه (1087) واللفظ لهم","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Rdhx3JZT","merged":2,"otherRefs":["صحيح ابن حبان 2781 (صحيح)"]},{"id":"س-04432","fp":"1fc0c7818531","stateId":522,"easy":"إذا حججت وأنت ضعيف ← فالحج جهادك","cause":"الحجُّ","result":"جهادُ كلِّ ضعيفٍ","explicit":true,"ref":"الترغيب والترهيب 2/166","srcLabel":"أحمد","text":[["الحجُّ",1]," ",["جهادُ كلِّ ضعيفٍ",2],"."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجة (2902 )، وأحمد (26563 )، وأبو يعلى (6916 )، والقضاعي في ((الشهاب)) (80 )","bab":"جهاد › فضل الجهاد","dorar":"EvDM9Hss","merged":2,"otherRefs":["التمهيد 21/20 (حسن)"]},{"id":"س-02157","fp":"0320dea18412","stateId":522,"easy":"إذا اعتمرت في رمضان ← فهي تعدل الحج مع النبي ﷺ","cause":"عُمرةٌ في رمضانَ","result":"ما يعدلُ الحجَّ معكَ","explicit":true,"apply":{"k":"time","t":"في رمضان"},"repOf":"س-07528","ref":"الزواجر عن اقتراف الكبائر 1/205","text":[["ما يعدلُ الحجَّ معكَ",2]," ؟ قالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ ",["عُمرةٌ في رمضانَ",1]],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ApjT4Xni"},{"id":"س-02224","fp":"b42e9ef4eb6e","stateId":522,"easy":"إذا طفت أسبوعاً تحصيه ← فهو كعتق رقبة","cause":"من أحصى أسبوعًا","result":"كان كعتقِ رقبةٍ","explicit":true,"similar":["س-03401","س-03561"],"ref":"صحيح الترغيب 1139","srcLabel":"الترمذي","text":[["من أحصى أسبوعًا ",1],["كان كعتقِ رقبةٍ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن خزيمة (2753) بلفظه مطولًا، والترمذي (959)، وأبو يعلى (5687) باختلاف يسير مطولًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"iZLQt85O"},{"id":"س-03401","fp":"e075c0577c2b","stateId":522,"easy":"إذا طفت بالبيت أسبوعاً تحصيه وصليت ركعتين ← فهو كعتق رقبة","cause":"مَن طاف بِهَذا البيتِ أسبوعًا يُحصيهِ، فيُصلِّي رَكْعتينِ","result":"كانَ كعِتقِ رقَبةٍ، وما وضَعَ رجلٌ قدمًا، ولا رفَعها ؛ إلَّا كتبَ اللَّهُ لهُ بِها حسَنةً، ومحا عنه بها سيِّئةً، ورفع لهُ بِها درجةً","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-02224","otherNeedIds":[45,11],"ref":"هداية الرواة 2513","text":[["مَن طاف بِهَذا البيتِ أسبوعًا يُحصيهِ، فيُصلِّي رَكْعتينِ ",1],["كانَ كعِتقِ رقَبةٍ، وما وضَعَ رجلٌ قدمًا، ولا رفَعها ؛ إلَّا كتبَ اللَّهُ لهُ بِها حسَنةً، ومحا عنه بها سيِّئةً، ورفع لهُ بِها درجةً ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (959)، وأحمد (4462) باختلاف يسير، وابن ماجه (2956) مختصراً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"gdonISz6"},{"id":"س-03528","fp":"2de8d6058134","stateId":522,"easy":"إذا طفت سبعاً ← فهو يعدل رقبة","cause":"مَن طافَ سَبْعًا","result":"فهو يَعدِلُ رَقَبةً","explicit":true,"similar":["س-01113"],"ref":"الأحكام الوسطى 2/285","srcLabel":"الأحكام الوسطى","text":["عن عُبَيْدِ اللهِ بنِ عُبَيْدِ بنِ عُمَيْرٍ أنَّ رَجُلًا قالَ: يا أبا عَبْدِ الرَّحْمنِ، ما أَراك تَستَلِمُ إلَّا هذَينِ الرُّكْنَينِ، قالَ: إنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"إنَّ مَسْحَهما يَحُطُّ الخَطيَّةَ\"، وسَمِعْتُه يقولُ: \"",["مَن طافَ سَبْعًا ",1],["فهو يَعدِلُ رَقَبةً\"",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","bab":"استغفار › مكفرات الذنوب","dorar":"Y9hOASVg"},{"id":"س-03561","fp":"459388d247f8","stateId":522,"easy":"إذا طفت بالبيت أسبوعاً فأحصيته ← فهو كعتق رقبة","cause":"مَنْ طافَ بِهذا البيتِ أُسْبُوعًا فأَحْصاهُ","result":"كان كَعِتْقِ رَقَبَةٍ وسَمِعْتُهُ يَقولُ لا يَضَعُ قَدَمًا ولا يَرْفَعُ أُخْرَى إِلَّا حَطَّ اللهُ عنْهُ خَطِيئَتَهُ وكُتِبَ له بِها حَسنةٌ","explicit":true,"repOf":"س-02224","otherNeedIds":[11],"ref":"صحيح الترمذي 959","text":["أنَّ ابنَ عُمرَ كان يُزاحِمُ على الركنينِ زِحامًا ما رأيتُ أحدًا مِن أصحابِ النَّبيِّ صلَّى اللهُ علَيه وسلَّم يَفعلُه، فقلتُ: يا أبا عبد الرحمن، إنَّك تُزاحِمُ على الُّركنينِ زِحامًا ما رأيتُ أحدًا من أصحابِ النَّبيِّ صلَّى اللهُ علَيه وسلَّم يُزاحِمُ عليه؟! فقال: إنْ أفعلْ، فإنِّي سمعتُ رسولَ اللهِ صلَّى اللهُ علَيه وسلَّم يقولُ: إنَّ مَسْحَهُما كفَّارةٌ لِلخطايا وسَمِعْتُهُ يَقولُ ",["مَنْ طافَ بِهذا البيتِ أُسْبُوعًا فأَحْصاهُ ",1],["كان كَعِتْقِ رَقَبَةٍ وسَمِعْتُهُ يَقولُ لا يَضَعُ قَدَمًا ولا يَرْفَعُ أُخْرَى إِلَّا حَطَّ اللهُ عنْهُ خَطِيئَتَهُ وكُتِبَ له بِها حَسنةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (959) مطولاً واللفظ له، والنسائي (2919) مطولاً باختلاف يسير، وأحمد (4462) بنحوه","bab":"استغفار › مكفرات الذنوب","dorar":"PxAvHfZU"},{"id":"س-08445","fp":"68a4aed4edd5","stateId":522,"easy":"إذا طفت بالبيت وصليت ركعتين ← فهو كعتق رقبة","cause":"من طافَ بالبيتِ ، وصلَّى ركعتينِ","result":"كان كعِتقِ رقبةٍ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"صحيح الترغيب 1142","srcLabel":"الترمذي","text":[["من طافَ بالبيتِ ، وصلَّى ركعتينِ ؛ ",1],["كان كعِتقِ رقبةٍ ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (2956) واللفظ له، وأخرجه الترمذي (959)، وأحمد (4462) مطولاً باختلاف يسير","bab":"مناقب وفضائل › مكة شرفها الله تعالى","dorar":"FyPXu68Z"},{"id":"س-01113","fp":"54c7fcb3f47e","stateId":522,"easy":"إذا طفت بالبيت سبعاً تذكر الله ← فهو كعدل رقبة تعتقها","cause":"من طاف بالبَيتِ سَبعًا يَذكُرُ اللهَ فيه","result":"كان كعَدْلِ رَقبةٍ، وزاد في روايةٍ: يُعتِقُها، وفيها بَدَلَ يَذكُرُ اللهَ: لا يَلْغُو فيه","explicit":true,"repOf":"س-03528","ref":"الفتوحات الربانية 4/383","text":[["من طاف بالبَيتِ سَبعًا يَذكُرُ اللهَ فيه، ",1],["كان كعَدْلِ رَقبةٍ، وزاد في روايةٍ: يُعتِقُها، وفيها بَدَلَ يَذكُرُ اللهَ: لا يَلْغُو فيه",2]],"grade":"حسن","narrator":"[المنكدر بن عبد الله، والد محمد]","muhaddith":"حسن","takhrij":"أخرجه الحاكم (5925)، والطبراني في ((المعجم الكبير)) (845) (20/ 360)، وأبو نعيم في ((معرفة الصحابة)) (6267) بنحوه تامًا.","bab":"أدعية وأذكار › فضل الذكر","dorar":"o6Kny2zO"},{"id":"س-03404","fp":"6a093310a8ea","stateId":522,"easy":"إذا طفت أسبوعاً تحصيه وصليت ركعتين ← فلك عدل رقبة وبكل قدم حسنة","cause":"من طافَ أُسبوعا يُحصيهِ وصلَّى ركعتينِ","result":"فلهُ عدلُ رقبةٍ أو نسمةٍ ، وما رفعَ رجلٌ قدمهُ ، ولا وضعَها إلا كتبَ له اللهُ بها حسنةً ، ومحَا عنهُ بها خطيئةً ، ورفعَ لهُ بها درجَةً","explicit":true,"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[45,11],"ref":"شرح السنة 4/77","srcLabel":"الترمذي","text":["عن عبد الله بن عبيدِ بن عُمَيْرٍ أن أباه سأل ابن عمرَ : ما لِيْ أراكَ لا تستلمُ إلا هذينِ الركنينِ لا تسْتلمُ غيرهما -يعني الحجرَ الأسودَ ، والركنَ اليمانيَّ -؟ قال : إنْ أَفعلْ ، فإنِّي سمعتُ رسولَ اللهِ صلى الله عليه وسلم يقول : إنَّ استلامهُما يحطَّانِ الخطايا . وسمعتُه يقول : ",["من طافَ أُسبوعا يُحصيهِ وصلَّى ركعتينِ ، ",1],["فلهُ عدلُ رقبةٍ أو نسمةٍ ، وما رفعَ رجلٌ قدمهُ ، ولا وضعَها إلا كتبَ له اللهُ بها حسنةً ، ومحَا عنهُ بها خطيئةً ، ورفعَ لهُ بها درجَةً",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن","takhrij":"أخرجه الترمذي (959)، وأحمد (4462) باختلاف يسير، وابن ماجه (2956) مختصراً باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"laOKlrlW"},{"id":"س-03575","fp":"97b67a6279c3","stateId":522,"easy":"إذا اعتمرت في رمضان ← فهي تعدل حجة","cause":"إذا فاتتكِ حجَّةٌ معَنا يا أمَّ مَعقلٍ فاعتَمري عُمرةً في رمضانَ","result":"فإنَّها حجَّةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"في رمضان"},"repOf":"س-07528","ref":"حجة الوداع 128","text":["لمَّا تَهَيَّأَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ لحجَّةِ الوداعِ أمرَ النَّاسَ بالخروجِ معَهُ ، أصابتهُم هذِهِ القرحةُ الجُدريُّ أوِ الحصبةُ قالت : فدخلَ ما شاءَ اللَّهُ أن يدخلَ لمرضِ أبي مَعقلٍ ومَرِضْتُ معَهُ وذَكَرتُ حديثًا طويلًا فقالت : قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ : ",["إذا فاتتكِ حجَّةٌ معَنا يا أمَّ مَعقلٍ فاعتَمري عُمرةً في رمضانَ ",1],["فإنَّها حجَّةٌ",2]],"grade":"صحيح","narrator":"أم معقل الأسدية","muhaddith":"إسناده متصل صحيح[كما ذكر في المقدمة]","takhrij":"أخرجه مطولا بنحوه أبو داود (1989) بنحوه، والترمذي (939)، والنسائي في ((السنن الكبرى)) (4227)، وأحمد (27285) مختصرا بنحوه، وابن حزم في ((حجة الوداع)) (3) واللفظ له","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"YnlVYGja"},{"id":"س-03248","fp":"1a114c6cb97c","stateId":522,"easy":"إذا صليت ركعتي الطواف ← فهما كعتق رقبة","cause":"وإنَّ ركعتَي الطَّوافِ","result":"كَعِتقِ رقبةٍ مِن بَني إسماعيلَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الزواجر عن اقتراف الكبائر 1/205","srcLabel":"الزواجر عن اقتراف الكبائر","text":["إنَّ مَن أمَّ البَيتَ لا تضعُ ناقتُهُ خُفًّا ولا ترفعُهُ إلَّا كُتِبَ لَه بهِ حسنةٌ ومُحِيَ عنهُ خَطيئةٌ ، ",["وإنَّ ركعتَي الطَّوافِ",1]," ",["كَعِتقِ رقبةٍ مِن بَني إسماعيلَ",2]," والسَّعيَ كَعِتقِ سبعينَ رقبةً ، والوقوفَ تُغفَرُ بهِ الذُّنوبُ ، وإن كانت بعدَدِ الرَّملِ أو كقَطرِ المطرِ ، أو كزَبَدِ البحرِ ، وبكلِّ حصاةٍ مِن الجِمارِ تكفيرُ كبيرةٍ مِن الموبِقاتِ والنَّحرَ مَذخورٌ عندَ اللهِ ، وبكلِّ شعرةٍ حُلِقَت حسنةٌ ومَحوُ خَطيئةٍ ، وبالطَّوافِ بعدَ ذلكَ يضعُ مَلكٌ يدَيهِ بينَ كتفَيهِ فَيقولُ : اعمَل فيما استُقبِلَ ، فقَد غُفِرَ لكَ ما مضَى"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"استغفار › أسباب المغفرة","dorar":"JXahJfeA"},{"id":"س-03249","fp":"60c3e9f9001c","stateId":522,"easy":"إذا سعيت بين الصفا والمروة ← فهو كعتق سبعين رقبة","cause":"والسَّعيَ","result":"كَعِتقِ سبعينَ رقبةً","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الزواجر عن اقتراف الكبائر 1/205","srcLabel":"الزواجر عن اقتراف الكبائر","text":["إنَّ مَن أمَّ البَيتَ لا تضعُ ناقتُهُ خُفًّا ولا ترفعُهُ إلَّا كُتِبَ لَه بهِ حسنةٌ ومُحِيَ عنهُ خَطيئةٌ ، وإنَّ ركعتَي الطَّوافِ كَعِتقِ رقبةٍ مِن بَني إسماعيلَ ",["والسَّعيَ",1]," ",["كَعِتقِ سبعينَ رقبةً",2]," ، والوقوفَ تُغفَرُ بهِ الذُّنوبُ ، وإن كانت بعدَدِ الرَّملِ أو كقَطرِ المطرِ ، أو كزَبَدِ البحرِ ، وبكلِّ حصاةٍ مِن الجِمارِ تكفيرُ كبيرةٍ مِن الموبِقاتِ والنَّحرَ مَذخورٌ عندَ اللهِ ، وبكلِّ شعرةٍ حُلِقَت حسنةٌ ومَحوُ خَطيئةٍ ، وبالطَّوافِ بعدَ ذلكَ يضعُ مَلكٌ يدَيهِ بينَ كتفَيهِ فَيقولُ : اعمَل فيما استُقبِلَ ، فقَد غُفِرَ لكَ ما مضَى"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"استغفار › أسباب المغفرة","dorar":"JXahJfeA"},{"id":"س-02050","fp":"1ba0b9465e0b","stateId":522,"easy":"إذا طفت بالبيت أسبوعاً لا تلغو ← فهو كعدل رقبة تعتقها","cause":"من طافَ بالبيتِ أسبوعًا لا يلْغُو فيِه","result":"كان كعِدلِ رقبةٍ يعتِقُها","explicit":true,"ref":"صحيح الترغيب 1140","srcLabel":"الحاكم","text":[["من طافَ بالبيتِ أسبوعًا لا يلْغُو فيِه ؛ ",1],["كان كعِدلِ رقبةٍ يعتِقُها ",2],"."],"grade":"صحيح","narrator":"المنكدر بن عبدالله بن الهدير","muhaddith":"صحيح لغيره","takhrij":"أخرجه الطبراني (20/360) (845)، وابن عدي في ((الكامل في الضعفاء)) (2/200)، والحاكم (5925) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"YerYerWI"},{"id":"س-04462","fp":"6bb287ef72f6","stateId":523,"easy":"إذا حجّت المرأة ← فهو جهادها","cause":"الحَجُّ","result":"جِهادُكنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["فضل أشخاص أو فئة بأعيانهم، وتعميمه اجتهاد"],"star":true,"ref":"تخريج المسند لشعيب 25328","srcLabel":"البخاري","text":["سألتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ عنِ الجِهادِ؟ فقال: بحَسْبِكنَّ ",["الحَجُّ",1],". أو قال: ",["جِهادُكنَّ",2]," الحَجُّ."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (2875) باختلاف يسير","bab":"جهاد › فضل الجهاد","dorar":"kLjTRNSp","merged":4,"otherRefs":["تخريج المسند لشعيب 24422 (صحيح)","صحيح البخاري 2875 (صحيح)","تخريج المسند لشعيب 25325 (صحيح)"]},{"id":"س-07136","fp":"bdec6d5ff433","stateId":523,"easy":"إذا حججت أو اعتمرت (للمرأة) ← فهو جهاد لا قتال فيه","cause":"الحجُّ و العمرةُ","result":"عليهن جهادٌ لا قتالَ فيه","explicit":true,"similar":["س-05854"],"ref":"مجموع فتاوى ابن عثيمين 240/24","srcLabel":"ابن ماجه","text":["أن النبيَّ صلَّى اللهُ عليهِ وسلَّمَ قال لعائشةَ حين سألته هل على النساءِ جهادٌ؟ قال: نعم، ",["عليهن جهادٌ لا قتالَ فيه",2],"، ",["الحجُّ و العمرةُ",1]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[ثابت]","takhrij":"أخرجه ابن ماجه (2901)، وابن أبي شيبة (12798) كلاهما بلفظه، وأحمد (24463) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"5Xaqk2RV","merged":4,"otherRefs":["تخريج سنن الدارقطني 2715 (صحيح)","صحيح البخاري 2876 (صحيح)","التلخيص الحبير 4/1420 (صحيح)"]},{"id":"س-05854","fp":"042164c0bdbe","stateId":523,"easy":"إذا حججت ← فهو جهاد لا شوكة فيه","cause":"حجُّ البيتِ","result":"أَلَا أدُلُّكَ علَى جِهادٍ لَا شوكةَ فيه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"repOf":"س-07136","ref":"صحيح الجامع 2611","text":[["أَلَا أدُلُّكَ علَى جِهادٍ لَا شوكةَ فيه ",2],"؟",[" حجُّ البيتِ",1]],"grade":"صحيح","narrator":"الشفاء بنت عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الطبراني (24/ 314) (792)، وسعيد بن منصور (2343)، والمزي في ((تهذيب الكمال)) (19/ 383)، واللفظ لهم جميعا.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"0YItQ2nt"},{"id":"س-06351","fp":"62e12bcf69bc","stateId":523,"easy":"إذا أحسنت المرأة التبعّل لزوجها ← فهو جهادها","cause":"حُسنُ التَّبعُّلِ لزوجِها","result":"وجهادُ المرأةِ","explicit":true,"otherNeedIds":[37],"ref":"التمهيد 21/20","srcLabel":"ابن حبان","text":["اجتمع عليُّ بنُ أبي طالبٍ وأبو بكرٍ وعمرُ وأبو عبيدةَ بنُ الجرَّاحِ فتمارَوْا في أشياءَ ، فقال لهم عليُّ بنُ أبي طالبٍ : انطلِقوا بنا إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم نسألُه ، فلمَّا وقفوا على النَّبيِّ عليه السَّلامُ قالوا : يا رسولَ اللهِ جِئنا نسألُك ، قال : إن شئتم سألتموني وإن شئتم أخبرتُكم بما جئتم له ، قالوا أخبِرْنا يا رسولَ اللهِ ، قال : جئتم تسألوني عن الصَّنيعةِ لمن تكونُ ؟ ولا ينبغي أن تكونَ الصَّنيعةُ إلَّا لذي حسَبٍ أو دِينٍ ، وجئتم تسألوني عن الرِّزقِ يجلِبُه اللهُ على العبدِ ، اللهُ يجلبُه عليه فاستنزِلوه بالصَّدقةِ ، وجئتم تسألوني عن جهادِ الضَّعيفِ ، وجهادُ الضَّعيفِ الحجُّ والعمرةُ ، وجئتم تسألوني عن جهادِ المرأةِ ، ",["وجهادُ المرأةِ",2]," ",["حُسنُ التَّبعُّلِ لزوجِها",1]," ، وجئتم تسألوني عن الرِّزقِ من أين يأتي وكيف يأتي ، [ أبَى ] اللهُ أن يرزُقَ عبدَه المؤمنَ إلَّا من حيث لا يحتسِبُ"],"grade":"حسن","narrator":"علي بن الحسين بن علي","muhaddith":"حسن","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/ 147)، وابن الجوزي في ((الموضوعات)) (1039) كلاهما بلفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"z1VvWp0d"},{"id":"س-02627","fp":"a482786d1599","stateId":523,"easy":"إذا صبرت المرأة على الغيرة إيماناً واحتساباً ← فلها مثل أجر الشهيد","cause":"فمنْ صبرَ منهنَّ إيمانًا واحتسابًا","result":"كانَ لها مثلُ أجرِ الشهيدِ","explicit":true,"similar":["س-06038"],"otherNeedIds":[45,62],"ref":"الجامع الصغير 1761","srcLabel":"الطبراني","text":["إنَّ اللهَ تعالى كتبَ الغيرةَ على النساءِ،  والجهادَ على الرجالِ،  ",["فمنْ صبرَ منهنَّ إيمانًا واحتسابًا ",1],["كانَ لها مثلُ أجرِ الشهيدِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه البزار (1490)، والعقيلي في ((الضعفاء الكبير)) (3/117)، والطبراني (10/107) (10040) مطولاً","bab":"إيمان › الاحتساب والنية","dorar":"dA2l1JCI"},{"id":"س-06038","fp":"1740f10097ff","stateId":523,"easy":"إذا صبرت المرأة على الغيرة ← فلها أجر شهيد","cause":"المرأةُ تصبرُ على الغيرةِ","result":"فَلَها أَجْرُ شَهِيدٍ","explicit":true,"repOf":"س-02627","otherNeedIds":[9],"ref":"الفتح الرباني 10/4958","text":[["المرأةُ تصبرُ على الغيرةِ",1]," ",["فَلَها أَجْرُ شَهِيدٍ",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه مطولاً البزار (1490)، والعقيلي في ((الضعفاء الكبير)) (3/117)، وابن حبان في ((المجروحين)) (2/159)، والطبراني (10/107) (10040) باختلاف يسير.","bab":"رقائق وزهد › فضل الصبر","dorar":"Po9CUsf7"},{"id":"س-02012","fp":"89bcc4d64db7","stateId":524,"easy":"إذا وقفت في الصف في سبيل الله ← فهو أفضل من عبادة ستين سنة","cause":"مَقامُ الرَّجلِ في الصَّفِّ في سبيلِ اللهِ","result":"أَفضلُ عندَ اللهِ مِن عبادةِ رَجلٍ ستِّينَ سنةً","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2418","srcLabel":"البخاري","text":[["مَقامُ الرَّجلِ في الصَّفِّ في سبيلِ اللهِ",1]," ",["أَفضلُ عندَ اللهِ مِن عبادةِ رَجلٍ ستِّينَ سنةً",2],"."],"grade":"صحيح","narrator":"عمران بن حصين","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الدارمي في ((مسنده)) (2441)، والبيهقي (18544)، وابن لأبي عاصم في ((الجهاد)) (139) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"h0BLz0PV"},{"id":"س-01995","fp":"53baf2149b42","stateId":524,"easy":"إذا رميت بسهم في سبيل الله أخطأت أو أصبت ← فهو كعتق نسمة من ولد إسماعيل","cause":"مَن رمَى بسهمٍ في سبيلِ اللهِ، فأخطَأَ أو أصابَ","result":"كان كعِتقِ نسَمةٍ مِن ولدِ إسماعيلَ","explicit":true,"ref":"تخريج مشكل الآثار 3910","srcLabel":"النسائي","text":[["مَن رمَى بسهمٍ في سبيلِ اللهِ، فأخطَأَ أو أصابَ، ",1],["كان كعِتقِ نسَمةٍ مِن ولدِ إسماعيلَ",2],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجة (2812)، وأحمد (17023) بنحوه، والنسائي (3145) بنحوه مطولًا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"1lweHxUI"},{"id":"س-07141","fp":"d9d66240c62e","stateId":524,"easy":"إذا أنفقت على الخيل (في سبيل الله) ← فأنت كالباسط يده بالصدقة","cause":"المُنفقِ على الخيلِ","result":"كالمتكفِّفِ بالصَّدقةِ","explicit":true,"star":true,"otherNeedIds":[45],"ref":"تخريج صحيح ابن حبان 4675","srcLabel":"متفق عليه","text":["مَثلُ ",["المُنفقِ على الخيلِ",1]," ",["كالمتكفِّفِ بالصَّدقةِ",2]," ) فقُلْنا لِمَعْمَرٍ: ما المتكفِّفُ بالصَّدقةِ قال: الَّذي يُعطي بكفَّيه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (4675) واللفظ له، والبخاري (2371)، ومسلم (987) كلاهما بمعناه.","bab":"علم › حسن السؤال ونصح العالم","dorar":"A4TyfTmu","merged":2,"otherRefs":["الترغيب والترهيب 2/234 (صحيح)"]},{"id":"س-04317","fp":"5d1e6825e022","stateId":524,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير من الدنيا وما فيها","cause":"لَغَدوةٌ في سَبيلِ اللهِ، أو رَوْحةٌ","result":"خَيرٌ منَ الدُّنيا وما فيها","explicit":true,"star":true,"similar":["س-04479"],"ref":"تخريج المسند لشعيب 12436","srcLabel":"متفق عليه","text":[["لَغَدوةٌ في سَبيلِ اللهِ، أو رَوْحةٌ",1]," ",["خَيرٌ منَ الدُّنيا وما فيها",2],"، ولَقابُ قَوسِ أَحَدِكم أو مَوضِعُ قَدِّه -يَعْني سَوطَه- منَ الجَنَّةِ خَيرٌ منَ الدُّنيا وما فيها، ولوِ اطَّلعَتِ امرأةٌ من نساءِ أهلِ الجَنَّةِ إلى الأرضِ لَملَأَتْ ما بينهما ريحًا، ولَطابَ ما بينهما، ولَنَصيفُها على رأسِها خَيرٌ منَ الدُّنيا وما فيها."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6568)، ومسلم (1880) باختلاف يسير","bab":"جنة › صفة أهل الجنة","dorar":"kcPnUV6F"},{"id":"س-04479","fp":"8fbe63f53a8f","stateId":524,"easy":"إذا غدوت أو رحت في سبيل الله ← فهو خير مما طلعت عليه الشمس","cause":"لَغَدوةٌ أو رَوحةٌ في سَبيلِ اللهِ","result":"خَيرٌ ممَّا تَطلُعُ عليه الشَّمسُ","explicit":true,"repOf":"س-04317","ref":"صحيح البخاري 2793","text":["لَقَابُ قَوسٍ في الجَنَّةِ خَيرٌ ممَّا تَطلُعُ عليه الشَّمسُ وتَغرُبُ. وقال: ",["لَغَدوةٌ أو رَوحةٌ في سَبيلِ اللهِ",1]," ",["خَيرٌ ممَّا تَطلُعُ عليه الشَّمسُ",2]," وتَغرُبُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2793)، ومسلم (1882) مختصراً","bab":"جهاد › فضل الجهاد","dorar":"nYdKfTew"},{"id":"س-04526","fp":"008a37386154","stateId":524,"easy":"إذا سألت الله الشهادة بصدق ← يبلغك منازل الشهداء ولو مت على فراشك","cause":"مَن سَألَ اللهَ الشَّهادةَ بصِدقٍ","result":"بَلَّغَه اللهُ مَنازِلَ الشُّهَداءِ، وإن ماتَ على فِراشِه","explicit":true,"star":true,"otherNeedIds":[62],"ref":"صحيح مسلم 1909","srcLabel":"متفق عليه","text":[["مَن سَألَ اللهَ الشَّهادةَ بصِدقٍ ",1],["بَلَّغَه اللهُ مَنازِلَ الشُّهَداءِ، وإن ماتَ على فِراشِه",2],". ولَم يَذكُرْ أبو الطَّاهِرِ في حَديثِه: بصِدقٍ."],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جهاد › فضل الشهيد","dorar":"oXqYwv6D"},{"id":"س-04646","fp":"5fae379e5d5c","stateId":524,"easy":"إذا رابطت يوماً وليلة ← فهو كصيام شهر وقيامه","cause":"رِباطُ يَومٍ وليلةٍ في سَبيلِ اللهِ","result":"كصِيامِ شَهرٍ وقِيامِه","explicit":true,"star":true,"similar":["س-04518","س-04668"],"ref":"تخريج المسند لشعيب 23728","srcLabel":"مسلم","text":["أنَّه سَمِعَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ يقولُ: ",["رِباطُ يَومٍ وليلةٍ في سَبيلِ اللهِ",1]," ",["كصِيامِ شَهرٍ وقِيامِه",2],"، إنْ ماتَ جَرى عليه أجْرُ المُرابِطِ حتى يُبعَثَ، ويُؤمَنُ الفتَّانَ."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1913)، والترمذي (1665)، وأحمد (23728) واللفظ له","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"AOt6l7gd","merged":2,"otherRefs":["صحيح الترمذي 1665 (صحيح)"]},{"id":"س-06800","fp":"c1fd749b9617","stateId":524,"easy":"إذا رميت بسهم في سبيل الله ← فهو عدل محرَّر","cause":"مَن رَمى بسَهمٍ في سبيلِ اللهِ عزَّ وجلَّ","result":"فهو عِدْلُ مُحَرَّرٍ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 17022","srcLabel":"مسلم","text":["حاصَرْنا مع نَبيِّ اللهِ صلَّى اللهُ عليه وسلَّمَ حِصنَ الطائفِ، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن بَلَغَ بسَهمٍ فله درجةٌ في الجَنَّةِ. قال: فبلَّغْتُ يَومَئذٍ ستَّةَ عَشَرَ سَهمًا، فسمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن رَمى بسَهمٍ في سبيلِ اللهِ عزَّ وجلَّ ",1],["فهو عِدْلُ مُحَرَّرٍ، ",2],"ومَن شابَ شَيْبةً في سبيلِ اللهِ، كانت له نورًا يَومَ القيامةِ، وأَيُّما رجُلٍ مُسلِمٍ أَعتَقَ رجُلًا مُسلِمًا، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِه عَظْمًا مِن عِظامِ مُحَرِّرِه مِنَ النارِ، وأَيُّما امْرأةٍ مُسلِمةٍ أَعتَقَتِ امْرأةً مُسلِمةً، فإنَّ اللهَ عزَّ وجلَّ جاعِلٌ وَفاءَ كلِّ عَظْمٍ مِن عِظامِها عَظْمًا مِن عِظامِ مُحَرِّرِها مِنَ النارِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (3966) مختصرا بنحوه، والترمذي (1638) مختصرا، والنسائي (3145) مختصرا باختلاف يسير، وأحمد (17022) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"hWvbEIGM","merged":2,"otherRefs":["تخريج المسند لشعيب 19428 (صحيح)"]},{"id":"س-04357","fp":"562d7c07453d","stateId":524,"easy":"إذا وقفت في سبيل الله ← فهو أفضل من صلاتك في أهلك ستين عاماً","cause":"مَقامَ أَحَدِكُم في سبيلِ اللهِ","result":"أفضلُ مِن صلاتِهِ في أَهلِهِ ستِّينَ عامًا","explicit":true,"similar":["س-04474"],"ref":"المستدرك على الصحيحين 2417","srcLabel":"مسلم","text":["أنَّ رَجلًا مِن أصحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ مَرَّ بشِعْبٍ فيه عُيَينَةُ مِن ماءٍ عَذْبٍ، فأَعْجَبَه طيبُهُ وحُسنُه، فقالَ: لوِ اعتزلتُ النَّاسَ، وأَقمتُ في هذا الشِّعبِ؟ ثُمَّ قالَ: لا أَفعلُ حتَّى أَستأْمِرَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ ذلك لرسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: لا تَفعلْ؛ فإنَّ ",["مَقامَ أَحَدِكُم في سبيلِ اللهِ",1]," ",["أفضلُ مِن صلاتِهِ في أَهلِهِ ستِّينَ عامًا",2],"، ألا تُحبُّونَ أنْ يَغفِرَ اللهُ لكم، ويُدخِلَكُم الجنَّةَ؛ اغزوا في سبيلِ اللهِ، مَنْ قاتَلَ في سبيلِ الله فُواقَ ناقةٍ؛ وَجَبَتْ له الجنَّةُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه البيهقي (18543) واللفظ له، والترمذي (1650)، وأحمد (10786) بنحوه","bab":"جهاد › الترغيب في الجهاد","dorar":"7Vzc5L5E"},{"id":"س-04363","fp":"5c0176747001","stateId":524,"easy":"إذا خلفت الخارج في أهله وماله بخير ← فلك نصف أجره","cause":"أَيُّكُم خَلَفَ الخارجَ في أَهلِهِ ومالِهِ بخيرٍ","result":"كان له مِثلُ نصفِ أَجْرِ الخارجِ","explicit":true,"ref":"المستدرك على الصحيحين 2464","srcLabel":"مسلم","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بَعَثَ إلى بَني لِحيانَ، وقالَ: ليَخْرُجْ مِن كُلِّ رَجلينِ رَجلٌ. ثُمَّ قالَ للقاعدِ: ",["أَيُّكُم خَلَفَ الخارجَ في أَهلِهِ ومالِهِ بخيرٍ",1],"؛ ",["كان له مِثلُ نصفِ أَجْرِ الخارجِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (1896)، وأبو داود (2510)، وأحمد (11110) جميعا بلفظه.","bab":"جهاد › الترغيب في الجهاد","dorar":"vwA5Timb"},{"id":"س-04367","fp":"b69d5ca008cf","stateId":524,"easy":"إذا جهّزت غازياً في سبيل الله ← فقد غزوت","cause":"مَن جَهَّزَ غازيًا في سَبيلِ اللهِ","result":"فقد غَزا","explicit":true,"ref":"صحيح البخاري 2843","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["مَن جَهَّزَ غازيًا في سَبيلِ اللهِ ",1],["فقد غَزا، ",2],"ومَن خَلَفَ غازيًا في سَبيلِ اللهِ بخَيرٍ فقد غَزا."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1895)، وأبو داود (2509)، والترمذي (1628) واللفظ لهم.","bab":"جهاد › الترغيب في الجهاد","dorar":"POUYh0BW"},{"id":"س-04368","fp":"957f2918c1f7","stateId":524,"easy":"إذا خلفت غازياً في أهله بخير ← فقد غزوت","cause":"ومَن خَلَفَ غازيًا في سَبيلِ اللهِ بخَيرٍ","result":"فقد غَزا","explicit":true,"ref":"صحيح البخاري 2843","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: مَن جَهَّزَ غازيًا في سَبيلِ اللهِ فقد غَزا، ",["ومَن خَلَفَ غازيًا في سَبيلِ اللهِ بخَيرٍ ",1],["فقد غَزا",2],"."],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1895)، وأبو داود (2509)، والترمذي (1628) واللفظ لهم.","bab":"جهاد › الترغيب في الجهاد","dorar":"POUYh0BW"},{"id":"س-04518","fp":"36f9257adb02","stateId":524,"easy":"إذا رابطت يوماً وليلة ← فهو كعدل صيام شهر وقيامه","cause":"من رابط يومًا وليلةً في سبيلِ اللهِ","result":"كان كعدلِ صيامِ شهرٍ وقيامِه لا يفطرُ ولا ينفتلُ عن صلاتِه إلى لحاجةٍ","explicit":true,"repOf":"س-04646","ref":"تخريج الكشاف 1/266","text":["أنهم كانوا في جندٍ من المسلمين مرةً فأصابهم ضُرٌّ وحصرٌ فقال سلمانُ لصاحبِ الجندِ ألا أحدثُك حديثًا سمعته من رسولِ اللهِ صلَّى اللهُ عليهِ وسلمَ  فيكونَ لك قوةٌ على الجندِ قال بلى قال سمعتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلمَ  يقولُ ",["من رابط يومًا وليلةً في سبيلِ اللهِ ",1],["كان كعدلِ صيامِ شهرٍ وقيامِه لا يفطرُ ولا ينفتلُ عن صلاتِه إلى لحاجةٍ ",2],"ومن مات في سبيلِ اللهِ أجرى اللهُ تعالَى عليه أجرَه حتى يقضيَ بينَ أهلِ الجنةِ والنارِ"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"معناه في صحيح مسلم","takhrij":"أخرجه مسلم (1913)  مختصرا والترمذي (1665) و النسائي (3167 ) بمعناه.","bab":"جهاد › فضل الشهيد","dorar":"d2PMaKNS"},{"id":"س-04668","fp":"2b333b39b017","stateId":524,"easy":"إذا رابطت يوماً أو ليلة ← فلك كصيام شهر للقاعد","cause":"مَن رابَطَ يومًا أو ليلةً","result":"كان له كصيامِ شَهرٍ للقاعِدِ","explicit":true,"repOf":"س-04646","ref":"تخريج المسند لشعيب 23727","text":["أنَّه سَمِعَه وهو يُحَدِّثُ شُرَحْبيلَ بنَ السِّمْطِ وهو مُرابِطٌ على السَّاحِلِ، يقولُ: سَمِعتُ النبيَّ صلَّى اللهُ عليه وسَلَّمَ يقولُ: ",["مَن رابَطَ يومًا أو ليلةً ",1],["كان له كصيامِ شَهرٍ للقاعِدِ، ",2],"ومَن ماتَ مُرابِطًا في سَبيلِ اللهِ، أجْرَى اللهُ له أجْرَه الذي كان يَعمَلُ: أجْرَ صَلاتِه وصِيامِه ونَفَقَتِه، ووُقِيَ مِن فتَّانِ القَبرِ، وأمِنَ مِن الفَزَعِ الأكبَرِ."],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه مسلم (1913)، والترمذي (1665)، والنسائي (3167) بنحوه، وأحمد (23727) واللفظ له","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"NOC7DQ1q"},{"id":"س-02464","fp":"355bc4a13749","stateId":524,"easy":"إذا أسلمت ثم قاتلت فقُتلت ← عملت قليلاً وأُجرت كثيراً","cause":"أَسْلِمْ ثُمَّ قَاتِلْ. فأسْلَمَ ثُمَّ قَاتَلَ، فَقُتِلَ","result":"عَمِلَ قَلِيلًا، وأُجِرَ كَثِيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[62],"ref":"صحيح الجامع 973","srcLabel":"متفق عليه","text":["أسْلِمْ ثمَّ قاتِلْ [يعني حديث: أَتَى النَّبيَّ صَلَّى اللهُ عليه وسلَّمَ رَجُلٌ مُقَنَّعٌ بالحَدِيدِ ، فَقالَ: يا رَسولَ اللَّهِ، أُقَاتِلُ أَوْ أُسْلِمُ؟ قالَ: ",["أَسْلِمْ ثُمَّ قَاتِلْ. فأسْلَمَ ثُمَّ قَاتَلَ، فَقُتِلَ",1],"، فَقالَ رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: ",["عَمِلَ قَلِيلًا، وأُجِرَ كَثِيرًا",2],".]"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2808) واللفظ له، ومسلم (1900)","bab":"إسلام › فضل الشهادتين","dorar":"mMIQevl1","merged":3,"otherRefs":["تخريج صحيح ابن حبان 4601 (صحيح)","تخريج المسند لشعيب 18592 (صحيح)"]},{"id":"س-04373","fp":"1988814edd8d","stateId":524,"easy":"إذا رابطت على سواحل المسلمين ثلاثة أيام ← تجزئك عن رباط سنة","cause":"مَن رابَطَ في شَيءٍ مِن سَواحِلِ المُسلمينَ ثَلاثةَ أيَّامٍ","result":"أجزَأَت عَنه رِباطَ سَنةٍ له","explicit":true,"ref":"مشارع الأشواق 689","srcLabel":"البخاري","text":[["مَن رابَطَ في شَيءٍ مِن سَواحِلِ المُسلمينَ ثَلاثةَ أيَّامٍ ",1],["أجزَأَت عَنه رِباطَ سَنةٍ له",2]],"grade":"حسن","narrator":"أم الدرداء","muhaddith":"[فيه] إسماعيل بن عياش عن المدنيين، وبقية رجاله ثقات","takhrij":"أخرجه أحمد (27040)، والبخاري في ((التاريخ الكبير)) (2/ 129)، وابن أبي عاصم في ((الجهاد)) (307)، والطبراني (24/ 254) (648) واللفظ لهم.","bab":"جهاد › الترغيب في الجهاد","dorar":"zNqW9UnR"},{"id":"س-04534","fp":"0892fd65a983","stateId":524,"easy":"إذا قاتلت حتى قُتلت ← عملت يسيراً وأُجرت كثيراً","cause":"ثُمَّ تَقدَّمَ فقاتَلَ حتَّى قُتِلَ","result":"عَمِلَ هذا يَسيرًا، وأُجِرَ كَثيرًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح مسلم 1900","srcLabel":"البخاري","text":["جاءَ رَجُلٌ مِن بَني النَّبيتِ قَبيلٍ مِنَ الأنصارِ، فقال: أشهَدُ أن لا إلَهَ إلَّا اللهُ، وأنَّكَ عَبدُه ورَسولُه، ",["ثُمَّ تَقدَّمَ فقاتَلَ حتَّى قُتِلَ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: ",["عَمِلَ هذا يَسيرًا، وأُجِرَ كَثيرًا",2],"."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (18581)، وابن منده في ((الإيمان)) (250) بلفظه، والبخاري (2808) بنحوه.","bab":"جهاد › فضل الشهيد","dorar":"PRhFXwN8"},{"id":"س-02872","fp":"89974837c6a7","stateId":524,"easy":"إذا جهّزت غازياً حتى يستقل ← فلك مثل أجره حتى يموت أو يرجع","cause":"ومَن جهَّز غازيًا حتى يستقِلَّ","result":"كان له مثلُ أجرِه حتى يموتَ أو يرجِعَ","explicit":true,"otherNeedIds":[45],"ref":"إتحاف الخيرة المهرة 2/15","srcLabel":"ابن ماجه","text":["مَن أظلَّ رأسَ غازٍ أظلَّه اللهُ يومَ القيامةِ ، ",["ومَن جهَّز غازيًا حتى يستقِلَّ ",1],["كان له مثلُ أجرِه حتى يموتَ أو يرجِعَ ، ",2],"ومَن بنى للهِ مسجدًا بنى اللهُ له بيتًا في الجنةِ.  فقال الوليدُ : فذكرتُ ذلك للقاسمِ بنِ محمدٍ ، فقال : قد بلَغني هذا الحديثُ ، قال : قد ذكرتُ ذلك لمحمدِ بنِ المُنكدِرِ وزيدِ بنِ أسلمَ فكلاهما قالا مثلَ ذلك ، وقالا : قد بلَغَنا ذلك"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (735، 2758) مختصراً مفرقاً، وأحمد (126) باختلاف يسير، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (2/15) واللفظ له","bab":"إيمان › الوعد","dorar":"OnoBmIss","merged":2,"otherRefs":["الإصابة في تمييز الصحابة 2/400 (حسن)"]},{"id":"س-04513","fp":"208d99037e2a","stateId":524,"easy":"إذا أصابك دوار البحر وقيؤه (في الجهاد) ← فلك أجر شهيد","cause":"المائِدُ في البحرِ الذي يُصيبُهُ القَيءُ","result":"له أجرُ شَهيدٍ","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 6642","srcLabel":"أبو داود","text":[["المائِدُ في البحرِ الذي يُصيبُهُ القَيءُ",1]," ",["له أجرُ شَهيدٍ",2]," ، و الغَرِيقُ له أجْرُ شَهيدَيْنِ"],"grade":"صحيح","narrator":"أم حرام بنت ملحان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2493)، والبيهقي (8929) باختلاف يسير.","bab":"جهاد › فضل الشهيد","dorar":"aCcml7ay","merged":2,"otherRefs":["صحيح الجامع 5187 (صحيح)"]},{"id":"س-04514","fp":"0ca12c3de34c","stateId":524,"easy":"إذا غرقت (في الجهاد) ← فلك أجر شهيدين","cause":"و الغَرِيقُ","result":"له أجْرُ شَهيدَيْنِ","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 6642","srcLabel":"أبو داود","text":["المائِدُ في البحرِ الذي يُصيبُهُ القَيءُ له أجرُ شَهيدٍ ، ",["و الغَرِيقُ",1]," ",["له أجْرُ شَهيدَيْنِ",2]],"grade":"صحيح","narrator":"أم حرام بنت ملحان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2493)، والبيهقي (8929) باختلاف يسير.","bab":"جهاد › فضل الشهيد","dorar":"aCcml7ay","merged":2,"otherRefs":["صحيح الجامع 5187 (صحيح)"]},{"id":"س-06795","fp":"ee2e88ef30ff","stateId":524,"easy":"إذا رميت بسهم في سبيل الله بلغ العدو أصاب أو أخطأ ← فلك كعدل رقبة","cause":"ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ بَلَغَ به العَدوَّ، أصابَ أو أخطَأَ","result":"كان له كعَدلِ رَقبةٍ","explicit":true,"similar":["س-02261"],"ref":"تخريج المسند لشعيب 19437","srcLabel":"أبو داود","text":["مَن وُلِدَ له ثلاثةُ أَولادٍ في الإسلامِ، فماتوا قبلَ أنْ يَبلُغوا الحِنثَ، أدخَلَه اللهُ عزَّ وجلَّ الجنَّةَ برَحمتِه إيَّاهم، ومَن شاب شَيبةً في سَبيلِ اللهِ عزَّ وجلَّ كانتْ له نورًا يومَ القيامةِ، ",["ومَن رَمى بسَهمٍ في سَبيلِ اللهِ عزَّ وجلَّ بَلَغَ به العَدوَّ، أصابَ أو أخطَأَ، ",1],["كان له كعَدلِ رَقبةٍ، ",2],"ومَن أعتَقَ رَقبةً مؤمنةً أعتَقَ اللهُ بكلِّ عُضوٍ منها عُضوًا منه مِن النَّارِ، ومَن أنفَقَ زَوجَينِ في سَبيلِ اللهِ عزَّ وجلَّ، فإنَّ للجنَّةِ ثَمانيةَ أبْوابٍ، يُدخِلُه اللهُ عزَّ وجلَّ مِن أيِّ بابٍ شاء منها الجنَّةِ."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد له....\" و\"ومن أنفق زوجين\" فصحيح لغيره","takhrij":"أخرجه أبو داود (3966)، والنسائي (3145) مختصرا، والترمذي (1635، 1638) مفرقاً مختصراً، وأحمد (19437) واللفظ له","bab":"عتق وولاء › فضل العتق","dorar":"bTRJfZ4H","merged":2,"otherRefs":["صحيح النسائي 3145 (صحيح)"]},{"id":"س-00525","fp":"5bd47324c53f","stateId":524,"easy":"إذا عبرت البحر (في الجهاد) ← فكأنما عبرت الأودية كلها","cause":"ومن أجاز البحرَ","result":"فكأنَّما أجاز الأوديةَ كلَّها","explicit":true,"ref":"الترغيب والترهيب 2/269","srcLabel":"ابن حبان","text":["حجَّةٌ لمن لم يحجَّ خيرٌ من عشرِ غزواتٍ وغزوةٌ لمن قد حجَّ خيرٌ من عشرِ حججٍ وغزوةٌ في البحرِ خيرٌ من عشرِ غزواتٍ في البرِّ ",["ومن أجاز البحرَ",1]," ",["فكأنَّما أجاز الأوديةَ كلَّها",2]," والمائدُ فيه كالمتشحِّطِ في دمِه"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان في ((المجروحين)) (1/461)، والطبراني (13/654) (14581) واللفظ له، والبيهقي (8928)","bab":"آداب عامة › ضرب الأمثال","dorar":"Ws53xUp3"},{"id":"س-00542","fp":"4c0a41270fd6","stateId":524,"easy":"إذا رميت بسهم في سبيل الله فبلغ أصاب أو أخطأ ← فكأنما أعتقت رقبة من ولد إسماعيل","cause":"ومَن رَمى بسَهمٍ فبلَغَ فأَصاب أو أَخطأَ","result":"كان كمَن أَعتَقَ رَقَبةً مِن ولَدِ إسماعيلَ","explicit":true,"ref":"تخريج المسند لشعيب 17020","srcLabel":"أبو داود","text":["مَن أَعتَقَ رَقَبةً مُسلِمةً، كانت فِكاكَه مِنَ النارِ عُضْوًا بعُضوٍ، ومَن شابَ شَيبةً في سبيلِ اللهِ كانت له نورًا يَومَ القيامةِ، ",["ومَن رَمى بسَهمٍ فبلَغَ فأَصاب أو أَخطأَ، ",1],["كان كمَن أَعتَقَ رَقَبةً مِن ولَدِ إسماعيلَ",2],"."],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح دون قوله: \"من ولد إسماعيل\"","takhrij":"أخرجه أبو داود (3966)، والترمذي (1638) مختصرا، والنسائي (3145) باختلاف يسير، وأحمد (17020) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"Bn518V3w"},{"id":"س-02074","fp":"39a9c8d35c7f","stateId":524,"easy":"إذا جاهدت في سبيل الله ← فأنت كالصائم القائم الذي لا يفتر","cause":"المُجاهِدِ في سبيلِ اللَّهِ","result":"كالصَّائمِ القائمِ بآياتِ اللَّهِ آناءَ اللَّيلِ وآناءَ النَّهارِ","explicit":true,"similar":["س-00631"],"ref":"حلية الأولياء 8/184","srcLabel":"ابن المبارك","text":["مثَلُ ",["المُجاهِدِ في سبيلِ اللَّهِ",1]," ",["كالصَّائمِ القائمِ بآياتِ اللَّهِ آناءَ اللَّيلِ وآناءَ النَّهارِ",2]," مَثلُ هذِه الأسطُوانةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ثابت من حديث أبي إبراهيم","takhrij":"أخرجه ابن المبارك في ((الجهاد)) (13)، وأبو نعيم في ((حلية الأولياء)) (8/173)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"a1Y9JcbP"},{"id":"س-02261","fp":"367238d53bbe","stateId":524,"easy":"إذا رميت بسهم في سبيل الله بلغ أو لم يبلغ ← فلك كعتق رقبة","cause":"ومن رَمى بسَهْمٍ في سبيلِ اللَّهِ تعالى بلغَ العدوَّ ، أو لم يبلُغ","result":"كانَ لَهُ كعتقِ رقبةٍ","explicit":true,"repOf":"س-06795","ref":"صحيح النسائي 3142","text":["من شابَ شَيبةً في سبيلِ اللَّهِ تعالى ، كانت لَهُ نورًا يومَ القيامةِ ، ",["ومن رَمى بسَهْمٍ في سبيلِ اللَّهِ تعالى بلغَ العدوَّ ، أو لم يبلُغ ، ",1],["كانَ لَهُ كعتقِ رقبةٍ ، ",2],"ومن أعتقَ رقبةً مُؤْمِنَةً ، كانت لَهُ فداءَهُ منَ النَّارِ عضوًا بعضوٍ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1635) مختصراً، والنسائي (3142) واللفظ له، وأحمد (19437) مطولاً.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"WiMjcnkt"},{"id":"س-02919","fp":"82bee5e6ac3c","stateId":524,"easy":"إذا سافرت في سبيل الله ← فهي أفضل من خمسين حجة","cause":"لسَفرةٌ في سَبيلِ اللهِ","result":"أفضَلُ مِن خَمسينَ حَجَّةً","explicit":true,"apply":{"k":"time","t":"في السفر"},"ref":"مشارع الأشواق 204","srcLabel":"ابن المبارك","text":["عن ابن عمر: [",["لسَفرةٌ في سَبيلِ اللهِ",1]," ",["أفضَلُ مِن خَمسينَ حَجَّةً",2],"]"],"grade":"صحيح","narrator":"آدم بن علي","muhaddith":"[إسناده صحيح]","takhrij":"أخرجه ابن المبارك في ((الجهاد)) (225)، وعبد الرزاق (9546)، وابن أبي شيبة (20507) جميعا بلفظه.","bab":"إيمان › الوعد","dorar":"8gRZhRH5"},{"id":"س-04474","fp":"97fb1591ad5e","stateId":524,"easy":"إذا قمت في الصف في سبيل الله ساعة ← فهو أفضل من عبادة ستين سنة","cause":"لَقِيامُ رجلٍ في الصفِّ في سبيلِ اللهِ عزَّ وجلَّ ساعةً","result":"أفضلُ من عبادةِ سِتِّينَ سنةً","explicit":true,"repOf":"س-04357","ref":"صحيح الجامع 5151","text":[["لَقِيامُ رجلٍ في الصفِّ في سبيلِ اللهِ عزَّ وجلَّ ساعةً",1]," ",["أفضلُ من عبادةِ سِتِّينَ سنةً",2]],"grade":"صحيح","narrator":"عمران بن الحصين وأبو برزة","muhaddith":"صحيح","bab":"جهاد › فضل الجهاد","dorar":"vdHwkKXk"},{"id":"س-04477","fp":"7090db37067d","stateId":524,"easy":"إذا صليت وأنت مرابط ← تعدل صلاتك خمسمئة صلاة ونفقتك أفضل من سبعمئة","cause":"إنَّ صلاةَ المرابِطِ","result":"تعدِلُ خمسَمائةِ صلاةٍ ونفقةَ الدِّينارِ والدِّرهمِ منه أفضلُ من سبعِمائةِ دينارٍ يُنفقُه في غيرِه","explicit":true,"otherNeedIds":[45],"ref":"الترغيب والترهيب 2/239","srcLabel":"البيهقي","text":[["إنَّ صلاةَ المرابِطِ ",1],["تعدِلُ خمسَمائةِ صلاةٍ ونفقةَ الدِّينارِ والدِّرهمِ منه أفضلُ من سبعِمائةِ دينارٍ يُنفقُه في غيرِه",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن أبي عاصم في ((الجهاد)) (313)، وتمام في ((فوائده)) (1675)، والبيهقي في ((شعب الإيمان)) (4295) واللفظ لهم.","bab":"جهاد › فضل الجهاد","dorar":"haKlnKL9"},{"id":"س-04642","fp":"1df0c73be41f","stateId":524,"easy":"إذا رابطت يوماً في سبيل الله ← يعدل عبادة شهر أو سنة صيامها وقيامها","cause":"رباطُ يومٍ في سبيلِ اللهِ","result":"يعدلُ عبادةَ شهرٍ أو سنةٍ : صيامَها و قيامَها","explicit":true,"ref":"الجامع الصغير 4383","srcLabel":"ابن أبي أسامة","text":[["رباطُ يومٍ في سبيلِ اللهِ ",1],["يعدلُ عبادةَ شهرٍ أو سنةٍ : صيامَها و قيامَها",2],"،  و منْ ماتَ مرابطًا في سبيلِ اللهِ أعاذَهُ اللهُ منْ عذابِ القبرِ،  و أجْرَى لهُ رِباطَهُ ما قامتْ الدنيا"],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي أسامة في ((مسند الحارث)) (629) واللفظ له.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"rtHceILX"},{"id":"س-06798","fp":"ac88a07ff169","stateId":524,"easy":"إذا رميت العدو بسهم في سبيل الله فبلغه ← يعدل رقبة أصاب أو أخطأ","cause":"مَن رَمَى العَدُوَّ بِسَهْمٍ في سبيلِ اللهِ","result":"فَبَلَغَ سَهْمُهُ العَدُوَّ ، أصابَ أو أخْطأَ ، يَعْدِلُ رَقَبَةً","explicit":true,"ref":"صحيح الجامع 6267","srcLabel":"الترمذي","text":[["مَن رَمَى العَدُوَّ بِسَهْمٍ في سبيلِ اللهِ ، ",1],["فَبَلَغَ سَهْمُهُ العَدُوَّ ، أصابَ أو أخْطأَ ، يَعْدِلُ رَقَبَةً",2]],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (1638) بنحوه، والنسائي (3145)، وأحمد (17020) مطولاً، وابن ماجه (2812) باختلاف يسير.","bab":"عتق وولاء › فضل العتق","dorar":"8u62kPca"},{"id":"س-00631","fp":"fcfac7987010","stateId":524,"easy":"إذا جاهدت في سبيل الله ← فأنت كالصائم القائم الذي لا يفتر","cause":"المُجاهِدِ في سَبيلِ اللهِ","result":"كَمَثَلِ الصَّائِمِ القائِمِ القانِتِ بآياتِ اللهِ، لا يَفتُرُ مِن صيامٍ، ولا صَلاةٍ، حتَّى يَرجِعَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-02074","ref":"صحيح مسلم 1878","text":["قيلَ للنَّبيِّ صلَّى اللهُ عليه وسلَّم: ما يَعدِلُ الجِهادَ في سَبيلِ اللهِ عَزَّ وجَلَّ؟ قال: لا تَستَطيعونَه، قال: فأعادوا عليه مَرَّتَينِ أو ثَلاثًا، كُلَّ ذلك يقولُ: لا تَستَطيعونَه، وقال في الثَّالِثةِ: مَثَلُ ",["المُجاهِدِ في سَبيلِ اللهِ",1]," ",["كَمَثَلِ الصَّائِمِ القائِمِ القانِتِ بآياتِ اللهِ، لا يَفتُرُ مِن صيامٍ، ولا صَلاةٍ، حتَّى يَرجِعَ",2]," المُجاهِدُ في سَبيلِ اللهِ تَعالى."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2785)، ومسلم (1878) واللفظ له","bab":"آداب عامة › ضرب الأمثال","dorar":"CvC9CQrg","merged":11,"otherRefs":["صحيح ابن حبان 4622 (صحيح)","تخريج المسند لشعيب 9648 (صحيح)","صحيح الترمذي 1619 (صحيح)","تخريج المسند لشعيب 9920 (صحيح)","تخريج المسند لشعيب 10000 (صحيح)","السلسلة الصحيحة 6/935 (حسن)","مشارع الأشواق 117 (صحيح)","صحيح ابن ماجه 2243 (صحيح)","صحيح النسائي 3124 (صحيح)","صحيح الجامع 5851 (صحيح)"]},{"id":"س-02231","fp":"128bac180897","stateId":524,"easy":"إذا رابطت ليلة في سبيل الله ← فهي كألف ليلة صيامها وقيامها","cause":"من رابط ليلةً في سبيلِ اللهِ","result":"كانت كألفِ ليلةٍ صيامِها وقيامِها","explicit":true,"ref":"صحيح الترغيب 1224","srcLabel":"ابن ماجه","text":[["من رابط ليلةً في سبيلِ اللهِ ؛ ",1],["كانت كألفِ ليلةٍ صيامِها وقيامِها ",2],"."],"grade":"حسن","narrator":"عثمان بن عفان","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن ماجه (2766)، واللفظ له، وأحمد (463)، والبيهقي في ((الشعب)) بنحوه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"TCks5w8Z"},{"id":"س-04512","fp":"4b82e434363f","stateId":524,"easy":"إذا قُتلت في سبيل الله ← فهو أحب إليك من الدنيا كلها","cause":"أُقتَلَ في سبيلِ اللهِ","result":"أحبُّ إليَّ من أن يكونَ لي أهلُ الوَبَرِ والمدَرِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"صحيح الترغيب 1357","srcLabel":"النسائي","text":["ما من نفسٍ مسلمةٍ يقبضُها ربُّها تحب أن ترجعَ إليكم ، وإنَّ لها الدنيا وما فيها ؛ غيرُ الشهيدِ . قال ابن أبي عُميرةَ : قال رسولُ اللهِ : لأن ",["أُقتَلَ في سبيلِ اللهِ",1]," ؛ ",["أحبُّ إليَّ من أن يكونَ لي أهلُ الوَبَرِ والمدَرِ",2]," ."],"grade":"صحيح","narrator":"عبدالرحمن بن أبي عميرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3153) بلفظه، وأحمد (17894) بلفظ مقارب","bab":"جهاد › فضل الشهيد","dorar":"vEIUfejI"},{"id":"س-01734","fp":"dc3c619ad962","stateId":524,"easy":"إذا رميت رمية في سبيل الله قصّرت أو بلغت ← فلك مثل أجر عتق أربعة من ولد إسماعيل","cause":"مَن رمى رَمْيةً في سَبيلِ اللهِ -قَصَّر أو بلَغَ","result":"كان له مِثْلُ أجرِ أَربَعةِ أناسٍ مِن وَلَدِ إسماعيلَ أعتَقَهم","explicit":true,"star":true,"otherNeedIds":[45],"ref":"الأحاديث المختارة 2204","srcLabel":"البخاري","text":["«",["مَن رمى رَمْيةً في سَبيلِ اللهِ -قَصَّر أو بلَغَ- ",1],["كان له مِثْلُ أجرِ أَربَعةِ أناسٍ مِن وَلَدِ إسماعيلَ أعتَقَهم»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أنبياء › عام","dorar":"HV4ZmoFk"},{"id":"س-02058","fp":"3ff4fc8b519b","stateId":525,"easy":"إذا كان والداك حيين ← ففيهما فجاهد","cause":"ففيهِما","result":"فجاهِدْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[39],"ref":"غاية المرام 281","srcLabel":"متفق عليه","text":["جاءَ رجلٌ إلى نبيِّ اللهِ فاستأذَنَهُ في الجهادِ فقالَ: أحيٌّ والداكَ ؟ قال: نعَم قال: ",["ففيهِما",1]," ",["فجاهِدْ",2]," و قال: أقبلَ رجلٌ إلى رسولِ اللهِ فقالَ: أبايِعُكَ على الهجرَةِ و الجهادِ أبتَغي الأجرَ منَ اللهِ قال: فَهلْ مِن والدَيكَ أحدٌ حيٌّ ؟ قالَ: نعَم بل كِلاهُما حىٌّ قال: أفتَبتَغي الأجرَ منَ اللهِ ؟ قالَ: نعَم قال: فارجِعْ إلى والدَيكَ فأحسِنْ صُحبَتَهُما"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3004)، ومسلم (2549) باختلاف يسير\nوحديث وقال: أقبل.. أخرجه مسلم (2549) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"6c8yZWHM","merged":8,"otherRefs":["صحيح الأدب المفرد 15 (صحيح)","حلية الأولياء 5/74 (صحيح)","تخريج مشكل الآثار 2131 (صحيح)","تخريج المسند لشاكر 11/61 (صحيح)","الأحاديث المختارة 13 / 159 (صحيح)","تخريج مشكل الآثار 2119 (صحيح)","صحيح ابن حبان 420 (صحيح)"]},{"id":"س-07229","fp":"633d6b5e4ecf","stateId":525,"easy":"إذا اجتهدت في بر أمك فرضيت عنك ← فأنت حاج ومعتمر ومجاهد","cause":"فأَبْلِ اللهَ عُذرًا في بِرِّها","result":"فأنت حاجٌّ ومُعتَمِرٌ ومجاهِدٌ إذا رَضِيَت عنك أمُّك","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-04486"],"otherNeedIds":[39],"ref":"الأحاديث المختارة 1857","srcLabel":"البخاري","text":["«أتى رَجُلٌ النَّبيَّ صلَّى اللهُ عليه وسلَّم فقال: إنِّي أشتهي الجِهادَ، وإنِّي لا أقدِرُ عليه؟ قال: هل بَقِيَ أحَدٌ من والِدَيك؟ قال: أمِّي، قال: ",["فأَبْلِ اللهَ عُذرًا في بِرِّها",1],"؛ فإنَّك إذا فعَلْتَ ذلك ",["فأنت حاجٌّ ومُعتَمِرٌ ومجاهِدٌ إذا رَضِيَت عنك أمُّك",2],"، فاتَّقِ اللهَ في بِرِّها، اللَّفظُ واحِدٌ [ ... ]، فأَبْلِ عُذرًا في بِرِّها، وفي آخِرِه: وبِرَّها»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"علم › حسن السؤال ونصح العالم","dorar":"fD4KfpQW"},{"id":"س-04486","fp":"4893b8596ffd","stateId":525,"easy":"إذا اجتهدت في بر أمك ← لك أجر حاج ومعتمر ومجاهد","cause":"اللهَ في برِّها","result":"كان لك أجرُ حاجٍّ ومعتمرٍ ومجاهدٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-07229","otherNeedIds":[39],"ref":"مجمع الزوائد 8/141","text":["أتى رجلٌ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقال إنِّي أشتَهي الجهادَ ولا أقدِرُ عليه قال هل بقي من والدَيْك أحدٌ قال أمِّي قال ",["اللهَ في برِّها",1]," فإذا فعَلْتَ ذلك ",["كان لك أجرُ حاجٍّ ومعتمرٍ ومجاهدٍ",2]," فإذا رضِيَت عنك أمُّك فاتَّقِ وبِرَّها"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح غير ميمون بن نجيح وثقه ابن حبان","takhrij":"أخرجه أبو يعلى (2760)، والطبراني في ((المعجم الأوسط)) (2915)","bab":"جهاد › فضل الجهاد","dorar":"afBIywD0"},{"id":"س-06808","fp":"cab23fbc4221","stateId":525,"easy":"إذا نظر الوالد إلى ولده فسرّه ← كان للولد عتق نسمة","cause":"إذا نَظَرَ الوالِدُ إلى وَلَدِه فسَرَّهُ","result":"كانَ للوَلَدِ عِتقُ نَسَمَةٍ","explicit":true,"ref":"مجمع الزوائد 8/159","srcLabel":"الطبراني","text":[["إذا نَظَرَ الوالِدُ إلى وَلَدِه فسَرَّهُ، ",1],["كانَ للوَلَدِ عِتقُ نَسَمَةٍ",2],"، قيلَ: يا رسولَ اللهِ، وإنْ نَظَرَ ثلاثَ مِئَةٍ وسِتينَ نَظْرةً؟! قالَ: اللهُ أكبرُ."],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (11/239) (11608)","bab":"عتق وولاء › فضل العتق","dorar":"SBFEcDro"},{"id":"س-02053","fp":"9fa1d9d7cb18","stateId":525,"easy":"إذا دللت على الخير ← فأنت كفاعله","cause":"دليلُ الخيرِ","result":"كفاعلِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح الجامع 3390","srcLabel":"عبد الرحمن","text":[["دليلُ الخيرِ ",1],["كفاعلِهِ",2]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"حسن","takhrij":"أخرجه عبد الرحمن الكزبري في ((انتخاب العوالي والشيوخ من فهارس)) (ص40)، ومحمد الفاداني في ((العجالة في الأحاديث المسلسلة)) (ص70)، بلفظ:\"الدال على الخير كفاعله\"","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"OighFjyH"},{"id":"س-02302","fp":"026fbe3bfc1f","stateId":526,"easy":"إذا صليت ركعتين وأنت متزوج ← فهما خير من اثنتين وثمانين ركعة للأعزب","cause":"ركعتانِ مِن المتأهِّلِ","result":"خَيرٌ مِن اثنَتَينِ وثمانينَ رَكعةً مِن العَزَبِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[37],"ref":"الأحاديث المختارة 2101","srcLabel":"البخاري","text":["«",["ركعتانِ مِن المتأهِّلِ",1]," ",["خَيرٌ مِن اثنَتَينِ وثمانينَ رَكعةً مِن العَزَبِ",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"gkkXe5y7"},{"id":"س-01290","fp":"d86fc67858fa","stateId":526,"easy":"إذا صليت ركعتين وأنت متزوج ← فهما خير من سبعين ركعة لغير المتزوج","cause":"رَكعَتانِ مِن مُتَأهِّلٍ","result":"خَيرٌ مِن سبعينَ رَكعةً مِن غَير مُتَأهِّلٍ","explicit":true,"star":true,"apply":{"k":"count","t":"ركعتين"},"otherNeedIds":[37],"ref":"فيض القدير 4/ 157","srcLabel":"ابن عدي","text":["شِرارُكُم عُزَّابُكُم، ",["رَكعَتانِ مِن مُتَأهِّلٍ",1]," ",["خَيرٌ مِن سبعينَ رَكعةً مِن غَير مُتَأهِّلٍ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"رمز السيوطي لحسنه وليس ذا منه بحسن","takhrij":"أخرجه ابن عدي في ((الكامل)) (7/ 163)، وابن الجوزي في ((الموضوعات)) (1251) معلقًا واللفظ لهما، وأبو يعلى (2042) مختصرًا.","bab":"نكاح › الحث على التزويج","dorar":"eBZEtCZt"},{"id":"س-07184","fp":"7dacf885dd9c","stateId":527,"easy":"إذا وقع الطاعون في بلدك فمكثت صابراً محتسباً ← فلك مثل أجر شهيد","cause":"فليس مِن عَبدٍ وقَعَ الطَّاعونُ في بَلَدِه، فيَمكُثُ في بَلَدِه صابِرًا مُحتسِبًا، يَعلَمُ أنَّه لن يُصيبَه إلَّا ما كتَبَ اللهُ له","result":"إلَّا كان له مِثلُ أجْرِ شَهيدٍ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 25212","srcLabel":"البخاري","text":["أنَّها سألتْ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عنِ الطَّاعونِ، فأخبَرَها نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّهُ كان عَذابًا يَبعَثُه اللهُ عزَّ وجلَّ على مَن يَشاءُ، فجعَلَه اللهُ رَحمةً لِلمُؤمِنينَ، ",["فليس مِن عَبدٍ وقَعَ الطَّاعونُ في بَلَدِه، فيَمكُثُ في بَلَدِه صابِرًا مُحتسِبًا، يَعلَمُ أنَّه لن يُصيبَه إلَّا ما كتَبَ اللهُ له",1],"، ",["إلَّا كان له مِثلُ أجْرِ شَهيدٍ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (3474)، والنسائي في ((السنن الكبرى)) (7527)، وأحمد (24358) واللفظ له","bab":"علم › حسن السؤال ونصح العالم","dorar":"7AW954KV","merged":2,"otherRefs":["صحيح البخاري 3474 (صحيح)"]},{"id":"س-05684","fp":"b08b95fcae8b","stateId":527,"easy":"إذا صبرت على أذى (الأمير أو البلاء) ← فأنت كالمجاهد في سبيل الله","cause":"والصَّابرُ عليهِ","result":"كالمجاهدِ في سبيلِ اللَّهِ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"مجمع الزوائد 2/318","srcLabel":"البخاري","text":[". . . . ",["والصَّابرُ عليهِ",1]," ",["كالمجاهدِ في سبيلِ اللَّهِ",2]," أي الطاعونِ"],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (5531) واللفظ له تامًا، والبخاري (3474)، وأحمد (24358) بمعناه مطولًا.","bab":"رقائق وزهد › الصبر على البلاء","dorar":"yqKl9dUR"},{"id":"س-02864","fp":"f2b6d300f794","stateId":527,"easy":"إذا عزّيت مصاباً ← فلك مثل أجره","cause":"مَن عزَّى مصابًا","result":"فلَهُ مثلُ أجرِهِ","explicit":true,"otherNeedIds":[45],"ref":"تحفة المحتاج 1/614","srcLabel":"الترمذي","text":[["مَن عزَّى مصابًا ",1],["فلَهُ مثلُ أجرِهِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح أو حسن [كما اشترط على نفسه في المقدمة]","takhrij":"أخرجه الترمذي (1073)، وابن ماجه (1602)","bab":"إيمان › الوعد","dorar":"9DDXxtjr"},{"id":"س-00605","fp":"eaf942a57129","stateId":527,"easy":"إذا صبرت في الطاعون ← فأنت كالصابر في الزحف","cause":"والصابِرُ فيهِ","result":"كالصابِرِ في الزَّحْفِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[9],"ref":"صحيح الجامع 4276","srcLabel":"أحمد","text":["الفارُّ مِنَ الطاعونِ كالفارِّ مِنَ الزَّحْفِ ، ",["والصابِرُ فيهِ",1]," ",["كالصابِرِ في الزَّحْفِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14518)، وعبد بن حميد في ((مسنده)) (1116) واللفظ لهما، والطبري في ((تهذيب الآثار)) (92) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"8Vk5OzKE"},{"id":"س-01613","fp":"0e711b587930","stateId":528,"easy":"إذا مشيت مع أخيك في حاجته ← فهو أحب من اعتكاف شهر في المسجد النبوي","cause":"ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ","result":"أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا","explicit":true,"ref":"السلسلة الصحيحة 906","srcLabel":"الطبراني","text":["أحبُّ الناسِ إلى اللهِ أنْفَعُهُمْ لِلنَّاسِ، وأحبُّ الأعمالِ إلى اللهِ عزَّ وجلَّ سُرُورٌ يدْخِلُهُ على مسلمٍ، أوْ يكْشِفُ عنهُ كُرْبَةً، أوْ يقْضِي عنهُ دَيْنًا، أوْ يَطْرُدُ عنهُ جُوعًا، ",["ولأنْ أَمْشِيَ مع أَخٍ لي في حاجَةٍ",1]," ",["أحبُّ إِلَيَّ من أنْ أعْتَكِفَ في هذا المسجدِ -يعني: مسجدَ المدينةِ- شهرًا",2],"، و مَنْ كَفَّ غضبَهُ سترَ اللهُ عَوْرَتَهُ، ومَنْ كَظَمَ غَيْظَهُ و لَوْ شاءَ أنْ يُمْضِيَهُ أَمْضَاهُ مَلأَ اللهُ قلبَهُ رَجَاءً يومَ القيامةِ، ومَنْ مَشَى مع أَخِيهِ في حاجَةٍ حتى تتَهَيَّأَ لهُ أَثْبَتَ اللهُ قَدَمَهُ يومَ تَزُولُ الأَقْدَامِ، [و إِنَّ سُوءَ الخُلُقِ يُفْسِدُ العَمَلَ، كما يُفْسِدُ الخَلُّ العَسَلَ]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6026)، وأبو الشيخ في ((التوبيخ والتنبيه)) (97) باختلاف يسير.","bab":"أطعمة › إطعام الطعام","dorar":"3mmEYTsk"},{"id":"س-02003","fp":"2856883ea3b0","stateId":528,"easy":"إذا جهّزت غازياً أو حاجاً أو خلفته في أهله أو فطّرت صائماً ← فلك مثل أجورهم","cause":"مَن جَهَّزَ غازيًا أو جَهَّزَ حاجًّا، أو خلفَهُ في أَهْلِهِ أو فطَّرَ صائمًا","result":"كانَ لَهُ مثلُ أجورِهِم مِن غيرِ أن يُنتَقصَ مِن أجورِهِم شيءٌ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 479","srcLabel":"ابن خزيمة","text":[["مَن جَهَّزَ غازيًا أو جَهَّزَ حاجًّا، أو خلفَهُ في أَهْلِهِ أو فطَّرَ صائمًا ",1],["كانَ لَهُ مثلُ أجورِهِم مِن غيرِ أن يُنتَقصَ مِن أجورِهِم شيءٌ ",2],"[وفي روايةٍ] لم يقُلْ أو جَهَّزَ حاجًّا"],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"أخرجه في صحيحه","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IQt2ZHQ5"},{"id":"س-06752","fp":"ae1f849df924","stateId":528,"easy":"إذا سعيت على الأرملة والمسكين ← فأنت كالمجاهد في سبيل الله","cause":"السَّاعي على الأرمَلةِ والمِسكينِ","result":"كالمُجاهِدِ في سَبيلِ اللهِ وأحسِبُه","explicit":true,"star":true,"ref":"صحيح البخاري 6007","srcLabel":"متفق عليه","text":["\"",["السَّاعي على الأرمَلةِ والمِسكينِ",1]," ",["كالمُجاهِدِ في سَبيلِ اللهِ\" وأحسِبُه",2]," قال -يَشُكُّ القَعنَبيُّ-:\" كالقائِمِ لا يَفتُرُ، وكالصَّائِمِ لا يُفطِرُ\"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5353 )، ومسلم (2982)","bab":"صيام › فضل الصيام","dorar":"gcHW6JfT","merged":4,"otherRefs":["صحيح الجامع 1476 (صحيح)","صحيح الأدب المفرد 98 (صحيح)","صحيح الجامع 3680 (صحيح)"]},{"id":"س-04476","fp":"6f652683b2f7","stateId":528,"easy":"إذا جهّزت غازياً أو خلفته في أهله أو فطّرت صائماً ← فلك مثل أجره لا ينقص منه شيء","cause":"مَن جَهَّزَ غَازِيًا أو خَلَفَهُ في أهْلِهِ ، أو فَطَّرَ صَائِمًا","result":"فله مِثْلُ أجْرِهِ من غَيْرِ أن يَنقُصَ مِنْ أَجْرِهِ شيئًا","explicit":true,"star":true,"otherNeedIds":[45],"ref":"السنن الكبرى للبيهقي 4/240","srcLabel":"متفق عليه","text":[["مَن جَهَّزَ غَازِيًا أو خَلَفَهُ في أهْلِهِ ، أو فَطَّرَ صَائِمًا ",1],["فله مِثْلُ أجْرِهِ من غَيْرِ أن يَنقُصَ مِنْ أَجْرِهِ شيئًا",2]],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"محفوظ","takhrij":"أخرجه الدارمي (2463)، وابن ماجه (2759) واللفظ لهما، والبخاري (2843)، ومسلم (1895) بنحوه.","bab":"جهاد › فضل الجهاد","dorar":"ogy4BIdx","merged":2,"otherRefs":["تخريج شرح السنة 1819 (صحيح)"]},{"id":"س-06246","fp":"56090f3087ed","stateId":528,"easy":"إذا أعنت رجلاً على دابته أو قلت كلمة طيبة ← فهي صدقة","cause":"يُعينُ الرَّجُلَ في دابَّتِه، يُحامِلُه عليها، أو يَرفَعُ عليها مَتاعَه: صَدَقةٌ، والكَلِمةُ الطَّيِّبةُ، وكُلُّ خَطوةٍ يَمشيها إلى الصَّلاةِ: صَدَقةٌ، ودَلُّ الطَّريقِ","result":"صَدَقةٌ","explicit":true,"star":true,"similar":["س-06288"],"ref":"صحيح البخاري 2891","srcLabel":"متفق عليه","text":["كُلُّ سُلامى عليه صَدَقةٌ كُلَّ يَومٍ؛ ",["يُعينُ الرَّجُلَ في دابَّتِه، يُحامِلُه عليها، أو يَرفَعُ عليها مَتاعَه: صَدَقةٌ، والكَلِمةُ الطَّيِّبةُ، وكُلُّ خَطوةٍ يَمشيها إلى الصَّلاةِ: صَدَقةٌ، ودَلُّ الطَّريقِ",1]," ",["صَدَقةٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2891)، ومسلم (1009)","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"2jhl7Psd"},{"id":"س-06288","fp":"07147835be96","stateId":528,"easy":"إذا عدلت بين اثنين وأعنت الرجل على دابته ← فهي صدقة","cause":"يعدِلُ بينَ اثنينِ ويُعينُ الرَّجلَ في دابَّتِه ويحمِلُه عليها ويرفَعُ له عليها متاعَه ويُميطُ الأذى عن الطَّريقِ","result":"صدقةٌ","explicit":true,"repOf":"س-06246","ref":"تخريج صحيح ابن حبان 3381","text":["كلُّ سُلامى مِن النَّاسِ عليه صدقةٌ: كلَّ يومٍ تطلُعُ عليه الشَّمسُ ",["يعدِلُ بينَ اثنينِ ويُعينُ الرَّجلَ في دابَّتِه ويحمِلُه عليها ويرفَعُ له عليها متاعَه ويُميطُ الأذى عن الطَّريقِ",1]," ",["صدقةٌ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (2989)، ومسلم (1009)، وأحمد (8183) جميعا بلفظه مطولا.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"0wtQ8JND"},{"id":"س-00591","fp":"3af741c50bef","stateId":528,"easy":"إذا رأيت عورة فسترتها ← فكأنما أحييت موءودة من قبرها","cause":"مَن رَأى عَورةً فسَتَرها","result":"كان كمَن اسْتَحْيا مَوْءودةً مِن قَبرِها","explicit":true,"similar":["س-03758","س-04905"],"ref":"المستدرك على الصحيحين 8374","srcLabel":"أبو داود","text":[["مَن رَأى عَورةً فسَتَرها ",1],["كان كمَن اسْتَحْيا مَوْءودةً مِن قَبرِها",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح الإسناد ولم يخرجاه","takhrij":"أخرجه أحمد (17447)، والنسائي في ((الكبرى)) (7242) كلاهما بلفظه، وأبو داود (4891) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"AF2dkhTx"},{"id":"س-03758","fp":"a12544581370","stateId":528,"easy":"إذا سترت عورة مؤمن ← فكأنما أحييت موءودة","cause":"من ستَر على مؤمنٍ عورةً","result":"فكأنَّما أحيا موءودةً فضرب بعيرَه راجعًا","explicit":true,"repOf":"س-00591","ref":"الترغيب والترهيب 3/240","text":["بينا أنا على مصرَ فأتَى البوَّابُ فقال إنَّ أعرابيًّا على البابِ يستأذنُ فقلتُ من أنت قال أنا جابرُ بنُ عبدِ اللهِ قال فأشرفتُ عليه فقلتُ أنزِلُ إليك أو تصعدُ قال لا تنزِلُ ولا أصعدُ حديثٌ بلَغني أنَّك ترويه عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في سِترِ المؤمنِ جئتَ أسمعُه قلتُ سمِعتُ رسول اللهِ صلَّى اللهُ عليه وسلَّم يقولُ ",["من ستَر على مؤمنٍ عورةً ",1],["فكأنَّما أحيا موءودةً فضرب بعيرَه راجعًا",2]],"grade":"صحيح","narrator":"مسلمة بن مخلد","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (8133) بزيادة في أوله، والرامهرمزي في ((المحدث)) (113) مختصرا.","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"61tE89Ws"},{"id":"س-04905","fp":"83e9e3d9bbba","stateId":528,"easy":"إذا سترت عورة مؤمن ← فكأنما أحييت موءودة في قبرها","cause":"مَن ستَر عورةَ مؤمنٍ","result":"فكأنَّما استحيا مَوْؤودةً في قبرِها","explicit":true,"repOf":"س-00591","ref":"صحيح ابن حبان 517","text":["قُلْتُ لِعُقبةَ بنِ عامرٍ: إنَّ لنا جيرانًا يشرَبونَ الخمرَ وأنا داعٍ الشُّرَطَ ليأخُذُوهم فقال عُقبةُ: ويحَكَ لا تفعَلْ ولكِنْ عِظْهم وهدِّدْهم قال: إنِّي نهَيْتُهم فلم ينتَهوا وإنِّي داعٍ الشُّرَطَ ليأخُذوهم فقال عُقبةُ: ويحَكَ لا تفعَلْ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ( ",["مَن ستَر عورةَ مؤمنٍ ",1],["فكأنَّما استحيا مَوْؤودةً في قبرِها",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (17395) باختلاف يسير، والنسائي في ((السنن الكبرى)) (7243)، والروياني في ((مسنده)) (252) بنحوه.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ey8JAKfK"},{"id":"س-06064","fp":"587b1a3fe2b2","stateId":528,"easy":"إذا أمرت بالمعروف ونهيت عن المنكر ← فهو صلاة (صدقة عن مفاصلك)","cause":"أمرٌ بالمعروفِ ونهيٌ عن المنكرِ","result":"صلاةٌ","explicit":true,"ref":"السلسلة الصحيحة 2/120","srcLabel":"الطبراني","text":["على كلِّ مِيسمٍ من الإنسانِ صلاةٌ ( وفي روايةٍ يصبحُ على كلِّ ميسمٍ من ابنِ آدم كلَّ يومٍ صدقةٌ ) فقال رجلٌ من القومِ : ومن يطيقُ هذا ؟ فقال : ",["أمرٌ بالمعروفِ ونهيٌ عن المنكرِ",1]," ",["صلاةٌ",2]," , وإنَّ حملًا عن الضعيفِ صلاةٌ , وإنَّ كلَّ خطوةٍ يخطوها أحدُكم إلى صلاةٍ صلاةٌ"],"grade":"صحيح","narrator":"عبد الله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (2434)، وابن خزيمة (1497)، والطبراني (11/297) (11791)","bab":"رقائق وزهد › ما جاء في السعي لقضاء حوائج الخلق","dorar":"jCcOFvxQ"},{"id":"س-06065","fp":"c8833fbf7ad4","stateId":528,"easy":"إذا حملت عن الضعيف ← فهو صلاة","cause":"حملًا عن الضعيفِ","result":"صلاةٌ","explicit":true,"ref":"السلسلة الصحيحة 2/120","srcLabel":"الطبراني","text":["على كلِّ مِيسمٍ من الإنسانِ صلاةٌ ( وفي روايةٍ يصبحُ على كلِّ ميسمٍ من ابنِ آدم كلَّ يومٍ صدقةٌ ) فقال رجلٌ من القومِ : ومن يطيقُ هذا ؟ فقال : أمرٌ بالمعروفِ ونهيٌ عن المنكرِ صلاةٌ , وإنَّ ",["حملًا عن الضعيفِ",1]," ",["صلاةٌ",2]," , وإنَّ كلَّ خطوةٍ يخطوها أحدُكم إلى صلاةٍ صلاةٌ"],"grade":"صحيح","narrator":"عبد الله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو يعلى (2434)، وابن خزيمة (1497)، والطبراني (11/297) (11791)","bab":"رقائق وزهد › ما جاء في السعي لقضاء حوائج الخلق","dorar":"jCcOFvxQ"},{"id":"س-06300","fp":"c916049197fb","stateId":528,"easy":"إذا أمرت بالمعروف ونهيت عن المنكر وحملت الضعيف وأمطت الأذى ← فهي صلاة تؤدي حق كل عضو كل يوم","cause":"أمرُكَ بالمعروفِ، ونَهْيُكَ عنِ المنكرِ صلاةٌ، وحَملُكَ على الضَّعيفِ صلاةٌ، وإنحاؤُكَ القذرَ عنِ الطَّريقِ صلاةٌ، وَكُلُّ خُطوةٍ تَخطوها إلى الصَّلاةِ","result":"على كلِّ عُضوٍ منَ الإنسانِ صلاةٌ كلَّ يومٍ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 27","srcLabel":"ابن حبان","text":[["على كلِّ عُضوٍ منَ الإنسانِ صلاةٌ كلَّ يومٍ",2],"، فقالَ رجلٌ منَ القومِ: هذا مِن أشدِّ ما أتَيتَنا بِهِ قالَ: ",["أمرُكَ بالمعروفِ، ونَهْيُكَ عنِ المنكرِ صلاةٌ، وحَملُكَ على الضَّعيفِ صلاةٌ، وإنحاؤُكَ القذرَ عنِ الطَّريقِ صلاةٌ، وَكُلُّ خُطوةٍ تَخطوها إلى الصَّلاةِ",1]," صلاةٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن حبان (792)، والطبراني في ((المعجم الأوسط)) (4449) ، والبيهقي في ((شعب الإيمان)) (11235) بنحوه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"JpT0AhgB"},{"id":"س-07130","fp":"35e222533636","stateId":528,"easy":"إذا دفنت النخاعة في المسجد أو نحيت الأذى عن الطريق ← تؤدي صدقة مفاصلك","cause":"النُّخَاعَةُ في المسجدِ تَدْفِنُها ، والشَّيْءُ تُنَحِّيهِ عَنِ الطَّرِيقِ ، فإنْ لمْ تَقْدِرْ فَرَكْعَتَا الضُّحَى تُجزِي عَنْكَ","result":"أنْ يَتَصَدَّقَ عن كلِّ مَفْصِلٍ مِنْها صدقةً","explicit":true,"ref":"صحيح الترغيب 2971","srcLabel":"أبو داود","text":["في الإنسانِ سِتونَ وثلاثُمِائَةِ مَفْصِلٍ ، فَعليهِ ",["أنْ يَتَصَدَّقَ عن كلِّ مَفْصِلٍ مِنْها صدقةً",2]," قالوا : فمَنْ يطيقُ ذلكَ يا رسولَ اللهِ ! قال : ",["النُّخَاعَةُ في المسجدِ تَدْفِنُها ، والشَّيْءُ تُنَحِّيهِ عَنِ الطَّرِيقِ ، فإنْ لمْ تَقْدِرْ فَرَكْعَتَا الضُّحَى تُجزِي عَنْكَ",1]],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5242)، وأحمد (23037) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"f49GNAj2"},{"id":"س-01815","fp":"4451d5138311","stateId":528,"easy":"إذا سعيت على عيالك أو على نفسك لتعفها ← فأنت في سبيل الله","cause":"ومَن سعى على عيالِه ففي سبيلِ اللهِ ومَن سعى على نفسهِ لِيَعُفَّها","result":"فهو في سبيلِ اللهِ ,ومَن سعى مُكَاثِرًا ففي سبيلِ الطاغوتِ","explicit":true,"ref":"السلسلة الصحيحة 5/272","srcLabel":"الطبراني","text":["بينا نحنُ مع رسولِ اللهِ _صلى الله عليه وسلم_ إذ طلع شابٌ من الثَّنيَّةِ ,فلما رأيناه رَميْناه بأبصَارِنا ,فقلنا :لو أنَّ هذا الشابُ جَعل شبابَه ونشاطَه وقوتَه في سبيلِ اللهِ !فَسَمِعَ رسولُ اللهِ _صلى الله عليه وسلم_  مقالتَنا فقال: \"وما سبيلُ اللهِ إلا مَن قُتِلَ ؟مَن سعى على والدَيْهِ ففي سبيلِ اللهِ, ",["ومَن سعى على عيالِه ففي سبيلِ اللهِ ومَن سعى على نفسهِ لِيَعُفَّها ",1],["فهو في سبيلِ اللهِ ,ومَن سعى مُكَاثِرًا ففي سبيلِ الطاغوتِ \"",2],".في رواية سبيل الشيطان."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4214)، وأبو نعيم في ((حلية الأولياء)) (6/196) واللفظ له، والبيهقي (18280).\nوالرواية: أخرجها البيهقي (18280)","bab":"إجارة › كسب الرجل وعمله بيده","dorar":"Ki6NVStg"},{"id":"س-04731","fp":"d9ff4b452e9e","stateId":528,"easy":"إذا مشيت في حاجة أخيك وبلغت فيها ← فهو خير لك من اعتكاف عشر سنين","cause":"من مشَى في حاجةِ أخيه وبلغ فيها كان خيرًا له من اعتكافِ عشرِ سنين ومن اعتكف يومًا ابتغاءَ وجهِ اللهِ تعالَى","result":"وجعل اللهَ بينه وبين النَّارِ ثلاثَ خنادِقَ أبعدَ ممَّا بين الخافِقيْن","explicit":true,"ref":"الترغيب والترهيب 2/156","srcLabel":"الطبراني","text":["أنَّه كان معتكِفًا في مسجدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فأتاه رجلٌ فسلَّم عليه ثمَّ جلس فقال له ابنُ عبَّاسٍ يا فلانُ أراك مكتئِبًا حزينًا قال نعم يا بنَ عمِّ رسولِ اللهِ لفلانٍ عليَّ حقُّ ولاءٍ وحُرمةِ صاحبِ هذا القبرِ ما أقدِرُ عليه قال ابنُ عبَّاسٍ أفلا أكلِّمُه فيك فقال إن أحببْتَ قال فانتَعَل ابنُ عبَّاسٍ ثمَّ خرج من المسجدِ فقال له الرَّجلُ أنسِيتَ ما كنتَ فيه قال لا ولكنِّي سمعتُ صاحبَ هذا القبرِ صلَّى اللهُ عليه وسلَّم والعهدُ به قريبٌ فدمِعَتْ عيناه وهو يقولُ ",["من مشَى في حاجةِ أخيه وبلغ فيها كان خيرًا له من اعتكافِ عشرِ سنين ومن اعتكف يومًا ابتغاءَ وجهِ اللهِ تعالَى ",1],["وجعل اللهَ بينه وبين النَّارِ ثلاثَ خنادِقَ أبعدَ ممَّا بين الخافِقيْن",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7326) دون القصة في أوله، والبيهقي في ((شعب الإيمان)) (3965)، والخطيب في ((تاريخ بغداد)) (4/126) باختلاف يسير","bab":"رقائق وزهد › الإخلاص","dorar":"Bg2CXpyy"},{"id":"س-07624","fp":"1551184c0163","stateId":529,"easy":"إذا هدى الله بك رجلاً واحداً ← فهو خير لك من حمر النعم","cause":"لَأن يَهديَ اللهُ بكَ رَجُلًا واحِدًا","result":"خَيرٌ لكَ مِن أن يَكونَ لكَ حُمْرُ النَّعَمِ","explicit":true,"star":true,"ref":"صحيح البخاري 4210","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال يَومَ خَيبَرَ: لَأُعطيَنَّ هذه الرَّايةَ غَدًا رَجُلًا يَفتَحُ اللهُ على يَدَيه، يُحِبُّ اللهَ ورَسولَه، ويُحِبُّه اللهُ ورَسولُه، قال: فباتَ النَّاسُ يَدوكونَ لَيلَتَهم: أيُّهم يُعطاها؟ فلَمَّا أصبَحَ النَّاسُ غَدَوا على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم كُلُّهم يَرجو أن يُعطاها، فقال: أينَ عَليُّ بنُ أبي طالِبٍ؟ فقيلَ: هو -يا رَسولَ اللهِ- يَشتَكي عَينَيه، قال: فأرسَلوا إليه. فأُتيَ به فبَصَقَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم في عَينَيه ودَعا له، فبَرَأ حتَّى كَأن لَم يَكُنْ به وجَعٌ، فأعطاه الرَّايةَ، فقال عَليٌّ: يا رَسولَ اللهِ، أُقاتِلُهم حتَّى يَكونوا مِثلَنا؟ فقال: انفُذْ على رِسلِكَ حتَّى تَنزِلَ بساحَتِهم، ثُمَّ ادعُهم إلى الإسلامِ، وأخبِرْهم بما يَجِبُ عليهم مِن حَقِّ اللهِ فيه؛ فواللهِ ",["لَأن يَهديَ اللهُ بكَ رَجُلًا واحِدًا",1]," ",["خَيرٌ لكَ مِن أن يَكونَ لكَ حُمْرُ النَّعَمِ",2],"."],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2406) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"QUIHeza5","merged":5,"otherRefs":["الجامع الصغير 7201 (حسن)","مجمع الزوائد 5/337 (حسن)","التمهيد 2/218 (صحيح)","صحيح البخاري 2942 (صحيح)"]},{"id":"س-05748","fp":"e1b888631b20","stateId":529,"easy":"إذا دللت على الخير ← فلك مثل أجر فاعله","cause":"الدالُّ على الخَيرِ","result":"له مِثلُ أجرِ فاعِلِهِ","explicit":true,"star":true,"similar":["س-06078","س-02249"],"otherNeedIds":[45],"ref":"تخريج مشكل الآثار 1547","srcLabel":"مسلم","text":["جاءَ رَجُلٌ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فقال: يا رسولَ اللهِ، أُبدِعَ بي فاحْمِلْني، فقال: ما أجِدُ ما أحمِلُكَ عليه، ائتِ فُلانًا، فأتاهُ فحَمَلَه، فأَتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فأخبَرَه، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["الدالُّ على الخَيرِ",1]," ",["له مِثلُ أجرِ فاعِلِهِ",2],"."],"grade":"صحيح","narrator":"أبو مسعود عقبة بن عمرو","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح المشكل)) (1547) بلفظه، ومسلم (1893)، وأبو داود (5129)، والترمذي (2671) جميعهم بنحوه.","bab":"رقائق وزهد › المبادرة إلى الخيرات","dorar":"h6YUaQU3","merged":4,"otherRefs":["صحيح الترمذي 2671 (صحيح)","صحيح أبي داود 5129 (صحيح)","الترغيب والترهيب 1/95 (صحيح)"]},{"id":"س-02303","fp":"f3989f9ea0fa","stateId":529,"easy":"إذا خرجت في طلب العلم ← فأنت في سبيل الله حتى ترجع","cause":"من خرج في طَلَبِ العِلْمِ","result":"فهو في سَبيلِ اللهِ تبارك وتعالى حتَّى يَرجِعَ","explicit":true,"ref":"الأحاديث المختارة 2120","srcLabel":"البخاري","text":["«",["من خرج في طَلَبِ العِلْمِ ",1],["فهو في سَبيلِ اللهِ تبارك وتعالى حتَّى يَرجِعَ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"IWEKjVd4"},{"id":"س-06078","fp":"e4e416e6da08","stateId":529,"easy":"إذا دللت على الخير ← فأنت كفاعله","cause":"الدالَ على الخيرِ","result":"كفاعلِه","explicit":true,"repOf":"س-05748","ref":"صحيح الترمذي 2670","text":["أتى النبيَّ صلى اللهُ عليهِ و سلمَ رجلٌ يستحملُه فلمْ يجدْ عندهُ ما يتحملُهُ فدلَّه على آخرٍ فحملَهُ فأتى النبيَّ صلى اللهُ عليهِ و سلمَ فأخبرَه فقال إنَّ ",["الدالَ على الخيرِ",1]," ",["كفاعلِه",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (2670)","bab":"رقائق وزهد › ما جاء في فعل الخير","dorar":"b49oOCxv","merged":3,"otherRefs":["النوافح العطرة 141 (صحيح)","تخريج المسند لشعيب 23027 (صحيح)"]},{"id":"س-02134","fp":"b17ac0160b9d","stateId":529,"easy":"إذا سننت سنة خير ← لك مثل أجر من عمل بها","cause":"مَن سَنَّ سُنَّةً ثم ذكَرَ بقيَّةَ الحديثِ الذي قبلَه، يعني: مَن سَنَّ سُنَّةً -كأنَّه يعني: حَسَنةً- فعَمِلَ بها مَن بعدَه","result":"كان له مِثلُ أجرِ مَن عَمِلَ بها من غَيرِ أنْ يُنتقَصَ من أُجورِهم شَيءٌ","explicit":true,"similar":["س-03665"],"otherNeedIds":[45,50],"ref":"تخريج مشكل الآثار 1541","srcLabel":"أحمد","text":["عن جَريرِ بنِ عبدِ اللهِ البَجَليِّ، أنَّه حدَّثَهم في ناحيةِ مسجِدِ الكوفةِ أنَّ رَجُلًا منَ الأنصارِ قامَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بصُرَّةٍ من ذَهَبٍ تَملأُ ما بينَ الأصابِعِ، فقال: يا رسولَ اللهِ، هذه في سَبيلِ اللهِ، ثم قام أبو بَكرٍ فأَعْطى، ثم قام عُمَرُ فأَعْطى، ثم قام المُهاجِرونَ والأنصارُ فأعطَوْا، فأشرَقَ وَجهُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حتى رَأيْنا الفَرَحَ في وَجهِه، فقال: عندَ ذلك: ",["مَن سَنَّ سُنَّةً ثم ذكَرَ بقيَّةَ الحديثِ الذي قبلَه، يعني: مَن سَنَّ سُنَّةً -كأنَّه يعني: حَسَنةً- فعَمِلَ بها مَن بعدَه، ",1],["كان له مِثلُ أجرِ مَن عَمِلَ بها من غَيرِ أنْ يُنتقَصَ من أُجورِهم شَيءٌ",2],"، ومَن سَنَّ سُنَّةً سيِّئةً فعَمِلَ بها مَن بعدَه، كان عليه مِثلُ وِزرِ مَن عَمِلَ بها من غَيرِ أنْ يُنتقَصَ من أوْزارِهم شَيءٌ."],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1541) واللفظ له، وأحمد (19183)، وعبد الرزاق (21025) باختلاف يسير.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"EYs2t2Fi","merged":2,"otherRefs":["تخريج مشكل الآثار 1540 (صحيح)"]},{"id":"س-07032","fp":"059e7f1ebd15","stateId":529,"easy":"إذا أتيت المسجد النبوي لخير تتعلمه أو تعلّمه ← فأنت بمنزلة المجاهدين في سبيل الله","cause":"مَن جاءَ مَسجدي هذا ، لَم يَأْتِه إلَّا لخيرٍ يَتعلَّمُه ، أو يُعلِّمُه","result":"فهوَ بِمنزِلَةِ المجاهدينَ في سَبيلِ اللهِ","explicit":true,"ref":"صحيح الترغيب 87","srcLabel":"ابن ماجه","text":[["مَن جاءَ مَسجدي هذا ، لَم يَأْتِه إلَّا لخيرٍ يَتعلَّمُه ، أو يُعلِّمُه",1]," ",["فهوَ بِمنزِلَةِ المجاهدينَ في سَبيلِ اللهِ",2]," ، و مَن جاءَ لغيرِ ذلكَ ، فهوَ بِمنزِلَةِ الرَّجُلِ يَنظرُ إلى مَتاعِ غيرِه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (227)، وأحمد (9419)","bab":"علم › الحث على طلب العلم","dorar":"SGWXGx2r","merged":2,"otherRefs":["المستدرك على الصحيحين 314 (صحيح)"]},{"id":"س-02249","fp":"9fe69db49923","stateId":529,"easy":"إذا دللت على الخير ← فأنت كفاعله","cause":"والدالُّ على الخيرِ","result":"كفاعلِه","explicit":true,"repOf":"س-05748","ref":"النوافح العطرة 141","text":["الدالُ على الخيرِ كفاعلِه [يعني حديث: كلُّ معروفٍ صدقةٌ ",["والدالُّ على الخيرِ ",1],["كفاعلِه",2]," واللهُ يحبُّ إغاثةَ اللهفانِ.]"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (7251 )، وابن عساكر في ((معجم الشيوخ)) (1272)،","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"wTwdLYzv"},{"id":"س-03665","fp":"24b1d8aefe0d","stateId":529,"easy":"إذا أحييت سنة من السنن فعمل بها الناس ← فلك مثل أجر من عمل بها","cause":"مَن أحيا سنَّةً من سنَّتي ، فعملَ بِها النَّاسُ","result":"كانَ لَهُ مثلُ أجرِ من عَمِلَ بِها ، لا يَنقصُ مِن أجورِهِم شيئًا","explicit":true,"repOf":"س-02134","otherNeedIds":[45,50],"ref":"صحيح ابن ماجه 174","text":[["مَن أحيا سنَّةً من سنَّتي ، فعملَ بِها النَّاسُ ، ",1],["كانَ لَهُ مثلُ أجرِ من عَمِلَ بِها ، لا يَنقصُ مِن أجورِهِم شيئًا",2]," ، ومن ابتدعَ بدعةً ، فعمِلَ بِها ، كانَ عليهِ أوزارُ مَن عملَ بِها ، لا ينقُصُ مِن أوزارِ من عملَ بِها شيئًا"],"grade":"صحيح","narrator":"عمرو بن عوف المزني","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (2677)، وابن ماجه (209) واللفظ له.","bab":"اعتصام بالسنة › الأمر بالتمسك بالكتاب والسنة","dorar":"I69gRFWy"},{"id":"س-07031","fp":"58304ce86ed8","stateId":529,"easy":"إذا تعلمت باباً من العلم ← فهو أحب إلى الله من ألف ركعة تطوعاً","cause":"لبابٌ يتعلمُه الرجلُ","result":"أحبُّ إلى اللهِ من ألفِ ركعةٍ تطوعًا","explicit":true,"similar":["س-07036"],"otherNeedIds":[18,23],"ref":"المتجر الرابح 22","srcLabel":"البزار","text":[["لبابٌ يتعلمُه الرجلُ",1]," ",["أحبُّ إلى اللهِ من ألفِ ركعةٍ تطوعًا",2],"، وقالا: قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ: إذا جاء الموتُ لطالبِ العلمِ وهو على هذه الحالةِ – مات وهو شهيدٌ."],"grade":"حسن","narrator":"أبو ذر وأبو هريرة","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه البزار (8574) بلفظه.","bab":"علم › الحث على طلب العلم","dorar":"JFNk2jAv"},{"id":"س-07036","fp":"7ca6cda9fb84","stateId":529,"easy":"إذا غدوت فتعلمت باباً من العلم ← فهو خير لك من ألف ركعة","cause":"ولأن تغدوَ فتعلَّمَ بابًا منَ العلمِ عُمِلَ بِهِ أو لم يُعمَلْ بهِ","result":"خيرٌ لكَ من أن تصلِّيَ ألفَ رَكْعةٍ","explicit":true,"repOf":"س-07031","otherNeedIds":[18],"ref":"الترغيب والترهيب 1/77","text":["يا أبا ذرٍّ لأن تغدوَ فتعلَّمَ آيةً من كتابِ اللَّهِ خيرٌ لَكَ من أن تصلِّيَ مئةَ رَكْعةٍ ",["ولأن تغدوَ فتعلَّمَ بابًا منَ العلمِ عُمِلَ بِهِ أو لم يُعمَلْ بهِ",1]," ",["خيرٌ لكَ من أن تصلِّيَ ألفَ رَكْعةٍ",2]],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"إسناده حسن","takhrij":"أخرجه ابن ماجه (219)، وابن شاهين في ((شرح مذاهب أهل السنة)) (54)، والديلمي في ((الفردوس)) (8362) باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"mdOmwQ7H"},{"id":"س-01363","fp":"61da82074467","stateId":530,"easy":"إذا نويت صادقاً «لو كان لي مال لعملت فيه بعمل فلان» ← فأجركما سواء","cause":"لو أن عندي مالًا ؛ لعمِلتُ فيه بعملِ فلانٍ","result":"فهو بنيَّتِه ؛ فأجرُهما سواءٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«لو كان لي مال لعملت فيه بعمل فلان»"},"ref":"مجموع فتاوى ابن عثيمين 506/8","srcLabel":"مجموع فتاوى ابن عثيمين","text":["قصةُ الرجلِ الذي كان له مالٌ يُنفقُه في سبلِ الخيرِ ، فقال الرجلُ الفقيرُ: ",["لو أن عندي مالًا ؛ لعمِلتُ فيه بعملِ فلانٍ",1]," ؛ قال النبيُّ صلَّى اللّهُ عليهِ وسلَّمَ : ",["فهو بنيَّتِه ؛ فأجرُهما سواءٌ",2]," ."],"grade":"صحيح","muhaddith":"صحيح","bab":"نية › النية في العبادات","dorar":"1eQfBf4n"},{"id":"س-01465","fp":"c0237c1dd4d3","stateId":530,"easy":"إذا أجنبت فتوضأت قبل النوم ← فهو نصف غسل الجنابة","cause":"إذَا أجنبَ أحدُكم مِنَ اللَّيلِ ثُمَّ أرادَ أنْ ينامَ فليتوضأْ","result":"فإنَّهُ نصفُ غُسْلِ الجنابةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"time","t":"عند النوم"},"ref":"عمدة القاري 3/362","srcLabel":"ابن أبي شيبة","text":["عن شدادِ بنِ أوسٍ الصحابِيِّ قالَ ",["إذَا أجنبَ أحدُكم مِنَ اللَّيلِ ثُمَّ أرادَ أنْ ينامَ فليتوضأْ",1]," ",["فإنَّهُ نصفُ غُسْلِ الجنابةِ",2]],"grade":"حسن","narrator":"[أبو قلابة عبدالله بن زيد]","muhaddith":"إسناد رجاله ثقات","takhrij":"أخرجه ابن أبي شيبة (668)، والقاضي إسماعيل في ((أحاديث أيوب)) (37)، وابن المنذر في ((الأوسط)) (600) بنحوه.","bab":"وضوء › فضل الوضوء","dorar":"2yYGyiaX"},{"id":"س-06751","fp":"c2cf0fab8625","stateId":530,"easy":"إذا طعمت وشكرت ← فأنت مثل الصائم الصابر","cause":"الطَّاعمُ الشَّاكِرُ","result":"مِثلُ الصَّائمِ الصَّابِرِ","explicit":true,"star":true,"similar":["س-00603"],"ref":"المستدرك على الصحيحين 7396","srcLabel":"الترمذي","text":["عنْ سَعيدِ بنِ أبي سَعيدٍ المَقبُرِيِّ، قالَ: كنْتُ أنا وحَنظلةُ بالبَقيعِ معَ أبي هُرَيرةَ رَضيَ اللهُ عنه، فحَدَّثَنا أبو هُريرةَ بالبَقيعِ عنْ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قالَ: ",["الطَّاعمُ الشَّاكِرُ",1]," ",["مِثلُ الصَّائمِ الصَّابِرِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2486)، وابن ماجة (1764)، وأحمد (7889) باختلاف يسير.","bab":"صيام › فضل الصيام","dorar":"irEJhPTM","merged":4,"otherRefs":["صحيح ابن ماجه 1440 (صحيح)","صحيح ابن ماجه 1439 (صحيح)","تخريج شرح السنة 2832 (صحيح)"]},{"id":"س-00603","fp":"d6e80f288279","stateId":530,"easy":"إذا أكلت وشكرت ← فلك من الأجر مثل الصائم الصابر","cause":"للطاعمِ الشاكرِ","result":"من الأجرِ ، مثلُ ما للصائمِ الصابرِ","explicit":true,"repOf":"س-06751","ref":"صحيح الجامع 2179","text":["إنَّ ",["للطاعمِ الشاكرِ",1]," ",["من الأجرِ ، مثلُ ما للصائمِ الصابرِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2486)، وابن ماجة (1764)، وأحمد (7889) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"Pyh1VYm5"},{"id":"س-02136","fp":"d25661931714","stateId":530,"easy":"إذا قتلت حية أو عقرباً ← فكأنما قتلت كافراً","cause":"مَن قتَلَ حيَّةً أو عَقربًا","result":"فقَدْ قتَلَ كافرًا","explicit":true,"ref":"تخريج مشكل الآثار 7/ 373","srcLabel":"أحمد","text":[["مَن قتَلَ حيَّةً أو عَقربًا",1],"، ",["فقَدْ قتَلَ كافرًا",2],"، أو فكأنَّما قتَلَ كافرًا."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"إسناده رجاله رجال الصحيح","takhrij":"أخرجه أحمد (3746) باختلاف يسير، والبزار (1847)، والطبراني (9/ 351) (9745) واللفظ لهما","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0KWN0b8B"},{"id":"س-02270","fp":"8c5f88270915","stateId":530,"easy":"إذا حبسك العذر عن الخير ← تشارك العاملين في الأجر","cause":"حبسَهمُ العذر","result":"إلاَّ شرِكوكم في الأجرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"star":true,"ref":"تفسير القرطبي 7/57","srcLabel":"مسلم","text":["حديثٌ إنَّ بالمدينةِ رجالًا [ما قطعتم واديًا، ولاَ سلَكتم طريقًا، ",["إلاَّ شرِكوكم في الأجرِ",2],"، ",["حبسَهمُ العذر",1],". قالَ أبو عبدِ الله: أو كما قالَ كتبتُهُ لفظًا.]"],"grade":"صحيح","narrator":"[جابر بن عبدالله]","muhaddith":"صحيح","takhrij":"أخرجه ماجه (2765) بلفظه، ومسلم (1911)، وأحمد (14208) كلاهما بمعناه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Tqhr4tXO"},{"id":"س-02149","fp":"63533b385e4c","stateId":531,"easy":"إذا كنت خازناً أميناً تعطي ما أُمرت به طيبة نفسك ← فأنت أحد المتصدقين","cause":"الخازِنَ المُسلِمَ الأمينَ الذي يُنفِذُ -ورُبَّما قال: يُعطي- ما أُمِرَ به، فيُعطيه كامِلًا موفَّرًا، طَيِّبةً به نَفسُه","result":"أحَدُ المُتَصَدِّقَينِ","explicit":true,"star":true,"similar":["س-06333"],"ref":"صحيح مسلم 1023","srcLabel":"البخاري","text":["إنَّ ",["الخازِنَ المُسلِمَ الأمينَ الذي يُنفِذُ -ورُبَّما قال: يُعطي- ما أُمِرَ به، فيُعطيه كامِلًا موفَّرًا، طَيِّبةً به نَفسُه",1],"، فيَدفَعُه إلى الذي أُمِرَ له به: ",["أحَدُ المُتَصَدِّقَينِ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1438) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Fc0AV5DU","merged":2,"otherRefs":["صحيح البخاري 2319 (صحيح)"]},{"id":"س-06333","fp":"8760e465bad9","stateId":531,"easy":"إذا كنت خازناً أميناً تؤدي ما أُمرت به طيبة نفسك ← فأنت أحد المتصدقين","cause":"الخازنُ الأمينُ الذي يُؤدِّي ما أُمِرَ به طَيِّبةً به نَفْسُه","result":"أحَدُ المُتصدِّقينَ","explicit":true,"repOf":"س-02149","ref":"تخريج المسند لشعيب 19667","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ إذا جاءه السَّائلُ أو ذو الحاجةِ قال: اشفَعوا تُؤجَروا، وليَقضِ اللهُ عزَّ وجلَّ على لِسانِ رسولِه ما شاء، وقال: المؤمنُ لِلمؤمنِ كالبُنْيانِ، يَشُدُّ بعضُه بعضًا، وقال: ",["الخازنُ الأمينُ الذي يُؤدِّي ما أُمِرَ به طَيِّبةً به نَفْسُه",1]," ",["أحَدُ المُتصدِّقينَ",2],"."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (1432، 2446، 2260) مفرقاً، ومسلم (2627، 2585، 1023) مفرقاً، وأبو داود (5133، 1684) مفرقاً مختصراً، والترمذي (2672، 1928) مفرقاً مختصراً، والنسائي (2560) مختصراً، وأحمد (19667) واللفظ له","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"ehUblHHg","merged":2,"otherRefs":["تخريج المسند لشعيب 19624 (صحيح)"]},{"id":"س-00521","fp":"e9c33d6d7491","stateId":531,"easy":"إذا عملت عاملاً فأخذت الحق وأعطيت الحق ← تبقى كالمجاهد في سبيل الله حتى ترجع","cause":"العاملُ إذا استُعمِل فأخذ الحقَّ وأعطَى الحقَّ","result":"لم يزلْ كالمجاهدِ في سبيلِ اللهِ حتّى يرجعَ إلى بيتِه","explicit":true,"ref":"الترغيب والترهيب 2/22","srcLabel":"الطبراني","text":[["العاملُ إذا استُعمِل فأخذ الحقَّ وأعطَى الحقَّ",1]," ",["لم يزلْ كالمجاهدِ في سبيلِ اللهِ حتّى يرجعَ إلى بيتِه",2]],"grade":"صحيح","narrator":"عبدالرحمن بن عوف","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (1/134) (282)","bab":"آداب عامة › ضرب الأمثال","dorar":"95IUicJT"},{"id":"س-00634","fp":"6c5e83842ce2","stateId":531,"easy":"إذا عملت على الصدقة بالحق ← فأنت كالغازي في سبيل الله","cause":"العاملُ على الصَّدقةِ بالحقِّ لوجهِ اللهِ تعالَى","result":"كالغازي في سبيلِ اللهِ عزَّ وجلَّ حتَّى يرجعَ إلى أهلِه","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الترغيب والترهيب 2/22","srcLabel":"أبو داود","text":[["العاملُ على الصَّدقةِ بالحقِّ لوجهِ اللهِ تعالَى",1]," ",["كالغازي في سبيلِ اللهِ عزَّ وجلَّ حتَّى يرجعَ إلى أهلِه",2]],"grade":"صحيح","narrator":"رافع بن خديج","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (2936)، والترمذي (645)، وابن ماجه (1809)، وأحمد (15864) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"p5ArPIKQ"},{"id":"س-02166","fp":"373b1b16acc6","stateId":532,"easy":"إذا عبدت الله في زمن الفتنة ← فهو كهجرة إلى النبي ﷺ","cause":"عبادةٌ في الهرْجِ و الفتنةِ","result":"كهجرةٍ إليَّ","explicit":true,"star":true,"ref":"صحيح الجامع 3974","srcLabel":"مسلم","text":[["عبادةٌ في الهرْجِ و الفتنةِ",1]," ",["كهجرةٍ إليَّ",2]],"grade":"صحيح","narrator":"معقل بن يسار","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2948)، وابن ماجة (3985)، وأحمد (20298) واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8TZdT4hf","merged":3,"otherRefs":["صحيح الجامع 4119 (صحيح)","صحيح الترمذي 2201 (صحيح)"]},{"id":"س-06032","fp":"8ad296a421f1","stateId":532,"easy":"إذا عملت في زمن الفتن ← فلك أجر خمسين","cause":"لِلْعَامِلِ فِيهَا","result":"أَجْرُ خَمْسِينَ","explicit":true,"otherNeedIds":[16],"ref":"مجمع الزوائد 7/285","srcLabel":"ابن حبان","text":["إنَّ مِنْ ورائِكُمْ أيامَ الصبرِ الصبرُ فيهِنَّ كَقَبْضٍ علَى الجمْرِ ",["لِلْعَامِلِ فِيهَا",1]," ",["أَجْرُ خَمْسِينَ",2]," قالوا يا رسولَ اللهِ أجْرُ خمسينَ منهم أَوْ خمسينَ مِنَّا قال خمسينَ مِنْكُمْ"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"رجاله رجال الصحيح غير سهل بن عامر البجلي وثقه ابن حبان","takhrij":"أخرجه البزار في ((البحر الزخار)) (1776)، واللفظ له، والطبراني في ((المعجم الكبير)) (10394)، بلفظ مقارب.","bab":"رقائق وزهد › فضل الصبر","dorar":"Q5Vfyr1I","merged":3,"otherRefs":["صحيح الجامع 2234 (صحيح)","السلسلة الصحيحة 494 (صحيح)"]},{"id":"س-05921","fp":"e95e975bbe12","stateId":532,"easy":"إذا عملت صالحاً في أيام الصبر ← فلك أجر خمسين يعملون مثلك","cause":"أيَّامَ الصَّبْرِ، صَبْرٌ فيهِنَّ كقَبْضٍ على الجَمْرِ، للعاملِ فيهِنَّ","result":"أجْرُ خمْسينَ يَعمَلُ مِثلَ عمَلِهِ","explicit":true,"otherNeedIds":[16],"ref":"المستدرك على الصحيحين 8125","srcLabel":"أبو داود","text":["عن أبِي أُمَيَّةَ الشَّعْبانيِّ قال: سَألتُ أبا ثَعْلبةَ عنْ هذه الآيةِ {يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ} [المائدة: 105]، فقالَ أبو ثَعْلبةَ: لقدْ سَألتَ عنها خَبيرًا؛ أنا سَألتُ عنها رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال: يا أبا ثَعْلبةَ، مُرُوا بالمعروفِ، وتَناهَوْا عنِ المنكَرِ، فإذا رأيْتَ شُحًّا مُطاعًا وهوًى مُتَّبعًا ودُنْيا مُؤثَرةً، ورَأيتَ أمرًا لا بُدَّ لكَ مِن طلَبِهِ؛ فعليكَ نفْسَكَ ودَعْهُم وعَوامَّهُم؛ فإنَّ وَراءَكُم ",["أيَّامَ الصَّبْرِ، صَبْرٌ فيهِنَّ كقَبْضٍ على الجَمْرِ، للعاملِ فيهِنَّ",1]," ",["أجْرُ خمْسينَ يَعمَلُ مِثلَ عمَلِهِ",2],"."],"grade":"صحيح","narrator":"أبو ثعلبة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (4341)، والترمذي (3058)، وابن ماجه (4014)، وابن حبان (801) واللفظ لهم.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"yekq5cJg","merged":2,"otherRefs":["الفتح الرباني 8/3784 (صحيح)"]},{"id":"س-03690","fp":"3869d8660dd6","stateId":532,"easy":"إذا تمسكت بالسنة عند فساد الأمة ← فلك أجر شهيد","cause":"المُتمسِّكُ بسُنَّتي ، عندَ فسادِ أمَّتي","result":"لهُ أجرُ شَهيدٍ","explicit":true,"ref":"الجامع الصغير 9152","srcLabel":"الطبراني","text":[["المُتمسِّكُ بسُنَّتي ، عندَ فسادِ أمَّتي",1]," ، ",["لهُ أجرُ شَهيدٍ",2],"."],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الأوسط)) (4776)، وأبو نعيم في ((الحلية)) (8/ 200) واللفظ لهما.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"zfAvZdep"},{"id":"ق-1450","fp":"4e2a0e050f83","stateId":533,"easy":"إحياء ليلة القدر ← خير من ألف شهر","cause":"إحياء ليلة القدر","result":"خير من ألف شهر","explicit":true,"star":true,"apply":{"k":"time","t":"في العشر الأواخر"},"similar":["س-02510"],"ref":"سورة القدر: 3","srcLabel":"القرآن الكريم","quran":{"s":97,"from":3,"to":3,"text":"لَيْلَةُ الْقَدْرِ خَيْرٌ مِنْ أَلْفِ شَهْرٍ (3)","hl":[[0,44,1]]}},{"id":"س-02510","fp":"ed3e1bad2aad","stateId":533,"easy":"إذا قمت ليلة القدر ← فهي خير من ألف شهر","cause":"فيه ليلَةٌ","result":"خَيْرٌ مِن أَلْفِ شَهرٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"في العشر الأواخر"},"repOf":"ق-1450","ref":"تخريج المسند لشعيب 7148","text":["لَمَّا حضَرَ رَمَضانُ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: قد جاءَكم رَمَضانُ، شَهْرٌ مُبارَكٌ، افتَرَضَ اللهُ عليكم صِيامَه، تُفْتَحُ فيه أَبْوابُ الجنةِ، وتُغلقُ فيه أبوابُ الجحيمِ، وتُغَلُّ فيه الشَّياطينُ، ",["فيه ليلَةٌ",1]," ",["خَيْرٌ مِن أَلْفِ شَهرٍ",2],"، مَن حُرِمَ خَيْرَها فقد حُرِم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (2106)، وأحمد (7148) واللفظ له","bab":"إيمان › أعمال الجن والشياطين","dorar":"IUbKzziZ","merged":2,"otherRefs":["صحيح ابن ماجه 1341 (صحيح)"]},{"id":"س-02063","fp":"8562019e5240","stateId":533,"easy":"إذا عملت في عشر ذي الحجة ← فلا أيام العمل فيها أفضل منها","cause":"العملُ فيهنَّ","result":"ما من أيَّامٍ العملُ فيهنَّ أفضلُ من هذِهِ العَشرِ","explicit":true,"star":true,"similar":["س-06885"],"otherNeedIds":[23],"ref":"تخريج المسند لشاكر 10/67","srcLabel":"الطبراني","text":["كنتُ عندَ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ : فذُكِرتِ الأعمالُ فقالَ : ",["ما من أيَّامٍ العملُ فيهنَّ أفضلُ من هذِهِ العَشرِ",2]," قالوا : يا رسولَ اللَّهِ الجِهادُ في سبيلِ اللَّهِ ؟ فأَكْبرَهُ فقالَ : ولا الجِهادُ إلَّا أن يخرُجَ رجلٌ بنفسِهِ ومالِهِ في سبيلِ اللَّهِ ثمَّ تَكونَ مُهْجةُ نفسِهِ فيهِ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطيالسي (2397)، والطحاوي في ((شرح مشكل الآثار)) (2972)، والطبراني (13/581) (14492) باختلاف يسير","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ZkXZIVYe","merged":4,"otherRefs":["مجمع الزوائد 20-4 (صحيح)","المحلى 7/19 (صحيح)","صحيح الترغيب 1149 (صحيح)"]},{"id":"س-06885","fp":"997bedf53467","stateId":533,"easy":"إذا عملت في عشر ذي الحجة ← فلا أيام أفضل عند الله منها","cause":"أيَّامِ عشرِ ذي الحجَّةِ","result":"ما من أيَّامٍ أفضلَ عندَ اللَّهِ","explicit":true,"repOf":"س-02063","otherNeedIds":[23,45],"ref":"مجمع الزوائد 3/256","text":[["ما من أيَّامٍ أفضلَ عندَ اللَّهِ",2]," من ",["أيَّامِ عشرِ ذي الحجَّةِ",1],"، قالَ: فقالَ رجلٌ: يا رسولَ اللَّهِ، هنَّ أفضلُ أم عدَّتهنَّ جهادٌ في سبيلِ اللَّهِ؟ قالَ: هنَّ أفضلُ من عدَّتهنَّ جهادٌ في سبيلِ اللَّهِ، إلَّا عفيرًا يعفِّرُ وجههُ في التُّراب. وما من يومٍ أفضلَ عندَ اللَّهِ من يومِ عرفةَ؛ ينزلُ اللَّهُ إلى السَّماءِ الدُّنيا فيُباهي بأهلِ الأرضِ أهلَ السَّماءِ، فيقولُ: انظروا إلى عبادي شُعثًا غُبرًا ضاحِينَ، جاؤوا من كلِّ فجٍّ عميقٍ ولم يروا رحمتي ولم يروا عذابي، فلم أرَ يومًا أكثرَ عتيقًا منَ النَّارِ من يومِ عرفة."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"فيه محمد بن مروان العقيلي وثقه ابن معين وابن حبان وفيه بعض كلام وبقية  رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (2090)، وابن حبان (3853)، وابن عدي في ((الكامل في الضعفاء)) (7/253) باختلاف يسير","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"4Q1teRb9","merged":4,"otherRefs":["إتحاف الخيرة المهرة 3/170 (صحيح)","إرواء الغليل 3/398 (حسن)","مجمع الزوائد 19-4 (صحيح)"]},{"id":"س-04520","fp":"c1b5beb0c373","stateId":533,"easy":"إذا عملت يوماً من أيام العشر ← فهو كقدر غزوة يُصام نهارها ويُحرس ليلها","cause":"أنَّ العملَ في اليومِ من أيَّامِ العَشرِ","result":"كقَدرِ غَزوةٍ في سبيلِ اللهِ يُصامُ نهارُها ويُحرسُ ليلُها","explicit":true,"ref":"الترغيب والترهيب 2/191","srcLabel":"البيهقي","text":[["أنَّ العملَ في اليومِ من أيَّامِ العَشرِ",1]," ",["كقَدرِ غَزوةٍ في سبيلِ اللهِ يُصامُ نهارُها ويُحرسُ ليلُها",2]," إلَّا أن يُختصَّ امرؤٌ بشهادةٍ"],"grade":"صحيح","narrator":"رجل من بني مخزوم","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (3477) بلفظه.","bab":"جهاد › فضل الشهيد","dorar":"UxvhRieA"},{"id":"س-02088","fp":"3d455a3cfced","stateId":533,"easy":"إذا عملت في أيام العشر ← فكل يوم بألف يوم","cause":"في أيامِ العشرِ: بكلِّ يومٍ","result":"ألفُ يومٍ","explicit":true,"ref":"المتجر الرابح 154","srcLabel":"المتجر الرابح","text":["عن أنسِ بنِ مالكٍ رضي الله عنه قال: كان يقالُ ",["في أيامِ العشرِ: بكلِّ يومٍ",1]," ",["ألفُ يومٍ",2]," ويومُ عرفةَ عشرةُ آلافِ يومٍ. قال: يعني في الفضلِ."],"grade":"حسن","muhaddith":"إسناده لا بأس به","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BSFR3nAB"},{"id":"س-02089","fp":"67bd2b0ba6ba","stateId":533,"easy":"إذا عملت يوم عرفة ← فهو بعشرة آلاف يوم","cause":"ويومُ عرفةَ","result":"عشرةُ آلافِ يومٍ","explicit":true,"apply":{"k":"time","t":"يوم عرفة"},"ref":"المتجر الرابح 154","srcLabel":"المتجر الرابح","text":["عن أنسِ بنِ مالكٍ رضي الله عنه قال: كان يقالُ في أيامِ العشرِ: بكلِّ يومٍ ألفُ يومٍ ",["ويومُ عرفةَ",1]," ",["عشرةُ آلافِ يومٍ",2],". قال: يعني في الفضلِ."],"grade":"حسن","muhaddith":"إسناده لا بأس به","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"BSFR3nAB"}]}