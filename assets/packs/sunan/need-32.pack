{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":32,"stateIds":[278,279,280,281,282],"items":[{"id":"ق-0109","fp":"cafab562132c","stateId":278,"easy":"أكل الربا ← القيام كالذي يتخبطه الشيطان من المس","cause":"أكل الربا","result":"القيام كالذي يتخبطه الشيطان من المس","explicit":true,"star":true,"otherNeedIds":[57],"ref":"سورة البقرة: 275","srcLabel":"القرآن الكريم","quran":{"s":2,"from":275,"to":275,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ذَلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَى فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ وَمَنْ عَادَ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (275)","hl":[[0,115,1]]}},{"id":"ق-0176","fp":"71b32b9c367c","stateId":278,"easy":"الذنوب السابقة ← استزلال الشيطان عند الشدة","cause":"الذنوب السابقة","result":"استزلال الشيطان عند الشدة","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"سورة آل عمران: 155","srcLabel":"القرآن الكريم","quran":{"s":3,"from":155,"to":155,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ (155)","hl":[[65,123,1]]}},{"id":"ق-0217","fp":"21d6c6e6fa3c","stateId":278,"easy":"الإنفاق رياءً وعدم الإيمان بالله واليوم الآخر ← مقارنة الشيطان","cause":"الإنفاق رياءً وعدم الإيمان بالله واليوم الآخر","result":"مقارنة الشيطان","explicit":true,"star":true,"ref":"سورة النساء: 38","srcLabel":"القرآن الكريم","quran":{"s":4,"from":38,"to":38,"text":"وَالَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُونَ بِاللَّهِ وَلَا بِالْيَوْمِ الْآخِرِ وَمَنْ يَكُنِ الشَّيْطَانُ لَهُ قَرِينًا فَسَاءَ قَرِينًا (38)","hl":[[0,150,1]]}},{"id":"ق-0396","fp":"80d05b018393","stateId":278,"easy":"عدم الإيمان ← ولاية الشياطين","cause":"عدم الإيمان","result":"ولاية الشياطين","explicit":true,"star":true,"ref":"سورة الأعراف: 27","srcLabel":"القرآن الكريم","quran":{"s":7,"from":27,"to":27,"text":"يَا بَنِي آدَمَ لَا يَفْتِنَنَّكُمُ الشَّيْطَانُ كَمَا أَخْرَجَ أَبَوَيْكُمْ مِنَ الْجَنَّةِ يَنْزِعُ عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوْآتِهِمَا إِنَّهُ يَرَاكُمْ هُوَ وَقَبِيلُهُ مِنْ حَيْثُ لَا تَرَوْنَهُمْ إِنَّا جَعَلْنَا الشَّيَاطِينَ أَوْلِيَاءَ لِلَّذِينَ لَا يُؤْمِنُونَ (27)","hl":[[216,285,1]]}},{"id":"ق-0443","fp":"2b021f23e3d6","stateId":278,"easy":"الانسلاخ من آيات الله والإخلاد إلى الأرض واتباع الهوى ← إتباع الشيطان والغواية وحرمان الرفعة","cause":"الانسلاخ من آيات الله والإخلاد إلى الأرض واتباع الهوى","result":"إتباع الشيطان والغواية وحرمان الرفعة","explicit":true,"star":true,"otherNeedIds":[19],"ref":"سورة الأعراف: 175–176","srcLabel":"القرآن الكريم","quran":{"s":7,"from":175,"to":176,"text":"وَاتْلُ عَلَيْهِمْ نَبَأَ الَّذِي آتَيْنَاهُ آيَاتِنَا فَانْسَلَخَ مِنْهَا فَأَتْبَعَهُ الشَّيْطَانُ فَكَانَ مِنَ الْغَاوِينَ (175) وَلَوْ شِئْنَا لَرَفَعْنَاهُ بِهَا وَلَكِنَّهُ أَخْلَدَ إِلَى الْأَرْضِ وَاتَّبَعَ هَوَاهُ فَمَثَلُهُ كَمَثَلِ الْكَلْبِ إِنْ تَحْمِلْ عَلَيْهِ يَلْهَثْ أَوْ تَتْرُكْهُ يَلْهَثْ ذَلِكَ مَثَلُ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا فَاقْصُصِ الْقَصَصَ لَعَلَّهُمْ يَتَفَكَّرُونَ (176)","hl":[[0,222,1]]}},{"id":"ق-0655","fp":"454a4e18ad69","stateId":278,"easy":"اتباع الشيطان (الغواية) ← سلطانه عليهم وجهنم موعدهم","cause":"اتباع الشيطان (الغواية)","result":"سلطانه عليهم وجهنم موعدهم","explicit":true,"otherNeedIds":[57],"ref":"سورة الحجر: 42–43","srcLabel":"القرآن الكريم","quran":{"s":15,"from":42,"to":43,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ إِلَّا مَنِ اتَّبَعَكَ مِنَ الْغَاوِينَ (42) وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ (43)","hl":[[48,137,1]]}},{"id":"ق-0674","fp":"f6735aa4ee21","stateId":278,"easy":"اتباع تزيين الشيطان ← ولاية الشيطان وعذاب أليم","cause":"اتباع تزيين الشيطان","result":"ولاية الشيطان وعذاب أليم","explicit":true,"otherNeedIds":[57],"ref":"سورة النحل: 63","srcLabel":"القرآن الكريم","quran":{"s":16,"from":63,"to":63,"text":"تَاللَّهِ لَقَدْ أَرْسَلْنَا إِلَى أُمَمٍ مِنْ قَبْلِكَ فَزَيَّنَ لَهُمُ الشَّيْطَانُ أَعْمَالَهُمْ فَهُوَ وَلِيُّهُمُ الْيَوْمَ وَلَهُمْ عَذَابٌ أَلِيمٌ (63)","hl":[[56,153,1]]}},{"id":"ق-0680","fp":"ff81328e6922","stateId":278,"easy":"تولّي الشيطان والشرك ← سلطان الشيطان عليهم","cause":"تولّي الشيطان والشرك","result":"سلطان الشيطان عليهم","explicit":true,"ref":"سورة النحل: 100","srcLabel":"القرآن الكريم","quran":{"s":16,"from":100,"to":100,"text":"إِنَّمَا سُلْطَانُهُ عَلَى الَّذِينَ يَتَوَلَّوْنَهُ وَالَّذِينَ هُمْ بِهِ مُشْرِكُونَ (100)","hl":[[0,86,1]]}},{"id":"ق-0705","fp":"ac7fb3d4da81","stateId":278,"easy":"التبذير ← أخوّة الشياطين","cause":"التبذير","result":"أخوّة الشياطين","explicit":true,"otherNeedIds":[26],"ref":"سورة الإسراء: 27","srcLabel":"القرآن الكريم","quran":{"s":17,"from":27,"to":27,"text":"إِنَّ الْمُبَذِّرِينَ كَانُوا إِخْوَانَ الشَّيَاطِينِ وَكَانَ الشَّيْطَانُ لِرَبِّهِ كَفُورًا (27)","hl":[[0,93,1]]}},{"id":"ق-0733","fp":"65986fa24c10","stateId":278,"easy":"اتخاذ إبليس وذريته أولياء ← بئس البدل","cause":"اتخاذ إبليس وذريته أولياء","result":"بئس البدل","explicit":true,"ref":"سورة الكهف: 50","srcLabel":"القرآن الكريم","quran":{"s":18,"from":50,"to":50,"text":"وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ كَانَ مِنَ الْجِنِّ فَفَسَقَ عَنْ أَمْرِ رَبِّهِ أَفَتَتَّخِذُونَهُ وَذُرِّيَّتَهُ أَوْلِيَاءَ مِنْ دُونِي وَهُمْ لَكُمْ عَدُوٌّ بِئْسَ لِلظَّالِمِينَ بَدَلًا (50)","hl":[[126,235,1]]}},{"id":"ق-0756","fp":"cb7378bcba4d","stateId":278,"easy":"الكفر ← تسليط الشياطين تؤزّهم أزّاً","cause":"الكفر","result":"تسليط الشياطين تؤزّهم أزّاً","explicit":true,"ref":"سورة مريم: 83","srcLabel":"القرآن الكريم","quran":{"s":19,"from":83,"to":83,"text":"أَلَمْ تَرَ أَنَّا أَرْسَلْنَا الشَّيَاطِينَ عَلَى الْكَافِرِينَ تَؤُزُّهُمْ أَزًّا (83)","hl":[[12,83,1]]}},{"id":"ق-0851","fp":"4b0c12bf5687","stateId":278,"easy":"اتباع خطوات الشيطان ← الوقوع في الفحشاء والمنكر","cause":"اتباع خطوات الشيطان","result":"الوقوع في الفحشاء والمنكر","explicit":true,"ref":"سورة النور: 21","srcLabel":"القرآن الكريم","quran":{"s":24,"from":21,"to":21,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ وَمَنْ يَتَّبِعْ خُطُوَاتِ الشَّيْطَانِ فَإِنَّهُ يَأْمُرُ بِالْفَحْشَاءِ وَالْمُنْكَرِ وَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ مَا زَكَى مِنْكُمْ مِنْ أَحَدٍ أَبَدًا وَلَكِنَّ اللَّهَ يُزَكِّي مَنْ يَشَاءُ وَاللَّهُ سَمِيعٌ عَلِيمٌ (21)","hl":[[70,157,1]]}},{"id":"ق-0896","fp":"bd57a8945761","stateId":278,"easy":"الإفك والإثم ← تنزّل الشياطين","cause":"الإفك والإثم","result":"تنزّل الشياطين","explicit":true,"ref":"سورة الشعراء: 221–222","srcLabel":"القرآن الكريم","quran":{"s":26,"from":221,"to":222,"text":"هَلْ أُنَبِّئُكُمْ عَلَى مَنْ تَنَزَّلُ الشَّيَاطِينُ (221) تَنَزَّلُ عَلَى كُلِّ أَفَّاكٍ أَثِيمٍ (222)","hl":[[0,98,1]]}},{"id":"ق-1039","fp":"bfc79407751b","stateId":278,"easy":"عبادة الشيطان وطاعته ← الضلال وصَلي جهنم","cause":"عبادة الشيطان وطاعته","result":"الضلال وصَلي جهنم","explicit":true,"otherNeedIds":[57],"ref":"سورة يس: 60–64","srcLabel":"القرآن الكريم","quran":{"s":36,"from":60,"to":64,"text":"أَلَمْ أَعْهَدْ إِلَيْكُمْ يَا بَنِي آدَمَ أَنْ لَا تَعْبُدُوا الشَّيْطَانَ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ (60) وَأَنِ اعْبُدُونِي هَذَا صِرَاطٌ مُسْتَقِيمٌ (61) وَلَقَدْ أَضَلَّ مِنْكُمْ جِبِلًّا كَثِيرًا أَفَلَمْ تَكُونُوا تَعْقِلُونَ (62) هَذِهِ جَهَنَّمُ الَّتِي كُنْتُمْ تُوعَدُونَ (63) اصْلَوْهَا الْيَوْمَ بِمَا كُنْتُمْ تَكْفُرُونَ (64)","hl":[[0,339,1]]}},{"id":"ق-1133","fp":"e7feee2f7bce","stateId":278,"easy":"الكفر والإعراض ← تقييض قرناء السوء المزيّنين","cause":"الكفر والإعراض","result":"تقييض قرناء السوء المزيّنين","explicit":true,"otherNeedIds":[19],"ref":"سورة فصلت: 25","srcLabel":"القرآن الكريم","quran":{"s":41,"from":25,"to":25,"text":"وَقَيَّضْنَا لَهُمْ قُرَنَاءَ فَزَيَّنُوا لَهُمْ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ الْقَوْلُ فِي أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِهِمْ مِنَ الْجِنِّ وَالْإِنْسِ إِنَّهُمْ كَانُوا خَاسِرِينَ (25)","hl":[[0,211,1]]}},{"id":"ق-1220","fp":"831bb9917f4d","stateId":278,"easy":"الارتداد بعد تبيّن الهدى واتباع ما أسخط الله وكراهة رضوانه ← تسويل الشيطان وضرب الملائكة عند الوفاة وإحباط الأعمال","cause":"الارتداد بعد تبيّن الهدى واتباع ما أسخط الله وكراهة رضوانه","result":"تسويل الشيطان وضرب الملائكة عند الوفاة وإحباط الأعمال","explicit":true,"otherNeedIds":[59,45],"ref":"سورة محمد: 25–28","srcLabel":"القرآن الكريم","quran":{"s":47,"from":25,"to":28,"text":"إِنَّ الَّذِينَ ارْتَدُّوا عَلَى أَدْبَارِهِمْ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْهُدَى الشَّيْطَانُ سَوَّلَ لَهُمْ وَأَمْلَى لَهُمْ (25) ذَلِكَ بِأَنَّهُمْ قَالُوا لِلَّذِينَ كَرِهُوا مَا نَزَّلَ اللَّهُ سَنُطِيعُكُمْ فِي بَعْضِ الْأَمْرِ وَاللَّهُ يَعْلَمُ إِسْرَارَهُمْ (26) فَكَيْفَ إِذَا تَوَفَّتْهُمُ الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ (27) ذَلِكَ بِأَنَّهُمُ اتَّبَعُوا مَا أَسْخَطَ اللَّهَ وَكَرِهُوا رِضْوَانَهُ فَأَحْبَطَ أَعْمَالَهُمْ (28)","hl":[[0,466,1]]}},{"id":"ق-1313","fp":"7e07f0cf1f31","stateId":278,"easy":"تولّي من غضب الله عليهم والحلف على الكذب والصد عن سبيل الله ← عذاب شديد واستحواذ الشيطان ونسيان ذكر الله والخسران","cause":"تولّي من غضب الله عليهم والحلف على الكذب والصد عن سبيل الله","result":"عذاب شديد واستحواذ الشيطان ونسيان ذكر الله والخسران","explicit":true,"otherNeedIds":[50,57],"ref":"سورة المجادلة: 14–19","srcLabel":"القرآن الكريم","quran":{"s":58,"from":14,"to":19,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ تَوَلَّوْا قَوْمًا غَضِبَ اللَّهُ عَلَيْهِمْ مَا هُمْ مِنْكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى الْكَذِبِ وَهُمْ يَعْلَمُونَ (14) أَعَدَّ اللَّهُ لَهُمْ عَذَابًا شَدِيدًا إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ (15) اتَّخَذُوا أَيْمَانَهُمْ جُنَّةً فَصَدُّوا عَنْ سَبِيلِ اللَّهِ فَلَهُمْ عَذَابٌ مُهِينٌ (16) لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا أُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (17) يَوْمَ يَبْعَثُهُمُ اللَّهُ جَمِيعًا فَيَحْلِفُونَ لَهُ كَمَا يَحْلِفُونَ لَكُمْ وَيَحْسَبُونَ أَنَّهُمْ عَلَى شَيْءٍ أَلَا إِنَّهُمْ هُمُ الْكَاذِبُونَ (18) اسْتَحْوَذَ عَلَيْهِمُ الشَّيْطَانُ فَأَنْسَاهُمْ ذِكْرَ اللَّهِ أُولَئِكَ حِزْبُ الشَّيْطَانِ أَلَا إِنَّ حِزْبَ الشَّيْطَانِ هُمُ الْخَاسِرُونَ (19)","hl":[[0,778,1]]}},{"id":"ق-1321","fp":"619258a3298e","stateId":278,"easy":"طاعة الشيطان في الكفر ← تبرّؤه من صاحبه والخلود في النار","cause":"طاعة الشيطان في الكفر","result":"تبرّؤه من صاحبه والخلود في النار","explicit":true,"otherNeedIds":[57],"ref":"سورة الحشر: 16–17","srcLabel":"القرآن الكريم","quran":{"s":59,"from":16,"to":17,"text":"كَمَثَلِ الشَّيْطَانِ إِذْ قَالَ لِلْإِنْسَانِ اكْفُرْ فَلَمَّا كَفَرَ قَالَ إِنِّي بَرِيءٌ مِنْكَ إِنِّي أَخَافُ اللَّهَ رَبَّ الْعَالَمِينَ (16) فَكَانَ عَاقِبَتَهُمَا أَنَّهُمَا فِي النَّارِ خَالِدَيْنِ فِيهَا وَذَلِكَ جَزَاءُ الظَّالِمِينَ (17)","hl":[[0,243,1]]}},{"id":"ق-1382","fp":"f2b8c9fdaf3b","stateId":278,"easy":"الاستعاذة بغير الله (بالجن) ← زيادة الرهق","cause":"الاستعاذة بغير الله (بالجن)","result":"زيادة الرهق","explicit":true,"otherNeedIds":[10],"ref":"سورة الجن: 6","srcLabel":"القرآن الكريم","quran":{"s":72,"from":6,"to":6,"text":"وَأَنَّهُ كَانَ رِجَالٌ مِنَ الْإِنْسِ يَعُوذُونَ بِرِجَالٍ مِنَ الْجِنِّ فَزَادُوهُمْ رَهَقًا (6)","hl":[[0,94,1]]}},{"id":"س-05524","fp":"71a97d726c7b","stateId":278,"easy":"إذا خرجت تسعى رياءً ومفاخرة ← فأنت في سبيل الشيطان","cause":"خَرَجَ يَسعى رياءً ومُفاخَرةً","result":"فهو في سَبيلِ الشَّيطانِ","explicit":true,"otherNeedIds":[45],"ref":"حسن الأسوة بما ثبت في النسوة 564","srcLabel":"الطبراني","text":["مَرَّ على النَّبيِّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فرَأى أصحابُ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم مِن جَلَدِه ونَشاطِه، فقالوا: يا رَسولَ اللهِ، لو كان هذا في سَبيلِ اللهِ! فقال رسولُ اللهِ: إن كان خَرَجَ يَسعى على ولدِه صِغارًا فهو في سَبيل اللهِ، وإن كان خَرَجَ يَسعى على أبَوينِ شَيخَينِ كَبيرَينِ فهو في سَبيلِ اللهِ، وإن كان خَرَجَ يَسعى على نَفسِه يُعِفُّها فهو في سَبيلِ اللهِ، وإن كان ",["خَرَجَ يَسعى رياءً ومُفاخَرةً",1]," ",["فهو في سَبيلِ الشَّيطانِ",2]],"grade":"صحيح","narrator":"كعب بن عجرة","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((الأوسط)) (6835)، وبحشل في ((تاريخ واسط)) (صـ162) واللفظ لهما.","bab":"رقائق وزهد › الرياء والسمعة","dorar":"yhlIFCs7"},{"id":"س-01659","fp":"918fb8036455","stateId":278,"easy":"إذا حرّمت على نفسك ما أحل الله ← فهو من خطرات الشيطان (أثر ابن مسعود)","cause":"إني حَرَّمْتُ الضرعَ","result":"هذا من خطَراتِ الشيطانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 4/193","srcLabel":"الطبراني","text":["أُتِيَ عبدُ اللهِ بِضْرِعٍ فأَخَذَ يَأْكُلُ منه فقال لِلْقَوْمِ ادْنُوا فَدَنَا القومُ وتَنَحَّى رجلٌ منهم فقال عبدُ اللهِ ما شأْنُكَ قال ",["إني حَرَّمْتُ الضرعَ",1]," قال ",["هذا من خطَراتِ الشيطانِ",2]," ادنُ وكلْ وكفِّرْ يمينَكَ ثم تَلَا  يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُحَرِّمُوا طَيِّبَاتِ مَا أَحَلَّ اللهُ لَكُمْ"],"grade":"صحيح","narrator":"مسروق بن الأجدع","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه سعيد بن منصور في ((السنن)) (4/1519)، والطبراني (9/206) (8908)","bab":"أطعمة › ما يحل من الأطعمة","dorar":"h0GJFQOT"},{"id":"س-02550","fp":"36caca7335ca","stateId":278,"easy":"إذا أحب الناس المعاصي ← لن ينفلتوا من الشيطان","cause":"لئِنْ كانوا يُحِبُّونها","result":"إنَّهم لنْ يَنفَلِتوا مِنِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 8131","srcLabel":"البيهقي","text":["لَمَّا بُعِثَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ أتَتْ إبليسَ جُنودُه، فقالوا: قدْ بُعِثَ نَبيٌّ، وخرَجَتْ أُمَّتُه، فقالَ إبليسُ: أيُحِبُّونَ الدُّنْيا؟ قالوا: نعَمْ، قالَ: ",["لئِنْ كانوا يُحِبُّونها",1]," ما أبالِي ألَّا يَعبُدوا الأوثانَ؛ ",["إنَّهم لنْ يَنفَلِتوا مِنِّي",2]," وأنا أغْدُو عَلَيْهم وأروحُ بثَلاثٍ: أخْذِ المالِ مِن غيْرِ حَقِّه، وإنفاقِهِ في غيْرِ حَقِّهِ، وإمساكِهِ عنْ حَقِّهِ، والشَّرُّ كُلُّه لهذا تَبَعٌ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي الدنيا في ((الزهد)) (10)، والبيهقي في ((دلائل النبوة)) ((شعب الإيمان)) (10502) واللفظ لهما.","bab":"إيمان › أعمال الجن والشياطين","dorar":"a2YAiTNJ"},{"id":"س-07328","fp":"9f65c8e25593","stateId":278,"easy":"إذا كنت صاحب مال ← يكيدك الشيطان بكسبه من حرام أو إنفاقه في باطل أو منعه حقه","cause":"أَخْذِه مِن غيرِ حِلِّه وإنفاقِه في غيرِ حقِّه وأُحَبِّبُه إليه فيمنَعُه مِن حقِّه","result":"لن يسلَمَ منِّي صاحبُ المالِ مِن إحدى ثلاثٍ","explicit":true,"otherNeedIds":[3],"ref":"مجمع الزوائد 10/248","srcLabel":"الطبراني","text":["قال الشَّيطانُ لعَنه اللهُ ",["لن يسلَمَ منِّي صاحبُ المالِ مِن إحدى ثلاثٍ",2]," أغدو عليه بهنَّ وأروحُ بهنَّ ",["أَخْذِه مِن غيرِ حِلِّه وإنفاقِه في غيرِ حقِّه وأُحَبِّبُه إليه فيمنَعُه مِن حقِّه",1]],"grade":"حسن","narrator":"عبدالرحمن بن عوف","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (1030)، والطبراني (1/136) (289)، وأبو نعيم في ((معرفة الصحابة)) (500) باختلاف يسير","bab":"فتن › فتنة المال","dorar":"i0D7aVPx"},{"id":"س-07726","fp":"e8c377f5eefd","stateId":278,"easy":"إذا أطعت الشيطان في معصية بعد معصية ← يقودك إلى الكفر (من قصة برصيصا)","cause":"أنَّ امرأةً زيَّنتْ له نفسَها فوَقَعَ عليها فحَمَلَتْ فجاءَهُ الشَّيطانُ، فقالَ: اقتُلْها؛ فإنَّهم إنْ ظَهروا عليكَ افتضَحتَ. فقَتلَها فدَفنَها","result":"فسَجَدَ له، فأَنزلَ اللهُ عزَّ وجلَّ: كَمَثَلِ الشَّيْطَانِ إِذْ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"المستدرك على الصحيحين 3847","srcLabel":"البيهقي","text":["عنْ عَليِّ بنِ أبي طالبٍ رَضيَ اللهُ عنه، قالَ: كان راهبٌ يَتعبَّدُ في صَومعةٍ، و",["أنَّ امرأةً زيَّنتْ له نفسَها فوَقَعَ عليها فحَمَلَتْ فجاءَهُ الشَّيطانُ، فقالَ: اقتُلْها؛ فإنَّهم إنْ ظَهروا عليكَ افتضَحتَ. فقَتلَها فدَفنَها",1],"، فجاؤوه فأَخذوه فذَهَبوا به، فبيْنَما هُم يَمشونَ إذ جاءَهُ الشَّيطانُ، فقالَ: أنا الَّذي زَيَّنتُ لكَ فاسجُدْ لي سجدةً أُنجيكَ، ",["فسَجَدَ له، فأَنزلَ اللهُ عزَّ وجلَّ: {كَمَثَلِ الشَّيْطَانِ إِذْ",2]," قَالَ لِلْإِنْسَانِ اكْفُرْ فَلَمَّا كَفَرَ قَالَ إِنِّي بَرِيءٌ مِنْكَ} [الحشر: 16] الآيةَ."],"grade":"صحيح","narrator":"حميد بن عبدالله السلولي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (5067)، وإسحاق بن راهويه كما في ((المطالب العالية)) (3748) بلفظه.","bab":"قرآن › أسباب النزول","dorar":"1VZ23yQs"},{"id":"س-02526","fp":"e1c7315cc36c","stateId":279,"easy":"إذا غفلت ← يجثم الشيطان على قلبك فيوسوس","cause":"وإذا غَفَلَ","result":"جَثَمَ على قَلْبِه فوَسْوَسَ","explicit":true,"star":true,"ref":"الأحاديث المختارة 10 / 175","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ «في قَوْلِه: {الْوَسْوَاسِ الْخَنَّاسِ} هو الشَّيْطانُ، يُوَلِّهُ المَوْلودَ، والوَسْواسُ على قَلْبِه فهو يَصرِفُه حيثُ شاءَ، فإذا ذَكَرَ اللهَ خَنَسَ، ",["وإذا غَفَلَ",1]," ",["جَثَمَ على قَلْبِه فوَسْوَسَ",2],"»."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › أعمال الجن والشياطين","dorar":"iaN3A635","merged":3,"otherRefs":["هداية الرواة 2221 (صحيح)","الأحاديث المختارة 10 / 367 (صحيح)"]},{"id":"س-00801","fp":"d7e6555f6b3e","stateId":279,"easy":"إذا لم تذكر الله عند دخول بيتك ← يقول الشيطان: أدركتم المبيت","cause":"فلم يَذْكُرِ اسْمَ اللهِ عندَ دُخولِه","result":"قال: أدْرَكْتُم المَبيتَ","explicit":true,"star":true,"similar":["س-00802"],"ref":"تخريج المسند لشعيب 14729","srcLabel":"مسلم","text":["عن أبي الزُّبَيرِ، أنَّه سَألَ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: إذا دَخَلَ الرَّجُلُ بَيتَه يُسَلِّمُ، والمؤمِنُ يَأكُلُ في مِعًى واحِدٍ؟ قال: نَعَمْ. قال: وسَألْتُ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: إذا دَخَلَ الرَّجُلُ بَيتَه فذَكَرَ اسْمَ اللهِ حينَ يَدخُلُ، وحينَ يَطْعَمُ، قال الشَّيطانُ: لا مَبيتَ لكم، ولا عَشاءَ هاهُنا، وإنْ دَخَلَ ",["فلم يَذْكُرِ اسْمَ اللهِ عندَ دُخولِه",1],"، ",["قال: أدْرَكْتُم المَبيتَ",2],"، وإنْ لم يَذْكُرِ اسْمَ اللهِ عندَ مَطْعَمِه، قال: أدْرَكْتُمُ المَبيتَ والعَشاءَ؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2018، 2061) مفرقاً، وأبو داود (3765)، والنسائي في ((السنن الكبرى)) (6757)، وابن ماجه (3887)، وأحمد (14729) واللفظ له","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aQlb0Lyt","merged":3,"otherRefs":["صحيح مسلم 2018 (صحيح)","صحيح الأدب المفرد 834 (صحيح)"]},{"id":"س-00802","fp":"90945f9f8425","stateId":279,"easy":"إذا لم تذكر الله عند طعامك ← يقول الشيطان: أدركتم المبيت والعشاء","cause":"وإنْ لم يَذْكُرِ اسْمَ اللهِ عندَ مَطْعَمِه","result":"أدْرَكْتُمُ المَبيتَ والعَشاءَ","explicit":true,"repOf":"س-00801","otherNeedIds":[3],"ref":"تخريج المسند لشعيب 14729","text":["عن أبي الزُّبَيرِ، أنَّه سَألَ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: إذا دَخَلَ الرَّجُلُ بَيتَه يُسَلِّمُ، والمؤمِنُ يَأكُلُ في مِعًى واحِدٍ؟ قال: نَعَمْ. قال: وسَألْتُ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: إذا دَخَلَ الرَّجُلُ بَيتَه فذَكَرَ اسْمَ اللهِ حينَ يَدخُلُ، وحينَ يَطْعَمُ، قال الشَّيطانُ: لا مَبيتَ لكم، ولا عَشاءَ هاهُنا، وإنْ دَخَلَ فلم يَذْكُرِ اسْمَ اللهِ عندَ دُخولِه، قال: أدْرَكْتُم المَبيتَ، ",["وإنْ لم يَذْكُرِ اسْمَ اللهِ عندَ مَطْعَمِه",1],"، قال: ",["أدْرَكْتُمُ المَبيتَ والعَشاءَ",2],"؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2018، 2061) مفرقاً، وأبو داود (3765)، والنسائي في ((السنن الكبرى)) (6757)، وابن ماجه (3887)، وأحمد (14729) واللفظ له","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aQlb0Lyt","merged":3,"otherRefs":["صحيح مسلم 2018 (صحيح)","صحيح الأدب المفرد 834 (صحيح)"]},{"id":"س-02542","fp":"04fa9167d8bd","stateId":279,"easy":"إذا نمت حتى أصبحت ولم تصلِّ ← بال الشيطان في أذنك","cause":"نام الليلةَ حتى أصبَحَ لم يُصَلِّ","result":"ذاك رجلٌ بالَ الشيطانُ في أُذُنِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"تخريج مشكل الآثار 4021","srcLabel":"متفق عليه","text":["ذكَرتُ عِندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ رجلًا، فقلتُ: إنَّ فلانًا ",["نام الليلةَ حتى أصبَحَ لم يُصَلِّ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["ذاك رجلٌ بالَ الشيطانُ في أُذُنِه",2]," أو في أذُنَيْهِ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3270)، ومسلم (774) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"8a9Ih7bp","merged":9,"otherRefs":["تخريج المسند لشاكر 5/190 (صحيح)","تخريج صحيح ابن حبان 2562 (صحيح)","تخريج مشكل الآثار 4020 (صحيح)","صحيح البخاري 1144 (صحيح)","مجمع الزوائد 2/265 (صحيح)","صحيح النسائي 1608 (صحيح)","صحيح مسلم 774 (صحيح)","تخريج المسند لشعيب 9516 (صحيح)"]},{"id":"س-01063","fp":"9365e9d4b735","stateId":279,"easy":"إذا لم تذكروا اسم الله على طعامكم ← يستحله الشيطان","cause":"إذا لمْ يذكُروا اسمَ اللهِ عليه","result":"إنَّ الشَّيطانَ يستحِلُّ طعامَ القومِ","explicit":true,"similar":["س-01766","س-02543"],"ref":"تخريج مشكل الآثار 1077","srcLabel":"مسلم","text":["بيْنَما نحنُ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إذْ أُتِيَ بجَفْنةٍ، فكفَّ عنها رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وكُنَّا لا نضَعُ أيديَنا حتى يضَعَ يدَهُ، فجاء أعرابيٌّ كأنَّهُ يُطرَدُ حتى يَهوِيَ إلى الجَفْنةِ، فأكَل منها، فأخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بيدِهِ فأجلَسهُ، ثمَّ جاءتْ جاريةٌ فأهْوَتْ بيدِها تأكُلُ، فأخَذ بيدِها فأجلَسها، ثمَّ قال: ",["إنَّ الشَّيطانَ يستحِلُّ طعامَ القومِ",2]," ",["إذا لمْ يذكُروا اسمَ اللهِ عليه",1],"، وإنَّه لمَّا رآكم كفَفْتُمْ جاء بالأعرابيِّ لِيَستحِلَّ به، ثمَّ جاء بالجاريةِ لِيَستحِلَّ بها، فواللهِ الذي لا إلهَ غيْرُهُ، إنَّ يدَهُ في يدي مع أيديهما."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"رجاله رجال الصحيح، إلا أن معمرا أخطأ في إسناده","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1077) واللفظ له، ومسلم (2017) وأبو داود (3766) بنحوه","bab":"أدعية وأذكار › فضل الذكر","dorar":"rDb2ojkZ"},{"id":"ق-1168","fp":"1c17774f820d","stateId":279,"easy":"العَشو عن ذكر الرحمن ← تقييض شيطان قرين يصدّه عن السبيل ويحسب أنه مهتد","cause":"العَشو عن ذكر الرحمن","result":"تقييض شيطان قرين يصدّه عن السبيل ويحسب أنه مهتد","explicit":true,"otherNeedIds":[19],"ref":"سورة الزخرف: 36–37","srcLabel":"القرآن الكريم","quran":{"s":43,"from":36,"to":37,"text":"وَمَنْ يَعْشُ عَنْ ذِكْرِ الرَّحْمَنِ نُقَيِّضْ لَهُ شَيْطَانًا فَهُوَ لَهُ قَرِينٌ (36) وَإِنَّهُمْ لَيَصُدُّونَهُمْ عَنِ السَّبِيلِ وَيَحْسَبُونَ أَنَّهُمْ مُهْتَدُونَ (37)","hl":[[0,169,1]]}},{"id":"س-01766","fp":"ddf8433fb78a","stateId":279,"easy":"إذا لم يُذكر اسم الله على الطعام ← يستحله الشيطان","cause":"أن لا يُذكَرَ اسمُ اللهِ عليه","result":"إنَّ الشَّيطانَ يَستَحِلُّ الطَّعامَ","explicit":true,"repOf":"س-01063","ref":"صحيح مسلم 2017","text":["كُنَّا إذا حَضَرنا مع النَّبيِّ صلَّى اللهُ عليه وسلَّم طَعامًا لم نَضَعْ أيديَنا حتَّى يَبدَأَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم فيَضَعَ يَدَه، وإنَّا حَضَرنا معهُ مَرَّةً طَعامًا، فجاءَت جاريةٌ كَأنَّها تُدفَعُ، فذَهَبَت لتَضَعَ يَدَها في الطَّعامِ، فأخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم بيَدِها، ثُمَّ جاءَ أعرابيٌّ كَأنَّما يُدفَعُ فأخَذَ بيَدِه، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["إنَّ الشَّيطانَ يَستَحِلُّ الطَّعامَ",2]," ",["أن لا يُذكَرَ اسمُ اللهِ عليه",1],"، وإنَّه جاءَ بهذه الجاريةِ ليَستَحِلَّ بها فأخَذتُ بيَدِها، فجاءَ بهذا الأعرابيِّ ليَستَحِلَّ به، فأخَذتُ بيَدِه، والذي نَفسي بيَدِه، إنَّ يَدَه في يَدي مع يَدِها. وفي روايةٍ: كَأنَّما يُطرَدُ، وفي الجاريةِ: كَأنَّما تُطرَدُ، وقدَّمَ مَجيءَ الأعرابيِّ في حَديثِه قَبلَ مَجيءِ الجاريةِ. وزادَ في آخِرِ الحَديثِ: ثُمَّ ذَكَرَ اسمَ اللهِ وأكَلَ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (3766)، وأحمد (23249)، والحاكم (7088) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"ncPchnYf","merged":4,"otherRefs":["المستدرك على الصحيحين 7284 (صحيح)","تخريج مشكل الآثار 1078 (صحيح)","صحيح الجامع 1653 (صحيح)"]},{"id":"س-00887","fp":"fe703adeefbf","stateId":279,"easy":"إذا أصبحت ولم تقم من الليل ولم تصلِّ الصبح ← يبقى الشيطان عليك","cause":"فإن أصبحَ ولم يقمْ شيئًا من الليلِ ولم يصلِّ الصبحَ","result":"أصبح وهو عليه","explicit":true,"ref":"مجمع الزوائد 2/265","srcLabel":"أحمد","text":["عن أبي هريرةََ قال إذا رقد أحدُكم عُقِد على رأسِه بجَريرٍ فإن قام فذكر اللهَ عزَّ وجلَّ أُطلِقت واحدةٌ وإن مضَى فتوضأ أُطلِقت الثانيةُ فإن مضَى فصلَّى أُطلِقَت الثالثةُ ",["فإن أصبحَ ولم يقمْ شيئًا من الليلِ ولم يصلِّ الصبحَ",1]," ",["أصبح وهو عليه",2]," يعني الحريرَ"],"grade":"صحيح","narrator":"[الحسن البصري]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (10457) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"x3kVdVfe"},{"id":"س-02506","fp":"ef1922cc7826","stateId":279,"easy":"إذا ركبت الدابة فلم تذكر اسم الله ← يردفك الشيطان","cause":"إذا ركِبَ الرَّجلُ الدَّابَّةُ فلم يذكُرِ اسمَ اللهِ","result":"ردِفه الشَّيطانُ","explicit":true,"ref":"مجمع الزوائد 10/134","srcLabel":"الطبراني","text":["عَنِ ابنِ مسعودٍ قال ",["إذا ركِبَ الرَّجلُ الدَّابَّةُ فلم يذكُرِ اسمَ اللهِ",1]," ",["ردِفه الشَّيطانُ",2]," فقال له مغن فإن لم يُحْسِنْ قال له عي"],"grade":"صحيح","narrator":"[عبدالله بن سخبرة الأزدي أبو معمر]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (9/ 156) (8781)، والبيهقي في ((الشعب)) (4747) ومعمر بن راشد في ((الجامع)) (19481) جميعا باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"dZSQEldR"},{"id":"س-00706","fp":"039d5aa9038d","stateId":279,"easy":"إذا خلوت في سفرك بالشعر واللهو ← يكون رديفك شيطان","cause":"يخلو بشعرِه و نحوه","result":"إلا كان رَدفَه شيطانٌ","explicit":true,"ref":"صحيح الجامع 5706","srcLabel":"الطبراني","text":["ما من راكبٍ يخلو في مسيرِه باللهِ و ذِكرِه ، إلا كان رَدْفَه ملَكٌ ، و لا ",["يخلو بشعرِه و نحوه",1]," ، ",["إلا كان رَدفَه شيطانٌ",2]],"grade":"حسن","narrator":"عقبة بن عامر","muhaddith":"حسن","takhrij":"أخرجه الطبراني (17/324) (895) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"iohSczX5"},{"id":"س-00932","fp":"537f48248c73","stateId":279,"easy":"إذا نسيت الله ← يلتقم الشيطان قلبك","cause":"و إذا نسيَ اللهَ","result":"الْتَقَمَ قلبَهُ","explicit":true,"ref":"الجامع الصغير 4955","srcLabel":"الطبراني","text":["الشيطانُ يلتقمُ قلبَ ابنِ آدمَ،  فإذا ذكر اللهَ خَنَسَ عنده،  ",["و إذا نسيَ اللهَ",1]," ",["الْتَقَمَ قلبَهُ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الدعاء)) (1862)، وأبو نعيم في ((حلية الأولياء)) (6/268)، والبيهقي في ((شعب الإيمان)) (536) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"qHZMA59L"},{"id":"س-07510","fp":"12ed227fdf4d","stateId":279,"easy":"إذا لم تذكر اسم الله على الطعام ← فهو رزق الشيطان","cause":"فيما لم يُذكَرِ اسْمي عليه","result":"ففيما رِزْقي","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الأحاديث المختارة 10 / 361","srcLabel":"متفق عليه","text":["«قالَ إبْليسُ: يا رَبِّ، كلُّ خَلْقِك بَيَّنْتَ رِزْقَه، ",["ففيما رِزْقي",2],"؟ قالَ: ",["فيما لم يُذكَرِ اسْمي عليه",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"UdvNQokN"},{"id":"س-02543","fp":"5a50340a9290","stateId":279,"easy":"إذا لم تذكر اسم الله على الطعام ← يستحله الشيطان","cause":"ألَّا يُذكَرَ اسمُ اللهِ عزَّ وجلَّ","result":"لِيَستحِلَّ به طعامَنا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-01063","ref":"تخريج مشكل الآثار 1079","text":["كُنَّا إذا دُعينا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى طعامٍ كفَفْنا أيديَنا حتى يضَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يدَهُ، فدُعينا إلى طعامٍ، فكفَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يدَهُ، فكفَفْنا أيديَنا، فجاء أعرابيٌّ كأنَّه يُطْرَدُ، فأَهْوى بيدِهِ، فأخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يدَهُ فأجلَسهُ، ثمَّ جاءتْ جاريةٌ كأنَّها تُطْرَدُ حتى أَهْوَتْ بيدِها، فأخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ بيدِها فأجلَسها، ثمَّ قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: لمَّا أعيَيْناهُ ",["ألَّا يُذكَرَ اسمُ اللهِ عزَّ وجلَّ",1],"، جاء بهذا الأعرابيِّ كأنَّه يعني شيطانًا، ",["لِيَستحِلَّ به طعامَنا",2],"، فأخَذْتُ بيدِهِ فأجلَسْتُهُ، ثمَّ جاء بهذه الجاريةِ لِيَستحِلَّ بها طعامَنا، فأخَذْتُ بيدِها فأجلَسْتُها، والذي نفْسي بيدِهِ إنَّ يدَهُ لَفي يدي مع أيديهما، ثمَّ سمَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأكَل."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (1079) واللفظ له، ومسلم (2017)، وأبو داود (3766) باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"Ev1FByWR"},{"id":"س-02508","fp":"29b6608d082d","stateId":279,"easy":"إذا أكلت ولم تسمّ الله ← يأكل معك الشيطان","cause":"ثمَّ قعدَ من أَكلَ ولم يسمِّ اللَّهَ","result":"فأَكلَ معَه الشَّيطانُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[3],"ref":"هداية الرواة 4/152","srcLabel":"الترمذي","text":["كنَّا عندَ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقُرِّبَ إليهِ طعامٌ فلم أرَ طعامًا كانَ أعظمَ برَكةً منهُ أوَّلَ ما أَكلنا ولا أقلَّ برَكةً في آخرِه قلنا يا رسولَ اللَّهِ كيفَ هذا قالَ إنَّا ذَكرنا اسمَ اللَّهِ حينَ أَكلنا ",["ثمَّ قعدَ من أَكلَ ولم يسمِّ اللَّهَ",1]," ",["فأَكلَ معَه الشَّيطانُ",2]],"grade":"حسن","narrator":"أبو أيوب الأنصاري","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه أحمد (23522)، والترمذي في ((الشمائل)) (189)، والبغوي في ((شرح السنة)) (2824) واللفظ لهم.","bab":"إيمان › أعمال الجن والشياطين","dorar":"BmCawps5"},{"id":"س-08391","fp":"fd562e15e6e4","stateId":280,"easy":"إذا خلوت بامرأة ← فالشيطان ثالثكما","cause":"ولا يَخلوَنَّ أحدُكم بامرأةٍ","result":"فإنَّ الشَّيطانَ ثالثُهما","explicit":true,"star":true,"similar":["س-08396"],"otherNeedIds":[18],"ref":"تخريج مشكل الآثار 3708","srcLabel":"البخاري","text":["عن ابن عمر أنَّ عُمَرَ بنَ الخطَّابِ خَطَبَ النَّاسَ بالجابِيةِ، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطيبًا مَقامي هذا فيكم، فقال: استَوصوا بأصحابي خيرًا، ثُمَّ الذين يَلونَهم، ثُمَّ يَفشُو الكَذِبُ، حتى إنَّ الرَّجُلَ ليَبدَأُ بالشَّهادةِ قبلَ أنْ يُسأَلَها، وباليَمينِ قبلَ أنْ يُسأَلَها، فمَن أرادَ منكم بُحبوحةَ الجنَّةِ؛ فليَلزَمِ الجَماعةَ؛ فإنَّ الشَّيطانَ مع الواحدِ، وهو مِن الاثنَينِ أبعدُ، ",["ولا يَخلوَنَّ أحدُكم بامرأةٍ",1],"؛ ",["فإنَّ الشَّيطانَ ثالثُهما",2],"، ومَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه؛ فهو مؤمنٌ، هكذا حَدَّثَنا محمَّدُ بنُ عليٍّ هذا الحديثَ، فقال فيه: بُحبوحةُ الجنَّةِ، قال: وقال عبدُ اللهِ، وقال غيرُه -كأنَّه يَعني غير محمَّدِ بنِ سُوقةَ-: بَحبَحةُ الجنَّةِ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرح البخاري","takhrij":"أخرجه أحمد (114)، وابن حبان (7254)، والحاكم (387) مطولاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"DzdB7trU","merged":6,"otherRefs":["تخريج المسند لشعيب 15696 (صحيح)","الأحكام الوسطى 2/ 374 (صحيح)","تخريج مشكل الآثار 3719 (صحيح)","المستدرك على الصحيحين 395 (صحيح)","الأحاديث المختارة 155 (صحيح)"]},{"id":"س-08390","fp":"15e8bbdfc430","stateId":280,"easy":"إذا انفردت ← فالشيطان مع الواحد وهو من الاثنين أبعد","cause":"فإنَّ الشَّيطانَ مع الواحدِ","result":"وهو مِن الاثنَينِ أبعدُ","explicit":true,"star":true,"similar":["س-08377"],"ref":"تخريج مشكل الآثار 3708","srcLabel":"البخاري","text":["عن ابن عمر أنَّ عُمَرَ بنَ الخطَّابِ خَطَبَ النَّاسَ بالجابِيةِ، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ خَطيبًا مَقامي هذا فيكم، فقال: استَوصوا بأصحابي خيرًا، ثُمَّ الذين يَلونَهم، ثُمَّ يَفشُو الكَذِبُ، حتى إنَّ الرَّجُلَ ليَبدَأُ بالشَّهادةِ قبلَ أنْ يُسأَلَها، وباليَمينِ قبلَ أنْ يُسأَلَها، فمَن أرادَ منكم بُحبوحةَ الجنَّةِ؛ فليَلزَمِ الجَماعةَ؛ ",["فإنَّ الشَّيطانَ مع الواحدِ",1],"، ",["وهو مِن الاثنَينِ أبعدُ",2],"، ولا يَخلوَنَّ أحدُكم بامرأةٍ؛ فإنَّ الشَّيطانَ ثالثُهما، ومَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه؛ فهو مؤمنٌ، هكذا حَدَّثَنا محمَّدُ بنُ عليٍّ هذا الحديثَ، فقال فيه: بُحبوحةُ الجنَّةِ، قال: وقال عبدُ اللهِ، وقال غيرُه -كأنَّه يَعني غير محمَّدِ بنِ سُوقةَ-: بَحبَحةُ الجنَّةِ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح على شرح البخاري","takhrij":"أخرجه أحمد (114)، وابن حبان (7254)، والحاكم (387) مطولاً باختلاف يسير","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"DzdB7trU","merged":5,"otherRefs":["تخريج المسند لشعيب 15696 (صحيح)","الأحكام الوسطى 2/ 374 (صحيح)","المستدرك على الصحيحين 395 (صحيح)","الأحاديث المختارة 155 (صحيح)"]},{"id":"س-05146","fp":"b3c842ab8e21","stateId":280,"easy":"إذا سرت وحدك بالليل ← فلو علمت ما في الوحدة ما سرت","cause":"يَسِرِ الرَّاكبُ بلَيلٍ وَحْدَهُ","result":"لوْ يَعلَمُ النَّاسُ ما في الوَحْدَةِ ما أَعلمُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2528","srcLabel":"البخاري","text":[["لوْ يَعلَمُ النَّاسُ ما في الوَحْدَةِ ما أَعلمُ",2],"؛ لمْ ",["يَسِرِ الرَّاكبُ بلَيلٍ وَحْدَهُ",1]," أبدًا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البخاري (2998)، والترمذي (1673)، وابن ماجه (3768) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"Wz9QmGX0","merged":2,"otherRefs":["تخريج المسند لشعيب 5581 (صحيح)"]},{"id":"س-07421","fp":"a616a5a15651","stateId":280,"easy":"إذا فارقت الجماعة ← يركض معك الشيطان","cause":"من فارق الجماعةَ","result":"وإنَّ الشَّيطانَ مع من فارق الجماعةَ يركُضُ","explicit":true,"ref":"الأحكام الشرعية الصغرى 493","srcLabel":"مسلم","text":["رأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم وهو على المنبرِ يخطبُ النَّاسَ فقال : إنَّها ستكونُ بعدي هنَّاتٌ وهنَّاتٌ ، فمن رأيتموه فارق الجماعةَ أو يريدُ تفريقَ أمرِ أمَّةِ محمَّدٍ كائنًا من كان ، فاقتُلوه فإنَّ يدَ اللهِ على الجماعةِ ، ",["وإنَّ الشَّيطانَ مع من فارق الجماعةَ يركُضُ",2]],"grade":"صحيح","narrator":"عرفجة [بن شراحيل أو شريح أو شريك أو ضريح أو أسعد]","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه النسائي (4020) وابن حبان (4577) باختلاف يسير وأخرجه مسلم  (1852) وأبو داود (4762) مختصرا بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"YQK2rhuB","merged":2,"otherRefs":["مجمع الزوائد 5/224 (حسن)"]},{"id":"س-06852","fp":"5260a75e27d5","stateId":280,"easy":"إذا خرجت المرأة ← يستشرفها الشيطان","cause":"فإذا خرجَت","result":"استشرَفَها الشَّيطانُ","explicit":true,"ref":"المحلى 4/201","srcLabel":"الترمذي","text":["إنَّما المرأةُ عَورةٌ ",["فإذا خرجَت",1]," ",["استشرَفَها الشَّيطانُ",2]," ، وأقرَبُ ما تَكونُ مِن وجهِ ربِّها وَهيَ في قَعرِ بيتِها صلاةُ المرأةِ في مَخدعِها أفضلُ من صلاتِها في بيتِها ، وصلاتُها في بيتِها أفضلُ من صلاتِها في حُجرتِها"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه الترمذي (1173)، وابن حبان (5598) مختصراً، وابن خزيمة (1685، 1690) مفرقاً","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"bCwOJksE","merged":8,"otherRefs":["السلسلة الصحيحة 2688 (صحيح)","فتح الباري لابن رجب 5/318 (حسن)","مجمع الزوائد 2/38 (حسن)","مجمع الزوائد 4/317 (صحيح)","عارضة الأحوذي 3/92 (صحيح)","مجمع الزوائد 2/37 (صحيح)"]},{"id":"س-08377","fp":"5f20fb64d460","stateId":280,"easy":"إذا انفردت ← فالشيطان مع الفذ وهو من الاثنين أبعد","cause":"فإنَّ الشَّيطانَ مع الفَذِّ","result":"وهو مِن الاثنَينِ أبعدُ","explicit":true,"repOf":"س-08390","ref":"تخريج مشكل الآثار 3719","text":["[عن] جابر بن سمرة قال: خَطَبَنا عُمَرُ رَضيَ اللهُ عنه، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثُمَّ ذَكَرَ مِثلَه.\n[مِثلَ حديثِ:  خَطَبَنا عُمَرُ بنُ الخطَّابِ رَضيَ اللهُ عنه بالجابيةِ، فقال: قام فينا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مَقامي فيكم اليوم، فقال: أحسِنوا إلى أصحابي، ثُمَّ الذين يَلونَهم، ثُمَّ الذين يَلونَهم، ثُمَّ يَفشُو الكَذِبُ حتى يَشهَدَ الرَّجُلُ على الشَّهادةِ لا يُسأَلُها، وحتى يَحلِفَ الرَّجُلُ على اليَمينِ لا يُستحلَفُ، فمَن سَرَّه بَحبَحةَ الجنَّةِ؛ فليَلزَمِ الجَماعةَ؛ ",["فإنَّ الشَّيطانَ مع الفَذِّ",1],"، ",["وهو مِن الاثنَينِ أبعدُ",2],"، لا يَخلوَنَّ رَجُلٌ بامرأةٍ؛ فإنَّ الشَّيطانَ ثالثُهما، فمَن سَرَّتْه حَسَنتُه، وساءتْه سيِّئتُه؛ فهو مؤمنٌ]."],"grade":"صحيح","narrator":"جابر بن سمرة","muhaddith":"إسناده صحيح على شرح الشيخين","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"ZNtiEfFV","merged":2,"otherRefs":["تخريج شرح السنة 9 / 27 (صحيح)"]},{"id":"س-04926","fp":"1812fc435eae","stateId":280,"easy":"إذا خلوت بامرأة ليس معها محرم ← فثالثكما الشيطان","cause":"يَخْلوَنَّ بامْرَأةٍ ليس معها ذو مَحْرمٍ منها","result":"فإنَّ ثالِثَهُما الشَّيطانُ","explicit":true,"otherNeedIds":[18],"ref":"تخريج المسند لشعيب 14651","srcLabel":"الترمذي","text":["مَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ، فلا يَدْخُلِ الحمَّامَ إلَّا بمِئْزَرٍ، ومَن كان يؤُمِنُ باللهِ واليَومِ الآخِرِ، فلا يُدخِلْ حَليلَتَه الحمَّامَ، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ، فلا يَقعُدْ على مائِدةٍ يُشرَبُ عليها الخَمرُ، ومَن كان يُؤمِنُ باللهِ واليَومِ الآخِرِ، فلا ",["يَخْلوَنَّ بامْرَأةٍ ليس معها ذو مَحْرمٍ منها",1],"؛ ",["فإنَّ ثالِثَهُما الشَّيطانُ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"حسن لغيره، وبعضه صحيح","takhrij":"أخرجه الترمذي (2801)، والنسائي (401) مختصراً، وأحمد (14651) واللفظ له","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"FOgyaL30"},{"id":"س-06541","fp":"5c8fb2655558","stateId":280,"easy":"إذا كنتم ثلاثة لا تُقام فيكم الصلاة ← يستحوذ عليكم الشيطان","cause":"ما مِن ثلاثةِ نفرٍ في قريةٍ، ولا بدوٍ، فلا تقامُ فيهمُ الصَّلاةُ","result":"إلَّا استحوذَ عليهمُ الشَّيطانُ","explicit":true,"ref":"صحيح ابن خزيمة 3/ 19","srcLabel":"أبو داود","text":["عن معدانَ بنِ أبي طلحةَ اليَعمُريِّ قالَ: قالَ أبو الدَّرداءِ: أينَ مسكنُكَ؟ قلتُ قريةٌ دونَ حِمصَ قالَ أبو الدَّرداءِ: سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: ",["ما مِن ثلاثةِ نفرٍ في قريةٍ، ولا بدوٍ، فلا تقامُ فيهمُ الصَّلاةُ",1]," ",["إلَّا استحوذَ عليهمُ الشَّيطانُ",2],"، فعليكَ بالجَماعةِ، فإنَّما يأكلُ الذِّئبُ القاصيةَ، [وفي روايةٍ]: قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ... وقالَ: إنَّ الذِّئبَ يأخذُ القاصيَةَ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أبو داود (547)، والنسائي (847)، وأحمد (27514) باختلاف يسير.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"YTIiOIcl"},{"id":"س-08396","fp":"596efa4f0431","stateId":280,"easy":"إذا خلوت بامرأة ← فالشيطان ثالثكم","cause":"ولا يخلُوَنَّ رجُلٌ بامرأةٍ","result":"فإنَّ الشيطانَ ثالثُهم","explicit":true,"repOf":"س-08391","otherNeedIds":[18],"ref":"تخريج شرح السنة 9 / 27","text":["أنَّ عُمَرَ بنَ الخطَّابِ قام بالجابيَةِ خطيبًا، فقال: إنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قام فينا كقيامي فيكم، فقال: أكرِموا أصحابي، ثم الذين يلونهم، ثم الذين يلونهم، ثم يَظهَرُ الكَذِبُ، حتى إنَّ الرَّجُلَ لَيَحلِفُ ولا يُستحلَفُ، ويَشهَدُ ولا يُستشهَدُ، ألَا فمَن سَرَّهُ بَحبَحةُ الجنَّةِ، فَلْيَلزَمِ الجماعةَ؛ فإنَّ الشيطانَ مع الفَذِّ، وهو مِن الاثنَيْنِ أبعَدُ، ",["ولا يخلُوَنَّ رجُلٌ بامرأةٍ",1],"؛ ",["فإنَّ الشيطانَ ثالثُهم",2],"، ومَن سرَّتْهُ حسَنتُهُ وساءته سيِّئتُهُ، فهو مؤمِنٌ."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"TpBzJBhA"},{"id":"س-05843","fp":"cc3e12ad544c","stateId":280,"easy":"إذا تفرقتم في المنازل ← فهو من الشيطان","cause":"تفرُّقَكُم في هذِهِ الشِّعابِ والأوديةِ","result":"إنَّما ذلِكُم منَ الشَّيطانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الصحيح المسند 1211","srcLabel":"أبو داود","text":["كانَ النَّاسُ إذا نزَلوا منزلًا . قالَ عمرو : كانَ النَّاسُ إذا نزلَ رسولُ اللَّهِ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - منزلًا تفرَّقوا في الشِّعابِ والأودِيةِ ، فقالَ رسولُ اللَّهِ - صلَّى اللَّهُ علَيهِ وعلَى آلِهِ وسلَّمَ - : إنَّ ",["تفرُّقَكُم في هذِهِ الشِّعابِ والأوديةِ",1]," ، ",["إنَّما ذلِكُم منَ الشَّيطانِ",2]," . فلم ينزِلوا بعدَ ذلِكَ منزلًا إلَّا انضَمَّ بعضُهُم إلى بَعضٍ ، حتَّى يقالَ لو بُسِطَ علَيهم ثَوبٌ لعمَّهُم ."],"grade":"صحيح","narrator":"أبو ثعلبة الخشني","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2628) واللفظ له، وابن حبان (2690)، والحاكم (2540)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"UoY7X2FB","merged":3,"otherRefs":["صحيح الجامع 2352 (صحيح)","تخريج المسند لشعيب 17736 (صحيح)"]},{"id":"س-06712","fp":"b411dc849751","stateId":280,"easy":"إذا كنتم خمسة بيوت لا يُؤذّن فيكم ولا تُقام الصلاة ← يستحوذ عليكم الشيطان","cause":"ما مِن خمسَةِ أهلِ أبْياتٍ لا يُؤذَّنُ فيهم بالصَّلاةِ، وتُقامُ فيهمُ الصَّلواتُ","result":"إلا استحْوَذَ عليهمُ الشيطانُ","explicit":true,"ref":"تخريج المسند لشعيب 27513","srcLabel":"أبو داود","text":["كانَ رجلٌ بالشَّامِ يُقالُ له: مَعْدانُ، كانَ أبو الدَّرداءِ يُقرِئُه القرآنَ، ففقَدَهُ أبو الدَّرداءِ، فلَقِيَه يومًا وهو بدابِقَ، فقالَ لهُ أبو الدَّرداءِ: يا مَعدانُ، ما فعَلَ القرآنُ الذي كان معَكَ؟ كيفَ أنتَ والقرآنُ اليومَ؟ قال: قد عَلَّمَ اللهُ منه فأحْسَنَ، قال: يا معدانُ، أفي مدينةٍ تَسكُنُ اليومَ أوْ في قَريَةٍ؟ قال: لا، بلْ في قَريَةٍ قريبَةٍ من المدينةِ، قال: مَهْلًا، ويْحَكَ يا معدانُ، فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما مِن خمسَةِ أهلِ أبْياتٍ لا يُؤذَّنُ فيهم بالصَّلاةِ، وتُقامُ فيهمُ الصَّلواتُ،",1]," ",["إلا استحْوَذَ عليهمُ الشيطانُ",2],"، وإنَّ الذِّئبَ يأخُذُ الشَّاذَّةَ، فعلَيْكَ بالمدائِنِ، ويْحَكَ يا معْدانُ."],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"حسن","takhrij":"أخرجه أبو داود (547)، والنسائي (847) مختصراً، وأحمد (27513) واللفظ له","bab":"صلاة الجماعة والإمامة › فضل صلاة الجماعة","dorar":"ipFXIeYs"},{"id":"س-00140","fp":"93dd37441887","stateId":280,"easy":"إذا سافرت وحدك ← فالواحد شيطان والاثنان شيطانان والثلاثة ركب","cause":"الواحدُ","result":"شيطان , والاثنانِ شيطانانِ ، والثلاثةُ رَكْبٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"similar":["س-00640"],"ref":"إتحاف الخيرة المهرة 3/144","srcLabel":"أبو داود","text":["جاء رجلٌ فسلَّم على النبيِّ صلَّى اللهُ عليه وسلَّم خارجًا مِن مكةَ فسأَله النبيُّ صلَّى اللهُ عليه وسلَّم : أصحِبتَ مِن أحدٍ ؟ قال : لا ، قال النبيُّ صلَّى اللهُ عليه وسلَّم : ",["الواحدُ",1]," ",["شيطان , والاثنانِ شيطانانِ ، والثلاثةُ رَكْبٌ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح، وله شاهد","takhrij":"أخرجه أبو داود (2607)، والترمذي (1674)، وأحمد (6748) مختصراً باختلاف يسير","bab":"آداب السلام › إفشاء السلام","dorar":"yDmuiBuB"},{"id":"س-02520","fp":"14edbc4fd835","stateId":280,"easy":"إذا ركبت وحدك ← فالراكب شيطان","cause":"الرَّاكِبُ","result":"شَيْطانٌ، والرَّاكِبانِ شَيْطانانِ، والثَّلاثةُ رَكْبٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"الأحكام الوسطى 3/ 26","srcLabel":"أبو داود","text":[["الرَّاكِبُ",1]," ",["شَيْطانٌ، والرَّاكِبانِ شَيْطانانِ، والثَّلاثةُ رَكْبٌ",2],"."],"grade":"صحيح","narrator":"جد عمرو بن شعيب","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أبو داود (2607)، والترمذي (1674) وأحمد (6748) واللفظ لهم","bab":"إيمان › أعمال الجن والشياطين","dorar":"jBysdSLL"},{"id":"س-00640","fp":"bcf16c9ebfd8","stateId":280,"easy":"إذا سافرت وحدك ← فالواحد شيطان","cause":"أنَّ الواحدَ","result":"شَيطانٌ، والاثنَينِ شَيْطانانِ، والثلاثةَ رَكبٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-00140","ref":"تخريج زاد المعاد 2/410","text":[["أنَّ الواحدَ",1]," ",["شَيطانٌ، والاثنَينِ شَيْطانانِ، والثلاثةَ رَكبٌ",2],"."],"grade":"حسن","narrator":"[جد عمرو بن شعيب]","muhaddith":"إسناده حسن","bab":"آداب عامة › ضرب الأمثال","dorar":"QOgR1X0p"},{"id":"س-04079","fp":"10786be77fed","stateId":281,"easy":"إذا أكلت أو شربت بشمالك ← فالشيطان يأكل ويشرب بشماله","cause":"لا يَأكُلَنَّ أحَدٌ مِنكُم بشِمالِه، ولا يَشرَبَنَّ بها","result":"فإنَّ الشَّيطانَ يَأكُلُ بشِمالِه، ويَشرَبُ بها","explicit":true,"star":true,"similar":["س-04091"],"ref":"صحيح مسلم 2020","srcLabel":"متفق عليه","text":[["لا يَأكُلَنَّ أحَدٌ مِنكُم بشِمالِه، ولا يَشرَبَنَّ بها",1],"؛ ",["فإنَّ الشَّيطانَ يَأكُلُ بشِمالِه، ويَشرَبُ بها",2],". قال: وكانَ نافِعٌ يَزيدُ فيها: ولا يَأخُذُ بها، ولا يُعطي بها. وفي رِوايةِ أبي الطَّاهِرِ: لا يَأكُلَنَّ أحَدُكُم."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جن › صفة إبليس وجنوده","dorar":"ZajUxMW1","merged":6,"otherRefs":["تخريج صحيح ابن حبان 5229 (صحيح)","صحيح مسلم 2019 (صحيح)","صحيح الأدب المفرد 906 (صحيح)","تخريج المسند لشعيب 5847 (صحيح)","عارضة الأحوذي 4/236 (صحيح)"]},{"id":"س-03626","fp":"257e17453b96","stateId":281,"easy":"إذا مشيت في نعل واحدة ← فالشيطان يمشي بالنعل الواحدة","cause":"المَشيِ في النَّعلِ الواحدةِ","result":"إنَّ الشَّيطانَ يَمْشي بالنَّعلِ الواحدةِ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 1358","srcLabel":"متفق عليه","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ نَهى عنِ ",["المَشيِ في النَّعلِ الواحدةِ",1],"، وقال: ",["إنَّ الشَّيطانَ يَمْشي بالنَّعلِ الواحدةِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في  ((شرح مشكل الآثار)) (1358) واللفظ له، والبخاري (5856)، ومسلم (2097) كلاهما بنحوه وزيادة فيه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"B5d9seZy","merged":2,"otherRefs":["السلسلة الصحيحة 348 (صحيح)"]},{"id":"س-04081","fp":"ee1e65842b90","stateId":281,"easy":"إذا قلت عند التثاؤب «آه آه» ← يضحك الشيطان من جوفك","cause":"وإذا قال: آهْ آهْ","result":"فإنَّ الشَّيطانَ يضحَكُ مِن جَوْفِه","explicit":true,"star":true,"ref":"عارضة الأحوذي 5/382","srcLabel":"متفق عليه","text":["العُطاسُ مِن اللهِ، والتَّثاؤُبُ مِن الشَّيطانِ، فإذا تثاءَبَ أحدُكم فلْيضَعْ يَدَهُ على فِيهِ، ",["وإذا قال: (آهْ آهْ",1],") ",["فإنَّ الشَّيطانَ يضحَكُ مِن جَوْفِه",2],"، وإنَّ اللهَ يحِبُّ العُطاسَ ويكْرَهُ التَّثاؤُبَ، فإذا قال الرَّجلُ: (آهْ آهْ) إذا تثاءَبَ، فإنَّ الشَّيطانَ يضحَكُ مِن جَوْفِه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2746) واللفظ له، وأخرجه البخاري (6223) بلفظ مقارب، ومسلم (2994) باختلاف يسير مختصراً","bab":"جن › صفة إبليس وجنوده","dorar":"idSw1nPQ","merged":2,"otherRefs":["تحفة المحتاج 1/370 (صحيح)"]},{"id":"س-06443","fp":"764bf141c2db","stateId":281,"easy":"إذا التزمت الانصراف عن يمينك فقط ← جعلت للشيطان نصيباً من صلاتك","cause":"يَرى أنَّ حَقًّا عليه أن لا يَنصَرِفَ إلَّا عن يَمينِه","result":"لا يَجعَلْ أحَدُكُم للشَّيطانِ شيئًا مِن صَلاتِه","explicit":true,"star":true,"ref":"صحيح البخاري 852","srcLabel":"مسلم","text":["قال عبدُ اللهِ: ",["لا يَجعَلْ أحَدُكُم للشَّيطانِ شيئًا مِن صَلاتِه",2]," ",["يَرى أنَّ حَقًّا عليه أن لا يَنصَرِفَ إلَّا عن يَمينِه",1],"، لقد رَأيتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم كَثيرًا يَنصَرِفُ عن يَسارِه."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (707) باختلاف يسير","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"fXGFX7JN"},{"id":"س-04819","fp":"022c9c6e663e","stateId":281,"easy":"إذا نحت على الميت ← أدخلت الشيطان بيتاً أخرجه الله منه","cause":"لأبكيَنَّه بُكاءً يُتَحَدَّثُ عنه، فكُنتُ قد تَهَيَّأتُ للبُكاءِ عليه، إذ أقَبَلَتِ امرَأةٌ مِنَ الصَّعيدِ تُريدُ أن تُسعِدَني","result":"تُدخِلي الشَّيطانَ بَيتًا أخرَجَه اللهُ منه؟! مَرَّتَينِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"ref":"صحيح مسلم 922","srcLabel":"متفق عليه","text":["لَمَّا ماتَ أبو سَلَمةَ قُلتُ: غَريبٌ، وفي أرضِ غُربةٍ، ",["لأبكيَنَّه بُكاءً يُتَحَدَّثُ عنه، فكُنتُ قد تَهَيَّأتُ للبُكاءِ عليه، إذ أقَبَلَتِ امرَأةٌ مِنَ الصَّعيدِ تُريدُ أن تُسعِدَني",1],"، فاستَقبَلَها رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وقال: أتُريدينَ أن ",["تُدخِلي الشَّيطانَ بَيتًا أخرَجَه اللهُ منه؟! مَرَّتَينِ",2],"، فكَفَفتُ عَنِ البُكاءِ، فلَم أبكِ."],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"jCReDowy","merged":2,"otherRefs":["تخريج صحيح ابن حبان 3144 (صحيح)"]},{"id":"س-00459","fp":"701015fcd9ea","stateId":281,"easy":"إذا أكلت وشربت وأخذت وأعطيت بيمينك ← تخالف الشيطان (فهو يفعل بشماله)","cause":"ليأكُلْ أحدُكُم بيمينِهِ، وليشرَب بيمينِهِ، وليأخذ بيمينِهِ، وليُعطِ بيمينِهِ","result":"فإنَّ الشَّيطانَ يأكلُ بشمالِهِ، ويَشربُ بشمالِهِ، ويُعطي بشِمالِهِ، ويأخذُ بشِمالِهِ","explicit":true,"ref":"مصباح الزجاجة 4/9","srcLabel":"ابن ماجه","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ",["ليأكُلْ أحدُكُم بيمينِهِ، وليشرَب بيمينِهِ، وليأخذ بيمينِهِ، وليُعطِ بيمينِهِ",1],"، ",["فإنَّ الشَّيطانَ يأكلُ بشمالِهِ، ويَشربُ بشمالِهِ، ويُعطي بشِمالِهِ، ويأخذُ بشِمالِهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح رجاله ثقات","takhrij":"أخرجه ابن ماجه (3266) واللفظ له، وأحمد (8306) مختصراً باختلاف يسير","bab":"آداب عامة › التيمن والبدء بجهة اليمين","dorar":"mwV7xZDU","merged":3,"otherRefs":["صحيح الجامع 384 (صحيح)","تخريج المسند لشعيب 6333 (صحيح)"]},{"id":"س-04795","fp":"7506417e2fd9","stateId":281,"easy":"إذا علّقت الجرس ← فهو مزمار الشيطان","cause":"الجرسِ","result":"مزمارُ الشَّيطانِ","explicit":true,"ref":"صحيح أبي داود 2556","srcLabel":"أبو داود","text":["أنَّ النَّبيَّ صلى الله عليه وسلم قالَ في ",["الجرسِ",1],": ",["مزمارُ الشَّيطانِ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2556)، وأحمد (8783)، وابن خزيمة (2554)، وابن حبان (1647) واللفظ لهم.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"LdssnzRG","merged":3,"otherRefs":["رياض الصالحين 540 (صحيح)","صحيح مسلم 2114 (صحيح)"]},{"id":"س-03587","fp":"c03b7c2821b1","stateId":281,"easy":"إذا جلست بين الشمس والظل ← فهو مجلس الشيطان","cause":"يُجلَسَ بيْن الضِّحِّ والظِّلِّ","result":"مَجلِسُ الشَّيطانِ","explicit":true,"ref":"تخريج المسند لشعيب 15421","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ نَهى أنْ ",["يُجلَسَ بيْن الضِّحِّ والظِّلِّ",1],"، وقال: ",["مَجلِسُ الشَّيطانِ",2],"."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح","takhrij":"أخرجه أحمد (15421)، وابن أبي عاصم في ((الآحاد والمثاني)) (2905)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"8IcP3vLD","merged":2,"otherRefs":["السلسلة الصحيحة 838 (صحيح)"]},{"id":"س-06442","fp":"cb87f250abd8","stateId":281,"easy":"إذا حركت الحصى في صلاتك ← فهو من الشيطان","cause":"تحرِّكِ الحصَى وأنتَ في الصَّلاةِ","result":"فإنَّ ذلِكَ منَ الشَّيطانِ","explicit":true,"ref":"صحيح النسائي 1159","srcLabel":"النسائي","text":["أنَّهُ رأى رجلًا يحرِّكُ الحصَى بيدِهِ وَهوَ في الصَّلاةِ ، فلمَّا انصرفَ ، قالَ لَهُ عبدُ اللَّهِ لا ",["تحرِّكِ الحصَى وأنتَ في الصَّلاةِ",1]," ",["فإنَّ ذلِكَ منَ الشَّيطانِ",2]," ، ولَكِنِ اصنَع كما كانَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يصنعُ ، قالَ: وَكَيفَ كانَ يصنَعُ ؟ قالَ: فوضعَ يدَهُ اليمنى على فخذِهِ اليمنى ، وأشارَ بإصبعِهِ الَّتي تلي الإبهامَ في القبلةِ ، ورمى ببصرِهِ إليها أو نحوِها ، ثمَّ قالَ: هَكَذا رأيتُ رسولَ اللَّهِ يصنعُ"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"حسن صحيح","takhrij":"أخرجه النسائي (1160) واللفظ له، وابن خزيمة (719)، وابن حبان (1947) باختلاف يسير","bab":"صلاة › صفة صلاة النبي صلى الله عليه وسلم","dorar":"NsYMRRyg","merged":2,"otherRefs":["تخريج المسند لشاكر 7/218 (صحيح)"]},{"id":"س-02554","fp":"d0444851266f","stateId":281,"easy":"إذا شبكت أصابعك وأنت تنتظر الصلاة ← فالتشبيك من الشيطان","cause":"فلا يشبِّكنَّ","result":"فإنَّ التَّشبيكَ منَ الشَّيطانِ","explicit":true,"ref":"الترغيب والترهيب 1/163","srcLabel":"أحمد","text":["بينا أَنا معَ أبي سَعيدٍ وَهوَ معَ رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - إذا دخَلنا المسجِدَ فإذا رجلٌ جالسٌ في وسطِ المسجِدِ مُحتبيًا مشبِّكًا أصابعَهُ بَعضَها في بعضٍ ، فأشارَ إليهِ رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - فلم يفطِنِ الرَّجلُ لإشارةِ رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - فالتَفتَ إلى أبي سَعيدٍ فقالَ : إذا كانَ أحدُكُم في المسجِدِ ",["فلا يشبِّكنَّ",1]," ، ",["فإنَّ التَّشبيكَ منَ الشَّيطانِ",2]," ، وإنَّ أحدَكُم لا يَزالُ في صلاةٍ ما كانَ في المسجِدِ حتَّى يَخرجَ منهُ"],"grade":"حسن","narrator":"مولى لأبي سعيد الخدري","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (11385)، وابن أبي شيبة (4859)، وابن سعد في ((الطبقات الكبرى)) (5/ 356) باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"ZCsHlVSv","merged":3,"otherRefs":["شرح ابن ماجه لمغلطاي 3/595 (حسن)","الأحكام الكبير 2/118 (حسن)"]},{"id":"س-02540","fp":"cfedd524a269","stateId":281,"easy":"إذا شربت قائماً ← يشرب معك الشيطان","cause":"يَشرَبُ قائمًا","result":"قد شَرِبَ معك شَرٌّ منَ الهِرِّ: الشَّيطانُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج مشكل الآثار 2102","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ أنَّه رأى رَجُلًا ",["يَشرَبُ قائمًا",1],"؛ فقال له: قِئْ، قال: لِمَ؟ قال: أتُحِبُّ أنْ يَشرَبَ معكَ الهِرُّ؟، فقال: لا، فقال: ",["قد شَرِبَ معك شَرٌّ منَ الهِرِّ: الشَّيطانُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (2102) واللفظ له، وأحمد (8003)، والدارمي (2174) كلاهما بنحوه.","bab":"إيمان › أعمال الجن والشياطين","dorar":"vJ4a3yvR","merged":2,"otherRefs":["السلسلة الصحيحة 1/337 (صحيح)"]},{"id":"س-00181","fp":"8e9800f236c8","stateId":281,"easy":"إذا تثاءبت أو عطست في الصلاة ← فهو من الشيطان","cause":"التَّثاؤبُ والعُطاسُ في الصَّلاةِ","result":"منَ الشَّيطانِ","explicit":true,"ref":"مجمع الزوائد 2/89","srcLabel":"الطبراني","text":["عن عبدِ اللَّهِ بنِ مسعودٍ قالَ ",["التَّثاؤبُ والعُطاسُ في الصَّلاةِ",1]," ",["منَ الشَّيطانِ",2]],"grade":"حسن","narrator":"[حصين بن جندب]","muhaddith":"رجاله موثقون","takhrij":"أخرجه الطبراني ((9/ 288)) (9453) واللفظ له، وابن أبي شيبة (7985) بنحوه.","bab":"آداب العطاس › العطاس","dorar":"FPY285x7"},{"id":"س-04091","fp":"3bf1cdc1c855","stateId":281,"easy":"إذا أكلت بشمالك ← يأكل معك الشيطان","cause":"من أَكَلَ بشمالِهِ","result":"أَكَلَ معَهُ الشَّيطانُ","explicit":true,"repOf":"س-04079","ref":"فتح الباري لابن حجر 9/433","text":[["من أَكَلَ بشمالِهِ ",1],["أَكَلَ معَهُ الشَّيطانُ",2]],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (24479)، والطبراني في ((المعجم الأوسط)) (292) مطولاً","bab":"جن › صفة إبليس وجنوده","dorar":"ePFdUAw9"},{"id":"س-05956","fp":"819342a48d26","stateId":281,"easy":"إذا رفعت صوتك عند العطاس والتثاؤب ← فالشيطان يحب ذلك","cause":"فلا يَرفَعَنَّ بهما الصَّوتَ","result":"فإنَّ الشَّيْطانَ يُحِبُّ أنْ يَرفَعَ بهما الصَّوتَ","explicit":true,"ref":"تخريج المراسيل لأبي داود 524","srcLabel":"أبو داود","text":["إذا عَطَسَ أحدُكم أو تجشَّأ، ",["فلا يَرفَعَنَّ بهما الصَّوتَ",1],"؛ ",["فإنَّ الشَّيْطانَ يُحِبُّ أنْ يَرفَعَ بهما الصَّوتَ",2],"."],"grade":"حسن","narrator":"يزيد بن مرثد","muhaddith":"[فيه] الوضين بن عطاء: سيئ الحفظ وباقي رجاله ثقات","takhrij":"أخرجه أبو داود في ((المراسيل)) (524)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"9HuywfAA"},{"id":"س-06201","fp":"152028add670","stateId":281,"easy":"إذا تزينت بالحمرة الفاقعة ← فالشيطان يحبها","cause":"الحُمْرةَ","result":"إن الشيطانَ يُحبُ","explicit":true,"ref":"نيل الأوطار 2/91","srcLabel":"الطبراني","text":[["إن الشيطانَ يُحبُ",2]," ",["الحُمْرةَ",1],"، فإيَّاكم والحمرةَ! وكلَّ ثوبٍ ذي شهرةٍ."],"grade":"حسن","narrator":"رافع بن يزيد الثقفي","muhaddith":"غير صالح للاحتجاج","takhrij":"أخرجه الطبراني في ((الأوسط)) (7708)، وابن عدي في ((الكامل)) (4/ 346)، وأبو نعيم في ((معرفة الصحابة)) (2670) واللفظ لهم.","bab":"زينة اللباس › ما نهي عنه من اللباس","dorar":"d4o1BrVb"},{"id":"س-00207","fp":"9e8f5b8bed51","stateId":281,"easy":"إذا اتخذت فراشاً زائداً عن الحاجة ← فهو للشيطان","cause":"فراشٌ للرَّجلِ ، وفِراشٌ للمرأةِ ، وفراشٌ للضَّيفِ","result":"والرَّابعُ للشَّيطانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح أبي داود 4142","srcLabel":"مسلم","text":[["فراشٌ للرَّجلِ ، وفِراشٌ للمرأةِ ، وفراشٌ للضَّيفِ",1]," ، ",["والرَّابعُ للشَّيطانِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4142) واللفظ له، وأخرجه مسلم (2084) باختلاف يسير","bab":"آداب المجلس › إكرام الضيف","dorar":"T0Ye5E8Y"},{"id":"س-00211","fp":"a186bf0fbf94","stateId":281,"easy":"إذا اتخذت فراشاً رابعاً ← فهو للشيطان","cause":"فِراشٌ للرجُلِ ، وفِراشٌ لامْرأتِه ، وفِراشٌ للضيْفِ","result":"وفراشٌ للشيطانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 4198","srcLabel":"مسلم","text":[["فِراشٌ للرجُلِ ، وفِراشٌ لامْرأتِه ، وفِراشٌ للضيْفِ",1]," ، ",["وفراشٌ للشيطانِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2084) باختلاف يسير","bab":"آداب المجلس › إكرام الضيف","dorar":"YbtcIqk7"},{"id":"س-01654","fp":"1b07b26c6f01","stateId":281,"easy":"إذا أكلت البلح بالتمر ← يغيظ ذلك الشيطان (على رواية)","cause":"كُلوا البلحَ بالتَّمرِ","result":"فإنَّ الشَّيطانَ إذا رآهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المدخل إلى معرفة كتاب الإكليل 62","srcLabel":"النسائي","text":[["كُلوا البلحَ بالتَّمرِ",1]," ",["فإنَّ الشَّيطانَ إذا رآهُ :",2]," قالَ عاشَ ابنُ آدمَ حتَّى أَكَلَ الجديدِ بالخَلِقِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"[صحيح]","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (6724)، وابن ماجه (3330) باختلاف يسير، وأورده أبو أحمد الحاكم في ((المدخل)) (ص40) واللفظ له","bab":"أطعمة › ما يحل من الأطعمة","dorar":"OLCz2G9W"},{"id":"س-00420","fp":"7329e18aa8f1","stateId":282,"easy":"إذا شققت الكلام وتكلفته ← فهو من الشيطان","cause":"تَشقيقُ الكلامِ","result":"مِنَ الشَّيطانِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 5687","srcLabel":"البخاري","text":["قَدِمَ رجُلانِ مِنَ المَشرِقِ خَطِيبانِ على عهدِ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقامَا فتَكَلَّمَا، ثمَّ قَعَدَا، وقام ثابتُ بنُ قَيسٍ خطيبُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فتَكلَّمَ، ثمَّ قَعَدَ، فعَجِبَ النَّاسُ مِن كلامِهم، فقام النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فقال: يا أيُّها النَّاسُ، قُولُوا بقَولِكُم؛ فإنَّما ",["تَشقيقُ الكلامِ",1]," ",["مِنَ الشَّيطانِ",2],". قال النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: إنَّ مِنَ البَيانِ سِحْرًا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (5767)، وأبو داود (5007)، والترمذي (2028)، وأحمد (5687) واللفظ له","bab":"آداب عامة › الأخلاق المذمومة","dorar":"5j3EHFYt","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5718 (صحيح)"]},{"id":"س-05048","fp":"00dcfdc4236e","stateId":282,"easy":"إذا قلت «لو أني فعلت كذا» ← فـ«لو» تفتح عمل الشيطان","cause":"لو أَنِّي فَعَلْتُ كانَ كَذَا وَكَذَا","result":"فإنَّ (لو) تَفْتَحُ عَمَلَ الشَّيْطَانِ","explicit":true,"star":true,"ref":"مختصر المقاصد 824","srcLabel":"مسلم","text":["لو تفتحُ عملَ الشَّيطانِ [يعني حديث: الْمُؤْمِنُ القَوِيُّ خَيْرٌ وَأَحَبُّ إلى اللهِ مِنَ المُؤْمِنِ الضَّعِيفِ، وفي كُلٍّ خَيْرٌ. احْرِصْ علَى ما يَنْفَعُكَ، وَاسْتَعِنْ باللَّهِ وَلَا تَعْجِزْ، وإنْ أَصَابَكَ شَيءٌ، فلا تَقُلْ: ",["لو أَنِّي فَعَلْتُ كانَ كَذَا وَكَذَا",1],"، وَلَكِنْ قُلْ: قَدَرُ اللهِ وَما شَاءَ فَعَلَ؛ ",["فإنَّ (لو) تَفْتَحُ عَمَلَ الشَّيْطَانِ",2],".]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2664) مطولاً","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"V6LVEaum","merged":2,"otherRefs":["تفسير القرآن العظيم 7/459 (صحيح)"]},{"id":"س-00968","fp":"2f60330f599f","stateId":282,"easy":"إذا قلت «تعس الشيطان» ← يتعاظم حتى يصير مثل الجبل","cause":"تَعِسَ الشَّيطانُ","result":"فإنَّه يَتعاظَمُ إذا قُلتَ ذلك حتى يَصيرَ مِثلَ الجَبَلِ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 23092","srcLabel":"أبو داود","text":["عن أبي تَميمةَ الهُجَيميِّ، عن رِدْفِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أو مَن حَدَّثَه عن رِدْفِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أنَّه كان رِدْفَه فعَثَرَتْ به دابَّتُه، فقال: ",["تَعِسَ الشَّيطانُ",1],"، فقال: لا تَفعَلْ؛ ",["فإنَّه يَتعاظَمُ إذا قُلتَ ذلك حتى يَصيرَ مِثلَ الجَبَلِ",2],"، ويقولُ: بقُوَّتي صَرَعتُه، وإذا قُلتُ: باسمِ اللهِ، تَصاغَرَ حتى يكونَ مِثلَ الذُّبابِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4982)، وأحمد (23092)","bab":"أدعية وأذكار › فضل الذكر","dorar":"ydUqQjxY","merged":6,"otherRefs":["الأحكام الوسطى 4/ 323 (صحيح)","صحيح الجامع 7401 (صحيح)","الأحاديث المختارة 1413 (صحيح)","الترغيب والترهيب 4/115 (صحيح)","تخريج مشكل الآثار 369 (حسن)"]},{"id":"س-04595","fp":"b10aafbf475a","stateId":282,"easy":"إذا رأيت مذنباً يحب الله ورسوله فلا تلعنه ← دعوه، فإنه يحب الله ورسوله","cause":"دعوه","result":"فإنَّه يحبُّ اللهَ ورسولَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[40],"ref":"حلية الأولياء 3/264","srcLabel":"البخاري","text":["أنَّ رجلًا كان يُلقَّبُ حِمارًا ، وكان يهدي لرسولِ اللهِ صلَّى اللهُ عليه وسلَّم العُكَّةَ من السَّمنِ والعُكَّةَ من العسلِ ، فإذا جاء صاحبُه يتقاضاه جاء به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال : أعْطِ هذا ثمنَ متاعِه ، فما يزيدُ النَّبيُّ صلَّى اللهُ عليه وسلَّم أن يبتسمَ ويأمرَ به فيُعطَى ، فجيء به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم وقد شرِب الخمرَ ، فقال رجلٌ : اللَّهمَّ العَنْه ما أكثرَ ما يُؤتَى به إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["دعوه",1]," ، ",["فإنَّه يحبُّ اللهَ ورسولَه",2]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح ثابت","takhrij":"أخرجه البخاري (6780)، والبزار (269)، وأبو يعلى (176) واللفظ لهم.","bab":"حدود › كراهة لعن شارب الخمر","dorar":"Yib7PpIl","merged":3,"otherRefs":["صحيح البخاري 6780 (صحيح)","مجموع الفتاوى 4/474 (صحيح)"]},{"id":"س-04596","fp":"8475c3824177","stateId":282,"easy":"إذا رأيت أخاك المذنب فلا تقل «أخزاه الله» ← لا تكن عون الشيطان عليه","cause":"ما له أخزاه اللهُ","result":"لا تَكونوا عَونَ الشَّيطانِ على أخيكُم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"صحيح البخاري 6781","srcLabel":"متفق عليه","text":["أُتيَ النَّبيُّ صلَّى اللهُ عليه وسلَّم بسَكرانَ، فأمَرَ بضَربِه. فمِنَّا مَن يَضرِبُه بيَدِه، ومِنَّا مَن يَضرِبُه بنَعلِه، ومِنَّا مَن يَضرِبُه بثَوبِه، فلَمَّا انصَرَفَ قال رَجُلٌ: ",["ما له أخزاه اللهُ",1],"! فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا تَكونوا عَونَ الشَّيطانِ على أخيكُم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"حدود › كراهة لعن شارب الخمر","dorar":"jMzo2JFV","merged":2,"otherRefs":["الإعلام بفوائد عمدة الأحكام 4/510 (صحيح)"]},{"id":"س-05996","fp":"c1f033b41233","stateId":282,"easy":"إذا قلت للمذنب «أخزاك الله» ← تعين عليه الشيطان","cause":"أخزاكَ اللهُ","result":"لا تقولوا هكذا، لا تُعينوا عليه الشيطانَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج سنن أبي داود 4478","srcLabel":"البخاري","text":["بإسنادِه، ومعناه. [بمعنى حديثِ: أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أُتِي برجُلٍ قد شرِبَ، فقال: اضرِبوه، فقال أبو هُرَيرةَ: فمنَّا الضاربُ بيَدِه، والضاربُ بنَعلِه، والضاربُ بثَوبِه، فلمَّا انصَرفَ قال بعضُ القومِ: ",["أخزاكَ اللهُ",1],"! فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["لا تقولوا هكذا، لا تُعينوا عليه الشيطانَ",2],"]. قال فيه بعدَ الضربِ: ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لأصحابِه: بَكِّتوه، فأقبَلوا عليه يقولونَ: أمَا اتَّقَيتَ اللهَ، ما خَشِيتَ اللهَ، وما استَحيَيْتَ من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثم أرسَلوه، وقال في آخِرِه: ولكنْ قولوا: اللهُمَّ اغفِرْ له، اللهُمَّ ارحَمْه، وبعضُهم يزيدُ الكلمةَ ونحوَها."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه البزار (8564) باختلاف يسير، وأخرجه البخاري (6777) مختصراً بنحوه","bab":"رقائق وزهد › تقوى الله","dorar":"i2qhsx5A","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5730 (صحيح)"]},{"id":"س-07544","fp":"6e8af7b3e294","stateId":282,"easy":"إذا قلت «تعس الشيطان» ← يتعاظم في نفسه","cause":"لا تَقُلْ: تَعِسَ الشَّيطانُ","result":"فإنَّكَ إذا قُلتَ: تَعِسَ الشَّيطانُ، تعاظَمَ في نَفْسِهِ، وقالَ: صرَعْتُهُ","explicit":true,"ref":"تخريج شرح السنة 3384","srcLabel":"السنة","text":["كُنتُ رَديفُهُ على حِمارٍ، فعَثَرَ الحِمارُ، فقُلتُ: تَعِسَ الشَّيطانُ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["لا تَقُلْ: تَعِسَ الشَّيطانُ",1],"؛ ",["فإنَّكَ إذا قُلتَ: تَعِسَ الشَّيطانُ، تعاظَمَ في نَفْسِهِ، وقالَ: صرَعْتُهُ",2]," بقُوَّتي، فإذا قُلتَ: بِسمِ اللَّهِ، تصاغَرَتْ إليهِ نَفْسُهُ حتَّى تكونَ أصغرَ مِنَ الذُّبابِ."],"grade":"صحيح","narrator":"عمن كان رديف رسول الله صلى الله عليه وسلم","muhaddith":"إسناده صحيح","bab":"فضائل النبي وصفته ودلائل النبوة › تواضعه صلى الله عليه وسلم","dorar":"MhxBl3Tm","merged":4,"otherRefs":["تخريج زاد المعاد 2/324 (صحيح)","القبس 1/196 (صحيح)","الصحيح المسند 1503 (صحيح)"]},{"id":"س-03657","fp":"162df049c9f4","stateId":282,"easy":"إذا عوقب أخوك فلا تلعنه ← لا تُعن الشيطان عليه، بل قل: رحمك الله","cause":"لا تُعِينوا الشيطانَ عليه","result":"ولكنْ قُولوا: رَحِمك اللهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج شرح السنة 10/ 338","srcLabel":"البخاري","text":[["لا تُعِينوا الشيطانَ عليه",1],"، ",["ولكنْ قُولوا: رَحِمك اللهُ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7985) بلفظه، والبخاري (6777)، وأبو داود (4477) كلاهما بنحوه.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"LDgAfrxr"},{"id":"س-03603","fp":"e48696c14030","stateId":282,"easy":"إذا سببت الديك ← فإنه يدعو إلى الصلاة","cause":"لا تَسبُّوا الدِّيكَ","result":"فإنَّهُ يَدعو إلى الصَّلاةِ","explicit":true,"ref":"الصحيح المسند 356","srcLabel":"السنة","text":[["لا تَسبُّوا الدِّيكَ",1]," ، ",["فإنَّهُ يَدعو إلى الصَّلاةِ",2],". قالَ أبي قال أبو النَّضرِ: نَهَى رسولُ اللَّهِ صلَّى اللَّه عليهِ وعلى آلِهِ وسلَّمَ عن سبِّ الدِّيكِ ، وقالَ : إنَّهُ يؤذِّنُ بالصَّلاةِ"],"grade":"صحيح","narrator":"زيد بن خالد الجهني","muhaddith":"صحيح","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"Ys0AzVKa","merged":2,"otherRefs":["فيض القدير 6/ 399 (صحيح)"]},{"id":"س-04094","fp":"647158794c3c","stateId":282,"easy":"إذا عجلت ← فالعجلة من الشيطان","cause":"والعَجَلةُ","result":"من الشَّيطانِ","explicit":true,"otherNeedIds":[50],"ref":"مجمع الزوائد 8/22","srcLabel":"البيهقي","text":["التَّأنِّي من اللهِ ",["والعَجَلةُ",1]," ",["من الشَّيطانِ",2]," وما أحدٌ أكثرُ معاذيرَ من اللهِ وما من شيءٍ أحبُّ إلى اللهِ من الحمدِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أبو يعلى (4256 )، والبيهقي في ((شعب الإيمان)) (4058 )","bab":"جن › صفة إبليس وجنوده","dorar":"mbnPxq0F","merged":2,"otherRefs":["صحيح الجامع 3011 (حسن)"]},{"id":"س-04598","fp":"bfe483354fc7","stateId":282,"easy":"إذا نلت من عرض أخيك التائب ← فما نلته منه أعظم من ذنبه","cause":"فالَّذي نِلْتُما مِن عِرْضِ أخيكما","result":"أكثرُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[57],"ref":"صحيح ابن حبان 4400","srcLabel":"الترمذي","text":["جاء ماعزُ بنُ مالكٍ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: إنَّ الأبعدَ قد زنى فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّم: ( وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) ثمَّ أمَر به فطُرِد وأُخرِج ثمَّ أتاه الثَّانيةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى فقال: ( وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) فطُرِد وأُخرِج ثمَّ أتاه الثَّالثةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى قال: (  وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ ) قال: أتَيْتُ امرأةً حرامًا مِثْلَ ما يأتي الرَّجلُ مِن امرأتِه فأمَر به فطُرِد وأُخرِج ثمَّ أتاه الرَّابعةَ فقال: يا رسولَ اللهِ إنَّ الأبعدَ قد زنى فقال: (  وَيْلَكَ وما يُدريكَ ما الزِّنا ؟ قال: أدخَلْتُ وأخرَجْتُ ؟ ) قال: نَعم، فأمَر به أنْ يُرجَمَ فلمَّا وجَد مسَّ الحجارةِ تحمَّل إلى شجرةٍ فرُجِم عندَها حتَّى مات \nفمرَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بعدَ ذلك معه نفرٌ مِن أصحابِه فقال رجلٌ منهم لصاحبِه: وأبيكَ إنَّ هذا لهو الخائبُ أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم مرارًا كلُّ ذلك يرُدُّه حتَّى قُتِل كما يُقتَلُ الكلبُ فسكَت عنهما النَّبيُّ صلَّى اللهُ عليه وسلَّم حتَّى مرَّ بجيفةِ حمارٍ شائلةٍ رِجْلَها فقال: ( كُلَا مِن هذا ) قالا: مِن جيفةِ حمارٍ يا رسولَ اللهِ ؟ قال: ( ",["فالَّذي نِلْتُما مِن عِرْضِ أخيكما",1]," ",["أكثرُ",2]," والَّذي نفسُ محمَّدٍ صلَّى اللهُ عليه وسلَّم بيدِه إنَّه لفي نهرٍ مِن أنهارِ الجنَّةِ يتقمَّصُ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (1428)، وابن ماجه (2554)، وأحمد (9809) واللفظ لهم.","bab":"حدود › من أقر بالحد","dorar":"qROjKZrK","merged":3,"otherRefs":["تخريج الإحياء للعراقي 3/176 (حسن)","صحيح ابن حبان 4399 (صحيح)"]},{"id":"س-00368","fp":"f30760c7982a","stateId":282,"easy":"إذا اشتد غضب السلطان ← يتسلط الشيطان","cause":"إذا استشاطَ السُّلطانُ","result":"تَسلَّطَ الشَّيطانُ","explicit":true,"otherNeedIds":[8],"ref":"الجامع الصغير 425","srcLabel":"أحمد","text":[["إذا استشاطَ السُّلطانُ",1]," ",["تَسلَّطَ الشَّيطانُ",2]],"grade":"حسن","narrator":"عطية بن عروة السعدي","muhaddith":"حسن","takhrij":"أخرجه أحمد (17984)، وابن أبي عاصم في ((الآحاد والمثاني)) (1266)، والطبراني (17/167) (444)","bab":"آداب عامة › الأخلاق المذمومة","dorar":"gJ4wxwDS"},{"id":"س-04110","fp":"91e8ae184605","stateId":282,"easy":"إذا آذيت بلسانك ويدك ← فهو من الشيطان","cause":"وما يكونُ من اللسانِ واليدِ","result":"فمن الشيطانِ","explicit":true,"ref":"السنن الكبرى للبيهقي 4/70","srcLabel":"أحمد","text":["بكتِ النساءُ على رقيةَ رضيَ اللهُ عنها ، فجعل عمرُ رضيَ اللهُ عنهُ ينهاهنَّ ، فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ : مَهْ يا عمرُ ، قال : ثم قال : إياكنَّ ونعيقَ الشيطانِ ، فإنَّهُ مهما يَكُنْ من العينِ والقلبِ فمن الرحمةِ ، ",["وما يكونُ من اللسانِ واليدِ",1]," ",["فمن الشيطانِ",2]," ، قال : وجعلت فاطمةُ رضيَ اللهُ عنها تبكي على شفيرِ قبرِ رقيةَ ، فجعل رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ يمسحُ الدموعَ عن وجهها باليدِ أو قال : بالثوبِ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"غير قوي، وله ما يدل على معناه، ويشهد له بالصحة","takhrij":"أخرجه أحمد (3103) ، والطيالسي (2817) وابن شبة في ((تاريخ المدينة)) ((1/ 102)) بنحوه","bab":"جنائز وموت › البكاء على الميت","dorar":"cHBzCvNp"},{"id":"س-07771","fp":"23af36fea042","stateId":282,"easy":"إذا اشتد غضبك في الجدال فاستعذ بالله من الشيطان ← يذهب عنك","cause":"استعِذْ باللهِ من الشيطانِ الرجيمِ","result":"ففضتُ عرقًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[14],"ref":"تفسير الطبري 1/23","srcLabel":"السنة","text":["أنَّ رجلينِ اختصما في آيةٍ من القرآنِ ، وكلٌّ يزعم أنَّ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أقرأه ، فتقارآ إلى أُبيٍّ ، فخالفَهما أُبيٌّ ، فتقارءوا إلى النبيِّ صلَّى اللهُ عليهِ وسلَّمَ ، فقال : يا نبيَّ اللهِ ! اختلفْنا في آيةٍ من القرآنِ ، وكلُّنا يزعمُ أنك أقرأتَه ، فقال لأحدِهما : اقرأْ ! قال : فقرأ ، فقال : أصبتَ ! وقال للآخرِ : اقرأْ ! فقرأ خلاف ما قرأ صاحبُه ، فقال : أصبتَ ! وقال لأُبيٍّ : اقرأ ! فقرأ فخالفَهما ، فقال : أصبتَ ! قال أُبيٌّ : فدخلني من الشكِّ في أمرِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ ما دخل في أمرٍ من الجاهليةِ ، قال : فعرف رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ الذي في وجهي ، فرفع يدَه فضرب صدري ، وقال : ",["استعِذْ باللهِ من الشيطانِ الرجيمِ",1]," ، قال : ",["ففضتُ عرقًا",2]," ، وكأني أنظرُ إلى اللهِ فرَقًا ، وقال : إنه أتاني آتٍ من ربي ، فقال : إنَّ ربَّكَ يأمرُكَ أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أمتي ، قال : ثم جاء ، فقال : إنَّ ربَّك يأمرُكَ أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أُمتي ، قال : ثم جاء الثالثةَ ، فقال : إنَّ ربَّك يأمرك أن تقرأَ القرآنَ على حرفٍ واحدٍ ، فقلتُ : ربِّ خفِّفْ عن أمتي ، قال : ثم جاءني الرابعةَ ، فقال : إنَّ ربَّك يأمرك أن تقرأَ القرآنَ على سبعةِ أحرفٍ ، ولك بكلِّ ردَّة مسألةٌ ، قال : قلتُ : ربِّ اغفرْ لأمتي ، ربِّ اغفرْ لأمتي ، واختبأتُ الثالثةَ شفاعةً لأمتي ، حتى إنَّ إبراهيمَ صلَّى اللهُ عليهِ وسلَّمَ خليلَ الرحمنِ لَيرغِّبُ فيها"],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"ثابت","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"k7kl9mCt"}]}