{"schema":1,"kind":"sunan-chunk","version":"sunan-98a69b4361e7","needId":32,"stateIds":[354,355,356,357,358,359],"items":[{"id":"س-02505","fp":"7cf98befeafc","stateId":354,"easy":"إذا وسوس لك الشيطان «من خلق الله؟» ← فاستعذ بالله وانتهِ","cause":"فليَستَعِذْ باللهِ وليَنتَهِ","result":"يَأتي الشَّيطانُ أحَدَكُم فيَقولُ: مَن خَلَقَ كَذا؟ مَن خَلَقَ كَذا؟ حتَّى يَقولَ: مَن خَلَقَ رَبَّكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«من خلق الله؟»"},"otherNeedIds":[17],"ref":"صحيح البخاري 3276","srcLabel":"متفق عليه","text":[["يَأتي الشَّيطانُ أحَدَكُم فيَقولُ: مَن خَلَقَ كَذا؟ مَن خَلَقَ كَذا؟ حتَّى يَقولَ: مَن خَلَقَ رَبَّكَ",2],"؟ فإذا بَلَغَه ",["فليَستَعِذْ باللهِ وليَنتَهِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3276)، ومسلم (134)","bab":"إيمان › أعمال الجن والشياطين","dorar":"vc5Wge4t","merged":2,"otherRefs":["صحيح مسلم 134 (صحيح)"]},{"id":"س-02528","fp":"eda1f36d41eb","stateId":354,"easy":"إذا وجدت الوسوسة فقل «آمنت بالله ورسله» ← تذهب عنك","cause":"وجَدَ أحدُكمْ ذلِكَ فلْيَقُلْ : آمنْتُ بِاللهِ و رُسُلِهِ","result":"فإنَّ ذلِكَ يَذهبُ عنْهُ","explicit":true,"apply":{"k":"say","t":"«آمنت بالله ورسله»"},"similar":["س-02803"],"otherNeedIds":[5],"ref":"صحيح الجامع 1657","srcLabel":"أحمد","text":["إنَّ الشيطانَ يَأتِي أحدَكُمْ فيقولُ : مَن خَلَقَكَ ؟ فيَقولُ : اللهُ ، فيَقولُ : فمَنْ خلق اللهَ ؟ ! فإذا ",["وجَدَ أحدُكمْ ذلِكَ فلْيَقُلْ : آمنْتُ بِاللهِ و رُسُلِهِ",1]," ، ",["فإنَّ ذلِكَ يَذهبُ عنْهُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أحمد (26203)، وأبو يعلى (4704)، وابن حبان (150) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"4ERyAuc0"},{"id":"س-02803","fp":"eac3e780a615","stateId":354,"easy":"إذا وجدت الوسوسة فقل «آمنا بالله ورسوله» ثلاثاً ← تذهب عنك","cause":"من وجَد من هذا الوسواسِ ، فليقُلْ : آمنَّا باللهِ ورسولِه ثلاثا","result":"فإنَّ ذلك يَذهبُ عنه","explicit":true,"apply":{"k":"say","t":"«آمنا بالله ورسوله»"},"repOf":"س-02528","otherNeedIds":[5],"ref":"صحيح الجامع 6587","text":[["من وجَد من هذا الوسواسِ ، فليقُلْ : آمنَّا باللهِ ورسولِه  ثلاثا، ",1],["فإنَّ ذلك يَذهبُ عنه ",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن السني في ((عمل اليوم والليلة)) (626)، وابن عدي في ((الكامل في الضعفاء)) (1618)، والديلمي في ((الفردوس)) (5489) باختلاف يسير","bab":"إيمان › الوسوسة في الإيمان وما يقول من وجدها","dorar":"tyj3k8oa"},{"id":"س-02541","fp":"b8de1f9a2e7a","stateId":354,"easy":"إذا وجدت في نفسك وسوسة تكرهها ← فاحمد الله الذي رد كيده إلى الوسوسة","cause":"لَأنْ يكونَ حُمَمةً أحَبُّ إليه من أنْ يتكلَّمَ به","result":"الحمدُ للهِ الذي لم يَقدِرْ منكم إلَّا على الوَسْوسةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[17],"ref":"تخريج مشكل الآثار 1638","srcLabel":"أبو داود","text":["أنَّ أصحابَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، قالوا: يا رسولَ اللهِ، إنَّ أحدَنا يُحدِّثُ نفْسَه بالشَّيءِ، ",["لَأنْ يكونَ حُمَمةً أحَبُّ إليه من أنْ يتكلَّمَ به",1],"، فقال: ",["الحمدُ للهِ الذي لم يَقدِرْ منكم إلَّا على الوَسْوسةِ",2],"،، قال شُعبةُ: وحدَّثنا سُليمانُ بهذا الإسنادِ، وقال في حديثِه: الحمدُ للهِ الذي ردَّ أمرَه إلى الوَسْوسةِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (5112)، وأحمد (3161) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"1UAsA9ka","merged":4,"otherRefs":["الأحاديث المختارة 11 / 100 (صحيح)","تخريج صحيح ابن حبان 4599 (صحيح)","الصحيح المسند 1/511 (صحيح)"]},{"id":"س-02512","fp":"75cdb22baaf8","stateId":354,"easy":"إذا وسوس لك «من خلق الله؟» فقل: آمنت بالله ← تنقطع الوسوسة","cause":"فلْيَقُلْ: آمَنتُ باللهِ","result":"فمَن خلَقَ اللهَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«من خلق الله؟»"},"otherNeedIds":[17],"ref":"تخريج سنن أبي داود 4722","srcLabel":"متفق عليه","text":["فذَكَرَ نحوَه [أي نحوَ حديثِ: لا يزالُ النَّاسُ يَتساءَلونَ حتى يُقالَ: هذا خَلَقَ اللهُ الخَلْقَ، ",["فمَن خلَقَ اللهَ",2],"؟ فمَن وجَدَ من ذلك شيئًا، ",["فلْيَقُلْ: آمَنتُ باللهِ",1],"]، قال: فإذا قالوا ذلك، فقُولوا: {قُلْ هُوَ اللَّهُ أَحَدٌ * اللَّهُ الصَّمَدُ * لَمْ يَلِدْ وَلَمْ يُولَدْ * وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ} [الإخلاص: 1-4] ثُمَّ لْيَتْفُلْ عن يَسارِه ثلاثًا، ولْيَستَعِذْ من الشَّيطانِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3276) مختصراً بنحوه، ومسلم (134) بنحوه","bab":"إيمان › أعمال الجن والشياطين","dorar":"tjTNsDnY","merged":4,"otherRefs":["تخريج صحيح ابن حبان 150 (صحيح)","صحيح الجامع 1656 (صحيح)","تخريج المسند لشعيب 21867 (صحيح)"]},{"id":"س-08155","fp":"4a2d4def241c","stateId":354,"easy":"إذا وجدت لمّة الشيطان (الشر والتكذيب) فتعوّذ بالله ← يُصرف عنك","cause":"فلْيَتَعَوَّذْ باللهِ من الشيطانِ","result":"ومَن وجد الأخرى","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"هداية الرواة 70","srcLabel":"الترمذي","text":["إنَّ للشيطانِ لَمَّةً بابنِ آدمَ ، وللمَلَكِ لَمَّةً ، فأما لَمَّةُ الشيطانِ ، فإيعادٌ بالشرِّ ، وتكذيبٌ بالحقِّ ، وأما لَمَّةُ المَلَكِ ؛ فإيعادٌ بالخيرِ ، وتصديقٌ بالحقِّ ، فمَن وجد ذلك ، فلْيَعْلَمْ أنه من اللهِ ، فلْيَحْمَدِ اللهَ ، ",["ومَن وجد الأخرى",2]," ، ",["فلْيَتَعَوَّذْ باللهِ من الشيطانِ",1]," ، ثم قرأ  الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُمْ بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُمْ مَغْفِرَةً مِنْهُ وَفَضْلًا"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (2988) واللفظ له، والنسائي في ((السنن الكبرى)) (11051)، وابن حبان (997)","bab":"ملائكة › أعمال الملائكة","dorar":"92wIc8c8"},{"id":"س-04105","fp":"d59511dc0ed7","stateId":354,"easy":"إذا قلت كلمة التوحيد ← تنجيك (من أثر عثمان)","cause":"أنْ تقولوا ما أمَرتُ به عمِّي أنْ يقُولَه","result":"يُنجِيكُم مِن ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[19],"ref":"تخريج المسند لشعيب 37","srcLabel":"أحمد","text":["أنَّ عُثمانَ قال: تَمنَّيتُ أنْ أكونَ سألتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ: ماذا يُنجِينَا ممَّا يُلقِي الشيطانُ في أنفُسِنا؟ فقال أبو بَكْرٍ: قد سألتُه عن ذلك، فقال: ",["يُنجِيكُم مِن ذلك",2]," ",["أنْ تقولوا ما أمَرتُ به عمِّي أنْ يقُولَه",1]," فلم يقُلْه."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (37) واللفظ له، وأبو يعلي (133)","bab":"جن › صفة إبليس وجنوده","dorar":"3uPxzbh4"},{"id":"س-02534","fp":"accb0f2faec2","stateId":355,"easy":"إذا أحسست بالوسوسة في الصلاة فانفث عن يسارك ثلاثاً وتعوّذ ← يذهب الله عنك ما تجد","cause":"فإذا أحسستَ بذلك فانفثْ عن يسارِك ثلاثَ مراتٍ وتعوذ باللهِ من الشيطانِ ثلاثًا","result":"فأذهبَ اللهُ عني ما أجدُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[51],"ref":"مجموع فتاوى ابن باز 29/336","srcLabel":"مسلم","text":["يا رسولَ اللهِ إن الشيطانَ قد لبَّس عليَّ صلاتي  فقال صلَّى اللهُ عليهِ وسلَّمَ :  ذاك شيطانٌ يقالُ له خنزبٌ ، ",["فإذا أحسستَ بذلك فانفثْ عن يسارِك ثلاثَ مراتٍ وتعوذ باللهِ من الشيطانِ ثلاثًا",1]," قال عثمانُ : ففعلتُ ذلك ",["فأذهبَ اللهُ عني ما أجدُ",2]],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (2203)، وأحمد (17897)، وعبد بن حميد في المنتخب (380) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"QyCs21oc","merged":3,"otherRefs":["المستدرك على الصحيحين 7721 (صحيح)","مجموع الشروح الفقهية. 74/25 (صحيح)"]},{"id":"س-02544","fp":"3137973c755d","stateId":355,"easy":"إذا التبست عليك قراءتك في الصلاة فاستعذ واتفل ← يذهب عنك الشيطان","cause":"فإذا أتاكَ فاخْسَأْهُ","result":"فذهَب عنِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[51],"ref":"تخريج مشكل الآثار 370","srcLabel":"مسلم","text":["قُلْتُ: يا رسولَ اللهِ، إنَّ الشَّيطانَ يأتيني، فيَلبِسُ عليَّ قراءَتي، قال: ذاك شَيطانٌ يُقالُ له: خِنْزَبٌ، ",["فإذا أتاكَ فاخْسَأْهُ",1],"، ففعَلْتُ ",["فذهَب عنِّي",2],"."],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (370) واللفظ له، ومسلم (2203) باختلاف يسير، وأحمد (17897) بنحوه.","bab":"إيمان › أعمال الجن والشياطين","dorar":"2xgXieyw"},{"id":"س-02498","fp":"2c7419cd5b6f","stateId":355,"easy":"إذا وسوس لك الشيطان في عدد ركعاتك فضع سبابتك على فخذك ← يذهب عنك الشك","cause":"فضَعْ إِصبَعَكَ السَّبابةَ على فخِذِكَ اليُسْرَى","result":"فما أدْرِي على شَفْعٍ أنْفَتِلُ أمْ على وِتْرٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"البحر الزخار 6/327","srcLabel":"الطبراني","text":["أنَّ رجلًا قال : يا رسولَ اللهِ ، إنِّي لَأدخُلُ الصلاةَ ",["فما أدْرِي على شَفْعٍ أنْفَتِلُ أمْ على وِتْرٍ",2]," لِسُوءِ حِفْظِي ، فقال : إذا وجدْتَ ذلِكَ ؛ ",["فضَعْ إِصبَعَكَ السَّبابةَ على فخِذِكَ اليُسْرَى",1]," ، فإنَّها من الشَّيطانِ"],"grade":"صحيح","narrator":"أسامة بن عمير الهذلي","muhaddith":"محفوظ من هذا الوجه، [وفيه] أبو سعيد الحسن بن دينار ومهاجر أبو حبيب ليسا بالقويين في الحديث","takhrij":"أخرجه الطبراني (1/ 192) (512) بلفظه.","bab":"إيمان › أعمال الجن والشياطين","dorar":"LcUcWcdN"},{"id":"س-02500","fp":"cf9b95c9afce","stateId":355,"easy":"إذا أشرت بإصبعك في التشهد ← فهي مذبة الشيطان، لا تسهو","cause":"وهو يقولُ هكَذا في التشَهُّدِ","result":"مذبة الشَّيطانِ ، لا يَسهو أحدٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04102"],"ref":"صفة الصلاة 158","srcLabel":"صفة الصلاة","text":["عن عبد الله بن عمر قال: وهيَ [",["مذبة] الشَّيطانِ ، لا يَسهو أحدٌ",2]," ",["وهو يقولُ هكَذا [في التشَهُّدِ",1],"]"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"إيمان › أعمال الجن والشياطين","dorar":"vM0nIpQX"},{"id":"س-04102","fp":"ff4fefdd3802","stateId":355,"easy":"إذا أشرت بإصبعك في التشهد ← فهي أشد على الشيطان من الحديد","cause":"وأشار بإصبعِه وأتبعها بصرَه","result":"لهِيَ أشدُّ على الشيطانِ من الحديدِ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"repOf":"س-02500","ref":"تخريج المسند لشاكر 8/194","text":["كان عبدُ اللهِ بنُ عمرَ إذا جلس في الصلاةِ وضع يدَيه على رُكبَتَيه ",["وأشار بإصبعِه وأتبعها بصرَه",1]," ثم قال : قال رسولُ اللهِ صلَّى اللهُ عليهِ وسلمَ  : ",["لهِيَ أشدُّ على الشيطانِ من الحديدِ",2]," يعنى السبابةَ"],"grade":"صحيح","narrator":"نافع مولى ابن عمر","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (6000) واللفظ له، والبزار (5917)، والطبراني (642) باختلاف يسير.","bab":"جن › صفة إبليس وجنوده","dorar":"o9hkZhPL"},{"id":"س-01487","fp":"3d18a63f996a","stateId":355,"easy":"إذا جاءك الشيطان بالوسوسة في الوضوء فقل: كذبت ← فلا تنصرف إلا بيقين","cause":"فليَقُلْ: كَذَبْتَ، إلَّا ما وَجَد رِيحًا بأنفِه، أو سَمِعَ صَوتًا بأُذُنِه","result":"إذا جاء أحَدَكُمُ الشَّيطانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"المستدرك على الصحيحين 1227","srcLabel":"أبو داود","text":["عنِ عِياضٍ، قالَ: سَألتُ أبا سَعيدٍ الخُدريَّ، فقُلتُ: أحَدُنا يُصَلِّي فلا يَدري كم صَلَّى. قالَ: قالَ لنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: إذا صَلَّى أحَدُكُم فلم يَدرِ كم صَلَّى؛ فليَسجُدْ سَجدَتَينِ، و",["إذا جاء أحَدَكُمُ الشَّيطانَ",2]," فقالَ: إنَّكَ قد أحدَثْتَ؛ ",["فليَقُلْ: كَذَبْتَ، إلَّا ما وَجَد رِيحًا بأنفِه، أو سَمِعَ صَوتًا بأُذُنِه",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (1029) دون السؤال في أوله، والترمذي (396)، وأحمد (11478) جميعا بلفظ مقارب.","bab":"وضوء › نواقض الوضوء","dorar":"jYvd3oDX","merged":4,"otherRefs":["صحيح ابن حبان 2666 (صحيح)","تخريج المسند لشعيب 11513 (صحيح)","تخريج المسند لشعيب 11468 (صحيح)"]},{"id":"س-01424","fp":"961deef14cd0","stateId":355,"easy":"إذا توضأت فانتضح (رش الماء) والهُ عن الوسوسة ← يذهب عنك ما تجد","cause":"إذا تَوضَّأتَ فانتَضِحْ والْهُ عَنه","result":"وشَكا له مَولًى لابنِ الأزهَرِ البَولَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"النفح الشذي 1/٤٤٩","srcLabel":"ابن أبي شيبة","text":["عَنِ ابنِ عُمَرَ أنَّه كان إذا تَوضَّأ نَضَحَ فرجَه، ",["وشَكا له مَولًى لابنِ الأزهَرِ البَولَ",2],"، فقال: ",["إذا تَوضَّأتَ فانتَضِحْ والْهُ عَنه",1],"؛ فإنَّه مِنَ الشَّيطانِ"],"grade":"صحيح","narrator":"نافع مولى ابن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه ابن أبي شيبة (1786) بلفظه مختصرًا.","bab":"وضوء › صفة الوضوء","dorar":"Vd53cR40"},{"id":"س-01486","fp":"a3561d4a1c8c","stateId":355,"easy":"إذا شبّه عليك الشيطان في صلاتك فقل في نفسك: كذبت ← فلا تنصرف حتى تتيقن","cause":"فلْيَقُلْ في نفْسِه: كذَبْتَ، حتى يسمَعَ صوتًا بأُذُنَيْه، أو يَجِدَ ريحًا بأَنْفِه","result":"إذا شبَّه على أَحَدِكمُ الشيطانُ وهو في صلاتِه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"تخريج المسند لشعيب 11320","srcLabel":"أبو داود","text":["\"",["إذا شبَّه على أَحَدِكمُ الشيطانُ وهو في صلاتِه،",2]," فقال: أَحدَثْتَ، ",["فلْيَقُلْ في نفْسِه: كذَبْتَ، حتى يسمَعَ صوتًا بأُذُنَيْه، أو يَجِدَ ريحًا بأَنْفِه",1],"، وإذا صلَّى أَحَدُكم فلم يَدْرِ أَزاد أَمْ نقَص، فلْيَسْجُدْ سَجدَتيْنِ وهو جالسٌ\"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (1029)، والترمذي (396) باختلاف يسير، والنسائي في ((السنن الكبرى)) (587) مختصراً، وابن ماجه (514، 1204) مفرقاً باختلاف يسير، وأحمد (11320) واللفظ له","bab":"وضوء › نواقض الوضوء","dorar":"I1HnF5uv"},{"id":"س-01515","fp":"af77303996e7","stateId":356,"easy":"إذا نودي بالصلاة ← يدبر الشيطان","cause":"إذا نوديَ بالصَّلاةِ","result":"أدبَرَ الشَّيطانُ وله ضُراطٌ","explicit":true,"similar":["س-01498"],"ref":"صحيح البخاري 3285","srcLabel":"متفق عليه","text":[["إذا نوديَ بالصَّلاةِ",1]," ",["أدبَرَ الشَّيطانُ وله ضُراطٌ",2],"، فإذا قُضيَ أقبَلَ، فإذا ثُوِّبَ بها أدبَرَ، فإذا قُضيَ أقبَلَ، حتَّى يَخطِرَ بينَ الإنسانِ وقَلبِه، فيَقولُ: اذكُر كَذا وكَذا، حتَّى لا يَدريَ أثَلاثًا صَلَّى أم أربَعًا، فإذا لَم يَدرِ ثَلاثًا صَلَّى أو أربَعًا، سَجَدَ سَجدَتَيِ السَّهوِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3285)، ومسلم (389)","bab":"أذان › فضل التأذين","dorar":"xJ5YDcL7"},{"id":"س-01518","fp":"1c481e4cc3c2","stateId":356,"easy":"إذا أذّن المؤذن ← يدبر الشيطان","cause":"إذا أذَّن المُؤذِّنُ","result":"أدبَر الشَّيطانُ وله ضُراطٌ","explicit":true,"apply":{"k":"time","t":"عند الأذان"},"similar":["س-01495","س-01509"],"ref":"تخريج صحيح ابن حبان 1662","srcLabel":"متفق عليه","text":[["إذا أذَّن المُؤذِّنُ",1]," ",["أدبَر الشَّيطانُ وله ضُراطٌ",2]," فإذا سكَت أقبَل فإذا ثوَّب أدبَر وله ضُراطٌ فإذا سكَت أقبَل يخطِرُ بَيْنَ المرءِ ونفسِه حتَّى يظَلَّ الرَّجُلُ لا يدري كم صلَّى فإذا صلَّى أحَدُكم فوجَد ذلكَ فلْيسجُدْ سجدتَيْنِ وهو جالسٌ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرطهما","takhrij":"أخرجه البخاري (1231)، ومسلم (389) باختلاف يسير","bab":"أذان › فضل التأذين","dorar":"BCL6L9WU"},{"id":"س-02517","fp":"3d0b3e717f51","stateId":356,"easy":"إذا رصصت الصفوف وقاربت بينها ← تمنع الشيطان من الدخول بينكم","cause":"رصُّوا صفوفَكُم، وقارِبوا بينَها، وحاذوا بالأعناقِ","result":"إنِّي لأرى الشَّيطانَ يدخلُ من خَلَلِ الصَّفِّ كأنَّها الحذفُ","explicit":true,"similar":["س-06666"],"otherNeedIds":[51],"ref":"صحيح ابن خزيمة 3/ 69","srcLabel":"ابن خزيمة","text":[["رصُّوا صفوفَكُم، وقارِبوا بينَها، وحاذوا بالأعناقِ",1],"، فوالَّذي نَفسُ محمَّدٍ بيدِهِ ",["إنِّي لأرى الشَّيطانَ يدخلُ من خَلَلِ الصَّفِّ كأنَّها الحذفُ",2]," قالَ مُسلمٌ: يعني النَّقدَ الصِّغارَ، النَّقدُ الصِّغارُ: أولادُ الغَنمِ"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أخرجه في صحيحه","bab":"إيمان › أعمال الجن والشياطين","dorar":"FtNmCr0f","merged":4,"otherRefs":["خلاصة الأحكام للنووي 2/708 (صحيح)","صحيح الجامع 3505 (صحيح)","الأحاديث المختارة 2435 (صحيح)"]},{"id":"س-06672","fp":"6f4c2fdf63ab","stateId":356,"easy":"إذا تراصصتم في الصف ← لا يتخللكم الشيطان","cause":"تَراصُّوا في الصَّفِّ","result":"لا يَتخَلَّلُكُم أولادُ الحَذَفِ","explicit":true,"ref":"المستدرك على الصحيحين 882","srcLabel":"الحاكم","text":[["تَراصُّوا في الصَّفِّ",1]," ",["لا يَتخَلَّلُكُم أولادُ الحَذَفِ",2]," قُلتُ: يا رَسولَ اللهِ، ما أولادُ الحَذَفِ؟ قالَ: ضَأنٌ جُرْدٌ سودٌ تَكونُ بأرضِ اليَمَنِ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح على شرط الشيخين","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"YgkxL8ef","merged":4,"otherRefs":["تخريج المسند لشعيب 18618 (صحيح)","المهذب في اختصار السنن 2/1032 (حسن)","صحيح الجامع 1192 (صحيح)"]},{"id":"س-06668","fp":"d375931ad79a","stateId":356,"easy":"إذا سددت الخلل في الصف ← لا يدخل الشيطان بينكم","cause":"وسُدُّوا الخَللَ","result":"فإنَّ الشَّيطانَ يَدخُلُ فيما بيْنَكم بمَنزِلةِ الحَذَفِ","explicit":true,"ref":"تخريج المسند لشعيب 22263","srcLabel":"أحمد","text":["إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ الأوَّلِ، قالوا: يا رسولَ اللهِ، وعلى الثَّاني؟ قال: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ الأوَّلِ، قالوا: يا رسولَ اللهِ، وعلى الثَّاني؟ قال: إنَّ اللهَ وملائكتَه يُصلُّونَ على الصَّفِّ الأوَّلِ، قالوا: يا رسولَ اللهِ، وعلى الثَّاني؟ قال: وعلى الثَّاني، وقال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: سَوُّوا صُفوفَكم، وحاذوا بيْنَ مَناكبِكم، ولِينوا في أيدي إخْوانِكم، ",["وسُدُّوا الخَللَ",1],"؛ ",["فإنَّ الشَّيطانَ يَدخُلُ فيما بيْنَكم بمَنزِلةِ الحَذَفِ",2],"؛ يَعني: أَولادَ الضَّأنِ الصِّغارَ."],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (22263) واللفظ له، والطبراني (8/205) (7727)","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"cdYnOnPL","merged":2,"otherRefs":["صحيح الجامع 1840 (صحيح)"]},{"id":"س-06666","fp":"2eb865d1ec26","stateId":356,"easy":"إذا رصصت الصفوف ← يُمنع الشيطان من الخلل","cause":"راصُّوا الصُّفوفَ","result":"فإنَّ الشَّيطانَ يقومُ في الخَلَلِ","explicit":true,"repOf":"س-02517","otherNeedIds":[51],"ref":"تخريج المسند لشعيب 12572","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["راصُّوا الصُّفوفَ",1],"؛ ",["فإنَّ الشَّيطانَ يقومُ في الخَلَلِ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه أحمد (12572)، والدارقطني في ((العلل)) (12/230) واللفظ لهما، وأبو نعيم في ((حلية الأولياء)) (3/53) باختلاف يسير","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"iWBtksjO"},{"id":"س-06678","fp":"d32d921e765a","stateId":356,"easy":"إذا أقمت الصفوف وتراصصت ← لا يدخل الشيطان بينكم","cause":"أَقيموا صفوفَكم ، و تراصُّو","result":"إني لأرى الشيطانَ بين صفوفِكم كأنها غنمٌ عفرٌ","explicit":true,"otherNeedIds":[51],"ref":"صحيح الجامع 1194","srcLabel":"الطيالسي","text":[["أَقيموا صفوفَكم ، و تراصُّو",1]," ، فوالذي نفسي بيدِه ، ",["إني لأرى الشيطانَ بين صفوفِكم كأنها غنمٌ عفرٌ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الطيالسي (2222)، وأبو نعيم في ((حلية الأولياء)) (6/309)","bab":"صلاة الجماعة والإمامة › إقامة الصفوف ووصلها وفضائلها","dorar":"CTWy6lLz"},{"id":"س-01495","fp":"9935f51bbe81","stateId":356,"easy":"إذا أذّنت ← يدبر الشيطان","cause":"إذا نوديَ بالأذانِ","result":"أدبَرَ الشَّيطانُ له ضُراطٌ، حتَّى لا يَسمَعَ الأذانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01518","ref":"صحيح مسلم 389","text":[["إذا نوديَ بالأذانِ",1]," ",["أدبَرَ الشَّيطانُ له ضُراطٌ، حتَّى لا يَسمَعَ الأذانَ",2],"، فإذا قُضيَ الأذانُ أقبَلَ، فإذا ثُوِّبَ بها أدبَرَ، فإذا قُضيَ التَّثويبُ أقبَلَ يَخطُرُ بينَ المَرءِ ونَفسِه، يقولُ: اذكُرْ كَذا، اذكُرْ كَذا، لِما لَم يَكُنْ يَذكُرُ، حتَّى يَظَلَّ الرَّجُلُ إن يَدري كَم صَلَّى، فإذا لَم يَدرِ أحَدُكُم كَم صَلَّى فليَسجُدْ سَجدَتَينِ وهو جالِسٌ. وفي روايةٍ: أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: إنَّ الشَّيطانَ إذا ثُوِّبَ بالصَّلاةِ ولَّى وله ضُراطٌ، فذَكَرَ نَحوَه، وزادَ: فهَنَّاه ومَنَّاه، وذَكَّرَه مِن حاجاتِه ما لَم يَكُنْ يَذكُرُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1222)، ومسلم (389).","bab":"أذان › فضل التأذين","dorar":"WeJn2KJa","merged":9,"otherRefs":["صحيح النسائي 1252 (صحيح)","صحيح مسلم 389 (صحيح)","صحيح البخاري 1222 (صحيح)","الكلم الطيب 131 (صحيح)","تخريج المسند لشعيب 10543 (صحيح)","صحيح ابن خزيمة 1/ 480 (صحيح)","تخريج المسند لشعيب 10876 (صحيح)","صحيح الجامع 1647 (صحيح)"]},{"id":"س-04104","fp":"4b59df4b9dad","stateId":356,"easy":"إذا سوّيت الصفوف ← تمنع الشيطان من التخلل بينها","cause":"سوُّوا صفوفَكم","result":"فإنَّ الشَّيطانَ يتخلَّلُها كالحذفِ أو كأولادِ الحذفِ","explicit":true,"ref":"مجمع الزوائد 2/93","srcLabel":"الطبراني","text":["عن عبدِ اللَّهِ بنِ مسعودٍ قالَ ",["سوُّوا صفوفَكم ",1],["فإنَّ الشَّيطانَ يتخلَّلُها كالحذفِ أو كأولادِ الحذفِ",2]],"grade":"حسن","narrator":"[عوف بن مالك بن نضلة أبو الأحوص]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني في ((الكبير)) (9/ 275) (9376) واللفظ له.","bab":"جن › صفة إبليس وجنوده","dorar":"mKVZIjIL"},{"id":"س-01498","fp":"b72f7ca5339e","stateId":356,"easy":"إذا نوديت للصلاة ← يهرب الشيطان بعيداً","cause":"إذا سَمِعَ النِّداءَ بالصَّلاةِ","result":"ذَهَبَ حتَّى يَكونَ مَكانَ الرَّوحاءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"repOf":"س-01515","ref":"صحيح مسلم 388","text":["إنَّ الشَّيطانَ ",["إذا سَمِعَ النِّداءَ بالصَّلاةِ",1]," ",["ذَهَبَ حتَّى يَكونَ مَكانَ الرَّوحاءِ",2],". قال سُلَيمانُ: فسَألتُه عَنِ الرَّوحاءِ، فقال: هي مِنَ المَدينةِ سِتَّةٌ وثَلاثونَ ميلًا."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"أذان › فضل التأذين","dorar":"qY83INDr","merged":2,"otherRefs":["تخريج المسند لشعيب 14610 (صحيح)"]},{"id":"س-01509","fp":"e316fe8adf9e","stateId":356,"easy":"إذا أذّن المؤذن ← يخرج الشيطان من المسجد","cause":"إذا أذَّنَ المؤَذِّنُ","result":"خَرَجَ الشَّيطانُ منَ المسجدِ له حُصاصٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"عند الأذان"},"repOf":"س-01518","ref":"تخريج سنن الدارقطني 1404","text":[["إذا أذَّنَ المؤَذِّنُ",1]," ",["خَرَجَ الشَّيطانُ منَ المسجدِ له حُصاصٌ",2],"، فإذا سَكَتَ المؤَذِّنُ رَجَعَ، فإذا أقامَ المؤَذِّنُ الصَّلاةَ خرَجَ منَ المسجدِ وله ضُراطٌ، فإذا سكَتَ رجَعَ حتى يَأتيَ المَرءَ المُسلمَ في صَلاتِه، فيَدخُلَ بيْنَه وبيْنَ نَفْسِه، لا يَدري أزاد في صَلاتِه أم نقَصَ؟ فإذا وجَدَ ذلك أحدُكم، فليَسجُدْ سَجدَتَينِ وهو جالسٌ قبلَ أنْ يُسلِّمَ، ثم يُسلِّمْ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (1231)، ومسلم (389) باختلاف يسير دون قوله: \"قبل أن يسلم ثم يسلم\"","bab":"أذان › فضل التأذين","dorar":"ctfYoMT3"},{"id":"س-01514","fp":"0389a77e49d1","stateId":356,"easy":"إذا سمعت صوتاً مخيفاً فنادِ بالأذان ← يولّي الشيطان","cause":"إذا سَمِعتَ صَوتًا فنادِ بالصَّلاةِ","result":"إنَّ الشَّيطانَ إذا نوديَ بالصَّلاةِ ولَّى وله حُصاصٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"time","t":"عند الأذان"},"otherNeedIds":[6],"ref":"صحيح مسلم 389","srcLabel":"البخاري","text":["أرسَلَني أبي إلى بَني حارِثةَ، قال: ومَعي غُلامٌ لَنا أو صاحِبٌ لَنا، فناداه مُنادٍ مِن حائِطٍ باسمِه، قال: وأشرَفَ الذي مَعي على الحائِطِ فلَم يَرَ شيئًا، فذَكَرتُ ذلك لأبي فقال: لو شَعَرتُ أنَّك تَلقَ هذا لَم أُرسِلْك، ولَكِن ",["إذا سَمِعتَ صَوتًا فنادِ بالصَّلاةِ",1],"؛ فإنِّي سَمِعتُ أبا هُرَيرةَ يُحَدِّثُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم أنَّه قال: ",["إنَّ الشَّيطانَ إذا نوديَ بالصَّلاةِ ولَّى وله حُصاصٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (608) مطولاً بلفظ: \"وله ضراط\" دون القصة في أوله","bab":"أذان › فضل التأذين","dorar":"Wxx8LVHB"},{"id":"س-02710","fp":"351189269223","stateId":356,"easy":"إذا رأيت الغيلان فأذّن ← تنصرف عنك","cause":"فأذِّنوا","result":"فإذا رأيتم ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"فتح الباري لابن حجر 396/6","srcLabel":"ابن أبي شيبة","text":["أن الغيلان ذكروا عند عمر فقال: أن أحدً لا يستطيعُ أن يتحولَ عن صورتِه التي خلقَه اللهُ عليها، ولكن لهم سحرةٌ كسحَرَتِكم، ",["فإذا رأيتم ذلك",2]," ",["فأذِّنوا",1],"."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن أبي شيبة (10/ 397)، وابن أبي الدنيا في ((مكائد الشيطان)) (صـ 24). باختلاف يسير عندهما.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"Bn78A1qj"},{"id":"س-01418","fp":"d01c27e83250","stateId":357,"easy":"إذا استيقظت فاستنثر ثلاثاً ← فإن الشيطان يبيت على خيشومك","cause":"فليَستَنثِرْ ثَلاثًا","result":"فإنَّ الشَّيطانَ يَبيتُ على خَيشومِه","explicit":true,"star":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"ref":"صحيح البخاري 3295","srcLabel":"متفق عليه","text":["إذا استَيقَظَ -أُراه- أحَدُكُم مِن مَنامِه فتَوضَّأ، ",["فليَستَنثِرْ ثَلاثًا",1],"؛ ",["فإنَّ الشَّيطانَ يَبيتُ على خَيشومِه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3295)، ومسلم (238)","bab":"وضوء › صفة الوضوء","dorar":"MTG9tesk","merged":3,"otherRefs":["صحيح ابن خزيمة 1/ 267 (صحيح)","تخريج المسند لشاكر 16/255 (صحيح)"]},{"id":"س-02551","fp":"a5590382861e","stateId":357,"easy":"إذا تثاءبت في الصلاة فاكظم ما استطعت ← فالتثاؤب من الشيطان","cause":"فليَكْظِم ما استطاعَ","result":"إن التَّثاؤبُ في الصَّلاةِ منَ الشَّيطانِ","explicit":true,"star":true,"similar":["س-04086"],"ref":"هداية الرواة 952","srcLabel":"متفق عليه","text":["قالَ رسولُ اللَّهِ - صلَّى اللَّهُ علَيهِ وسلَّمَ - : ",["إن التَّثاؤبُ في الصَّلاةِ منَ الشَّيطانِ",2]," فإذا تثاءبَ أحدُكُم ؛ ",["فليَكْظِم ما استطاعَ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه الترمذي (370) باختلاف يسير، وأخرجه البخاري (3289)، ومسلم (2994) دون ذكر الصلاة","bab":"إيمان › أعمال الجن والشياطين","dorar":"K41LJQ6r","merged":2,"otherRefs":["تخريج المسند لشعيب 10695 (صحيح)"]},{"id":"س-00176","fp":"5a197eb082fe","stateId":357,"easy":"إذا تثاءبت فاكظم ما استطعت ولا تقل «هاه» ← لئلا يضحك منك الشيطان","cause":"فإذا تثاءَب أحدُكم فلْيرُدَّ ما استطاع ولا يقُلْ : هاو","result":"فإنَّه إذا قال : هاو ضحِك منه الشَّيطانُ","explicit":true,"ref":"تخريج صحيح ابن حبان 598","srcLabel":"متفق عليه","text":["إنَّ اللهَ يُحِبُّ العُطاسَ ويكرَهُ التَّثاؤبَ ",["فإذا تثاءَب أحدُكم فلْيرُدَّ ما استطاع ولا يقُلْ : هاو",1]," ",["فإنَّه إذا قال : هاو ضحِك منه الشَّيطانُ",2]," فإذا عطَس أحدُكم فقال : الحمدُ للهِ فحقٌّ على مَن سمِعه أنْ يقولَ : يرحَمُك اللهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه ابن حبان (598) واللفظ له، والبخاري (6226) بنحوه، ومسلم (2994) مختصرا بنحوه.","bab":"آداب العطاس › العطاس","dorar":"u4dfH2f0"},{"id":"س-03112","fp":"4ac9ae19d713","stateId":357,"easy":"إذا تثاءبت فاكظم أو ضع يدك على فمك ← لئلا يضحك منك الشيطان","cause":"فإذا تثاءَب أحدُكم فليكظِمْ ما استطاع أو ليضَعْ يدَه على فيه","result":"فإنَّه إذا تثاءَب فقال: آه فإنَّما هو الشَّيطانُ يضحَكُ مِن جوفِه","explicit":true,"similar":["س-05884"],"ref":"صحيح ابن حبان 2358","srcLabel":"البخاري","text":["إنَّ اللهَ يُحِبُّ العُطاسَ ويكرَهُ التَّثاؤبَ ",["فإذا تثاءَب أحدُكم فليكظِمْ ما استطاع أو ليضَعْ يدَه على فيه",1]," ",["فإنَّه إذا تثاءَب فقال: آه فإنَّما هو الشَّيطانُ يضحَكُ مِن جوفِه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (6223)، وأبو داود (5028)، والترمذي (2746) بنحوه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"DyfAzHPN"},{"id":"س-04086","fp":"54bcca35fe64","stateId":357,"easy":"إذا تثاءبت في الصلاة فاكظم ما استطعت ← لئلا يدخل الشيطان","cause":"إذا تَثاءَبَ أحَدُكُم في الصَّلاةِ فليَكظِمْ ما استَطاعَ","result":"فإنَّ الشَّيطانَ يَدخُلُ","explicit":true,"repOf":"س-02551","ref":"صحيح مسلم 2995","text":[["إذا تَثاءَبَ أحَدُكُم في الصَّلاةِ فليَكظِمْ ما استَطاعَ؛ ",1],["فإنَّ الشَّيطانَ يَدخُلُ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جن › صفة إبليس وجنوده","dorar":"wIRA5b50"},{"id":"س-05828","fp":"3858dee60122","stateId":357,"easy":"إذا تثاءبت فسد فمك بيدك ← لئلا يدخل الشيطان","cause":"إذا تَثاءبَ أحدُكُم فليَسُدَّ بيدِهِ فاهُ","result":"فإنَّ الشَّيطانَ يدخلُ","explicit":true,"ref":"صحيح ابن خزيمة 2/ 128","srcLabel":"مسلم","text":[["إذا تَثاءبَ أحدُكُم فليَسُدَّ بيدِهِ فاهُ",1],"؛ ",["فإنَّ الشَّيطانَ يدخلُ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه مسلم (2995)، وأبو داود (5027) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"v8XAYPdR"},{"id":"س-05884","fp":"16b52c7a678d","stateId":357,"easy":"إذا تثاءبت فضع يدك على فمك ← لئلا يدخل الشيطان","cause":"إذا تَثاءَبَ أحَدُكم فلْيَضَعْ يَدَه على فيهِ","result":"فإنَّ الشَّيطانَ يَدخُلُ مع التَّثاؤُبِ","explicit":true,"repOf":"س-03112","ref":"تخريج المسند لشعيب 11889","text":[["إذا تَثاءَبَ أحَدُكم فلْيَضَعْ يَدَه على فيهِ؛ ",1],["فإنَّ الشَّيطانَ يَدخُلُ مع التَّثاؤُبِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2995)، وأبو داود (5026)، وأحمد (11889) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"bCbwBorj"},{"id":"س-02514","fp":"bc0dd000fb5b","stateId":357,"easy":"إذا دخلت الخلاء فقلت «اللهم إني أعوذ بك من الخبث والخبائث» ← تُحفظ (فهي أماكن تحضرها الشياطين)","cause":"فلْيقُل: اللَّهمَّ إنِّي أعوذُ بِكَ منَ الخُبثِ والخبائِثِ","result":"إنَّ هذِهِ الحُشوشَ مُحتضَرةٌ","explicit":true,"apply":{"k":"say","t":"«اللهم إني أعوذ بك من الخبث والخبائث»"},"ref":"صحيح ابن خزيمة 1/ 187","srcLabel":"ابن خزيمة","text":["عَنِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ",["إنَّ هذِهِ الحُشوشَ مُحتضَرةٌ",2],"، فإذا دَخلَها أحدُكُم ",["فلْيقُل: اللَّهمَّ إنِّي أعوذُ بِكَ منَ الخُبثِ والخبائِثِ",1]],"grade":"صحيح","narrator":"زيد بن أرقم","muhaddith":"أخرجه في صحيحه","bab":"إيمان › أعمال الجن والشياطين","dorar":"P6pyP9Ib","merged":2,"otherRefs":["الإعلام بفوائد عمدة الأحكام 1/427 (صحيح)"]},{"id":"س-00886","fp":"03aff4dbbc39","stateId":357,"easy":"إذا استيقظت فذكرت الله ثم توضأت ثم صليت ← تنحل عقد الشيطان عنك","cause":"فإن قام فذكر اللهَ عزَّ وجلَّ","result":"أُطلِقت واحدةٌ وإن مضَى فتوضأ أُطلِقت الثانيةُ فإن مضَى فصلَّى أُطلِقَت الثالثةُ","explicit":true,"apply":{"k":"time","t":"عند الاستيقاظ"},"ref":"مجمع الزوائد 2/265","srcLabel":"أحمد","text":["عن أبي هريرةََ قال إذا رقد أحدُكم عُقِد على رأسِه بجَريرٍ ",["فإن قام فذكر اللهَ عزَّ وجلَّ",1]," ",["أُطلِقت واحدةٌ وإن مضَى فتوضأ أُطلِقت الثانيةُ فإن مضَى فصلَّى أُطلِقَت الثالثةُ",2]," فإن أصبحَ ولم يقمْ شيئًا من الليلِ ولم يصلِّ الصبحَ أصبح وهو عليه يعني الحريرَ"],"grade":"صحيح","narrator":"[الحسن البصري]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (10457) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"x3kVdVfe"},{"id":"س-03687","fp":"daace04bb140","stateId":357,"easy":"إذا قِلت (نمت القيلولة) ← فالشياطين لا تقيل","cause":"قِيلُوا","result":"فإنَّ الشياطينَ لا تَقِيلُ","explicit":true,"ref":"الجامع الصغير 6150","srcLabel":"ابن حبان","text":[["قِيلُوا",1],"، ",["فإنَّ الشياطينَ لا تَقِيلُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان في ((المجروحين)) (2/96)، وأبو نعيم في ((الطب النبوي)) (151) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (28) باختلاف يسير","bab":"اعتصام بالسنة › لزوم السنة","dorar":"UKRpOK2l"},{"id":"س-01175","fp":"ca3ffa8b4eb5","stateId":357,"easy":"إذا قلت «بسم الله» عند دخول الخلاء ← تكون ستراً بين أعين الجن وعورتك","cause":"إذا دَخَلَ أحَدُهم الخَلاءَ أن يَقولَ: بسمِ اللهِ","result":"سَترُ ما بَينَ أعيُنِ الجِنِّ وعَوراتِ بَني آدَمَ","explicit":true,"apply":{"k":"say","t":"«بسم الله»"},"otherNeedIds":[42],"ref":"فيض القدير 4/ 97","srcLabel":"الترمذي","text":[["سَترُ ما بَينَ أعيُنِ الجِنِّ وعَوراتِ بَني آدَمَ",2]," ",["إذا دَخَلَ أحَدُهم الخَلاءَ أن يَقولَ: بسمِ اللهِ",1]],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (606)، وابن ماجه (297)، والبزار (484)، والبغوي في ((شرح السنة)) (187) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"TDIQ2rxB","merged":3,"otherRefs":["الجامع الصغير 4647 (حسن)","تخريج زاد المعاد 2/350 (حسن)"]},{"id":"س-05886","fp":"51465109dc35","stateId":358,"easy":"إذا سمعت نهيق الحمار فاستعذ بالله ← فإنه رأى شيطاناً","cause":"فاسْتَعِيذوا بِاللهِ","result":"فإنَّها رأتْ شيطانًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 8269","srcLabel":"متفق عليه","text":["قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فذَكَرَ معناه. [أيْ حديثَ: إذا سَمِعْتُم أصواتَ الدِّيَكةِ فإنَّها رأتْ مَلَكًا؛ فاسْأَلوا اللهَ وارْغَبوا إليه، وإذا سَمِعْتُم نُهاقَ الحَمِيرِ ",["فإنَّها رأتْ شيطانًا",2],"؛ ",["فاسْتَعِيذوا بِاللهِ",1]," مِنْ شَرِّ ما رأتْ]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه البخاري (3303)، ومسلم (2729)، وأبو داود (5102)، والترمذي (3459)، والنسائي في ((السنن الكبرى)) (10779)، وأحمد (8269) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"CPx3M4tL","merged":5,"otherRefs":["تخريج المسند لشعيب 8764 (صحيح)","صحيح الأدب المفرد 938 (صحيح)","صحيح الترمذي 3459 (صحيح)","صحيح الجامع 611 (صحيح)"]},{"id":"س-02525","fp":"8c53dc03cb31","stateId":358,"easy":"إذا ذكرت الله ← يخنس الشيطان","cause":"فإذا ذَكَرَ اللهَ","result":"خَنَسَ","explicit":true,"star":true,"similar":["س-00891"],"ref":"الأحاديث المختارة 10 / 175","srcLabel":"متفق عليه","text":["عن ابنِ عبَّاسٍ «في قَوْلِه: {الْوَسْوَاسِ الْخَنَّاسِ} هو الشَّيْطانُ، يُوَلِّهُ المَوْلودَ، والوَسْواسُ على قَلْبِه فهو يَصرِفُه حيثُ شاءَ، ",["فإذا ذَكَرَ اللهَ",1]," ",["خَنَسَ",2],"، وإذا غَفَلَ جَثَمَ على قَلْبِه فوَسْوَسَ»."],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"إيمان › أعمال الجن والشياطين","dorar":"iaN3A635","merged":4,"otherRefs":["هداية الرواة 2221 (صحيح)","الجامع الصغير 4955 (حسن)","الأحاديث المختارة 10 / 367 (صحيح)"]},{"id":"س-07823","fp":"c8d6a8299dd6","stateId":358,"easy":"إذا قرأت المعوذتين ← فلن تقرأ بمثلهما في التعوذ","cause":"اقرأْ المعوذتينِ","result":"فإنَّك لن تقرأَ بمثْلِهما","explicit":true,"apply":{"k":"read","t":"المعوذتين"},"ref":"صحيح الجامع 1160","srcLabel":"مسلم","text":[["اقرأْ المعوذتينِ ، ",1],["فإنَّك لن تقرأَ بمثْلِهما",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17322) بلفظه، ومسلم (814)، والترمذي (3367) كلاهما باختلاف يسير.","bab":"قرآن › فضل قراءة القرآن","dorar":"jYsvLSao"},{"id":"س-07637","fp":"ce8e29adc2cd","stateId":358,"easy":"إذا تعوذت بالإخلاص والمعوذتين ← فما تعوذ العباد بمثلهن","cause":"قُلْ هُوَ اللهُ أَحَدٌ قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ مِنْ شَرِّ مَا خَلَقَ حتى فرغْتَ منها ثمَّ قال قُلْ قلْتُ ما أقولُ قال قُلْ أَعُوذُ بِرَبِّ النَّاسِ","result":"فما تَعَوَّذَ العُبَّادُ بمثْلِهِنَّ قَطُّ","explicit":true,"otherNeedIds":[29,23,47],"ref":"مجمع الزوائد 7/152","srcLabel":"بيبي","text":["كنَّا معَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم في عمرةٍ حتى إذا كنَّا بِبَطْنِ واقِمٍ استقْبَلَتْنَا ضبَابَةٌ فأَضَلَّتْنَا الطريقُ فلَمْ أشعُرْ حتى طلَعْنَا علَى ثَنِيَّةٍ فلَمَّا رأى رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ذلِكَ عدَلَ إلى كَثِيبٍ فَأَناخَ عليه ثمَّ قام وقام عليه مَنْ شاءَ اللهُ فما زالَ يُصَلِّى حتَّى طلَعَ الفجرُ فأَخَذَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم برأْسِ ناقتِهِ ثمَّ مشَى وعبدُ اللهِ الأسلَمِيُّ إلى جنبِهِ ما أحدٌ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّم غيرُهُ فوضعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يدَهُ على صدْرِهِ ثمَّ قال قُلْ قلْتُ ما أقولُ قال  ",["قُلْ هُوَ اللهُ أَحَدٌ   قُلْ أَعُوذُ بِرَبِّ الْفَلَقِ مِنْ شَرِّ مَا خَلَقَ  حتى فرغْتَ منها ثمَّ قال قُلْ قلْتُ ما أقولُ قال  قُلْ أَعُوذُ بِرَبِّ النَّاسِ",1],"  قلْتُ قل أعوذُ بربِّ الناسِ حتى فرغْتَ منها فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم هكذا فتَعَوَّذْ ",["فما تَعَوَّذَ العُبَّادُ بمثْلِهِنَّ قَطُّ",2]],"grade":"صحيح","narrator":"عبدالله الأسلمي","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه بيبي في ((جزئه)) (42) واللفظ له.","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"xVHc3kYa","merged":14,"otherRefs":["هداية الرواة 2103 (صحيح)","صحيح الجامع 7948 (حسن)","صحيح النسائي 5444 (صحيح)","صحيح النسائي 5453 (صحيح)","السلسلة الصحيحة 1104 (صحيح)","صحيح ابن حبان 1842 (صحيح)","تخريج صحيح ابن حبان 795 (صحيح)","تخريج سنن أبي داود 2/397 (حسن)","تخريج مشكل الآثار 125 (حسن)","صحيح النسائي 5445 (صحيح)","صحيح النسائي 5446 (صحيح)","الصحيح المسند 2/30 (صحيح)","الصحيح المسند 933 (صحيح)"]},{"id":"ق-0447","fp":"6b7448efca12","stateId":358,"easy":"الاستعاذة بالله والتذكر عند مسّ الشيطان (التقوى) ← الإبصار وذهاب النزغ","cause":"الاستعاذة بالله والتذكر عند مسّ الشيطان (التقوى)","result":"الإبصار وذهاب النزغ","explicit":true,"ref":"سورة الأعراف: 200–201","srcLabel":"القرآن الكريم","quran":{"s":7,"from":200,"to":201,"text":"وَإِمَّا يَنْزَغَنَّكَ مِنَ الشَّيْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللَّهِ إِنَّهُ سَمِيعٌ عَلِيمٌ (200) إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ (201)","hl":[[0,180,1],[180,204,2]]}},{"id":"ق-0654","fp":"30df66bda27c","stateId":358,"easy":"الإخلاص والعبودية لله ← لا سلطان للشيطان عليهم","cause":"الإخلاص والعبودية لله","result":"لا سلطان للشيطان عليهم","explicit":true,"ref":"سورة الحجر: 40–42","srcLabel":"القرآن الكريم","quran":{"s":15,"from":40,"to":42,"text":"إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ (40) قَالَ هَذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ (41) إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ إِلَّا مَنِ اتَّبَعَكَ مِنَ الْغَاوِينَ (42)","hl":[[0,106,1],[106,138,2]]}},{"id":"ق-0679","fp":"34fc375f1daa","stateId":358,"easy":"الإيمان والتوكل على الله والاستعاذة به ← لا سلطان للشيطان عليهم","cause":"الإيمان والتوكل على الله والاستعاذة به","result":"لا سلطان للشيطان عليهم","explicit":true,"ref":"سورة النحل: 98–99","srcLabel":"القرآن الكريم","quran":{"s":16,"from":98,"to":99,"text":"فَإِذَا قَرَأْتَ الْقُرْآنَ فَاسْتَعِذْ بِاللَّهِ مِنَ الشَّيْطَانِ الرَّجِيمِ (98) إِنَّهُ لَيْسَ لَهُ سُلْطَانٌ عَلَى الَّذِينَ آمَنُوا وَعَلَى رَبِّهِمْ يَتَوَكَّلُونَ (99)","hl":[[0,84,1],[84,113,2],[113,170,1]]}},{"id":"ق-0713","fp":"85ea0720b23e","stateId":358,"easy":"العبودية لله والتوكل عليه ← لا سلطان للشيطان وكفى بالله وكيلاً","cause":"العبودية لله والتوكل عليه","result":"لا سلطان للشيطان وكفى بالله وكيلاً","explicit":true,"ref":"سورة الإسراء: 65","srcLabel":"القرآن الكريم","quran":{"s":17,"from":65,"to":65,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ وَكَفَى بِرَبِّكَ وَكِيلًا (65)","hl":[[0,15,1],[15,74,2]]}},{"id":"ق-1069","fp":"e83e07d883e2","stateId":358,"easy":"الإخلاص لله ← النجاة من إغواء الشيطان","cause":"الإخلاص لله","result":"النجاة من إغواء الشيطان","explicit":true,"ref":"سورة ص: 82–83","srcLabel":"القرآن الكريم","quran":{"s":38,"from":82,"to":83,"text":"قَالَ فَبِعِزَّتِكَ لَأُغْوِيَنَّهُمْ أَجْمَعِينَ (82) إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ (83)","hl":[[0,95,1]]}},{"id":"ق-1137","fp":"99da8d1350ce","stateId":358,"easy":"الاستعاذة بالله عند نزغ الشيطان ← الحفظ من نزغه","cause":"الاستعاذة بالله عند نزغ الشيطان","result":"الحفظ من نزغه","explicit":true,"ref":"سورة فصلت: 36","srcLabel":"القرآن الكريم","quran":{"s":41,"from":36,"to":36,"text":"وَإِمَّا يَنْزَغَنَّكَ مِنَ الشَّيْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللَّهِ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ (36)","hl":[[0,69,1]]}},{"id":"س-07542","fp":"fc045d9f83ee","stateId":358,"easy":"إذا عثرت فقل «بسم الله» ← يتصاغر الشيطان حتى يصير كالذباب","cause":"ولكنْ قُلْ: باسْمِ اللهِ","result":"فإنَّك إذا قُلْتَ ذلك تَصاغَرَ حتَّى يكونَ مِثلَ الذُّبابِ","explicit":true,"apply":{"k":"say","t":"«بسم الله»"},"similar":["س-00969","س-01013","س-03625"],"ref":"الصحيح المسند 1503","srcLabel":"الصحيح المسند","text":["كُنْتُ رَديفَ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فعَثَرَتْ دابَّتُه، فقُلْتُ: تَعِسَ الشَّيْطانُ، فقالَ: لا تَقُلْ: تَعِسَ الشَّيْطانُ؛ فإنَّك إذا قُلْتَ ذلك تَعاظَمَ حتَّى يكونَ مِثلَ البَيْتِ، ويقولُ: بقُوَّتي، ",["ولكنْ قُلْ: باسْمِ اللهِ",1],"؛ ",["فإنَّك إذا قُلْتَ ذلك تَصاغَرَ حتَّى يكونَ مِثلَ الذُّبابِ",2],"."],"grade":"صحيح","narrator":"رديف رسول الله صلى الله عليه وسلم","muhaddith":"صحيح، رجاله رجال الصحيح","bab":"فضائل النبي وصفته ودلائل النبوة › تواضعه صلى الله عليه وسلم","dorar":"3Uqq5RR5","merged":5,"otherRefs":["الأحكام الوسطى 4/ 323 (صحيح)","صحيح الجامع 7401 (صحيح)","تخريج زاد المعاد 2/324 (صحيح)","القبس 1/196 (صحيح)"]},{"id":"س-04097","fp":"31028b42f6bd","stateId":358,"easy":"إذا أخرجت الصدقة ← تفك عنها لحيي سبعين شيطاناً","cause":"لا يخرجُ رجلٌ شيئًا من الصَّدقةِ","result":"حتَّى يفُكَّ عنها لَحييَ سبعينَ شيطانًا","explicit":true,"otherNeedIds":[45],"ref":"الزواجر عن اقتراف الكبائر 1/193","srcLabel":"الزواجر عن اقتراف الكبائر","text":["كلُّ امرئٍ في ظِلِّ صدقتِهِ حتَّى يقضى بينَ النَّاسِ ، ",["لا يخرجُ رجلٌ شيئًا من الصَّدقةِ",1]," ",["حتَّى يفُكَّ عنها لَحييَ سبعينَ شيطانًا",2]],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"جن › صفة إبليس وجنوده","dorar":"1LMYfP2V","merged":2,"otherRefs":["إتحاف الخيرة المهرة 3/37 (حسن)"]},{"id":"س-00969","fp":"e31e179c67cf","stateId":358,"easy":"إذا قلت «بسم الله» ← يتصاغر الشيطان حتى يصير مثل الذباب","cause":"وإذا قُلتُ: باسمِ اللهِ","result":"تَصاغَرَ حتى يكونَ مِثلَ الذُّبابِ","explicit":true,"apply":{"k":"say","t":"«بسم الله»"},"repOf":"س-07542","ref":"تخريج المسند لشعيب 23092","text":["عن أبي تَميمةَ الهُجَيميِّ، عن رِدْفِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أو مَن حَدَّثَه عن رِدْفِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أنَّه كان رِدْفَه فعَثَرَتْ به دابَّتُه، فقال: تَعِسَ الشَّيطانُ، فقال: لا تَفعَلْ؛ فإنَّه يَتعاظَمُ إذا قُلتَ ذلك حتى يَصيرَ مِثلَ الجَبَلِ، ويقولُ: بقُوَّتي صَرَعتُه، ",["وإذا قُلتُ: باسمِ اللهِ",1],"، ",["تَصاغَرَ حتى يكونَ مِثلَ الذُّبابِ",2],"."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4982)، وأحمد (23092)","bab":"أدعية وأذكار › فضل الذكر","dorar":"ydUqQjxY"},{"id":"س-01013","fp":"a1130e71c283","stateId":358,"easy":"إذا قلت «بسم الله» ← يخنس الشيطان حتى يصير كالذباب","cause":"فإذا قيل بسمِ اللهِ","result":"خَنَسَ حتى يَصِيرَ مِثْلَ الذُّبابِ","explicit":true,"apply":{"k":"say","t":"«بسم الله»"},"repOf":"س-07542","ref":"صحيح الترغيب 3129","text":[["فإذا قيل بسمِ اللهِ ",1],["خَنَسَ حتى يَصِيرَ مِثْلَ الذُّبابِ",2]],"grade":"صحيح","narrator":"رديف رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7792) واللفظ له، وأبو داود (4982)، وأحمد (20690) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"GncUmKwg"},{"id":"س-01692","fp":"7db200d874ba","stateId":358,"easy":"إذا لزمت الصمت إلا من خير ← يطرد عنك الشيطان ويعينك على دينك","cause":"عليكَ بالصَّمتِ إلَّا مِن خيرٍ","result":"فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ","explicit":true,"otherNeedIds":[19],"ref":"النوافح العطرة 227","srcLabel":"أحمد","text":["قُلِ الحقَّ وإن كان مُرًّا [يعني حديث: دخَلتُ علَى رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ وهو في المسجِدِ جالِسٌ، فاغتَنَمتُ خلوتَهُ، وحدَهُ، فجلَستُ إليهِ، فقالَ : أبا ذَرٍّ ! إن لِلمَسجِد تَحيَّةً، وإنَّ تحيَّتَهُ ركعتان فقُم فاركَعهما، قالَ : فقُمت فركَعتُها ثم عُدتُ فجلَستُ إليهِ، فقُلتُ : يا رسولَ اللهِ ! إنَّكَ أمَرتَني بالصَّلاةِ فما الصَّلاةُ ؟ قال : خيرٌ موضوعٌ استكثِرْ أو استَقِلَّ. قلتُ : يا رسولَ اللهِ ! فأيُّ الأعمالِ أفضَلُ ؟ قال : إيمانٌ باللَّهِ عزَّ وجلَّ، وجهادٌ في سبيلِهِ، قال : قلتُ : يا رسولَ اللهِ ! فأيُّ المؤمنينَ أكمَلُهم إيمانًا ؟ قالَ : أحسَنُهُم خُلُقًا. قالَ : قلتُ : يا رسولَ اللَّهِ ! فأيُّ المؤمنينَ أسلَمُ ؟ قالَ : مَن سلِمَ النَّاسُ من لسانِهِ ويدِهِ. قال : قلتُ : يا رسولَ اللَّهِ ! فأيُّ الهجرةِ أفضَلُ ؟ قال : مَن هجرَ السَّيِّئاتِ. قالَ : قُلتُ : يا رسولَ اللهِ ! فأيُّ الصَّلاةِ أفضَلُ ؟ قال : طولُ القنوتِ . قال : قلتُ : يا رسولَ اللهِ ! فما الصِّيامُ ؟ قالَ : فرضٌ مَجزيٌّ ، وعندَ اللهِ أضعافٌ كثيرةٌ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ الجهادِ أفضَلُ ؟ قالَ : مَن عُقِرَ جوادُهُ وأهريقَ دمُهُ. قال : قُلتُ : يا رسولَ اللهِ ! فأيُّ الرِّقابِ أفضَلُ ؟ قالَ : أغلاها ثَمنًا وأنفَسُها عندَ ربِّها. قالَ : قلتُ : يا رسولَ اللهِ ! فأيُّ الصَّدقةِ أفضَلُ ؟ قال : جُهدٌ مِن مُقِلٍّ يُسَرُّ إلى فقيرٍ. قال : قلتُ : يا رسولَ اللهِ ! فأيُّ آيةٍ مِمَّا أنزلَ اللهُ عزَّ وجلَّ عليكَ أعظَمُ ؟ قال : آيةُ الكُرسيِّ. ثُمَّ قالَ : يا أبا ذَرٍّ ! ما السَّماواتُ السَّبعُ معَ الكُرسيِّ إلا كَحلقَةٍ مُلقاةٍ بأرضِ فلاةٍ، وفَضلُ العَرشِ على الكُرسيِّ كفَضلِ الفَلاةِ علَى الحَلقَةِ. قلتُ : يا رسولَ اللهِ ! كم الأنبياءُ ؟ قال : مائةُ ألفٍ وأربعةٌ وعِشرونَ ألفًا. قلتُ : يا رسولَ اللهِ ! كم الرُّسلِ ؟ قالَ : ثلاثُمائةٍ وثلاثَةُ عشرَ جَمًّا غفيرًا. قلتُ : كثيرٌ طيِّبٌ، قلتُ : يا رسولَ اللهِ ! مَن كان أوَّلُهمْ ؟ قال : آدَمُ. قلتُ : يا رسولَ اللهِ ! أنَبيٌّ مُرسَلٌ ؟ قال : نعَم، خلقَهُ اللهُ بيدِهِ، ونفخَ فيهِ مِن روحِهِ، ثُمَّ سوَّاهُ قِبَلًا. وقال أحمدُ بنُ أنَسٍ ثُمَّ كلَّمهُ قِبَلًا. ثُمَّ قالَ : يا أبا ذَرٍّ ! أربعةٌ سُريانيُّونَ؛ آدَمُ، وشيثُ، وخَنوخُ - وهو إدريسُ، وهم أوَّلُ مَن خطَّ بالقلَمِ - ونوحٌ. وأربعةٌ من العَربِ؛ هودٌ، وصالِحٌ، وشُعَيبٌ، ونبيُّكَ يا أبا ذَرٍّ. قال : قلتُ : يا رسولَ اللهِ ! كَم كتابٌ أنزلَهُ اللَّهُ تعالى ؟ قال : مائةُ كتابٍ وأربعةُ كتُبٍ، أنزلَ علَى شيثَ خَمسونَ صحيفَةً، وأنزلَ علَى خَنوخَ ثلاثونَ صَحيفةً، وأنزلَ على إبراهيمَ عشرَ صحائفَ، وأنزلَ على موسَى قبلَ التَّوراةِ عَشرَ صحائفَ، وأنزلَ التَّوراةَ والإنجيلَ والزَّبورَ والفُرقانَ. قال : قلتُ : يا رسولَ اللهِ ! فَما كانَت صُحفُ إبراهيمَ ؟ قالَ : كانَت أمثالًا كلُّها : أيُّها الملِكُ المسلَّطُ المبتَلَى المغرورُ، فإنِّي لم أبعثْكَ لتجمَعَ الدُّنيا بعضَها إلى بعضٍ، ولكن بعثتُكَ لترُدَّ عنِّي دعوةَ المظلومِ، فإنِّي لا أردُّها ولَو كانَت مِن كافِرٍ. وكانَت فيها أمثالٌ : علَى العاقِلِ ما لَم يكُن مغلوبًا علَى عقلِهِ أن تكونَ له ساعاتٌ؛ ساعَةٌ يُناجي فيها ربَّهُ عزَّ وجلَّ، وساعةٌ يحاسِبُ فيها نفسَهُ، وساعَةٌ يفكِّرُ فيها في صُنعِ اللَّهِ عزَّ وجلَّ، وساعةٌ يخلو فيها بحاجتِهِ من المطعَمِ والمشرَبِ، وعلى العاقلِ أن لا يكون ظاعِنًا إلَّا لثلاثٍ؛ تزوُّدٍ لمعادٍ، أو مرمَّةٍ لمعاشٍ، أو لذَّةٍ في غيرِ محرَّمٍ، وعلى العاقِلِ أن يكونَ بصيرًا بزمانِهِ، مقبِلًا على شأنِهِ، حافِظًا للسانِهِ، ومن حسَبَ كلامَهُ من عمَلِهِ قلَّ كلامُهُ إلا فيما يعنيهِ. قلتُ : يا رسولَ اللَّهِ ! فما كان صحُفُ موسَى عليهِ السَّلامُ ؟ قال : كانَت عبرًا كلَّها، عجبتُ لمن أيقنَ بالموتِ ثُمَّ هو يفرَحُ، عجبتُ لمن أيقنَ بالنَّارِ وهو يضحَكُ، عجبتُ لمن أيقنَ للقدرِ ثم هو ينصَبُ، عجبتُ لمن رأى الدُّنيا وتقلُّبَها ثُمَّ اطمأنَّ إليها، عجِبتُ لمن أيقنَ بالحسابِ غدًا ثُمَّ لا يعمَلُ. قلتُ : يا رسولَ اللهِ ! أوصِني. قال : أوصيكَ بتقوى اللهِ فإنَّهُ رأسُ الأمرِ كلِّهِ، قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بتلاوَةِ القرآنِ فإنَّهُ نور لكَ في الأرضِ وذكرٌ لكَ في السَّماءِ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : إيَّاكَ وكثرةَ الضَّحِكِ فإنَّهُ يُميتُ القَلبَ، ويَذهَبُ بنورِ الوَجهِ، قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : ",["عليكَ بالصَّمتِ إلَّا مِن خيرٍ، ",1],["فإنَّهُ مطردَةٌ للشَّيطانِ عنكَ، وعونٌ لكَ علَى أمر دينِكَ",2],". قلتُ : يا رسولَ اللهِ ! زِدني. قال : عليكَ بالجهادِ فإنَّهُ رهبانيَّةُ أمَّتي. قلتُ : يا رسولَ اللهِ ! زِدني. قال : حبُّ المساكينِ وجالِسهُم. قلتُ : يا رسولَ اللَّهِ ! زِدني. قال : انظُر إلى مَن تحتَكَ ولا تنظُر إلى مَن فوقكَ فإنَّهُ أجدَرُ أن لا تَزدَري نِعمةَ اللهِ عندكَ. قلتُ : زِدني يا رسولَ اللهِ ! قال : صِلْ قرابَتَكَ وإن قَطعوكَ. قلتُ : يا رسولَ اللهِ ! زِدني. قال : لا تَخَف في اللَّهِ تعالى لَومَةَ لائمٍ. قلتُ : يا رسولَ اللهِ ! زِدني. قالَ : قُل الحقَّ وإن كان مُرًّا. قلتُ : يا رسولَ اللهِ ! زِدني. قال : يردُّكَ عن النَّاسِ ما تعرفُ من نفسِكَ، ولا تجِد عليهِم فيما تأتي، وكفَى به عيبًا أن تعرِفَ من النَّاسِ ما تجهَلُ من نفسِكَ، أو تجِدُ عليهِم فيما تأتي. ثُمَّ ضربَ بيدِهِ علَى صدري، فقالَ : يا أبا ذَرٍّ ! لا عقلَ كالتَّدبيرِ، ولا ورعَ كالكَفِّ، ولا حسَبَ كحُسنِ الخُلُقِ، قلتُ : يارسولَ اللهِ ! هل لي في الدُّنيا شَيءٌ مِمَّا أنزلَ اللهُ عليكَ مِمَّا كان في صحُفِ إبراهيمَ وموسَى ؟ قال : يا أبا ذَرٍّ ! اقرَأ : ? قَد أفلَحَ مَن تزَكَّى? إلى آخرِ السُّورَةِ]"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه مطولاً أحمد (21415)، والبزار (3966) باختلاف يسير، وابن حبان (361) واللفظ له","bab":"أقضية وأحكام › الترغيب في القضاء بالحق","dorar":"wZID7EAR"},{"id":"س-02529","fp":"af3cb4721479","stateId":358,"easy":"إذا لزمت الجماعة وتركت الفرقة ← فالشيطان مع الواحد وهو من الاثنين أبعد","cause":"عليكُم بالجماعَةِ و إيَّاكُم و الفُرقةِ","result":"فإنَّ الشَّيطانَ مع الواحدِ و هو مِن الاثنينِ أبعدُ","explicit":true,"otherNeedIds":[67],"ref":"تخريج كتاب السنة 88","srcLabel":"ابن أبي عاصم","text":[["عليكُم بالجماعَةِ و إيَّاكُم و الفُرقةِ ",1],["فإنَّ الشَّيطانَ مع الواحدِ و هو مِن الاثنينِ أبعدُ",2]," و مَن أراد بَحْبَحَةَ الجنَّةِ فعلَيهِ بالجمَاعةِ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح","bab":"إيمان › أعمال الجن والشياطين","dorar":"T4BgaEdg"},{"id":"س-03609","fp":"b92a5fc582c9","stateId":358,"easy":"إذا قلت «أعوذ بالله السميع العليم من الشيطان الرجيم» ← يخنس الشيطان عن قلبك","cause":"فإذا قال العبدُ : أعوذُ باللهِ السميعِ العليمِ من الشيطانِ الرجيمِ ، وأعوذُ باللهِ أن يحضرونِ ، إنَّ اللهَ هو السميعُ العليمُ","result":"خَنَس الخُرطومُ عن القلبِ","explicit":true,"apply":{"k":"say","t":"«أعوذ بالله السميع العليم من الشيطان الرجيم»"},"otherNeedIds":[4],"ref":"رفع البأس عن حديث النفس 40","srcLabel":"الديلمي","text":["إنَّ إبليسَ له خُرطومٌ كخرطومِ الكلبِ واضعهُ على قلبِ ابنِ آدمَ ، يذكِّرهُ بالشهواتِ واللذَّاتِ ، ويأتيهِ بالأمانيِّ ، ويأتيهِ بالوسوسةِ على قلبهِ ليشككَّهُ في ربهِ ، ",["فإذا قال العبدُ : أعوذُ باللهِ السميعِ العليمِ من الشيطانِ الرجيمِ ، وأعوذُ باللهِ أن يحضرونِ ، إنَّ اللهَ هو السميعُ العليمُ",1]," ، ",["خَنَس الخُرطومُ عن القلبِ",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الديلمي كما في ((كنز العمال)) (1266) واللفظ له.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"ELYWpiWy"},{"id":"س-04083","fp":"900da5237579","stateId":358,"easy":"إذا قرأت آية الكرسي ← تجيرك من الجن","cause":"آيةُ الكُرسِيِّ","result":"يجيرُ الإنسَ من الجنِّ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"similar":["س-01170"],"ref":"السلسلة الصحيحة 3245","srcLabel":"السلسلة الصحيحة","text":["صدقَ الخبيثُ . يعني : الجنِّيُّ في قولهِ : ",["يجيرُ الإنسَ من الجنِّ",2]," ",["آيةُ  الكُرسِيِّ",1]],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح","bab":"جن › صفة إبليس وجنوده","dorar":"kRMKf0Lx"},{"id":"س-03625","fp":"81a706608d0f","stateId":358,"easy":"إذا قلت «بسم الله» ← يتصاغر الشيطان حتى يصير كالذباب","cause":"وإذا قُلْتَ: بسمِ اللهِ","result":"تصاغَرَ حتى يصيرَ مِثْلَ الذُّبابِ","explicit":true,"apply":{"k":"say","t":"«بسم الله»"},"repOf":"س-07542","ref":"تخريج مشكل الآثار 369","text":["عثَر حِمارٌ فقال: تَعِس الشَّيطانُ، فقال: لا تَقُلْ تَعِس الشَّيطانُ، ولكنْ قُلْ: بسمِ اللهِ، فإنَّكَ إذا قُلْتَ: تَعِس الشَّيطانُ يَعظُمُ حتى يكونَ مِثْلَ الجَبَلِ، فيقولُ: بقُوَّتي صرَعْتُهُ، ",["وإذا قُلْتَ: بسمِ اللهِ",1],"، ",["تصاغَرَ حتى يصيرَ مِثْلَ الذُّبابِ",2],"."],"grade":"حسن","muhaddith":"رجاله ثقات","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"KpMn8905"},{"id":"س-04099","fp":"5c349a499ef6","stateId":358,"easy":"إذا كنت مؤمناً (ذاكراً مطيعاً) ← تُنهك شياطينك وتضعفها","cause":"المؤمنَ","result":"ليُنضي شياطينَه","explicit":true,"ref":"السلسلة الصحيحة 3586","srcLabel":"أحمد","text":["إنَّ ",["المؤمنَ",1]," ",["ليُنضي شياطينَه",2]," ؛ كما يُنضي أحدُكم بعيرَه في السَّفرِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (8940) واللفظ له، وابن أبي الدنيا في ((مكائد الشيطان)) (20)، وأبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (7/382) باختلاف يسير","bab":"جن › صفة إبليس وجنوده","dorar":"ko46JXsU"},{"id":"س-01170","fp":"c5ef51a835ad","stateId":358,"easy":"إذا قرأت آية الكرسي ← تُجار من الجن","cause":"هذه الآيةُ آيةُ الكُرْسِيِّ","result":"فما الَّذي يُجيرُنا مِنكم","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)","واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-04083","ref":"الأحاديث المختارة 1262","text":["«كانَ له جُرْنٌ فيه تَمْرٌ، قالَ: فكانَ أُبَيٌّ يَتَعاهَدُه فوَجَدَه يَنقُصُ، فحَرَسَه ذاتَ لَيْلةٍ فإذا هو بِدابَّةٍ شِبْهِ الغُلامِ المُحْتلِمِ، قالَ: فسَلَّمْتُ فرَدَّ السَّلامَ، قالَ: فقُلْتُ: ما أنت؟ أَجِنِّيٌّ أم إنْسِيٌّ؟ قالَ: جِنِّيٌّ، قالَ: ناوِلْني يَدَك، قالَ: فناوَلَ فإذا يَدُ كَلْبٍ وشَعَرُ كَلْبٍ، فقُلْتُ: هكذا خَلْقُ الجِنِّ، قالَ: لقد عَلِمَتِ الجِنُّ ما فيهم أَشَدُّ مِنِّي، قالَ: ما حَمَلَك على ما صَنَعْتَ؟ قالَ: بَلَغَني أنَّك رَجُلٌ تُحِبُّ الصَّدَقةَ فأَحْبَبْنا أن نُصيبَ مِن طَعامِك، قالَ: فقالَ له أُبَيٌّ: ",["فما الَّذي يُجيرُنا مِنكم",2],"؟ قالَ: ",["هذه الآيةُ آيةُ الكُرْسِيِّ",1],"، ثُمَّ غَدا إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فأَخبَرَه، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: صَدَقَ الخَبيثُ»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"72jbg9d2","merged":2,"otherRefs":["صحيح ابن حبان 784 (صحيح)"]},{"id":"س-00891","fp":"d22f01341897","stateId":358,"easy":"إذا ذكرت الله ← تحرز نفسك من الشيطان","cause":"إلَّا بذِكْرِ اللهِ","result":"كذلك العبدُ لا يُحرِزُ نفسَه مِن الشَّيطانِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-02525","ref":"سنن الترمذي 2863","text":["إنَّ اللَّهَ أمرَ يحيى بنَ زَكَريَّا بخمسِ كلماتٍ أن يعملَ بِها ، ويأمرَ بني إسرائيل أن يعمَلوا بِها ، وإنَّهُ كادَ أن يُبْطِئَ بِها فقال عيسى: إنَّ اللهَ أمَرَك بخَمسِ كلماتٍ؛ لِتَعمَلَ بها وتَأمُرَ بَني إسرائيلَ أن يَعمَلوا بها، فإمَّا أن تَأمُرَهم، وإمَّا أنْ آمُرَهم، فقال يحيى: أخشى إن سبَقتَني بها أن يُخسَفَ بي أو أُعذَّبَ، فجمَع النَّاسَ في بيتِ المقدِسِ، فامتَلَأ المسجدُ وقعَدوا على الشُّرُفِ، فقال: \"إنَّ اللهَ أمَرني بخَمسِ كلماتٍ أن أَعمَلَ بِهنَّ، وآمرُكم أن تَعمَلوا بهنَّ: أوَّلُهنَّ أن تَعبُدوا اللهَ ولا تُشرِكوا به شيئًا، وإنَّ مَثلَ مَن أشرَك باللهِ كمثَلِ رجلٍ اشترى عبدًا مِن خالصِ مالِه بذهَبٍ أو ورِقٍ، فقال: هذه داري وهذا عمَلي، فاعمَلْ وأدِّ إليَّ، فكان يعمَلُ ويُؤدِّي إلى غيرِ سيِّدِه، فأيُّكم يَرضى أن يكونَ عبدُه كذلك؟! وإنَّ الله أمركم بالصَّلاة، فإذا صَلَّيتُم فلا تَلتَفِتوا؛ فإنَّ اللهَ يَنصُبُ وجهَه لوجهِ عبدِه في صلاتِه ما لم يَلتفِتْ، وآمرُكم بالصِّيامِ؛ فإنَّ مَثلَ ذلك كمثَلِ رجلٍ في عِصابةٍ معَه صُرَّةٌ فيها مِسكٌ، فكلَّهم يَعجَبُ أو يُعجِبُه ريحُها، وإنَّ ريحَ الصَّائمِ أطيبُ عندَ اللهِ مِن ريحِ المسكِ، وآمرُكم بالصَّدقةِ؛ فإنَّ مثَلَ ذلك كمثَلِ رجلٍ أسَره العدوُّ، فأوثَقوا يدَه إلى عنُقِه، وقدَّموه لِيَضرِبوا عُنقَه، فقال: أنا أَفْديه منكم بالقليلِ والكثيرِ، ففدَى نفسَه منهم، وآمُركم أن تَذكُروا اللهَ؛ فإنَّ مَثلَ ذلك كمَثلِ رجلٍ خرَج العدوُّ في أثَرِه سِراعًا حتَّى إذا أتى على حِصنٍ حَصينٍ، فأحرَز نفسَه منهم، ",["كذلك العبدُ لا يُحرِزُ نفسَه مِن الشَّيطانِ",2]," ",["إلَّا بذِكْرِ اللهِ",1],"\". قال النَّبيُّ صلَّى اللهُ علَيه وسلَّم: وأَنا آمرُكُم بخَمسٍ اللَّهُ أمرَني بِهِنَّ، السَّمعُ والطَّاعةُ والجِهادُ والهجرةُ والجمَاعةُ، فإنَّهُ مَن فارقَ الجماعةَ قيدَ شبرٍ فقد خلَعَ رِبقةَ الإسلامِ من عُنقِهِ إلَّا أن يراجِعَ، ومن ادَّعى دَعوى الجاهليَّةِ فإنَّهُ من جُثى جَهَنَّم، فقالَ رجلٌ: يا رسولَ اللَّهِ وإن صلَّى وصامَ؟ فقالَ: وإن صلَّى وصامَ، فادعوا بدَعوى اللَّهِ الَّذي سمَّاكمُ المسلِمينَ المؤمنينَ، عبادَ اللَّهِ"],"grade":"صحيح","narrator":"الحارث بن الحارث الأشعري","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه أحمد (17170)، وابن خزيمة (930) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"p7zymDIJ","merged":2,"otherRefs":["تخريج صحيح ابن حبان 6233 (صحيح)"]},{"id":"س-03588","fp":"1191fe170ccc","stateId":358,"easy":"إذا لزمت الجماعة والمسجد ← تسلم من الشيطان، فإنما يأكل الذئب القاصية","cause":"فإيَّاكم والشِّعابَ، وعليكم بالجَماعةِ والعامَّةِ والمسجدِ","result":"إنَّ الشَّيطانَ ذِئبُ الإنسانِ كذِئبِ الغَنمِ، يَأخُذُ الشَّاةَ القاصيةَ والنَّاحيةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج المسند لشعيب 22029","srcLabel":"أحمد","text":[["إنَّ الشَّيطانَ ذِئبُ الإنسانِ كذِئبِ الغَنمِ، يَأخُذُ الشَّاةَ القاصيةَ والنَّاحيةَ",2],"، ",["فإيَّاكم والشِّعابَ، وعليكم بالجَماعةِ والعامَّةِ والمسجدِ",1],"."],"grade":"حسن","narrator":"معاذ بن جبل","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (22029) واللفظ له، وعبد بن حميد (114)، والحارث في ((المسند)) (606)","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"5K6xJzxo"},{"id":"س-04687","fp":"3e00486524e4","stateId":359,"easy":"إذا حلمت حلماً تكرهه فانفث عن يسارك ثلاثاً وتعوذ ← لن يضرك","cause":"فإذا حَلَمَ أحَدُكُم حُلمًا يَكرَهُه فليَنفُثْ عن يَسارِه ثَلاثًا، وليَتَعَوَّذْ باللهِ مِن شَرِّها","result":"فإنَّها لَن تَضُرَّه","explicit":true,"star":true,"otherNeedIds":[6],"ref":"صحيح مسلم 2261","srcLabel":"متفق عليه","text":["الرُّؤيا مِنَ اللهِ، والحُلمُ مِنَ الشَّيطانِ، ",["فإذا حَلَمَ أحَدُكُم حُلمًا يَكرَهُه فليَنفُثْ عن يَسارِه ثَلاثًا، وليَتَعَوَّذْ باللهِ مِن شَرِّها",1],"؛ ",["فإنَّها لَن تَضُرَّه",2],". وفي روايةٍ: عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِثلَه، ولَم يَذكُرْ في حَديثِهم قَولَ أبي سَلَمةَ: كُنتُ أرى الرُّؤيا أُعرى مِنها، غيرَ أنِّي لا أُزَمَّلُ. وفي روايةٍ: بهذا الإسنادِ، وليسَ في حَديثِهما: أُعرى مِنها. وزادَ في حَديثِ يونُسَ: فليَبصُقْ على يَسارِه، حينَ يَهُبُّ مِن نَومِه، ثَلاثَ مَرَّاتٍ."],"grade":"صحيح","narrator":"أبو قتادة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3292 )، ومسلم (2261)","bab":"رؤيا › الرؤيا من الله","dorar":"ylh5nz74","merged":12,"otherRefs":["صحيح ابن ماجه 3172 (صحيح)","صحيح الجامع 554 (صحيح)","مجمع الزوائد 7/178 (حسن)","تخريج صحيح ابن حبان 6060 (صحيح)","تخريج صحيح ابن حبان 6059 (صحيح)","شرح السنة 6/294 (صحيح)","مجموع فتاوى ابن باز 270/21 (صحيح)","صحيح البخاري 5747 (صحيح)","تخريج المسند لشعيب 22598 (صحيح)","صحيح مسلم 2261 (صحيح)","زاد المعاد 2/419 (صحيح)"]},{"id":"س-04691","fp":"a8207b093b51","stateId":359,"easy":"إذا رأيت ما تكره فتعوذ بالله من شرها وشر الشيطان واتفل ← لن تضرك","cause":"وإذا رَأى ما يَكرَهُ فليَتَعَوَّذْ باللهِ مِن شَرِّها، ومِن شَرِّ الشَّيطانِ، وليَتفِلْ ثَلاثًا، ولا يُحَدِّثْ بها أحَدًا","result":"فإنَّها لَن تَضُرَّه","explicit":true,"star":true,"ref":"صحيح البخاري 7044","srcLabel":"متفق عليه","text":["سَمِعتُ أبا سَلَمةَ يقولُ: لقد كُنتُ أرى الرُّؤيا فتُمرِضُني، حتَّى سَمِعتُ أبا قَتادةَ يقولُ: وأنا كُنتُ لَأرى الرُّؤيا تُمرِضُني، حتَّى سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: الرُّؤيا الحَسَنةُ مِنَ اللهِ، فإذا رَأى أحَدُكُم ما يُحِبُّ فلا يُحَدِّثْ به إلَّا مَن يُحِبُّ، ",["وإذا رَأى ما يَكرَهُ فليَتَعَوَّذْ باللهِ مِن شَرِّها، ومِن شَرِّ الشَّيطانِ، وليَتفِلْ ثَلاثًا، ولا يُحَدِّثْ بها أحَدًا؛ ",1],["فإنَّها لَن تَضُرَّه",2],"."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7044)، ومسلم (2261)","bab":"رؤيا › على من يقص الرؤيا","dorar":"3xL5X8cr","merged":2,"otherRefs":["صحيح مسلم 2261 (صحيح)"]},{"id":"س-04686","fp":"d0f5ae06a246","stateId":359,"easy":"إذا رأيت ما تكره فانفث عن شمالك ثلاثاً وتعوذ بالله ← لا تضرك","cause":"فمَن رَأى شيئًا يَكرَهُه فليَنفِثْ عن شِمالِه ثَلاثًا، وليَتَعَوَّذْ مِنَ الشَّيطانِ","result":"فإنَّها لا تَضُرُّه، وإنَّ الشَّيطانَ لا يَتَراءى بي","explicit":true,"star":true,"ref":"صحيح البخاري 6995","srcLabel":"متفق عليه","text":["الرُّؤيا الصَّالِحةُ مِنَ اللهِ، والحُلمُ مِنَ الشَّيطانِ، ",["فمَن رَأى شيئًا يَكرَهُه فليَنفِثْ عن شِمالِه ثَلاثًا، وليَتَعَوَّذْ مِنَ الشَّيطانِ؛ ",1],["فإنَّها لا تَضُرُّه، وإنَّ الشَّيطانَ لا يَتَراءى بي",2],"."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6995 )، ومسلم (2261) بنحوه","bab":"رؤيا › الرؤيا من الله","dorar":"UjhC7SOu"},{"id":"س-04680","fp":"1f43aeae6758","stateId":359,"easy":"إذا حدّثت برؤياك ← وقعت كما عُبّرت","cause":"فإذا حَدَّث بها","result":"وقعتْ","explicit":true,"ref":"هداية الرواة 4545","srcLabel":"أبو داود","text":["رؤيا المؤمنِ جزءٌ مِنْ سِتَّةٍ وأربعينَ جُزءًا مِنَ النُّبوَّةِ ؛ وهي على رِجْلِ طائرٍ ؛ ما لم يُحَدِّثْ بها ",["فإذا حَدَّث بها",1]," ",["وقعتْ",2]," - وأحسَبُه قال - ؛ لا يُحَدِّثُ إلا حبيبًا ، أو لبيبًا . وفي روايةٍ : الرؤيا على رِجْلِ طائرٍ ؛ مالم تُعَبَّرْ ، فإذا عُبِّرَتْ وقعت - أحسَبُه قال - ؛ ولا تَقُصُّها إلا على وادٍّ ، أو ذي رأيٍ ."],"grade":"صحيح","narrator":"أبو رزين العقيلي لقيط بن عامر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5020) مختصراً، والترمذي (2278)، وابن ماجه (3914)، وأحمد (16227) باختلاف يسير.","bab":"رؤيا › الرؤيا الصالحة من النبوة","dorar":"jzohMlI5","merged":5,"otherRefs":["صحيح ابن حبان 6055 (صحيح)","تخريج المسند لشعيب 16183 (حسن)","صحيح الجامع 3456 (صحيح)","أحكام القرآن لابن العربي 3/56 (صحيح)"]},{"id":"س-04682","fp":"99b20b5b8ad7","stateId":359,"easy":"إذا رأيت ما تكره فانفث عن يسارك ثلاثاً واسكت ← فهي من الشيطان ليحزنك ولا تضرك","cause":"فلْيَنفُثْ عن يَسارِه ثلاثًا، ولْيَسكُتْ ولا يُخبِرْ بها أحدًا","result":"ومَن رَأى سِوى ذلك، فإنَّما هو مِن الشَّيطانِ لِيُحزِنَه","explicit":true,"otherNeedIds":[6],"ref":"تخريج المسند لشعيب 7044","srcLabel":"أحمد","text":["عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أنَّه قال: {لَهُمُ الْبُشْرَى فِي الْحَيَاةِ الدُّنْيَا} [يونس: 64]، قال: الرُّؤيا الصَّالحةُ، يُبشَّرُها المؤمنُ، هي جُزءٌ مِن تِسعةٍ وأربعينَ جُزءًا مِن النُّبوَّةِ، فمَن رَأى ذلك، فلْيُخبِرْ بها، ",["ومَن رَأى سِوى ذلك، فإنَّما هو مِن الشَّيطانِ لِيُحزِنَه",2],"؛ ",["فلْيَنفُثْ عن يَسارِه ثلاثًا، ولْيَسكُتْ ولا يُخبِرْ بها أحدًا",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (7044) واللفظ له، والبيهقي في ((شعب الإيمان)) (4764)","bab":"رؤيا › الرؤيا الصالحة من النبوة","dorar":"3V0Mtajx","merged":3,"otherRefs":["تخريج المسند لشعيب 6215 (صحيح)","المستدرك على الصحيحين 8393 (صحيح)"]},{"id":"س-04690","fp":"72029c923814","stateId":359,"easy":"إذا رأيت رؤيا قبيحة ← فلا تفسرها ولا تخبر بها","cause":"فلا يُفَسِرْها و لا يُخبرُ بها","result":"و إذا رأى الرؤيا القبيحةَ","explicit":true,"ref":"صحيح الجامع 548","srcLabel":"ابن المقرئ","text":["إذا رأى أحدُكم الرؤيا الحسنةَ فلْيُفسرْها ، و لْيُخبرْ بها ، ",["و إذا رأى الرؤيا القبيحةَ",2]," ، ",["فلا يُفَسِرْها و لا يُخبرُ بها",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن المقرئ في ((المعجم)) (866)","bab":"رؤيا › تأويل الرؤيا","dorar":"XJ9Jye9f","merged":2,"otherRefs":["السلسلة الصحيحة 1340 (صحيح)"]},{"id":"س-04681","fp":"bab09c480354","stateId":359,"easy":"إذا رأيت رؤيا فلا تحدّث بها إلا ناصحاً أو عالماً ← فالرؤيا تقع على ما تُعبّر","cause":"فلا يُحَدِّثْ بِها إلا ناصِحًا أو عالِمًا","result":"إنَّ الرُّؤْيا تَقَعُ على ما تُعَبَّرُ","explicit":true,"ref":"صحيح الجامع 1612","srcLabel":"ابن ماجه","text":[["إنَّ الرُّؤْيا تَقَعُ على ما تُعَبَّرُ",2]," ، و مَثلُ ذلِكَ مَثلُ رجلٍ رفعَ رِجليْهِ فهو يَنتظِرُ متَى يَضعُها ، فإذا رأَى أحدُكمْ رُؤْيا ",["فلا يُحَدِّثْ بِها إلا ناصِحًا أو عالِمًا",1]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (8177). وقوله: \"الرؤيا تقع على ما تعبر\" أخرجه ابن ماجه (3915) بلفظ: \"والرؤيا لأول عابر\"","bab":"رؤيا › الرؤيا الصالحة من النبوة","dorar":"EFoi9yLN"},{"id":"س-04685","fp":"741b4317626f","stateId":359,"easy":"إذا رأيت رؤيا تكرهها فلا تحدّث بها وقم فصلّ ← لا تضرك","cause":"فلا يحدِّثْ بِها أحدًا وليقُمْ فليصلِّ","result":"فإذا رأى أحدُكم رؤيا يَكرَهُها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الترمذي 2291","srcLabel":"متفق عليه","text":["في آخرِ الزَّمانِ لا تَكادُ رؤيا المؤمنِ تَكذِبُ وأصدقُهم رؤيا أصدقُهم حديثًا، والرُّؤيا ثلاثٌ، الحسَنةُ بشرى منَ اللَّهِ، والرُّؤيا يحدِّثُ الرَّجلُ بِها نفسَه، والرُّؤيا تحزينٌ منَ الشَّيطانِ، ",["فإذا رأى أحدُكم رؤيا يَكرَهُها",2]," ",["فلا يحدِّثْ بِها أحدًا وليقُمْ فليصلِّ",1]," قالَ أبو هريرةَ: يعجِبُني القيدُ وأَكرَهُ الغَلَّ القيدُ: ثباتٌ في الدِّينِ قال: وقالَ النَّبيُّ صلَّى اللَّهُ عليْهِ وسلَّم: رُؤيا المؤمنِ جزءٌ من ستَّةٍ وأربعينَ جزءًا منَ النُّبوَّةِ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه البخاري (7017)، ومسلم (2263)، وأبو داود (5019)، والترمذي (2291) واللفظ له، وأحمد (10590)","bab":"رؤيا › الرؤيا الصالحة من النبوة","dorar":"IKbSpIVA","merged":4,"otherRefs":["علل الدارقطني 1833 (صحيح)","السلسلة الصحيحة 1341 (صحيح)","سنن الترمذي 2280 (صحيح)"]},{"id":"س-04688","fp":"6c0a75b36fbd","stateId":359,"easy":"إذا عبرت لمسلم رؤيا فعبّرها على الخير ← فالرؤيا تقع على ما تُعبّر","cause":"إذا عَبَرْتم للمُسلِمِ الرُّؤْيا، فاعْبُروها على الخَيرِ","result":"فإنَّ الرُّؤْيا تكونُ على ما يَعبُرُها صاحِبُها","explicit":true,"ref":"تخريج زاد المعاد 2/419","srcLabel":"الدارمي","text":["كانتِ امرأةٌ من أهلِ المَدينةِ لها زَوجٌ تاجرٌ يَختلِفُ -يَعني في التجارةِ- فأتَتْ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، قالت: إنَّ زَوْجي غائبٌ، وتَرَكَني حاملًا، فرأيْتُ في المنامِ أنَّ ساريةَ بَيْتي انكَسَرَت، وأنِّي وَلدْتُ غُلامًا أعْوَرَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: خَيرٌ، يَرجِعُ زَوجُكِ إنْ شاء اللهُ تعالى صالِحًا، وتَلِدينَ غُلامًا برًّا، فذكَرَت ذلك ثلاثًا، فجاءت ورسولُ اللهِ غائبٌ، فسألْتُها، فأخبَرَتْني بالمنامِ، فقُلْتُ: لئن صدَقَتْ رُؤْياكِ لَيَموتَنَّ زَوْجُكِ، وتَلِدينَ غُلامًا فاجرًا، فقَعَدَتْ تَبْكي، فجاء رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَهْ يا عائشةُ، ",["إذا عَبَرْتم للمُسلِمِ الرُّؤْيا، فاعْبُروها على الخَيرِ",1],"، ",["فإنَّ الرُّؤْيا تكونُ على ما يَعبُرُها صاحِبُها",2],"."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه الدارمي (2163) باختلاف يسير","bab":"رؤيا › تأويل الرؤيا","dorar":"hK7FkzhH"},{"id":"س-03197","fp":"eefbc9a4f252","stateId":359,"easy":"إذا رأيت رؤيا فلا تخبر بها إلا من تحب ← فهي على رجل طائر ما لم تُخبر بها","cause":"ما لم يُخبِرْ بها","result":"على رِجْلِ طائِرٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[6],"ref":"تخريج المسند لشعيب 16191","srcLabel":"أبو داود","text":["رُؤيا المُؤمِنِ جُزءٌ مِن أربعين جُزءًا مِنَ النُّبوَّةِ -أشُكُّ أنَّهُ زادَ: رُؤيا المُؤمِنِ ",["على رِجْلِ طائِرٍ",2]," ",["ما لم يُخبِرْ بها",1],"، فإذا أخبَرَ بها وقَعَتْ."],"grade":"حسن","narrator":"عم أبو رزين العقيلي لقيط بن عامر","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود (5020)، والترمذي (2278)، وابن ماجه (3914)، وأحمد (16191) واللفظ له","bab":"إيمان › فضل الإيمان","dorar":"k4KsEkUN"}]}