{"schema":1,"kind":"sunan-chunk","version":"sunan-50a61695a4db","needId":31,"stateIds":[276,277],"items":[{"id":"س-07470","fp":"c443e13f5951","stateId":276,"easy":"إذا أدركت الدجال فأتِ النهر الذي تراه ناراً ← فإنه ماء بارد","cause":"فلْيَأتِ النَّهَرَ الذي يَراهُ نارًا","result":"فإنَّه ماءٌ باردٌ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 23439","srcLabel":"مسلم","text":["لَأنا أعلَمُ بما مع الدَّجَّالِ مِن الدَّجَّالِ، معه نَهَرانِ يَجْريانِ: أحَدُهما رَأيَ العينِ ماءٌ أبيَضُ، والآخَرُ رأيَ العَينِ نارٌ تأجَّجُ، فإمَّا أدرَكَنَّ أحَدًا منكم ",["فلْيَأتِ النَّهَرَ الذي يَراهُ نارًا",1],"، ولْيُغمِضْ ثم لِيُطَأطِئْ رَأسَه فلْيَشرَبْ؛ ",["فإنَّه ماءٌ باردٌ",2],"، وإنَّ الدَّجَّال مَمْسوحُ العَيْنِ اليُسْرى، عليها ظَفَرةٌ غَليظةٌ، وفيه مَكتوبٌ بيْنَ عَيْنَيهِ: كافِرٌ، يَقرَؤُه كُلُّ مُؤمِنٍ؛ كاتِبٍ وغَيرِ كاتِبٍ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2934)، وأحمد (23439) واللفظ له","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"KIEf4ipW","merged":3,"otherRefs":["الضياء اللامع 57 (صحيح)","صحيح مسلم 2935 (صحيح)"]},{"id":"س-07302","fp":"5d39a49d77e5","stateId":276,"easy":"إذا نجوت من فتنة موت النبي ﷺ وقتل الخليفة والدجال ← فقد نجوت","cause":"مَوْتي، ومِن قَتْلِ خَليفةٍ مُصْطَبِرٍ بالحَقِّ يُعطيه، والدَّجَّالِ","result":"مَن نَجا مِن ثَلاثٍ فقدْ نَجا","explicit":true,"star":true,"ref":"الأحاديث المختارة 9 / 280","srcLabel":"متفق عليه","text":["«",["مَن نَجا مِن ثَلاثٍ فقدْ نَجا",2],"، مَن نَجا مِن ثَلاثٍ فقدْ نَجا، فقالوا: يا رَسولَ اللهِ مَهْ؟ قالَ: ",["مَوْتي، ومِن قَتْلِ خَليفةٍ مُصْطَبِرٍ بالحَقِّ يُعطيه، والدَّجَّالِ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن حوالة الأزدي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فتن › ظهور الفتن","dorar":"5UhBHNEq"},{"id":"س-07316","fp":"8e15c8270533","stateId":276,"easy":"إذا قرأت سورة الكهف يوم الجمعة ← تُعصم ثمانية أيام من كل فتنة","cause":"مَن قَرَأَ سورةَ الكَهْفِ يَوْمَ الجُمُعةِ","result":"فهو مَعْصومٌ إلى ثَمانِيةِ أيَّامٍ مِن كلِّ فِتْنةٍ تكونُ، فإن خَرَجَ الدَّجَّالُ عُصِمَ مِنه","explicit":true,"star":true,"apply":{"k":"time","t":"يوم الجمعة"},"similar":["س-07309"],"ref":"الأحاديث المختارة 429","srcLabel":"البخاري","text":["«",["مَن قَرَأَ سورةَ الكَهْفِ يَوْمَ الجُمُعةِ ",1],["فهو مَعْصومٌ إلى ثَمانِيةِ أيَّامٍ مِن كلِّ فِتْنةٍ تكونُ، فإن خَرَجَ الدَّجَّالُ عُصِمَ مِنه»",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فتن › فتنة الدجال","dorar":"uQAaTRIt"},{"id":"س-01568","fp":"a0adf32fa600","stateId":276,"easy":"إذا ابتُليت بنار الدجال فأغمض عينيك واستغث بالله ← تكون عليك برداً وسلاماً","cause":"فمَن ابتُلِيَ بنارِه فلْيُغمِضْ عَيْنَيه، ولْيَستَغِثْ باللهِ","result":"تكونُ عليه بَرْدًا وسلامًا كما كانت النَّارُ بَرْدًا وسلامًا على إبراهيمَ عليه السَّلامُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8845","srcLabel":"مسلم","text":["خطَبَنا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يومًا، فكان أكثَرُ خُطبتِه ذِكرَ الدَّجَّالِ، يُحدِّثُنا عنه حتَّى فرَغَ مِن خُطْبتِه، فكان فيما قال لنا يومئذٍ: إنَّ اللهَ تعالَى لم يَبعَثْ نبيًّا إلَّا حذَّرَ أُمَّتَه الدَّجَّالَ، وإنِّي آخِرُ الأنبياءِ وأنتُم آخِرُ الأُمَمِ، وهو خارجٌ فيكم لا مَحالةَ، فإنْ يَخرُجْ وأنا بيْن أظْهُرِكم فأنا حَجيجُ كلِّ مُسْلمٍ، وإنْ يَخرُجْ فيكم بعْدي فكلُّ امرئٍ حَجيجُ نفْسِه، واللهُ خَلِيفتي على كلِّ مُسْلمٍ، إنَّه يَخرُجُ مِن خَلَّةٍ بيْن العراقِ والشَّامِ، فعاث يَمينًا وعاث شِمالًا، يا عِبادَ اللهِ فاثْبُتوا؛ فإنَّه يَبدَأُ فيَقولُ: أنا نبيٌّ ولا نَبيَّ بعْدي، ثمَّ يُثَنِّي حتَّى يَقولَ: أنا ربُّكم، وإنَّكم لم تَرَوا ربَّكم حتَّى تَموتوا، وإنَّه مَكتوبٌ بيْن عَيْنَيه: كافرٌ، يَقرَؤُه كلُّ مُؤمنٍ، فمَن لَقِيَه منكم فلْيَتفُلْ في وَجْهِه، ولْيَقرَأْ فواتحَ سُورةِ أصحابِ الكهفِ، وإنَّه يُسلَّطُ على نفْسٍ مِن بَني آدَمَ فيَقتُلُها، ثمَّ يُحْيِيها، وإنَّه لا يَعْدو ذلكَ، ولا يُسلَّطُ على نفْسِ غيرِها. وإنَّ مِن فِتنتِه أنَّ معه جنَّةً ونارًا؛ فنارُه جنَّةٌ، وجنَّتُه نارٌ، ",["فمَن ابتُلِيَ بنارِه فلْيُغمِضْ عَيْنَيه، ولْيَستَغِثْ باللهِ",1],"؛ ",["تكونُ عليه بَرْدًا وسلامًا كما كانت النَّارُ بَرْدًا وسلامًا على إبراهيمَ عليه السَّلامُ",2],"، وإنَّ مِن فِتنتِه أنْ يَمُرَّ على الحيِّ فيُؤمِنون به ويُصدِّقونه، فيَدْعو لهم فتُمطِرُ السَّماءُ عليهم مِن يَومِهم، وتُخصِبُ لهم الأرضُ مِن يومِها، وتَروحُ عليهم ماشيِتُهم مِن يومِها أعظَمَ ما كانت وأسْمَنَه، وأمَدَّه خَواصِرَ، وأدَرَّه ضُروعًا، ويَمُرُّ على الحيِّ فيَكفُرون به ويُكذِّبونه، فيَدْعو عليهم فلا يُصبِحُ لهم سارحٌ يَسْرَحُ. وإنَّ أيَّامَه أرْبَعون؛ فيومٌ كسَنةٍ، ويومٌ كشَهرٍ، ويومٌ كجُمعةٍ، ويومُ كالأيَّامِ، وآخِرُ أيَّامِه كالسَّرابِ، تَقْدُرون الأيَّامَ الطِّوالَ ثمَّ تُصَلُّون، يُصبِحُ الرَّجلُ عِندَ بابِ المدينةِ، فيُمْسي قبْلَ أنْ يَبلُغَ بابَها الآخَرَ، قالوا: كيْف نُصلِّي يا رَسولَ اللهِ في تلكَ الأيَّامِ القِصارِ؟ قال: تَقْدُرون فيها ثمَّ تُصَلُّونَ."],"grade":"صحيح","narrator":"أبو  أمامة الباهلي","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه بهذه السياقة","takhrij":"أخرجه ابن ماجه (4077)، والطبراني (8/ 146) (7644) باختلاف يسير.","bab":"أشراط الساعة › صفة الدجال","dorar":"BHzNEMY8"},{"id":"س-05334","fp":"053e0b176096","stateId":276,"easy":"إذا قلت للدجال «لست ربنا، ربنا الله عليه توكلنا...» ← لا يكون له عليك سلطان","cause":"مَن قالَ: لسْتَ رَبَّنا، لكِنَّ رَبَّنا اللهُ، عليه تَوَكَّلْنا وإليه أَنَبْنا، نَعوذُ باللهِ مِن شَرِّك","result":"لم يكن له عليه سُلْطانٌ","explicit":true,"apply":{"k":"say","t":"«لست ربنا، ربنا الله عليه توكلنا...»"},"ref":"الصحيح المسند 1474","srcLabel":"السنة","text":["رأيْتُ رَجُلًا بالمَدينةِ وقد طافَ النَّاسُ به وهو يقولُ: قالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، قالَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فإذا رَجُلٌ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، قالَ: فسَمِعْتُه وهو يقولُ: «إنَّ مِن بَعْدِكم الكَذَّابَ المُضِلَّ، وإنَّ رأسَه مِن بَعْدِه حُبُكٌ حُبُكٌ حُبُكٌ -ثَلاثَ مَرَّاتٍ- وإنَّه سيَقولُ: أنا رَبُّكم، ف",["مَن قالَ: لسْتَ رَبَّنا، لكِنَّ رَبَّنا اللهُ، عليه تَوَكَّلْنا وإليه أَنَبْنا، نَعوذُ باللهِ مِن شَرِّك",1],"؛ ",["لم يكن له عليه سُلْطانٌ",2],"»."],"grade":"صحيح","narrator":"رجل","muhaddith":"صحيح","bab":"رقائق وزهد › التوكل واليقين","dorar":"nxX9Uwvs","merged":2,"otherRefs":["تخريج المسند لشعيب 23487 (صحيح)"]},{"id":"س-07309","fp":"8655f6766b53","stateId":276,"easy":"إذا قرأت عشر آيات من سورة الكهف ← تُعصم من فتنة الدجال","cause":"مَن قرَأ عَشْرَ آياتٍ مِن سورةِ الكهفِ","result":"عُصِم مِن فتنةِ الدَّجَّالِ","explicit":true,"repOf":"س-07316","ref":"المنار المنيف 90","text":["حديث  العشرِ آياتٍ من أولِ سورةِ الكهفِ من قرأها عصم من فتنةِ الدجالِ [يعني حديث: ",["مَن قرَأ عَشْرَ آياتٍ مِن سورةِ الكهفِ ",1],["عُصِم مِن فتنةِ الدَّجَّالِ",2],"]"],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"صحيح","bab":"فتن › فتنة الدجال","dorar":"PGpOahVj","merged":2,"otherRefs":["كشف الخفاء 2/565 (صحيح)"]},{"id":"س-07294","fp":"0695bcb31c8a","stateId":276,"easy":"إذا قرأت سورة الكهف كما أُنزلت ثم خرج الدجال ← لا يُسلّط عليك","cause":"مَن قَرَأ سُورةَ الكهفِ كما أُنزِلَت، ثمَّ خَرَج إلى الدَّجَّالِ","result":"لم يُسلَّطْ عليه، ولم يكُنْ له عليه سَبيلٌ","explicit":true,"ref":"المستدرك على الصحيحين 8787","srcLabel":"النسائي","text":["عن أبي سَعيدٍ الخُدْريِّ رَضيَ اللهُ عنه، قال: ",["مَن قَرَأ سُورةَ الكهفِ كما أُنزِلَت، ثمَّ خَرَج إلى الدَّجَّالِ؛ ",1],["لم يُسلَّطْ عليه، ولم يكُنْ له عليه سَبيلٌ",2],"."],"grade":"صحيح","narrator":"قيس بن عبادة","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه النسائي في ((عمل اليوم والليلة)) (954)، والبيهقي في ((الشعب)) (2776)، وعبد الرزاق (730) واللفظ لهم جميعا.","bab":"فتن › ظهور الفتن","dorar":"Lvrcrfdt"},{"id":"س-07305","fp":"83f3e708959e","stateId":276,"easy":"إذا قرأت ثلاث آيات من أول الكهف ← تُعصم من فتنة الدجال","cause":"مَن قرأ ثلاثَ آياتٍ مِن أَوَّلِ الكهف","result":"عُصِمَ من فتنةِ الدَّجَّالِ","explicit":true,"similar":["س-07308"],"ref":"الجامع الصغير 8912","srcLabel":"الترمذي","text":[["مَن قرأ ثلاثَ آياتٍ مِن أَوَّلِ ( الكهف ) ",1],["عُصِمَ من فتنةِ الدَّجَّالِ",2]],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2886)","bab":"فتن › فتنة الدجال","dorar":"RJyH9Prs"},{"id":"س-07308","fp":"e32217a103ea","stateId":276,"easy":"إذا قرأت عشر آيات من الكهف ← تُعصم من الدجال","cause":"من قرأ منها عشرَ آياتٍ","result":"عُصِمَ من الدجالِ","explicit":true,"repOf":"س-07305","ref":"كشف الخفاء 2/565","text":["حديث  الكهفِ ",["من قرأ منها عشرَ آياتٍ ",1],["عُصِمَ من الدجالِ",2]," [يعني حديث: مَن حَفِظَ عَشْرَ آياتٍ مِن أوَّلِ سُورَةِ الكَهْفِ عُصِمَ مِنَ الدَّجَّالِ.]"],"grade":"صحيح","narrator":"[أبو الدرداء]","muhaddith":"صحيح","bab":"فتن › فتنة الدجال","dorar":"n4ihN0w8"},{"id":"س-07313","fp":"b73e639cf9bc","stateId":276,"easy":"إذا قرأت عشر آيات من آخر الكهف ثم خرج الدجال ← لا يضرك","cause":"و مَنْ قرأَ عشرَ آياتٍ من آخِرِها","result":"ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ","explicit":true,"ref":"السلسلة الصحيحة 2651","srcLabel":"النسائي","text":["مَنْ قرأَ سورةَ الكهفِ [ كما أُنْزِلَتْ ] كانَتْ لهُ نُورًا يومَ القيامةِ ، من مَقَامِهِ إلى مكةَ ، ",["و مَنْ قرأَ عشرَ آياتٍ من آخِرِها",1]," ",["ثُمَّ خرجَ الدَّجَّالُ لمْ يَضُرَّهُ",2]," ، و مَنْ تَوَضَّأَ فقال : سبحانَكَ اللهمَّ و بحمدِكَ [ أشهدُ أنْ ] لا إلهَ إلَّا أنتَ ، أستغفرُكَ و أتوبُ إليكَ ، كُتِبَ في رَقٍّ ، ثُمَّ جُعِلَ في طابعٍ ، فلمْ يُكْسَرْ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455)، والحاكم (2072) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"4Vdm3x5r"},{"id":"س-07315","fp":"1646de45cc3e","stateId":276,"easy":"إذا قرأت عشر آيات من آخر الكهف ← لا يُسلط عليك الدجال","cause":"ومن قرأ عشرَ آياتٍ من آخرِها ثمَّ خرج المسيحُ الدَّجَّالُ","result":"لم يُسلَّطْ عليه","explicit":true,"ref":"الترغيب والترهيب 2/318","srcLabel":"النسائي","text":["من قرأ الكهفَ كما أُنزلتْ كانت له نورًا يومَ القيامةِ من مقامِه إلى مكَّةَ ",["ومن قرأ عشرَ آياتٍ من آخرِها ثمَّ خرج المسيحُ الدَّجَّالُ",1]," ",["لم يُسلَّطْ عليه",2]," ومن توضَّأ ثمَّ قال سبحانَك اللَّهمَّ وبحمدِك لا إلهَ إلَّا أنت أستغفِرُك وأتوبُ إليك كُتِب في رَقٍّ ثمَّ طُبِع بطابعٍ فلم يُكسرْ إلى يومِ القيامةِ"],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحاكم (2072) واللفظ له، وأخرجه النسائي في ((السنن الكبرى)) (9909، 10788) مفرقاً باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1455) باختلاف يسير","bab":"فتن › فتنة الدجال","dorar":"eVKEnPL0"},{"id":"س-07507","fp":"36312ed81509","stateId":276,"easy":"إذا قلت للدجال «كذبت، ربي الله عليه توكلت وإليه أنيب» ← لا يضرك","cause":"ومَن قال: كذَبْتَ، ربِّي اللهُ، وعليه تَوكَّلْتُ، وإليه أُنيبُ","result":"فلا يَضُرُّه، أو قال: فلا فِتنةَ عليه","explicit":true,"apply":{"k":"say","t":"«كذبت، ربي الله عليه توكلت وإليه أنيب»"},"ref":"المستدرك على الصحيحين 8775","srcLabel":"أحمد","text":["إنَّ رأْسَ الدَّجَّالِ مِن وَرائِه حُبكٌ حبُكٌ، وإنَّه سيَقولُ: أنا ربُّكم، فمَن قال: أنتَ ربِّي، افتُتِنَ، ",["ومَن قال: كذَبْتَ، ربِّي اللهُ، وعليه تَوكَّلْتُ، وإليه أُنيبُ، ",1],["فلا يَضُرُّه، أو قال: فلا فِتنةَ عليه",2],"."],"grade":"صحيح","narrator":"هشام بن عامر الأنصاري","muhaddith":"صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه أحمد (16260)، والطبراني (22/ 175) (456)، وعبد الرزاق (21906) جميعا باختلاف يسير.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"T5DF5HS0"},{"id":"س-01560","fp":"a689764f3094","stateId":276,"easy":"إذا سمعت بالدجال فابتعد عنه ← تنجو من فتنته","cause":"مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه","result":"فإنَّ الرَّجُلَ يَأتيه وهو يَحسَبُ أنَّه مؤمنٌ، فلا يَزالُ به لِمَا معه مِن الشُّبَهِ حتى يَتبَعَه","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"تخريج المسند لشعيب 19875","srcLabel":"مسلم","text":[["مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه",1],"، مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه، مَن سَمِعَ بالدَّجَّالِ فليَنْأَ منه؛ ",["فإنَّ الرَّجُلَ يَأتيه وهو يَحسَبُ أنَّه مؤمنٌ، فلا يَزالُ به لِمَا معه مِن الشُّبَهِ حتى يَتبَعَه",2],"."],"grade":"صحيح","narrator":"عمران بن الحصين","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (4319)، وأحمد (19875) واللفظ له","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"JGsNuBfb","merged":4,"otherRefs":["تخريج المسند لشعيب 19968 (صحيح)","الآداب الشرعية 1/220 (حسن)","الأحكام الوسطى 4/ 375 (صحيح)"]},{"id":"س-01562","fp":"592ef36c2fc4","stateId":276,"easy":"إذا أدركت الدجال فقع فيما تراه ناراً ← فإنه ماء عذب بارد","cause":"فمن أدرك منكم فليقعْ في الذي يرى أنها نارٌ","result":"فإنه عَذْبٌ باردٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الجامع 2196","srcLabel":"متفق عليه","text":["إنَّ مع الدَّجَّالِ إذا خرج ماءً و نارًا ، فأما الذي يرى الناسُ أنها النارُ فماءٌ باردٌ ، و أما الذي يرى الناسُ أنها ماءٌ باردٌ فنارٌ تحرقُ ، ",["فمن أدرك منكم فليقعْ في الذي يرى أنها نارٌ",1]," ؛ ",["فإنه عَذْبٌ باردٌ",2]],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3450) واللفظ له، ومسلم (2935) وأبو داود (4315) بنحوه","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"8k5xOiez"},{"id":"س-01070","fp":"63d256e52a1b","stateId":276,"easy":"إذا كان منطقك التسبيح والتقديس زمن الدجال ← يذهب الله عنك الجوع","cause":"فمَن كان مَنطِقُه يومئذٍ التَّسبيحَ والتَّقديسَ","result":"أذْهَبَ اللهُ عنه الجُوعَ، فلم يَخْشَ جُوعًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"المستدرك على الصحيحين 8786","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ سُئِلَ عن طَعامِ المُؤمنينَ في زمَنِ الدَّجَّالِ، قال: طَعامُ الملائكةِ، قالوا: وما طَعامُ الملائكةِ؟ قال: طَعامُهم مَنطِقُهم بالتَّسبيحِ والتَّقديسِ، ",["فمَن كان مَنطِقُه يومئذٍ التَّسبيحَ والتَّقديسَ",1],"، ",["أذْهَبَ اللهُ عنه الجُوعَ، فلم يَخْشَ جُوعًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد على شرط مسلم، ولم يخرجاه","bab":"أدعية وأذكار › فضل الذكر","dorar":"lbnhpS9A"},{"id":"س-00842","fp":"9f3a03605882","stateId":276,"easy":"إذا أدركت فتنة الدجال والجوع فأكثر التسبيح والتكبير والتهليل ← يجزئك عن الطعام","cause":"التسبيحُ والتكبيرُ والتهليلُ","result":"فما طعامُ المؤمنينَ يومئذٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 7/338","srcLabel":"أحمد","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ذَكَرَ جَهْدًا يكونُ بينَ يَدَيِ الدجالِ فقالوا أيُّ المالِ خيْرٌ يومئِذٍ قال غلامٌ شديدٌ يَسْقِي أهلَهُ الماءَ وأَمَّا الطعامُ فليس قالوا ",["فما طعامُ المؤمنينَ يومئذٍ",2]," قال ",["التسبيحُ والتكبيرُ والتهليلُ",1]," قالَتْ عائِشَةٌ فأينَ العربُ يومئذٍ قال العربُ يومئذٍ قليلٌ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (24944)، وأبو يعلى (4607) واللفظ لهما.","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"DcSN03zV","merged":3,"otherRefs":["سبل الهدى والرشاد 10/173 (حسن)","السلسلة الصحيحة 3079 (حسن)"]},{"id":"س-07292","fp":"0ab994cdf6bf","stateId":276,"easy":"إذا نجوت من الفتن قبل الدجال ← تنجو منه","cause":"يَنجُوَ أحَدٌ ممَّا قَبلَها","result":"إلَّا نَجا منها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 23304","srcLabel":"أحمد","text":["ذُكِرَ الدَّجَّالُ عندَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال: لَأنا لِفِتْنةِ بعضِكم أخوَفُ عندي مِن فِتْنةِ الدَّجَّالِ، ولنْ ",["يَنجُوَ أحَدٌ ممَّا قَبلَها",1]," ",["إلَّا نَجا منها",2],"، وما صُنِعَتْ فِتْنةٌ منذُ كانتِ الدُّنيا صَغيرةٌ ولا كبيرةٌ، إلَّا [تَتَّضِعُ] لِفِتْنةِ الدَّجَّالِ."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (23304) واللفظ له، والبزار (2807)، وابن حبان (6807)","bab":"فتن › ظهور الفتن","dorar":"ACTVkZPw"},{"id":"س-07486","fp":"ab18faa0b535","stateId":277,"easy":"إذا فررت بدينك بغنمك إلى رؤوس الجبال ← تنجو من الفتن","cause":"الغَنَمُ فيه خَيرَ مالِ المُسلِمِ، يَتبَعُ بها شَعَفَ الجِبالِ -أو سَعَفَ الجِبالِ- في مَواقِعِ القَطرِ","result":"يَفِرُّ بدينِه مِنَ الفِتَنِ","explicit":true,"star":true,"ref":"صحيح البخاري 3600","srcLabel":"متفق عليه","text":["قال لي: إنِّي أراكَ تُحِبُّ الغَنَمَ، وتَتَّخِذُها، فأصلِحْها وأصلِحْ رُعامَها؛ فإنِّي سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم يقولُ: يَأتي على النَّاسِ زَمانٌ، تَكونُ ",["الغَنَمُ فيه خَيرَ مالِ المُسلِمِ، يَتبَعُ بها شَعَفَ الجِبالِ -أو سَعَفَ الجِبالِ- في مَواقِعِ القَطرِ",1],"، ",["يَفِرُّ بدينِه مِنَ الفِتَنِ",2],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"UK5Nck3z","merged":3,"otherRefs":["تخريج المسند لشعيب 11542 (صحيح)","تخريج صحيح ابن حبان 5955 (صحيح)"]},{"id":"س-07477","fp":"93ccdb30b9ca","stateId":277,"easy":"إذا قعدت في الفتنة ← تكون خيراً من القائم","cause":"القاعدُ فيها","result":"خيرٌ مِنَ القائمِ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8534","srcLabel":"أحمد","text":["عن عُمرِو بنِ وابِصةَ الأسديِّ، عن أبيه، قال: إنِّي لَبِالكوفةِ في داري، إذ سَمِعتُ على بابِ الدَّارِ: السَّلامُ عليكم، أَلِجُ؟ فقُلتُ: عليك السَّلامُ، فَلُجْ، فلمَّا دخَلَ إذا هو عبدُ اللهِ بنُ مَسعودٍ رَضيَ اللهُ عنه، فقُلتُ: يا أبا عبْدَ الرَّحمنِ، أيَّةُ ساعةٍ هذه للزِّيارةِ؟! -وذلك في نحْرِ الظَّهيرةِ- قال: طال علَيَّ النَّهارُ، فتَذكَّرْتُ مَن أتحَدَّثُ إليه، فجَعَل يُحدِّثُني عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأُحَدِّثُه، قال: ثمَّ أنشَأَ يُحَدِّثُني، فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: تكونُ فِتنةٌ، النَّائمُ فيها خيْرٌ مِنَ المضْطجِعِ، والمضْطجِعُ فيها خيرٌ مِنَ القاعدِ، و",["القاعدُ فيها",1]," ",["خيرٌ مِنَ القائمِ",2],"، والقائمٌ خيرٌ مِنَ الماشي، والماشي خيرٌ مِنَ الرَّاكبِ، والرَّاكبُ خيرٌ مِنَ المُجْري، قُلتُ: يا رَسولَ اللهِ، ومَتى ذلكَ؟ قال: ذلكَ أيَّامُ الهَرْجِ حِينَ لا يَأمَنُ الرَّجلُ جَليسَه، قُلتُ: فبِمَ تَأمُرُني إنْ أدرَكْتُ ذلكَ الزَّمانَ؟ قال: اكْفُفْ نفْسَكَ ويَدَكَ، وادْخُلْ دارَك، قال: قُلتُ: يا رَسولَ اللهِ، أرأيْتَ إنْ دخَلَ علَيَّ داري؟ قال: فادخُلْ بيْتَكَ، قال: قُلتُ: أفرأيتَ إنْ دخَلَ علَيَّ بيْتي؟ قال: فادخُلْ مَسجِدَكَ، واصنَعْ هكذا -وقبَضَ بيَمينِه على الكُوعِ- وقُلْ: ربِّي اللهُ، حتَّى تَموتَ على ذلكَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه أحمد (4286)، ومعمر في ((الجامع)) (20727)، والطبراني (10/ 9)، (9774) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"u2LjwKQ4","merged":14,"otherRefs":["تخريج المسند لشعيب 20490 (صحيح)","صحيح أبي داود 4256 (صحيح)","صحيح الجامع 3623 (صحيح)","صحيح الجامع 2049 (صحيح)","صحيح الجامع 3624 (صحيح)","الأحاديث المختارة 938 (صحيح)","تخريج المسند لشعيب 17010 (صحيح)","صحيح مسلم 2886 (صحيح)","تخريج المسند لشعيب 1446 (صحيح)","صحيح مسلم 2887 (صحيح)","تخريج صحيح ابن حبان 5959 (صحيح)","تخريج صحيح ابن حبان 6705 (صحيح)","تخريج المسند لشعيب 21064 (صحيح)"]},{"id":"س-07304","fp":"cd65f9ebd6da","stateId":277,"easy":"إذا اعتزلت في شعب تتقي ربك وتدع الناس من شرك ← تكون من أفضل الناس في الفتنة","cause":"مُؤمِنٌ مُعتَزِلٌ في شِعبٍ مِنَ الشِّعابِ، يَتَّقي رَبَّه تَبارَكَ وتَعالى، ويَدَعُ النَّاسَ مِن شَرِّه","result":"وأفضَلُ النَّاسِ يَومَئِذٍ","explicit":true,"star":true,"otherNeedIds":[41,7],"ref":"تخريج المسند لشعيب 15919","srcLabel":"السنة","text":["أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم أعرابيٌّ، فقال: يا رَسولَ اللهِ، هَل لهذا الأمرِ مِن مُنتَهًى؟ قال: «نَعَم، فمَن أرادَ اللهُ به خَيرًا مِن أعجَمَ أو عَرَبٍ أدخَلَه عليهم، ثُمَّ تَقَعُ فِتَنٌ كالظُّلَلِ تَعودونَ فيها أساوِدَ صُبًّا، يَضرِبُ بَعضُكُم رِقابَ بَعضٍ، ",["وأفضَلُ النَّاسِ يَومَئِذٍ",2]," ",["مُؤمِنٌ مُعتَزِلٌ في شِعبٍ مِنَ الشِّعابِ، يَتَّقي رَبَّه تَبارَكَ وتَعالى، ويَدَعُ النَّاسَ مِن شَرِّه",1],"» قال عَبدُ اللهِ بنُ أحمَدَ: قال أبي: وحَدَّثَني مُحَمَّدُ بنُ مُصعَبٍ القُرقُسانيُّ مِثلَ حَديثِ أبي المُغيرةِ إلَّا أنَّه قال: كُرزُ بنُ حُبَيشٍ الخُزاعيُّ."],"grade":"صحيح","narrator":"كرز بن علقمة الخزاعي","muhaddith":"صحيح","bab":"فتن › ظهور الفتن","dorar":"5MDttS51","merged":5,"otherRefs":["الأحكام الوسطى 2/352 (صحيح)","صحيح الجامع 5915 (صحيح)","تخريج المسند لشعيب 27353 (صحيح)","صحيح ابن حبان 5956 (صحيح)"]},{"id":"س-07293","fp":"fe399412aa78","stateId":277,"easy":"إذا اعتزلت بغنمك أو ثبتّ مرابطاً في الفتنة ← تكون من خير الناس فيها","cause":"صاحبُ شاءٍ يَأكُلُ مِن رِسلِ غَنمِه، أو رجُلٌ وَراءَ الدَّرْبِ آخِذٌ بعِنانِ فَرَسِه، يَأكُلُ مِن سَيفِه","result":"إنَّما خيرُ النَّاسِ فيها","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 8658","srcLabel":"عبد الرزاق","text":["عن أبي هُرَيرةَ رَضيَ اللهُ عنه، قال: أيُّها النَّاسُ، أظلَّتْكم فِتنةٌ كقِطَعِ اللَّيلِ المظلِمِ، ",["إنَّما خيرُ النَّاسِ فيها",2]," -أو قال: منها- ",["صاحبُ شاءٍ يَأكُلُ مِن رِسلِ غَنمِه، أو رجُلٌ وَراءَ الدَّرْبِ آخِذٌ بعِنانِ فَرَسِه، يَأكُلُ مِن سَيفِه",1],"."],"grade":"صحيح","narrator":"نافع بن سرجس","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه عبد الرزاق (21808)، ومعمر بن راشد في ((الجامع)) (20762)، وابن بطة في ((الإبانة)) (759) جميعا بلفظه.","bab":"فتن › ظهور الفتن","dorar":"mpj0B5X2","merged":3,"otherRefs":["المستدرك على الصحيحين 8794 (صحيح)","صحيح الجامع 1035 (صحيح)"]},{"id":"س-07476","fp":"33b5af51c40c","stateId":277,"easy":"إذا اضطجعت في الفتنة ← تكون خيراً من القاعد","cause":"والمضْطجِعُ فيها","result":"خيرٌ مِنَ القاعدِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"المستدرك على الصحيحين 8534","srcLabel":"أحمد","text":["عن عُمرِو بنِ وابِصةَ الأسديِّ، عن أبيه، قال: إنِّي لَبِالكوفةِ في داري، إذ سَمِعتُ على بابِ الدَّارِ: السَّلامُ عليكم، أَلِجُ؟ فقُلتُ: عليك السَّلامُ، فَلُجْ، فلمَّا دخَلَ إذا هو عبدُ اللهِ بنُ مَسعودٍ رَضيَ اللهُ عنه، فقُلتُ: يا أبا عبْدَ الرَّحمنِ، أيَّةُ ساعةٍ هذه للزِّيارةِ؟! -وذلك في نحْرِ الظَّهيرةِ- قال: طال علَيَّ النَّهارُ، فتَذكَّرْتُ مَن أتحَدَّثُ إليه، فجَعَل يُحدِّثُني عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ وأُحَدِّثُه، قال: ثمَّ أنشَأَ يُحَدِّثُني، فقال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: تكونُ فِتنةٌ، النَّائمُ فيها خيْرٌ مِنَ المضْطجِعِ، ",["والمضْطجِعُ فيها",1]," ",["خيرٌ مِنَ القاعدِ",2],"، والقاعدُ فيها خيرٌ مِنَ القائمِ، والقائمٌ خيرٌ مِنَ الماشي، والماشي خيرٌ مِنَ الرَّاكبِ، والرَّاكبُ خيرٌ مِنَ المُجْري، قُلتُ: يا رَسولَ اللهِ، ومَتى ذلكَ؟ قال: ذلكَ أيَّامُ الهَرْجِ حِينَ لا يَأمَنُ الرَّجلُ جَليسَه، قُلتُ: فبِمَ تَأمُرُني إنْ أدرَكْتُ ذلكَ الزَّمانَ؟ قال: اكْفُفْ نفْسَكَ ويَدَكَ، وادْخُلْ دارَك، قال: قُلتُ: يا رَسولَ اللهِ، أرأيْتَ إنْ دخَلَ علَيَّ داري؟ قال: فادخُلْ بيْتَكَ، قال: قُلتُ: أفرأيتَ إنْ دخَلَ علَيَّ بيْتي؟ قال: فادخُلْ مَسجِدَكَ، واصنَعْ هكذا -وقبَضَ بيَمينِه على الكُوعِ- وقُلْ: ربِّي اللهُ، حتَّى تَموتَ على ذلكَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه أحمد (4286)، ومعمر في ((الجامع)) (20727)، والطبراني (10/ 9)، (9774) جميعهم بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"u2LjwKQ4","merged":3,"otherRefs":["تخريج المسند لشعيب 20490 (صحيح)","تخريج المسند لشعيب 1446 (صحيح)"]},{"id":"س-06027","fp":"d0c20dcf5fe7","stateId":277,"easy":"إذا جُنّبت الفتن ← فأنت السعيد","cause":"لَمَن جُنِّبَ الفتَنَ","result":"إنَّ السَّعيدَ","explicit":true,"otherNeedIds":[7],"ref":"البحر الزخار 6/46","srcLabel":"أبو داود","text":["جاءَ المقدادُ بنُ الأسوَدِ في حاجةٍ، فقلنا: اجلِس حتَّى نطلُبَ لَك حاجتَكَ فجلسَ فقال: عجِبتُ لقومٍ مرَرتُ بِهم يتمنَّونَ الفتَنَ يزعُمونَ ليُبلِينَّهمُ اللَّهُ فيها ما أبلى رسولَه صلَّى اللهُ علَيهِ وسلَّم، وأصحابَه رضيَ اللَّهُ عنهُم، ولقد سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: إنَّ السَّعيدَ ",["لَمَن جُنِّبَ الفتَنَ",1],"، ",["إنَّ السَّعيدَ",2]," لمن جُنِّبَ الفتَن يردِّدُها ثلاثَ مرَّاتٍ إلَّا مَنِ ابتُليَ فصبرَ وايمُ اللَّهِ لا أشهَدُ لأحدٍ أنَّهُ من أَهلِ الجنَّةِ حتَّى أعلمَ ما يموتُ علَيهِ بعدَ حديثٍ سمعتُهُ مِن رسولِ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ سمعتُ رسولَ اللَّهِ صلَّى اللهُ علَيهِ وسلَّمَ يقولُ: لَقَلبُ ابنِ آدمَ أشدُّ انقلابًا منَ القِدرِ إذا غَلِيَتْ"],"grade":"صحيح","narrator":"المقداد بن عمرو بن الأسود","muhaddith":"محفوظ وإسناده حسن","takhrij":"أخرجه أبو داود (4263) مختصراً، والبزار (2112) واللفظ له.","bab":"رقائق وزهد › فضل الصبر","dorar":"wy9CD1MT","merged":2,"otherRefs":["السلسلة الصحيحة 975 (صحيح)"]},{"id":"س-07282","fp":"8a338884fb2b","stateId":277,"easy":"إذا عضضت على أصل شجرة (اعتزلت الفتن) ← فهو خير لك من اتباع أهلها","cause":"وأنتَ عاضٌّ على جِذْلٍ","result":"خيرٌ لك من أنْ تتَّبِعَ أحدًا منهم","explicit":true,"otherNeedIds":[48],"ref":"تخريج سنن أبي داود 4246","srcLabel":"أبو داود","text":["أتَيْنا اليَشْكُريَّ في رَهْطٍ من بني ليثٍ، فقال: مَن القومُ؟ فقُلْنا: بنو ليثٍ. فقُلْنا: أتَيْناكَ نسألُكَ عن حديثِ حُذَيفةَ، قال: أقبَلْنا مع أبي موسى قافِلِينَ، وغلَتِ الدوابُّ بالكوفةِ، قال: فسألتُ أبا موسى أنا وصاحِبٌ لي، فأذِنَ لنا، فقدِمْنا الكوفةَ، فقلتُ لصاحبي: أنا داخلٌ المسجِدَ، فإذا قامتِ السوقُ خرَجتُ إليك، قال: فدخَلتُ المسجِدَ، فإذا فيه حَلْقةٌ كأنَّما قُطِّعتْ رؤوسُهم، يستَمِعونَ إلى حديثِ رجُلٍ، قال: فقمتُ عليهم، فجاء رجُلٌ فقام إلى جَنْبي، فقلتُ: مَن هذا؟ قال: أبصريٌّ أنتَ؟ قلتُ: نعَمْ، قال: قد عرَفتُ، لو كنتَ كوفيًّا لم تسألْ عن هذا، قال: فدنَوتُ منه، فسمِعتُ حُذَيفةَ يقولُ: كان الناسُ يسألونَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عن الخيرِ، وكنتُ أسألُه عن الشرِّ، وعرَفتُ أنَّ الخيرَ لن يسبِقَني.\nقال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ، قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ فقال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. قلت: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: فِتْنةٌ وشرٌّ. قلتُ: يا رسولَ اللهِ، بعدَ هذا الشرِّ خيرٌ؟ قال:  يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ، قلتُ: يا رسولَ اللهِ، بعدَ هذا الشرِّ خيرٌ؟ قال: هُدْنةٌ على دَخَنٍ، وجماعةٌ على أقذاءٍ، فيها -أو فيهم- قلتُ: يا رسولَ اللهِ، الهُدْنةُ على الدَّخَنِ ما هي؟ قال: لا ترجِعُ قلوبُ أقوامٍ على الذي كانت عليه. قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: يا حُذَيفةُ، تعلَّمْ كتابَ اللهِ، واتَّبِعْ ما فيه. ثلاثَ مِرارٍ. قال: قلتُ: يا رسولَ اللهِ، بعدَ هذا الخيرِ شرٌّ؟ قال: فِتْنةٌ عَمْياءُ صَمَّاءُ، عليها دُعاةٌ على أبوابِ النارِ، فإنْ مِتَّ يا حُذَيفةُ ",["وأنتَ عاضٌّ على جِذْلٍ",1],"، ",["خيرٌ لك من أنْ تتَّبِعَ أحدًا منهم",2],"."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (5963) واللفظ له، وأبو داود (4246) مختصرا، وأحمد (23282) بنحوه","bab":"فتن › ظهور الفتن","dorar":"jC21BNrR","merged":2,"otherRefs":["المستدرك على الصحيحين 8550 (صحيح)"]},{"id":"س-05844","fp":"d9d8f75dbcae","stateId":277,"easy":"إذا قعدت عن الفتنة ← فهو خير من القتال فيها","cause":"القُعودُ عن الفِتنةِ","result":"خَيرٌ مِن القِتالِ فيها","explicit":true,"ref":"الفتاوى الكبرى 3/458","srcLabel":"السنة","text":[["القُعودُ عن الفِتنةِ ",1],["خَيرٌ مِن القِتالِ فيها",2]],"grade":"صحيح","muhaddith":"[صحيح]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"l4kZE2ER"},{"id":"س-07301","fp":"c112311000a5","stateId":277,"easy":"إذا دعوت بدعاء الغريق (بإخلاص) ← تنجو في الفتنة","cause":"مَن دَعا دُعاءَ الغرَقِ","result":"لا يَنْجو فيه إلَّا","explicit":true,"otherNeedIds":[28],"ref":"المستدرك على الصحيحين 8528","srcLabel":"أحمد","text":["عن حُذَيفةَ رَضيَ اللهُ عنه، قال: يَأتي عليكم زَمانٌ ",["لا يَنْجو فيه إلَّا",2]," ",["مَن دَعا دُعاءَ الغرَقِ",1],"."],"grade":"صحيح","narrator":"عمارة بن عمير","muhaddith":"هذا إسناد صحيح على شرط الشيخين، ولم يخرجاه","takhrij":"أخرجه أحمد في ((العلل ومعرفة الرجال لأحمد- رواية ابنه عبد الله)) (1370) واللفظ له، وابن أبي شيبة (29173)، والبيهقي في ((الشعب)) (1078) كلاهما باختلاف يسير.","bab":"فتن › ظهور الفتن","dorar":"l4ttcKY5"},{"id":"س-07303","fp":"cd55cb3e39e9","stateId":277,"easy":"إذا نمت عن الفتنة ← تكون خيراً من اليقظان فيها","cause":"سَتَكونُ مِن بَعدي فِتنةٌ النَّائِمُ فيها","result":"خَيرٌ مِنَ اليَقظانِ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"تخريج المسند لشعيب 17010","srcLabel":"السنة","text":[["«سَتَكونُ مِن بَعدي فِتنةٌ النَّائِمُ فيها ",1],["خَيرٌ مِنَ اليَقظانِ",2],"، والقاعِدُ فيها خَيرٌ مِنَ القائِمِ، والقائِمُ فيها خَيرٌ مِنَ السَّاعي، فمَن أتَت عليه فليَمشِ بسَيفِه إلى صَفاةٍ فليَضرِبْه بها حَتَّى يَنكَسِرَ، ثُمَّ ليَضطَجِعْ لها حَتَّى تَنجَليَ عَمَّا انجَلَت»."],"grade":"صحيح","narrator":"خرشة","muhaddith":"صحيح لغيره","bab":"فتن › ظهور الفتن","dorar":"vMlILGF8"},{"id":"س-07790","fp":"b682b1782652","stateId":277,"easy":"إذا ظهرت الفتن فاقرأ كتاب الله واعمل بما فيه ← تنجو","cause":"اقْرَأْ كِتابَ اللهِ، واعْمَلْ بما فيه","result":"مَن أجابَهم قَذَفوهُ فيها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[57],"ref":"تخريج المسند لشعيب 23449","srcLabel":"متفق عليه","text":["قُلتُ: يا رسولَ اللهِ، هل بعدَ هذا الخَيرِ شَرٌّ كما كان قَبلَه شَرٌّ؟ قال: يا حُذَيفةُ، ",["اقْرَأْ كِتابَ اللهِ، واعْمَلْ بما فيه",1],"، فأعرَضَ عَنِّي، فأعَدتُ عليه ثلاثَ مرَّاتٍ، وعَلِمتُ أنَّه إنْ كان خَيرًا اتَّبَعتُه، وإنْ كان شَرًّا اجتَنَبتُه، فقُلتُ: هل بعدَ هذا الخَيرِ من شَرٍّ؟ قال: نَعَمْ، فِتْنةٌ عَمْياءُ صَمَّاءُ، ودُعاةُ ضَلالةٍ على أبْوابِ جَهنَّمَ، ",["مَن أجابَهم قَذَفوهُ فيها",2],"."],"grade":"حسن","narrator":"حذيفة بن اليمان","muhaddith":"حسن","takhrij":"أخرجه البخاري (3606)، ومسلم (1847) مطولاً بمعناه، وأبو داود (4246)، والنسائي في ((السنن الكبرى)) (8032)، وابن ماجه (3979) بنحوه مطولاً، وأحمد (23449) واللفظ له","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"C5AlUed8"},{"id":"س-07266","fp":"cdc951c42c78","stateId":277,"easy":"إذا أنكرت على أمراء الجور ← تنجو","cause":"فمَنْ نابَذَهمْ","result":"نَجَا","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 3661","srcLabel":"الطبراني","text":["سيكونُ أمراءٌ تعرِفونَ و تُنكِرونَ، ",["فمَنْ نابَذَهمْ",1]," ",["نَجَا",2],"، ومَنْ اعتزَلَهم سلِمَ، ومَنْ خالَطَهم هَلَكَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (38898)، والطبراني (11/40) (10973)، وابن عدي في ((الكامل في الضعفاء)) (7/132) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YVAi1vMQ"},{"id":"س-07267","fp":"c0f76864b124","stateId":277,"easy":"إذا اعتزلت أمراء الجور ← تسلم","cause":"ومَنْ اعتزَلَهم","result":"سلِمَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 3661","srcLabel":"الطبراني","text":["سيكونُ أمراءٌ تعرِفونَ و تُنكِرونَ، فمَنْ نابَذَهمْ نَجَا، ",["ومَنْ اعتزَلَهم",1]," ",["سلِمَ",2],"، ومَنْ خالَطَهم هَلَكَ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي شيبة في ((المصنف)) (38898)، والطبراني (11/40) (10973)، وابن عدي في ((الكامل في الضعفاء)) (7/132) باختلاف يسير.","bab":"فتن › أمراء الجور","dorar":"YVAi1vMQ"}]}