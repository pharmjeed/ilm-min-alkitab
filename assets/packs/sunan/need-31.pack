{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":31,"stateIds":[339,340,341,342,343,344,345,346,347,348,349,350,351,352,353],"items":[{"id":"س-00665","fp":"b92992396f3c","stateId":339,"easy":"إذا قرأت الإخلاص والمعوذتين ثلاثاً صباحاً ومساءً ← تكفيك من كل شيء","cause":"قُلْ هُوَ اللَّهُ أَحَدٌ والمُعَوِّذَتَينِ حينَ تُمْسي وتُصبِحُ ثَلاثَ مَرَّاتٍ","result":"يَكْفيك مِن كلِّ شيءٍ","explicit":true,"star":true,"apply":{"k":"read","t":"الإخلاص والمعوذتين · الوقت: صباحاً ومساءً"},"ref":"الأحاديث المختارة 9 / 288","srcLabel":"متفق عليه","text":["«خَرَجْنا في لَيْلةٍ مَطيرةٍ مُظْلِمةٍ شَديدةٍ، فطَلَبْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ليُصَلِّيَ لنا، قالَ: فأَدْرَكْتُه، فقالَ: قُلْ، فلم أَقُلْ شَيئًا، ثُمَّ قالَ: قُلْ، فلم أَقُلْ شَيئًا، قالَ: قُلْ، قُلْتُ: يا رَسولَ اللهِ وما أَقولُ؟ قالَ: {",["قُلْ هُوَ اللَّهُ أَحَدٌ} والمُعَوِّذَتَينِ حينَ تُمْسي وتُصبِحُ ثَلاثَ مَرَّاتٍ",1],"، ",["يَكْفيك مِن كلِّ شيءٍ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن خبيب الجهني","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › أذكار الصباح","dorar":"Eed94zRz","merged":4,"otherRefs":["صحيح النسائي 5443 (حسن)","صحيح الترغيب 649 (صحيح)","الأحاديث المختارة 9 / 287 (صحيح)"]},{"id":"س-01160","fp":"1ea37f3d0ded","stateId":339,"easy":"إذا قلت مساءً «أعوذ بكلمات الله التامات من شر ما خلق» ← لا يضرك شيء","cause":"لو قُلْتَ حينَ أمسيْتَ: أعوذُ بكلماتِ اللهِ التَّامَّاتِ مِن شرِّ ما خلَق","result":"لمْ يَضُرَّكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«أعوذ بكلمات الله التامات من شر ما خلق» · الوقت: في المساء"},"similar":["س-03242"],"ref":"تخريج مشكل الآثار 18","srcLabel":"مسلم","text":["غَيْرَ أنَّه لمْ يَقُلْ فيه: (إنْ شاء اللهُ). يعني هذا الحديثَ: أنَّ رجُلًا، مِن أَسْلَمَ قال: ما نِمْتُ هذه الليلةَ، فقال النَّبيُّ عليه السَّلامُ: مِن أَيِّ شيءٍ؟ فقال: لدَغتْني عَقربٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أمَا إنَّكَ ",["لو قُلْتَ حينَ أمسيْتَ: أعوذُ بكلماتِ اللهِ التَّامَّاتِ مِن شرِّ ما خلَق",1],"، ",["لمْ يَضُرَّكَ",2]," إنْ شاء اللهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"رجاله رجال الصحيح، عدا إبراهيم بن أبي داود، شيخ أبي جعفر... فإنَّ ه حافظ ثقة مكثر","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10350)، ومسلم (2709)، وأبو داود (3899) كلاهما بنحوه، وليس فيه: إن شاء الله.","bab":"أدعية وأذكار › فضل الذكر","dorar":"Si3KVhd5","merged":5,"otherRefs":["صحيح مسلم 2709 (صحيح)","صحيح ابن ماجه 2852 (صحيح)","الأذكار للنووي 127 (صحيح)","تخريج مشكل الآثار 30 (صحيح)"]},{"id":"س-00895","fp":"1586d87fa56c","stateId":339,"easy":"إذا قلت مساءً ثلاثاً «أعوذ بكلمات الله التامات من شر ما خلق» ← لا تضرك لدغة تلك الليلة","cause":"مَن قالَ حينَ يمسي ثلاثَ مرَّاتٍ : أعوذُ بِكَلماتِ اللَّهِ التَّامَّاتِ من شرِّ ما خلقَ","result":"لم يضُرَّهُ حُمةٌ تلكَ اللَّيلةَ","explicit":true,"star":true,"apply":{"k":"say","t":"«أعوذ بكلمات الله التامات من شر ما خلق» · الوقت: في المساء"},"ref":"صحيح الترمذي 3604","srcLabel":"مسلم","text":[["مَن قالَ حينَ يمسي ثلاثَ مرَّاتٍ : أعوذُ بِكَلماتِ اللَّهِ التَّامَّاتِ من شرِّ ما خلقَ ، ",1],["لم يضُرَّهُ حُمةٌ تلكَ اللَّيلةَ",2]," قالَ سُهَيْلٌ : فَكانَ أَهْلُنا تعلَّموها فَكانوا يقولونَها كلَّ ليلةٍ فلُدِغَت جاريةٌ منهم فلم تجِدْ لَها وجعًا"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3604) واللفظ له، وأخرجه مسلم (2709) مختصراً بلفظ مقارب","bab":"أدعية وأذكار › فضل الذكر","dorar":"sUT2BhMg"},{"id":"س-01041","fp":"37a97d227cd0","stateId":339,"easy":"إذا قلت مساءً ثلاثاً «أعوذ بكلمات الله التامات...» ← لا تضرك حية حتى الصباح","cause":"مَن قال حين يُمسي: أعوذُ بكلماتِ اللهِ التَّامَّاتِ مِن شرِّ ما خلَق ثلاثَ مرَّاتٍ","result":"لم تضُرَّه حيَّةٌ إلى الصَّباحِ","explicit":true,"apply":{"k":"say","t":"«أعوذُ بكلماتِ اللهِ التَّامَّاتِ مِن شرِّ ما خلَق» · الوقت: في المساء"},"ref":"تخريج صحيح ابن حبان 1022","srcLabel":"مسلم","text":[["مَن قال حين يُمسي: أعوذُ بكلماتِ اللهِ التَّامَّاتِ مِن شرِّ ما خلَق ثلاثَ مرَّاتٍ ",1],["لم تضُرَّه حيَّةٌ إلى الصَّباحِ )",2]," قال: وكان إذا لُدِغ إنسانٌ مِن أهلِه قال [يعني أبا هُرَيرةَ]: أمَا قال الكلماتِ ؟!"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناد صحيح على شرط مسلم","takhrij":"أخرجه مسلم (2709) بلفظ مقارب","bab":"أدعية وأذكار › فضل الذكر","dorar":"KOnETCul"},{"id":"س-00662","fp":"8e09bd829a13","stateId":339,"easy":"إذا قرأت آية الكرسي صباحاً ← تُجار من الجن حتى تمسي","cause":"إذا قرَأْتَها غُدوَةً","result":"أُجِرتَ مِنَّا حتَّى تُمسيَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: في الصباح"},"ref":"المستدرك على الصحيحين 2091","srcLabel":"الحاكم","text":["عَنْ أُبَيِّ بْنِ كَعْبٍ أنَّه كان له جَرينُ تَمرٍ، فكان يَجِدُهُ يَنقُصُ، فحَرَسَهُ ليلةً، فإذا هو بِمثلِ الغلامِ المُحتلِمِ، فسَلَّمَ عليه، فرَدَّ عليه السَّلامَ، فقالَ: أَجِنِّيٌّ أَمْ إنسِيٌّ؟ فقالَ: بل جِنِّيٌّ، فقالَ: أَرِني يدَكَ، فأَراهُ، فإذا يدُ كلبٍ وشَعرُ كلبٍ، فقالَ: هكذا خَلْقُ الجِنِّ، فقالَ: لقد عَلِمتِ الجِنُّ أنَّه ليس فيهم رَجلٌ أَشدُّ مِنِّي، قالَ: ما جاءَ بكَ؟ قالَ: أُنبِئنا أنَّكَ تُحِبُّ الصَّدقَةَ، فجِئنا نُصيبُ مِن طعامِكَ، قالَ: ما يُجيرُنا منكم؟ قالَ: تَقرأُ آيةَ الكُرسيِّ مِن سورةِ البقرةِ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} [البقرة: 255] قالَ: نَعَمْ، قالَ: ",["إذا قرَأْتَها غُدوَةً",1],"؛ ",["أُجِرتَ مِنَّا حتَّى تُمسيَ",2],"، وإذا قرَأْتَها حينَ تُمسي؛ أُجِرْتَ مِنَّا حتَّى تُصبِحَ، قالَ أُبيٌّ: فغَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأَخبرْتُهُ بذلك، فقالَ: صَدَقَ الخبيثُ."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › أذكار الصباح","dorar":"TYKMkMFg","merged":2,"otherRefs":["الأحاديث المختارة 1261 (صحيح)"]},{"id":"س-00676","fp":"6edcf99e6d69","stateId":339,"easy":"إذا قلتها صباحاً ← لا يفجؤك بلاء حتى تمسي","cause":"وإنْ قالَها حينَ يُصبِحُ","result":"لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُمْسيَ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"similar":["س-02536","س-01017","س-01044"],"ref":"تخريج مشكل الآثار 3074","srcLabel":"الترمذي","text":["بسمِ اللهِ الذي لا يَضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السميعُ العَليمُ، فقالها حينَ يُمْسي، لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُصبِحَ، ",["وإنْ قالَها حينَ يُصبِحُ",1]," ",["لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُمْسيَ",2],".\nوإنَّ أَبانَ أصابَه فالِجٌ، فقيلَ له: أين ما كُنتَ حدَّثْتَنا؟ قال: واللهِ ما كذَبْتُ ولا كُذِبْتُ، ولكِنِّي حينَ أرادَ اللهُ عزَّ وجلَّ ما أرادَني به، أَنْساني ذلك الدُّعاءَ."],"grade":"صحيح","narrator":"عثمان","muhaddith":"إسناده صحيح.","takhrij":"أخرجه الطحاوي  في ((شرح مشكل الآثار)) (3074) واللفظ له، وأبي داود (5088)، والترمذي (3388)، وابن ماجه (3869)، والنسائي في ((السنن الكبرى)) (10106) جميعا باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"W2IQSn2x","merged":2,"otherRefs":["تخريج صحيح ابن حبان 862 (صحيح)"]},{"id":"س-02535","fp":"ee06d662a188","stateId":339,"easy":"إذا قلت آية الكرسي مساءً ← تُجار من الجن حتى تصبح","cause":"مَن قالها حين يُمسي","result":"أُجيرَ مِنَّا حتى يُصبِحَ","explicit":true,"apply":{"k":"time","t":"في المساء"},"ref":"المتجر الرابح 222","srcLabel":"النسائي","text":["عن أُبَيِّ بنِ كَعبٍ رضِيَ اللهُ عنه: أنَّه كان له جَرينٌ من تَمْرٍ، وكان يَنقُصُ، فحَرَسَه ذاتَ لَيلَة، فإذا هو بدابَّةٍ شِبْهِ الغُلامِ المُحتَلِمِ، فسلَّمَ عليه، فرَدَّ عليه السَّلامَ، فقال: مَن أنتَ؟ جِنِّيٌّ أم إِنسيٌّ؟ قال: جِنِّيٌّ، قال: فنَاوِلْني يَدَك، فناوَلَه يَدَه، فإذا يَدُ كَلبٍ وشَعَرُه شَعَرُ كَلبٍ، قال: هذا خَلْقُ الجِنِّ؟ قال: قد عَلِمَتِ الجِنُّ أنَّ ما فيهم رَجُلًا أشَدَّ مِنِّي، قال: فما جاءَ بك؟ قال: بَلَغَنا أنَّك تُحِبُّ الصَّدَقةَ، فجِئْنا نُصيبُ من طَعامِكَ، قال: فما يُنجينا منكم؟ قال: هذه الآيَةُ التي في سورةِ البَقَرةِ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} [البقرة: 255]، ",["مَن قالها حين يُمسي",1]," ",["أُجيرَ مِنَّا حتى يُصبِحَ",2],"، ومَن قالها حين يُصبِحُ أُجيرَ مِنَّا حتى يُمسي، فلمَّا أصبَحَ أتَى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فذَكَرَ ذلك له، فقال: صَدَقَ الخَبيثُ."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10730)، وابن حبان (784)، والطبراني (1/201) (543) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"zCnhmSPH","merged":2,"otherRefs":["الأحاديث المختارة 1261 (صحيح)"]},{"id":"س-02536","fp":"72a82b69dff3","stateId":339,"easy":"إذا قلتها صباحاً ← تُجار منهم حتى تمسي","cause":"ومَن قالها حين يُصبِحُ","result":"أُجيرَ مِنَّا حتى يُمسي","explicit":true,"apply":{"k":"time","t":"في الصباح"},"repOf":"س-00676","ref":"المتجر الرابح 222","text":["عن أُبَيِّ بنِ كَعبٍ رضِيَ اللهُ عنه: أنَّه كان له جَرينٌ من تَمْرٍ، وكان يَنقُصُ، فحَرَسَه ذاتَ لَيلَة، فإذا هو بدابَّةٍ شِبْهِ الغُلامِ المُحتَلِمِ، فسلَّمَ عليه، فرَدَّ عليه السَّلامَ، فقال: مَن أنتَ؟ جِنِّيٌّ أم إِنسيٌّ؟ قال: جِنِّيٌّ، قال: فنَاوِلْني يَدَك، فناوَلَه يَدَه، فإذا يَدُ كَلبٍ وشَعَرُه شَعَرُ كَلبٍ، قال: هذا خَلْقُ الجِنِّ؟ قال: قد عَلِمَتِ الجِنُّ أنَّ ما فيهم رَجُلًا أشَدَّ مِنِّي، قال: فما جاءَ بك؟ قال: بَلَغَنا أنَّك تُحِبُّ الصَّدَقةَ، فجِئْنا نُصيبُ من طَعامِكَ، قال: فما يُنجينا منكم؟ قال: هذه الآيَةُ التي في سورةِ البَقَرةِ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} [البقرة: 255]، مَن قالها حين يُمسي أُجيرَ مِنَّا حتى يُصبِحَ، ",["ومَن قالها حين يُصبِحُ",1]," ",["أُجيرَ مِنَّا حتى يُمسي",2],"، فلمَّا أصبَحَ أتَى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فذَكَرَ ذلك له، فقال: صَدَقَ الخَبيثُ."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10730)، وابن حبان (784)، والطبراني (1/201) (543) باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"zCnhmSPH","merged":2,"otherRefs":["هداية الرواة 2/471 (حسن)"]},{"id":"س-03242","fp":"15032d15bfe7","stateId":339,"easy":"إذا قلت عند نومك «أعوذ بكلمات الله التامة من شر ما خلق» ← لا يضرك شيء","cause":"لو قال حينَ أَوى إلى فِراشِه أعُوذُ بكلماتِ اللهِ التَّامَّةِ مِن شرِّ ما خلَق","result":"لَمْ يضُرَّه","explicit":true,"apply":{"k":"say","t":"«أعوذ بكلمات الله التامة من شر ما خلق»"},"repOf":"س-01160","ref":"أطراف الغرائب 1/174","text":["حديث: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ فُلانًا لم يَنَمِ البارِحةَ [قال ولِمَ قيل لدَغَتْه عَقْربٌ قال أمَا إنَّه ",["لو قال حينَ أَوى إلى فِراشِه أعُوذُ بكلماتِ اللهِ التَّامَّةِ مِن شرِّ ما خلَق",1]," ",["لَمْ يضُرَّه",2],"]"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"غريب من حديث ثابت عن أنس تفرد به وهب عن ثابت","bab":"استعاذة › التعوذ","dorar":"jVqQa6Bg","merged":2,"otherRefs":["تخريج سنن أبي داود 3899 (صحيح)"]},{"id":"س-00659","fp":"4c76b93aad14","stateId":339,"easy":"إذا قلت أذكار المساء ← تكون لك حجاباً من الشيطان حتى تصبح","cause":"فإنْ قالها حينَ يُمسي","result":"كان لهُ مِثْلَ ذلكَ ، وكُنَّ لهُ حِجابًا مِنَ الشيطانِ حتى يُصبحَ","explicit":true,"ref":"السلسلة الصحيحة 113","srcLabel":"ابن عرفه","text":["مَنْ قال لا إلهَ إِلَّا اللهُ وحْدَهُ، لا شريكَ لهُ لهُ الملكُ ولهُ الحمدُ وهوَ على كلِّ شيءٍ قديرٌ بعدَ ما يصلِّي الغداةَ عشرَ مراتٍ كتب اللهُ عزَّ وجلَّ لهُ عشرَ حَسَناتٍ ، و مَحَى عنهُ عشرَ سيئاتٍ ، و رفعَ لهُ عشرَ درجاتٍ وكُنَّ لهُ بِعِدْلِ عِتْقِ رَقَبَتَيْنِ من ولَدِ إسماعيلَ ، ",["فإنْ قالها حينَ يُمسي",1]," ",["كان لهُ مِثْلَ ذلكَ ، وكُنَّ لهُ حِجابًا مِنَ الشيطانِ حتى يُصبحَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن عرفه في ((جزئه)) (18)، والخطيب في ((تاريخ بغداد)) (12/389)، وقاضي المارستان في ((المشيخة)) (476) باختلاف يسير","bab":"أدعية وأذكار › أذكار الصباح","dorar":"s3PZKdKr"},{"id":"س-00663","fp":"2e635f803f1b","stateId":339,"easy":"إذا قرأتها مساءً ← تُجار منهم حتى تصبح","cause":"وإذا قرَأْتَها حينَ تُمسي","result":"أُجِرْتَ مِنَّا حتَّى تُصبِحَ","explicit":true,"apply":{"k":"time","t":"في المساء"},"ref":"المستدرك على الصحيحين 2091","srcLabel":"الحاكم","text":["عَنْ أُبَيِّ بْنِ كَعْبٍ أنَّه كان له جَرينُ تَمرٍ، فكان يَجِدُهُ يَنقُصُ، فحَرَسَهُ ليلةً، فإذا هو بِمثلِ الغلامِ المُحتلِمِ، فسَلَّمَ عليه، فرَدَّ عليه السَّلامَ، فقالَ: أَجِنِّيٌّ أَمْ إنسِيٌّ؟ فقالَ: بل جِنِّيٌّ، فقالَ: أَرِني يدَكَ، فأَراهُ، فإذا يدُ كلبٍ وشَعرُ كلبٍ، فقالَ: هكذا خَلْقُ الجِنِّ، فقالَ: لقد عَلِمتِ الجِنُّ أنَّه ليس فيهم رَجلٌ أَشدُّ مِنِّي، قالَ: ما جاءَ بكَ؟ قالَ: أُنبِئنا أنَّكَ تُحِبُّ الصَّدقَةَ، فجِئنا نُصيبُ مِن طعامِكَ، قالَ: ما يُجيرُنا منكم؟ قالَ: تَقرأُ آيةَ الكُرسيِّ مِن سورةِ البقرةِ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} [البقرة: 255] قالَ: نَعَمْ، قالَ: إذا قرَأْتَها غُدوَةً؛ أُجِرتَ مِنَّا حتَّى تُمسيَ، ",["وإذا قرَأْتَها حينَ تُمسي",1],"؛ ",["أُجِرْتَ مِنَّا حتَّى تُصبِحَ",2],"، قالَ أُبيٌّ: فغَدَوْتُ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فأَخبرْتُهُ بذلك، فقالَ: صَدَقَ الخبيثُ."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"صحيح الإسناد","bab":"أدعية وأذكار › أذكار الصباح","dorar":"TYKMkMFg"},{"id":"س-00675","fp":"2740b515e75f","stateId":339,"easy":"إذا قلت مساءً «بسم الله الذي لا يضر مع اسمه شيء...» ← لا يفجؤك بلاء حتى تصبح","cause":"بسمِ اللهِ الذي لا يَضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السميعُ العَليمُ، فقالها حينَ يُمْسي","result":"لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُصبِحَ","explicit":true,"apply":{"k":"say","t":"«بسمِ اللهِ الذي لا يَضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السميعُ العَليمُ، فقالها حينَ يُمْسي، لم تَفْجأْهُ فاجئةُ بَلاء» · الوقت: في المساء"},"similar":["س-01016"],"ref":"تخريج مشكل الآثار 3074","srcLabel":"الترمذي","text":[["بسمِ اللهِ الذي لا يَضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السميعُ العَليمُ، فقالها حينَ يُمْسي",1],"، ",["لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُصبِحَ",2],"، وإنْ قالَها حينَ يُصبِحُ لم تَفْجأْهُ فاجئةُ بَلاءٍ حتى يُمْسيَ.\nوإنَّ أَبانَ أصابَه فالِجٌ، فقيلَ له: أين ما كُنتَ حدَّثْتَنا؟ قال: واللهِ ما كذَبْتُ ولا كُذِبْتُ، ولكِنِّي حينَ أرادَ اللهُ عزَّ وجلَّ ما أرادَني به، أَنْساني ذلك الدُّعاءَ."],"grade":"صحيح","narrator":"عثمان","muhaddith":"إسناده صحيح.","takhrij":"أخرجه الطحاوي  في ((شرح مشكل الآثار)) (3074) واللفظ له، وأبي داود (5088)، والترمذي (3388)، وابن ماجه (3869)، والنسائي في ((السنن الكبرى)) (10106) جميعا باختلاف يسير.","bab":"أدعية وأذكار › الجوامع من الدعاء","dorar":"W2IQSn2x"},{"id":"س-01010","fp":"244408e39dc0","stateId":339,"easy":"إذا قلت صباحاً ومساءً ثلاثاً «بسم الله الذي لا يضر مع اسمه شيء...» ← لا يضرك شيء","cause":"ما مِن عبدٍ يقولُ في صباحِ كلِّ يومٍ ومَساءِ كلِّ لَيلةٍ : بسمِ اللَّهِ الَّذي لا يضرُّ معَ اسمِهِ شيءٌ في الأرضِ ولَا في السَّماءِ ، وَهوَ السَّميعُ العليمُ ثلاثَ مرَّاتٍ","result":"فيضُرَّهُ شيءٌ","explicit":true,"apply":{"k":"say","t":"«بسمِ اللَّهِ الَّذي لا يضرُّ معَ اسمِهِ شيءٌ في الأرضِ ولَا في السَّماءِ ، وَهوَ السَّميعُ العليم» · الوقت: صباحاً ومساءً"},"ref":"صحيح الترمذي 3388","srcLabel":"الترمذي","text":[["ما مِن عبدٍ يقولُ في صباحِ كلِّ يومٍ ومَساءِ كلِّ لَيلةٍ : بسمِ اللَّهِ الَّذي لا يضرُّ معَ اسمِهِ شيءٌ في الأرضِ ولَا في السَّماءِ ، وَهوَ السَّميعُ العليمُ ثلاثَ مرَّاتٍ",1]," ، ",["فيضُرَّهُ شيءٌ",2]," وَكانَ أبانُ ، قد أصابَهُ طرفُ فالجٍ ، فجعلَ الرَّجلُ ينظرُ إليهِ ، فقالَ لَهُ أبانُ : ما تنظرُ ؟ أما إنَّ الحديثَ كما حدَّثتُكَ ، ولَكِنِّي لم أقلهُ يَومئذٍ ليُمْضيَ اللَّهُ علَيَّ قدرَهُ"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (3388)، والنسائي في ((السنن الكبرى)) (10178)، وابن ماجه (3869)","bab":"أدعية وأذكار › فضل الذكر","dorar":"SXhnxc9r"},{"id":"س-01016","fp":"58ecb63a508a","stateId":339,"easy":"إذا قلت مساءً «بسم الله الذي لا يضر...» ثلاثاً ← لا يصيبك فجأة بلاء حتى تصبح","cause":"مَنْ قال حِينَ يُمسِي : بِسمِ اللهِ الَّذي لا يَضُرُّ مع اسْمِه شيءٌ في الأرضِ ولا في السماءِ ، وهوَ السميعُ العليمُ ، ثلاثَ مرَّاتٍ","result":"لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُصبِحَ","explicit":true,"apply":{"k":"say","t":"«بِسمِ اللهِ الَّذي لا يَضُرُّ مع اسْمِه شيءٌ في الأرضِ ولا في السماءِ ، وهوَ السميعُ العليمُ» · الوقت: في المساء"},"repOf":"س-00675","ref":"صحيح الجامع 6426","text":[["مَنْ قال حِينَ يُمسِي : بِسمِ اللهِ الَّذي لا يَضُرُّ مع اسْمِه شيءٌ في الأرضِ ولا في السماءِ ، وهوَ السميعُ العليمُ ، ثلاثَ مرَّاتٍ ، ",1],["لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُصبِحَ ، ",2],"ومَنْ قالَها حِينَ يُصبِحُ ثلاثَ مرَّاتٍ ، لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُمسِي"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5088)، والترمذي (3388)، والنسائي في ((السنن الكبرى)) (9843)، وابن ماجه (3869)، وأحمد (446) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"J9ocOyNQ"},{"id":"س-01017","fp":"845bbb9aba6f","stateId":339,"easy":"إذا قلتها صباحاً ثلاثاً ← لا يصيبك فجأة بلاء حتى تمسي","cause":"ومَنْ قالَها حِينَ يُصبِحُ ثلاثَ مرَّاتٍ","result":"لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُمسِي","explicit":true,"apply":{"k":"time","t":"في الصباح"},"repOf":"س-00676","ref":"صحيح الجامع 6426","text":["مَنْ قال حِينَ يُمسِي : بِسمِ اللهِ الَّذي لا يَضُرُّ مع اسْمِه شيءٌ في الأرضِ ولا في السماءِ ، وهوَ السميعُ العليمُ ، ثلاثَ مرَّاتٍ ، لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُصبِحَ ، ",["ومَنْ قالَها حِينَ يُصبِحُ ثلاثَ مرَّاتٍ ، ",1],["لمْ يُصِبْهُ فَجْأَةُ بَلاَءٍ حتى يُمسِي",2]],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5088)، والترمذي (3388)، والنسائي في ((السنن الكبرى)) (9843)، وابن ماجه (3869)، وأحمد (446) باختلاف يسير","bab":"أدعية وأذكار › فضل الذكر","dorar":"J9ocOyNQ"},{"id":"س-01044","fp":"aa4d5ba3f72a","stateId":339,"easy":"إذا قلت صباحاً ثلاثاً «بسم الله الذي لا يضر...» ← لا يفجؤك بلاء حتى تمسي","cause":"مَن قال حينَ يُصبِحُ ثلاثَ مرَّاتٍ : بسمِ اللهِ الَّذي لا يضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السَّميعُ العليمُ","result":"لَمْ تفجَأْه فاجئةُ بلاءٍ حتَّى يُمسيَ","explicit":true,"apply":{"k":"say","t":"«بسمِ اللهِ الَّذي لا يضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السَّميعُ العليمُ لَمْ تفجَأْه فاجئةُ بلاء» · الوقت: في الصباح"},"repOf":"س-00676","ref":"تخريج صحيح ابن حبان 862","text":[["مَن قال حينَ يُصبِحُ ثلاثَ مرَّاتٍ : بسمِ اللهِ الَّذي لا يضُرُّ مع اسمِه شيءٌ في الأرضِ ولا في السَّماءِ وهو السَّميعُ العليمُ",1]," ",["لَمْ تفجَأْه فاجئةُ بلاءٍ حتَّى يُمسيَ",2]," ومَن قالها حينَ يُمسي لَمْ تفجَأْه فاجئةُ بلاءٍ حتَّى يُصبِحَ ) وقد كان أصابه الفالِجُ فقيل له : أينَ ما كُنْتَ تُحدِّثُنا به ؟ قال : إنَّ اللهَ حينَ أراد بي ما أراد أنسانيها"],"grade":"صحيح","narrator":"عثمان بن عفان","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (862) واللفظ له، والخرائطي في ((مكارم الأخلاق)) (871) باختلاف يسير، وأبو داود (5088)، والترمذي (3388) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"vpcKTSrj"},{"id":"س-00829","fp":"4f616109f858","stateId":339,"easy":"إذا قلت «أمسينا وأمسى الملك لله... أعوذ بالله الذي يمسك السماء...» ← تُعصم من كل ساحر وكاهن وشيطان وحاسد","cause":"أمسَيْنا وأمسى المُلْكُ للهِ والحمدُ للهِ أعوذُ باللهِ الَّذي يُمْسِكُ السَّماءَ أن تقَعَ على الأرضِ إلَّا بإذنِه مِن شرِّ ما خلَق وذرَأ وبرَأ","result":"مَن قالهنَّ عُصِمَ مِن كلِّ ساحرٍ وكاهنٍ وشيطانٍ وحاسدٍ","explicit":true,"apply":{"k":"say","t":"«أمسَيْنا وأمسى المُلْكُ للهِ والحمدُ للهِ أعوذُ باللهِ الَّذي يُمْسِكُ السَّماء»"},"ref":"مجمع الزوائد 10/122","srcLabel":"الطبراني","text":[["أمسَيْنا وأمسى المُلْكُ للهِ والحمدُ للهِ أعوذُ باللهِ الَّذي يُمْسِكُ السَّماءَ أن تقَعَ على الأرضِ إلَّا بإذنِه مِن شرِّ ما خلَق وذرَأ وبرَأ",1]," ",["مَن قالهنَّ عُصِمَ مِن كلِّ ساحرٍ وكاهنٍ وشيطانٍ وحاسدٍ",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"رجاله ثقات وفي بعضهم خلاف","takhrij":"أخرجه الخرائطي في ((مساوئ الأخلاق)) (727)، والطبراني (4/ 310)، (4291) كلاهما بلفظه.","bab":"أدعية وأذكار › دعوات النبي صلى الله عليه وسلم","dorar":"77DmKG59"},{"id":"س-00917","fp":"0a0bb0861c52","stateId":339,"easy":"إذا قرأت أول سورة غافر وآية الكرسي صباحاً ← تُحفظ بهما حتى تمسي","cause":"من قرأَ { حم } المؤمِنَ إلى { إِليهِ الْمَصِيرُ } وآيةَ الكرسيِّ حينَ يصبحُ","result":"حفظَ بهما حتَّى يمسيَ","explicit":true,"apply":{"k":"time","t":"في الصباح"},"ref":"هداية الرواة 2/376","srcLabel":"الترمذي","text":[["من قرأَ { حم } المؤمِنَ إلى { إِليهِ الْمَصِيرُ } وآيةَ الكرسيِّ حينَ يصبحُ",1]," ",["حفظَ بهما حتَّى يمسيَ",2]," ومن قرأَهما حينَ يمسي حُفِظَ بهما حتَّى يصبح"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2879) واللفظ له، وابن السني في ((عمل اليوم والليلة)) (76)، وأبو نعيم في ((تاريخ أصبهان)) (1/281)","bab":"أدعية وأذكار › فضل الذكر","dorar":"xifGe1FS"},{"id":"س-00918","fp":"32364ef02a76","stateId":339,"easy":"إذا قرأتهما مساءً ← تُحفظ بهما حتى تصبح","cause":"ومن قرأَهما حينَ يمسي","result":"حُفِظَ بهما حتَّى يصبح","explicit":true,"apply":{"k":"time","t":"في المساء"},"ref":"هداية الرواة 2/376","srcLabel":"الترمذي","text":["من قرأَ { حم } المؤمِنَ إلى { إِليهِ الْمَصِيرُ } وآيةَ الكرسيِّ حينَ يصبحُ حفظَ بهما حتَّى يمسيَ ",["ومن قرأَهما حينَ يمسي",1]," ",["حُفِظَ بهما حتَّى يصبح",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"[حسن كما قال في المقدمة]","takhrij":"أخرجه الترمذي (2879) واللفظ له، وابن السني في ((عمل اليوم والليلة)) (76)، وأبو نعيم في ((تاريخ أصبهان)) (1/281)","bab":"أدعية وأذكار › فضل الذكر","dorar":"xifGe1FS"},{"id":"س-03591","fp":"82500ab6466a","stateId":339,"easy":"إذا قلت صباحاً ومساءً «اللهم فاطر السماوات والأرض... نعوذ بك من شر أنفسنا» ← تُعاذ من الشر","cause":"إذا أصبَحْنا وأمسَيْنا واضطَجَعْنا","result":"فإنَّا نعوذُ بكَ من شرِّ أنفُسِنا، ومن شرِّ الشَّيطانِ الرَّجيمِ وشِرْكِه، وأنْ نقترِفَ سُوءًا على أنفُسِنا، أو نجُرَّه إلى مُسلِمٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللهم فاطر السماوات والأرض... نعوذ بك من شر أنفسنا» · الوقت: صباحاً ومساءً"},"ref":"تخريج سنن أبي داود 5083","srcLabel":"أبو داود","text":["قالوا: يا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، حدِّثْنا بكَلِمةٍ نقولُها ",["إذا أصبَحْنا وأمسَيْنا واضطَجَعْنا",1],"، فأمَرَهم أنْ يَقولوا: اللَّهُمَّ فاطِرَ السَّمواتِ والأرضِ، عالِمَ الغَيبِ والشَّهادةِ، أنتَ ربُّ كُلِّ شَيءٍ، والملائكةُ يَشهَدونَ أنَّك لا إلهَ إلَّا أنتَ، ",["فإنَّا نعوذُ بكَ من شرِّ أنفُسِنا، ومن شرِّ الشَّيطانِ الرَّجيمِ وشِرْكِه، وأنْ نقترِفَ سُوءًا على أنفُسِنا، أو نجُرَّه إلى مُسلِمٍ",2],"."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (5083) بلفظه، والطبراني (3/ 295)، (3450) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"Br6otCIB"},{"id":"س-00790","fp":"8413482d2d8c","stateId":340,"easy":"إذا أويت إلى فراشك فانفضه ثلاثاً ← فإنك لا تدري ما خلفك عليه","cause":"فلينفُضْهُ بصنفةِ إزارِهِ ثلاثَ مرَّاتٍ","result":"فإنَّهُ لا يدري ما خلفَهُ عليهِ بعدَهُ","explicit":true,"star":true,"apply":{"k":"time","t":"عند النوم"},"ref":"نتائج الأفكار 1/112","srcLabel":"متفق عليه","text":["إذا قامَ أحدُكُم عن فراشِهِ ثمَّ رجعَ إليهِ ",["فلينفُضْهُ بصنفةِ إزارِهِ ثلاثَ مرَّاتٍ",1]," ",["فإنَّهُ لا يدري ما خلفَهُ عليهِ بعدَهُ",2]," فإذا أخذا المضجَعَ فليقُل باسمِكَ ربِّي وضَعتُ جنبي وبكَ أرفعُهُ إن أمسَكتَ نفسي فارحَمْها وإن أرسلتَها فاحفظْها بما تحفظُ بهِ عبادَكَ الصَّالحينَ فإذا استيقظَ فليقُلِ الحمدُ للَّهِ الَّذي عافاني في جسَدي وردَّ عليَّ روحي وأذِنَ لي بذِكرِه"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن من هذا الوجه بهذا السياق، وأصل شطره الأول صحيح","takhrij":"أخرجه الترمذي (3401) باختلاف يسير، والنسائي في ((السنن الكبرى)) (10636،10559)، وابن السني في ((عمل اليوم والليلة)) (9، 710) مفرقاً باختلاف يسير. وأخرجه البخاري (7393)، ومسلم (2714) دون قوله: \"فإذا استيقظ ...\"","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"NvMI7pBe","merged":3,"otherRefs":["ما تمس إليه الحاجة 128 (صحيح)","تخريج المسند لشعيب 7811 (صحيح)"]},{"id":"س-00994","fp":"ff5eb3cb0abf","stateId":340,"easy":"إذا ذكرت الله قبل نومك ← يذهب الشيطان ويبيت الملك يحرسك","cause":"فإنْ ذَكَرَ اللهَ","result":"ذَهَبَ الشَّيطانُ وباتَ الملَكُ يَكلَؤهُ","explicit":true,"star":true,"ref":"المستدرك على الصحيحين 2037","srcLabel":"مسلم","text":["إذا أَوى أَحدُكُم إلى فِراشِه ابتدَرَهُ ملَكٌ وشَيطانٌ، يقولُ الشَّيطانُ: افتحْ بِشرٍّ، ويقولُ الملَكُ: افتحْ بخيرٍ، ",["فإنْ ذَكَرَ اللهَ",1]," ",["ذَهَبَ الشَّيطانُ وباتَ الملَكُ يَكلَؤهُ",2],"، وإذا استَيقَظَ ابتدَرَهُ ملَكٌ وشَيطانٌ، يقولُ الشَّيطانُ: افتحْ بِشرٍّ، ويقولُ الملَكُ: افتحْ بخيرٍ، فإنْ قالَ: الحمدُ للهِ الَّذي ردَّ إليَّ نَفسي بعدَ موتِها ولمْ يُمِتْها في نَومِها، الحمدُ للهِ الَّذي يُمسِكُ السَّماءَ أنْ تَقَعَ على الأرضِ إلَّا بإذنِهِ، إنَّ اللهَ بالنَّاسِ لرَؤوفٌ رَحيمٌ، الحمدُ للهِ الَّذي يُحيِي المَوْتى وهو على كُلِّ شيءٍ قديرٌ؛ فإنْ خَرَّ مِن دابَّةٍ ماتَ شهيدًا، وإنْ قامَ فصَلَّى صَلَّى في الفضائلِ."],"grade":"صحيح","narrator":"جابر","muhaddith":"صحيح على شرط مسلم","bab":"أدعية وأذكار › فضل الذكر","dorar":"IGFuJdDk","merged":2,"otherRefs":["الحرز الثمين 2/595 (صحيح)"]},{"id":"س-00789","fp":"f2ec6cd203b1","stateId":340,"easy":"إذا قرأت الآيتين من آخر البقرة في ليلة ← تكفيانك","cause":"الآيَتَانِ مِن آخِرِ سُورَةِ البَقَرَةِ مَن قَرَأَهُما في لَيْلَةٍ","result":"كَفَتَاهُ","explicit":true,"ref":"كشف الخفاء 2/565","srcLabel":"كشف الخفاء","text":["حديث  من قَرَأ آيتينِ من آخرِ سورةِ البقرةِ في كل ليلة كَفَتاهُ [يعني حديث:  لَقِيتُ أَبَا مَسْعُودٍ عِنْدَ البَيْتِ، فَقُلتُ: حَدِيثٌ بَلَغَنِي عَنْكَ في الآيَتَيْنِ في سُورَةِ البَقَرَةِ، فَقالَ: نَعَمْ، قالَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ: ",["الآيَتَانِ مِن آخِرِ سُورَةِ البَقَرَةِ مَن قَرَأَهُما في لَيْلَةٍ",1]," ",["كَفَتَاهُ",2],".]"],"grade":"صحيح","narrator":"[أبو مسعود عقبة بن عمرو]","muhaddith":"صحيح","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"gk0SlNXB","merged":3,"otherRefs":["صحيح مسلم 808 (صحيح)","صحيح البخاري 5008 (صحيح)"]},{"id":"س-00794","fp":"ddff8706be40","stateId":340,"easy":"إذا قرأت آية الكرسي عند نومك ← لا يزال عليك من الله حافظ ولا يقربك شيطان حتى تصبح","cause":"إذَا أوَيْتَ إلى فِرَاشِكَ فَاقْرَأْ آيَةَ الكُرْسِيِّ مِن أوَّلِهَا حتَّى تَخْتِمَ الآيَةَ: اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ","result":"لَنْ يَزَالَ عَلَيْكَ مِنَ اللَّهِ حَافِظٌ، ولَا يَقْرَبَكَ شيطَانٌ حتَّى تُصْبِحَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"similar":["س-02509","س-02518","س-00788"],"ref":"كشف الخفاء 2/565","srcLabel":"كشف الخفاء","text":["حديث  لَقَدْ صَدَقَكَ وإنه لَكَذُوبٌ في فضلِ آيةِ الكُرْسِيِّ [يعني حديث: وَكَّلَنِي رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ بحِفْظِ زَكَاةِ رَمَضَانَ، فأتَانِي آتٍ فَجَعَلَ يَحْثُو مِنَ الطَّعَامِ، فأخَذْتُهُ وقُلتُ: واللَّهِ لَأَرْفَعَنَّكَ إلى رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قَالَ: إنِّي مُحْتَاجٌ، وعَلَيَّ عِيَالٌ، ولِي حَاجَةٌ شَدِيدَةٌ، قَالَ: فَخَلَّيْتُ عنْه، فأصْبَحْتُ، فَقَالَ النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: يا أبَا هُرَيْرَةَ ، ما فَعَلَ أسِيرُكَ البَارِحَةَ؟ قَالَ: قُلتُ: يا رَسولَ اللَّهِ، شَكَا حَاجَةً شَدِيدَةً وعِيَالًا، فَرَحِمْتُهُ، فَخَلَّيْتُ سَبِيلَهُ، قَالَ: أَمَا إنَّه قدْ كَذَبَكَ، وسَيَعُودُ، فَعَرَفْتُ أنَّه سَيَعُودُ؛ لِقَوْلِ رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: إنَّه سَيَعُودُ، فَرَصَدْتُهُ، فَجَاءَ يَحْثُو مِنَ الطَّعَامِ، فأخَذْتُهُ، فَقُلتُ: لَأَرْفَعَنَّكَ إلى رَسولِ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ، قَالَ: دَعْنِي؛ فإنِّي مُحْتَاجٌ، وعَلَيَّ عِيَالٌ، لا أعُودُ، فَرَحِمْتُهُ، فَخَلَّيْتُ سَبِيلَهُ، فأصْبَحْتُ، فَقَالَ لي رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: يا أبَا هُرَيْرَةَ ، ما فَعَلَ أسِيرُكَ، قُلتُ: يا رَسولَ اللَّهِ، شَكَا حَاجَةً شَدِيدَةً وعِيَالًا، فَرَحِمْتُهُ، فَخَلَّيْتُ سَبِيلَهُ، قَالَ: أَمَا إنَّه قدْ كَذَبَكَ وسَيَعُودُ، فَرَصَدْتُهُ الثَّالِثَةَ، فَجَاءَ يَحْثُو مِنَ الطَّعَامِ، فأخَذْتُهُ، فَقُلتُ: لَأَرْفَعَنَّكَ إلى رَسولِ اللَّهِ، وهذا آخِرُ ثَلَاثِ مَرَّاتٍ أنَّكَ تَزْعُمُ لا تَعُودُ ثُمَّ تَعُودُ، قَالَ: دَعْنِي أُعَلِّمْكَ كَلِمَاتٍ يَنْفَعُكَ اللَّهُ بهَا، قُلتُ: ما هُوَ؟ قَالَ: إذَا أوَيْتَ إلى فِرَاشِكَ، فَاقْرَأْ آيَةَ الكُرْسِيِّ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ} [البقرة: 255]، حتَّى تَخْتِمَ الآيَةَ؛ فإنَّكَ لَنْ يَزَالَ عَلَيْكَ مِنَ اللَّهِ حَافِظٌ، ولَا يَقْرَبَنَّكَ شَيطَانٌ حتَّى تُصْبِحَ. فَخَلَّيْتُ سَبِيلَهُ، فأصْبَحْتُ، فَقَالَ لي رَسولُ اللَّهِ صَلَّى اللهُ عليه وسلَّمَ: ما فَعَلَ أسِيرُكَ البَارِحَةَ؟ قُلتُ: يا رَسولَ اللَّهِ، زَعَمَ أنَّه يُعَلِّمُنِي كَلِمَاتٍ يَنْفَعُنِي اللَّهُ بهَا، فَخَلَّيْتُ سَبِيلَهُ، قَالَ: ما هي؟ قُلتُ: قَالَ لِي: ",["إذَا أوَيْتَ إلى فِرَاشِكَ فَاقْرَأْ آيَةَ الكُرْسِيِّ مِن أوَّلِهَا حتَّى تَخْتِمَ الآيَةَ: {اللَّهُ لَا إِلَهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ",1],"} [البقرة: 255]، وقَالَ لِي: ",["لَنْ يَزَالَ عَلَيْكَ مِنَ اللَّهِ حَافِظٌ، ولَا يَقْرَبَكَ شيطَانٌ حتَّى تُصْبِحَ",2]," -وكَانُوا أحْرَصَ شَيءٍ علَى الخَيْرِ- فَقَالَ النَّبيُّ صَلَّى اللهُ عليه وسلَّمَ: أَمَا إنَّه قدْ صَدَقَكَ، وهو كَذُوبٌ، تَعْلَمُ مَن تُخَاطِبُ مُنْذُ ثَلَاثِ لَيَالٍ يا أبَا هُرَيْرَةَ؟ قَالَ: لَا، قَالَ: ذَاكَ شَيطانٌ.]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"OoepGnas","merged":2,"otherRefs":["صحيح ابن خزيمة 4/ 152 (صحيح)"]},{"id":"س-03737","fp":"8e9ce0785b27","stateId":340,"easy":"إذا أخذت مضجعك فقل «اللهم خلقت نفسي... إن أحييتها فاحفظها» ← تُحفظ","cause":"إذا أخَذَ مَضجَعَه","result":"إن أحيَيتَها فاحفَظْها، وإن أمَتَّها فاغفِرْ لَها، اللَّهمَّ إنِّي أسألُكَ العافيةَ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللَّهمَّ خَلَقتَ نَفسي، وأنتَ تَوفَّاها، لكَ مَماتُها ومَحياها، إن أحيَيتَها فاحفَظْها» · الوقت: عند النوم"},"otherNeedIds":[35],"ref":"صحيح مسلم 2712","srcLabel":"مسلم","text":["أنَّه أمَرَ رَجُلًا ",["إذا أخَذَ مَضجَعَه",1]," قال: اللَّهمَّ خَلَقتَ نَفسي، وأنتَ تَوفَّاها، لكَ مَماتُها ومَحياها، ",["إن أحيَيتَها فاحفَظْها، وإن أمَتَّها فاغفِرْ لَها، اللَّهمَّ إنِّي أسألُكَ العافيةَ",2],". فقال له رَجُلٌ: أسَمِعتَ هذا مِن عُمَرَ؟ فقال: مِن خَيرٍ مِن عُمَرَ؛ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عبد الله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2712) بلفظه.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"IVGIPfWR"},{"id":"س-02509","fp":"6a3f2f50d861","stateId":340,"easy":"إذا قرأت آية الكرسي عند نومك ← لا يزال عليك حافظ من الله ولا يقربك شيطان حتى تصبح","cause":"مَن قرأها [يعني : آيةَ الكرسيِّ] عندَ النومِ","result":"لا يزالُ عليه من اللهِ حافظٌ , ولا يقربُه شيطانٌ حتى يُصبِحَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-00794","ref":"مجموع فتاوى ابن باز 454/3","text":["أن ",["مَن قرأها [يعني : آيةَ الكرسيِّ] عندَ النومِ",1]," ",["لا يزالُ عليه من اللهِ حافظٌ , ولا يقربُه شيطانٌ حتى يُصبِحَ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"إيمان › أعمال الجن والشياطين","dorar":"XqIIn1rz"},{"id":"س-02518","fp":"11c6325dd8ae","stateId":340,"easy":"إذا قرأت آية الكرسي في ليلة ← لا يزال عليك حافظ من الله ولا يقربك شيطان","cause":"آيةِ الكُرسيِّ: فإنَّ مَن قَرَأها في لَيلةٍ","result":"لم يَزَلْ عليه مِن اللهِ حافظٌ، ولا يَقرَبُه شَيطانٌ حتَّى يُصبِحَ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-00794","ref":"فتاوى نور على الدرب لابن عثيمين 12/620","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّمَ في ",["آيةِ الكُرسيِّ: فإنَّ مَن قَرَأها في لَيلةٍ",1],"، ",["لم يَزَلْ عليه مِن اللهِ حافظٌ، ولا يَقرَبُه شَيطانٌ حتَّى يُصبِحَ",2],"."],"grade":"صحيح","muhaddith":"[ثابت]","bab":"إيمان › أعمال الجن والشياطين","dorar":"0HKamH7h"},{"id":"س-06406","fp":"6775b5eba2b9","stateId":340,"easy":"إذا قرأتها حين تأخذ مضجعك ← يؤمّنك الله على دارك ودار جارك وما حولها","cause":"ومن قرأها حينَ يأخذُ مضجعَهُ","result":"آمنَهُ اللَّهُ على دارِهِ ودارِ جارِهِ ، ودويراتٍ حولَهُ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"هداية الرواة 1/436","srcLabel":"البيهقي","text":["من قرأَ آيةَ الكرسيِّ في دُبرِ كلِّ صلاةٍ ؛ لم يمنعْهُ من دخولِ الجنَّةِ إلَّا الموتُ ، ",["ومن قرأها حينَ يأخذُ مضجعَهُ",1]," ؛ ",["آمنَهُ اللَّهُ على دارِهِ ودارِ جارِهِ ، ودويراتٍ حولَهُ",2]],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"له شاهد صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (2395)، وابن الجوزي في ((الموضوعات)) (1/243) باختلاف يسير","bab":"صلاة › أدعية دبر الصلوات","dorar":"UvvMmMtc"},{"id":"س-07650","fp":"4a8ddae3dccb","stateId":340,"easy":"إذا قرأت الفاتحة والإخلاص عند نومك ← تأمن من كل شيء إلا الموت","cause":"إذا وضَعتَ جنبَكَ على الفِراشِ وقرأتَ فاتحةَ الكتابِ وقُلْ هوَ اللَّهُ أحدٌ","result":"فقد أمِنتَ مِن كلِّ شيءٍ إلَّا الموتَ","explicit":true,"apply":{"k":"read","t":"الفاتحة والإخلاص"},"otherNeedIds":[6],"ref":"الترغيب والترهيب 1/284","srcLabel":"البزار","text":[["إذا وضَعتَ جنبَكَ على الفِراشِ وقرأتَ فاتحةَ الكتابِ وقُلْ هوَ اللَّهُ أحدٌ ",1],["فقد أمِنتَ مِن كلِّ شيءٍ إلَّا الموتَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"رجاله رجال الصحيح إلا غسان بن عبيد","takhrij":"أخرجه البزار (7393)","bab":"فضائل سور وآيات › سورة الإخلاص","dorar":"3o1orzsz"},{"id":"س-08160","fp":"30df4d65845a","stateId":340,"easy":"إذا قرأت سورة عند نومك ← يبعث الله إليك ملكاً يحفظك من كل أذى","cause":"ما مِن رجل يأوي إلى فراشِه فيقرَأُ سورةً مِن كتابِ اللهِ عَزَّ وجَلَّ","result":"إلَّا بعَث اللهُ عَزَّ وجَلَّ إليه مَلَكًا يحفَظُه مِن كلِّ شيءٍ يُؤذيه حتَّى يهُبَّ متى هبَّ","explicit":true,"similar":["س-08131"],"ref":"مجمع الزوائد 10/123","srcLabel":"مجمع الزوائد","text":[["ما مِن رجل يأوي إلى فراشِه فيقرَأُ سورةً مِن كتابِ اللهِ عَزَّ وجَلَّ",1]," ",["إلَّا بعَث اللهُ عَزَّ وجَلَّ إليه مَلَكًا يحفَظُه مِن كلِّ شيءٍ يُؤذيه حتَّى يهُبَّ متى هبَّ",2]],"grade":"صحيح","narrator":"شداد بن أوس","muhaddith":"رجاله رجال الصحيح","bab":"ملائكة › أعمال الملائكة","dorar":"ZyvBFmLF"},{"id":"س-08131","fp":"0b42d580f0aa","stateId":340,"easy":"إذا قرأت سورة من القرآن عند نومك ← يوكل الله بك ملكاً يحفظك","cause":"ما مِن مُسلِمٍ يَأْوي إلى فِراشِه، فيَقرأُ سورةً مِن كِتابِ اللهِ تَعالى حينَ يأخُذُ مَضجَعَه","result":"إلَّا وَكَّلَ اللهُ عَزَّ وجَلَّ به مَلَكًا، لا يَدَعُ شَيئًا يَقرَبُه يُؤذيه؛ حتى يَهُبَّ متى هَبَّ","explicit":true,"repOf":"س-08160","ref":"الفتوحات الربانية 3/162","text":[["ما مِن مُسلِمٍ يَأْوي إلى فِراشِه، فيَقرأُ سورةً مِن كِتابِ اللهِ تَعالى حينَ يأخُذُ مَضجَعَه",1]," ",["إلَّا وَكَّلَ اللهُ عَزَّ وجَلَّ به مَلَكًا، لا يَدَعُ شَيئًا يَقرَبُه يُؤذيه؛ حتى يَهُبَّ متى هَبَّ",2],"."],"grade":"حسن","narrator":"شداد بن أوس","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3407) واللفظ له.","bab":"ملائكة › أعمال الملائكة","dorar":"NgAEZL6f","merged":2,"otherRefs":["فيض القدير 5/ 495 (حسن)"]},{"id":"س-01120","fp":"92b7221eacb5","stateId":340,"easy":"إذا قلت عند تقلبك في الليل «بسم الله» و«سبحان الله» و«آمنت بالله وكفرت بالطاغوت» عشراً ← تُوقى كل ما تخاف","cause":"مَن قال حينَ يتحرَّكُ مِنَ اللَّيلِ بسمِ اللهِ عشْرَ مرَّاتٍ وسُبحانَ اللهِ عشْرًا آمَنْتُ باللهِ","result":"وكفَرْتُ بالطَّاغوتِ عشْرًا وُقِيَ كلَّ شيءٍ يتخوَّفُه ولم ينبَغِ لذنبٍ أن يُدرِكَه إلى مِثلِها","explicit":true,"apply":{"k":"say","t":"«بسم الله» ثم «سبحان الله» ثم «آمنت بالله وكفرت بالطاغوت»"},"otherNeedIds":[11],"ref":"مجمع الزوائد 10/128","srcLabel":"الطبراني","text":[["مَن قال حينَ يتحرَّكُ مِنَ اللَّيلِ بسمِ اللهِ عشْرَ مرَّاتٍ وسُبحانَ اللهِ عشْرًا آمَنْتُ باللهِ ",1],["وكفَرْتُ بالطَّاغوتِ عشْرًا وُقِيَ كلَّ شيءٍ يتخوَّفُه ولم ينبَغِ لذنبٍ أن يُدرِكَه إلى مِثلِها",2]],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (9017)","bab":"أدعية وأذكار › فضل الذكر","dorar":"j3UVj1L9"},{"id":"س-03243","fp":"998e3e9cb7e4","stateId":340,"easy":"إذا قلت عند نومك «أعوذ بكلمات الله التامات من غضبه وعقابه وشر عباده...» ← لا يضرك شيء حتى تصبح","cause":"إذا أتيتَ فراشَكَ فقُلْ : أعوذُ بكلماتِ اللهِ التاماتِ مِن غضبِه وعقابِه وشرِّ عبادِه ومِن همزاتِ الشياطينِ وأن يَحضُرونَ","result":"لا يضُرُّكَ شيءٌ حتى تُصبِحَ","explicit":true,"apply":{"k":"say","t":"«أعوذُ بكلماتِ اللهِ التاماتِ مِن غضبِه وعقابِه وشرِّ عبادِه ومِن همزاتِ الشياطينِ وأن يَحضُرونَ فوالذي نفْسي بيدِه لا يضُرُّكَ شيءٌ حتى تُصبِحَ وبالحَرِيِّ أن لا يَفوتَك»"},"otherNeedIds":[6],"ref":"إتحاف الخيرة المهرة 6/402","srcLabel":"أحمد","text":["أنَّ الوليدَ بنَ الوليدِ ، شَكى إلى النبيِّ صلَّى اللهُ عليه وسلَّم حديثَ نفسٍ وجَده ، فقال : ",["إذا أتيتَ فراشَكَ فقُلْ : أعوذُ بكلماتِ اللهِ التاماتِ مِن غضبِه وعقابِه وشرِّ عبادِه ومِن همزاتِ الشياطينِ وأن يَحضُرونَ",1]," فوالذي نفْسي بيدِه ",["لا يضُرُّكَ شيءٌ حتى تُصبِحَ",2]," وبالحَرِيِّ أن لا يَفوتَكَ"],"grade":"حسن","narrator":"محمد بن يحيى بن حبان","muhaddith":"رجاله ثقات","takhrij":"أخرجه مسدد كما في ((إتحاف الخيرة المهرة)) (6094)، وابن السني في ((عمل اليوم والليلة)) (638) بلفظه، وأحمد (16573) بنحوه.","bab":"استعاذة › التعوذ","dorar":"m1LPc6gf"},{"id":"س-03613","fp":"a917c0f8613b","stateId":340,"easy":"إذا أخذت مضجعك فقل «أعوذ بوجهك الكريم وكلماتك التامة...» ← تُحفظ","cause":"إذا أخَذْتَ مَضجَعَك","result":"فقُلْ: أعوذُ بوَجْهِك الكَريمِ وكَلِماتِك التَّامَّةِ، مِن شَرِّ ما أنت آخِذٌ بناصيتِه، اللَّهُمَّ أنت تَكشِفُ المغرَمَ والمأثَمَ، اللَّهُمَّ لا يُهزَمُ جُندُك، ولا يُخلَفُ وَعدُك، ولا يَنفَعُ ذا الجَدِّ منك الجَدُّ، سُبحانَك وبحَمْدِك","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«أعوذُ بوَجْهِك الكَريمِ وكَلِماتِك التَّامَّةِ، مِن شَرِّ ما أنت آخِذٌ بناصيتِه، اللَّهُمَّ أنت تَكشِفُ المغرَمَ والمأثَمَ، اللَّهُمَّ لا يُهزَمُ جُندُك، ولا يُخلَفُ وَعدُك، ولا يَنفَعُ ذا الجَدِّ منك الجَدُّ، سُبحانَك وبحَمْدِك» · الوقت: عند النوم"},"ref":"الأسماء والصفات للبيهقي 2/33","srcLabel":"أبو داود","text":["كَتَب لي عَلِيُّ بنُ أبي طالِبٍ رَضِيَ اللهُ عنه كِتابًا قال: أمَرَني به رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، قال: ",["إذا أخَذْتَ مَضجَعَك",1]," ",["فقُلْ: أعوذُ بوَجْهِك الكَريمِ وكَلِماتِك التَّامَّةِ، مِن شَرِّ ما أنت آخِذٌ بناصيتِه، اللَّهُمَّ أنت تَكشِفُ المغرَمَ والمأثَمَ، اللَّهُمَّ لا يُهزَمُ جُندُك، ولا يُخلَفُ وَعدُك، ولا يَنفَعُ ذا الجَدِّ منك الجَدُّ، سُبحانَك وبحَمْدِك",2],"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (5052)، والنسائي في ((السنن الكبرى)) (7685) باختلاف يسير.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"NQEZ5vj9"},{"id":"س-08147","fp":"2609dc97b0ea","stateId":340,"easy":"إذا قرأت سورة من القرآن عند نومك ← يوكل الله بك ملكاً لا يقربك شيء حتى تستيقظ","cause":"ما مِن عبدٍ يقرأُ سورةً مِن كتابِ اللهِ عندَ نومِه","result":"إلا وكَّل اللهُ به ملَكًا لا يقربُه شيءٌ حتى يهبَّ متى هبَّ","explicit":true,"ref":"نتائج الأفكار 3/74","srcLabel":"أحمد","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يعلمُنا أن نقولَ في صلاتِنا : اللهم إنا نسألُكَ التثبتَ في الأمرِ الحديثِ . وفيه وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ",["ما مِن عبدٍ يقرأُ سورةً مِن كتابِ اللهِ عندَ نومِه",1]," ",["إلا وكَّل اللهُ به ملَكًا لا يقربُه شيءٌ حتى يهبَّ متى هبَّ",2]],"grade":"حسن","narrator":"شداد بن أوس","muhaddith":"حسن","takhrij":"أخرجه أحمد (17132)، وابن السني في ((عمل اليوم والليلة)) (صـ673)، والطبراني في ((الدعاء)) (275) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"v2uZgx36"},{"id":"س-00788","fp":"56abc8d2bd1d","stateId":340,"easy":"إذا قرأت آية الكرسي عند منامك ← لا يزال معك من الله حافظ","cause":"مَن يقرؤُها عند منامِه","result":"أنَّه لا يزالُ مع مَن يقرؤُها عند منامِه مِن اللهِ حافِظٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-00794","ref":"الأجوبة المرضية 2/668","text":[["أنَّه لا يزالُ مع مَن يقرؤُها عند منامِه مِن اللهِ حافِظٌ",2],"."],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"PMgEve1x"},{"id":"س-00795","fp":"12aae5a035e5","stateId":340,"easy":"إذا قرأت آية الكرسي عند النوم ← يحفظك الله من الشيطان وكل سوء","cause":"قراءةِ آيةِ الكرسيِّ عندَ النَّومِ","result":"من أسبابِ حفظِ العبدِ من الشيطانِ ومن كلِّ سوءٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"apply":{"k":"read","t":"آية الكرسي · الوقت: عند النوم"},"ref":"مجموع فتاوى ابن باز 50/11","srcLabel":"مجموع فتاوى ابن باز","text":["[حديثُ ",["قراءةِ آيةِ الكرسيِّ عندَ النَّومِ",1]," ",["من أسبابِ حفظِ العبدِ من الشيطانِ ومن كلِّ سوءٍ",2],"]"],"grade":"صحيح","muhaddith":"صحيح","bab":"أدعية وأذكار › الذكر عند النوم","dorar":"R6kVtrQd"},{"id":"س-07813","fp":"21249c992905","stateId":341,"easy":"إذا قرأت سورة البقرة في بيتك ← ينفر منه الشيطان","cause":"البَيتِ الذي تُقرَأُ فيه سورةُ البَقَرةِ","result":"إنَّ الشَّيطانَ يَنفِرُ","explicit":true,"star":true,"apply":{"k":"read","t":"سورة البقرة"},"similar":["س-03618","س-02548","س-02555","س-03581"],"ref":"صحيح مسلم 780","srcLabel":"متفق عليه","text":["لا تَجعَلوا بُيوتَكُم مَقابِرَ، ",["إنَّ الشَّيطانَ يَنفِرُ",2]," مِنَ ",["البَيتِ الذي تُقرَأُ فيه سورةُ البَقَرةِ",1],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"قرآن › فضل قراءة القرآن","dorar":"PTdeO5yZ","merged":3,"otherRefs":["عمدة التفسير 1/72 (صحيح)","تخريج شرح السنة 1194 (حسن)"]},{"id":"س-02306","fp":"0de7fd70ca36","stateId":341,"easy":"إذا قرأت القرآن في بيتك ← لا يدخله الشيطان","cause":"بَيْتًا فيه يقرَأُ القُرآنَ","result":"وإنَّ الشَّيْطانَ لا يدخُلُ","explicit":true,"ref":"الأحاديث المختارة 1836","srcLabel":"البخاري","text":["«صلاةُ الرَّجُلِ في الجَماعةِ تَفضُلُ على صلاةِ الرَّجُلِ وَحْدَه في بَيْتِه بسَبْعةٍ وعِشرينَ ضِعْفًا، فإذا صلَّى أحَدُكم في المسجِدِ فلْيَجعَلْ في بَيْتِه نَصيبًا مِن صلاتِه؛ فإنَّ اللهَ تعالى جاعِلٌ في بَيْتِه مِن صلاتِه خَيرًا، ",["وإنَّ الشَّيْطانَ لا يدخُلُ",2]," ",["بَيْتًا فيه يقرَأُ القُرآنَ",1],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"m0JjRLEj"},{"id":"س-03618","fp":"cd3092cd87d8","stateId":341,"easy":"إذا قرأت سورة البقرة في بيتك ← يفر منه الشيطان","cause":"لا تَجعَلوا بيوتَكم مَقابِرَ","result":"فإنَّ الشيطانَ يفِرُّ مِنَ البيتِ، أنْ يَسمَعَ سورةَ البقرةِ تُقرَأُ فيه","explicit":true,"apply":{"k":"read","t":"سورة البقرة"},"repOf":"س-07813","ref":"تخريج المسند لشعيب 8443","text":[["لا تَجعَلوا بيوتَكم مَقابِرَ؛ ",1],["فإنَّ الشيطانَ يفِرُّ مِنَ البيتِ، أنْ يَسمَعَ سورةَ البقرةِ تُقرَأُ فيه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه مسلم (780) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"FmGfCTHQ"},{"id":"س-07804","fp":"a817085518f0","stateId":341,"easy":"إذا قرأت آخر البقرة في دار ثلاث ليال ← لا يقربها الشيطان","cause":"و لا يُقرآنِ في دارٍ ثلاثَ ليالٍ","result":"فيقربُها الشيطانُ","explicit":true,"ref":"صحيح الجامع 1799","srcLabel":"الترمذي","text":["إنَّ اللهَ تعالى كتب كتابًا قبلَ أنْ يخلقَ السمواتِ و الأرضَ بألْفي عامٍ ، و هو عندَ العرشِ ، و إنَّه أنزل منه آيتينِ ، ختم بهما سورةُ البقرةِ ، ",["و لا يُقرآنِ في دارٍ ثلاثَ ليالٍ",1]," ",["فيقربُها الشيطانُ",2]],"grade":"صحيح","narrator":"النعمان بن بشير","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2882)، وأحمد (18414)، والدارمي (3430) واللفظ لهم.","bab":"قرآن › فضل قراءة القرآن","dorar":"zfVcyeAL","merged":4,"otherRefs":["بذل الماعون 89 (حسن)","الخصائص الكبرى 2/95 (حسن)","المستدرك على الصحيحين 3072 (صحيح)"]},{"id":"س-04098","fp":"0ccaf9f77a81","stateId":341,"easy":"إذا قرأت آية الكرسي في بيتك ← لا يقربك شيطان ولا غيره","cause":"آيةَ الكرسيِّ، اقرأها في بيتِكَ","result":"فلا يقربُكَ شيطانٌ ولا غيرُه","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"similar":["س-00709"],"ref":"صحيح الترمذي 2880","srcLabel":"الترمذي","text":["أنَّهُ كانت له سَهوةٌ فيها تَمرٌ فَكانت تجيءُ الغولُ فتأخذُ منه، قال: فشَكا ذلِكَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ، قال: فاذهب فإذا رأيتَها فقُلْ: باسمِ اللَّهِ أجيبي رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ. قال: فأخذَها فحلَفت أن لا تعودَ، فأرسلَها فجاءَ إلى النَّبِيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقال: ما فعلَ أسيرُكَ؟ قال: حلَفَت أن لا تعودَ، قالَ: كذبَتْ وهيَ معاوِدةٌ للْكذبِ، قال: فأخذَها مرَّةً أخرى فحلَفت أن لا تعودَ فأرسلَها، فجاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقال: ما فعلَ أسيرُكَ؟ قال: فحلَفت أن لا تعودَ، فقال: كذبَتْ وهيَ معاودةٌ للْكذبِ، فأخذَها فقال: ما أنا بتارِككِ حتَّى أذهبَ بِكِ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ، فقالت: إنِّي ذاكرةٌ لَكَ شيئًا؛ ",["آيةَ الكرسيِّ، اقرأها في بيتِكَ",1]," ",["فلا يقربُكَ شيطانٌ ولا غيرُه",2],". فجاءَ إلى النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ فقال: ما فعلَ أسيرُكَ؟ قال: فأخبرَهُ بما قالت، قال: صدَقَت وهيَ كذوبٌ"],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2880) واللفظ له، وأحمد (23592) باختلاف يسير","bab":"جن › صفة إبليس وجنوده","dorar":"X75HeGEc","merged":2,"otherRefs":["در السحابة 103 (صحيح)"]},{"id":"س-00613","fp":"ccd61c59c369","stateId":341,"easy":"إذا قرأت (آخر البقرة) في بيتك ليلاً ← لا يدخله الشيطان ثلاث ليال","cause":"من قرأها في بيتِه ليلًا","result":"لم يدخُلِ الشَّيطانُ بيتَه ثلاثَ ليالٍ","explicit":true,"ref":"الترغيب والترهيب 2/314","srcLabel":"ابن حبان","text":["إنَّ لكلِّ شيءٍ سَنامًا وإنَّ سَنامَ القرآنِ سورةُ البقرةِ ",["من قرأها في بيتِه ليلًا",1]," ",["لم يدخُلِ الشَّيطانُ بيتَه ثلاثَ ليالٍ",2]," ومن قرأها نهارًا لم يدخُلِ الشَّيطانُ بيتَه ثلاثةَ أيَّامٍ"],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (780) واللفظ له، والطبراني (6/163) (5864)، والبيهقي في ((شعب الإيمان)) (2378) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"B7xlNGYi"},{"id":"س-00614","fp":"025d8c368cd5","stateId":341,"easy":"إذا قرأتها نهاراً ← لا يدخل الشيطان بيتك ثلاثة أيام","cause":"ومن قرأها نهارًا","result":"لم يدخُلِ الشَّيطانُ بيتَه ثلاثةَ أيَّامٍ","explicit":true,"ref":"الترغيب والترهيب 2/314","srcLabel":"ابن حبان","text":["إنَّ لكلِّ شيءٍ سَنامًا وإنَّ سَنامَ القرآنِ سورةُ البقرةِ من قرأها في بيتِه ليلًا لم يدخُلِ الشَّيطانُ بيتَه ثلاثَ ليالٍ ",["ومن قرأها نهارًا",1]," ",["لم يدخُلِ الشَّيطانُ بيتَه ثلاثةَ أيَّامٍ",2]],"grade":"صحيح","narrator":"سهل بن سعد الساعدي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن حبان (780) واللفظ له، والطبراني (6/163) (5864)، والبيهقي في ((شعب الإيمان)) (2378) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"B7xlNGYi"},{"id":"س-00709","fp":"f360c7e81e94","stateId":341,"easy":"إذا قرأت آية الكرسي في بيتك ← لا يدخله شيطان","cause":"آيةُ الكرسيِّ","result":"لا يدخلُ البيتَ الذي تقرأُ فيه شيطانٌ","explicit":true,"apply":{"k":"read","t":"آية الكرسي"},"repOf":"س-04098","ref":"الفتح الرباني 4/1898","text":[["آيةُ الكرسيِّ",1]," وأنه ",["لا يدخلُ البيتَ الذي تقرأُ فيه شيطانٌ",2]],"grade":"صحيح","muhaddith":"صحيح من دون تقييد بقوله ثلاثا","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"ItW2ldhU"},{"id":"س-00797","fp":"2efcec01f870","stateId":341,"easy":"إذا جئت باب بيتك فذكرت الله ← يرجع قرينك","cause":"إذا جِئتَ بابَ حُجرتِك فاذكرِ اللهَ تعالَى","result":"يرجعْ قرينُك","explicit":true,"apply":{"k":"time","t":"عند دخول البيت"},"ref":"معجم الشيوخ 2/659","srcLabel":"ابن عساكر","text":[["إذا جِئتَ بابَ حُجرتِك فاذكرِ اللهَ تعالَى ",1],["يرجعْ قرينُك",2]," وإذا دخلتَ بيتَك فاذكُرِ اللهَ يخرجْ ساكنُه وإذا قرُب طعامُكم فاذكروا اللهَ لا يشاركوكم في طعامِكم قال وحسبتُه قال وإذا اضطجع أحدُكم فليذكرِ اللهَ لا يناموا على فراشِكم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن عساكر في ((معجم الشيوخ)) (816)","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aFArsrZ2"},{"id":"س-00798","fp":"6a1177690b38","stateId":341,"easy":"إذا دخلت بيتك فذكرت الله ← يخرج الشيطان منه","cause":"وإذا دخلتَ بيتَك فاذكُرِ اللهَ","result":"يخرجْ ساكنُه","explicit":true,"apply":{"k":"time","t":"عند دخول البيت"},"ref":"معجم الشيوخ 2/659","srcLabel":"ابن عساكر","text":["إذا جِئتَ بابَ حُجرتِك فاذكرِ اللهَ تعالَى يرجعْ قرينُك ",["وإذا دخلتَ بيتَك فاذكُرِ اللهَ",1]," ",["يخرجْ ساكنُه",2]," وإذا قرُب طعامُكم فاذكروا اللهَ لا يشاركوكم في طعامِكم قال وحسبتُه قال وإذا اضطجع أحدُكم فليذكرِ اللهَ لا يناموا على فراشِكم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن عساكر في ((معجم الشيوخ)) (816)","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aFArsrZ2"},{"id":"س-02548","fp":"f19654d059ec","stateId":341,"easy":"إذا قرأت سورة البقرة في بيتك ← يخرج الشيطان منه","cause":"وإنَّ الشيطانَ إذا سَمِعَ سورةَ البقرةِ تُقرأُ","result":"خَرَجَ مِنَ البيتِ الَّذي يُقرأُ فيه سورةُ البقرةِ","explicit":true,"apply":{"k":"read","t":"سورة البقرة"},"repOf":"س-07813","ref":"المستدرك على الصحيحين 2086","text":["عن عبدَ اللهِ بنَ مسعودٍ قالَ: إنَّ لكُلِّ شيءٍ سَنامًا؛ وسَنامُ القرآنِ سورةُ البقرةِ، ",["وإنَّ الشيطانَ إذا سَمِعَ سورةَ البقرةِ تُقرأُ",1],"؛ ",["خَرَجَ مِنَ البيتِ الَّذي يُقرأُ فيه سورةُ البقرةِ",2],"."],"grade":"صحيح","narrator":"أبو الأحوص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((الشعب)) (2159)، وابن الضريس في ((فضائل القرآن)) (177) واللفظ لهما، والدارمي (3422) بنحوه مختصرًا.","bab":"إيمان › أعمال الجن والشياطين","dorar":"IPJvTjJo"},{"id":"س-02555","fp":"2c8e9c34dc34","stateId":341,"easy":"إذا قرأت سورة البقرة في بيتك ← لا يدخله الشيطان","cause":"اقرؤوا سورةَ البقرةِ في بيوتِكم","result":"فإنَّ الشَّيطانَ لا يدخلُ بيتًا يُقرأُ فيه سورةُ البقرةِ","explicit":true,"apply":{"k":"read","t":"سورة البقرة"},"repOf":"س-07813","ref":"الترغيب والترهيب 2/314","text":["عن عبدِ اللهِ رضِي اللهُ عنه قال ",["اقرؤوا سورةَ البقرةِ في بيوتِكم",1]," ",["فإنَّ الشَّيطانَ لا يدخلُ بيتًا يُقرأُ فيه سورةُ البقرةِ",2]],"grade":"صحيح","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما] [وروي] مرفوعا بإسناد حسن","bab":"إيمان › أعمال الجن والشياطين","dorar":"f1tRYwPS"},{"id":"س-03581","fp":"3307823402d3","stateId":341,"easy":"إذا صليت في بيتك وقرأت فيه البقرة ← يفر منه الشيطان","cause":"لا تتَّخِذوا بيوتَكم مقابِرَ صلُّوا فيها","result":"فإنَّ الشَّيطانَ لَيفِرُّ مِن البيتِ يسمَعُ سورةَ البقرةِ تُقرَأُ فيه","explicit":true,"repOf":"س-07813","ref":"صحيح ابن حبان 783","text":[["لا تتَّخِذوا بيوتَكم مقابِرَ صلُّوا فيها ",1],["فإنَّ الشَّيطانَ لَيفِرُّ مِن البيتِ يسمَعُ سورةَ البقرةِ تُقرَأُ فيه",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البزار (9091)، والمروزي في ((مختصر قيام الليل)) (ص165)، والفريابي في ((فضائل القرآن)) (ص147) واللفظ لهم.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"4cTHo9ZV"},{"id":"س-00781","fp":"3ef9d47b38e9","stateId":341,"easy":"إذا دخلت منزلك فصليت ركعتين ← تمنعانك مدخل السوء","cause":"إذا دَخَلتَ مَنزِلَكَ فصَلِّ رَكعَتَينِ","result":"تَمنَعانِكَ مَدخَلَ السُّوءِ","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: عند دخول البيت"},"ref":"الفوائد المجموعة 56","srcLabel":"البيهقي","text":[["إذا دَخَلتَ مَنزِلَكَ فصَلِّ رَكعَتَينِ",1]," ",["تَمنَعانِكَ مَدخَلَ السُّوءِ",2],"، وإذا خَرَجتَ مِن مَجلسِكَ فصَلِّ رَكعَتَينِ تَمنَعانِكَ مِن مَخرَجِ السُّوءِ"],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه البزار (8567)، والبيهقي في ((شعب الإيمان)) (2814)، وقوام السنة في ((الترغيب والترهيب)) (2011) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"F6i9BVpb","merged":2,"otherRefs":["الابتهاج 12 (حسن)"]},{"id":"س-01722","fp":"9676d30737a4","stateId":341,"easy":"إذا ظهرت الحية في مسكنك فناشدتها بعهد نوح وسليمان ← لا تؤذيكم","cause":"إنَّا نسألُك بعهدِ نوحٍ ، وبعهدِ سليمانَ بنِ داودَ","result":"أن لا تؤذينَا","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"ref":"الجامع الصغير 744","srcLabel":"أبو داود","text":["إذا ظهرتِ الحيةُ في المسكنِ فقولوا لها : ",["إنَّا نسألُك بعهدِ نوحٍ ، وبعهدِ سليمانَ بنِ داودَ",1]," ، ",["أن لا تؤذينَا",2]," ، فإنْ عادتْ فاقتُلُوها"],"grade":"حسن","narrator":"أبو ليلى الأنصاري والد عبدالرحمن","muhaddith":"حسن","takhrij":"أخرجه الترمذي (1485) بلفظه، وأبو داود (5260)، والنسائي في ((السنن الكبرى)) (10738) كلاهما بلفظ مقارب.","bab":"أنبياء › عام","dorar":"id4knR64"},{"id":"س-02545","fp":"72cf069d6af5","stateId":341,"easy":"إذا قرأت خاتمة سورة البقرة في بيتك ← لا يدخله الشيطان","cause":"يَقرأَ أَحدٌ مِنكُم خاتمةَ البقرةِ","result":"أنْ لا يَقرأَ أَحدٌ مِنكُم خاتمةَ البقرةِ؛ فيَدخُلَ أَحدٌ مِنَّا في بيتِهِ تلكَ اللَّيلةَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"read","t":"خاتمة سورة البقرة"},"ref":"المستدرك على الصحيحين 2096","srcLabel":"البيهقي","text":["عَنْ أَبِي الْأَسْوَدِ الدِّيلِيِّ، قَالَ: قُلْتُ لِمُعَاذِ بْنِ جَبَلٍ رَضِيَ اللَّهُ عَنْهُ: حدِّثْني عنْ قصَّةِ الشَّيطانِ حينَ أَخذْتَهُ، فقالَ: جَعَلَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ على صدَقةِ المسلمينَ، فجَعَلتُ التَّمرَ في غُرفةٍ، فوَجدْتُ فيه نُقصانًا، فأَخبرْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: هذا الشَّيطانُ يَأخُذُه، قالَ: فدَخلتُ الغُرفةَ، فأَغلقتُ البابَ عَلَيَّ، فجاءتْ ظُلمةٌ عظيمةٌ، فغَشِيتُ البابَ، ثُمَّ تَصوَّرَ في صورةِ فيلٍ، ثُمَّ تَصوَّرَ في صورةٍ أُخرى، فدَخَلَ مِن شَقِّ البابِ، فشَددْتُ إزاري عَلَيَّ، فجَعَلَ يَأكُلُ مِنَ التَّمرِ، قالَ: فوَثَبتُ إليه فضَبَطْتُه، فالتقتْ يَدايَ عليه، فقلتُ: يا عَدوَّ اللهِ، فقالَ: خلِّ عنِّي؛ فإنِّي كبيرٌ ذو عيالٍ كثيرٍ، وأنا فقيرٌ، وأنا مِن جِنِّ نَصيبِينَ، وكانت لنا هذه القريةُ قبلَ أنْ يُبعثَ صاحِبُكُم، فلمَّا بُعِثَ أُخرِجْنا عنها، فخَلِّ عنِّي، فلن أَعودَ إليكَ. فخَلَّيتُ عنه، وجاءَ جِبريلُ عليه السَّلامُ، فأَخبَرَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بما كان، فصلَّى رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ الصُّبحَ، فنادى مُنادِيهِ: أين مُعاذُ بنُ جبلٍ، فقمتُ إليه، فقالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ما فَعَلَ أَسيرُكَ يا مُعاذُ؟ فأَخبرْتُه، فقالَ: أمَا إنَّه سيَعودُ. فعادَ، قالَ: فدَخَلْتُ الغُرفةَ، وأَغلَقتُ عَلَيَّ البابَ، فدَخَلَ مِن شَقِّ البابِ، فجَعَلَ يَأكُلُ مِنَ التَّمرِ، فصَنعتُ به كما صَنعتُ في المرَّةِ الأولى، فقالَ: خَلِّ عنِّي؛ فإنِّي لن أَعودَ إليكَ، فقلتُ: يا عَدُوَّ اللهِ، ألمْ تَقُلْ: لا أَعودُ؟ قالَ: فإنِّي لن أَعودَ، وآيةُ ذلك ",["أنْ لا يَقرأَ أَحدٌ مِنكُم خاتمةَ البقرةِ؛ فيَدخُلَ أَحدٌ مِنَّا في بيتِهِ تلكَ اللَّيلةَ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي الدنيا في ((مكائد الشيطان)) (14)، والبيهقي في ((دلائل النبوة)) (7/ 109)، وأبو نعيم في ((دلائل النبوة)) (547) جميعا بلفظ قريب.","bab":"إيمان › أعمال الجن والشياطين","dorar":"imPY7Y6z"},{"id":"س-02533","fp":"54bee8cb6060","stateId":341,"easy":"إذا قرأت آية الكرسي على إنائك ← لا يُكشف غطاؤه (لا يقربه الشيطان)","cause":"آيةُ الكُرسيِّ","result":"تَقرَؤُها على إنائِكَ، ولا يُكشَفُ غِطاؤُه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"read","t":"آية الكرسي"},"ref":"الخصائص الكبرى 2/96","srcLabel":"الطبراني","text":["أنَّه قَطَعَ تَمرَ حائِطِه، فجَعَلَه في غُرفَةٍ، فكانتِ الغُولُ تُخالِفُه إلى مَشرُبَتِه فتَسرِقُ تَمرَه، وتُفسِدُه عليه، فشَكا ذلك إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: تلك الغُولُ يا أبا أُسَيدٍ، فاستَمِعْ عليها، فإذا سَمِعتَ اقتِحامَها، فقُلْ: بسمِ اللهِ، أجيببي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم، ففَعَلَ، فقالتِ الغُولُ: يا أبا أُسَيدٍ، اعْفِني أنْ تُكلِّفَني أنْ أذهَبَ إلى رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وأُعطيكَ مَوثِقًا من اللهِ ألَّا أعودَ وأدُلَّك على آيةٍ ",["تَقرَؤُها على إنائِكَ، ولا يُكشَفُ غِطاؤُه",2],"، ",["آيةُ الكُرسيِّ",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم: صَدَقتْ وهي كَذوبٌ."],"grade":"حسن","narrator":"مالك بن ربيعة أبو أسيد الساعدي","muhaddith":"إسناده جيد","takhrij":"أخرجه الطبراني ((19/ 263)) (585) واللفظ له، وابن أبي الدنيا في ((مكائد الشيطان)) (13) مختصرا","bab":"إيمان › أعمال الجن والشياطين","dorar":"ng04go02"},{"id":"س-02501","fp":"ad239bb35da0","stateId":342,"easy":"إذا أطفأت المصابيح عند النوم ← تأمن أن تجرّ الفأرة الفتيلة فتحرق البيت","cause":"وأطفِؤوا المصابيحَ عِندَ الرُّقادِ","result":"فإنَّ الفُوَيسِقةَ رُبَّما اجتَرَّتِ الفَتيلةَ فأحرَقَتِ البَيتَ","explicit":true,"star":true,"apply":{"k":"time","t":"عند النوم"},"ref":"إرواء الغليل 1/80","srcLabel":"البخاري","text":["حديث: [خمِّروا الآنيةَ، وأوكُوا الأسقيةَ، وأجيفوا البابَ، ",["وأطفِؤوا المصابيحَ] عِندَ الرُّقادِ",1],"؛ ",["فإنَّ الفُوَيسِقةَ رُبَّما اجتَرَّتِ الفَتيلةَ فأحرَقَتِ البَيتَ",2],"، وأكفِتوا صِبيانَكم عِندَ المَساءِ؛ فإنَّ للجنِّ انتِشارًا وخَطفةً."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15167) بلفظه، والبخاري (3316)، وأبو يعلى (2130) كلاهما باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"GvOQooOX","merged":2,"otherRefs":["صحيح البخاري 6295 (صحيح)"]},{"id":"س-02515","fp":"53b5a85ea03a","stateId":342,"easy":"إذا أغلقت بابك وأوكيت سقاءك وغطيت إناءك وأطفأت سراجك ← فالشيطان لا يفتح غلقاً ولا يكشف غطاءً","cause":"أغلِقوا أبوابَكُم، وأوكوا أسقيتَكُم، وخمِّروا آنيتَكُم، وأطفِئوا سُرُجَكُم","result":"فإنَّ الشَّيطانَ لا يفتحُ غلقًا، ولا يحلُّ وِكاءً، ولا يَكْشِفُ غطاءً، وإنَّ الفوَيْسقةَ ربَّما أضرمت على أَهْلِ البيتِ بيتَهُم نارًا","explicit":true,"similar":["س-04084","س-02516","س-02537","س-04078"],"ref":"صحيح ابن خزيمة 1/ 249","srcLabel":"متفق عليه","text":[["أغلِقوا أبوابَكُم، وأوكوا أسقيتَكُم، وخمِّروا آنيتَكُم، وأطفِئوا سُرُجَكُم؛ ",1],["فإنَّ الشَّيطانَ لا يفتحُ غلقًا، ولا يحلُّ وِكاءً، ولا يَكْشِفُ غطاءً، وإنَّ الفوَيْسقةَ ربَّما أضرمت على أَهْلِ البيتِ بيتَهُم نارًا",2],"، وَكُفُّوا فواشيَكُم وأَهْليكُم عندَ غروبِ الشَّمسِ إلى أن تذهَبَ فجوةُ العِشاءِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (3316) بلفظ مقارب، ومسلم (2012)، وأبو داود (732) مختصرا","bab":"إيمان › أعمال الجن والشياطين","dorar":"nQh2zIyz","merged":2,"otherRefs":["تخريج المسند لشعيب 14228 (صحيح)"]},{"id":"س-04084","fp":"4262082ece94","stateId":342,"easy":"إذا أغلقت الأبواب وأوكيت السقاء وأكفأت الإناء وأطفأت المصابيح ← فالشيطان لا يفتح مغلقاً","cause":"أَغْلِقُوا الأبوابَ ، و أوْكُوا السقاءَ ، و اكفئُوا الإناءَ ، و خمرُوا الإناءَ ، و أطفئُوا المصباحَ","result":"فإِنَّ الشيطانَ لا يَفتحُ غلقًا ، و لا يَحُلُّ وِكَاءً ، و لا يَكْشِفُ إِناءً","explicit":true,"repOf":"س-02515","ref":"صحيح الأدب المفرد 927","text":[["أَغْلِقُوا الأبوابَ ، و أوْكُوا السقاءَ ، و اكفئُوا الإناءَ ، و خمرُوا الإناءَ ، و أطفئُوا المصباحَ",1]," ؛ ",["فإِنَّ الشيطانَ لا يَفتحُ غلقًا ، و لا يَحُلُّ وِكَاءً ، و لا يَكْشِفُ إِناءً",2]," ، و إِنَّ الفُوَيْسِقَةَ تُضْرِمُ على الناسِ بَيْتَهُمْ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3280)، ومسلم (2012) واللفظ له","bab":"جن › صفة إبليس وجنوده","dorar":"qU6MWQ4W","merged":2,"otherRefs":["تخريج مشكل الآثار 1083 (صحيح)"]},{"id":"س-05829","fp":"ec5f55938204","stateId":342,"easy":"إذا نمت فلا تترك النار مشتعلة في بيتك ← فهي عدو","cause":"تَبِيتَنَّ النَّارُ في بُيوتِكُم","result":"فإنَّها عَدُوٌّ","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"المستدرك على الصحيحين 7974","srcLabel":"متفق عليه","text":["لا ",["تَبِيتَنَّ النَّارُ في بُيوتِكُم",1],"؛ ",["فإنَّها عَدُوٌّ",2],". فما كانَ ابنُ عُمَرَ يَرقُدُ حتَّى لا يَدَعَ في البَيتِ نارًا إلَّا أطفَأَها، وكان آخِرَ أهلِ البَيتِ رُقادًا؛ كانَ يُصَلِّي، فإذا فَرَغ لم يَنَمْ حتَّى يُطفِئَ السِّراجَ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (5396) بلفظه دون فعل ابن عمر، والبخاري (6293)، ومسلم (2015) كلاهما بمعناه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"8dukm0kW","merged":2,"otherRefs":["تخريج صحيح ابن حبان 5520 (صحيح)"]},{"id":"س-02516","fp":"d98fb11a5803","stateId":342,"easy":"إذا أوكيت الأسقية وأغلقت الأبواب وغطيت الطعام ← لا يدخلها الشيطان","cause":"أوكوا الأسقيةَ، وغلِّقوا الأبوابَ إذا رقدتُمْ باللَّيلِ، وخَمِّروا الشَّرابَ والطَّعامَ","result":"فإنَّ الشَّيطانَ يأتي فإن لم يجدِ البابَ مُغلقًا دخلَهُ، وإن لَم يجدِ السِّقاءَ موكأً شربَ منهُ","explicit":true,"repOf":"س-02515","ref":"صحيح ابن خزيمة 1/ 251","text":["أنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ كانَ يَقولُ: ",["أوكوا الأسقيةَ، وغلِّقوا الأبوابَ إذا رقدتُمْ باللَّيلِ، وخَمِّروا الشَّرابَ والطَّعامَ",1],"؛ ",["فإنَّ الشَّيطانَ يأتي فإن لم يجدِ البابَ مُغلقًا دخلَهُ، وإن لَم يجدِ السِّقاءَ موكأً شربَ منهُ",2],"، وإن وجدَ البابَ مُغلقًا والسِّقاءَ موكأً لم يحلَّ وِكاءً، ولَم يفتَح مُغلقًا وإن لَم يَجد أحدُكُم لإنائِهِ ما يخمَّرُ بِهِ فليَعرُضْ عليهِ عودًا"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (5623) بلفظ مقارب، ومسلم (2012)، وأبو داود (3731)","bab":"إيمان › أعمال الجن والشياطين","dorar":"8J4TZDKY"},{"id":"س-02537","fp":"9ba90c44765a","stateId":342,"easy":"إذا أغلقت الأبواب وأوكيت الأسقية وغطيت الآنية وأطفأت السرج ← فالشيطان لا يفتح مغلقاً","cause":"أغْلِقوا الأبْوابَ، وأَوْكوا الأسْقيةَ، وخَمِّروا الآنيةَ، وأطْفِئوا السُّرُجَ","result":"فإنَّ الشَّيطانَ لا يَفتَحُ غَلَقًا، ولا يَحُلُّ وِكاءً، ولا يَكشِفُ إناءً، وإنَّ الفُوَيْسِقةَ تُضرِمُ على أهلِ البَيتِ، ولا تُرْسِلوا فَواشِيَكُم وصِبْيانَكُم إذا غابَتِ الشَّمسُ","explicit":true,"repOf":"س-02515","ref":"تخريج المسند لشعيب 15256","text":[["أغْلِقوا الأبْوابَ، وأَوْكوا الأسْقيةَ، وخَمِّروا الآنيةَ، وأطْفِئوا السُّرُجَ؛ ",1],["فإنَّ الشَّيطانَ لا يَفتَحُ غَلَقًا، ولا يَحُلُّ وِكاءً، ولا يَكشِفُ إناءً، وإنَّ الفُوَيْسِقةَ تُضرِمُ على أهلِ البَيتِ، ولا تُرْسِلوا فَواشِيَكُم وصِبْيانَكُم إذا غابَتِ الشَّمسُ",2]," حتى تَذهَبَ فَحْمةُ العِشاءِ؛ فإنَّ الشياطينَ تُبعَثُ إذا غابَتِ الشَّمسُ حتى تَذهَبَ فَحْمةُ العِشاءِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه البخاري (3304) بنحوه مختصراً، ومسلم (2012، 2013) مفرقاً باختلاف يسير","bab":"إيمان › أعمال الجن والشياطين","dorar":"hygTQ76G"},{"id":"س-02549","fp":"c85f305feb45","stateId":342,"easy":"إذا نمت فأطفئ سراجك ← لئلا يدل الشيطان عليه الفأرة فيحرقكم","cause":"إذا نِمتُم فأطْفِئوا سُرُجَكم","result":"فإنَّ الشَّيطانَ يَدُلُّ مِثلَ هذه على هذا، فيُحرِقُكم","explicit":true,"apply":{"k":"time","t":"عند النوم"},"ref":"المستدرك على الصحيحين 7975","srcLabel":"البخاري","text":["جاءت فأرةٌ فأخَذَت تَجُرُّ الفَتيلةَ، فذَهَبَتِ الجارِيةُ تَزجُرُها، فقالَ نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ: دَعيها، فجاءَتْ بها فألْقَتْها بيْنَ يَدَيْ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ على الخُمرةِ الَّتي كانَ قاعِدًا عليها، فأحرَقَت مِنها مَوضِعَ دِرهَمٍ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إذا نِمتُم فأطْفِئوا سُرُجَكم؛ ",1],["فإنَّ الشَّيطانَ يَدُلُّ مِثلَ هذه على هذا، فيُحرِقُكم",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (5247)، والبخاري في ((الأدب المفرد)) (1222)، والبزار (4779) واللفظ لهم","bab":"إيمان › أعمال الجن والشياطين","dorar":"bzscGMQ7"},{"id":"س-04078","fp":"83ce07625d5b","stateId":342,"easy":"إذا غطيت الإناء وأوكيت السقاء وأغلقت الباب وأطفأت السراج ← فالشيطان لا يحل سقاءً ولا يفتح باباً ولا يكشف إناءً","cause":"غَطُّوا الإناءَ، وأوكوا السِّقاءَ، وأغلِقوا البابَ، وأطفِئوا السِّراجَ","result":"فإنَّ الشَّيطانَ لا يَحُلُّ سِقاءً، ولا يَفتَحُ بابًا، ولا يَكشِفُ إناءً، فإن لَم يَجِدْ أحَدُكُم إلَّا أن يَعرُضَ على إنائِه عودًا، ويَذكُرَ اسمَ اللهِ","explicit":true,"repOf":"س-02515","ref":"صحيح مسلم 2012","text":[["غَطُّوا الإناءَ، وأوكوا السِّقاءَ، وأغلِقوا البابَ، وأطفِئوا السِّراجَ؛ ",1],["فإنَّ الشَّيطانَ لا يَحُلُّ سِقاءً، ولا يَفتَحُ بابًا، ولا يَكشِفُ إناءً، فإن لَم يَجِدْ أحَدُكُم إلَّا أن يَعرُضَ على إنائِه عودًا، ويَذكُرَ اسمَ اللهِ،",2]," فليَفعَلْ؛ فإنَّ الفُوَيسِقةَ تُضرِمُ على أهلِ البَيتِ بَيتَهم [وفي روايةٍ لم يَذكُرْ قَولَه]: وأغلِقوا البابَ. وفي رِوايةٍ: قال: وأكفِئوا الإناءَ، أو خَمِّروا الإناءَ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جن › صفة إبليس وجنوده","dorar":"9CRmyvsx"},{"id":"س-04087","fp":"0d227364db2b","stateId":342,"easy":"إذا أغلقت بابك وذكرت اسم الله ← لا يفتحه الشيطان","cause":"أغلِقْ بابَك واذكُرِ اسمَ اللهِ","result":"فإنَّ الشَّيطانَ لا يفتَحُ بابًا مُغلقًا","explicit":true,"similar":["س-04085"],"ref":"صحيح أبي داود 3731","srcLabel":"البخاري","text":[["أغلِقْ بابَك واذكُرِ اسمَ اللهِ",1]," ، ",["فإنَّ الشَّيطانَ لا يفتَحُ بابًا مُغلقًا",2]," ، وأطفِ مِصباحَك واذكرِ اسمَ اللهِ ، وخمِّرْ إناءَك ولَو بِعودٍ تعرُضُه عليهِ ، واذكرِ اسمَ اللهِ ، وأَوْكِ سقاءَك ، واذكُرِ اسمَ اللهِ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3280)، وأبو داود (3731)، وأحمد (14474) واللفظ له","bab":"جن › صفة إبليس وجنوده","dorar":"2NCnPsj3"},{"id":"س-02560","fp":"59b419e7f022","stateId":342,"easy":"إذا أغلقت أبوابك وأكفأت آنيتك وأوكيت أسقيتك وأطفأت سراجك ← لا يتسوّر الشيطان عليكم","cause":"أجيفوا أبوابَكم، وأكفِئوا آنيَتَكم، وأوكِئوا أسقِيَتَكم، وأطفِئوا سُرُجَكم","result":"فإنَّهم لم يؤذَنْ لهم بالتَّسَوُّرِ عليكم","explicit":true,"ref":"فيض القدير 1/164","srcLabel":"أحمد","text":[["أجيفوا أبوابَكم، وأكفِئوا آنيَتَكم، وأوكِئوا أسقِيَتَكم، وأطفِئوا سُرُجَكم",1],"؛ ",["فإنَّهم لم يؤذَنْ لهم بالتَّسَوُّرِ عليكم",2],"."],"grade":"صحيح","narrator":"أبو أمامة","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (22264)، وابن عدي في ((الكامل في الضعفاء)) (7/ 143) واللفظ لهما.","bab":"إيمان › أعمال الجن والشياطين","dorar":"oVXjndcb","merged":2,"otherRefs":["تخريج المسند لشعيب 22264 (صحيح)"]},{"id":"س-04085","fp":"82e6c2e179d7","stateId":342,"easy":"إذا أغلقت الأبواب وذكرت اسم الله عليها ← لا يفتحها الشيطان","cause":"وأَجِيفُوا الأبوابَ ، واذْكُرُوا اسْمَ اللهِ علَيْهَا","result":"فإِنَّ الشَّيطانَ لا يَفتَحُ بابًا أُجِيفَ وذُكِرَ اسْمُ اللهِ عليْهِ","explicit":true,"repOf":"س-04087","ref":"صحيح الجامع 620","text":["إذا سَمِعتُمْ نِباحَ الكِلابِ ، ونَهِيقَ الحَمِيرِ بِالليلِ فتَعَوَّذُوا بِاللهِ من الشيطانِ ، فإنَّهُنَّ يَرَيْنَ ما لا تَرَوْنَ ، وأَقِلُّوا الخُروجَ إذا هَدَأَتِ الرِّجْلُ ؛ فإِنَّ اللهَ عزَّ وجَلَّ يَبُثُّ في لَيْلِهِ من خَلْقِهِ ما يَشاءُ ، ",["وأَجِيفُوا الأبوابَ ، واذْكُرُوا اسْمَ اللهِ علَيْهَا",1]," ؛ ",["فإِنَّ الشَّيطانَ لا يَفتَحُ بابًا أُجِيفَ وذُكِرَ اسْمُ اللهِ عليْهِ",2]," ، وغَطُّوا الجِرارَ ، وأوْكِئُوا القِرَبَ ، وأكْفِئُوا الآنِيَةَ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (5103)، وأحمد (14322) واللفظ له.","bab":"جن › صفة إبليس وجنوده","dorar":"hKfllhG9","merged":2,"otherRefs":["تخريج شرح السنة 3060 (صحيح)"]},{"id":"س-05943","fp":"a5c20e78bbb1","stateId":343,"easy":"إذا قلت عند إتيان أهلك «بسم الله اللهم جنبنا الشيطان...» ← لا يضر الشيطان ولدكما أبداً","cause":"لَو أنَّ أحَدَهم إذا أرادَ أن يَأتيَ أهلَه قال: باسمِ اللهِ، اللَّهمَّ جَنِّبنا الشَّيطانَ، وجَنِّبِ الشَّيطانَ ما رَزَقتَنا","result":"فإنَّه إن يُقدَّرْ بينَهما ولَدٌ في ذلك لم يَضُرَّه شيطانٌ أبَدًا","explicit":true,"star":true,"apply":{"k":"say","t":"«بسم الله اللهم جنبنا الشيطان...»"},"similar":["س-01352"],"otherNeedIds":[38],"ref":"صحيح مسلم 1434","srcLabel":"متفق عليه","text":[["لَو أنَّ أحَدَهم إذا أرادَ أن يَأتيَ أهلَه قال: باسمِ اللهِ، اللَّهمَّ جَنِّبنا الشَّيطانَ، وجَنِّبِ الشَّيطانَ ما رَزَقتَنا؛ ",1],["فإنَّه إن يُقدَّرْ بينَهما ولَدٌ في ذلك لم يَضُرَّه شيطانٌ أبَدًا",2],". [وفي روايةٍ]: غيرَ أنَّ شُعبةَ ليس في حَديثِه ذِكرُ: باسمِ اللهِ، وفي رِوايةِ عبدِ الرَّزَّاقِ، عَنِ الثَّوريِّ: باسمِ اللهِ، وفي رِوايةِ ابنِ نُمَيرٍ: قال مَنصورٌ: أُراه قال: باسمِ اللهِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (6388)، ومسلم (1434) واللفظ له","bab":"رقائق وزهد › الوصايا النافعة","dorar":"9z6L6JBb","merged":4,"otherRefs":["صحيح البخاري 3283 (صحيح)","تخريج المسند لشاكر 4/205 (صحيح)","تخريج المسند لشاكر 4/31 (صحيح)"]},{"id":"س-02502","fp":"3a1460b44070","stateId":343,"easy":"إذا ضممت صبيانك عند المساء ← تحميهم من انتشار الجن","cause":"وأكفِتوا صِبيانَكم عِندَ المَساءِ","result":"فإنَّ للجنِّ انتِشارًا وخَطفةً","explicit":true,"ref":"إرواء الغليل 1/80","srcLabel":"البخاري","text":["حديث: [خمِّروا الآنيةَ، وأوكُوا الأسقيةَ، وأجيفوا البابَ، وأطفِؤوا المصابيحَ] عِندَ الرُّقادِ؛ فإنَّ الفُوَيسِقةَ رُبَّما اجتَرَّتِ الفَتيلةَ فأحرَقَتِ البَيتَ، ",["وأكفِتوا صِبيانَكم عِندَ المَساءِ",1],"؛ ",["فإنَّ للجنِّ انتِشارًا وخَطفةً",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15167) بلفظه، والبخاري (3316)، وأبو يعلى (2130) كلاهما باختلاف يسير.","bab":"إيمان › أعمال الجن والشياطين","dorar":"GvOQooOX","merged":2,"otherRefs":["الجامع الصغير 6249 (صحيح)"]},{"id":"س-01061","fp":"b98806efe4a6","stateId":343,"easy":"إذا جنح الليل فاحفظ صبيانك ساعة ← فالشياطين تنتشر حينئذ","cause":"إذا جنَح اللَّيلُ فكُفُّوا صِبْيانَكم حتى تذهَبَ ساعةٌ منَ اللَّيلِ، ثمَّ خَلُّوا سَبيلَهم","result":"فإنَّ الشَّياطينَ تنتشِرُ حِينَئِذٍ","explicit":true,"ref":"تخريج مشكل الآثار 1082","srcLabel":"متفق عليه","text":[["إذا جنَح اللَّيلُ فكُفُّوا صِبْيانَكم حتى تذهَبَ ساعةٌ منَ اللَّيلِ، ثمَّ خَلُّوا سَبيلَهم، ",1],["فإنَّ الشَّياطينَ تنتشِرُ حِينَئِذٍ",2],"، وأغلِقوا أبوابَكم، واذكُروا اسمَ اللهِ عزَّ وجلَّ، فإنَّ الشَّيطانَ لا يفتَحُ مُغلقًا، وأَوْكوا قِرَبَكم، واذكُروا اسمَ اللهِ عزَّ وجلَّ، وخمِّروا آنيَتَكم، واذكُروا اسمَ اللهِ عزَّ وجلَّ، ولو أنْ تَعرُضوا عليه بعُودٍ، قال: وأخبَرني عمرٌو، عن جابرٍ بنَحْوٍ مِن هذا، ولمْ يذكُرْ قولَهُ: فاذكُروا اسمَ اللهِ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (1082) واللفظ له، والبخاري (5623)، ومسلم (2012) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"WaddiBpy"},{"id":"س-04092","fp":"3418f4edf2c9","stateId":343,"easy":"إذا ضممت صبيانك أول الليل ← تحميهم حتى تذهب فورة العشاء","cause":"كُفُّوا صِبيانَكم","result":"حتَّى تذهَبَ فَحمةُ أو فَورةُ العِشاءِ","explicit":true,"similar":["س-04100"],"ref":"صحيح الأدب المفرد 935","srcLabel":"متفق عليه","text":[["كُفُّوا صِبيانَكم ",1],["حتَّى تذهَبَ فَحمةُ أو فَورةُ العِشاءِ ",2],"، ساعةَ تَهبُّ الشَّياطينُ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مطولاً البخاري (3316)، وفي ((الأدب المفرد)) (1231) واللفظ له، ومسلم (2013)","bab":"جن › صفة إبليس وجنوده","dorar":"R4X4DzRs"},{"id":"س-05879","fp":"7a77c57c0ba2","stateId":343,"easy":"إذا حفظت مواشيك وصبيانك أول الليل ← تحفظهم من الشيطان","cause":"كُفُّوا فواشيَكم","result":"حتَّى تذهَبَ فزْعةُ العِشاءِ فإنَّها ساعةٌ يحترقُ فيها الشَّيطانُ","explicit":true,"ref":"تخريج صحيح ابن حبان 1276","srcLabel":"متفق عليه","text":[["كُفُّوا فواشيَكم ",1],["حتَّى تذهَبَ فزْعةُ العِشاءِ فإنَّها ساعةٌ يحترقُ فيها الشَّيطانُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح على شرط مسلم سوى إبراهيم بن الحجاج، وهو ثقة","takhrij":"أخرجه أبو يعلى (1771) واللفظ له، والبخاري (3280)، ومسلم (2012) بنحوه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Bx5dNqbk"},{"id":"س-01352","fp":"9dfcd35dc644","stateId":343,"easy":"إذا قلت عند إتيان أهلك «بسم الله، اللهم جنّبنا الشيطان...» ← لا يضر الشيطان ولدكما أبداً","cause":"لو أنَّ أحَدَهم يَقولُ حينَ يَأتي أهلَه: باسمِ اللهِ، اللهُمَّ جَنِّبني الشَّيطانَ، وجَنِّبِ الشَّيطانَ ما رَزَقتَنا، ثُمَّ قُدِّرَ بينَهما في ذلك، أو قُضيَ ولَدٌ","result":"لم يَضُرَّه شَيطانٌ أبَدًا","explicit":true,"apply":{"k":"say","t":"«بسم الله، اللهم جنّبنا الشيطان...»"},"repOf":"س-05943","otherNeedIds":[38],"ref":"صحيح البخاري 5165","text":["أمَا ",["لو أنَّ أحَدَهم يَقولُ حينَ يَأتي أهلَه: باسمِ اللهِ، اللهُمَّ جَنِّبني الشَّيطانَ، وجَنِّبِ الشَّيطانَ ما رَزَقتَنا، ثُمَّ قُدِّرَ بينَهما في ذلك، أو قُضيَ ولَدٌ؛ ",1],["لم يَضُرَّه شَيطانٌ أبَدًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1434) باختلاف يسير","bab":"نكاح › عشرة النساء","dorar":"SLSSKZZP"},{"id":"س-04100","fp":"226fea168885","stateId":343,"easy":"إذا حبست صبيانك أول الليل ← تحميهم حتى تذهب فورة العشاء","cause":"احْبِسُوا صِبْيانَكُمْ","result":"حتى تَذْهَبَ فَوْعَةُ العِشَاءِ","explicit":true,"repOf":"س-04092","ref":"السلسلة الصحيحة 905","text":[["احْبِسُوا صِبْيانَكُمْ ",1],["حتى تَذْهَبَ فَوْعَةُ العِشَاءِ ",2],"، فإنَّها ساعَةٌ تَخْتَرِقُ فيها الشَّياطِينُ"],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (14941)، والحاكم (7763)","bab":"جن › صفة إبليس وجنوده","dorar":"XetKFg8j"},{"id":"س-08272","fp":"718e4cf30904","stateId":343,"easy":"إذا عوّذت أولادك بـ«أعيذكما بكلمات الله التامة...» ← يحفظهم الله","cause":"يُعَوِّذُ الحسنَ، والحُسيْنَ","result":"أُعيذُكما بكلماتِ اللهِ التَّامَّةِ من كلِّ شَيطانٍ، وهامَّةٍ، ومن كلِّ عيْنٍ لامَّةٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«أُعيذُكما بكلماتِ اللهِ التَّامَّةِ من كلِّ شَيطانٍ، وهامَّةٍ، ومن كلِّ عيْنٍ لامَّةٍ، هكذا كان إبراهيمُ صلَّى اللهُ عليه وسلَّمَ يُعَوِّذُ ابْنَيْهِ إسماعيلَ، وإسحاقَ صلواتُ اللهِ عليهما»"},"ref":"تخريج مشكل الآثار 2885","srcLabel":"البخاري","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كان ",["يُعَوِّذُ الحسنَ، والحُسيْنَ",1],": ",["أُعيذُكما بكلماتِ اللهِ التَّامَّةِ من كلِّ شَيطانٍ، وهامَّةٍ، ومن كلِّ عيْنٍ لامَّةٍ",2],"، هكذا كان إبراهيمُ صلَّى اللهُ عليه وسلَّمَ يُعَوِّذُ ابْنَيْهِ إسماعيلَ، وإسحاقَ صلواتُ اللهِ عليهما."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه البخاري (3371) باختلاف يسير","bab":"مناقب وفضائل › الحسن والحسين ابنا علي بن أبي طالب","dorar":"dcitzFgO","merged":3,"otherRefs":["صحيح ابن حبان 1013 (صحيح)","تخريج المسند لشعيب 2434 (صحيح)"]},{"id":"س-05801","fp":"7bf536e506ab","stateId":343,"easy":"إذا غربت الشمس فاحفظ صبيانك ← فهي ساعة تنتشر فيها الشياطين","cause":"إذا غربتِ الشمسُ فكفوا صبيانَكمْ","result":"فإنَّها ساعةٌ يُنشرُ فيها الشياطينُ","explicit":true,"ref":"الجامع الصغير 762","srcLabel":"الطبراني","text":[["إذا غربتِ الشمسُ فكفوا صبيانَكمْ ؛ ",1],["فإنَّها ساعةٌ يُنشرُ فيها الشياطينُ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه الطبراني (11/76) (11094)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"G9oVotAE"},{"id":"س-04096","fp":"86717bf10dc6","stateId":344,"easy":"إذا سقطت لقمتك فأمط عنها الأذى وكلها ← ولا تدعها للشيطان","cause":"فليُمِطْ ما كانَ بها مِن أذًى، ثُمَّ ليَأكُلْها","result":"ولا يَدَعْها للشَّيطانِ","explicit":true,"star":true,"similar":["س-05814"],"ref":"صحيح مسلم 2033","srcLabel":"متفق عليه","text":["إنَّ الشَّيطانَ يَحضُرُ أحَدَكُم عِندَ كُلِّ شيءٍ مِن شَأنِه، حتَّى يَحضُرَه عِندَ طَعامِه، فإذا سَقَطَت مِن أحَدِكُمُ اللُّقمةُ ",["فليُمِطْ ما كانَ بها مِن أذًى، ثُمَّ ليَأكُلْها",1],"، ",["ولا يَدَعْها للشَّيطانِ",2],"، فإذا فرَغَ فليَلعَقْ أصابِعَه؛ فإنَّه لا يَدري في أيِّ طَعامِه تَكونُ البَرَكةُ. وفي روايةٍ: إذا سَقَطَت لُقمةُ أحَدِكُم... إلى آخِرِ الحَديثِ، ولَم يَذكُرْ أوَّلَ الحَديثِ: إنَّ الشَّيطانَ يَحضُرُ أحَدَكُم."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"جن › صفة إبليس وجنوده","dorar":"FuWQd2hJ","merged":6,"otherRefs":["صحيح الترمذي 1803 (صحيح)","صحيح مسلم 2033 (صحيح)","صحيح الجامع 602 (صحيح)","صحيح الجامع 601 (صحيح)","صحيح الجامع 378 (صحيح)"]},{"id":"س-00800","fp":"2e46df539191","stateId":344,"easy":"إذا ذكرت الله عند دخولك وعند طعامك ← يقول الشيطان: لا مبيت لكم ولا عشاء","cause":"إذا دَخَلَ الرَّجُلُ بَيتَه فذَكَرَ اسْمَ اللهِ حينَ يَدخُلُ، وحينَ يَطْعَمُ","result":"قال الشَّيطانُ: لا مَبيتَ لكم، ولا عَشاءَ","explicit":true,"star":true,"otherNeedIds":[1],"ref":"تخريج المسند لشعيب 14729","srcLabel":"مسلم","text":["عن أبي الزُّبَيرِ، أنَّه سَألَ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: إذا دَخَلَ الرَّجُلُ بَيتَه يُسَلِّمُ، والمؤمِنُ يَأكُلُ في مِعًى واحِدٍ؟ قال: نَعَمْ. قال: وسَألْتُ جابِرًا، أسَمِعتَ رسولَ اللهِ صلَّى اللهُ عليه وسَلَّم يقولُ: ",["إذا دَخَلَ الرَّجُلُ بَيتَه فذَكَرَ اسْمَ اللهِ حينَ يَدخُلُ، وحينَ يَطْعَمُ",1],"، ",["قال الشَّيطانُ: لا مَبيتَ لكم، ولا عَشاءَ",2]," هاهُنا، وإنْ دَخَلَ فلم يَذْكُرِ اسْمَ اللهِ عندَ دُخولِه، قال: أدْرَكْتُم المَبيتَ، وإنْ لم يَذْكُرِ اسْمَ اللهِ عندَ مَطْعَمِه، قال: أدْرَكْتُمُ المَبيتَ والعَشاءَ؟ قال: نَعَمْ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2018، 2061) مفرقاً، وأبو داود (3765)، والنسائي في ((السنن الكبرى)) (6757)، وابن ماجه (3887)، وأحمد (14729) واللفظ له","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aQlb0Lyt","merged":4,"otherRefs":["الفتاوى الكبرى 5 / 214 (صحيح)","صحيح مسلم 2018 (صحيح)","صحيح الأدب المفرد 834 (صحيح)"]},{"id":"س-05814","fp":"b82a90420e83","stateId":344,"easy":"إذا سقطت لقمتك فأمط ما أرابك منها وكلها ← ولا تدعها للشيطان","cause":"إذا أكَلَ أحَدُكُم فسَقَطَتْ لُقْمتُه، فلْيُمِطْ ما أرابَه منها، ثُمَّ لْيَطْعَمْها","result":"ولا يَدَعْها للشَّيطانِ","explicit":true,"repOf":"س-04096","ref":"تخريج المسند لشعيب 15237","text":[["إذا أكَلَ أحَدُكُم فسَقَطَتْ لُقْمتُه، فلْيُمِطْ ما أرابَه منها، ثُمَّ لْيَطْعَمْها",1],"، ",["ولا يَدَعْها للشَّيطانِ",2],"، ولا يَمسَحْ أحَدُكُم يَدَه بالمِنْديلِ حتى يَلعَقَ يَدَه؛ فإنَّ الرَّجُلَ لا يَدْري في أيِّ طَعامِه يُبارَكُ له؛ فإنَّ الشَّيطانَ يَرصُدُ ابنَ آدَمَ عِندَ كلِّ شَيءٍ حتى عِندَ طَعامِه."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2033) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"giKWyfDH"},{"id":"س-07597","fp":"f8f390f69577","stateId":344,"easy":"إذا ذكرت الله على طعامك ولو في آخره ← يستقيء الشيطان ما أكل","cause":"بِسْمِ اللهِ في أوَّلِه وفي آخِرِه","result":"فلمَّا ذَكَرَ اللهَ اسْتَقاءَ الشَّيْطانُ ما في بَطْنِه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[1],"ref":"الأحاديث المختارة 1510","srcLabel":"البخاري","text":["«كانَ رَجُلٌ يَأكُلُ والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ جالِسٌ، فلم يُسَمِّ، فجَعَلَ الشَّيْطانُ يَأكُلُ معَه، فلمَّا لم يَبْقَ مِن طَعامِه إلَّا لُقْمةٌ قالَ: ",["بِسْمِ اللهِ في أوَّلِه وفي آخِرِه",1],"، قالَ: فضَحِكَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ فقالَ: إنَّ هذا لم يَزَلِ الشَّيْطانُ يَأكُلُ معَه، ",["فلمَّا ذَكَرَ اللهَ اسْتَقاءَ الشَّيْطانُ ما في بَطْنِه",2],"»."],"grade":"صحيح","narrator":"أمية بن مخشي الخزاعي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"فضائل النبي وصفته ودلائل النبوة › ضحك النبي صلى الله عليه وسلم وتبسمه","dorar":"pnnA9ly5","merged":2,"otherRefs":["إرشاد الساري 5/304 (صحيح)"]},{"id":"س-01610","fp":"35fdff8cfc9e","stateId":344,"easy":"إذا نسيت التسمية فقل «بسم الله أوله وآخره» ← يقيء الشيطان ما أكل","cause":"قالَ: بِسْمِ اللهِ أوَّلَه وآخِرَه","result":"فقاءَ الشَّيْطانُ كلَّ ما أكَلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«بسم الله أوله وآخره»"},"similar":["س-02558","س-01042"],"otherNeedIds":[1],"ref":"الأحاديث المختارة 1511","srcLabel":"البخاري","text":["أنَّ رَجُلًا كانَ يَأكُلُ عنْدَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فلم يُسَمِّ، فلمَّا كانَ في آخِرِ لُقْمةٍ، ",["قالَ: بِسْمِ اللهِ أوَّلَه وآخِرَه",1],"، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما زالَ الشَّيْطانُ يَأكُلُ معَه حتَّى قالَ: أوَّلَه وآخِرَه، ",["فقاءَ الشَّيْطانُ كلَّ ما أكَلَ",2],"»."],"grade":"صحيح","narrator":"أمية بن مخشي الخزاعي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أطعمة › إطعام الطعام","dorar":"v7LKCktQ"},{"id":"س-02558","fp":"eb2433ad9a22","stateId":344,"easy":"إذا نسيت التسمية فقل «باسم الله أوله وآخره» ← يقيء الشيطان ما أكل","cause":"فقالَ: باسمِ اللهِ أوَّلَه وآخِرَه","result":"فلم يَبْقَ في بَطْنِه شيءٌ إلَّا قاءَه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«باسم الله أوله وآخره»"},"repOf":"س-01610","otherNeedIds":[1],"ref":"الأحاديث المختارة 1509","text":["«المُثَنَّى بنُ عَبْدِ الرَّحْمنِ الخُزاعيُّ -وصَحِبْتُه إلى واسِطٍ- فكانَ يُسَمِّي في أوَّلِ طَعامِه، وفي آخَرِ لُقْمةٍ يَقولُ: بِسْمِ اللهِ في أوَّلِه وآخِرِه، فقُلْتُ له: إنَّك تُسَمِّي في أوَّلِ ما تَأكُلُ، أَرَأيْتَ قَوْلَك في آخِرِ ما تَأكُلُ: بِسْمِ اللهِ أوَّلَه وآخِرَه؟ قالَ: أُخبِرُك عن ذلك: إنَّ جَدِّي أُمَيَّةَ بنَ مَخْشيٍّ -وكانَ مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ- يَقولُ: إنَّ رَجُلًا كانَ يَأكُلُ والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يَنظُرُ، فلم يُسَمِّ حتَّى كانَ في آخِرِ طَعامِه لُقْمةٌ، ",["فقالَ: باسمِ اللهِ أوَّلَه وآخِرَه",1],"، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ما زالَ الشَّيْطانُ يَأكُلُ معَه حتَّى سمَّى، ",["فلم يَبْقَ في بَطْنِه شيءٌ إلَّا قاءَه",2],"»."],"grade":"صحيح","narrator":"أمية بن مخشي الخزاعي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"إيمان › أعمال الجن والشياطين","dorar":"e35jeFPZ"},{"id":"س-00799","fp":"356383a1bf14","stateId":344,"easy":"إذا ذكرت الله عند طعامك ← لا يشاركك الشيطان فيه","cause":"وإذا قرُب طعامُكم فاذكروا اللهَ","result":"لا يشاركوكم في طعامِكم","explicit":true,"otherNeedIds":[1],"ref":"معجم الشيوخ 2/659","srcLabel":"ابن عساكر","text":["إذا جِئتَ بابَ حُجرتِك فاذكرِ اللهَ تعالَى يرجعْ قرينُك وإذا دخلتَ بيتَك فاذكُرِ اللهَ يخرجْ ساكنُه ",["وإذا قرُب طعامُكم فاذكروا اللهَ",1]," ",["لا يشاركوكم في طعامِكم",2]," قال وحسبتُه قال وإذا اضطجع أحدُكم فليذكرِ اللهَ لا يناموا على فراشِكم"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن عساكر في ((معجم الشيوخ)) (816)","bab":"أدعية وأذكار › الذكر عند دخول المنزل","dorar":"aFArsrZ2"},{"id":"س-01042","fp":"1df3d4e48e4b","stateId":344,"easy":"إذا نسيت التسمية أول الطعام فقل «بسم الله أوله وآخره» ← تستقبل طعامك جديداً وتمنع الشيطان منه","cause":"مَن نسي أنْ يذكُرَ اللهَ في أوَّلِ طعامِه فلْيقُلْ حينَ يذكُرُ: بسمِ اللهِ في أوَّلِه وآخِرِه","result":"فإنَّه يستقبِلُ طعامَه جديدًا ويمنَعُ الخبيثَ ما كان يُصيبُ منه","explicit":true,"apply":{"k":"say","t":"«بسم الله أوله وآخره»"},"repOf":"س-01610","otherNeedIds":[1],"ref":"تخريج صحيح ابن حبان 5213","text":[["مَن نسي أنْ يذكُرَ اللهَ في أوَّلِ طعامِه فلْيقُلْ حينَ يذكُرُ: بسمِ اللهِ في أوَّلِه وآخِرِه ",1],["فإنَّه يستقبِلُ طعامَه جديدًا ويمنَعُ الخبيثَ ما كان يُصيبُ منه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبراني (10/211) (10354)، وابن السني في ((عمل اليوم والليلة)) (459)","bab":"أدعية وأذكار › فضل الذكر","dorar":"s8L34XG9"},{"id":"س-00885","fp":"077667588727","stateId":344,"easy":"إذا ذكرت اسم الله عند الطعام والشراب ودخول البيت ← لا يصل إليك الشيطان","cause":"إذا طعِم ذكرَ اسمَ اللهِ وإذا شرِب ذكرَ اسمَ اللهِ وإذا دخل بيتَه ذكر اسمَ اللهِ","result":"لا واللهِ ما أصلُ معَه إلى شيءٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 5/25","srcLabel":"الطبراني","text":["عن ابنِ مسعودٍ قال إن شيطانَ المسلمِ يلقَى شيطانَ الكافرِ فيُرَى شيطانُ المؤمنِ شاحبًا أغبرَ مهزولًا فيقولُ له شيطانُ الكافرِ ويحَك مالَك هلكتَ فيقولُ شيطانُ المؤمنِ ",["لا واللهِ ما أصلُ معَه إلى شيءٍ",2]," ",["إذا طعِم ذكرَ اسمَ اللهِ وإذا شرِب ذكرَ اسمَ اللهِ وإذا دخل بيتَه ذكر اسمَ اللهِ",1]," فيقولُ الآخرُ لكنِّي آكلُ من طعامِه وأشربُ من شرابِه وأنامُ على فراشِه فهذا ساحٌّ وهذا مهزولٌ"],"grade":"صحيح","narrator":"[عوف بن مالك بن نضلة أبو الأحوص]","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه عبد الرزاق (19560)، والطبراني في ((الكبير)) (9/ 156) (8782)، والبيهقي في ((الشعب)) (5447) واللفظ لهم.","bab":"أدعية وأذكار › فضل الذكر","dorar":"KKMAD1Zq"},{"id":"س-02552","fp":"e5210f5535b7","stateId":344,"easy":"إذا أطعمت اليتيم معك على قصعتك ← لا يقربها شيطان","cause":"قعَد يتيمٌ مع قومٍ على قصعتِهم","result":"ما قعَد يتيمٌ مع قومٍ على قصعتِهم فيقرَبُ قصعتَهم شيطانٌ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"مجمع الزوائد 8/163","srcLabel":"الطبراني","text":[["ما قعَد يتيمٌ مع قومٍ على قصعتِهم فيقرَبُ قصعتَهم شيطانٌ",2]],"grade":"حسن","narrator":"أبو موسى الأشعري","muhaddith":"حسن","takhrij":"أخرجه ابن أبي الدنيا في ((النفقة على العيال)) (624)، والحارث في ((المسند)) (907)، والطبراني في ((المعجم الأوسط)) (7165)","bab":"إيمان › أعمال الجن والشياطين","dorar":"N0dLRrZx"},{"id":"س-07584","fp":"e5b51b5c772e","stateId":345,"easy":"إذا تركت النزول والصلاة وقضاء الحاجة على قارعة الطريق ← تتقي الهوام واللعن","cause":"إيَّاكم والتَّعريسَ على جوادِّ الطَّريقِ ، والصَّلاةَ عليها","result":"فإنَّها مأوى الحيَّاتِ والسِّباعِ ، وقضاءَ الحاجةِ عليها فإنَّها الملاعِنُ","explicit":true,"ref":"البدر المنير 2/314","srcLabel":"ابن ماجه","text":[["إيَّاكم والتَّعريسَ على جوادِّ الطَّريقِ ، والصَّلاةَ عليها ",1],["فإنَّها مأوى الحيَّاتِ والسِّباعِ ، وقضاءَ الحاجةِ عليها فإنَّها الملاعِنُ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجه (329) باختلاف يسير، وابن خزيمة (2548) مطولاً باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"Rl670xMj","merged":2,"otherRefs":["صحيح الترغيب 149 (حسن)"]},{"id":"س-01165","fp":"b6b5852dc39c","stateId":345,"easy":"إذا عثرت دابتك فقل «بسم الله» ← يتصاغر الشيطان حتى يصير كالذباب","cause":"ولكنْ قُلْ: بِسْمِ اللهِ","result":"فإنَّه يَتَصاغَرُ حتَّى يَصيرَ مِثلَ الذُّبابِ","explicit":true,"star":true,"apply":{"k":"say","t":"«بسم الله»"},"ref":"الأحاديث المختارة 1413","srcLabel":"البخاري","text":["«عَثَرَتْ بالنَّبيِّ صلَّى اللهُ عليه وسلَّمَ النَّاقةُ، قالَ: فقُلْتُ: تَعِسَ الشَّيْطانُ! قالَ: لا تَقُلْ: تَعِسَ الشَّيْطانُ؛ فإنَّه يَتَعاظَمُ حتَّى يَصيرَ مِثلَ الجَبَلِ، ويَقولُ: بقُوَّتي صَرَعْتُ! ",["ولكنْ قُلْ: بِسْمِ اللهِ",1],"؛ ",["فإنَّه يَتَصاغَرُ حتَّى يَصيرَ مِثلَ الذُّبابِ",2],"»."],"grade":"صحيح","narrator":"ردف النبي صلى الله عليه وسلم","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › فضل الذكر","dorar":"gKn33sYS","merged":2,"otherRefs":["تخريج مشكل الآثار 369 (حسن)"]},{"id":"س-03237","fp":"3e2db6f072a6","stateId":345,"easy":"إذا نزلت منزلاً فقلت «أعوذ بكلمات الله التامات من شر ما خلق» ← لا يضرك شيء حتى ترتحل","cause":"إذا نَزَلَ أحَدُكُم مَنزِلًا فليَقُلْ: أعوذُ بكَلِماتِ اللهِ التَّامَّاتِ مِن شَرِّ ما خَلَقَ","result":"فإنَّه لا يَضُرُّه شيءٌ حتَّى يَرتَحِلَ منه","explicit":true,"star":true,"apply":{"k":"say","t":"«أعوذ بكلمات الله التامات من شر ما خلق» · الوقت: في السفر"},"similar":["س-00972"],"ref":"صحيح مسلم 2708","srcLabel":"متفق عليه","text":[["إذا نَزَلَ أحَدُكُم مَنزِلًا فليَقُلْ: أعوذُ بكَلِماتِ اللهِ التَّامَّاتِ مِن شَرِّ ما خَلَقَ؛ ",1],["فإنَّه لا يَضُرُّه شيءٌ حتَّى يَرتَحِلَ منه",2],"."],"grade":"صحيح","narrator":"خولة بنت حكيم","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"استعاذة › التعوذ","dorar":"0jZIeGUD","merged":2,"otherRefs":["تخريج المسند لشعيب 27310 (صحيح)"]},{"id":"س-00972","fp":"2516641d9682","stateId":345,"easy":"إذا نزلت منزلاً فقلت «أعوذ بكلمات الله التامات من شر ما خلق» ← لا يضرك شيء حتى ترحل","cause":"مَن نزَلَ منزِلًا، فقالَ: أعوذُ بكلماتِ اللهِ التَّامَّاتِ كلِّها من شرِّ ما خلَقَ","result":"لم يضُرَّهُ في منزلِهِ ذلكَ شيءٌ حتَّى يظعَنَ عنه","explicit":true,"apply":{"k":"say","t":"«أعوذ بكلمات الله التامات من شر ما خلق» · الوقت: في السفر"},"repOf":"س-03237","ref":"تخريج المسند لشعيب 27123","text":[["مَن نزَلَ منزِلًا، فقالَ: أعوذُ بكلماتِ اللهِ التَّامَّاتِ كلِّها من شرِّ ما خلَقَ، ",1],["لم يضُرَّهُ في منزلِهِ ذلكَ شيءٌ حتَّى يظعَنَ عنه",2],"."],"grade":"صحيح","narrator":"خولة بنت حكيم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2708)، والترمذي (3437)، والنسائي في ((السنن الكبرى)) (10394)، وابن ماجه (3547) بنحوه، وأحمد (27123) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"gY3EeWBn"},{"id":"س-00973","fp":"536b29344a8f","stateId":345,"easy":"إذا نزلت منزلاً فقلت «أعوذ بكلمات الله التامة...» ← تُوقى شر منزلك حتى ترحل","cause":"ما من مُسلمٍ يَنزِلُ مَنزِلًا، فيقولُ حينَ يَنزِلُ: أعوذُ بكَلِماتِ اللهِ التَّامَّةِ من شَرِّ ما خلَقَ -وقال يزيدُ: ثلاثًا","result":"إلَّا وُقِيَ شَرَّ مَنْزِلِه ذلكَ حتَّى يَظْعَنَ منهُ","explicit":true,"apply":{"k":"say","t":"«أعوذُ بكَلِماتِ اللهِ التَّامَّةِ من شَرِّ ما خلَقَ -وقال يزيدُ: ثلاثًا- إلَّا وُقِيَ شَرَّ مَنْزِلِه ذلكَ حتَّى يَظْعَنَ منه» · الوقت: في السفر"},"ref":"تخريج المسند لشعيب 27311","srcLabel":"مسلم","text":[["ما من مُسلمٍ يَنزِلُ مَنزِلًا، فيقولُ حينَ يَنزِلُ: أعوذُ بكَلِماتِ اللهِ التَّامَّةِ من شَرِّ ما خلَقَ -وقال يزيدُ: ثلاثًا-",1]," ",["إلَّا وُقِيَ شَرَّ مَنْزِلِه ذلكَ حتَّى يَظْعَنَ منهُ",2],"."],"grade":"صحيح","narrator":"خولة بنت حكيم","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2708)، والترمذي (3437)، والنسائي في ((السنن الكبرى)) (10394)، وابن ماجه (3547) بنحوه، وأحمد (27311) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"Tg9FK3yg"},{"id":"س-06238","fp":"fa1d4dc8bdc3","stateId":345,"easy":"إذا سافرت ← فأنت في حفظ الله إذا دُعي لك","cause":"إنِّي أريدُ سَفَرًا فأَوْصِني","result":"في حِفْظِ اللهِ وفي كَنَفِه، وزَوَّدَك اللهُ التَّقْوى، وغَفَرَ ذَنْبَك، ووَجَّهَك للخَيْرِ حيثُ ما كُنْتَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"في السفر"},"otherNeedIds":[29],"ref":"الأحاديث المختارة 2674","srcLabel":"متفق عليه","text":["«أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقالَ: يا نَبيَّ اللهِ ",["إنِّي أريدُ سَفَرًا فأَوْصِني",1],"، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: مَتى؟ قالَ: غَدًا إن شاءَ اللهُ، ثُمَّ أتاه فأخَذَ بيَدِه فقالَ له: ",["في حِفْظِ اللهِ وفي كَنَفِه، وزَوَّدَك اللهُ التَّقْوى، وغَفَرَ ذَنْبَك، ووَجَّهَك للخَيْرِ حيثُ ما كُنْتَ",2],"، أو أين ما كُنْتَ -شَكَّ سَعيدٌ في إحدى الكَلِمَتَينِ»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"سفر › توديع المنزل بركعتين وما يقال عند التوديع","dorar":"57IrGAg1"},{"id":"س-03691","fp":"3b4e1adb3730","stateId":345,"easy":"إذا ودّعت مسافراً فقل «أستودع الله دينك وأمانتك وخواتيم عملك» ← يحفظه الله","cause":"وأَرسَلَني في حاجةٍ لهُ، فقال: تَعالَ حتى أُودِّعَك كما وَدَّعَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأَرسَلَني في حاجةٍ لهُ، فأَخَذ بيَدي","result":"أَستَودِعُ اللهَ دِينَك وأَمانَتَك وخَواتيمَ عمَلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أستودع الله دينك وأمانتك وخواتيم عملك»"},"similar":["س-07565"],"otherNeedIds":[29],"ref":"تخريج المسند لشعيب 4957","srcLabel":"أبو داود","text":["عن قَزَعةَ قال: قال عبدُ اللهِ بنُ عُمرَ ",["وأَرسَلَني في حاجةٍ لهُ، فقال: تَعالَ حتى أُودِّعَك كما وَدَّعَني رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وأَرسَلَني في حاجةٍ لهُ، فأَخَذ بيَدي",1],"، فقال: ",["أَستَودِعُ اللهَ دِينَك وأَمانَتَك وخَواتيمَ عمَلِكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2600)، والترمذي (3443)، والنسائي في ((السنن الكبرى)) (8806)، وابن ماجه (2826)، وأحمد (4957) واللفظ له","bab":"اعتصام بالسنة › لزوم السنة","dorar":"2uSqTFjp","merged":3,"otherRefs":["تخريج المسند لشعيب 9230 (صحيح)","تخريج مشكل الآثار 5940 (صحيح)"]},{"id":"س-06237","fp":"4fcc04cc1e5d","stateId":345,"easy":"إذا سافرت فاتقِ الله وكبّر على كل شرف ← يطوي الله لك البعيد","cause":"يُريدُ سفرًا فسلَّم عليه","result":"أوصيك بتقوى اللهِ والتَّكبيرِ على كلِّ شَرَفٍ حتَّى إذا أدبَر الرَّجلُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"في السفر"},"otherNeedIds":[29],"ref":"صحيح ابن حبان 2692","srcLabel":"الترمذي","text":["أنَّ رجلًا جاءه وهو ",["يُريدُ سفرًا فسلَّم عليه",1]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["أوصيك بتقوى اللهِ والتَّكبيرِ على كلِّ شَرَفٍ ) حتَّى إذا أدبَر الرَّجلُ",2]," قال: ( اللَّهمَّ ازْوِ له الأرضَ وهوِّنْ عليه السَّفرَ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (3445)، وأحمد (8310) باختلاف يسير، وابن ماجه (2771) مختصراً باختلاف يسير","bab":"سفر › توديع المنزل بركعتين وما يقال عند التوديع","dorar":"2AwznKLm","merged":2,"otherRefs":["تخريج المسند لشعيب 8385 (حسن)"]},{"id":"س-03689","fp":"4be00fbbaa14","stateId":345,"easy":"إذا ركبت دابتك فقل «بسم الله... الحمد لله الذي سخر لنا هذا» ← (ذكر الركوب)","cause":"ركِب عليٌّ دابَّةً فقال: بسمِ اللهِ فلمَّا استوى عليها","result":"الحمدُ للهِ الَّذي أكرَمنا وحمَلنا في البَرِّ والبحرِ ورزَقنا مِن الطَّيِّباتِ وفضَّلنا على كثيرٍ ممَّن خلَقه تفضيلًا: {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} [الزخرف: 13، 14] ثمَّ كبَّر ثلاثًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«بسمِ اللهِ فلمَّا استوى عليها قال: الحمدُ للهِ الَّذي أكرَمنا وحمَلنا في البَرِّ والبحرِ ورزَقنا مِن الطَّيِّباتِ وفضَّلنا على كثيرٍ ممَّن خلَقه تفضيلًا: {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا» · الوقت: في السفر"},"otherNeedIds":[11],"ref":"صحيح ابن حبان 2697","srcLabel":"أبو داود","text":[["ركِب عليٌّ دابَّةً فقال: بسمِ اللهِ فلمَّا استوى عليها",1]," قال: ",["الحمدُ للهِ الَّذي أكرَمنا وحمَلنا في البَرِّ والبحرِ ورزَقنا مِن الطَّيِّباتِ وفضَّلنا على كثيرٍ ممَّن خلَقه تفضيلًا: {سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} [الزخرف: 13، 14] ثمَّ كبَّر ثلاثًا",2]," ثمَّ قال: اللَّهمَّ اغفِرْ لي إنَّه لا يغفِرُ الذُّنوبَ غيرُك ثمَّ قال: فعَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم مِثلَ هذا وأنا أردفه"],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الدولابي في ((الكنى والأسماء)) (1931)، باختلاف يسير، وأبو داود (2602)، والترمذي (3446)، بلفظ مقارب.","bab":"اعتصام بالسنة › لزوم السنة","dorar":"DRby10N3"},{"id":"س-06236","fp":"f205f07b647d","stateId":345,"easy":"إذا أردت السفر فقل لمن تخلّف «أستودعكم الله الذي لا تضيع ودائعه» ← يحفظهم الله","cause":"فليقُلْ لِمَن يُخلِّفُ : استودعُكُمُ اللَّهَ الَّذي لا تضيعُ ودائعُهُ","result":"مَن أرادَ أن يسافرَ","explicit":true,"apply":{"k":"say","t":"«أستودعكم الله الذي لا تضيع ودائعه» · الوقت: في السفر"},"ref":"الكلم الطيب 168","srcLabel":"النسائي","text":[["مَن أرادَ أن يسافرَ ، ",2],["فليقُلْ لِمَن يُخلِّفُ : استودعُكُمُ اللَّهَ الَّذي لا تضيعُ ودائعُهُ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10342)، وابن ماجه (2825)، أحمد (9230) بنحوه، والطبراني في ((الدعاء)) (823) واللفظ له","bab":"سفر › توديع المنزل بركعتين وما يقال عند التوديع","dorar":"iR5fxAkx"},{"id":"س-07565","fp":"5b9884151105","stateId":345,"easy":"إذا ودّعت جيشاً أو مسافراً فقل «أستودع الله دينكم وأمانتكم وخواتيم أعمالكم» ← يحفظهم الله","cause":"إذا شيَّعَ جَيشًا","result":"أستَودِعُ اللهَ دِينَكم، وأمانتَكم، وخواتمَ أعمالِكم","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«أستودع الله دينكم وأمانتكم وخواتيم أعمالكم»"},"repOf":"س-03691","otherNeedIds":[29],"ref":"تخريج مشكل الآثار 5942","text":["كان رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["إذا شيَّعَ جَيشًا",1]," بلَغَ ثَنيَّةَ الوَداعِ، وقال: ",["أستَودِعُ اللهَ دِينَكم، وأمانتَكم، وخواتمَ أعمالِكم",2],"."],"grade":"صحيح","narrator":"عبدالله بن يزيد الخطمي","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (5942) واللفظ له، وأبو داود (2601)، والحاكم (2478) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"ngJWxMrb"},{"id":"س-07449","fp":"8c1e697a805e","stateId":345,"easy":"إذا سافرتم ثلاثة فأكثر ← لا يهمّ بكم الشيطان","cause":"فإذا كانوا ثَلاثةً","result":"لم يَهُمَّ بِهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"في السفر"},"ref":"الأحكام الوسطى 3/ 26","srcLabel":"البزار","text":["إنَّ الشَّيْطانَ يَهُمُّ بالواحِدِ وبالاثْنَينِ، ",["فإذا كانوا ثَلاثةً",1]," ",["لم يَهُمَّ بِهم",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه البزار (7834)، وابن عبد البر في ((التمهيد)) (20/ 8) بلفظه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"nAGvo5Km"},{"id":"س-01251","fp":"cde88060c214","stateId":346,"easy":"إذا خرجت من بيتك فقلت «بسم الله، توكلت على الله، لا حول ولا قوة إلا بالله» ← تُهدى وتُكفى وتُوقى","cause":"إذا خرجَ الرجلُ من بيتِه فقال : بِسمِ اللهِ","result":"يقولُ الملَكُ : هُدِيتَ ، فإذا قال : لا حولَ ولا قوَّةَ إلَّا باللهِ ، قال الملَكُ وُقِيتَ ، فإذا قال : توكلتُ على اللهِ ، يقولُ الملَكُ : كُفِيتَ ، يقولُ الشيطانُ عندَ ذلكَ : كيفَ لِي مَنْ كُفِيَ وهُدِيَ ووُقِيَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"apply":{"k":"say","t":"«بسم الله، توكلت على الله، لا حول ولا قوة إلا بالله» · الوقت: عند الخروج من البيت"},"otherNeedIds":[25,15],"ref":"تسديد القوس 1/360","srcLabel":"ابن شاهين","text":[["إذا خرجَ الرجلُ من بيتِه فقال : بِسمِ اللهِ",1]," ، ",["يقولُ الملَكُ : هُدِيتَ ، فإذا قال : لا حولَ ولا قوَّةَ إلَّا باللهِ ، قال الملَكُ وُقِيتَ ، فإذا قال : توكلتُ على اللهِ ، يقولُ الملَكُ : كُفِيتَ ، يقولُ الشيطانُ عندَ ذلكَ : كيفَ لِي مَنْ كُفِيَ وهُدِيَ ووُقِيَ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن شاهين في ((لترغيب في فضائل الأعمال)) (349)، والديلمي في ((الفردوس)) (1155) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا حول ولا قوة إلا بالله","dorar":"77Zdha9v"},{"id":"س-00143","fp":"0e6c3968255f","stateId":346,"easy":"إذا خرجت غازياً أو إلى المسجد أو دخلت بيتك بسلام ← تكون في ضمان الله","cause":"رَجلٌ خَرَجَ غازِيًا في سبيلِ اللهِ؛ فهو ضامِنٌ على اللهِ حتَّى يَتوَفَّاهُ، فيُدخِلَهُ الجنَّةَ، أوْ يَرُدَّه بما نالَ مِن أَجْرٍ أوْ غَنيمَةٍ، ورَجلٌ راحَ إلى المسجدِ؛ فهو ضامِنٌ على اللهِ حتَّى يَتوَفَّاهُ، فيُدخِلَهُ الجنَّةَ أوْ يَرُدَّه بما نالَ مِنْ أَجْرٍ أوْ غَنيمَةٍ، ورَجلٌ دَخَلَ بيتَهُ بالسَّلامِ؛ فهو ضامِنٌ على اللهِ","result":"ثلاثةٌ كُلُّهم ضامِنٌ على اللهِ","explicit":true,"star":true,"apply":{"k":"time","t":"عند دخول البيت"},"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 2435","srcLabel":"البخاري","text":[["ثلاثةٌ كُلُّهم ضامِنٌ على اللهِ",2],":",[" رَجلٌ خَرَجَ غازِيًا في سبيلِ اللهِ؛ فهو ضامِنٌ على اللهِ حتَّى يَتوَفَّاهُ، فيُدخِلَهُ الجنَّةَ، أوْ يَرُدَّه بما نالَ مِن أَجْرٍ أوْ غَنيمَةٍ، ورَجلٌ راحَ إلى المسجدِ؛ فهو ضامِنٌ على اللهِ حتَّى يَتوَفَّاهُ، فيُدخِلَهُ الجنَّةَ أوْ يَرُدَّه بما نالَ مِنْ أَجْرٍ أوْ غَنيمَةٍ، ورَجلٌ دَخَلَ بيتَهُ بالسَّلامِ؛ فهو ضامِنٌ على اللهِ.",1]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو داود (2494)، والبخاري في ((الأدب المفرد)) (1094)، وابن أبي عاصم في ((الجهاد)) (51)، وابن حبان (631) واللفظ لهم.","bab":"آداب السلام › إفشاء السلام","dorar":"SgzgRf2q"},{"id":"س-04440","fp":"68273941774d","stateId":346,"easy":"إذا خرجت إلى المسجد ← تكون في ضمان الله","cause":"ومَن خرجَ إلى المسجِدِ","result":"فَهوَ ضامنٌ علَى اللَّهِ","explicit":true,"star":true,"otherNeedIds":[25],"ref":"الترغيب والترهيب 1/172","srcLabel":"البخاري","text":["ثلاثةٌ كلُّهم ضامنٌ علَى اللَّهِ إن عاشَ رزقَ وَكُفيَ وإن ماتَ أدخلَهُ اللَّهُ الجنَّةَ مَن دخلَ بيتَهُ فسلَّمَ فَهوَ ضامنٌ على اللَّهِ ",["ومَن خرجَ إلى المسجِدِ ",1],["فَهوَ ضامنٌ علَى اللَّهِ ",2],"ومَن خرجَ في سبيلِ اللَّهِ فَهوَ ضامنٌ على اللَّهِ"],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (2494)، والبخاري في ((الأدب المفرد)) (1094)، وابن حبان (499) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"qUDi3czV"},{"id":"س-04441","fp":"2c59dc1db89e","stateId":346,"easy":"إذا خرجت في سبيل الله ← تكون في ضمان الله","cause":"ومَن خرجَ في سبيلِ اللَّهِ","result":"فَهوَ ضامنٌ على اللَّهِ","explicit":true,"star":true,"otherNeedIds":[25],"ref":"الترغيب والترهيب 1/172","srcLabel":"البخاري","text":["ثلاثةٌ كلُّهم ضامنٌ علَى اللَّهِ إن عاشَ رزقَ وَكُفيَ وإن ماتَ أدخلَهُ اللَّهُ الجنَّةَ مَن دخلَ بيتَهُ فسلَّمَ فَهوَ ضامنٌ على اللَّهِ ومَن خرجَ إلى المسجِدِ فَهوَ ضامنٌ علَى اللَّهِ ",["ومَن خرجَ في سبيلِ اللَّهِ ",1],["فَهوَ ضامنٌ على اللَّهِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (2494)، والبخاري في ((الأدب المفرد)) (1094)، وابن حبان (499) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"qUDi3czV"},{"id":"س-05794","fp":"34b2153dfc47","stateId":346,"easy":"إذا تركت السهر بعد هدوء الناس ← تتقي ما يبثه الله في الليل","cause":"إيَّاكَ والسَّمَرَ بعدَ هَدْأَةِ الرِّجْلِ","result":"فإنَّكمْ لا تَدرونَ ما يأتي اللهُ في خلقِهِ","explicit":true,"similar":["س-05890"],"ref":"الجامع الصغير 2876","srcLabel":"البخاري","text":[["إيَّاكَ والسَّمَرَ بعدَ هَدْأَةِ الرِّجْلِ ؛ ",1],["فإنَّكمْ لا تَدرونَ ما يأتي اللهُ في خلقِهِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7764) بلفظه، والبخاري في ((الأدب المفرد)) (1230) بنحوه، والبغوي في ((شرح السنة)) (3060) بمعناه في جزء منه.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"DJ1tdKEW"},{"id":"س-05890","fp":"7dad5934d251","stateId":346,"easy":"إذا تركت السهر بعد هدوء الليل وأغلقت أبوابك ← تتقي ما يبثه الله من خلقه","cause":"إيَّاكُم والسَّمَرَ بعدَ هدوءِ الليلِ","result":"فإنَّ أحدَكُم لا يَدْري ما يَبُثُّ اللهُ مِن خَلْقِه، غَلِّقوا الأبْوابَ، وَأَوْكُوا الأسْقِيةَ، وأَكْفِئوا الإناءَ، وأطْفِئوا المَصابيحَ","explicit":true,"repOf":"س-05794","ref":"تخريج المسند لشعيب 23/130","text":[["إيَّاكُم والسَّمَرَ بعدَ هدوءِ الليلِ؛ ",1],["فإنَّ أحدَكُم لا يَدْري ما يَبُثُّ اللهُ مِن خَلْقِه، غَلِّقوا الأبْوابَ، وَأَوْكُوا الأسْقِيةَ، وأَكْفِئوا الإناءَ، وأطْفِئوا المَصابيحَ",2],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"إسناده قوي على شرط مسلم.","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1230)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"flP0nPnC"},{"id":"س-00787","fp":"dc84662c0aa6","stateId":346,"easy":"إذا قلت عند خروجك للمسجد «أعوذ بالله العظيم وبوجهه الكريم...» ← يقول الملك: كُفيت ووُقيت","cause":"من خرج من بيتِه إلى المسجدِ فقال أعوذُ باللهِ العظيِمِ وسلطانِه القديمِ من الشَّيطانِ الرَّجيمِ ربِّي اللهُ توكَّلتُ على اللهِ لاحولَ ولا قوَّةَ إلَّا باللهِ","result":"قال له الملكُ كُفِيتَ ووُقِيتَ","explicit":true,"apply":{"k":"say","t":"«أعوذ بالله العظيم وبوجهه الكريم...»"},"otherNeedIds":[25],"ref":"الترغيب والترهيب 2/380","srcLabel":"ابن ماجه","text":[["من خرج من بيتِه إلى المسجدِ فقال أعوذُ باللهِ العظيِمِ وسلطانِه القديمِ من الشَّيطانِ الرَّجيمِ ربِّي اللهُ توكَّلتُ على اللهِ لاحولَ ولا قوَّةَ إلَّا باللهِ",1]," ",["قال له الملكُ كُفِيتَ ووُقِيتَ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن ماجه (3886)، والطبراني في ((الدعاء)) (409) باختلاف يسير، وذكره رزين كما في ((الترغيب والترهيب)) للمنذري (3/305) واللفظ له","bab":"أدعية وأذكار › الذكر عند الخروج من المنزل","dorar":"AqZDWxo4"},{"id":"س-06902","fp":"6466b250edf5","stateId":346,"easy":"إذا قلت عند دخول المسجد «أعوذ بالله العظيم وبوجهه الكريم...» ← يقول الشيطان: حُفظ مني سائر اليوم","cause":"إذا دخل المسجدَ قال أعوذُ باللهِ العظيمِ ، وبوجهِهِ الكريمِ ، وبسلطانِهِ القديمِ ، من الشيطانِ الرجيمِ","result":"قال الشيطانُ : حُفِظَ مِنِّي سائرَ اليومِ","explicit":true,"apply":{"k":"say","t":"«أعوذ بالله العظيم وبوجهه الكريم...»"},"ref":"الكلم الطيب 66","srcLabel":"أبو داود","text":["عن النبيِّ صلَّى اللهُ عليه وسلَّم أنه كان ",["إذا دخل المسجدَ قال أعوذُ باللهِ العظيمِ ، وبوجهِهِ الكريمِ ، وبسلطانِهِ القديمِ ، من الشيطانِ الرجيمِ",1]," . قال : فإذا قال ذلك ، ",["قال الشيطانُ : حُفِظَ مِنِّي سائرَ اليومِ",2]],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (466)، والبيهقي في ((الدعوات الكبير)) (68)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"jABPMEki"},{"id":"س-00782","fp":"3f45a525e44e","stateId":346,"easy":"إذا خرجت من منزلك فصليت ركعتين ← تمنعانك مخرج السوء","cause":"إذا خَرَجتَ مِن مَجلسِكَ فصَلِّ رَكعَتَينِ","result":"تَمنَعانِكَ مِن مَخرَجِ السُّوءِ","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: عند الخروج من البيت"},"ref":"الفوائد المجموعة 56","srcLabel":"البيهقي","text":["إذا دَخَلتَ مَنزِلَكَ فصَلِّ رَكعَتَينِ تَمنَعانِكَ مَدخَلَ السُّوءِ، و",["إذا خَرَجتَ مِن مَجلسِكَ فصَلِّ رَكعَتَينِ",1]," ",["تَمنَعانِكَ مِن مَخرَجِ السُّوءِ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن","takhrij":"أخرجه البزار (8567)، والبيهقي في ((شعب الإيمان)) (2814)، وقوام السنة في ((الترغيب والترهيب)) (2011) باختلاف يسير.","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"F6i9BVpb"},{"id":"س-01154","fp":"4c19d5e0d732","stateId":346,"easy":"إذا هدأت الحركة ليلاً فاتقِ الخروج ← فإن لله دواب يبثها في الأرض","cause":"اتَّقُوا الخُروجَ باللَّيلِ إذا هدَأَت الرِّجْلُ","result":"فإنَّ للهِ دوابَّ يَبُثُّهم في الأرضِ، فإذا سَمِعتُم نهيقَ الحِمارِ ونُباحَ الكِلابِ، فتعَوَّذوا باللهِ مِنَ الشَّيطانِ الرَّجيمِ؛ فإنَّهم يَرَونَ ما لا تَرَونَ، وافعَلوا ما تُؤمَرونَ","explicit":true,"ref":"الضعفاء الكبير 2/20","srcLabel":"العقيلي","text":[["اتَّقُوا الخُروجَ باللَّيلِ إذا هدَأَت الرِّجْلُ؛ ",1],["فإنَّ للهِ دوابَّ يَبُثُّهم في الأرضِ، فإذا سَمِعتُم نهيقَ الحِمارِ ونُباحَ الكِلابِ، فتعَوَّذوا باللهِ مِنَ الشَّيطانِ الرَّجيمِ؛ فإنَّهم يَرَونَ ما لا تَرَونَ، وافعَلوا ما تُؤمَرونَ",2]],"grade":"حسن","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"يروى بغير هذا الإسناد من طريق صالح وافعلوا ما تؤمرون لا أحفظه إلا في هذا","takhrij":"أخرجه العقيلي في ((الضعفاء الكبير)) (2/20)","bab":"أدعية وأذكار › فضل الذكر","dorar":"humBRryZ"},{"id":"س-07569","fp":"1377e070f223","stateId":347,"easy":"إذا أعجبك شيء في نفسك أو مالك أو أخيك فادعُ بالبركة ← تتقي العين (فالعين حق)","cause":"إذا رأى أحَدُكم مِن نَفْسِه أو مالِه أو أخيه فلْيَدْعُ له بالبَرَكةِ","result":"فإنَّ العَيْنَ حَقٌّ","explicit":true,"star":true,"ref":"الأحاديث المختارة 8 / 187","srcLabel":"متفق عليه","text":["«انْطَلَقْتُ أنا وسَهْلُ بنُ حُنيفٍ نَلْتَمِسُ الخَمْرَ، فوَجَدْنا خَمْرًا وغَديرًا، قالَ: وكانَ أحَدُنا يَسْتَحي أن يَغْتَسِلَ وأحَدٌ يَراه، فاسْتَتَرَ مِنِّي حتَّى إذا رأى أن قد فَعَلَ نَزَعَ جُبَّةً عليه مِن كِساءٍ، ثُمَّ دَخَلَ الماءَ، فنَظَرْتُ إليه نَظْرةً فأعْجَبَني خَلْقُه، فأصَبْتُه بعَيْني، فأخَذَتْه قَعْقَعةٌ وهو في الماءِ، فدَعَوْتُه فلم يُجِبْني، فانْطَلَقْتُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّمَ فأخْبَرْتُه الخَبَرَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (قوموا بنا) فأتاه فرَفَعَ عن ساقِه فدَخَلَ الماءَ، فلمَّا أتاه ضَرَبَ صَدْرَه وقالَ: اللَّهُمَّ أذْهِبْ حَرَّها وبَرْدَها ووَصَبَها ثُمَّ قالَ: (قُمْ) فقامَ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (",["إذا رأى أحَدُكم مِن نَفْسِه أو مالِه أو أخيه فلْيَدْعُ له بالبَرَكةِ؛ ",1],["فإنَّ العَيْنَ حَقٌّ»)",2],"."],"grade":"صحيح","narrator":"عامر بن ربيعة","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"فضائل النبي وصفته ودلائل النبوة › دعاء النبي لبعض الناس","dorar":"EHdjMJA2","merged":3,"otherRefs":["السلسلة الصحيحة 2572 (صحيح)","الكلم الطيب 244 (صحيح)"]},{"id":"س-01643","fp":"2aca8c0f7ccb","stateId":347,"easy":"إذا أكلت صباحاً سبع تمرات عجوة من المدينة ← لا يضرك شيء يومك حتى تمسي","cause":"مَن أكَلَ سَبعَ تَمَراتِ عَجوةٍ ما بَينَ لابَتَيِ المَدينةِ حين يُصبِحُ","result":"لم يَضُرَّهُ يَومَهُ ذلك شَيءٌ حتى يُمسيَ","explicit":true,"star":true,"apply":{"k":"time","t":"في الصباح"},"otherNeedIds":[35],"ref":"تخريج المسند لشعيب 1528","srcLabel":"متفق عليه","text":["حدَّثَ عامِرُ بنُ سَعدٍ، عُمَرَ بنَ عَبدِ العَزيزِ، وهو أميرٌ على المَدينةِ، أنَّ سَعدًا قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن أكَلَ سَبعَ تَمَراتِ عَجوةٍ ما بَينَ لابَتَيِ المَدينةِ حين يُصبِحُ، ",1],["لم يَضُرَّهُ يَومَهُ ذلك شَيءٌ حتى يُمسيَ",2],". قال فُلَيحٌ: وأظُنُّهُ قد قال: وإنْ أكَلَها حين يُمسي لم يَضُرَّهُ شَيءٌ حتى يُصبِحَ. قال: فقال عُمَرُ: يا عامِرُ، انظُرْ ما تُحدِّثُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فقال عامِرٌ: وَاللهِ ما كذَبتُ على سَعدٍ، وما كذَبَ سَعدٌ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5768)، وأبو داود (3876)، والنسائي في ((السنن الكبرى)) (6713) بنحوه، ومسلم (2047) بنحوه مختصراً، وأحمد (1528) واللفظ له","bab":"أطعمة › ما يحل من الأطعمة","dorar":"3f1Jq5dd","merged":2,"otherRefs":["صحيح الجامع 6085 (صحيح)"]},{"id":"س-02707","fp":"754f95565b08","stateId":347,"easy":"إذا أكلت تمرات عجوة كل صباح ← لا يضرك سم ولا سحر ذلك اليوم","cause":"مَنِ اصطَبَحَ كُلَّ يَومٍ تَمَراتٍ عَجوةً","result":"لم يَضُرَّه سُمٌّ ولا سِحرٌ ذلك اليومَ إلى اللَّيلِ","explicit":true,"similar":["س-02708"],"otherNeedIds":[35],"ref":"صحيح البخاري 5768","srcLabel":"مسلم","text":[["مَنِ اصطَبَحَ كُلَّ يَومٍ تَمَراتٍ عَجوةً، ",1],["لم يَضُرَّه سُمٌّ ولا سِحرٌ ذلك اليومَ إلى اللَّيلِ",2],"، وقال غَيرُه: سَبعَ تَمَراتٍ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2047)، وأبو داود (3876)، والنسائي في ((الكبرى)) واللفظ لهم.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"FvwI2Z92","merged":3,"otherRefs":["مجموع فتاوى ابن باز 21/6 (صحيح)","تخريج المسند لشعيب 1571 (صحيح)"]},{"id":"س-01644","fp":"a30171b59fd2","stateId":347,"easy":"إذا أكلتها مساءً ← لا يضرك شيء حتى تصبح","cause":"وإنْ أكَلَها حين يُمسي","result":"لم يَضُرَّهُ شَيءٌ حتى يُصبِحَ","explicit":true,"apply":{"k":"time","t":"في المساء"},"otherNeedIds":[35],"ref":"تخريج المسند لشعيب 1528","srcLabel":"متفق عليه","text":["حدَّثَ عامِرُ بنُ سَعدٍ، عُمَرَ بنَ عَبدِ العَزيزِ، وهو أميرٌ على المَدينةِ، أنَّ سَعدًا قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مَن أكَلَ سَبعَ تَمَراتِ عَجوةٍ ما بَينَ لابَتَيِ المَدينةِ حين يُصبِحُ، لم يَضُرَّهُ يَومَهُ ذلك شَيءٌ حتى يُمسيَ. قال فُلَيحٌ: وأظُنُّهُ قد قال: ",["وإنْ أكَلَها حين يُمسي ",1],["لم يَضُرَّهُ شَيءٌ حتى يُصبِحَ",2],". قال: فقال عُمَرُ: يا عامِرُ، انظُرْ ما تُحدِّثُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فقال عامِرٌ: وَاللهِ ما كذَبتُ على سَعدٍ، وما كذَبَ سَعدٌ على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه البخاري (5768)، وأبو داود (3876)، والنسائي في ((السنن الكبرى)) (6713) بنحوه، ومسلم (2047) بنحوه مختصراً، وأحمد (1528) واللفظ له","bab":"أطعمة › ما يحل من الأطعمة","dorar":"3f1Jq5dd"},{"id":"س-02708","fp":"7ace7d98eb7b","stateId":347,"easy":"إذا أكلت كل صباح سبع تمرات عجوة ← لا يضرك سم ولا سحر يومك","cause":"مَن تَصَبَّحَ كُلَّ يَومٍ سَبعَ تَمَراتٍ عَجوةً","result":"لم يَضُرَّه في ذلك اليَومِ سُمٌّ ولا سِحرٌ","explicit":true,"repOf":"س-02707","otherNeedIds":[35],"ref":"صحيح البخاري 5445","text":[["مَن تَصَبَّحَ كُلَّ يَومٍ سَبعَ تَمَراتٍ عَجوةً، ",1],["لم يَضُرَّه في ذلك اليَومِ سُمٌّ ولا سِحرٌ",2],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2047)، وأبو داود (3876)، والنسائي في ((الكبرى)) واللفظ لهم.","bab":"إيمان › السحر والنشرة والكهانة","dorar":"sPvK82vt"},{"id":"س-03244","fp":"0b7cd452a5c8","stateId":347,"easy":"إذا استعذت بالله من العين ← تُحفظ (فالعين حق)","cause":"استعيذوا باللَّهِ","result":"فإنَّ العينَ حقٌّ","explicit":true,"similar":["س-03245"],"ref":"صحيح ابن ماجه 2843","srcLabel":"ابن ماجه","text":[["استعيذوا باللَّهِ ",1],["فإنَّ العينَ حقٌّ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3508) واللفظ له، والخرائطي في ((مكارم الأخلاق)) (1063)، والحاكم (7497)","bab":"استعاذة › ما يؤمر به من التعوذ","dorar":"WLp7Lm9N"},{"id":"س-03245","fp":"c853ff3bc462","stateId":347,"easy":"إذا استعذت بالله من العين ← تُحفظ منها","cause":"اسْتَعِيذُوا باللهِ تَعالَى مِنَ العَيْنِ","result":"فإنَّ العَيْنَ حقٌّ","explicit":true,"repOf":"س-03244","ref":"السلسلة الصحيحة 737","text":[["اسْتَعِيذُوا باللهِ تَعالَى مِنَ العَيْنِ ",1],["فإنَّ العَيْنَ حقٌّ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (3508) باختلاف يسير، والخرائطي في ((مكارم الأخلاق)) (1063)، والحاكم (7497) واللفظ لهما.","bab":"استعاذة › ما يؤمر به من التعوذ","dorar":"LQpIJRtG"},{"id":"س-05349","fp":"ae92a015bf2e","stateId":347,"easy":"إذا سمّيت الله على ما تخاف ضرره ← لا يضرك (من فعل خالد)","cause":"وقالَ بسمِ اللَّهِ","result":"فلم يضرَّه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"time","t":"عند الطعام"},"ref":"در السحابة 370","srcLabel":"أحمد","text":["نزلَ خالدُ بنُ الوليدِ الحيرةَ فقالوا لهُ احذرِ السُّمَّ لا يسقيكَهُ الأعاجِمُ فقالَ ائتوني بهِ فأُتِيَ بهِ فأخذهُ بيدِهِ ثمَّ اقتحمَهُ ",["وقالَ بسمِ اللَّهِ",1],". ",["فلم يضرَّه",2]],"grade":"صحيح","narrator":"سعيد بن يحمد الهمداني أبو السفر","muhaddith":"[له أسانيد الأول] رجاله رجال الصحيح و[الثاني والثالث] رجالهما ثقات","takhrij":"أخرجه أحمد في ((فضائل الصحابة)) (1478)، وأبو يعلى (7186)، وأبو نعيم في ((دلائل النبوة)) (368) واللفظ لهم جميعا.","bab":"رقائق وزهد › التوكل واليقين","dorar":"odqNlrDG"},{"id":"س-00441","fp":"6b26771605e4","stateId":347,"easy":"إذا رأيت ما يعجبك فبرّك ← لا تصيبه بعينك","cause":"إذا رأيتَ ما يُعجبُك برَّكتَ","result":"علامَ يقتلُ أحدَكم أخاهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"مجمع الزوائد 5/110","srcLabel":"أحمد","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ خرج معه وسار معَهُ نحوَ مكةَ حتى إذا كان بشِعبِ الخزارِ من الجحفةِ اغتسل سهلُ بنُ حنيفٍ وكان أبيضَ حسنَ الجسمِ والجلدِ فنظر إليه عامرُ بنُ ربيعةَ أخو بني عديِّ بنِ كعبٍ وهو يغتسلُ فقال ما رأيتُ كاليومِ ولا جلدَ مخبأةٍ فلبطَ سهلٌ فأتى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فقيل يا رسولَ اللهِ هل لك في سهلٍ واللهِ ما يرفعُ رأسَه ولا يفيقُ قال هل تتهمون فيه من أحدٍ قالوا عامرُ بنُ ربيعةَ فدعا رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عامرَ بنَ ربيعةَ فتغيَّظَ عليه وقال ",["علامَ يقتلُ أحدَكم أخاهُ",2]," هلا ",["إذا رأيتَ ما يُعجبُك برَّكتَ",1]," ثم قال اغتسِلْ لهُ فغسل وجهَه ويديْهِ ومرفقيْهِ وركبتيْهِ وأطرافَ رجليْهِ وداخلةَ إزارِه في قدحٍ ثم صب ذلك الماءَ عليه يصبُّهُ رجلٌ على رأسِه وظهرِه من خلفِه ثم يُلْقِي القدحَ وراءَه ففعل به ذلك فراح سهلٌ مع الناسِ ليس به بأسٌ"],"grade":"صحيح","narrator":"سهل بن حنيف","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (6/ 78) (5573) واللفظ له، وأحمد (15980) بنحوه، وابن أبي عاصم في ((الآحاد والمثاني)) (1910) مختصرًا.","bab":"آداب عامة › الأخلاق المذمومة","dorar":"YAaku3UT"},{"id":"ق-0158","fp":"950b7e7b82e2","stateId":348,"easy":"الصبر والتقوى ← لا يضرّ كيد الأعداء شيئاً","cause":"الصبر والتقوى","result":"لا يضرّ كيد الأعداء شيئاً","explicit":true,"star":true,"otherNeedIds":[25],"ref":"سورة آل عمران: 120","srcLabel":"القرآن الكريم","quran":{"s":3,"from":120,"to":120,"text":"إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكُمْ سَيِّئَةٌ يَفْرَحُوا بِهَا وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا إِنَّ اللَّهَ بِمَا يَعْمَلُونَ مُحِيطٌ (120)","hl":[[83,187,1]]}},{"id":"ق-0322","fp":"82f0b9c3257a","stateId":348,"easy":"تبليغ ما أنزل الله ← عصمة الله من الناس","cause":"تبليغ ما أنزل الله","result":"عصمة الله من الناس","explicit":true,"star":true,"ref":"سورة المائدة: 67","srcLabel":"القرآن الكريم","quran":{"s":5,"from":67,"to":67,"text":"يَا أَيُّهَا الرَّسُولُ بَلِّغْ مَا أُنْزِلَ إِلَيْكَ مِنْ رَبِّكَ وَإِنْ لَمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُ وَاللَّهُ يَعْصِمُكَ مِنَ النَّاسِ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ (67)","hl":[[24,150,1]]}},{"id":"ق-1048","fp":"b123e873422e","stateId":348,"easy":"القلب السليم والثبات على التوحيد ← خيبة كيد الأعداء وجعلهم الأسفلين","cause":"القلب السليم والثبات على التوحيد","result":"خيبة كيد الأعداء وجعلهم الأسفلين","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[25],"ref":"سورة الصافات: 98","srcLabel":"القرآن الكريم","quran":{"s":37,"from":98,"to":98,"text":"فَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَسْفَلِينَ (98)","hl":[[0,55,1]]}},{"id":"ق-1114","fp":"7233d9b6d7cd","stateId":348,"easy":"تفويض الأمر إلى الله ← وقاية الله سيئات المكر","cause":"تفويض الأمر إلى الله","result":"وقاية الله سيئات المكر","explicit":true,"otherNeedIds":[25],"ref":"سورة غافر: 44–45","srcLabel":"القرآن الكريم","quran":{"s":40,"from":44,"to":45,"text":"فَسَتَذْكُرُونَ مَا أَقُولُ لَكُمْ وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ (44) فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا وَحَاقَ بِآلِ فِرْعَوْنَ سُوءُ الْعَذَابِ (45)","hl":[[35,150,1]]}},{"id":"س-05302","fp":"1e8adca26a19","stateId":348,"easy":"إذا توكلت على الله وقلت «الله» حين هُددت ← يحميك الله (من واقعة)","cause":"مَن يَمنَعُكَ مِنِّي؟ قُلتُ: اللهُ","result":"فها هو ذا جالِسٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[25],"ref":"صحيح البخاري 4135","srcLabel":"مسلم","text":["أنَّه غَزا مع رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم قِبَلَ نَجدٍ، فلَمَّا قَفَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم قَفَلَ معهُ، فأدرَكَتهُمُ القائِلةُ في وادٍ كَثيرِ العِضاهِ، فنَزَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وتَفَرَّقَ النَّاسُ في العِضاهِ يَستَظِلُّونَ بالشَّجَرِ، ونَزَلَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم تَحتَ سَمُرةٍ فعَلَّقَ بها سَيفَه. قال جابِرٌ: فنِمنا نَومةً، ثُمَّ إذا رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم يَدعونا فجِئناه، فإذا عِندَه أعرابيٌّ جالِسٌ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إنَّ هذا اختَرَطَ سَيفي وأنا نائِمٌ، فاستَيقَظتُ وهو في يَدِه صَلتًا، فقال لي: ",["مَن يَمنَعُكَ مِنِّي؟ قُلتُ: اللهُ",1],"، ",["فها هو ذا جالِسٌ",2],"، ثُمَّ لَم يُعاقِبْه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (843)، والنسائي في ((الكبرى)) (8801)، وابن حبان (4537)، والطبراني في ((مسند الشاميين)) (3214) جميعا باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"BU0YgLfa"},{"id":"س-05330","fp":"dcf6cd8010e8","stateId":348,"easy":"إذا اعتصمت بالله عند الخطر ← يحميك (من واقعة)","cause":"مَن يَمنعُكَ منِّي؟ قالَ: اللهُ","result":"فسقَطَ السَّيفُ من يَدِه","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 4374","srcLabel":"الحاكم","text":["قال: قاتل رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ مُحارِبَ خَصَفةَ بنَخْلٍ، فرَأَوْا منَ المُسلِمينَ غِرَّةً، فجاءَ رَجلٌ منهم يُقالُ له: غَوْرَثُ بنُ الحارِثِ حتَّى قامَ على رأْسِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ بالسَّيفِ، فقالَ: ",["مَن يَمنعُكَ منِّي؟ قالَ: «اللهُ",1],"»، قالَ: ",["فسقَطَ السَّيفُ من يَدِه",2],"، فأخَذَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ السَّيفَ، فقالَ: «مَن يَمنَعُكَ؟» قالَ: كُنْ خَيرَ آخِذٍ، قالَ: «تَشهَدُ أنْ لا إلَهَ إلَّا اللهُ وأنِّي رَسولُ اللهِ؟» قالَ الأعْرابيُّ: أُعاهِدُكَ ألَّا أُقاتِلَكَ، ولا أكونُ معَ قَومٍ يُقاتِلونَكَ، قالَ: فخَلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ سَبيلَه، فجاءَ إلى قَومِه، فقالَ: جِئْتُكم من عندِ خَيرِ النَّاسِ، فلمَّا حضَرَتِ الصَّلاةُ، صلَّى رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ صَلاةَ الخَوفِ، وكانَ النَّاسُ طائفَتَينِ، طائفةٌ بإزاءِ العَدوِّ، وطائفةٌ تُصلِّي معَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فصَلَّى بالطَّائفةِ الَّذين معَه رَكعَتَينِ، فانْصَرَفوا فكانوا معَ أولئك الَّذين بإزاءِ عَدوِّهم، وجاءَ أولئك فصَلَّى بهِم رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ رَكعَتَينِ، فكانَتْ للنَّاسِ رَكعَتَينِ رَكعَتَينِ، وللنَّبيِّ صلَّى اللهُ عليه وسلَّمَ أربَعُ رَكَعاتٍ."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح على شرط الشيخين","bab":"رقائق وزهد › التوكل واليقين","dorar":"PG47YRS3","merged":2,"otherRefs":["تخريج صحيح ابن حبان 4537 (صحيح)"]},{"id":"س-05362","fp":"076fc630a292","stateId":348,"easy":"إذا دعوت «اللهم اكفنيهم بما شئت» ← يكفيك الله (من قصة الغلام)","cause":"اللَّهُمَّ اكفِنيهم بما شِئتَ","result":"فرَجَفَ بهِمِ الجَبَلُ فسَقَطوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم اكفنيهم بما شئت»"},"similar":["س-05363"],"otherNeedIds":[25],"ref":"صحيح مسلم 3005","srcLabel":"النسائي","text":["كان مَلِكٌ فيمَن كان قَبلَكُم، وكان له ساحِرٌ، فلَمَّا كَبِرَ قال للمَلِكِ: إنِّي قد كَبِرتُ، فابعَث إليَّ غُلامًا أُعَلِّمْه السِّحرَ، فبَعَثَ إليه غُلامًا يُعَلِّمُه، فكان في طَريقِه إذا سَلَكَ راهِبٌ، فقَعَدَ إليه وسَمِعَ كَلامَه، فأعجَبَه، فكان إذا أتى السَّاحِرَ مَرَّ بالرَّاهِبِ وقَعَدَ إليه، فإذا أتى السَّاحِرَ ضَرَبَه، فشَكا ذلك إلى الرَّاهِبِ، فقال: إذا خَشيتَ السَّاحِرَ، فقُل: حَبَسَني أهلي، وإذا خَشيتَ أهلَكَ فقُل: حَبَسَني السَّاحِرُ، فبينَما هو كَذلك إذ أتى على دابَّةٍ عَظيمةٍ قد حَبَسَتِ النَّاسَ، فقال: اليومَ أعلَمُ آلسَّاحِرُ أفضَلُ أمِ الرَّاهِبُ أفضَلُ؟ فأخَذَ حَجَرًا، فقال: اللَّهُمَّ إن كان أمرُ الرَّاهِبِ أحَبَّ إليكَ مِن أمرِ السَّاحِرِ فاقتُلْ هذه الدَّابَّةَ حتَّى يَمضيَ النَّاسُ، فرَماها فقَتَلَها، ومَضى النَّاسُ، فأتى الرَّاهِبَ فأخبَرَه، فقال له الرَّاهِبُ: أي بُنَيَّ، أنتَ اليومَ أفضَلُ مِنِّي؛ قد بَلَغَ مِن أمرِكَ ما أرى، وإنَّكَ سَتُبتَلى، فإنِ ابتُليتَ فلا تَدُلَّ عليَّ. وكان الغُلامُ يُبرِئُ الأكمَهَ والأبرَصَ، ويُداوي النَّاسَ مِن سائِرِ الأدواءِ، فسَمِعَ جَليسٌ للمَلِكِ كان قد عَميَ، فأتاه بهَدايا كَثيرةٍ، فقال: ما هاهنا لكَ أجمَعُ إن أنتَ شَفَيتَني، فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فإن أنتَ آمَنتَ باللَّهِ دَعَوتُ اللَّهَ فشَفاكَ، فآمَنَ باللَّهِ فشَفاه اللهُ، فأتى المَلِكَ فجَلَسَ إليه كما كان يَجلِسُ، فقال له المَلِكُ: مَن رَدَّ عليكَ بَصَرَكَ؟ قال: رَبِّي، قال: ولَكَ رَبٌّ غيري؟ قال: رَبِّي ورَبُّكَ اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الغُلامِ، فجيءَ بالغُلامِ، فقال له المَلِكُ: أي بُنَيَّ، قد بَلَغَ مِن سِحرِكَ ما تُبرِئُ الأكمَهَ والأبرَصَ، وتَفعَلُ وتَفعَلُ! فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الرَّاهِبِ، فجيءَ بالرَّاهِبِ، فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَعا بالمِئشارِ، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه حتَّى وقَعَ شِقَّاه. ثُمَّ جيءَ بجَليسِ المَلِكِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه به حتَّى وقَعَ شِقَّاه، ثُمَّ جيءَ بالغُلامِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به إلى جَبَلِ كَذا وكَذا، فاصعَدوا به الجَبَلَ، فإذا بَلَغتُم ذِرْوَتَه، فإن رَجَعَ عن دينِه، وإلَّا فاطرَحوه، فذَهَبوا به فصَعِدوا به الجَبَلَ، فقال: ",["اللَّهُمَّ اكفِنيهم بما شِئتَ",1],"، ",["فرَجَفَ بهِمِ الجَبَلُ فسَقَطوا",2],"، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به فاحمِلوه في قُرقورٍ، فتَوسَّطوا به البَحرَ، فإن رَجَعَ عن دينِه، وإلَّا فاقذِفوه، فذَهَبوا به، فقال: اللَّهُمَّ اكفِنيهم بما شِئتَ، فانكَفَأت بهِمُ السَّفينةُ فغَرِقوا، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ. فقال للمَلِكِ: إنَّكَ لَستَ بقاتِلي حتَّى تَفعَلَ ما آمُرُكَ به، قال: وما هو؟ قال: تَجمَعُ النَّاسَ في صَعيدٍ واحِدٍ، وتَصلُبُني على جِذعٍ، ثُمَّ خُذْ سَهمًا مِن كِنانَتي، ثُمَّ ضَعِ السَّهمَ في كَبِدِ القَوسِ، ثُمَّ قُلْ: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ ارمِني؛ فإنَّكَ إذا فعَلتَ ذلك قَتَلتَني، فجَمَع النَّاسَ في صَعيدٍ واحِدٍ، وصَلَبَه على جِذعٍ، ثُمَّ أخَذَ سَهمًا مِن كِنانَتِه، ثُمَّ وضَعَ السَّهمَ في كَبدِ القَوسِ، ثُمَّ قال: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ رَماه فوقَعَ السَّهمُ في صُدغِه، فوضَعَ يَدَه في صُدغِه في مَوضِعِ السَّهمِ فماتَ، فقال النَّاسُ: آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ. فأُتيَ المَلِكُ فقيلَ له: أرَأيتَ ما كُنتَ تَحذَرُ؟ قد واللَّهِ نَزَلَ بكَ حَذَرُكَ، قد آمَنَ النَّاسُ، فأمَرَ بالأُخدودِ في أفواهِ السِّكَكِ فخُدَّت، وأضرَمَ النِّيرانَ، وقال: مَن لَم يَرجِعْ عن دينِه فأحموه فيها، أو قيلَ له: اقتَحِمْ، ففَعَلوا حتَّى جاءَتِ امرَأةٌ ومعها صَبيٌّ لَها، فتَقاعَسَت أن تَقَعَ فيها، فقال لَها الغُلامُ: يا أُمَّه، اصبِري؛ فإنَّكِ على الحَقِّ."],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (23931)، والنسائي في ((الكبرى)) (11597)، وابن حبان (873) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"2N3Sld4u"},{"id":"س-05363","fp":"690d22e5a6c6","stateId":348,"easy":"إذا دعوت «اللهم اكفنيهم بما شئت» ← يكفيك الله (من قصة الغلام)","cause":"اللَّهُمَّ اكفِنيهم بما شِئتَ","result":"فانكَفَأت بهِمُ السَّفينةُ فغَرِقوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم اكفنيهم بما شئت»"},"repOf":"س-05362","otherNeedIds":[25],"ref":"صحيح مسلم 3005","text":["كان مَلِكٌ فيمَن كان قَبلَكُم، وكان له ساحِرٌ، فلَمَّا كَبِرَ قال للمَلِكِ: إنِّي قد كَبِرتُ، فابعَث إليَّ غُلامًا أُعَلِّمْه السِّحرَ، فبَعَثَ إليه غُلامًا يُعَلِّمُه، فكان في طَريقِه إذا سَلَكَ راهِبٌ، فقَعَدَ إليه وسَمِعَ كَلامَه، فأعجَبَه، فكان إذا أتى السَّاحِرَ مَرَّ بالرَّاهِبِ وقَعَدَ إليه، فإذا أتى السَّاحِرَ ضَرَبَه، فشَكا ذلك إلى الرَّاهِبِ، فقال: إذا خَشيتَ السَّاحِرَ، فقُل: حَبَسَني أهلي، وإذا خَشيتَ أهلَكَ فقُل: حَبَسَني السَّاحِرُ، فبينَما هو كَذلك إذ أتى على دابَّةٍ عَظيمةٍ قد حَبَسَتِ النَّاسَ، فقال: اليومَ أعلَمُ آلسَّاحِرُ أفضَلُ أمِ الرَّاهِبُ أفضَلُ؟ فأخَذَ حَجَرًا، فقال: اللَّهُمَّ إن كان أمرُ الرَّاهِبِ أحَبَّ إليكَ مِن أمرِ السَّاحِرِ فاقتُلْ هذه الدَّابَّةَ حتَّى يَمضيَ النَّاسُ، فرَماها فقَتَلَها، ومَضى النَّاسُ، فأتى الرَّاهِبَ فأخبَرَه، فقال له الرَّاهِبُ: أي بُنَيَّ، أنتَ اليومَ أفضَلُ مِنِّي؛ قد بَلَغَ مِن أمرِكَ ما أرى، وإنَّكَ سَتُبتَلى، فإنِ ابتُليتَ فلا تَدُلَّ عليَّ. وكان الغُلامُ يُبرِئُ الأكمَهَ والأبرَصَ، ويُداوي النَّاسَ مِن سائِرِ الأدواءِ، فسَمِعَ جَليسٌ للمَلِكِ كان قد عَميَ، فأتاه بهَدايا كَثيرةٍ، فقال: ما هاهنا لكَ أجمَعُ إن أنتَ شَفَيتَني، فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فإن أنتَ آمَنتَ باللَّهِ دَعَوتُ اللَّهَ فشَفاكَ، فآمَنَ باللَّهِ فشَفاه اللهُ، فأتى المَلِكَ فجَلَسَ إليه كما كان يَجلِسُ، فقال له المَلِكُ: مَن رَدَّ عليكَ بَصَرَكَ؟ قال: رَبِّي، قال: ولَكَ رَبٌّ غيري؟ قال: رَبِّي ورَبُّكَ اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الغُلامِ، فجيءَ بالغُلامِ، فقال له المَلِكُ: أي بُنَيَّ، قد بَلَغَ مِن سِحرِكَ ما تُبرِئُ الأكمَهَ والأبرَصَ، وتَفعَلُ وتَفعَلُ! فقال: إنِّي لا أشفي أحَدًا، إنَّما يَشفي اللهُ، فأخَذَه، فلَم يَزَلْ يُعَذِّبُه حتَّى دَلَّ على الرَّاهِبِ، فجيءَ بالرَّاهِبِ، فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَعا بالمِئشارِ، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه حتَّى وقَعَ شِقَّاه. ثُمَّ جيءَ بجَليسِ المَلِكِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فوضَعَ المِئشارَ في مَفرِقِ رَأسِه، فشَقَّه به حتَّى وقَعَ شِقَّاه، ثُمَّ جيءَ بالغُلامِ فقيلَ له: ارجِعْ عن دينِكَ، فأبى، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به إلى جَبَلِ كَذا وكَذا، فاصعَدوا به الجَبَلَ، فإذا بَلَغتُم ذِرْوَتَه، فإن رَجَعَ عن دينِه، وإلَّا فاطرَحوه، فذَهَبوا به فصَعِدوا به الجَبَلَ، فقال: ",["اللَّهُمَّ اكفِنيهم بما شِئتَ",1],"، فرَجَفَ بهِمِ الجَبَلُ فسَقَطوا، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ، فدَفَعَه إلى نَفَرٍ مِن أصحابِه، فقال: اذهَبوا به فاحمِلوه في قُرقورٍ، فتَوسَّطوا به البَحرَ، فإن رَجَعَ عن دينِه، وإلَّا فاقذِفوه، فذَهَبوا به، فقال: اللَّهُمَّ اكفِنيهم بما شِئتَ، ",["فانكَفَأت بهِمُ السَّفينةُ فغَرِقوا",2],"، وجاءَ يَمشي إلى المَلِكِ، فقال له المَلِكُ: ما فعَلَ أصحابُكَ؟ قال: كَفانيهمُ اللهُ. فقال للمَلِكِ: إنَّكَ لَستَ بقاتِلي حتَّى تَفعَلَ ما آمُرُكَ به، قال: وما هو؟ قال: تَجمَعُ النَّاسَ في صَعيدٍ واحِدٍ، وتَصلُبُني على جِذعٍ، ثُمَّ خُذْ سَهمًا مِن كِنانَتي، ثُمَّ ضَعِ السَّهمَ في كَبِدِ القَوسِ، ثُمَّ قُلْ: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ ارمِني؛ فإنَّكَ إذا فعَلتَ ذلك قَتَلتَني، فجَمَع النَّاسَ في صَعيدٍ واحِدٍ، وصَلَبَه على جِذعٍ، ثُمَّ أخَذَ سَهمًا مِن كِنانَتِه، ثُمَّ وضَعَ السَّهمَ في كَبدِ القَوسِ، ثُمَّ قال: باسمِ اللهِ رَبِّ الغُلامِ، ثُمَّ رَماه فوقَعَ السَّهمُ في صُدغِه، فوضَعَ يَدَه في صُدغِه في مَوضِعِ السَّهمِ فماتَ، فقال النَّاسُ: آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ، آمَنَّا برَبِّ الغُلامِ. فأُتيَ المَلِكُ فقيلَ له: أرَأيتَ ما كُنتَ تَحذَرُ؟ قد واللَّهِ نَزَلَ بكَ حَذَرُكَ، قد آمَنَ النَّاسُ، فأمَرَ بالأُخدودِ في أفواهِ السِّكَكِ فخُدَّت، وأضرَمَ النِّيرانَ، وقال: مَن لَم يَرجِعْ عن دينِه فأحموه فيها، أو قيلَ له: اقتَحِمْ، ففَعَلوا حتَّى جاءَتِ امرَأةٌ ومعها صَبيٌّ لَها، فتَقاعَسَت أن تَقَعَ فيها، فقال لَها الغُلامُ: يا أُمَّه، اصبِري؛ فإنَّكِ على الحَقِّ."],"grade":"صحيح","narrator":"صهيب بن سنان الرومي","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (23931)، والنسائي في ((الكبرى)) (11597)، وابن حبان (873) باختلاف يسير.","bab":"رقائق وزهد › التوكل واليقين","dorar":"2N3Sld4u"},{"id":"س-05945","fp":"9d101482f802","stateId":348,"easy":"إذا احترست من الناس (بالحذر) ← تسلم","cause":"بسوءِ الظَّنِّ","result":"احتَرسوا من النَّاسِ","explicit":true,"ref":"مختصر المقاصد 30","srcLabel":"الطبراني","text":[["احتَرسوا من النَّاسِ",2]," ",["بسوءِ الظَّنِّ",1]],"grade":"حسن","narrator":"[أنس بن مالك]","muhaddith":"حسن لغيره","takhrij":"أخرجه ابن أبي الدنيا في ((مداراة الناس)) (113)، والطبراني في ((المعجم الأوسط)) (598)، وابن عدي في ((الكامل في الضعفاء)) (6/401)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"3uOwKtXG"},{"id":"س-05808","fp":"a32d8a272d61","stateId":348,"easy":"إذا وُقيت شر بطانة السوء ← فقد وُقيت","cause":"وُقِيَ شَرَّ بِطانَةِ السُّوءِ","result":"فقد وُقِيَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج المسند لشعيب 7887","srcLabel":"البخاري","text":["ما مِن نَبيٍّ ولا خَليفَةٍ -أو قال:- ما مِن نَبيٍّ إلَّا وله بِطانَتانِ، بِطانَةٌ تَأمُرُه بالمَعروفِ وتَنهاه عن المُنكَرِ، وبِطانَةٌ لا تَألوه خَبالًا، ومَن ",["وُقِيَ شَرَّ بِطانَةِ السُّوءِ",1]," ",["فقد وُقِيَ",2]," -يَقولُها ثَلاثًا- وهو مع الغالِبَةِ عليه منهما."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2369) مطولاً باختلاف يسير، والنسائي (4201) باختلاف يسير، وأخرجه البخاري معلقاً بعد حديث (7198) بنحوه","bab":"رقائق وزهد › الوصايا النافعة","dorar":"uc3yK0Hl"},{"id":"س-03135","fp":"330200db9000","stateId":348,"easy":"إذا خفت الله ← يُخيف الله منك كل شيء","cause":"مَن خافَ اللَّهَ","result":"خوَّفَ منهُ كلَّ شيءٍ","explicit":true,"ref":"مختصر المقاصد 1024","srcLabel":"العسكري","text":[["مَن خافَ اللَّهَ ",1],["خوَّفَ منهُ كلَّ شيءٍ",2]],"grade":"حسن","narrator":"[الحسين بن علي بن أبي طالب]","muhaddith":"حسن لغيره","takhrij":"أخرجه العسكري كما في ((المقاصد الحسنة)) للسخاوي (1119) باختلاف يسير","bab":"إيمان › توحيد الأسماء والصفات","dorar":"kHpi28Xz"},{"id":"س-00774","fp":"db4ed83f54eb","stateId":349,"easy":"إذا لم تعجز عن الدعاء ← لن تهلك","cause":"لا تَعْجِزوا في الدُّعاءِ","result":"فإنَّه لن يَهلِكَ مع الدُّعاءِ أحَدٌ","explicit":true,"star":true,"ref":"الأحاديث المختارة 1760","srcLabel":"البخاري","text":["«",["لا تَعْجِزوا في الدُّعاءِ؛ ",1],["فإنَّه لن يَهلِكَ مع الدُّعاءِ أحَدٌ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"htbPNdTe"},{"id":"س-00079","fp":"f147b3a96c94","stateId":349,"easy":"إذا دعوت ← يرد الدعاء البلاء","cause":"الدعاءُ","result":"يَرُدُّ البلاءَ","explicit":true,"similar":["س-08061","س-00081","س-00082"],"otherNeedIds":[29,4],"ref":"مختصر المقاصد 456","srcLabel":"أبو الشيخ","text":[["الدعاءُ",1]," ",["يَرُدُّ البلاءَ",2]," [يعني حديث: بِرُّ الوالدينِ يَزيدُ في العُمُرِ، والكَذِبُ يُنقِصُ مِنَ الرِّزقِ، والدعاءُ يَرُدُّ البلاءَ، ولِلَّهِ في خَلقِه قضاءان، فقضاءٌ نافِذٌ، وقضاءٌ يُنْتَظَرُ، ولِلْأنبياءِ على العلماءِ فضلُ دَرَجَتينِ، وللعلماءِ على الشهداءِ فضلُ دَرَجَةٍ]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه أبو الشيخ الأصبهاني في ((الفوائد)) (27 )، والشجري كما في ((ترتيب الأمالي)) (1981 )","bab":"آداب الدعاء › استجابة الدعاء","dorar":"4P94Rq6J","merged":5,"otherRefs":["النوافح العطرة 143 (صحيح)","الجامع الصغير 9950 (صحيح)","الفتح الرباني 11/5326 (صحيح)","تخريج العواصم والقواصم 6/ 136 (حسن)"]},{"id":"س-05961","fp":"f64ee0e37f6c","stateId":349,"easy":"إذا دعوت بـ«لا إله إلا الله الحليم الكريم...» ← يحفظك الله من الشر (من واقعة)","cause":"لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ","result":"فلم يَصِلْ إليها","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ، وزَعَمَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كانَ إذا حَزَبَه أمْر»"},"otherNeedIds":[4],"ref":"الأحاديث المختارة 9 / 174","srcLabel":"متفق عليه","text":["«أنَّه زَوَّجَ ابْنَتَه مِن الحَجَّاجِ بنِ يوسُفَ، فقالَ لها: إذا دَخَلَ بك فقولي: ",["لا إلهَ إلَّا اللهُ الحَليمُ الكَريمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ العَظيمِ، الحَمْدُ للهِ رَبِّ العالَمينَ",1],"، وزَعَمَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ كانَ إذا حَزَبَه أمْرٌ قالَ هذا.\nقالَ حَمَّادٌ: فظَنَنْتُ أنَّه قالَ: ",["فلم يَصِلْ إليها",2],"»."],"grade":"صحيح","narrator":"عبدالله بن جعفر بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"qQcgRWlZ","merged":2,"otherRefs":["الأحاديث المختارة 9 / 175 (صحيح)"]},{"id":"س-08061","fp":"0fb07126c139","stateId":349,"easy":"إذا دعوت ← فلا يرد القدر إلا الدعاء","cause":"إلَّا بالدُّعاءِ","result":"ولا يُرَدُّ القدَرُ","explicit":true,"repOf":"س-00079","otherNeedIds":[29],"ref":"صحيح ابن حبان 872","text":["إنَّ الرَّجُلَ لَيُحرَمُ الرِّزقَ بالذَّنبِ الَّذي يُصيبُه ",["ولا يُرَدُّ القدَرُ",2]," ",["إلَّا بالدُّعاءِ",1]," ولا يَزيدُ في العُمُرِ إلَّا البِرُّ"],"grade":"صحيح","narrator":"ثوبان","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (22386)، والحاكم (1814) واللفظ لهما.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"eGOPpwB5","merged":2,"otherRefs":["المستدرك على الصحيحين 1838 (صحيح)"]},{"id":"س-00081","fp":"9bad02fd20e1","stateId":349,"easy":"إذا دعوت ← يرد الدعاء البلاء","cause":"والدعاءُ","result":"يَرُدُّ البلاءَ","explicit":true,"repOf":"س-00079","otherNeedIds":[29],"ref":"مختصر المقاصد 456","text":["الدعاءُ يَرُدُّ البلاءَ [يعني حديث: بِرُّ الوالدينِ يَزيدُ في العُمُرِ، والكَذِبُ يُنقِصُ مِنَ الرِّزقِ، ",["والدعاءُ",1]," ",["يَرُدُّ البلاءَ",2],"، ولِلَّهِ في خَلقِه قضاءان، فقضاءٌ نافِذٌ، وقضاءٌ يُنْتَظَرُ، ولِلْأنبياءِ على العلماءِ فضلُ دَرَجَتينِ، وللعلماءِ على الشهداءِ فضلُ دَرَجَةٍ]"],"grade":"صحيح","narrator":"[أبو هريرة]","muhaddith":"صحيح","takhrij":"أخرجه أبو الشيخ الأصبهاني في ((الفوائد)) (27 )، والشجري كما في ((ترتيب الأمالي)) (1981 )","bab":"آداب الدعاء › استجابة الدعاء","dorar":"4P94Rq6J"},{"id":"س-00082","fp":"d8ed76dfa53b","stateId":349,"easy":"إذا دعوت ← يرد الدعاء القضاء","cause":"إنَّ الدُّعاءَ","result":"يرُدُّ القَضاءَ","explicit":true,"repOf":"س-00079","otherNeedIds":[29],"ref":"النوافح العطرة 143","text":["الدعاءُ يردُّ القضاءَ [يعني حديث: ",["إنَّ الدُّعاءَ",1]," ",["يرُدُّ القَضاءَ",2],"، وإنَّ البِرَّ يَزيدُ في الرِّزقِ، وإنَّ العَبدَ لَيُحرَمُ الرِّزقَ بالذَّنبِ يُصيبُه.]"],"grade":"صحيح","narrator":"ثوبان مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (6038)، والطحاوي في ((مشكل الآثار)) (3069)، وقوام السنة في ((الترغيب والترهيب)) (1262) بلفظه تامًا.","bab":"آداب الدعاء › استجابة الدعاء","dorar":"uDGZZtLv"},{"id":"س-00989","fp":"bbac899168c8","stateId":349,"easy":"إذا دعوت ← فالدعاء سلاح المؤمن","cause":"الدُّعاءُ","result":"سِلاحُ المؤمنِ، وعِمادُ الدِّينِ، ونُورُ السَّمواتِ والأرضِ","explicit":true,"otherNeedIds":[25],"ref":"المستدرك على الصحيحين 1836","srcLabel":"أبو يعلى","text":[["الدُّعاءُ",1]," ",["سِلاحُ المؤمنِ، وعِمادُ الدِّينِ، ونُورُ السَّمواتِ والأرضِ",2],"."],"grade":"صحيح","narrator":"علي","muhaddith":"صحيح","takhrij":"أخرجه أبو يعلى الموصلي (439)، والقضاعي في ((مسند الشهاب)) (143) كلاهما بلفظه، وابن عدي في ((الكامل)) (14988) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"4b7ZcrpN"},{"id":"س-06399","fp":"a1227b4f2149","stateId":349,"easy":"إذا أعددت الدعاء ← تتقي به البلاء","cause":"الدُّعاءَ","result":"وأعِدُّوا للبَلاءِ","explicit":true,"otherNeedIds":[4],"ref":"الفروع لابن مفلح 3/ 261","srcLabel":"الطبراني","text":["\"داووا مَرضاكُم بالصَّدَقةِ، وحَصِّنوا أموالَكُم بالزَّكاةِ، ",["وأعِدُّوا للبَلاءِ",2]," ",["الدُّعاءَ",1],"\""],"grade":"صحيح","narrator":"عبد الله","muhaddith":"حسن، ومعناه صحيح","takhrij":"أخرجه البيهقي (6667) بلفظه، والطبراني في ((الأوسط)) (1963)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/ 237) كلاهما بتقديم وتأخير في لفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hcesJBVx"},{"id":"س-08236","fp":"d5074bc82467","stateId":349,"easy":"إذا شربت ماء زمزم مستعيذاً ← يعيذك الله","cause":"وإن شَرِبتَه مُستَعيذًا","result":"أعاذَكَ اللهُ","explicit":true,"ref":"فيض القدير 5/ 404","srcLabel":"الحاكم","text":["ماءُ زَمزَمَ لِما شُرِبَ له، فإن شَرِبتَه تَستَشفي به شَفاكَ اللهُ، ",["وإن شَرِبتَه مُستَعيذًا",1]," ",["أعاذَكَ اللهُ",2],"، وإن شَرِبتَه لتَقطَعَ ظَمَأكَ قَطَعَه اللهُ، وإن شَرِبتَه لشِبَعِكَ أشبَعَكَ اللهُ، وهيَ هَزمةُ جِبريلَ وسُقيا إسماعيلَ"],"grade":"صحيح","narrator":"عبدالله  بن عباس","muhaddith":"قال الحاكم: صحيح إن سلم من الجارودي [قلت] سلم منه","bab":"ملائكة › أعمال الملائكة","dorar":"Wr5oIrxd"},{"id":"س-01065","fp":"31f0823c8bb5","stateId":349,"easy":"إذا قلت «أعوذ بكلمات الله التامات من شر ما خلق...» ← يكفيك الله شر الشياطين","cause":"قُلْ: أعوذُ بكَلِماتِ اللهِ التَّامَّةِ مِن شَرِّ ما خلَقَ، وذرَأَ وبرَأَ، ومِن شَرِّ ما يَنزِلُ مِن السَّماءِ، ومِن شَرِّ ما يَعرُجُ فيها، ومِن شَرِّ فِتنِ اللَّيلِ والنَّهارِ، ومِن شَرِّ كلِّ طارقٍ، إلَّا طارقًا يَطرُقُ بخيرٍ يا رَحمنُ","result":"فطُفِئَتْ نارُهم، وهزَمَهم اللهُ تَبارَكَ وتَعالى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«أعوذ بكلمات الله التامات من شر ما خلق...»"},"ref":"تخريج سير أعلام النبلاء 1/ 369","srcLabel":"أحمد","text":["عن أبي التَّيَّاحِ قال: قُلتُ لعبدِ الرَّحمنِ بنِ خَنْبَشٍ التَّميميِّ -وكان كَبيرًا-: أدرَكتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: نعمْ. قال: قُلتُ: كيف صنَعَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ لَيلةَ كادتْه الشَّياطينُ؟ فقال: إنَّ الشَّياطينَ تَحدَّرَتْ تلك اللَّيلةَ على رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ مِن الأَوديةِ والشِّعابِ، وفيهم شَيطانٌ بيَدِه شُعلةُ نارٍ يُريدُ أنْ يَحرِقَ بها وَجهَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فهبَطَ إليه جِبريلُ عليه السَّلامُ، فقال: يا محمَّدُ، قُلْ. قال: ما أقولُ؟ قال: ",["قُلْ: أعوذُ بكَلِماتِ اللهِ التَّامَّةِ مِن شَرِّ ما خلَقَ، وذرَأَ وبرَأَ، ومِن شَرِّ ما يَنزِلُ مِن السَّماءِ، ومِن شَرِّ ما يَعرُجُ فيها، ومِن شَرِّ فِتنِ اللَّيلِ والنَّهارِ، ومِن شَرِّ كلِّ طارقٍ، إلَّا طارقًا يَطرُقُ بخيرٍ يا رَحمنُ",1],". قال: ",["فطُفِئَتْ نارُهم، وهزَمَهم اللهُ تَبارَكَ وتَعالى",2],"."],"grade":"صحيح","narrator":"عبدالرحمن بن خنبش","muhaddith":"إسناده صحيح.","takhrij":"أخرجه أحمد (15460) باختلاف يسير، وأبو يعلى (6844)، وأبو نعيم في ((دلائل النبوة)) (137) بنحوه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"8wsezC0t"},{"id":"س-02173","fp":"9c02430a5752","stateId":349,"easy":"إذا استقبلت البلاء بالدعاء والتضرع ← يُدفع عنك","cause":"بالدُّعاءِ والتَّضرُّعِ","result":"واستقبلوا أمواجَ البلاءِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"otherNeedIds":[4],"ref":"صحيح الترغيب 744","srcLabel":"أبو داود","text":["داوُوا مرضاكم بالصَّدَقةِ [يعني حديث: حصِّنوا أموالَكم بالزَّكاةِ وداووا مرضاكم بالصَّدقةِ ",["واستقبلوا أمواجَ البلاءِ",2]," ",["بالدُّعاءِ والتَّضرُّعِ",1],"]"],"grade":"حسن","narrator":"الحسن البصري","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو داود في ((مراسيله)) (105)، وابن الجوزي في ((العلل المتناهية)) (816) مطولاً.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"LVSlwhvM"},{"id":"س-05377","fp":"3071e42d9e55","stateId":349,"easy":"إذا وجدت داراً ذميمة (تكثر فيها المصائب) ← فاتركها","cause":"فهَلَّا تَرَكتُموها وهيَ ذَميمةٌ","result":"سَكَنوا دارًا وهم ذوو عَدَدٍ فقَلُّوا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سبل الهدى والرشاد 12/136","srcLabel":"الطبراني","text":["اشتَكى قَومٌ إلى رَسولِ اللهِ صلَّى الله عليه وسلَّم أنَّهم ",["سَكَنوا دارًا وهم ذوو عَدَدٍ فقَلُّوا",2],"، فقال: «",["فهَلَّا تَرَكتُموها وهيَ ذَميمةٌ",1],"»"],"grade":"حسن","narrator":"سهل بن حارثة الأنصاري","muhaddith":"إسناده لا بأس به.","takhrij":"أخرجه أبو نعيم في ((معرفة الصحابة)) (3316) بلفظه، وابن أبي عاصم في ((الآحاد والمثاني)) (2160)، والطبراني (6/ 104) (5639) كلاهما بلفظ مقارب .","bab":"رقائق وزهد › التوكل واليقين","dorar":"mZpoYwF1"},{"id":"س-05782","fp":"837355cdc8cd","stateId":350,"easy":"إذا صنعت المعروف ← يقيك مصارع السوء","cause":"صنائعُ المعروفِ","result":"تَقي مصارعَ السوءِ","explicit":true,"similar":["س-01999","س-06865"],"otherNeedIds":[62],"ref":"الجامع الصغير 5024","srcLabel":"الطبراني","text":[["صنائعُ المعروفِ ",1],["تَقي مصارعَ السوءِ",2]," والصدقةُ خُفيا تُطفِئُ غضبَ الربِّ، وصلةُ الرحِمِ زيادةٌ في العمُرِ، وكلُّ معروفٍ صدَقَةٌ، وأهلُ المعروفِ في الدنيا هم أهلُ المعروفِ في الآخرةِ، وأهلُ المُنكَرِ في الدنيا هم أهلُ المُنكَرِ في الآخِرَةِ، وأولُ مَن يدخُلُ الجنةَ أهلُ المعروفِ"],"grade":"صحيح","narrator":"أم سلمة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (6086)","bab":"رقائق وزهد › الوصايا النافعة","dorar":"FXfMwMQ4","merged":2,"otherRefs":["المصابيح في الأحاديث المتواترة 610 (صحيح)"]},{"id":"س-06398","fp":"3b174097d5aa","stateId":350,"easy":"إذا زكّيت ← تحصّن أموالك","cause":"بالزَّكاةِ","result":"وحَصِّنوا أموالَكُم","explicit":true,"otherNeedIds":[1],"ref":"الفروع لابن مفلح 3/ 261","srcLabel":"الطبراني","text":["\"داووا مَرضاكُم بالصَّدَقةِ، ",["وحَصِّنوا أموالَكُم",2]," ",["بالزَّكاةِ",1],"، وأعِدُّوا للبَلاءِ الدُّعاءَ\""],"grade":"صحيح","narrator":"عبد الله","muhaddith":"حسن، ومعناه صحيح","takhrij":"أخرجه البيهقي (6667) بلفظه، والطبراني في ((الأوسط)) (1963)، وأبو نعيم الأصبهاني في ((حلية الأولياء)) (4/ 237) كلاهما بتقديم وتأخير في لفظه.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"hcesJBVx","merged":2,"otherRefs":["صحيح الترغيب 744 (حسن)"]},{"id":"س-01999","fp":"62cadb55c6f5","stateId":350,"easy":"إذا اصطنعت المعروف ← يقيك مصارع السوء","cause":"عليكم باصطناعِ المعروفِ","result":"فإنَّه يَمنَعُ مَصارِعَ السُّوءِ","explicit":true,"repOf":"س-05782","otherNeedIds":[62],"ref":"التنوير شرح الجامع الصغير 7/309","text":[["عليكم باصطناعِ المعروفِ؛ ",1],["فإنَّه يَمنَعُ مَصارِعَ السُّوءِ",2],"، وعليكم بصدَقةِ السِّرِّ؛ فإنَّها تُطفِئُ غضَبَ اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"متنه صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((اصطناع المعروف)) (6)، وابن الخطاب في ((مشيخته)) (105)، وإسماعيل الأصبهاني في ((الترغيب والترهيب)) (315) بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"8QIIya4I"},{"id":"س-02022","fp":"50f969327c2a","stateId":350,"easy":"إذا كسوت مسلماً ثوباً ← تكون في حفظ الله ما دامت عليه منه رقعة","cause":"مَن كَسا مُسلِمًا ثَوْبًا","result":"كانَ في حِفْظٍ مِن اللهِ ما واراه مِنه رُقْعةٌ","explicit":true,"similar":["س-06279"],"ref":"علل ابن أبي حاتم 1995","srcLabel":"علل ابن أبي حاتم","text":["حَديثٌ رَواه خالِدُ بنُ طَهْمانَ أبو العَلاءِ الخَفَّافُ، عن حُصَيْنٍ -وليس بابنِ عَبْدِ الرَّحْمنِ- عن ابنِ عبَّاسٍ، قالَ: ",["مَن كَسا مُسلِمًا ثَوْبًا ",1],["كانَ في حِفْظٍ مِن اللهِ ما واراه مِنه رُقْعةٌ",2],"؟\nقالَ أبي: حَدَّثَنا أَحمَدُ بنُ يونُسَ، عن أبي العَلاءِ الخَفَّافِ، عن حُصَيْنٍ، عن ابنِ عبَّاسٍ، عن النَّبيِّ صلَّى اللهُ عليه وسلَّم."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"النَّاسُ يَرْفَعونَه. مَرْفوع عِنْدي صَحيحٌ.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"Nptb76l1"},{"id":"س-06168","fp":"098bfe07863e","stateId":350,"easy":"إذا أديت زكاة مالك ← يذهب عنك شره","cause":"من أدَّى زكاةَ مالِه","result":"فقد ذهب عنه شرُّه","explicit":true,"otherNeedIds":[1],"ref":"الترغيب والترهيب 2/5","srcLabel":"الحاكم","text":["قال رجلٌ يا رسولَ اللهِ أرأيتَ إن أدَّى الرَّجلُ زكاةَ مالِه فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ",["من أدَّى زكاةَ مالِه ",1],["فقد ذهب عنه شرُّه",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه ابن خزيمة (2258)، والحاكم (1439) مختصرا باختلاف يسير، والطبراني في ((المعجم الأوسط)) (1579) باختلاف يسير","bab":"زكاة › فرض الزكاة","dorar":"g0dsdcMH"},{"id":"س-06284","fp":"535957716024","stateId":350,"easy":"إذا ناولت المسكين بيدك ← تقيك ميتة السوء","cause":"مناولةُ المسكينِ","result":"تَقِي ميتةَ السوءِ","explicit":true,"otherNeedIds":[62],"ref":"الجامع الصغير 9094","srcLabel":"الطبراني","text":[["مناولةُ المسكينِ ",1],["تَقِي ميتةَ السوءِ",2]],"grade":"صحيح","narrator":"حارثة بن النعمان","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في الكبير (3 / 230) (3233 )، وأبو نعيم في الحليه (1 / 356)، والبيهقي في ((الشعب)) (3188) واللفظ لهم جميعا","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"NuUvieQN"},{"id":"س-06865","fp":"d2804521567a","stateId":350,"easy":"إذا فعلت المعروف ← يقيك مصارع السوء","cause":"و فِعلُ المَعروفِ","result":"يَقِي مَصارِعَ السُّوءِ","explicit":true,"repOf":"س-05782","otherNeedIds":[62],"ref":"صحيح الجامع 3760","text":["صدَقةُ السِّرِّ تُطفِئُ غَضبَ الرَّبِ ، و صِلَةُ الرَّحِمِ تَزِيدُ في العُمرِ ، ",["و فِعلُ المَعروفِ",1]," ",["يَقِي مَصارِعَ السُّوءِ",2]],"grade":"صحيح","narrator":"أبو سعيد الخدري وعبدالله بن عباس وأم سلمة وأبو أمامة ومعاوية بن حيدة","muhaddith":"صحيح","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"BkWIc29A"},{"id":"س-04712","fp":"128b16b62553","stateId":350,"easy":"إذا لبست ثوباً جديداً فحمدت الله وتصدقت بالقديم ← تبقى في حرز الله وضمانه وجواره","cause":"ما من عبدٍ مسلمٍ يلبَسُ ثوبًا جديدًا ، ثم يقولُ مثلَ ما قلتُ ، ثم يعمِدُ إلى سملٍ من أخلاقِه الذي خلع فيكسوه إنسانًا مسلمًا لا يكسوه إلا للهِ تعالى","result":"لم يزلْ في حِرزِ اللهِ ، وفي ضمانِ اللهِ ، وفي جَوارِ اللهِ ما دامَ عليه منه سلكٌ واحدٌ حيًّا وميِّتًا","explicit":true,"otherNeedIds":[25],"ref":"نتائج الأفكار 1/127","srcLabel":"الترمذي","text":["كان عمرُ بنُ الخطابِ رضي الله عنه جالسًا يومًا في جمْعٍ من أصحابِ رسولِ اللهِ صلَّى اللهُ عليهِ وسلَّمَ إذ دعا بقميصٍ جديدٍ فلبِسَه ، فما أحسبُه بلغ تراقِيَهُ حتى قال : الحمدُ للهِ الذي كساني ما أُواري به عورَتي ، وأتجمَّلُ به في حياتي ثم قال : رأيتُ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ لبِسَ ثوبًا جديدًا ، فقال ما قلتُ ، ثم قال : والذي نفسي بيدِه ! ",["ما من عبدٍ مسلمٍ يلبَسُ ثوبًا جديدًا ، ثم يقولُ مثلَ ما قلتُ ، ثم يعمِدُ إلى سملٍ من أخلاقِه الذي خلع فيكسوه إنسانًا مسلمًا لا يكسوه إلا للهِ تعالى",1]," ",["لم يزلْ في حِرزِ اللهِ ، وفي ضمانِ اللهِ ، وفي جَوارِ اللهِ ما دامَ عليه منه سلكٌ واحدٌ حيًّا وميِّتًا",2]],"grade":"حسن","narrator":"عمر بن الخطاب","muhaddith":"حسن","takhrij":"أخرجه الطبراني في ((الدعاء)) (393)، باختلاف يسير، والترمذي (3560)، بلفظ مقارب، وابن أبي الدنيا في ((الشكر)) (75)، بنحوه.","bab":"رقائق وزهد › الإخلاص","dorar":"vRWXwc6J"},{"id":"س-06279","fp":"bd87eb2d5ab5","stateId":350,"easy":"إذا كسوت مسلماً ثوباً ← تكون في حفظ الله ما بقيت عليه منه خرقة","cause":"ما من مسلمٍ كسا مسلمًا ثوبًا","result":"إلا كان في حِفظٍ من اللهِ ما دام منه عليه خِرْقَةٌ","explicit":true,"repOf":"س-02022","ref":"تهذيب التهذيب 2/389","text":["حديث  في أجرِ مَنْ كسا مسلمًا ثوبًا [يعني حديث: جاء سائلٌ فسأل ابنَ عباسٍ، فقال ابنُ عباسٍ للسائلِ : أتشهدُ أن لا إله إلا اللهُ ؟ قال : نعم، قال : أتشهد أنَّ محمدًا رسولُ اللهِ ؟ قال : نعم، قال : وتصومُ رمضانَ ؟ قال : نعم قال سألتَ وللسائلِ حقٌّ إنه لحقٌّ علينا أن نصِلَك فأعطاه ثوبًا ثم قال سمعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ ",["ما من مسلمٍ كسا مسلمًا ثوبًا",1]," ",["إلا كان في حِفظٍ من اللهِ ما دام منه عليه خِرْقَةٌ",2],"]"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن غريب","takhrij":"أخرجه الترمذي (2484) واللفظ له، والطبراني ((12/ 97)) (12591) والحاكم (7422) بنحوه","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"SGRRFjh9"},{"id":"س-06563","fp":"b5d7660681fd","stateId":351,"easy":"إذا صليت الصبح في جماعة ← تكون في ذمة الله","cause":"مَن صلَّى الصُّبحَ في جماعةٍ","result":"فَهوَ في ذمَّةِ اللَّهِ فانظرْ يا ابنَ آدمَ لا يطلبنَكَ اللَّهُ بشيءٍ مِن ذمَّتِهِ","explicit":true,"star":true,"similar":["س-06609","س-05036","س-06520","س-06565"],"otherNeedIds":[25],"ref":"مختصر المقاصد 1044","srcLabel":"مسلم","text":[["مَن صلَّى الصُّبحَ في جماعةٍ ",1],["فَهوَ في ذمَّةِ اللَّهِ فانظرْ يا ابنَ آدمَ لا يطلبنَكَ اللَّهُ بشيءٍ مِن ذمَّتِهِ",2]],"grade":"صحيح","narrator":"[جندب بن سفيان]","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18814) واللفظ له، ومسلم (657)، والترمذي (222) بنحوه.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"YvxiYpbX"},{"id":"س-06609","fp":"4ecc4fa4ab95","stateId":351,"easy":"إذا صليت الصبح ← تكون في ذمة الله فلا تخفر ذمته","cause":"من صلَّى الصبحَ","result":"فهو في ذِمَّةِ اللهِ تبارك و تعالى ، فلا تُخفِروا اللهَ تبارك و تعالى في ذِمَّتِه ، فإنه","explicit":true,"repOf":"س-06563","otherNeedIds":[25],"ref":"صحيح الترغيب 462","text":[["من صلَّى الصبحَ ",1],["فهو في ذِمَّةِ اللهِ تبارك و تعالى ، فلا تُخفِروا اللهَ تبارك و تعالى في ذِمَّتِه ، فإنه ",2],"من أخفَر ذِمَّتَه طلبه اللهُ تبارك و تعالى ، حتى يُكبَّه على وجهِه"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (5898)، والبزار (5988) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (8548) مختصراً","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"sECvm2kY","merged":6,"otherRefs":["تخريج صحيح ابن حبان 1743 (صحيح)","صحيح الترغيب 462 (صحيح)","صحيح الجامع 6343 (صحيح)","صحيح الجامع 6344 (صحيح)","الأحاديث المختارة 64 (صحيح)"]},{"id":"س-02456","fp":"6e3d68e99a91","stateId":351,"easy":"إذا أقمت الصلاة وأديت الزكاة ← تكون آمناً بأمان الله ورسوله","cause":"إنَّكم إنْ أقمتُمُ الصَّلاةَ، وأدَّيتُمُ الزَّكاةَ","result":"فأنتُمْ آمِنونَ بأمانِ اللهِ وأمانِ رسولِه","explicit":true,"otherNeedIds":[6],"ref":"تخريج المسند لشعيب 23077","srcLabel":"أحمد","text":["عن يَزيدَ بنِ عبدِ اللهِ بنِ الشِّخِّيرِ قال: كُنَّا بهذا المِربَدِ بالبَصْرةِ، قال: فجاء أعْرابيٌّ معه قِطْعةُ أديمٍ -أو قِطْعةُ جِرابٍ- فقال: هذا كِتابٌ كَتَبَه لي النَّبيُّ صلَّى اللهُ عليه وسلَّمَ، قال أبو العَلاءِ: فأخَذتُه فقَرَأتُه على القَومِ، فإذا فيه: بسمِ اللهِ الرَّحمنِ الرَّحيمِ، هذا كِتابٌ مِن مُحمَّدٍ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ لبَني زُهَيرِ بنِ أُقَيشٍ: ",["إنَّكم إنْ أقمتُمُ الصَّلاةَ، وأدَّيتُمُ الزَّكاةَ",1],"، وأعْطيتُمْ مِن المغانِمِ الخُمُسَ، وسَهمَ النَّبيِّ والصَّفيَّ؛ ",["فأنتُمْ آمِنونَ بأمانِ اللهِ وأمانِ رسولِه",2],". قال: قُلْنا: ما سَمِعتَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ فقال: سَمِعتُه يقولُ: صَومُ شَهرِ الصَّبرِ وثلاثةِ أيَّامٍ من كُلِّ شَهرٍ، يُذهِبْنَ وَحَرَ الصَّدرِ."],"grade":"صحيح","narrator":"رجال من الصحابة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (23077) واللفظ له، وابن أبي شيبة (37790)، وابن الجارود في ((المنتقى)) (1099)","bab":"إسلام › فضل الشهادتين","dorar":"T3x5ADR9","merged":3,"otherRefs":["السلسلة الصحيحة 2857 (صحيح)","السلسلة الصحيحة 6/847 (صحيح)"]},{"id":"س-02418","fp":"d5e4dd684d30","stateId":351,"easy":"إذا شهدت الشهادتين وأقمت الصلاة وآتيت الزكاة ← تكون آمناً بأمان الله ورسوله","cause":"إنَّكم إن شَهِدْتُم أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ، وأَقَمْتُم الصَّلاةَ، وآتَيْتُم الزَّكاةَ، وأدَّيْتُم الخُمُسَ مِن المَغنَمِ، وسَهْمَ النَّبيِّ [وسَهْمَ] الصَّفِيِّ","result":"أنتم آمِنونَ باللهِ بأمانِ اللهِ ورَسولِه","explicit":true,"otherNeedIds":[6],"ref":"الأحكام الوسطى 3/98","srcLabel":"الأحكام الوسطى","text":["عن عائِشةَ قالَتْ: كانَتْ صَفِيَّةُ مِن الصَّفِيِّ [عن يَزيدَ بنِ عَبْدِ اللهِ بنِ الشِّخِّيْرِ قالَ: كُنَّا بالمِربَدِ، فجاءَ رَجُلٌ أَشعَثُ الرَّأسِ، بيَدِه قِطْعةُ أَديمٍ حَمْراءُ، فقُلْنا: كأنَّك مِن أهْلِ البادِيةِ؟ فقالَ: أجَلْ، قُلْنا: ناوِلْنا هذه القِطْعةَ الأدَمَ الَّتي في يَدِك، فناوَلَناها فقَرَأَ ما فيها، فإذا فيها: \"بِسْمِ اللهِ الرَّحْمنِ الرَّحيمِ، مِن مُحمَّدٍ صلَّى اللهُ عليه وسلَّمَ إلى بَني زَهْرِ بنِ أُقَيْشٍ: ",["إنَّكم إن شَهِدْتُم أنْ لا إلهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ، وأَقَمْتُم الصَّلاةَ، وآتَيْتُم الزَّكاةَ، وأدَّيْتُم الخُمُسَ مِن المَغنَمِ، وسَهْمَ النَّبيِّ [وسَهْمَ] الصَّفِيِّ",1],"- ",["أنتم آمِنونَ باللهِ بأمانِ اللهِ ورَسولِه",2],"\"، فقُلْنا: مَن كَتَبَ لك هذا الكِتابَ؟ فقالَ: رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ]."],"grade":"صحيح","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","bab":"إسلام › فضل الشهادتين","dorar":"b3vnOz04"},{"id":"س-05036","fp":"af56fd20e5fe","stateId":351,"easy":"إذا صليت الصبح ← تكون في ذمة الله","cause":"مَن صَلَّى صَلاةَ الصُّبحِ","result":"فهو في ذِمَّةِ اللهِ، فلا يَطلُبَنَّكُمُ اللهُ مِن ذِمَّتِه بشيءٍ؛ فإنَّه","explicit":true,"repOf":"س-06563","otherNeedIds":[25],"ref":"صحيح مسلم 657","text":[["مَن صَلَّى صَلاةَ الصُّبحِ ",1],["فهو في ذِمَّةِ اللهِ، فلا يَطلُبَنَّكُمُ اللهُ مِن ذِمَّتِه بشيءٍ؛ فإنَّه ",2],"مَن يَطلُبْه مِن ذِمَّتِه بشيءٍ يُدرِكْه، ثُمَّ يَكُبَّه على وجهِه في نارِ جَهَنَّمَ."],"grade":"صحيح","narrator":"جندب بن عبدالله","muhaddith":"[صحيح]","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (1683) (2/ 166)، والروياني (955) باختلاف يسير، وأحمد (18814) مختصرًا.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"v64OngYp"},{"id":"س-06520","fp":"61fbb2fad3e8","stateId":351,"easy":"إذا صليت الصبح ← تكون في ذمة الله","cause":"مَن صلَّى صلاة الصُّبحَ","result":"فله ذمَّةِ اللَّهِ تعالى","explicit":true,"repOf":"س-06563","otherNeedIds":[25],"ref":"المصابيح في الأحاديث المتواترة 620","text":[["مَن صلَّى صلاة الصُّبحَ ",1],["فله ذمَّةِ اللَّهِ تعالى",2],"، فلا تُخفِروا اللَّهَ في ذمَّتِهِ، فإنَّهُ مَن خفرَ ذمَّتَهُ طلبَهُ اللَّهُ حتَّى يكُبَّهُ على وجهِهِ"],"grade":"صحيح","muhaddith":"متواتر معنى [كما قال في المقدمة]","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"CotFt1ZD"},{"id":"س-06565","fp":"2e17ae964a04","stateId":351,"easy":"إذا صليت الصبح في جماعة ← تكون في ذمة الله","cause":"من صلَّى الصُّبحَ في جماعةٍ","result":"فهوَ في ذمَّةِ اللَّهِ","explicit":true,"repOf":"س-06563","otherNeedIds":[25],"ref":"مجمع الزوائد 2/44","text":[["من صلَّى الصُّبحَ في جماعةٍ ",1],["فهوَ في ذمَّةِ اللَّهِ ",2],"فمن أخفرَ ذمَّةَ اللَّهِ كبَّهُ اللَّهُ في النَّارِ لوجهه"],"grade":"صحيح","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني كما في ((مجمع الزوائد)) للهيثمي (1646)، والدارقطني في ((العلل)) (1274) واللفظ لهما، والبزار (‌3616) بنحوه مطولا.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"7SqYWwUp"},{"id":"س-07801","fp":"38965f520d70","stateId":351,"easy":"إذا قرأت آية الكرسي دبر كل صلاة ← تُحفظ إلى الصلاة الأخرى","cause":"من قرأَ في دبرِ كلِّ صلاةٍ مَكْتوبةٍ آيةَ الكرسيِّ","result":"حُفِظَ إلى الصَّلاةِ","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"similar":["س-01067"],"ref":"الكافي الشاف 41","srcLabel":"النسائي","text":[["من قرأَ في دبرِ كلِّ صلاةٍ مَكْتوبةٍ آيةَ الكرسيِّ ",1],["حُفِظَ إلى الصَّلاةِ",2]],"grade":"صحيح","narrator":"أبو أمامة الباهلي","muhaddith":"إسناده صحيح وله شاهد","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9928)، والطبراني (8/134) (7532)، وابن السني في ((عمل اليوم والليلة)) (124) أوله في أثناء حديث.","bab":"قرآن › فضل قراءة القرآن","dorar":"55P97Kl7"},{"id":"س-01067","fp":"1ed127d8d60d","stateId":351,"easy":"إذا قرأت آية الكرسي دبر كل صلاة ← تكون في ذمة الله إلى الصلاة الأخرى","cause":"قارِئُ آيَةِ الكُرسيِّ في دُبُرِ كُلِّ صَلاةٍ","result":"في ذِمَّةِ اللَّهِ إلى الصَّلاةِ الأُخرَى","explicit":true,"apply":{"k":"read","t":"آية الكرسي · الوقت: دبر كل صلاة"},"repOf":"س-07801","otherNeedIds":[25],"ref":"الحرز الثمين 2/806","text":["كانَ -أي: ",["قارِئُ آيَةِ الكُرسيِّ في دُبُرِ كُلِّ صَلاةٍ",1],"- ",["في ذِمَّةِ اللَّهِ إلى الصَّلاةِ الأُخرَى",2],"."],"grade":"حسن","narrator":"الحسن بن علي","muhaddith":"إسناده حسن","bab":"أدعية وأذكار › فضل الذكر","dorar":"7wyEIUrR"},{"id":"س-03659","fp":"401975864649","stateId":352,"easy":"إذا هاجت الريح فلا تسبّها وسل الله خيرها ← تُكفى شرها","cause":"هاجَتْ ريحٌ","result":"لا تَسُبَّها، وسَلِ اللهَ خَيْرَها، وخَيْرَ ما فيها، وخَيْرَ ما أُرسِلَتْ به","explicit":true,"star":true,"otherNeedIds":[29],"ref":"الأحاديث المختارة 1225","srcLabel":"البخاري","text":["«",["هاجَتْ ريحٌ",1]," فسَبَّها رَجُلٌ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["لا تَسُبَّها، وسَلِ اللهَ خَيْرَها، وخَيْرَ ما فيها، وخَيْرَ ما أُرسِلَتْ به",2],"، وتَعَوَّذوا باللهِ مِن شَرِّها، وشَرِّ ما فيها، وشَرِّ ما أُرسِلَتْ به»."],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"dK2df470"},{"id":"س-00872","fp":"bc35ff47db66","stateId":352,"easy":"إذا أنعم الله عليك فقلت «ما شاء الله لا قوة إلا بالله» ← لا ترى فيها آفة دون الموت","cause":"ما أنعمَ اللَّهُ على عبدٍ منِ نعمةٍ من أهلٍ وولدٍ فيقولُ ما شاءَ اللَّهُ لا قوَّةَ إلَّا باللَّهِ","result":"فَيرَى فيهِ آفةً دونَ المَوتِ","explicit":true,"apply":{"k":"say","t":"«ما شاء الله لا قوة إلا بالله»"},"otherNeedIds":[1],"ref":"شفاء العليل 1/182","srcLabel":"الطبراني","text":[["ما أنعمَ اللَّهُ على عبدٍ منِ نعمةٍ من أهلٍ وولدٍ فيقولُ ما شاءَ اللَّهُ لا قوَّةَ إلَّا باللَّهِ ",1],["فَيرَى فيهِ آفةً دونَ المَوتِ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((الشكر)) (1)، والطبراني في ((المعجم الأوسط)) (5995)، وابن السني في ((عمل اليوم والليلة)) (357)","bab":"أدعية وأذكار › فضل الذكر","dorar":"IAStgy27"},{"id":"س-02847","fp":"f0b4cdaa038d","stateId":352,"easy":"إذا رأيت مبتلى فقلت «الحمد لله الذي عافاني...» ← تُعافى من ذلك البلاء ما عشت","cause":"من رأى صاحب بلاء، فقال: الحمد لله الذي عافاني مما ابتلاك به، وفضلني على كثير ممن خلق تفضيلا","result":"إلا عوفي من ذلك البلاء كائنا ما كان ما عاش","explicit":true,"apply":{"k":"say","t":"«الحمد لله الذي عافاني مما ابتلاك به، وفضلني على كثير ممن خلق تفضيلا، إلا عوفي من ذلك البلاء كائنا ما كان ما عاش]$»"},"otherNeedIds":[35],"ref":"تخريج سير أعلام النبلاء 5/308","srcLabel":"الترمذي","text":["مَن رأى مُبتَلًى، فقال: الحَمدُ للهِ الذي فضَّلَني  بمَعْناه [أي حديث: ",["من رأى صاحب بلاء، فقال: الحمد لله الذي عافاني مما ابتلاك به، وفضلني على كثير ممن خلق تفضيلا، ",1],["إلا عوفي من ذلك البلاء كائنا ما كان ما عاش",2],"]$"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح بطرقه]","takhrij":"أخرجه الترمذي (3432) بلفظه، والبزار (6217)، والطبراني في ((الدعاء)) (799) كلاهما بلفظ مقارب.","bab":"إيمان › الوعد","dorar":"J4wC3Ofv"},{"id":"س-00832","fp":"ae2976f72c7b","stateId":352,"easy":"إذا رأيت مبتلى فقلت «الحمد لله الذي عافاني مما ابتلاك به» ← تكون شاكراً للنعمة","cause":"إذا رأى أحدُكم أحَدًا في بلاءٍ فليقُلِ الحمدُ للهِ الَّذي عافاني ممَّا ابتلاك به وفضَّلَني على كثيرٍ ممَّن خلَق تفضيلًا","result":"فإنَّه إذا قال ذلك كان شاكرًا تلك النِّعْمةَ","explicit":true,"apply":{"k":"say","t":"«الحمد لله الذي عافاني مما ابتلاك به»"},"otherNeedIds":[35,49],"ref":"مجمع الزوائد 10/141","srcLabel":"البيهقي","text":[["إذا رأى أحدُكم أحَدًا في بلاءٍ فليقُلِ الحمدُ للهِ الَّذي عافاني ممَّا ابتلاك به وفضَّلَني على كثيرٍ ممَّن خلَق تفضيلًا ",1],["فإنَّه إذا قال ذلك كان شاكرًا تلك النِّعْمةَ",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن","takhrij":"أخرجه البزار (9106)، والبيهقي في ((شعب الإيمان)) (4443)","bab":"أدعية وأذكار › فضل التحميد والتسبيح والدعاء","dorar":"eIeR56y3","merged":2,"otherRefs":["صحيح الجامع 555 (حسن)"]},{"id":"س-00935","fp":"87b98cabae64","stateId":352,"easy":"إذا رأيت الحريق فكبّر ← فالتكبير يطفئ النار","cause":"إذَا رأيتمُ الحريقَ فكبِّرُوا","result":"فإنَّه يُطفِئُ النارَ","explicit":true,"ref":"الجامع الصغير (2/ 69)","srcLabel":"ابن عدي","text":[["إذَا رأيتمُ الحريقَ فكبِّرُوا",1]," ، ",["فإنَّه يُطفِئُ النارَ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/ 112) واللفظ له.","bab":"أدعية وأذكار › فضل الذكر","dorar":"IgJU8QcU","merged":2,"otherRefs":["النوافح العطرة 31 (حسن)"]},{"id":"س-03594","fp":"e9042624c9e9","stateId":352,"easy":"إذا رأيت من الريح ما تكره فقل «اللهم إنا نسألك من خيرها...» ← تُوقى شرها","cause":"فإذا رأيتُم ما تكرهونَ","result":"فقولوا : اللهمّ إنا نسألُكَ من خير هذهِ الريحِ، وخيرٌِ ما فيها، وخيرٌ ما أُمرَتْ بهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«اللهمّ إنا نسألُكَ من خير هذهِ الريحِ، وخيرٌِ ما فيها، وخيرٌ ما أُمرَتْ بهِ، ونعوذُ بكِ من شرّ هذه الريحِ، وشرّ ما فيها، وشرّ ما أُمرَتْ بهِ]»"},"otherNeedIds":[29],"ref":"تفسير سورة فاطر 71","srcLabel":"الترمذي","text":["حديث النَّهيِ عن سَبِّ الرِّيحِ. [يعني حديث: لا تسبُّوا الريحَ، ",["فإذا رأيتُم ما تكرهونَ",1]," ",["فقولوا : اللهمّ إنا نسألُكَ من خير هذهِ الريحِ، وخيرٌِ ما فيها، وخيرٌ ما أُمرَتْ بهِ",2],"، ونعوذُ بكِ من شرّ هذه الريحِ، وشرّ ما فيها، وشرّ ما أُمرَتْ بهِ]"],"grade":"صحيح","narrator":"[أبي بن كعب]","muhaddith":"[ثابت]","takhrij":"أخرجه الترمذي (2252)، وأحمد (21138)، والنسائي في ((الكبرى)) (10704) بنحوه تامًا.","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"0lkVjNRK"},{"id":"س-03633","fp":"c7b2aa6d2ced","stateId":352,"easy":"إذا رأيت القمر فاستعذ بالله من شره ← فإنه الغاسق إذا وقب","cause":"استَعيذي باللهِ مِن شرِّ هذا","result":"فإنُّه الغاسِقُ إذا وَقَبَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"المستدرك على الصحيحين 4037","srcLabel":"الترمذي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أخَذَ بيدِها فأشارَ بها إلى القمرِ، فقالَ: «",["استَعيذي باللهِ مِن شرِّ هذا",1],"؛ ",["فإنُّه الغاسِقُ إذا وَقَبَ",2],"»."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (3366)، وأحمد (25802) بلفظه، والنسائي في ((السنن الكبرى)) (10064) بلفظ مقارب","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"dtZnAb6o"},{"id":"س-06014","fp":"785c183c08d8","stateId":353,"easy":"إذا حفظت الله ← يحفظك","cause":"احْفَظِ اللهَ","result":"يَحفَظْك","explicit":true,"star":true,"otherNeedIds":[25],"ref":"الأحاديث المختارة 10 / 24","srcLabel":"متفق عليه","text":["«كُنْتُ رَديفَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا غُلامُ، أو يا بُنَيَّ، أَلَا أُعَلِّمُك كَلِماتٍ يَنفَعُك اللهُ بِهنَّ؟ فقُلْتُ: بَلى، فقالَ: ",["احْفَظِ اللهَ ",1],["يَحفَظْك",2],"، احْفَظِ اللهَ تَجِدْه أمامَك، تَعرَّفْ إليه في الرَّخاءِ يَعرِفْك في الشِّدَّةِ، إذا سَألْتَ فاسْأَلِ اللهَ، وإذا اسْتَعَنْتَ فاسْتَعِنْ باللهِ، قد جَفَّ القَلَمُ بما هو كائِنٌ، فلو أنَّ الخَلْقَ كلَّهم جَميعًا أرادوا أن يَنفَعوك بشيءٍ لم يَقْضِه اللهُ لك لم يَقدِروا عليه، وإن أرادوا أن يَضُرُّوك بشيءٍ لم يَقْضِه اللهُ عليك لم يَقدِروا عليه، اعْمَلْ للهِ بالشُّكْرِ واليَقينِ، واعْلَمْ أنَّ الصَّبْرَ على ما تَكرَهُ خَيْرٌ كَثيرٌ، وأنَّ النَّصْرَ معَ الصَّبْرِ، وأنَّ الفَرَجَ معَ الكَرْبِ، وأنَّ معَ العُسْرِ يُسْرًا»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › تقوى الله","dorar":"Zz7qGbDv","merged":5,"otherRefs":["تخريج المسند لشعيب 2763 (صحيح)","الأحاديث المختارة 10 / 22 (صحيح)","الأحاديث المختارة 10 / 25 (صحيح)","تخريج رياض الصالحين 62 (صحيح)"]},{"id":"س-00127","fp":"cdefd19b005b","stateId":353,"easy":"إذا أفشيت السلام ← تسلم","cause":"أفْشوا السلامَ","result":"تَسلَموا","explicit":true,"star":true,"otherNeedIds":[41],"ref":"الجامع الصغير 1222","srcLabel":"البخاري","text":[["أفْشوا السلامَ ",1],["تَسلَموا ",2],"[ والأَشَرَةُ شَرٌّ.]"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه أحمد (18530)، والبخاري في ((الأدب المفرد)) (787)، وأبو يعلى (1687) واللفظ لهم.","bab":"آداب السلام › إفشاء السلام","dorar":"iDxVfrUK","merged":2,"otherRefs":["فيض القدير 2/ 23 (صحيح)"]},{"id":"ق-0340","fp":"46dd2d2306f2","stateId":353,"easy":"الاهتداء ولزوم إصلاح النفس ← لا يضرّ ضلال من ضلّ","cause":"الاهتداء ولزوم إصلاح النفس","result":"لا يضرّ ضلال من ضلّ","explicit":true,"ref":"سورة المائدة: 105","srcLabel":"القرآن الكريم","quran":{"s":5,"from":105,"to":105,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا عَلَيْكُمْ أَنْفُسَكُمْ لَا يَضُرُّكُمْ مَنْ ضَلَّ إِذَا اهْتَدَيْتُمْ إِلَى اللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ (105)","hl":[[31,101,1]]}},{"id":"ق-0460","fp":"d9d222628da0","stateId":353,"easy":"الاستغفار ← الأمان من العذاب","cause":"الاستغفار","result":"الأمان من العذاب","explicit":true,"otherNeedIds":[11],"ref":"سورة الأنفال: 33","srcLabel":"القرآن الكريم","quran":{"s":8,"from":33,"to":33,"text":"وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ (33)","hl":[[53,109,1]]}},{"id":"ق-0603","fp":"d44a8467dce3","stateId":353,"easy":"الإصلاح ← الأمان من الإهلاك","cause":"الإصلاح","result":"الأمان من الإهلاك","explicit":true,"otherNeedIds":[43],"ref":"سورة هود: 117","srcLabel":"القرآن الكريم","quran":{"s":11,"from":117,"to":117,"text":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَى بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ (117)","hl":[[0,72,1]]}},{"id":"ق-0999","fp":"483d759b2595","stateId":353,"easy":"الحجاب والستر ← الصيانة من الأذى","cause":"الحجاب والستر","result":"الصيانة من الأذى","explicit":true,"otherNeedIds":[42],"ref":"سورة الأحزاب: 59","srcLabel":"القرآن الكريم","quran":{"s":33,"from":59,"to":59,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ وَبَنَاتِكَ وَنِسَاءِ الْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ذَلِكَ أَدْنَى أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (59)","hl":[[80,170,1]]}},{"id":"ق-1272","fp":"0359937582b8","stateId":353,"easy":"الصبر لحكم الله والتسبيح بحمده حين القيام ومن الليل ← العناية والحفظ (فإنك بأعيننا)","cause":"الصبر لحكم الله والتسبيح بحمده حين القيام ومن الليل","result":"العناية والحفظ (فإنك بأعيننا)","explicit":true,"otherNeedIds":[25],"ref":"سورة الطور: 48–49","srcLabel":"القرآن الكريم","quran":{"s":52,"from":48,"to":49,"text":"وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ (48) وَمِنَ اللَّيْلِ فَسَبِّحْهُ وَإِدْبَارَ النُّجُومِ (49)","hl":[[0,148,1]]}},{"id":"س-04428","fp":"8597e1139839","stateId":353,"easy":"إذا استودعت الله شيئاً ← يحفظه","cause":"إذا استودِعَ اللَّهُ شيئًا","result":"حفظَهُ","explicit":true,"ref":"الفتوحات الربانية 5/113","srcLabel":"النسائي","text":["عن مجاهد قال: أتَيتُ ابنَ عُمرَ أنا و رجُلٌ معي أردنا الخروجَ إلى الغزوِ فشيَّعَنا فلمَّا أرادَ أن يفارقَنا قالَ : أنه ليسَ لي ما أُعطيكُما و لَكِنِّي سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["إذا استودِعَ اللَّهُ شيئًا",1]," ",["حفظَهُ",2]," ، وإنِّي أستودِعُ اللَّهَ دينَكُما وأمانتَكُما ، وخَواتيمَ أعمالِكُما"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10343)","bab":"جهاد › توديع المنزل بركعتين وما يقال عند التوديع","dorar":"MtUJHcYW","merged":4,"otherRefs":["السلسلة الصحيحة 1/49 (صحيح)","تخريج المسند لشاكر 8/14 (صحيح)","تخريج سنن أبي داود 4/242 (صحيح)"]},{"id":"س-06308","fp":"eeb72f3a7674","stateId":353,"easy":"إذا سكتّ عن الشر ← تسلم","cause":"واسكُتوا عنْ شَرٍّ","result":"تَسلَموا","explicit":true,"otherNeedIds":[53],"ref":"المستدرك على الصحيحين 7983","srcLabel":"الضياء","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ خَرَج ذاتَ يَومٍ على راحِلَتِه، وأصحابُه معه بيْنَ يَدَيهِ، فقال مُعاذُ بنُ جَبَلٍ: يا نَبيَّ اللهِ، أتَأذَنُ لي في أنْ أتقَدَّمَ إليكَ على طِيبةِ نَفسٍ؟ قالَ: نَعَم؛ فاقتَرَب مُعاذٌ إليه، فسارَا جَميعًا، فقالَ مُعاذٌ: بأبي أنتَ يا رَسولَ اللهِ، أسألُ اللهَ أنْ يَجعَلَ يَومَنا قَبْلَ يَومِكَ، أرَأيتَ إنْ كانَ شَيءٌ -ولا نَرى شَيئًا إنْ شاءَ اللهُ- فأيُّ الأعمالِ نَعمَلُها بعْدَكَ؟ فصَمَتَ رَسولُ الله صلَّى اللهُ عليه وسلَّمَ، فقالَ: الجِهادُ في سَبيلِ اللهِ، ثمَّ قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: نِعمَ الشَّيءُ الجِهادُ، والَّذي بالنَّاسِ أملَكُ مِن ذلكَ، فالصِّيامُ والصَّدَقةُ، قالَ: نِعمَ الشَّيءُ الصِّيامُ والصَّدَقةُ، فذَكَر مُعاذٌ كلَّ خَيرٍ يَعمَلُه ابنُ آدَمَ، كلُّ ذلكَ يَقولُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: وعادِ بالنَّاسِ خَيرٌ مِن ذلكَ، قالَ: فماذا -بأبي أنتَ وأُمِّي- عادِ بالنَّاسِ خَيرٌ من ذلكَ؟ قالَ: فأشار رَسولُ الله صلَّى اللهُ عليه وسلَّمَ إلى فِيهِ، قالَ: الصَّمتُ، إلَّا مِن خَيرٍ، قالَ: وهلْ نُؤاخَذُ بما تَكَلَّمَت به ألسِنَتُنا؟ قالَ: فضَرَب رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فَخِذَ مُعاذٍ، ثمَّ قالَ: يا مُعاذُ، ثَكِلَتْكَ أُمُّكَ! -أو ما شاءَ اللهُ أن يَقولَ له مِن ذلك- وهلْ يَكُبُّ النَّاسَ على مَناخِرِهم في جَهَنَّمَ إلَّا ما نَطَقَت به ألسِنَتُهم؟! فمَن كانَ يُؤمِنُ باللهِ واليَومِ الآخِرِ، فليَقُلْ خَيرًا أو لِيَسكُتْ عنْ شَرٍّ، قُولوا خَيرًا تَغنَموا، ",["واسكُتوا عنْ شَرٍّ",1]," ",["تَسلَموا",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الضياء في ((الأحاديث المختارة)) (405) (8/  333) بلفظ مقارب","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"qbFqZpYZ","merged":2,"otherRefs":["مجمع الزوائد 10/302 (صحيح)"]},{"id":"س-05638","fp":"280d4080589d","stateId":353,"easy":"إذا لزمت جماعة المسلمين ← فدعاؤهم يحيط بك من ورائك","cause":"واللُّزومُ لِجَماعَتِهم","result":"فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم","explicit":true,"similar":["س-04743"],"ref":"الترغيب والترهيب 4/162","srcLabel":"أبو داود","text":["رَحِمَ اللهُ مَن سَمِعَ مَقالَتي حتى يُبَلِّغَها غَيرَه: ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ امرِئٍ مُسلِمٍ: إخلاصُ العَمَلِ للهِ، والنُّصحُ لِأئِمَّةِ المُسلِمينَ، ",["واللُّزومُ لِجَماعَتِهم",1],"، ",["فإنَّ دُعاءَهم يُحيطُ مِن وَرائِهم",2],"، إنَّه مَن تَكُنِ الدُّنيا نِيَّتَه يَجعَلِ اللهُ فَقرَه بَينَ عَينَيْه، ويُشَتِّتُ عليه ضَيعَتَه، ولا يأتيه منها إلَّا ما كُتِبَ له، ومَن تَكُنِ الآخِرةُ نِيَّتَه يَجعَلِ اللهُ غِناهُ في قَلبِه ويَكفيه ضَيعَتَه، وتأتيه الدُّنيا وهي راغِمةٌ."],"grade":"صحيح","narrator":"زيد بن ثابت","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أبو داود (3660) باختلاف يسير دون قوله: \"ثلاث لا يغل ...\"، وابن ماجه (230، 4105) مفرقاً باختلاف يسير، وأحمد (21590) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"jihas9WH"},{"id":"س-06116","fp":"8ba82892b7b3","stateId":353,"easy":"إذا شكرت إذا أُعطيت وغفرت إذا قدرت وفترت إذا غضبت ← يؤويك الله في كنفه ويسترك برحمته","cause":"مَنْ إذا أُعْطيَ شَكَرَ، وإذا قَدَرَ غَفَرَ، وإذا غَضِبَ فَتَرَ","result":"ثلاثٌ مَنْ كُنَّ فيهِ آواهُ اللهُ في كَنَفِهِ، وسَتَرَ عليه بِرَحْمَتِهِ، وَأَدْخَلَهُ في مَحَبَّتِهِ","explicit":true,"otherNeedIds":[42,23],"ref":"المستدرك على الصحيحين 438","srcLabel":"البيهقي","text":["«",["ثلاثٌ مَنْ كُنَّ فيهِ آواهُ اللهُ في كَنَفِهِ، وسَتَرَ عليه بِرَحْمَتِهِ، وَأَدْخَلَهُ في مَحَبَّتِهِ",2],"». قيلَ: ما هُنَّ يا رسولَ اللَّهِ؟ قالَ: «",["مَنْ إذا أُعْطيَ شَكَرَ، وإذا قَدَرَ غَفَرَ، وإذا غَضِبَ فَتَرَ",1],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان )) (4119)، وقوام السنة في ((الترغيب والترهيب)) واللفظ له","bab":"رقائق وزهد › مكارم الأخلاق والعفو عمن ظلم","dorar":"rLhP09eA"},{"id":"س-00619","fp":"41c58492d42f","stateId":353,"easy":"إذا تواضعت لعظمة الله ولم تصرّ على المعصية وذكرته ← يحفظك الله بعزته ويستحفظك ملائكته","cause":"ممَّن تواضعَ بها لعظمتي ولم يستطل على خلقي ولم يبت مصرًّا على معصيتي وقطعَ نهارَهُ في ذكري ورحمَ المسكينَ وابنَ السَّبيلِ والأرملةَ ورحمَ المصابَ","result":"ذلكَ نورُهُ كنورِ الشَّمسِ أكلؤهُ بعزَّتي وأستحفظُهُ ملائكتي أجعلُ لهُ في الظُّلمةِ نورًا وفي الجهالةِ حلمًا ومثلُهُ في خَلقي كمثلِ الفردَوسِ في الجنَّةِ","explicit":true,"otherNeedIds":[15],"ref":"مجمع الزوائد 2/150","srcLabel":"البزار","text":["قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ اللَّهُ تباركَ وتعالى إنَّما أتقبَّلُ الصَّلاةَ ",["ممَّن تواضعَ بها لعظمتي ولم يستطل على خلقي ولم يبت مصرًّا على معصيتي وقطعَ نهارَهُ في ذكري ورحمَ المسكينَ وابنَ السَّبيلِ والأرملةَ ورحمَ المصابَ",1]," ",["ذلكَ نورُهُ كنورِ الشَّمسِ أكلؤهُ بعزَّتي وأستحفظُهُ ملائكتي أجعلُ لهُ في الظُّلمةِ نورًا وفي الجهالةِ حلمًا ومثلُهُ في خَلقي كمثلِ الفردَوسِ في الجنَّةِ",2]],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"فيه عبد الله بن واقد الحراني وبقية رجاله ثقات","takhrij":"أخرجه البزار (4855) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (2/420)، وأبو نعيم في ((حلية الأولياء)) (4/18)","bab":"آداب عامة › ضرب الأمثال","dorar":"ePrDhAWj"},{"id":"س-00938","fp":"f9627f71c761","stateId":353,"easy":"إذا وُجد في الناس عباد ركّع وصبية رضّع وبهائم رتّع ← يُدفع العذاب عنهم","cause":"لولا عبادٌ للَّهِ رُكَّعٌ، وصِبيةٌ رُضَّعٌ، وبَهائمُ رُتَّعٌ","result":"لَصُبَّ عليكُمُ العَذَابُ صبًّا","explicit":true,"otherNeedIds":[56],"ref":"الجامع الصغير 7505","srcLabel":"الطبراني","text":[["لولا عبادٌ للَّهِ رُكَّعٌ، وصِبيةٌ رُضَّعٌ، وبَهائمُ رُتَّعٌ",1]," ",["لَصُبَّ عليكُمُ العَذَابُ صبًّا",2],"، ثمَّ رُصَّ رَصًّا"],"grade":"حسن","narrator":"مسافع الديلي أبو عبيدة","muhaddith":"حسن","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (965) بلفظه، والطبراني (22/ 309) (785)، والبيهقي (6462)، والدولابي (263) جميعا باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"MtajoCLJ"},{"id":"س-07735","fp":"4b3440e8aae8","stateId":353,"easy":"إذا اعتصمت بالله ورفضت الزنا ← يعمي الله عنك من يطلبك (من قصة مرثد)","cause":"قلتُ يا عناقُ حرَّمَ اللَّهُ الزِّنا","result":"فظلَّ بولُهم على رأسي وعمَّاهمُ اللَّهُ عنِّي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"عارضة الأحوذي 6/260","srcLabel":"أبو داود","text":["كانَ رجلٌ يقالُ لهُ مرثدُ بنُ أبي مرثدٍ وَكانَ رجلًا يحملُ الأسرى من مَكةَ حتَّى يأتيَ بِهمُ المدينةَ قال وَكانت امرأةٌ بغيٌّ بمَكةَ يقالُ لَها عناقٌ وَكانت صديقةً لهُ وإنَّهُ كانَ وعدَ رجلًا من أسارى مَكةَ يحملُه قال فجئتُ حتَّى انتَهيتُ إلى ظلِّ حائطٍ من حوائطِ مَكةَ في ليلةٍ مقمرةٍ قال فجاءت عناقٌ فأبصرت سوادَ ظلِّي بجنبِ الحائطِ فلمَّا انتَهت إليَّ عرفت فقالت مرثدٌ فقلتُ مرثدٌ فقالت مرحبًا وأَهلًا هلمَّ فبت عندنا اللَّيلة قال ",["قلتُ يا عناقُ حرَّمَ اللَّهُ الزِّنا",1]," قالت يا أَهلَ الخيامِ هذا الرَّجلُ يحملُ أسراكم قال فتبعني ثمانيةٌ وسلَكتُ الخندمةَ فانتَهيتُ إلى غارٍ أو كَهفٍ فدخلتُ فجاؤوا حتَّى قاموا على رأسي فبالوا ",["فظلَّ بولُهم على رأسي وعمَّاهمُ اللَّهُ عنِّي",2]," قال ثمَّ رجعوا ورجعتُ إلى صاحبي فحملتُه وَكانَ رجلًا ثقيلًا حتَّى انتَهيتُ إلى الإذخرِ ففَككتُ عنهُ أَكبُلَه فجعلتُ أحملُه ويعينني حتَّى قدمتُ المدينةَ فأتيتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقلتُ يا رسولَ اللَّهِ أنكحُ عناقًا مرتين فأمسَك رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ولم يردَّ عليَّ شيئًا حتَّى نزلت {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ وَحُرِّمَ ذَلِكَ عَلَى الْمُؤْمِنِينَ} فقال رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يا مرثدُ {الزَّانِي لَا يَنْكِحُ إِلَّا زَانِيَةً أَوْ مُشْرِكَةً وَالزَّانِيَةُ لَا يَنْكِحُهَا إِلَّا زَانٍ أَوْ مُشْرِكٌ } فلا تَنكِحْها"],"grade":"صحيح","narrator":"[جد عمرو بن شعيب]","muhaddith":"حسن صحيح جدا","takhrij":"أخرجه الترمذي (3177) واللفظ له، وأبو داود (2051) مختصرا، والنسائي (3228) باختلاف يسير.","bab":"قرآن › أسباب النزول","dorar":"KbiEwY50"},{"id":"س-04743","fp":"6e3b13e32bbf","stateId":353,"easy":"إذا لزمت الجماعة ← تحيط بك دعوتهم من ورائك","cause":"ولُزومُ الجَماعةِ","result":"فإنَّ دَعوَتَهم تَكونُ مِن ورائِهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-05638","ref":"تخريج المسند لشعيب 16754","text":["سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسَلَّمَ وهو يَخطُبُ النَّاسَ بِالخَيْفِ: نَضَّرَ اللهُ عَبدًا سَمِعَ مَقالَتي، فَوَعاها، ثم أدَّاها إلى مَن لم يَسمَعْها، فرُبَّ حامِلِ فِقهٍ لا فِقهَ له، ورُبَّ حامِلِ فِقهٍ إلى مَن هو أفقَهُ منه. ثَلاثٌ لا يَغِلُّ عليهِنَّ قَلبُ المُؤمِنِ: إخلاصُ العَمَلِ، وطاعةُ ذوي الأمرِ، ",["ولُزومُ الجَماعةِ",1],"؛ ",["فإنَّ دَعوَتَهم تَكونُ مِن ورائِهِ",2],". وعنِ ابنِ إسحاقَ قال: حَدَّثَني عَمْرُو بنُ أبي عَمْرٍو، مَولى المُطَّلِبِ، عن عَبدِ الرَّحمنِ بنِ الحُوَيرِثِ، عن محمدِ بنِ جُبَيرِ بنِ مُطعِمٍ، عن أبيهِ، مِثلَ حَديثِ ابنِ شِهابٍ، لم يَزِدْ، ولم يَنقُصْ."],"grade":"صحيح","narrator":"جبير بن مطعم","muhaddith":"صحيح لغيره","takhrij":"أخرجه ابن ماجه (231)، وأحمد (16754) واللفظ له","bab":"رقائق وزهد › الإخلاص","dorar":"RM7YQLlk"}]}