{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":62,"stateIds":[643,644,645,646,647,648],"items":[{"id":"س-07115","fp":"54741c03c5c2","stateId":643,"easy":"إذا لقّنت موتاك «لا إله إلا الله الحليم العظيم...» ← (ذكر نبوي عند الموت)","cause":"لا إلهَ إلَّا اللهُ الحَليمُ العَظيمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ الكَريمِ، والحَمْدُ للهِ رَبِّ العالَمينَ","result":"لَقِّنوها مَوْتاكم، قالوا: يا رَسولَ اللهِ فكيف هي للأحْياءِ؟ قالَ: أَجْوَدُ وأَجْوَدُ","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ الحَليمُ العَظيمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ الكَريمِ، والحَمْدُ للهِ رَبِّ العالَمينَ»"},"ref":"الأحاديث المختارة 9 / 149","srcLabel":"متفق عليه","text":["«في هؤلاء الكَلِماتِ: ",["لا إلهَ إلَّا اللهُ الحَليمُ العَظيمُ، سُبْحانَ اللهِ رَبِّ العَرْشِ الكَريمِ، والحَمْدُ للهِ رَبِّ العالَمينَ",1],"، قالَ: كانَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["لَقِّنوها مَوْتاكم، قالوا: يا رَسولَ اللهِ فكيف هي للأحْياءِ؟ قالَ: أَجْوَدُ وأَجْوَدُ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن جعفر بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › تعليم الناس وفضل ذلك","dorar":"dwXPSqOp"},{"id":"س-01242","fp":"6f94b1b678cd","stateId":643,"easy":"إذا قلت «لا إله إلا الله» عند موتك ← تكون نور صحيفتك وتجد لها روحاً","cause":"كَلِمةً لا يَقولُها عبدٌ عِندَ مَوتِه","result":"إلَّا كان نورَ الصَّحيفةِ، وإنَّ جَسَدَه ورُوحَه ليَجِدانِ لها رَوحًا عند الموتِ","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-02449","س-01232","س-02406"],"otherNeedIds":[65],"ref":"الأحاديث المختارة 125","srcLabel":"متفق عليه","text":["«مَرَّ عُمَرُ بنُ الخَطَّابِ بطَلحةَ بَعْدَ وفاةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقال: ما لك؟ مُكتَئِبٌ؟ أساءك أمرُ ابنِ عَمِّك؟ فقال: لا. ولكنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: إنِّي لأعلَمُ ",["كَلِمةً لا يَقولُها عبدٌ عِندَ مَوتِه",1]," ",["إلَّا كان نورَ الصَّحيفةِ، وإنَّ جَسَدَه ورُوحَه ليَجِدانِ لها رَوحًا عند الموتِ",2],"، فقال: أنا أعلَمُها، هي التي أراد عليها عَمَّه، ولو عَلِمَ أنَّ شَيئًا أنجى له منها لأمَرَه بها.\n-      وفي روايةٍ: ما لي أراك مكتَئِبًا، أيسوءُك أمرُ ابنِ عَمِّك؟ قال: لا، وعنده: هي الكَلِمةُ التي، وعنده: لأمَرَه به إلا كانت له نورًا، وعنده: هي الكَلِمةُ التي أراد عليها عَمَّه، ولو عَلِمَ أنَّ شيئًا أنجى له منها لأمَرَه»."],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"HwuZQhf0"},{"id":"س-02404","fp":"421f2c377b40","stateId":643,"easy":"إذا لقّنت موتاكم «لا إله إلا الله» ← فمن كانت آخر كلامه دخل الجنة","cause":"لقِّنوا مَوْتاكم لا إلهَ إلَّا اللهُ","result":"فإنَّ مَن كان آخرَ كلمتِه لا إلهَ إلَّا اللهُ عندَ المَوتِ؛ دخَلَ الجنَّةَ يومًا مِن الدَّهرِ، وإنْ أصابَه قبلَ ذلك ما أصابَه","explicit":true,"star":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 11/157","srcLabel":"مسلم","text":[["لقِّنوا مَوْتاكم لا إلهَ إلَّا اللهُ؛ ",1],["فإنَّ مَن كان آخرَ كلمتِه لا إلهَ إلَّا اللهُ عندَ المَوتِ؛ دخَلَ الجنَّةَ يومًا مِن الدَّهرِ، وإنْ أصابَه قبلَ ذلك ما أصابَه",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (917)، وابن ماجه (1444) مختصراً، وابن حبان (3004) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"oGLXgXHQ"},{"id":"س-01021","fp":"e81845c4cba6","stateId":643,"easy":"إذا قلت «لا إله إلا الله» عند موتك ← يفرّج الله عنك كربتك","cause":"لا إلَهَ إلَّا اللَّهُ","result":"كلمةٌ لا يقولُها عبدٌ عندَ مَوتِهِ إلَّا فرَّجَ اللَّهُ عنهُ كُربتَهُ وأشرقَ لَونُهُ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"ref":"تخريج المسند لشاكر 2/360","srcLabel":"ابن حبان","text":["عن طلحةَ بنِ عُبَيْدِ اللَّهِ أنَّ عمرَ رضيَ اللَّهُ عنهُ رآهُ كئيبًا فقالَ : ما لَكَ يا أبا محمَّدٍ كئيبًا لعلَّهُ ساءتْكَ إمرةُ ابنِ عمِّكَ  يعني أبا بَكْرٍ قالَ : لا وأثنَى على أبي بَكْرٍ رضيَ اللَّهُ عنهُ ولَكِنِّي سَمِعْتُ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["كلمةٌ لا يقولُها عبدٌ عندَ مَوتِهِ إلَّا فرَّجَ اللَّهُ عنهُ كُربتَهُ وأشرقَ لَونُهُ",2]," فما منعَني أن أسألَهُ عنها إلَّا القدرةُ عليها حتَّى ماتَ فقالَ لَهُ عمرُ رضيَ اللَّهُ عنهُ إنِّي لأعلمُها . فقالَ لَهُ طلحةُ وما هيَ فقالَ لَهُ عمرُ رضيَ اللَّهُ عنهُ هل تعلمُ كلمةً هيَ أعظمَ من كلمةٍ أمرَ بِها عمَّهُ ",["لا إلَهَ إلَّا اللَّهُ",1]," فقالَ طلحةُ هيَ واللَّهِ هيَ"],"grade":"صحيح","narrator":"طلحة بن عبيد الله.","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن ماجة (3795)، وابن حبان (205)، وأبو يعلى (642) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"GYz23Nwl","merged":3,"otherRefs":["أحكام الجنائز 48 (صحيح)","مجمع الزوائد 2/327 (صحيح)"]},{"id":"س-02449","fp":"a0ad310772fb","stateId":643,"easy":"إذا قلت «لا إله إلا الله» عند الموت ← تجد روحك لها روحاً وتكون لك نوراً","cause":"لا يقولُها رجُلٌ عِندَ حضرةِ الموتِ","result":"إلَّا وجَدَ رُوحُه لها رَوْحًا حينَ تخرُجُ مِن جسدِه، وكانتْ له نورًا يومَ القيامةِ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-01242","otherNeedIds":[65],"ref":"تخريج المسند لشعيب 1/320","text":["مرَّ عُمَرُ بنُ الخطَّابِ بطلحةَ... فذكَرَتْه [أيْ حديثَ: ما لي أراكَ قد شَعِثْتَ واغْبَرَرْتَ منذُ تُوُفِّيَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ لعلَّك ساءَكَ يا طلحةُ إمَارةُ ابنِ عمِّك؟ قال: معاذَ اللهِ، إنِّي لَأجدَرُكم ألَّا أفعَلَ ذاك، إنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنِّي لَأعلَمُ كلمةً ",["لا يقولُها رجُلٌ عِندَ حضرةِ الموتِ",1]," ",["إلَّا وجَدَ رُوحُه لها رَوْحًا حينَ تخرُجُ مِن جسدِه، وكانتْ له نورًا يومَ القيامةِ",2],"، فلم أسألْ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عنها، ولم يُخبِرْني بها، فذلك الذي دخَلَني، قال عُمَرُ: فأنا أعلَمُها، قال: فللهِ الحمدُ! قال: فما هي؟! قال: هي الكلمةُ التي قالها لِعَمِّه: لا إلهَ إلَّا اللهُ، قال طلحةُ: صدَقتَ]."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10937)، وأحمد (187) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"EU5Dj7qE","merged":2,"otherRefs":["شرح الصدور 72 (صحيح)"]},{"id":"س-06057","fp":"f9f718e363f6","stateId":643,"easy":"إذا حافظت على الصلوات ← يدنو منك الملك عند الموت ويطرد الشيطان ويلقنك الشهادة","cause":"فمَن كان يُحافِظُ على الصَّلواتِ","result":"دَنا منه المَلَكُ وطَرَدَ عنه الشَّيطانَ، ويُلقِّنُه المَلَكُ لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، وذلك الحالُ العظيمُ","explicit":true,"otherNeedIds":[31],"ref":"مجمع الزوائد 2/328","srcLabel":"مجمع الزوائد","text":["سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ونظَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى مَلَكِ المَوتِ عليه السَّلامُ عندَ رأسِ رَجُلٍ من الأنصارِ فقال: يا مَلَكَ المَوتِ، ارفُقْ بصاحِبي، فإنَّه مُؤمِنٌ، فقال مَلَكُ المَوتِ عليه السَّلامُ: طِبْ نَفْسًا وقَرَّ عَينًا، واعلَمْ أنِّي بكل مُؤمِنٍ رفيقٌ، واعلَمْ يا مُحمَّدُ أنِّي لأقبِضُ رُوحَ ابنِ آدَمَ، فإذا صرَخَ صارِخٌ من أهلِه، قُمتُ في الدَّارِ ومعي رُوحُه، فقُلتُ: ما هذا الصَّارخُ؟ واللهِ ما ظَلَمْناه، ولا سَبَقْنا أجَلَه، ولا استَعْجَلْنا قَدَرَه، وما لنا في قَبضِه من ذَنْبٍ، فإنْ تَرْضَوْا بما صنَعَ اللهُ تُؤجَروا، وإنْ تَحزَنوا وتَسخَطوا تَأثُموا وتُؤزَروا، ما لكم عندَنا منه [عُتبى، وإنَّ لنا عندَكم بعدُ عَودَةً وعَودَةً]، فالحَذَرُ الحَذَرُ، وما من أهلِ بَيتٍ يا مُحمَّدُ شَعَرٌ ولا مَدَرٌ، بَرٌّ ولا بَحْرٌ، سَهْلٌ ولا جَبَلٌ إلَّا أنا أتصفَّحُهم في كُلِّ يَومٍ ولَيلَةٍ حتى لأنا أعرَفُ بصَغيرِهم وكَبيرِهم منهم بأنْفُسِهم، واللهِ يا مُحمَّدُ لو أرَدتُ أقبِضُ رُوحَ بَعوضَةٍ ما قَدَرتُ على ذلك حتى يكونَ اللهُ هو أَذِنَ بقَبْضِها، قال جَعفَرُ بنُ مُحمَّدٍ: بَلَغَني أنَّه إنَّما يتصفَّحُهم عندَ مَواقيتِ الصَّلاةِ، فإذا نظَرَ عندَ المَوتِ، ",["فمَن كان يُحافِظُ على الصَّلواتِ، ",1],["دَنا منه المَلَكُ وطَرَدَ عنه الشَّيطانَ، ويُلقِّنُه المَلَكُ لا إلهَ إلَّا اللهُ، مُحمَّدٌ رسولُ اللهِ، وذلك الحالُ العظيمُ",2],"."],"grade":"صحيح","narrator":"الخزرج والد الحارث","muhaddith":"فيه عمر بن شمر الجعفي والحارث بن الخزرج ولم أجد من ترجمهما وبقية رجاله رجال الصحيح","bab":"رقائق وزهد › فضل الصبر","dorar":"qxgiGeUr"},{"id":"س-01232","fp":"7fed7824c407","stateId":643,"easy":"إذا قلت لا إله إلا الله عند موتك ← تكون نوراً لصحيفتك","cause":"هيَ الَّتي أرادَ عمَّهُ علَيها","result":"كلِمةً لا يقولُها أحدٌ عندَ موتِهِ إلَّا كانَت نورًا لصَحيفتِهِ ، وإنَّ جسدَهُ وروحَهُ ليَجِدانِ لَها روحًا عندَ الموتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-01242","ref":"صحيح ابن ماجه 3077","text":["مرَّ عُمرُ بطلحةَ بعدَ وَفاةِ رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ، فقالَ: ما لَكَ كئيبًا ؟ أساءَتكَ إمرةُ ابنِ عمِّكَ ؟ قالَ: لا ، ولَكِن سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ: إنِّي لأعلَمُ ",["كلِمةً لا يقولُها أحدٌ عندَ موتِهِ إلَّا كانَت نورًا لصَحيفتِهِ ، وإنَّ جسدَهُ وروحَهُ ليَجِدانِ لَها روحًا عندَ الموتِ",2],". فلَم أسألْهُ حتَّى توُفِّيَ ، قالَ: أَنا أعلَمُها ، ",["هيَ الَّتي أرادَ عمَّهُ علَيها",1]," ، ولو علِمَ أنَّ شيئًا أَنجى لَهُ منها ، لأَمرَهُ"],"grade":"صحيح","narrator":"طلحة بن عبيد الله","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (3795)، والنسائي في ((السنن الكبرى)) (10874 )، وابن حبان (205)، وأبو يعلى (642)  جميعا بلفظه","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"wMG2x8DZ"},{"id":"س-02406","fp":"0e704b3da979","stateId":643,"easy":"إذا قلت لا إله إلا الله عند موتك ← تكون نوراً في صحيفتك وتجد لها روحاً","cause":"لا يقولُها الرجلُ عِندَ موتِه","result":"إلَّا كانتْ نورًا في صحيفتِه، أو وجَدَ لها رَوْحًا عِندَ الموتِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-01242","ref":"تخريج المسند لشعيب 252","text":["مرَّ عُمَرُ بطلحةَ -فذكَرَ معناهُ- قال: مرَّ عُمَرُ بطلحةَ فرآهُ مهتمًّا، قال: لعلَّك ساءَك إمَارةُ ابنِ عمِّك -قال: يعني أبا بَكْرٍ- فقال: لا، ولكنِّي سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: إنِّي لَأعلَمُ كلمةً ",["لا يقولُها الرجلُ عِندَ موتِه",1]," ",["إلَّا كانتْ نورًا في صحيفتِه، أو وجَدَ لها رَوْحًا عِندَ الموتِ",2],"، قال عُمَرُ: أنا أُخبِرُك بها، هي الكلمةُ التي أرادَ بها عمَّه: شهادةُ أنْ لا إلهَ إلَّا اللهُ. قال: فكأنَّما كُشِف عنِّي غِطاءٌ، قال: صدَقتَ، لو عَلِم كلمةً هي أفضَلُ منها لأمَرَه بها."],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"صحيح بطرقه","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10937)، وأحمد (252) واللفظ له","bab":"إسلام › فضل الشهادتين","dorar":"RRT8dmqx"},{"id":"س-02427","fp":"c7af98e0bf50","stateId":643,"easy":"إذا لقّنت موتاك لا إله إلا الله ← فنفس المؤمن تخرج رشحاً","cause":"نفسَ المُؤمِنِ","result":"تَخرُجُ رشْحًا","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح الجامع 5149","srcLabel":"الطبراني","text":["لقِّنوا موتَاكم لا إِلهَ إلا اللهُ ، فإنَّ ",["نفسَ المُؤمِنِ",1]," ",["تَخرُجُ رشْحًا",2]," ، و نفسُ الكافرِ تَخرُجُ من شِدْقِه ، كما تخرُجُ نفسُ الحِمارِ"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه الطبراني (10/233) (10417)، وأبو نعيم في ((حلية الأولياء)) (5/59)، والشجري في ((الأمالي)) (2926)","bab":"إسلام › فضل الشهادتين","dorar":"tr0KpdeT"},{"id":"س-03200","fp":"4d376ec5d099","stateId":643,"easy":"إذا كان آخر كلامك «لا إله إلا الله» ← دخلت الجنة","cause":"من كان آخِرَ كَلامِه لا إلهَ إلَّا اللهُ","result":"دَخَل الجنَّةَ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-04200"],"ref":"الفتاوى الكبرى 5/ 211","srcLabel":"الفتاوى الكبرى","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم «أمَرَ بتَلْقِينِ الميِّتِ لا إلهَ إلَّا اللهُ، وقال: ",["من كان آخِرَ كَلامِه لا إلهَ إلَّا اللهُ ",1],["دَخَل الجنَّةَ»",2]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"إيمان › فضل الإيمان","dorar":"gIhI0ald","merged":2,"otherRefs":["كلمة الإخلاص وتحقيق معناها 54 (صحيح)"]},{"id":"س-04200","fp":"cf0c7c899247","stateId":643,"easy":"إذا كان آخر كلامك «لا إله إلا الله» ← وجبت لك الجنة","cause":"مَن كان آخِرُ كَلامِه لا إلهَ إلَّا اللهُ","result":"وَجَبَتْ له الجنَّةُ","explicit":true,"apply":{"k":"say","t":"«لا إله إلا الله»"},"repOf":"س-03200","ref":"تخريج المسند لشعيب 22034","text":["قال لنا مُعاذٌ في مَرضِه: قد سَمِعتُ مِن رسولِ اللهِ صَلَّى اللهُ عليه وسلَّمَ شيئًا كنتُ أكتُمُكُموه؛ سَمِعتُ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن كان آخِرُ كَلامِه لا إلهَ إلَّا اللهُ، ",1],["وَجَبَتْ له الجنَّةُ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (3116)، وأحمد (22034) واللفظ له","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"kWj9xets"},{"id":"س-04500","fp":"8b06acec7416","stateId":644,"easy":"إذا قُتلت في سبيل الله ← فأنت شهيد","cause":"مَن قُتِلَ في سَبيلِ اللهِ","result":"فهو شَهيدٌ","explicit":true,"star":true,"similar":["س-04501","س-04499"],"ref":"صحيح مسلم 1915","srcLabel":"مسلم","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: ",["مَن قُتِلَ في سَبيلِ اللهِ ",1],["فهو شَهيدٌ، ",2],"ومَن ماتَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في الطَّاعونِ فهو شَهيدٌ، ومَن ماتَ في البَطنِ فهو شَهيدٌ. قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ومَن غَرِقَ فهو شَهيدٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB","merged":4,"otherRefs":["الأحاديث المختارة 294 (صحيح)","صحيح الجامع 5602 (صحيح)","فتح الباري لابن حجر 106/6 (حسن)"]},{"id":"س-04501","fp":"04a97ae4be79","stateId":644,"easy":"إذا مت في سبيل الله ← فأنت شهيد","cause":"ومَن ماتَ في سَبيلِ اللهِ","result":"فهو شَهيدٌ","explicit":true,"repOf":"س-04500","ref":"صحيح مسلم 1915","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، ",["ومَن ماتَ في سَبيلِ اللهِ ",1],["فهو شَهيدٌ، ",2],"ومَن ماتَ في الطَّاعونِ فهو شَهيدٌ، ومَن ماتَ في البَطنِ فهو شَهيدٌ. قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ومَن غَرِقَ فهو شَهيدٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB","merged":4,"otherRefs":["فتح الباري لابن حجر 23/6 (حسن)","السلسلة الصحيحة 4/231 (صحيح)","صحيح الجامع 5602 (صحيح)"]},{"id":"س-02154","fp":"91e9a7afce8b","stateId":644,"easy":"إذا طلبت الشهادة صادقاً ← تُعطاها ولو لم تصبك","cause":"مَن طَلَبَ الشَّهادةَ صادِقًا","result":"أُعطيَها ولو لَم تُصِبْه","explicit":true,"star":true,"ref":"صحيح مسلم 1908","srcLabel":"متفق عليه","text":[["مَن طَلَبَ الشَّهادةَ صادِقًا ",1],["أُعطيَها ولو لَم تُصِبْه",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"ABaQ9Yq1"},{"id":"س-04499","fp":"e69734eceb44","stateId":644,"easy":"إذا قُتلت في سبيل الله ← فأنت شهيد","cause":"مَن قُتِلَ في سَبيلِ اللهِ","result":"فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ","explicit":true,"repOf":"س-04500","ref":"صحيح مسلم 1915","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، ",["مَن قُتِلَ في سَبيلِ اللهِ ",1],["فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ",2],"، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في الطَّاعونِ فهو شَهيدٌ، ومَن ماتَ في البَطنِ فهو شَهيدٌ. قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ومَن غَرِقَ فهو شَهيدٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB","merged":2,"otherRefs":["الأحاديث المختارة 8 / 253 (صحيح)"]},{"id":"س-04210","fp":"02d45e071c72","stateId":644,"easy":"إذا خرجت في سبيل الله فمت أو قُتلت أو لدغتك هامة ← فأنت شهيد","cause":"مَنْ فَصَلَ في سبيلِ اللهِ فماتَ أوْ قُتِلَ","result":"فهو شَهيدٌ، أوْ وَقَصَهُ فَرسُهُ أوْ بَعيرُهُ أوْ لَدَغَتْهُ هامَةٌ، أوْ ماتَ على فِراشِهِ بأيِّ حَتفٍ شاءَ اللهُ؛ فإنَّه شَهيدٌ، وإنَّ له الجنَّةَ","explicit":true,"otherNeedIds":[67],"ref":"المستدرك على الصحيحين 2451","srcLabel":"مسلم","text":[["مَنْ فَصَلَ في سبيلِ اللهِ فماتَ أوْ قُتِلَ؛ ",1],["فهو شَهيدٌ، أوْ وَقَصَهُ فَرسُهُ أوْ بَعيرُهُ أوْ لَدَغَتْهُ هامَةٌ، أوْ ماتَ على فِراشِهِ بأيِّ حَتفٍ شاءَ اللهُ؛ فإنَّه شَهيدٌ، وإنَّ له الجنَّةَ",2],"."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أبو داود (2499)، وابن أبي عاصم في ((الجهاد)) (235)، والبيهقي في ((شعب الإيمان)) (3943) جميعهم بلفظه.","bab":"جنة › الصفات التي يعرف بها في الدنيا أهل الجنة وأهل النار","dorar":"A20dIOvh"},{"id":"س-08430","fp":"a72d1d068ed5","stateId":644,"easy":"إذا طُعنت في سبيل الله ← فزت ورب الكعبة","cause":"إذْ أَوْمَؤُوا إلى رجُلٍ فطَعَنَه فأْنفَذَه","result":"فُزْتُ وربِّ الكعبةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-07718"],"otherNeedIds":[67],"ref":"تخريج المسند لشعيب 14074","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم بعَثَ خالَه حَرامًا أخَا أُمِّ سُلَيمٍ في سَبعينَ إلى بني عامِرٍ، فلمَّا قَدِموا قال لهم خالي: أتَقَدَّمُكم، فإنْ أَمَّنوني حتى أُبَلِّغَهم عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، وإلَّا كنتم مِنِّي قريبًا، قال: فتَقَدَّمَ، فأَمَّنوه، فبيْنما هو يُحَدِّثُهم عن رسولِ اللهِ صلَّى اللهُ عليه وسلَّم، ",["إذْ أَوْمَؤُوا إلى رجُلٍ فطَعَنَه فأْنفَذَه",1],"، فقال: اللهُ أكبَرُ، ",["فُزْتُ وربِّ الكعبةِ",2],". ثمَّ مالُوا على بقيَّةِ أصحابِه فقَتَلوهم، إلَّا رجُلًا أَعرَجَ منهم كان قد صَعِد الجبَلَ. قال هَمَّامٌ: فأُراه قد ذكَرَ مع الأعرجِ آخَرَ معه على الجبَلِ. قال: وحدَّثَنا أنسٌ، أنَّ جِبريلَ عليه السلامُ أَتى النَّبيَّ صلَّى اللهُ عليه وسلَّم فأَخبَرَه أنَّهم قد لَقُوا ربَّهم، فرَضيَ عنهم وأَرْضاهم. قال أنسٌ: كانوا يَقرَؤونَ: أنْ بَلِّغوا قَومَنا، أنَّا قد لَقِينا ربَّنا، فرَضيَ عَنَّا وأَرْضانا. قال: ثمَّ نُسِخ بعْدَ ذلك. فدَعا عليهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ثلاثينَ صباحًا؛ على رِعْلٍ، وذَكْوانَ، وبني لِحْيانَ، وعُصَيَّةَ الذين عَصَوُا اللهَ ورسولَه، أو عَصَوُا الرحمنَ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (2801)، ومسلم (677) باختلاف يسير","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"KjSHFxxH"},{"id":"س-04538","fp":"cd3283895a5f","stateId":644,"easy":"إذا دعوت «اللهم آتني أفضل ما تؤتي عبادك الصالحين» ← تُرزق الشهادة","cause":"اللَّهُمَّ آتِني أفضَلَ ما تُؤتي عِبادَكَ الصَّالِحين","result":"إذَنْ يُعقَرُ جَوادُكَ، وتُستَشهَدُ في سَبيلِ اللهِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«اللهم آتني أفضل ما تؤتي عبادك الصالحين»"},"otherNeedIds":[29],"ref":"المستدرك على الصحيحين 760","srcLabel":"مسلم","text":["أنَّ رَجُلًا جاء إلى الصَّلاةِ والنَّبيُّ صلَّى اللهُ عليه وسلَّمَ يُصَلِّي بنا، فقالَ حين انتَهى إلى الصَّفِّ: ",["اللَّهُمَّ آتِني أفضَلَ ما تُؤتي عِبادَكَ الصَّالِحين",1],"، فلمَّا قَضَى النَّبيُّ صلَّى اللهُ عليه وسلَّمَ الصَّلاةَ، قالَ: مَنِ المُتَكَلِّمُ آنِفًا؟ فقالَ الرَّجُلُ: أنا يا رَسولَ اللهِ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["إذَنْ يُعقَرُ جَوادُكَ، وتُستَشهَدُ في سَبيلِ اللهِ",2],"."],"grade":"صحيح","narrator":"سعد","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه ابن خزيمة (453)، وابن حبان (4640) بلفظه.","bab":"جهاد › فضل الشهيد","dorar":"FcAukfIR","merged":2,"otherRefs":["الأحاديث المختارة 980 (صحيح)"]},{"id":"س-03347","fp":"5d7e855b3721","stateId":644,"easy":"إذا استُشهدت ← يُغفر لك مع أول دفعة من دمك وترى مقعدك من الجنة","cause":"لِلشَّهِيدِ عندَ اللهِ","result":"يُغْفَرُ لهُ في أولِ دَفْعَةٍ من دَمِهِ . ويُرَى مَقْعَدَهُ مِنَ الجنةِ . ويُحَلَّى حِلْيَةَ الإيمانِ . ويُزَوَّجُ [ اثْنَتَيْنِ وسبعينَ زَوْجَةً ] مِنَ الحُورِ العِينِ . ويُجَارُ من عذابِ القبرِ . ويَأْمَنُ مِنَ الفَزَعِ الأَكْبَرِ . ويُوضَعُ على رأسِهِ تَاجُ الوَقَارِ ، الياقُوتَةُ مِنْهُ خيرٌ مِنَ الدنيا وما فيها . ويُشَفَّعُ في سبعينَ إنسانًا من أهلِ بيتِه","explicit":true,"otherNeedIds":[11,63,65],"ref":"السلسلة الصحيحة 3213","srcLabel":"الترمذي","text":[["لِلشَّهِيدِ عندَ اللهِ",1]," خِصالٍ : ",["يُغْفَرُ لهُ في أولِ دَفْعَةٍ من دَمِهِ . ويُرَى مَقْعَدَهُ مِنَ الجنةِ . ويُحَلَّى حِلْيَةَ الإيمانِ . ويُزَوَّجُ [ اثْنَتَيْنِ وسبعينَ زَوْجَةً ] مِنَ الحُورِ العِينِ . ويُجَارُ من عذابِ القبرِ . ويَأْمَنُ مِنَ الفَزَعِ الأَكْبَرِ . ويُوضَعُ على رأسِهِ تَاجُ الوَقَارِ ، الياقُوتَةُ مِنْهُ خيرٌ مِنَ الدنيا وما فيها . ويُشَفَّعُ في سبعينَ إنسانًا من أهلِ بيتِه",2]],"grade":"صحيح","narrator":"المقدام بن معدي كرب","muhaddith":"إسناده صحيح","takhrij":"أخرجه الترمذي (1663)، وابن ماجه (2799)، وأحمد (17182) باختلاف يسير، وابن عساكر في ((تاريخ دمشق)) (16/191) واللفظ له","bab":"استغفار › أسباب المغفرة","dorar":"VmWbCH6E"},{"id":"س-04447","fp":"99b458b70b15","stateId":644,"easy":"إذا أصابك خراج في سبيل الله ← فعليك طابع الشهداء","cause":"ومَن خرَجَ به خُراجٌ في سبيلِ اللهِ","result":"فإنَّ عليه طابَعَ الشُّهداءِ","explicit":true,"similar":["س-04461","س-04737"],"ref":"تخريج سنن أبي داود 2541","srcLabel":"أبو داود","text":["أنَّه سَمِع رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: مَن قاتَلَ في سبيلِ اللهِ فُواقَ ناقةٍ فقد وجَبتْ له الجنَّةُ، ومَن سأَل اللهَ القتلَ مِن نفسِه صادقًا، ثمَّ مات أو قُتِل، فإنَّ له أجرَ شهيدٍ، زاد ابنُ المُصفَّى مِن هنا: ومَن جُرِح جُرحًا في سبيلِ اللهِ، أو نُكِب نَكبةً، فإنَّها تجيءُ يومَ القيامةِ كأَغزَرِ ما كانتْ: لونُها لونُ الزَّعفرانِ، وريحُها ريحُ المِسكِ، ",["ومَن خرَجَ به خُراجٌ في سبيلِ اللهِ، ",1],["فإنَّ عليه طابَعَ الشُّهداءِ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (2541) بلفظه، والترمذي (1657)، وابن ماجه (2792) كلاهما ببعض لفظه.","bab":"جهاد › فضل الجهاد","dorar":"P7OCEhu7"},{"id":"س-04461","fp":"3f16de0916d6","stateId":644,"easy":"إذا جُرحت في سبيل الله ← فعليك طابع الشهداء","cause":"ومَن جُرِحَ في سَبيلِ اللهِ","result":"فعليه طابَعُ الشُّهَداءِ","explicit":true,"repOf":"س-04447","ref":"تخريج المسند لشعيب 22116","text":["أنَّه سَمِعَ رسولَ اللهِ صَلَّى اللهُ عليه وسلَّمَ يقولُ: مَن جاهَدَ في سَبيلِ اللهِ -وقال رَوحٌ: قاتَلَ في سَبيلِ اللهِ- مِن رَجُلٍ مُسلِمٍ فُواقَ ناقةٍ، فقد وَجَبَتْ له الجنَّةُ، ومَن سَأَلَ اللهَ القَتلَ مِن عندِ نَفْسِه صادقًا، ثُمَّ مات أو قُتِلَ، فله أجرُ الشُّهَداءِ، ومَن جُرِحَ جُرحًا في سَبيلِ اللهِ أو نُكِبَ نَكبةً، فإنَّها تَجيءُ يومَ القيامةِ كأغزرِ ما كانتْ -وقال عبدُ الرَّزَّاقِ: كأغرِّ، ورَوحٌ: كأغزرِ، وحَجَّاجٌ: كأعزِّ ما كانتْ- لَونُها كالزَّعفَرانِ، ورِيحُها كالمِسكِ، ",["ومَن جُرِحَ في سَبيلِ اللهِ، ",1],["فعليه طابَعُ الشُّهَداءِ",2],"."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2541)، والترمذي (1657)، والنسائي (3141) باختلاف يسير، وابن ماجه (2792) مختصراً، وأحمد (22116) واللفظ له","bab":"جهاد › فضل الجهاد","dorar":"JjJkfDcT"},{"id":"س-04737","fp":"760ac2fdab58","stateId":644,"easy":"إذا جُرحت في سبيل الله ← طُبعت بطابع الشهداء","cause":"ومَن جُرِح في سبيلِ اللهِ","result":"طُبِع بطابَعِ الشُّهداءِ","explicit":true,"repOf":"س-04447","ref":"صحيح ابن حبان 3185","text":["( مَن جُرِح جُرحًا في سبيلِ اللهِ جاء يومَ القيامةِ يَدْمى اللَّونُ لونُ دمٍ والرِّيحُ ريحُ مِسْكٍ ",["ومَن جُرِح في سبيلِ اللهِ ",1],["طُبِع بطابَعِ الشُّهداءِ )",2]],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه أحمد (22110) بلفظه مطولًا، والترمذي (1657)، والنسائي (3141) بنحوه.","bab":"رقائق وزهد › الإخلاص","dorar":"gvaMIgeq"},{"id":"س-07927","fp":"36b320d941da","stateId":644,"easy":"إذا آمنت بالله وجاهدت في سبيله حتى قُتلت ← فأنت شهيد","cause":"مَن آمن باللهِ وجاهد في سبيلِ اللهِ وقاتل حتى يُقتلَ","result":"فهو شهيدٌ قال إن شهداءَ أمتي إذًا لقليلٌ القتلُ في سبيلِ اللهِ شهيدٌ والمبطونُ شهيدٌ والمطعونُ شهيدٌ والغريقُ شهيدٌ والنفساءُ شهيدةٌ","explicit":true,"ref":"مجمع الزوائد 5/304","srcLabel":"الطبراني","text":["عاد رسولُ اللهِ صلَّى اللهُ عليه وسلَّم سعدَ بنَ عبادةَ فقال ما تعدُّون الشهداءَ من أمتي قال ذلك ثلاثًا قالوا اللهُ ورسولُه أعلمُ قال سعدُ بنُ عبادةَ إن شاء رسولُ اللهِ صلَّى اللهُ عليه وسلَّم أذِن لي فأخبرته مَن الشهداءُ مِن أمتِه قال فأخبرْني مَن الشهداءُ من أمتي قال أسندوني فأسندوه قال ",["مَن آمن باللهِ وجاهد في سبيلِ اللهِ وقاتل حتى يُقتلَ ",1],["فهو شهيدٌ قال إن شهداءَ أمتي إذًا لقليلٌ القتلُ في سبيلِ اللهِ شهيدٌ والمبطونُ شهيدٌ والمطعونُ شهيدٌ والغريقُ شهيدٌ والنفساءُ شهيدةٌ",2]],"grade":"صحيح","narrator":"عبدالله بن بسر","muhaddith":"رجاله رجال الصحيح غير أبي صالح الفراء وهو ثقة","takhrij":"أخرجه الطبراني في ((مسند الشاميين)) (1508)، والضياء المقدسي في ((الأحاديث المختارة)) (70) واللفظ لهما.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"eqwTP1tl"},{"id":"س-07913","fp":"b6e368c99d9a","stateId":644,"easy":"إذا مت مسلماً بأي ميتة (في سبيل الله) ← فأنت شهيد","cause":"كلُّ مَوتةٍ يموتُ فيها المسلِمُ","result":"فهو شهيدٌ","explicit":true,"ref":"فيض القدير 4/ 180","srcLabel":"فيض القدير","text":[["كلُّ مَوتةٍ يموتُ فيها المسلِمُ",1]," ",["فهو شهيدٌ",2],"، غيرَ أنَّ الشَّهادةَ تتفاضَلُ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","bab":"مريض › فضل المرض والنوائب","dorar":"YPeTrbTm","merged":2,"otherRefs":["فتح الباري لابن حجر 52/6 (حسن)"]},{"id":"س-04662","fp":"56909db3a4ce","stateId":644,"easy":"إذا استُشهدت ← لك ست خصال عند أول قطرة: يُكفّر عنك كل خطيئة وترى مقعدك...","cause":"الشَّهيدُ","result":"سِتَّ خِصالٍ عِندَ أوَّلِ قَطرةٍ مِن دَمِه: يُكَفَّرُ عنه كُلُّ خَطيئةٍ، ويَرى مَقعَدَه مِنَ الجَنَّةِ، ويُزَوَّجُ مِنَ الحورِ العينِ، ويُؤمَنُ مِنَ الفَزَعِ الأكبَرِ، ومِن عَذابِ القَبرِ، ويُحَلَّى حُلَّةَ الإيمانِ","explicit":true,"otherNeedIds":[11,63,65,67],"ref":"تخريج المسند لشعيب 17783","srcLabel":"أحمد","text":["يُعطى ",["الشَّهيدُ",1]," ",["سِتَّ خِصالٍ عِندَ أوَّلِ قَطرةٍ مِن دَمِه: يُكَفَّرُ عنه كُلُّ خَطيئةٍ، ويَرى مَقعَدَه مِنَ الجَنَّةِ، ويُزَوَّجُ مِنَ الحورِ العينِ، ويُؤمَنُ مِنَ الفَزَعِ الأكبَرِ، ومِن عَذابِ القَبرِ، ويُحَلَّى حُلَّةَ الإيمانِ",2],"."],"grade":"حسن","narrator":"قيس الجذامي","muhaddith":"حسن","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"XHYs98OH"},{"id":"س-07718","fp":"73a4e31fbba3","stateId":644,"easy":"إذا استُشهدت في سبيل الله ← فزت ورب الكعبة","cause":"فضَرَبَه في جَنبِه حتى خَرَجَ مِنَ الشِّقِّ الآخَرِ","result":"فُزتُ ورَبِّ الكَعبةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-08430","otherNeedIds":[67],"ref":"عمدة التفسير 1/438","text":["في أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ الذين أرسَلَهم نَبيُّ اللهِ صلَّى اللهُ عليه وسلَّمَ إلى أهلِ بِئرِ مَعونةَ، قال: لا أدْري أربَعينَ أو سَبعينَ. وعلى ذلك الماءِ عامِرُ بنُ الطُّفَيلِ الجَعفَريُّ، فخَرَجَ أولئك النَّفَرُ مِن أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، حتى أتَوْا غارًا مُشرِفًا على الماءِ، فقَعَدوا فيه، ثم قال بَعضُهم لِبَعضٍ: أيُّكم يُبَلِّغُ رِسالةَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ أهلَ هذا الماءِ؟ فقال -أُراه ابنَ مِلحانَ الأنصاريَّ-: أنا أُبَلِّغُ رِسالةَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ. فخَرَجَ حتى أتى حَوَّاءَ منهم فاختَبَأ أمامَ البُيوتِ، ثم قال: يا أهلَ بِئرِ مَعونةَ، إنِّي رَسولُ رَسولِ اللهِ إليكم: أنِّي أشهَدُ أنْ لا إلهَ إلَّا اللهُ وأنَّ مُحمدًا عَبدُه ورَسولُه، فآمِنوا باللهِ ورَسولِه. فخَرَجَ إليه رَجُلٌ مِن كَسرِ البَيتِ برُمحٍ ",["فضَرَبَه في جَنبِه حتى خَرَجَ مِنَ الشِّقِّ الآخَرِ",1],". فقالَ: اللهُ أكبَرُ، ",["فُزتُ ورَبِّ الكَعبةِ",2],". فاتَّبَعوا أثَرَه حتى أتَوْا أصحابَه في الغارِ فقَتَلَهم أجمَعينَ عامِرُ بنُ الطُّفَيلِ. وقال ابنُ إسحاقَ: حَدَّثَني أنَسُ بنُ مالِكٍ أنَّ اللهَ أنزَلَ فيهم قُرآنًا: بَلِّغوا عَنَّا قَومَنا أنَّا قد لَقينا رَبَّنا فرَضيَ عنَّا ورَضينا عنه. ثم نُسِختْ فرُفِعتْ بَعدَما قَرأْناه زَمَنًا، وأنزَلَ اللهُ: {وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ} [آل عمران: 169]. وقد رَوى مُسلِمٌ عن مَسروقٍ قال: إنَّا سألْنا عَبدَ اللهِ عن هذه الآيةِ: {وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ} [آل عمران: 169]."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه السراج في ((المسند)) (1314)، والطبري في ((التفسير)) (8224)","bab":"قرآن › أسباب النزول","dorar":"Ca4orq1W"},{"id":"س-00554","fp":"aaf9986909ef","stateId":644,"easy":"إذا استُشهدت ← لا تجد من مس القتل إلا كالقرصة","cause":"الشَّهيدُ","result":"لا يَجِدَ مَسَّ القَتْلِ إلَّا كما يَجِدُ أحَدُكم القَرْصةَ يُقرَصُها","explicit":true,"ref":"الأحكام الوسطى 2/355","srcLabel":"الترمذي","text":[["الشَّهيدُ",1]," ",["لا يَجِدَ مَسَّ القَتْلِ إلَّا كما يَجِدُ أحَدُكم القَرْصةَ يُقرَصُها",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"سكت عنه [وقد قال في المقدمة: وإن لم تكن فيه علة كان سكوتي عنه دليلا على صحته]","takhrij":"أخرجه النسائي (3161) بلفظه، والترمذي (1668)، وابن ماجه (2802) باختلاف يسير.","bab":"آداب عامة › ضرب الأمثال","dorar":"pQAY4bqh","merged":3,"otherRefs":["صحيح الترغيب 1367 (صحيح)","تخريج شرح السنة 2630 (حسن)"]},{"id":"س-00643","fp":"31a77694f6d6","stateId":644,"easy":"إذا استُشهدت ← فمس السلاح أهون عليك من عضة نملة","cause":"الشَّهيدِ","result":"عَضَّةُ نَمْلةٍ أَشَدُّ على الشَّهيدِ مِن مَسِّ السِّلاحِ، بلْ هو أَشْهى عِنْدَه مِن شَرابٍ بارِدٍ لَذيذٍ في يَوْمٍ صائِفٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"الأحاديث المختارة 10 / 343","srcLabel":"متفق عليه","text":["«",["عَضَّةُ نَمْلةٍ أَشَدُّ على الشَّهيدِ مِن مَسِّ السِّلاحِ، بلْ هو أَشْهى عِنْدَه مِن شَرابٍ بارِدٍ لَذيذٍ في يَوْمٍ صائِفٍ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"آداب عامة › ضرب الأمثال","dorar":"xUmvH8u4"},{"id":"س-00641","fp":"a4256bfae109","stateId":645,"easy":"إذا مت بالطاعون ← فأنت شهيد","cause":"والمُتوَفَّوْنَ بالطاعونِ","result":"فهم شُهداءُ، فيَجِدونَهم كذلك","explicit":true,"otherNeedIds":[9],"ref":"إرشاد الساري 5/60","srcLabel":"أحمد","text":["يأتي الشُّهَداءُ ",["والمُتوَفَّوْنَ بالطاعونِ",1]," فيَقولُ أصحابُ الطاعونِ: نحن شُهَداءُ. فيُقالُ: انظُروا، فإنْ كان جِراحَتُهم كجِراحِ الشُّهَداءِ تَسيلُ دَمًا كريحِ المِسكِ ",["فهم شُهداءُ، فيَجِدونَهم كذلك",2],"."],"grade":"حسن","narrator":"عتبة بن عبد السلمي","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أحمد (17651)، والطبراني في ((المعجم الكبير)) (17/118) (292) واللفظ لهما.","bab":"آداب عامة › ضرب الأمثال","dorar":"RaWn0JzX","merged":2,"otherRefs":["الترغيب والترهيب 2/294 (حسن)"]},{"id":"س-03756","fp":"518e6c334162","stateId":645,"easy":"إذا قُتلت دون مالك ← فأنت شهيد","cause":"مَن قُتِلَ دونَ مالِه","result":"فهو شَهيدٌ","explicit":true,"star":true,"similar":["س-08016","س-04393","س-04516","س-04529","س-04530"],"ref":"صحيح مسلم 141","srcLabel":"متفق عليه","text":["أنَّه لَمَّا كانَ بينَ عبدِ اللهِ بنِ عَمرٍو وبينَ عَنبَسةَ بنِ أبي سُفيانَ ما كانَ تَيَسَّروا للقِتالِ، فرَكِبَ خالِدُ بنُ العاصِ إلى عبدِ اللهِ بنِ عَمرٍو فوعَظَه خالِدٌ، فقال عبدُ اللهِ بنُ عَمرٍو: أما عَلِمتَ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: ",["مَن قُتِلَ دونَ مالِه ",1],["فهو شَهيدٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2480)، ومسلم (141)","bab":"اعتصام بالسنة › نقل السنة وروايتها","dorar":"hytz8xdi","merged":9,"otherRefs":["تخريج المسند لشعيب 1639 (صحيح)","مجموع فتاوى ابن عثيمين 351/25 (صحيح)","صحيح الجامع 4172 (صحيح)","تخريج المسند لشاكر 11/188 (صحيح)","صحيح النسائي 4105 (صحيح)","الجامع الصغير 8899 (صحيح)","تخريج صحيح ابن حبان 3195 (صحيح)","تخريج شرح السنة 2564 (صحيح)"]},{"id":"س-04123","fp":"295f44f9896f","stateId":645,"easy":"إذا مت بالطاعون ← فهو شهادة لكل مسلم","cause":"الطَّاعونِ","result":"شَهادةٌ لكُلِّ مُسلِمٍ","explicit":true,"star":true,"similar":["س-04540","س-07899","س-02656","س-04108","س-04122","س-04539"],"otherNeedIds":[49,9],"ref":"صحيح البخاري 5732","srcLabel":"متفق عليه","text":["قال لي أنَسُ بنُ مالِكٍ رَضيَ اللهُ عنه: يَحيى بمَ ماتَ؟ قُلتُ: مِنَ ",["الطَّاعونِ",1],"، قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: الطَّاعونُ ",["شَهادةٌ لكُلِّ مُسلِمٍ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (2830)، ومسلم (1916)","bab":"جنائز وموت › الصبر على الأمراض والآلام والمصائب","dorar":"3V05EViU","merged":5,"otherRefs":["إرواء الغليل 6/72 (صحيح)","بذل الماعون 58 (صحيح)","تخريج المسند لشعيب 13335 (صحيح)","مجمع الزوائد 2/318 (حسن)"]},{"id":"س-04532","fp":"b55d731f116c","stateId":645,"easy":"إذا مت بالطعن أو البطن أو الغرق أو الهدم ← فأنت من الشهداء الخمسة","cause":"المَطعونُ، والمَبطونُ، والغَريقُ، وصاحِبُ الهَدمِ","result":"الشُّهَداءُ خَمسةٌ","explicit":true,"star":true,"otherNeedIds":[49],"ref":"صحيح البخاري 652","srcLabel":"متفق عليه","text":["بينَما رَجُلٌ يَمشي بطَريقٍ وجَدَ غُصنَ شَوكٍ على الطَّريقِ فأخَّرَه، فشَكَرَ اللهُ له فغَفَرَ له. ثُمَّ قال: ",["الشُّهَداءُ خَمسةٌ",2],": ",["المَطعونُ، والمَبطونُ، والغَريقُ، وصاحِبُ الهَدمِ",1],"، والشَّهيدُ في سَبيلِ اللهِ، وقال: لو يَعلَمُ النَّاسُ ما في النِّداءِ والصَّفِّ الأوَّلِ، ثُمَّ لَم يَجِدوا إلَّا أن يَستَهِموا لاستَهَموا عليه. ولو يَعلَمونَ ما في التَّهجيرِ لاستَبَقوا إليه، ولو يَعلَمونَ ما في العَتَمةِ والصُّبحِ لَأتَوْهما ولو حَبوًا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (652)، ومسلم (1914)","bab":"جهاد › فضل الشهيد","dorar":"DuXuhGJL","merged":4,"otherRefs":["تخريج صحيح ابن حبان 3188 (صحيح)","صحيح الجامع 3741 (صحيح)","صحيح الترغيب 1397 (صحيح)"]},{"id":"س-04541","fp":"25e356a69db3","stateId":645,"easy":"إذا غرقت ← فهي شهادة","cause":"والغَرَقُ","result":"شَهادةٌ","explicit":true,"star":true,"otherNeedIds":[49],"ref":"الأحاديث المختارة 8 / 253","srcLabel":"متفق عليه","text":["«أتاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وأنا مَريضٌ في ناسٍ مِن الأنْصارِ يَعودُني، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فسَكَتوا، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فسَكَتوا، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فقُلْتُ لامْرَأتي: أَسْنِديني، فأَسْنَدَتْني، فقُلْتُ: مَن أَسلَمَ ثُمَّ هاجَرَ ثُمَّ قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (إنَّ شُهَداءَ أمَّتي إذًا لَقَليلٌ! القَتْلُ في سَبيلِ اللهِ شَهادةٌ، والبَطْنُ شَهادةٌ، ",["والغَرَقُ",1]," ",["شَهادةٌ",2],"، والنُّفَساءُ شهادةٌ»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"aJWL2Cri","merged":3,"otherRefs":["صحيح الترغيب 1396 (صحيح)","صحيح النسائي 3194 (صحيح)"]},{"id":"س-04540","fp":"eb6ca9420bac","stateId":645,"easy":"إذا قُتلت في سبيل الله أو مت بالبطن ← فهي شهادة","cause":"القَتْلُ في سَبيلِ اللهِ شَهادةٌ، والبَطْنُ","result":"شَهادةٌ","explicit":true,"repOf":"س-04123","otherNeedIds":[9],"ref":"الأحاديث المختارة 8 / 253","text":["«أتاني رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ وأنا مَريضٌ في ناسٍ مِن الأنْصارِ يَعودُني، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فسَكَتوا، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فسَكَتوا، فقالَ: (هلْ تَدْرونَ ما الشَّهيدُ؟) فقُلْتُ لامْرَأتي: أَسْنِديني، فأَسْنَدَتْني، فقُلْتُ: مَن أَسلَمَ ثُمَّ هاجَرَ ثُمَّ قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: (إنَّ شُهَداءَ أمَّتي إذًا لَقَليلٌ! ",["القَتْلُ في سَبيلِ اللهِ شَهادةٌ، والبَطْنُ",1]," ",["شَهادةٌ",2],"، والغَرَقُ شَهادةٌ، والنُّفَساءُ شهادةٌ»)."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"جهاد › فضل الشهيد","dorar":"aJWL2Cri","merged":2,"otherRefs":["الجامع الصغير 6159 (صحيح)"]},{"id":"س-08016","fp":"af90d348f06a","stateId":645,"easy":"إذا أُريد مالك بغير حق فقُتلت دونه ← فأنت شهيد","cause":"مَن أُريدَ مالُه بغيرِ حقٍّ، فقُتِلَ دونَه","result":"فهو شهيدٌ","explicit":true,"repOf":"س-03756","ref":"تخريج المسند لشعيب 6823","text":[["مَن أُريدَ مالُه بغيرِ حقٍّ، فقُتِلَ دونَه؛ ",1],["فهو شهيدٌ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (4771)، والترمذي (1420) باختلاف يسير، وأخرجه البخاري (2480)، ومسلم (141) بنحوه مختصراً","bab":"مظالم › تحريم الظلم","dorar":"ouoFXaby"},{"id":"س-07899","fp":"14438c91e2e9","stateId":645,"easy":"إذا مت بالطاعون (وخز الجن) ← فهو لك شهادة","cause":"وَخْزُ إخْوانِكُم -أَوْ قالَ: أَعْدائكُمْ- مِنَ الجِنِّ","result":"وهو لَكُمْ شَهادَةٌ","explicit":true,"repOf":"س-04123","otherNeedIds":[9],"ref":"المستدرك على الصحيحين 159","text":["عنْ أَبي بَكْرِ بنِ أَبي موسى، عنْ أبيهِ قالَ: ذُكِرَ الطَّاعونُ عندَ أَبي موسى الأَشْعَريِّ، فقالَ أَبو موسى: سَأَلْنا عنه رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: «",["وَخْزُ إخْوانِكُم -أَوْ قالَ: أَعْدائكُمْ- مِنَ الجِنِّ",1],"، ",["وهو لَكُمْ شَهادَةٌ",2],"»."],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح على شرط مسلم","takhrij":"أخرجه أحمد (19708)، والروياني في ((المسند)) (514) واللفظ لهم.","bab":"مريض › فضل المرض والنوائب","dorar":"zmgAZG0Y","merged":2,"otherRefs":["فتح الباري لابن حجر 10/192 (صحيح)"]},{"id":"س-04502","fp":"8259c91f1aed","stateId":645,"easy":"إذا مت في الطاعون ← فأنت شهيد","cause":"ومَن ماتَ في الطَّاعونِ","result":"فهو شَهيدٌ","explicit":true,"star":true,"ref":"صحيح مسلم 1915","srcLabel":"مسلم","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في سَبيلِ اللهِ فهو شَهيدٌ، ",["ومَن ماتَ في الطَّاعونِ ",1],["فهو شَهيدٌ، ",2],"ومَن ماتَ في البَطنِ فهو شَهيدٌ. قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ومَن غَرِقَ فهو شَهيدٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB"},{"id":"س-04503","fp":"6463c84867a9","stateId":645,"easy":"إذا مت بداء البطن ← فأنت شهيد","cause":"ومَن ماتَ في البَطنِ","result":"فهو شَهيدٌ","explicit":true,"ref":"صحيح مسلم 1915","srcLabel":"مسلم","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في الطَّاعونِ فهو شَهيدٌ، ",["ومَن ماتَ في البَطنِ ",1],["فهو شَهيدٌ",2],". قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ومَن غَرِقَ فهو شَهيدٌ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB"},{"id":"س-04504","fp":"fa01a5002100","stateId":645,"easy":"إذا غرقت ← فأنت شهيد","cause":"ومَن غَرِقَ","result":"فهو شَهيدٌ","explicit":true,"ref":"صحيح مسلم 1915","srcLabel":"مسلم","text":["ما تَعُدُّونَ الشَّهيدَ فيكُم؟ قالوا: يا رَسولَ اللهِ، مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، قال: إنَّ شُهَداءَ أُمَّتي إذن لَقَليلٌ، قالوا: فمَن هُم يا رَسولَ اللهِ؟ قال: مَن قُتِلَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في سَبيلِ اللهِ فهو شَهيدٌ، ومَن ماتَ في الطَّاعونِ فهو شَهيدٌ، ومَن ماتَ في البَطنِ فهو شَهيدٌ. قال ابنُ مِقسَمٍ: أشهَدُ على أبيك في هذا الحَديثِ أنَّه قال: والغَريقُ شَهيدٌ. وفي روايةٍ: قال عُبَيدُ اللهِ بنُ مِقسَمٍ: أشهَدُ على أخيك أنَّه زادَ في هذا الحَديثِ: ",["ومَن غَرِقَ ",1],["فهو شَهيدٌ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1915)","bab":"جهاد › فضل الشهيد","dorar":"5O9qlOvB"},{"id":"س-07947","fp":"96d927173b15","stateId":645,"easy":"إذا مت مطعوناً أو غريقاً ← فأنت شهيد","cause":"المطعونُ شهيدٌ، والغَرِقُ","result":"شهيدٌ","explicit":true,"otherNeedIds":[9],"ref":"تخريج سنن أبي داود 3111","srcLabel":"النسائي","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ جاء يَعودُ عبدَ اللَّهِ بنَ ثابِتٍ، فوجدَهُ قد غُلِبَ، فصاحَ به رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ، فلَمْ يُجِبْهُ، فاسترجَعَ رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ، وقال: غُلِبْنَا عليكَ يا أبا الرَّبيعِ. فصاحَ النِّسوةُ وبَكَيْنَ، فجعَلَ ابنُ عَتيكٍ يُسْكِتُهُنَّ، فقال رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: دَعْهُنَّ، فإذا أَوْجَبَ فلا تَبْكِيَنَّ باكيةٌ. قالوا: وما الوجوبُ يا رسولَ اللَّهِ؟ قال: الموتُ. قالَتِ ابْنتُه: واللَّهِ، إنْ كُنتُ لَأَرْجو أنْ تكونَ شهيدًا؛ فإنَّكَ قد كُنتَ قَضَيْتَ جَهازَكَ، قال رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: إنَّ اللَّهَ قد أَوْقَعَ أجْرَهُ على قَدْرِ نِيَّتِهِ، وما تَعُدُّونَ الشَّهادةَ؟ قالوا: القَتلَ في سبيلِ اللَّهِ تعالى، قال رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ: الشَّهادةُ سَبْعٌ سِوى القتلِ في سبيلِ اللَّهِ: ",["المطعونُ شهيدٌ، والغَرِقُ",1]," ",["شهيدٌ",2],"، وصاحِبُ ذاتِ الجَنْبِ شهيدٌ، والمبطونُ شهيدٌ، وصاحِبُ الحريقِ شهيدٌ، والذي يَموتُ تحتَ الهَدْمِ شهيدٌ، والمرأةُ تموتُ بجُمْعٍ شهيدٌ."],"grade":"صحيح","narrator":"جابر بن عتيك","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1846)، ومالك (802) بلفظه.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"r2FXG2k6","merged":8,"otherRefs":["مجمع الزوائد 5/302 (حسن)","السلسلة الصحيحة 4/230 (حسن)","تخريج المسند لشعيب 22784 (صحيح)","أحكام الجنائز 53 (صحيح)","صحيح ابن ماجه 2279 (صحيح)","الأحاديث المختارة 8 / 290 (صحيح)","الأحاديث المختارة 8 / 254 (صحيح)"]},{"id":"س-02656","fp":"f10547a23690","stateId":645,"easy":"إذا مت بالطاعون ← فهو شهادة","cause":"والطَّاعونُ","result":"شهادةٌ","explicit":true,"repOf":"س-04123","otherNeedIds":[49],"ref":"صحيح الترغيب 1396","text":["أتعلَمون مَن الشَّهيدُ مِن أُمَّتِي ؟ فأرَمَّ القَومُ ، فقال عُبادةُ : سانِدُوني . فأسنَدوهُ ، فقالَ : يا رسولَ اللهِ ! الصَّابرُ المُحتَسبُ . فقال رسولُ اللهِ : إنَّ شُهداءَ أُمَّتِي إذًا لقَليلٌ ، القَتلُ في سبيلِ اللهِ عزَّ وجلَّ شَهادةٌ ، ",["والطَّاعونُ",1]," ",["شهادةٌ",2]," ، والغَرَقُ شهادةٌ ، والبَطنُ شهادةٌ ، والنُّفَساءُ يجرُّها ولدُها بسرَرِه إلى الجنَّةِ ، [ قال : وزادَ أبو العوامِ سادِنُ بيتِ المقدسِ : ] والحَرقُ ، والسُّلُّ"],"grade":"صحيح","narrator":"راشد بن حبيش","muhaddith":"حسن صحيح","takhrij":"أخرجه أحمد (16041)","bab":"إيمان › الاحتساب والنية","dorar":"0Rzsh73C","merged":4,"otherRefs":["إتحاف الخيرة المهرة 2/422 (حسن)","صحيح الترغيب 1403 (صحيح)","الجامع الصغير 5883 (صحيح)"]},{"id":"س-04108","fp":"4fdd58bd3ad6","stateId":645,"easy":"إذا مت بداء البطن ← فهو شهادة","cause":"والبطنَ","result":"شهادةٌ","explicit":true,"repOf":"س-04123","otherNeedIds":[49],"ref":"مجمع الزوائد 5/303","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عاد ابنَ أخي جبرٍ الأنصاريِّ فجعل أهلُه يَبكون عليه فقال لهم جبرٌ لا تُؤذوا رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بأصواتِكم فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ دَعْهنَّ يَبكينَ ما دام حيًّا فإذا وجَب فلْيَسْكُتُنَّ فقال بعضُهم ما كنا نرى أنْ يكونَ موتُك على فراشِك حتى تُقتَلَ في سبيلِ اللهِ مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ أو ما الشهادةُ إلا القتلُ في سبيلِ اللهِ ؛ إنَّ شهداءَ أُمَّتي إذًا لقليلٌ إنَّ الطَّعنَ شهادةٌ ",["والبطنَ",1]," ",["شهادةٌ",2]," والطاعونَ والنُّفَساءَ بجَمْعٍ شهداءُ والحَرِقَ شهادةٌ والغَرِقَ والهَدمَ شهادةٌ وذاتَ الجنبِ شهادةٌ"],"grade":"صحيح","narrator":"ربيع الأنصاري","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني (5/68) (4607)","bab":"جنائز وموت › البكاء على الميت","dorar":"aOa6w0se","merged":3,"otherRefs":["صحيح الترغيب 1396 (صحيح)","صحيح النسائي 3194 (صحيح)"]},{"id":"س-00296","fp":"527cc00021ee","stateId":645,"easy":"إذا عشقت فعففت وكتمت ومت ← مت شهيداً","cause":"من عشِقَ وعفَّ وكتم وماتَ","result":"مات شهيدًا","explicit":true,"ref":"عمدة القاري 14/179","srcLabel":"عمدة القاري","text":[["من عشِقَ وعفَّ وكتم وماتَ ",1],["مات شهيدًا",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"s7pMUF77"},{"id":"س-04122","fp":"5fb7720b0753","stateId":645,"easy":"إذا مت بالطاعون أو البطن أو الغرق أو النفاس ← فهو شهادة","cause":"الطاعونُ، والبَطْنُ، والغَرَقُ، والنُّفَساءُ","result":"شَهادةٌ","explicit":true,"repOf":"س-04123","ref":"تخريج المسند لشعيب 15301","text":[["الطاعونُ، والبَطْنُ، والغَرَقُ، والنُّفَساءُ",1]," ",["شَهادةٌ",2],"."],"grade":"صحيح","narrator":"صفوان بن أمية","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (2054)، وأحمد (15301) واللفظ له","bab":"جنائز وموت › الصبر على الأمراض والآلام والمصائب","dorar":"MxIlQcaI"},{"id":"س-04393","fp":"582396f7805d","stateId":645,"easy":"إذا قُتلت دون أهلك أو دمك أو دينك ← فأنت شهيد","cause":"ومن قُتِلَ دونَ أهلِه","result":"فهو شهيدٌ، أو دونَ دَمِهِ، أو دونَ دينهِ، فهو شهيدٌ","explicit":true,"repOf":"س-03756","ref":"مجموع فتاوى ابن عثيمين 351/25","text":["من قُتِلَ دونَ مالِه فهو شهيدٌ، ",["ومن قُتِلَ دونَ أهلِه ",1],["فهو شهيدٌ، أو دونَ دَمِهِ، أو دونَ دينهِ، فهو شهيدٌ",2]],"grade":"صحيح","muhaddith":"[ثابت]","bab":"جهاد › الشجاعة في الحرب والجبن","dorar":"al02WQHJ"},{"id":"س-04510","fp":"9a7bcae5c569","stateId":645,"easy":"إذا ترديت من رؤوس الجبال أو أكلتك السباع أو غرقت (في الجهاد) ← فأنت شهيد عند الله","cause":"أنَّ من يتردَّى من رؤوسِ الجبالِ وتأكلُه السباعُ ويغرَقُ في البحارِ","result":"لشهيدٌ عند اللهِ","explicit":true,"otherNeedIds":[9],"ref":"فتح الباري لابن حجر 52/6","srcLabel":"فتح الباري لابن حجر","text":[["أنَّ من يتردَّى من رؤوسِ الجبالِ وتأكلُه السباعُ ويغرَقُ في البحارِ",1]," ",["لشهيدٌ عند اللهِ",2]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"جهاد › فضل الشهيد","dorar":"ZgnDDm5f"},{"id":"س-04515","fp":"f247b25af4e0","stateId":645,"easy":"إذا وقع عليك البيت ← فأنت شهيد","cause":"ومَنْ يقَعُ عليه البيتُ","result":"فهو شهيدٌ","explicit":true,"ref":"صحيح الجامع 4172","srcLabel":"ابن عساكر","text":["الغَريقُ شهيدٌ ، و الحَريقُ شهيدٌ ، . . . . . . . . . . . و المبْطونُ شهيدٌ ، ",["ومَنْ يقَعُ عليه البيتُ ",1],["فهو شهيدٌ ، ",2],". . . . . . . ومَنْ قُتِلَ دُونَ مالِهِ فهو شهيدٌ ، ومَنْ قُتِلَ دُونَ نفسِهِ فهو شهيدٌ . . . . . . . . . . . . . . . ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (53/166)","bab":"جهاد › فضل الشهيد","dorar":"wdwrd8v7"},{"id":"س-04516","fp":"dd5a0280bc33","stateId":645,"easy":"إذا قُتلت دون نفسك ← فأنت شهيد","cause":"ومَنْ قُتِلَ دُونَ نفسِهِ","result":"فهو شهيدٌ","explicit":true,"repOf":"س-03756","ref":"صحيح الجامع 4172","text":["الغَريقُ شهيدٌ ، و الحَريقُ شهيدٌ ، . . . . . . . . . . . و المبْطونُ شهيدٌ ، ومَنْ يقَعُ عليه البيتُ فهو شهيدٌ ، . . . . . . . ومَنْ قُتِلَ دُونَ مالِهِ فهو شهيدٌ ، ",["ومَنْ قُتِلَ دُونَ نفسِهِ ",1],["فهو شهيدٌ ",2],". . . . . . . . . . . . . . . ."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"صحيح","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (53/166)","bab":"جهاد › فضل الشهيد","dorar":"wdwrd8v7"},{"id":"س-04522","fp":"fac0e96003dc","stateId":645,"easy":"إذا مت بذات الجنب ← فأنت شهيد","cause":"الميِّتُ مِن ذاتِ الجَنبِ","result":"شَهيدٌ","explicit":true,"otherNeedIds":[9],"ref":"صحيح الجامع 6738","srcLabel":"أحمد","text":[["الميِّتُ مِن ذاتِ الجَنبِ",1]," ",["شَهيدٌ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17470)، والروياني في ((مسنده)) (198)، والطبراني (17/318) (881)","bab":"جهاد › فضل الشهيد","dorar":"oKwL5C8U"},{"id":"س-04529","fp":"26119d69b2a3","stateId":645,"easy":"إذا قاتلت دون دمك فقُتلت ← فأنت شهيد","cause":"ومن قاتل دونَ دمِه","result":"فهو شهيدٌ","explicit":true,"repOf":"س-03756","otherNeedIds":[48],"ref":"صحيح النسائي 4105","text":["من قاتل دون مالِه، فقُتل فهو شهيدٌ، ",["ومن قاتل دونَ دمِه",1],"، ",["فهو شهيدٌ",2],"، ومن قاتل دونَ أهلِه، فهو شهيدٌ"],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4772)، والترمذي (1421)، والنسائي (4094) واللفظ لهم.","bab":"جهاد › فضل الشهيد","dorar":"2xGUSilo"},{"id":"س-04530","fp":"9a23cca81012","stateId":645,"easy":"إذا قاتلت دون أهلك فقُتلت ← فأنت شهيد","cause":"ومن قاتل دونَ أهلِه","result":"فهو شهيدٌ","explicit":true,"repOf":"س-03756","otherNeedIds":[48],"ref":"صحيح النسائي 4105","text":["من قاتل دون مالِه، فقُتل فهو شهيدٌ، ومن قاتل دونَ دمِه، فهو شهيدٌ، ",["ومن قاتل دونَ أهلِه",1],"، ",["فهو شهيدٌ",2]],"grade":"صحيح","narrator":"سعيد بن زيد","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (4772)، والترمذي (1421)، والنسائي (4094) واللفظ لهم.","bab":"جهاد › فضل الشهيد","dorar":"2xGUSilo"},{"id":"س-04535","fp":"bf4495eb2684","stateId":645,"easy":"إذا ماتت المرأة في نفاسها ← فهي شهادة","cause":"والنُّفساءُ","result":"شهادةٌ","explicit":true,"similar":["س-07938"],"ref":"الأحكام الشرعية الصغرى 481","srcLabel":"الطبراني","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم وذكر الشُّهداءَ قال : ",["والنُّفساءُ",1]," ",["شهادةٌ",2]],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه الطيالسي (583)، والبيهقي في ((شعب الإيمان)) (9413) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (9314) مطولا بنحوه.","bab":"جهاد › فضل الشهيد","dorar":"edQzP4nK"},{"id":"س-04539","fp":"09853c7c347f","stateId":645,"easy":"إذا مت بالطعن أو الطاعون أو الهدم أو السبع أو الغرق أو الحرق أو البطن أو ذات الجنب ← فهي شهادة","cause":"الطَّعنُ والطَّاعونُ، والهَدمُ وأكلُ السَّبُعِ، والغَرَقُ والحَرَقُ، والبَطنُ وذاتُ الجَنبِ","result":"شَهادةٌ","explicit":true,"repOf":"س-04123","ref":"فيض القدير 4/ 289","text":[["الطَّعنُ والطَّاعونُ، والهَدمُ وأكلُ السَّبُعِ، والغَرَقُ والحَرَقُ، والبَطنُ وذاتُ الجَنبِ",1],": ",["شَهادةٌ",2]],"grade":"صحيح","narrator":"ربيع الأنصاري","muhaddith":"[صحيح]","bab":"جهاد › فضل الشهيد","dorar":"Q4DiitnD"},{"id":"س-04673","fp":"ce559d67ea3f","stateId":645,"easy":"إذا مت مريضاً ← مت شهيداً ووُقيت عذاب القبر","cause":"مَنْ ماتَ مريضًا","result":"مات شهيدًا ووُقِيَ عذابَ القبرِ وغُدِيَ ورِيحَ عليهِ برزقِهِ مِنَ الجنةِ","explicit":true,"otherNeedIds":[63,66],"ref":"إتقان ما يحسن 2/632","srcLabel":"ابن ماجه","text":[["مَنْ ماتَ مريضًا ",1],["مات شهيدًا ووُقِيَ عذابَ القبرِ وغُدِيَ ورِيحَ عليهِ برزقِهِ مِنَ الجنةِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح قيل وهو تصحيف وإنما هو من مات مرابطا","takhrij":"أخرجه ابن ماجه (1615)، والبزار (8775)، وأبو يعلى (6145) باختلاف يسير.","bab":"دفن ومقابر › عذاب القبر ونعيمه","dorar":"RP0WPNBv"},{"id":"س-07938","fp":"3ccd799a610e","stateId":645,"easy":"إذا ماتت المرأة بولدها في بطنها ← فهي شهادة يجرها ولدها إلى الجنة","cause":"والمرأةُ يقتلُها ولدُها جَمعاءَ","result":"شَهادةٌ، يَجُرُّها ولدُها بسَررِهِ إلى الجنَّةِ","explicit":true,"repOf":"س-04535","otherNeedIds":[9,67],"ref":"أحكام الجنائز 53","text":["أنَّ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ: عادَ عبدَ اللَّهِ بنَ رواحةَ قالَ: فما تحوَّزَ لهُ عن فراشِهِ ، فقالَ: أتدري مَن شُهَداءُ أمَّتي ؟ قالوا: قتلُ المسلِمِ شَهادةٌ. قالَ: إنَّ شُهَداءَ أمَّتي إذًا لقليلٌ قتلُ المسلِمِ شَهادَةٌ، والطَّاعونُ شَهادةٌ، ",["والمرأةُ يقتلُها ولدُها جَمعاءَ",1]," ",["شَهادةٌ، يَجُرُّها ولدُها بسَررِهِ إلى الجنَّةِ",2],"."],"grade":"صحيح","narrator":"عبادة بن الصامت","muhaddith":"إسناده صحيح وله طرق أخرى","takhrij":"أخرجه الطيالسي (583)، والبيهقي في ((شعب الإيمان)) (9413) واللفظ لهما، والطبراني في ((المعجم الأوسط)) (9314) مطولا بنحوه.","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"uHoJvHlZ"},{"id":"س-07672","fp":"5904b8d6b235","stateId":645,"easy":"إذا مت بالطاعون ← تُلحق بالشهداء","cause":"الذين ماتوا مِنَ الطاعونِ","result":"فيُلْحَقونَ معهم","explicit":true,"otherNeedIds":[48],"ref":"تخريج المسند لشعيب 17164","srcLabel":"النسائي","text":["يَختصِمُ الشهداءُ والمُتَوَفَّوْنَ على فُرُشِهم إلى اللهِ عزَّ وجلَّ في ",["الذين ماتوا مِنَ الطاعونِ",1],"، فيقولُ الشهداءُ: إخوانُنا قُتِلوا، ويقولُ المُتَوَفَّوْنَ على فُرُشِهم: إخوانُنا ماتوا على فُرُشِهم كما مِتْنا، فيَقْضي اللهُ عزَّ وجلَّ بيْنهم: أنِ انظُروا إلى جِراحاتِ المَطْعونينَ؛ فإنْ أَشبَهَتْ جِراحاتِ الشهداءِ فهُم منهم. فيَنظُرونَ إلى جِراحِ المَطْعونينَ فإذا هي قد أَشبَهَتْ، ",["فيُلْحَقونَ معهم",2],"."],"grade":"حسن","narrator":"العرباض بن سارية","muhaddith":"حسن لغيره","takhrij":"أخرجه النسائي (3164)، وأحمد (17164) واللفظ له","bab":"قدر › العمل بالخواتيم","dorar":"bWp5ZRLQ","merged":2,"otherRefs":["تخريج المسند لشعيب 17159 (حسن)"]},{"id":"س-04124","fp":"86e4dfb07e2a","stateId":645,"easy":"إذا أقمت في بلد الطاعون صابراً ← تكون مرابطاً، وإن أُصبت به كنت شهيداً","cause":"من أقام عليها كان مُرابطًا","result":"ومن أُصِيب به كان شهيدًا","explicit":true,"ref":"صحيح الترغيب 1408","srcLabel":"أبو يعلى","text":["وَخْزةٌ تُصيب أُمَّتي من أعدائِهم من الجنِّ كغُدَّةِ الإبلِ ، ",["من أقام عليها كان مُرابطًا ، ",1],["ومن أُصِيب به كان شهيدًا ، ",2],"ومن فَرَّ منه كان كالفارِّ من الزَّحفِ ."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو يعلى (4664)","bab":"جنائز وموت › الصبر على الأمراض والآلام والمصائب","dorar":"FD7lZQUr"},{"id":"س-04376","fp":"0a935eb3c471","stateId":645,"easy":"إذا صبرت في أرض الطاعون ← فأنت كالشهيد","cause":"المُقيمُ به","result":"كالشَّهيدِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[9],"ref":"إرواء الغليل 1638","srcLabel":"أحمد","text":["غُدَّةٌ كغُدَّةِ البَعيرِ ، ",["المُقيمُ به",1]," ",["كالشَّهيدِ",2]," ، والفارُّ منه كالفارِّ مِن الزَّحْفِ [ أيِ الطَّاعونِ ]"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح","takhrij":"أخرجه أحمد (25118) بلفظه تامًا، وأبو يعلى (4408) باختلاف يسير تامًا، وابن الأعرابي في ((معجمه)) (2456) بنحوه تامًا.","bab":"جهاد › التولي والفرار من الزحف","dorar":"bIOuBz7i","merged":2,"otherRefs":["صحيح الجامع 3948 (صحيح)"]},{"id":"س-04370","fp":"18384622caf0","stateId":645,"easy":"إذا مت بالقتل أو الطعن أو الغرق أو البطن أو النفاس ← تكون شهيداً","cause":"بالقتلِ والطعنِ والغرقِ والبطنِ وموتِ المرأةِ جمعًا","result":"يستشهدونَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"بذل الماعون 104","srcLabel":"البزار","text":[["يستشهدونَ",2]," ",["بالقتلِ والطعنِ والغرقِ والبطنِ وموتِ المرأةِ جمعًا",1]," موتُها في نفاسِها"],"grade":"حسن","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده قوي","takhrij":"أخرجه البزار (4/ 16)، وعبد بن حميد (154)، وابن أبي شيبة كما في ((المطالب العالية)) (1920) باختلاف يسير.","bab":"جهاد › الترغيب في الجهاد","dorar":"3BorIG4k"},{"id":"س-00458","fp":"0ab6bd96927a","stateId":646,"easy":"إذا توضأت عند نومك واضطجعت على شقك الأيمن وقلت دعاء النوم ← إن مت من ليلتك مت على الفطرة","cause":"إذا أتَيتَ مَضجَعَكَ فتَوضَّأْ وُضوءَكَ للصَّلاةِ، ثُمَّ اضطَجِعْ على شِقِّكَ الأيمَنِ، ثُمَّ قُلْ: اللهُمَّ أسلَمتُ وجهي إليكَ، وفَوَّضتُ أمري إليكَ، وألجَأتُ ظَهري إليكَ، رَغبةً ورَهبةً إليكَ، لا مَلجَأَ ولا مَنجا مِنكَ إلَّا إليكَ، اللهُمَّ آمَنتُ بكِتابِكَ الذي أنزَلتَ، وبِنَبيِّكَ الذي أرسَلتَ","result":"فإن مُتَّ مِن لَيلَتِكَ فأنتَ على الفِطرةِ","explicit":true,"star":true,"ref":"صحيح البخاري 247","srcLabel":"متفق عليه","text":[["إذا أتَيتَ مَضجَعَكَ فتَوضَّأْ وُضوءَكَ للصَّلاةِ، ثُمَّ اضطَجِعْ على شِقِّكَ الأيمَنِ، ثُمَّ قُلْ: اللهُمَّ أسلَمتُ وجهي إليكَ، وفَوَّضتُ أمري إليكَ، وألجَأتُ ظَهري إليكَ، رَغبةً ورَهبةً إليكَ، لا مَلجَأَ ولا مَنجا مِنكَ إلَّا إليكَ، اللهُمَّ آمَنتُ بكِتابِكَ الذي أنزَلتَ، وبِنَبيِّكَ الذي أرسَلتَ",1],"، ",["فإن مُتَّ مِن لَيلَتِكَ فأنتَ على الفِطرةِ",2],"، واجعَلْهنَّ آخِرَ ما تَتَكَلَّمُ به. قال: فرَدَّدتُها على النَّبيِّ صلَّى اللهُ عليه وسلَّم، فلَمَّا بَلَغتُ: اللهُمَّ آمَنتُ بكِتابِكَ الذي أنزَلتَ قُلتُ: ورَسولِكَ، قال: لا، ونَبيِّكَ الذي أرسَلتَ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (247)، ومسلم (2710)","bab":"آداب عامة › التيمن والبدء بجهة اليمين","dorar":"aLt7xS4d","merged":3,"otherRefs":["تخريج مشكل الآثار 1139 (صحيح)","صحيح مسلم 2710 (صحيح)"]},{"id":"س-07001","fp":"fe83ffc47c9b","stateId":646,"easy":"إذا سرّك أن تلقى الله غداً مسلماً ← فحافظ على الصلوات المكتوبات حيث يُنادى بهن","cause":"فلْيُحافِظْ على هؤلاء الصَّلواتِ المَكتوباتِ حيث يُنادى بهنَّ","result":"مَن سَرَّه أنْ يَلقى اللهَ عزَّ وجلَّ غدًا مُسلمًا","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 3623","srcLabel":"مسلم","text":[["مَن سَرَّه أنْ يَلقى اللهَ عزَّ وجلَّ غدًا مُسلمًا؛ ",2],["فلْيُحافِظْ على هؤلاء الصَّلواتِ المَكتوباتِ حيث يُنادى بهنَّ",1],"؛ فإنِّهنَّ مِن سُنَنِ الهُدى، وإنَّ اللهَ عزَّ وجلَّ شرَعَ لنبيِّكم سُنَنَ الهُدى، وما منكم إلَّا وله مَسجدٌ في بيتِه، ولو صلَّيْتُم في بُيوتِكم، كما يُصلِّي هذا المُتخلِّفُ في بيتِه؛ لترَكْتم سُنَّةَ نبيِّكم، ولو ترَكْتم سُنَّةَ نبيِّكم لضلَلْتم، ولقد رأَيْتُني وما يَتخلَّفُ عنها إلَّا مُنافقٌ مَعلومٌ نِفاقُه، ولقد رأَيْتُ الرَّجُلَ يُهادَى بينَ الرَّجُلَينِ حتى يُقامَ في الصَّفِّ، وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: \"ما مِن رَجُلٍ يَتوضَّأُ، فيُحسِنُ الوُضوءَ، ثُمَّ يأْتي مَسجدًا مِن المَساجدِ، فيَخطو خُطوةً؛ إلَّا رُفِعَ بها دَرجةً، أو حُطَّ عنه بها خَطيئةً، أو كُتِبَتْ له بها حسنةً\"، حتى إنْ كنَّا لَنُقارِبُ بينَ الخُطى، \"وإنَّ فَضلَ صلاةِ الرَّجُلِ في جَماعةٍ على صلاتِه وَحده، بخَمسٍ وعشرينَ دَرجةً\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه مسلم (654)، وأبو داود (550)، والنسائي (849)، وابن ماجه (777) مختصراً، وأحمد (3623) واللفظ له","bab":"علم › الحث على الأخذ بالسنة","dorar":"DwsVWYgX","merged":3,"otherRefs":["صحيح ابن ماجه 638 (صحيح)","صحيح النسائي 848 (صحيح)"]},{"id":"س-00766","fp":"322d20bb19d0","stateId":646,"easy":"إذا قلت دعاء النوم ثم مت من ليلتك ← مت على الفطرة","cause":"مَنْ قالهُنَّ ثُمَّ ماتَ تَحْتَ لَيْلَتِه","result":"ماتَ على الفِطْرَةِ","explicit":true,"star":true,"similar":["س-00911"],"ref":"صحيح الأدب المفرد 920","srcLabel":"متفق عليه","text":["اللهمَّ أَسْلمْتُ نَفسي إليكَ ، و وجَّهْتُ وجْهِي إليكَ ، و فَوَّضْتُ أَمْرِي إليكَ ، و أَلْجَأْتُ ظَهْرِي إليكَ ، رَغْبَةً و رَهْبَةً إليكَ ، لا مَنْجَا و لا مَلْجَأَ مِنْكَ إلَّا إليكَ ، آمَنْتُ بِكتابِكَ الذي أنْزَلْتَ ، و بِنبيِّكَ الذي أَرْسَلْتَ ، قال رسولُ اللهِ : ",["مَنْ قالهُنَّ ثُمَّ ماتَ تَحْتَ لَيْلَتِه ",1],["ماتَ على الفِطْرَةِ",2]],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه البخاري في ((الأدب المفرد)) (1213) واللفظ له، وأصله في صحيح البخاري (6315)، ومسلم (2710) باختلاف يسير","bab":"أدعية وأذكار › الحث على ذكر الله تعالى","dorar":"2QXFrCuc"},{"id":"س-00911","fp":"6367d46856c9","stateId":646,"easy":"إذا قلت دعاء النوم «اللهم أسلمت نفسي إليك...» ← إن مت مت على الفطرة وإن أصبحت أصبت خيراً","cause":"إذا أويتَ إلى فِراشِكَ... بمِثلِ حَديثِ عَمرِو بنِ مُرَّةَ، غيرَ أنَّه قال: وبنَبيِّكَ الذي أرسَلتَ","result":"فإن مُتَّ مِن لَيلَتِكَ مُتَّ على الفِطرةِ، وإن أصبَحتَ أصَبتَ خَيرًا","explicit":true,"apply":{"k":"say","t":"«اللهم أسلمت نفسي إليك...»"},"repOf":"س-00766","ref":"صحيح مسلم 2710","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم لرَجُلٍ: يا فُلانُ، ",["إذا أويتَ إلى فِراشِكَ... بمِثلِ حَديثِ عَمرِو بنِ مُرَّةَ، غيرَ أنَّه قال: وبنَبيِّكَ الذي أرسَلتَ",1],"، ",["فإن مُتَّ مِن لَيلَتِكَ مُتَّ على الفِطرةِ، وإن أصبَحتَ أصَبتَ خَيرًا",2],". وفي روايةٍ: أمَرَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَجُلًا بمِثلِه، ولم يَذكُرْ: وإن أصبَحتَ أصَبتَ خَيرًا."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (247)، ومسلم (2710).","bab":"أدعية وأذكار › فضل الذكر","dorar":"D8YfvQg9"},{"id":"س-03648","fp":"4931e2a4013b","stateId":646,"easy":"إذا مت محرماً ← تُبعث يوم القيامة ملبّياً","cause":"وهو مُحرِمٌ، فوقَعَ مِن ناقَتِه فأقعَصَتْه","result":"فإنَّه يُبعَثُ يَومَ القيامةِ مُلَبِّدًا","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"otherNeedIds":[65],"ref":"صحيح مسلم 1206","srcLabel":"البخاري","text":["أنَّه سَمِعَ ابنَ عَبَّاسٍ رَضيَ اللهُ عنهما يُحَدِّثُ أنَّ رَجُلًا أتى النَّبيَّ صلَّى اللهُ عليه وسلَّم ",["وهو مُحرِمٌ، فوقَعَ مِن ناقَتِه فأقعَصَتْه",1],"، فأمَرَ النَّبيُّ صلَّى اللهُ عليه وسلَّم أن يُغسَلَ بماءٍ وسِدرٍ، وأن يُكَفَّنَ في ثَوبَينِ، ولا يُمَسَّ طيبًا، خارِجٌ رَأسُه. قال شُعبةُ: ثُمَّ حدَّثَني به بَعدَ ذلك: خارِجٌ رَأسُه ووجهُه؛ ",["فإنَّه يُبعَثُ يَومَ القيامةِ مُلَبِّدًا",2],"."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1265) باختلاف يسير","bab":"اعتصام بالسنة › أوامر النبي ونواهيه وتقريراته","dorar":"TI245Fag","merged":10,"otherRefs":["صحيح مسلم 1206 (صحيح)","صحيح أبي داود 3239 (صحيح)","تخريج صحيح ابن حبان 3957 (صحيح)","تخريج مشكل الآثار 256 (صحيح)","صحيح النسائي 2857 (صحيح)","تخريج المسند لشاكر 4/126 (صحيح)","تخريج المسند لشعيب 3076 (صحيح)","تخريج سنن الدارقطني 2769 (صحيح)"]},{"id":"س-07080","fp":"a9bdcaa7fd5c","stateId":646,"easy":"إذا قلت كلمات النوم عند فراشك ← إن مت من ليلتك مت على الفطرة وإن أصبحت أصبت خيراً","cause":"كلِماتٍ تقولُها إذا أويتَ إلى فراشِكَ ، فإن مِتَّ من ليلتِكَ مِتَّ على الفِطرةِ ، وإن أصبحتَ أصبحتَ وقد أصبتَ خيرًا ، تقولُ : اللَّهمَّ أسلَمتُ نفسي إليكَ ، ووَجَّهتُ وجهي إليكَ ، وفوَّضتُ أمري إليكَ ، رغبةً ورَهْبةً إليكَ ، وألجَأتُ ظَهْري إليكَ ، لا ملجأَ ولا مَنجى منكَ إلَّا إليكَ ، آمنتُ بِكِتابِكَ الَّذي أنزلتَ ونبيِّكَ الَّذي أرسلتَ","result":"فإن مِتَّ من ليلتِكَ مِتَّ على الفِطرةِ ، وإن أصبحتَ أصبحتَ وقد أصبتَ خيرًا","explicit":true,"star":true,"ref":"صحيح الترمذي 3394","srcLabel":"متفق عليه","text":["أنَّ النَّبيَّ صلَّى اللَّهُ علَيهِ وسلَّمَ قال له ألا أعلِّمُكَ ",["كلِماتٍ تقولُها إذا أويتَ إلى فراشِكَ ، ",1],["فإن مِتَّ من ليلتِكَ مِتَّ على الفِطرةِ ، وإن أصبحتَ أصبحتَ وقد أصبتَ خيرًا",2],[" ، تقولُ : اللَّهمَّ أسلَمتُ نفسي إليكَ ، ووَجَّهتُ وجهي إليكَ ، وفوَّضتُ أمري إليكَ ، رغبةً ورَهْبةً إليكَ ، وألجَأتُ ظَهْري إليكَ ، لا ملجأَ ولا مَنجى منكَ إلَّا إليكَ ، آمنتُ بِكِتابِكَ الَّذي أنزلتَ ونبيِّكَ الَّذي أرسلتَ",1]," قالَ البراءُ : فقلتُ : وبرسولِكَ الَّذي أرسلتَ ، قالَ : فطَعنَ بيدِهِ في صدري ، ثمَّ قالَ : ونبيِّكَ الَّذي أرسلتَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3394) واللفظ له، والبخاري (7488)، ومسلم (2710)، وأبو داود (5046) باختلاف يسير.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"Sar3ZDE6"},{"id":"س-07678","fp":"930409c40e4f","stateId":646,"easy":"إذا تحولت قبل موتك فعملت بعمل أهل الجنة ← تدخل الجنة","cause":"فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ بعمَلِ أهلِ الجَنَّةِ","result":"فمات، فدخَلَ الجَنَّةَ","explicit":true,"ref":"تخريج المسند لشعيب 13695","srcLabel":"مسلم","text":["إنَّ الرَّجُلَ لَيَعمَلُ البُرْهةَ مِن عُمُرِه بالعمل الذي لو مات عليه دخَلَ الجَنَّةَ، فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ عمَلَ أهلِ النارِ، فمات، فدخَلَ النارَ. وإنَّ الرَّجُلَ لَيَعمَلُ البُرْهةَ مِن عُمُرِه بالعملِ الذي لو مات عليه دخَلَ النارَ، ",["فإذا كان قبْلَ مَوتِه تَحَوَّلَ فعمِلَ بعمَلِ أهلِ الجَنَّةِ",1],"، ",["فمات، فدخَلَ الجَنَّةَ",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح على شرط مسلم","takhrij":"أخرجه أحمد (13695)، وأبو يعلى (3829)، والطبراني في ((المعجم الأوسط)) (6428)","bab":"قدر › العمل بالخواتيم","dorar":"HbnkgKES"},{"id":"س-01928","fp":"f615c876ffa1","stateId":646,"easy":"إذا تصدقت ← تمنع عنك ميتة السوء","cause":"الصدقةُ","result":"تمنعُ ميتةَ السوءِ","explicit":true,"otherNeedIds":[31],"ref":"الجامع الصغير 5126","srcLabel":"ابن زنجوية","text":[["الصدقةُ",1]," ",["تمنعُ ميتةَ السوءِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن زنجوية في ((الأموال)) (1308 )، والسهمي في ((تاريخ جرجان)) (496)، والقضاعي في ((مسند الشهاب)) (98 )","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"qcelb53G","merged":2,"otherRefs":["مجمع الزوائد 8/140 (حسن)"]},{"id":"س-01482","fp":"b955ffe817fa","stateId":646,"easy":"إذا استطعت ألا تنام إلا على طهارة ← فإن مت مت شهيداً","cause":"فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ","result":"فإنَّكَ إن مِتَّ مِتَّ شهيدًا","explicit":true,"ref":"الضعفاء الكبير 1/148","srcLabel":"البزار","text":["يا أَنَسُ، أسبِغِ الوضوءَ يَزِدْ في عُمُرِكَ، وصَلِّ مِن اللَّيلِ والنَّهارِ ما استطَعْتَ يُحِبَّكَ الحَفَظَةُ، وصَلِّ صلاةَ الضُّحى؛ فإنَّها صلاةُ الأوَّابينَ، ",["فإنِ استطَعْتَ ألَّا تنامَ إلَّا على طهارةٍ",1],"، ",["فإنَّكَ إن مِتَّ مِتَّ شهيدًا",2],"، وسلِّمْ على أهلِ بيتِكَ يكثُرْ خيرُ بيتِكَ، ووقِّرِ الكبيرَ، وارحَمِ الصَّغيرَ، تُرافِقْني في الجنَّةِ."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"ليس لهذا المتن عن أنس إسناد صحيح","takhrij":"أخرجه البزار (7396)، وأبو يعلى (4183)، والعقيلي في ((الضعفاء الكبير)) (1/148) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"CfQ83tTb"},{"id":"س-03913","fp":"d9df5779a43c","stateId":646,"easy":"إذا عدلت في وصيتك ← يُختم لك بخير عملك فتدخل الجنة","cause":"فيَعدِلُ في وَصيَّتِه","result":"فيُخْتَمُ له بخيرِ عَملِه، فيَدخُلُ الجنَّةَ","explicit":true,"otherNeedIds":[67],"ref":"تخريج المسند لشاكر 14/163","srcLabel":"أبو داود","text":["إنَّ الرَّجُلَ لَيَعمَلُ بعَمَلِ أهْلِ الخَيرِ سَبعينَ سَنةً، فإذا أَوصى حافَ في وَصيَّتِه، فيُختَمُ له بِشَرِّ عَملِهِ، فيَدخُلُ النَّارَ، وإنَّ الرَّجُلَ لَيَعمَلُ بعَملِ أهلِ الشَّرِّ سَبعينَ سَنةً، ",["فيَعدِلُ في وَصيَّتِه",1],"، ",["فيُخْتَمُ له بخيرِ عَملِه، فيَدخُلُ الجنَّةَ",2],". قال: ثمَّ يقولُ أبو هُريرةَ: واقْرَؤوا إنْ شِئتُم: {تِلْكَ حُدُودُ اللَّهِ} إلى قَولِه: {وَلَهُ عَذَابٌ مُهِينٌ} [النساء: 13 - 14]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (2867)، والترمذي (2117) بنحوه، وابن ماجه (2704) باختلاف يسير","bab":"تفسير آيات › سورة النساء","dorar":"alTrvM0H"},{"id":"س-06542","fp":"23cbe8bbb137","stateId":646,"easy":"إذا أديت زكاة مالك طيبة بها نفسك تريد وجه الله ← فأنت شهيد","cause":"مَن أدَّى زَكاةَ مالِه طَيِّبةَ طَيِّبَ النَّفسِ بها يُريدُ به وَجْهَ اللهِ، والدَّارَ الآخِرةَ لم يُغَيِّبْ شَيئًا من مالِه، وأقام الصَّلاةَ، وأدَّى الزَّكاةَ، فتَعَدَّى عليه الحَقُّ، فأخَذَ سِلاحَه فقاتَلَ، فقُتِلَ","result":"فهو شَهيدٌ","explicit":true,"ref":"المستدرك على الصحيحين 1489","srcLabel":"أحمد","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ بيْنَما هو في بَيتِها وعِندَه رِجالٌ من أصحابِه يَتحَدَّثون إذ جاء رَجُلٌ فقالَ: يا رَسولَ اللهِ، كم صَدَقةُ كذا وكذا منَ التَّمرِ؟ قالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: كذا وكذا فقالَ الرَّجُلُ: إنَّ فُلانًا تَعَدَّى عَلَيَّ، فأخَذَ مِنِّي كذا وكذا، فازدادَ صاعًا، فقالَ رسول اللهِ صلَّى اللهُ عليه وسلَّمَ: فكيف إذا سَعى عليكم مَن يَتعَدَّى عليكم أشَدَّ من هذا التَّعَدِّي، فحاصَ النَّاسُ وبَهَر الحَديثُ، حتَّى قالَ رَجُلٌ منهم: يا رَسولَ اللهِ، إنْ كان رَجُلًا غائبًا عنكَ في إبِلِه وماشِيَتِه وزَرعِه، فأدَّى زَكاةَ مالِه فتَعَدَّى عليه الحَقُّ، فكيف يَصنَعُ وهو غائبٌ؟ فقالَ رسول اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["مَن أدَّى زَكاةَ مالِه طَيِّبةَ طَيِّبَ النَّفسِ بها يُريدُ به وَجْهَ اللهِ، والدَّارَ الآخِرةَ لم يُغَيِّبْ شَيئًا من مالِه، وأقام الصَّلاةَ، وأدَّى الزَّكاةَ، فتَعَدَّى عليه الحَقُّ، فأخَذَ سِلاحَه فقاتَلَ، فقُتِلَ؛ ",1],["فهو شَهيدٌ",2],"."],"grade":"صحيح","narrator":"أم سلمة","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (26574)، وابن حبان (3193)، و الطبراني (23/ 287) (632) بلفظ قريب.","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"ytz32PAe"},{"id":"س-07675","fp":"5086e15819d5","stateId":646,"easy":"إذا مت على طاعة (رباط أو حج...) ← تُبعث عليها يوم القيامة","cause":"مَن ماتَ على مَرتَبَةٍ مِن هذه المَراتبِ","result":"بُعِثَ عليها يومَ القيامةِ: رِباطٌ أوْ حَجٌّ أوْ غيرُ ذلك","explicit":true,"ref":"المستدرك على الصحيحين 2673","srcLabel":"أحمد","text":[["مَن ماتَ على مَرتَبَةٍ مِن هذه المَراتبِ؛ ",1],["بُعِثَ عليها يومَ القيامةِ: رِباطٌ أوْ حَجٌّ أوْ غيرُ ذلك",2],". \n قالَ فَضالةُ: وسَمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: كُلُّ مَيِّتٍ يُختَمُ على عَمَلِه، إلَّا الَّذي ماتَ مُرابِطًا في سبيلِ اللهِ؛ يَنْمو له عَمَلُه إلى يومِ القيامةِ، ويُؤمَّنُ فِتنةَ القبرِ."],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (23941)، وابن عساكر في ((تاريخه)) (48/ 290)، وابن المبارك في ((الجهاد)) (173) واللفظ لهم.","bab":"قدر › العمل بالخواتيم","dorar":"IzkV38pM"},{"id":"س-06175","fp":"b37854b1bc53","stateId":646,"easy":"إذا أقررت بالتوحيد عند موتك ← تُطعم من ثمار الجنة","cause":"قال قد أقررتُ","result":"رأيتُ ملَكينِ يدُسَّانِ في فيهِ من ثمارِ الجنَّةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"معارج القبول 617/2","srcLabel":"أحمد","text":["خرجنا معَ رسولِ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - فلمَّا برزنا منَ المدينةِ إذا راكبٌ يوضَعُ نحونا فقال رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - كأنَّ هذا الرَّاكبَ إياكم يريدُنا قال فانتَهى الرَّجلُ إلينا فسلَّمَ فرددنا عليهِ فقال لهُ النَّبيُّ - صلَّى اللَّهُ عليهِ وسلَّمَ - من أينَ أقبلتَ قال من أَهلي وولدي وعشيرتي قال فأينَ تريدُ قال أريدُ رسولَ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - قال فقد أصبتَه قال يا رسولَ اللَّهِ علِّمني ما الإيمانُ قال تشهَدُ أن لا إلهَ إلَّا اللَّهُ وأنَّ محمَّدًا رسولُ اللَّهِ وتقيمُ الصَّلاةَ وتؤتي الزَّكاةَ وتصومُ رمضانَ وتحجُّ البيتَ ",["قال قد أقررتُ",1]," قال ثمَّ إنَّ بعيرَه دخلت يدُه في شبَكةِ جُرذانٍ فَهوى بعيرُه وَهوى الرَّجلُ فوقعَ على هامتِهِ فماتَ فقال رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - عليَّ بالرَّجلِ فوثبَ إليهِ عمَّارُ بنُ ياسرٍ وحذيفةُ فأقعداهُ فقالا يا رسولَ اللَّهِ قُبِضَ الرَّجلُ قال فأعرضَ عنهُ رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - ثمَّ قال لَهما رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - أما رأيتُما إعراضي عنِ الرَّجلِ فإنِّي ",["رأيتُ ملَكينِ يدُسَّانِ في فيهِ من ثمارِ الجنَّةِ",2]," فعلمتُ أنَّهُ ماتَ جائِعًا ثمَّ قال رسولُ اللَّهِ - صلَّى اللَّهُ عليهِ وسلَّمَ - هذا واللَّهِ منَ الَّذينَ قال اللَّهُ - تعالى - فيهم { الَّذِينَ آمَنُوا وَلَمْ يَلْبِسُوا إِيمَانَهُمْ بِظُلْمٍ أُولَئِكَ لَهُمُ الْأَمْنُ وَهُمْ مُهْتَدُونَ } [الأنعام 82] ثمَّ قال صلَّى اللَّهُ عليهِ وسلَّمَ دونَكم أخاكم قال فاحتملناهُ إلى الماءِ فغسَّلناهُ وحنَّطناهُ وَكفَّنَّاهُ وحملناهُ إلى القبرِ فجاءَ رسول الله صلَّى اللَّهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"جرير بن عبدالله","muhaddith":"المتن صحيح","takhrij":"أخرجه أحمد (19176) واللفظ له، والطبراني في ((المعجم الكبير)) (2/ 319) (2329)، وابن نصر المروزي في ((تعظيم قدر الصلاة)) (406) بنحوه.","bab":"زكاة › فرض الزكاة","dorar":"tUke9PWM"},{"id":"س-02198","fp":"381172e97d0a","stateId":646,"easy":"إذا حسنت خاتمتك ← فإنما الأعمال بالخواتيم","cause":"بالخَواتيمِ","result":"وإنَّما الأعْمَالُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"مختصر المقاصد 116","srcLabel":"متفق عليه","text":["الأعمالُ ",["بالخَواتيمِ",1]," [يعني حديث: أنَّ رَجُلًا مِن أعْظَمِ المُسْلِمِينَ غَنَاءً عَنِ المُسْلِمِينَ، في غَزْوَةٍ غَزَاهَا مع النبيِّ صَلَّى اللهُ عليه وسلَّمَ، فَنَظَرَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ فَقالَ: مَن أحَبَّ أنْ يَنْظُرَ إلى الرَّجُلِ مِن أهْلِ النَّارِ فَلْيَنْظُرْ إلى هذا فَاتَّبَعَهُ رَجُلٌ مِنَ القَوْمِ، وهو علَى تِلكَ الحَالِ مِن أشَدِّ النَّاسِ علَى المُشْرِكِينَ، حتَّى جُرِحَ، فَاسْتَعْجَلَ المَوْتَ، فَجَعَلَ ذُبَابَةَ سَيْفِهِ بيْنَ ثَدْيَيْهِ حتَّى خَرَجَ مِن بَيْنِ كَتِفَيْهِ، فأقْبَلَ الرَّجُلُ إلى النبيِّ صَلَّى اللهُ عليه وسلَّمَ مُسْرِعًا، فَقالَ: أشْهَدُ أنَّكَ رَسولُ اللَّهِ، فَقالَ: وما ذَاكَ قالَ: قُلْتَ لِفُلَانٍ: مَن أحَبَّ أنْ يَنْظُرَ إلى رَجُلٍ مِن أهْلِ النَّارِ فَلْيَنْظُرْ إلَيْهِ وكانَ مِن أعْظَمِنَا غَنَاءً عَنِ المُسْلِمِينَ، فَعَرَفْتُ أنَّه لا يَمُوتُ علَى ذلكَ، فَلَمَّا جُرِحَ اسْتَعْجَلَ المَوْتَ فَقَتَلَ نَفْسَهُ، فَقالَ النبيُّ صَلَّى اللهُ عليه وسلَّمَ عِنْدَ ذلكَ: إنَّ العَبْدَ لَيَعْمَلُ عَمَلَ أهْلِ النَّارِ وإنَّه مِن أهْلِ الجَنَّةِ، ويَعْمَلُ عَمَلَ أهْلِ الجَنَّةِ وإنَّه مِن أهْلِ النَّارِ، ",["وإنَّما الأعْمَالُ",2]," بالخَوَاتِيمِ.]"],"grade":"صحيح","narrator":"[سهل بن سعد الساعدي]","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6607)\nوأخرجه مسلم (112) دون لفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"FUrnhHGM","merged":3,"otherRefs":["صحيح ابن حبان 340 (صحيح)","أطراف الغرائب 1/399 (صحيح)"]},{"id":"س-02234","fp":"29faf13c9650","stateId":646,"easy":"إذا مت على شيء ← يبعثك الله عليه","cause":"مَنْ ماتَ على شيءٍ","result":"بَعثَهُ اللهُ عليْهِ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح الجامع 6543","srcLabel":"مسلم","text":[["مَنْ ماتَ على شيءٍ ",1],["بَعثَهُ اللهُ عليْهِ",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2878) بنحوه، وأحمد (14373) واللفظ له","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"fKWBP33I"},{"id":"س-06763","fp":"2067a28550a8","stateId":646,"easy":"إذا صمت شعبان ← تُكتب منيتك وأنت صائم","cause":"يَصومُ شَعبانَ كُلَّه","result":"إنَّ اللهَ يَكتُبُ في شَعبانَ حينَ يَقسِمُ مَن يُميتُه تلك السَّنةَ فأُحِبُّ أن يَأتيَ أجَلي وأنا صائِمٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"الفروع لابن مفلح 5/ 104","srcLabel":"الشجري","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّم كان ",["يَصومُ شَعبانَ كُلَّه",1],"، فقُلتُ: أرَأيتَ أحَبَّ الشُّهورِ إليك الصَّوم في شَعبانَ؟ فقال: ",["إنَّ اللهَ يَكتُبُ في شَعبانَ حينَ يَقسِمُ مَن يُميتُه تلك السَّنةَ فأُحِبُّ أن يَأتيَ أجَلي وأنا صائِمٌ",2]],"grade":"حسن","narrator":"أبو هريرة.","muhaddith":"إسناده جيد","takhrij":"أخرجه الشجري في ((ترتيب الأمالي الخميسية)) (1287) واللفظ له.","bab":"صيام › فضل الصيام","dorar":"IF6eWfyB","merged":2,"otherRefs":["سبل الهدى والرشاد 8/433 (حسن)"]},{"id":"س-04135","fp":"4f94e8e15ed8","stateId":647,"easy":"إذا مت مؤمناً ← تستريح من نصب الدنيا وأذاها إلى رحمة الله","cause":"العبدُ المؤمنُ","result":"يَستريحُ مِن نَصَبِ الدُّنْيا وأذاها إلى رَحمةِ اللهِ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"تخريج المسند لشعيب 22576","srcLabel":"متفق عليه","text":["كنَّا مع رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ جُلوسًا في مَجلسٍ، إذ مَرَّتْ جِنازةٌ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مُستريحٌ ومُستراحٌ منه، قال: فقُلْنا: يا رسولَ اللهِ، ما المُستريحُ؟ قال: ",["العبدُ المؤمنُ",1]," ",["يَستريحُ مِن نَصَبِ الدُّنْيا وأذاها إلى رَحمةِ اللهِ",2],"، قُلْنا: فما المُستراحُ منه؟ قال: العبدُ الفاجرُ يَستريحُ منه العِبادُ والبِلادُ والشَّجرُ والدَّوابُّ. قال عبدُ الرَّحمنِ: وقَرَأتُه على مالكٍ، يَعني هذا الحديثَ."],"grade":"صحيح","narrator":"أبو قتادة الحارث بن ربعي","muhaddith":"صحيح","takhrij":"أخرجه البخاري (6512)، ومسلم (950)، والنسائي (1930)، وأحمد (22576) واللفظ له","bab":"جنائز وموت › روح المؤمن بعد الموت","dorar":"Hm4sGnM1","merged":3,"otherRefs":["تخريج صحيح ابن حبان 3007 (صحيح)","صحيح مسلم 950 (صحيح)"]},{"id":"س-04651","fp":"dc8e146fed33","stateId":647,"easy":"إذا مت على الإيمان ← تُبعث في القبر على إيمانك","cause":"المُؤمِنُ على إيمانِه، والمُنافِقُ على نِفاقِه","result":"يُبعَثُ كلُّ عَبدٍ في القَبرِ على ما ماتَ","explicit":true,"star":true,"ref":"تخريج المسند لشعيب 14722","srcLabel":"مسلم","text":["عن أبي الزُّبَيرِ، أنَّه سَألَ جابِرَ بنَ عَبدِ اللهِ، عن فتَّاني القَبرِ، فقال: سَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسَلَّم يقولُ: إنَّ هذه الأُمَّةَ تُبتَلى في قُبورِها، فإذا أُدخِلَ المُؤمِنُ قَبرَه، وتَولَّى عنه أصحابُه، جاء مَلَكٌ شَديدُ الانْتِهارِ، فيقولُ له: ما كنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ المؤمنُ: أقولُ إنَّه رسولُ اللهِ وعَبْدُه، فيقولُ له المَلَكُ: انْظُرْ إلى مَقْعَدِكَ الذي كان لكَ في النَّارِ، قد أَنجاكَ اللهُ منه، وأَبدَلَكَ بمَقعَدِكَ الذي تَرى مِن النَّارِ، مَقعَدَكَ الذي تَرى مِن الجَنَّةِ، فيَراهُما كِلاهُما، فيقولُ المُؤمِنُ: دَعُوني أُبَشِّرْ أهْلي، فيُقالُ له: اسْكُنْ، وأمَّا المُنافِقُ فيَقعُدُ إذا تولَّى عنه أهْلُه، فيُقالُ له: ما كنتَ تقولُ في هذا الرَّجُلِ؟ فيقولُ: لا أَدْري، أقولُ ما يقولُ النَّاسُ، فيُقالُ له: لا دَرَيْتَ، هذا مَقعَدُكَ الذي كان لكَ مِن الجَنَّةِ، قد أُبدِلْتَ مكانَه مَقعَدَكَ مِن النَّارِ، قال جابِرٌ: فسَمِعتُ النَّبيَّ صلَّى اللهُ عليه وسَلَّم يقولُ: ",["يُبعَثُ كلُّ عَبدٍ في القَبرِ على ما ماتَ",2],"، ",["المُؤمِنُ على إيمانِه، والمُنافِقُ على نِفاقِه",1],"."],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14722) واللفظ له، وابن أبي عاصم في ((السنة)) (866)، وأبو يعلى (2316) بنحوه. وأخرجه مسلم (2878) مختصراً بلفظ: ((يبعث كل عبد على ما مات عليه))","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"MQSkCLw2"},{"id":"س-04619","fp":"9ee3eb4138d1","stateId":647,"easy":"إذا كنت مؤمناً في انقطاع من الدنيا وإقبال على الآخرة ← تنزل عليك ملائكة بيض الوجوه بالبشرى","cause":"إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ","result":"نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ","explicit":true,"star":true,"otherNeedIds":[11],"ref":"أحكام الجنائز 198","srcLabel":"أبو داود","text":["خَرَجْنا مع النبيِّ صلَّى اللهُ عليه وسلَّم في جَنازةِ رجلٍ من الأنصارِ ، فانْتَهَيْنا إلى القبرِ ولَمَّا يُلْحَدْ ، فجلس رسولُ اللهِ صلَّى اللهُ عليه وسلم مُسْتَقْبِلَ القِبْلَةِ ، وجَلَسْنَا حَوْلَهُ ، وكأنَّ على رُؤُوسِنَا الطَّيْرَ ، وفي يَدِهِ عودٌ يَنْكُتُ في الأرضِ ، فجعل يَنْظُرُ إلى السماءِ ، ويَنْظُرُ إلى الأرضِ ، وجعل يرفعُ بَصَرَهُ ويَخْفِضُهُ ، ثلاثًا ، فقال : اسْتَعِيذُوا باللهِ من عذابِ القَبْرِ ، مَرَّتَيْنِ ، أو ثلاثًا ، ثم قال : اللهم إني أعوذُ بك من عذابِ القبرِ ثلاثًا ، ثم قال: ",["إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ",1]," ، ",["نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ",2]," وفي رواية : المطمئنةُ ، اخْرُجِي إلى مغفرةٍ من اللهِ ورِضْوانٍ ، قال : فتَخْرُجُ تَسِيلُ كما تَسِيلُ القَطْرَةُ من فِي السِّقَاءِ ، فيأخُذُها ، وفي روايةٍ : حتى إذا خَرَجَتْ رُوحُه صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ ، فإذا أخذها لم يَدَعُوها في يَدِهِ طَرْفَةَ عَيْنٍ حتى يأخذوها فيَجْعَلُوها في ذلك الكَفَنِ ، وفي ذلك الحَنُوطِ ، فذلك قولُه تعالى :  تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ  ، ويخرجُ منها كأَطْيَبِ نَفْحَةِ مِسْكٍ وُجِدَتْ على وجهِ الأرضِ ، قال : فيَصْعَدُونَ بها فلا يَمُرُّونَ – يعني – بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الطَّيِّبُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَحْسَنِ أسمائِهِ التي كانوا يُسَمُّونَهُ بها في الدنيا ، حتى يَنْتَهُوا بها إلى السماءِ الدنيا ، فيَسْتَفْتِحُونَ له ، فيُفْتَحُ لهم ، فيُشَيِّعُهُ من كلِّ سماءٍ مُقَرَّبُوها ، إلى السماءِ التي تَلِيها ، حتى يُنْتَهَي به إلى السماءِ السابعةِ ، فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَ عَبْدِي في عِلِّيِّينَ  وَمَا أَدْرَاكَ مَا عِلِّيُّونَ . كِتَابٌ مَرْقُومٌ يَشْهَدُهُ الْمُقَرَّبُونَ  فيُكْتَبُ كتابُه في عِلِّيِّينَ ، ثم يُقَالُ : أَعِيدُوهُ إلى الأرضِ ، فإني وَعَدْتُهُم أني منها خَلَقْتُهُم ، وفيها أُعِيدُهُم ومنها أُخْرِجُهُم تارةً أُخْرَى ، قال : فيُرَدُّ إلى الأرضِ ، و تُعَادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه يَسْمَعُ خَفْقَ نِعالِ أصحابِه إذا وَلَّوْا عنه مُدْبِرِينَ ، فيَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ فيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : رَبِّيَ اللهُ ، فيقولانِ له : ما دِينُكَ ؟ فيقولُ : دِينِيَ الإسلامُ ، فيقولانِ له : ما هذا الرجلُ الذي بُعِثَ فيكم ؟ فيقولُ : هو رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فيقولانِ له : وما [علمُكَ] ؟ فيقولُ : قرأتُ كتابَ اللهِ ، فآمَنْتُ به ، وصَدَّقْتُ ، فيَنْتَهِرُهُ فيقولُ : مَن رَبُّكَ ؟ ما دِينُكَ ؟ مَن نبيُّكَ ؟ وهي آخِرُ فتنةٍ تُعْرَضُ على المؤمنِ ، فذلك حينَ يقولُ اللهُ عَزَّ وجَلَّ :  {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا} ، فيقولُ : رَبِّيَ اللهُ ، ودِينِيَ الإسلامُ ، ونَبِيِّي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم ، فيُنَادِي مُنَادٍ في السماءِ : أن صَدَقَ عَبْدِي ، فأَفْرِشُوهُ من الجنةِ ، وأَلْبِسُوهُ من الجنةِ ، وافْتَحُوا له بابًا إلى الجنةِ ، قال : فيَأْتِيهِ من رَوحِها وطِيبِها ، ويُفْسَحُ له في قبرِه مَدَّ بَصَرِهِ ، قال : ويَأْتِيهِ- وفي روايةٍ : يُمَثَّلُ له- رجلٌ حَسَنُ الوجهِ ، حَسَنُ الثيابِ ، طَيِّبُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُرُّكَ ، أَبْشِرِ برِضْوانٍ من اللهِ ، وجَنَّاتٍ فيها نعيمٌ مُقِيمٌ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ له : وأنت فبَشَّرَكَ اللهُ بخيرٍ مَن أنت ؟ فوَجْهُكَ الوجهُ يَجِئُ بالخيرِ ، فيقولُ : أنا عَمَلُكَ الصالِحُ فواللهِ ما عَلِمْتُكَ إلا كنتَ سريعًا في طاعةِ اللهِ ، بطيئًا في معصيةِ اللهِ ، فجزاك اللهُ خيرًا ، ثم يُفْتَحُ له بابٌ من الجنةِ ، وبابٌ من النارِ ، فيُقالُ : هذا مَنْزِلُكَ لو عَصَيْتَ اللهَ ، أَبْدَلَكَ اللهُ به هذا ، فإذا رأى ما في الجنةِ قال : رَبِّ عَجِّلْ قيامَ الساعةِ ، كَيْما أَرْجِعَ إلى أهلي ومالي ، فيُقالُ له : اسْكُنْ ، قال : وإنَّ العبدَ الكافرَ- وفي روايةٍ : الفاجرَ- إذا كان في انقطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ ، قال : فتفَرَّقُ في جَسَدِهِ فيَنْتَزِعُها كما يُنْتَزَعُ السَّفُّودُ الكثيرُ الشُّعبِ من الصُّوفِ المَبْلُولِ ، فتَقْطَعُ معها العُرُوقَ والعَصَبَ ، فيَلْعَنُهُ كلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكلُّ مَلَكِ في السماءِ ، وتُغْلَقُ أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أَلَّا تَعْرُجَ رُوحُهُ من قِبَلِهِمْ ، فيَأْخُذُها ، فإذا أخذها ، لم يَدَعُوها في يَدِهِ طَرْفَةَ عينٍ حتى يَجْعَلُوها في تِلْكِ المُسُوحِ ، ويخرجُ منها كأَنْتَنِ رِيحِ جِيفَةٍ وُجِدَتْ على وجهِ الأرضِ ، فيَصْعَدُونَ بها ، فلا يَمُرُّونَ بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الخَبِيثُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَقْبَحِ أسمائِهِ التي كان يُسَمَّى بها في الدنيا ، حتى يُنْتَهَي به إلى السماءِ الدنيا ، فيُسْتَفْتَحُ له ، فلا يُفْتَحُ له ، ثم قرأ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم  {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ}  فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَه في سِجِّينَ في الأرضِ السُّفْلَى ، ثم يُقالُ : أَعِيدُوا عَبْدِي إلى الأرضِ فإني وَعَدْتُهُمْ أني منها خَلَقْتُهُمْ ، وفيها أُعِيدُهُمْ ، ومنها أُخْرِجُهُمْ تارةً أُخْرَى ، فتُطْرَحُ رُوحُهُ من السماءِ طَرْحًا حتى تَقَعَ في جَسَدِهِ ثم قرأ :  {وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ}  فتُعادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه لَيَسْمَعُ خَفْقَ نِعالِ أصحابِهِ إذا وَلَّوْا عنه . ويَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ ، فَيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ ، فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : هاه هاه لا أَدْرِي ، فيقولانِ له : مادِينُكَ ؟ فيقولُ : ها هاه لا أَدْرِي ، فيقولانِ : فما تَقُولُ في هذا الرجلِ الذي بُعِثَ فيكم ؟ فلا يَهْتَدِي لاسْمِهِ ، فيُقالُ : مُحَمَّدٌ ! فيقولُ : هاه هاه لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك ! قال : فيُقالُ : لا دَرَيْتَ ، ولا تَلَوْتَ ، فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه ، ويَأْتِيهِ وفي روايةٍ : ويُمَثَّلُ له رجلٌ قبيحُ الوجهِ ، قبيحُ الثيابِ ، مُنْتِنُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُوؤُكَ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ : وأنت فَبَشَّرَكَ اللهُ بالشرِّ مَن أنت ؟ فوجهُك الوجهُ يَجِيءُ بالشرِّ ! فيقولُ : أنا عملُكَ الخبيثُ ، فواللهِ ما عَلِمْتُ إلا كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ ، فجزاك الله شرًّا ، ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ ، ثم يُفْتَحُ له بابٌ من النارِ ، ويُمَهَّدُ من فُرُشِ النارِ ، فيقولُ : رَبِّ لا تُقِمِ الساعةَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"القسم الأول منه إلى قوله: وكأن على رؤوسنا الطير صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4753)، وأحمد (18558) باختلاف يسير، والنسائي (2001)، وابن ماجه (1549) مختصراً","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"pUmebMAe","merged":7,"otherRefs":["المستدرك على الصحيحين 108 (صحيح)","التذكرة للقرطبي 119 (صحيح)","الروح 1/269 (صحيح)","مسند عمر 2/498 (صحيح)","مسند عمر 2/508 (صحيح)","مسند عمر 2/491 (صحيح)"]},{"id":"ق-0669","fp":"93d362b25fae","stateId":647,"easy":"التقوى وطيب النفس ← توفّي الملائكة لهم طيبين بالسلام والبشارة بالجنة","cause":"التقوى وطيب النفس","result":"توفّي الملائكة لهم طيبين بالسلام والبشارة بالجنة","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة النحل: 32","srcLabel":"القرآن الكريم","quran":{"s":16,"from":32,"to":32,"text":"الَّذِينَ تَتَوَفَّاهُمُ الْمَلَائِكَةُ طَيِّبِينَ يَقُولُونَ سَلَامٌ عَلَيْكُمُ ادْخُلُوا الْجَنَّةَ بِمَا كُنْتُمْ تَعْمَلُونَ (32)","hl":[[0,128,1]]}},{"id":"ق-1292","fp":"77a94d3081dd","stateId":647,"easy":"القرب من الله بالسبق في الطاعة ← رَوح وريحان وجنة نعيم عند الموت","cause":"القرب من الله بالسبق في الطاعة","result":"رَوح وريحان وجنة نعيم عند الموت","explicit":true,"star":true,"otherNeedIds":[67],"ref":"سورة الواقعة: 88–89","srcLabel":"القرآن الكريم","quran":{"s":56,"from":88,"to":89,"text":"فَأَمَّا إِنْ كَانَ مِنَ الْمُقَرَّبِينَ (88) فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ (89)","hl":[[0,84,1]]}},{"id":"ق-1293","fp":"ab2669d56a95","stateId":647,"easy":"العمل الصالح (أصحاب اليمين) ← السلام عند الموت","cause":"العمل الصالح (أصحاب اليمين)","result":"السلام عند الموت","explicit":true,"ref":"سورة الواقعة: 90–91","srcLabel":"القرآن الكريم","quran":{"s":56,"from":90,"to":91,"text":"وَأَمَّا إِنْ كَانَ مِنْ أَصْحَابِ الْيَمِينِ (90) فَسَلَامٌ لَكَ مِنْ أَصْحَابِ الْيَمِينِ (91)","hl":[[0,91,1]]}},{"id":"ق-1435","fp":"9d85b26417d5","stateId":647,"easy":"طمأنينة النفس بالإيمان ← الرجوع إلى الله راضية مرضية ودخول الجنة","cause":"طمأنينة النفس بالإيمان","result":"الرجوع إلى الله راضية مرضية ودخول الجنة","explicit":true,"otherNeedIds":[67,23],"ref":"سورة الفجر: 27–30","srcLabel":"القرآن الكريم","quran":{"s":89,"from":27,"to":30,"text":"يَا أَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُ (27) ارْجِعِي إِلَى رَبِّكِ رَاضِيَةً مَرْضِيَّةً (28) فَادْخُلِي فِي عِبَادِي (29) وَادْخُلِي جَنَّتِي (30)","hl":[[0,145,1]]}},{"id":"س-02766","fp":"1c53a40b7a2e","stateId":647,"easy":"إذا احتُضرت وأنت مؤمن ← تأتيك ملائكة الرحمة: اخرجي راضية مرضياً عنك","cause":"إنَّ المُؤمِنَ إذا احتُضِرَ","result":"أتَتْه مَلائكةُ الرَّحمةِ بحَريرةٍ بَيضاءَ، فَيقولون: اخرُجي راضِيةً مَرضِيَّةً عنكِ إلى رَوحِ اللهِ، ورَيحانٍ، ورَبٍّ غَيرِ غَضبانٍ، فتَخرُجُ كأطيَبِ رِيحِ مِسكٍ","explicit":true,"ref":"المستدرك على الصحيحين 1322","srcLabel":"النسائي","text":["إنَّ المُؤمِنَ إذا حَضَره المَوتُ حَضَره مَلائكةُ الرَّحمِة ثمَّ ذَكَر الحَديثَ بنَحوِه [أي: بنحوِ حَديثِ: ",["إنَّ المُؤمِنَ إذا احتُضِرَ",1]," ",["أتَتْه مَلائكةُ الرَّحمةِ بحَريرةٍ بَيضاءَ، فَيقولون: اخرُجي راضِيةً مَرضِيَّةً عنكِ إلى رَوحِ اللهِ، ورَيحانٍ، ورَبٍّ غَيرِ غَضبانٍ، فتَخرُجُ كأطيَبِ رِيحِ مِسكٍ",2],"، حتَّى إنَّهم ليُناوِلُه بَعضُهم بَعضًا يَشَمُّونه، حتَّى يأتوا به بابَ السَّماءِ فيَقولون: ما أطيَبَ هذه الرِّيحَ! الَّتي جاءَتكُم منَ الأرضِ! فكُلَّما أتَوا سَماءً قالوا ذلكَ، حتَّى يأتوا به أرواحَ المُؤمِنين. قالَ: فلَهُمْ أفرَحُ به من أحَدِكُم بغائبِه إذا قَدِمَ عليه. قالَ: فيَسألونه ما فَعَل فُلانٌ؟ قالَ: فيَقولون: دَعوه حتَّى يَستَريحَ؛ فإنَّه كان في غَمِّ الدُّنيا، فإذا قالَ لهم: أمَا أتاكُم؟ فإنَّه قد ماتَ. قالَ: فيَقولون: ذُهِبَ به إلى أُمِّه الهاوِيةِ. قالَ: وأمَّا الكافِرُ، فإنَّ مَلائكةَ العَذابِ تَأتيه، فتقول: اخرُجي ساخِطةً مَسخوطًا عَلَيكِ إلى عَذابِ اللهِ، وسَخَطِه، فتَخرُج كأنتَنِ ريحِ جِيفةٍ، فيَنطَلِقون به إلى بابِ الأرضِ، فيقولون: ما أنتَنَ هذه الرِّيحَ! كُلَّما أتَوا على أرضٍ قالوا ذلكَ، حتَّى يأتوا به أرواحَ الكُفَّارِ]."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح [وله شاهد]","takhrij":"أخرجه النسائي (1833)، وابن حبان (3014)، والبزار (9542) بنحوه.","bab":"إيمان › الملائكة","dorar":"qkIidGRa","merged":5,"otherRefs":["إتحاف الخيرة المهرة 2/439 (صحيح)","تخريج صحيح ابن حبان 3013 (صحيح)","هداية الرواة 1572 (صحيح)","الترغيب والترهيب 4/283 (صحيح)"]},{"id":"س-04660","fp":"3b6b4fe915e2","stateId":647,"easy":"إذا كنت صالحاً عند موتك ← يقال: اخرجي أيتها النفس الطيبة","cause":"فإذا كانَ الرَّجُلُ الصَّالِحُ قالوا","result":"اخْرُجي أيَّتُها النَّفْسُ الطَّيِّبةُ كانَتْ في الجَسَدِ الطَّيِّبِ، واخْرُجي حَميدةً، وأَبْشِري برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ","explicit":true,"ref":"الصحيح المسند 2/342","srcLabel":"أحمد","text":["عن عائِشةَ قالَتْ: جاءَتْ يَهوديَّةٌ فاسْتَطْعَمَتْ على بابي، فقالَتْ: أَطعِموني، أَعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ: فلم أَزَلْ أَحبِسُها حتَّى جاءَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، فقُلْتُ: يا رَسولَ اللهِ، ما تَقولُ هذه اليَهوديَّةُ؟ قالَ: «وما تَقولُ؟»، قُلْتُ: تَقولُ: أعاذَكم اللهُ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، قالَتْ عائِشةُ: فقامَ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ فرَفَعَ يَدَيه مَدًّا يَسْتعيذُ باللهِ مِن فِتْنةِ الدَّجَّالِ ومِن فِتْنةِ عَذابِ القَبْرِ، ثُمَّ قالَ: «أمَّا فِتْنةُ الدَّجَّالِ فإنَّه لم يكنْ نَبيٌّ إلَّا قد حَذَّرَ أُمَّتَه، وسأُحَذِّرُكموه تَحْذيرًا لم يُحَذِّرْه نَبيٌّ أُمَّتَه، إنَّه أَعوَرُ، واللهُ عَزَّ وجَلَّ ليس بأَعوَرَ، مَكْتوبٌ بَيْنَ عَيْنَيه: كافِرٌ، يَقرَؤُه كلُّ مُؤمِنٍ، فأمَّا فِتْنةُ القَبْرِ فبي تُفْتَنونَ، وعنِّي تُسأَلونَ، فإذا كانَ الرَّجُلُ الصَّالِحُ أُجلِسَ في قَبْرِه غَيْرَ فَزِعٍ ولا مَشْعوفٍ، ثُمَّ يُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: في الإسْلامِ، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: مُحمَّدٌ رَسولُ اللهِ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ، جاءَنا بالبَيِّناتِ مِن عنْدِ اللهِ عَزَّ وجَلَّ، فصَدَّقْناه، فيُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بعضًا، فيُقالُ له: انْظُرْ إلى ما وَقاك اللهُ عَزَّ وجَلَّ، ثُمَّ يُفرَجُ له فُرْجةٌ إلى الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: هذا مَقعَدُك مِنها، ويُقالُ: على اليَقينِ كُنْتَ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ. وإذا كانَ الرَّجُلُ السُّوءُ أُجلِسَ في قَبْرِه فَزِعًا مَشْعوفًا، فيُقالُ له: فيمَ كُنْتَ؟ فيَقولُ: لا أَدْري، فيُقالُ: ما هذا الرَّجُلُ الَّذي كانَ فيكم؟ فيَقولُ: سَمِعْتُ النَّاسَ يَقولونَ قَوْلًا فقُلْتُ كما قالوا، فتُفرَجُ له فُرْجةٌ قِبَلَ الجَنَّةِ، فيَنظُرُ إلى زَهْرتِها وما فيها، فيُقالُ له: انْظُرْ إلى ما صَرَفَ اللهُ عَزَّ وجَلَّ عنك، ثُمَّ يُفرَجُ له فُرْجةٌ قِبَلَ النَّارِ، فيَنظُرُ إليها يَحطِمُ بعضُها بَعضًا، ويُقالُ له: هذا مَقعَدُك مِنها، كُنْتَ على الشَّكِّ، وعليه مِتَّ، وعليه تُبعَثُ إن شاءَ اللهُ، ثُمَّ يُعذَّبُ».\nقالَ مُحمَّدُ بنُ عَمْرٍو: فحَدَّثَني سَعيدُ بنُ يَسارٍ عن أبي هُرَيْرةَ، عن النَّبيِّ صلَّى اللهُ عليه وعلى آلِه وسلَّمَ قالَ: «إنَّ المَيِّتَ تَحضُرُه المَلائِكةُ، ",["فإذا كانَ الرَّجُلُ الصَّالِحُ قالوا",1],": ",["اخْرُجي أيَّتُها النَّفْسُ الطَّيِّبةُ كانَتْ في الجَسَدِ الطَّيِّبِ، واخْرُجي حَميدةً، وأَبْشِري برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ",2],"، فلا يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بِها إلى السَّماءِ، فيُسْتَفتَحُ له، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: مَرْحبًا بالنَّفْسِ الطَّيِّبةِ كانَت في الجَسَدِ الطَّيِّبِ، ادْخُلي حَميدةً، وأَبشِري، ويُقالُ: برَوْحٍ ورَيْحانٍ، ورَبٍّ غَيْرِ غَضْبانَ، فلا يَزالُ يُقالُ لها ذلك حتَّى يُنْتَهى بها إلى السَّماءِ الَّتي فيها اللهُ عَزَّ وجَلَّ، فإذا كانَ الرَّجُلُ السُّوءُ قالوا: اخْرُجي أيَّتُها النَّفْسُ الخَبيثةُ كانَت في الجَسَدِ الخَبيثِ، اخْرُجي مِنه ذَميمةً، وأَبشِري بحَميمٍ وغَسَّاقٍ، وآخَرَ مِن شَكْلِه أزْواجٍ، فما يَزالُ يُقالُ لها ذلك حتَّى تَخرُجَ، ثُمَّ يُعرَجُ بها إلى السَّماءِ، فيُسْتَفتَحُ لها، فيُقالُ: مَن هذا؟ فيُقالُ: فُلانٌ، فيُقالُ: لا مَرْحبًا بالنَّفْسِ الخَبيثةِ كانَت في الجَسَدِ الخَبيثِ، ارْجِعي ذَميمةً؛ فإنَّه لا يُفتَحُ لكِ أبْوابُ السَّماءِ، فتُرسَلُ مِن السَّماءِ، ثُمَّ تَصيرُ إلى القَبْرِ، فيَجلِسُ الرَّجُلُ الصَّالِحُ، فيُقالُ له ويَرُدُّ»."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح، وحديث عائشة وكذا حديث أبي هُرَيْرةَ بعضهما في \"الصحيح\"من وجهين آخرين","takhrij":"أخرجه أحمد (25090) واللفظ له، وابن ماجة (4268)، وابن حبان (3113) بنحوه.","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"XKG6SNPU","merged":3,"otherRefs":["تفسير القرآن العظيم 6/110 (صحيح)","مجموع الفتاوى 9/290 (صحيح)"]},{"id":"س-07668","fp":"12e23c17d6fb","stateId":647,"easy":"إذا متّ فجأة وأنت مؤمن ← فهو راحة لك","cause":"للمؤمنِ","result":"موتُ الفَجْأَةِ راحةٌ","explicit":true,"ref":"كشف الخفاء 2/383","srcLabel":"أحمد","text":[["موتُ الفَجْأَةِ راحةٌ",2]," ",["للمؤمنِ",1]," , وأَخْذُهُ أَسَفٌ للكافرِ"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (25042)، والبيهقي (6811) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (3129) بنحوه","bab":"قدر › العمل بالخواتيم","dorar":"xvSw2QPJ","merged":3,"otherRefs":["مختصر المقاصد 1109 (صحيح)","الجامع الصغير 9101 (حسن)"]},{"id":"س-07946","fp":"4c2236b65446","stateId":647,"easy":"إذا مت مؤمناً ← تموت بعرق الجبين","cause":"المُؤمِنُ","result":"المُؤمِنُ يَموُت بعَرَقِ الجَبينِ","explicit":true,"ref":"تخريج المسند لشعيب 23047","srcLabel":"الترمذي","text":["عن عبدِ اللهِ بنِ بُرَيدةَ، عن أبيه، أنَّه عادَ أخًا له، فرَأى جَبينَه يَعرَقُ، فقال: اللهُ أكبَرُ، سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ -أو قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ. قال أبو داودَ في حَديثِه: سَمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ-: ",["المُؤمِنُ يَموُت بعَرَقِ الجَبينِ",2],"."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (982)، والنسائي (1829)، وابن ماجه (1452)، وأحمد (23047) واللفظ له","bab":"مريض › مشروعية عيادة المريض وفضلها","dorar":"6hObJfc3","merged":2,"otherRefs":["تخريج المسند لشعيب 23022 (صحيح)"]},{"id":"س-08101","fp":"ca76ed0b1428","stateId":647,"easy":"إذا خرجت روحك وأنت مؤمن ← يتلقاها ملكان ويصعدان بها بطيب ريحها","cause":"إذا خَرَجَت روحُ المُؤمِنِ","result":"تَلَقَّاها مَلَكانِ يُصعِدانِها. قال حَمَّادٌ: فذَكَرَ مِن طيبِ ريحِها وذَكَرَ المِسكَ. قال: ويقولُ أهلُ السَّماءِ: رُوحٌ طَيِّبةٌ جاءَت مِن قِبَلِ الأرضِ، صَلَّى اللهُ عليكِ وعلى جَسَدٍ كُنتِ تَعمُرينَه","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"صحيح مسلم 2872","srcLabel":"متفق عليه","text":[["إذا خَرَجَت روحُ المُؤمِنِ",1]," ",["تَلَقَّاها مَلَكانِ يُصعِدانِها. قال حَمَّادٌ: فذَكَرَ مِن طيبِ ريحِها وذَكَرَ المِسكَ. قال: ويقولُ أهلُ السَّماءِ: رُوحٌ طَيِّبةٌ جاءَت مِن قِبَلِ الأرضِ، صَلَّى اللهُ عليكِ وعلى جَسَدٍ كُنتِ تَعمُرينَه",2],"، فيُنطَلَقُ به إلى رَبِّه عزَّ وجلَّ، ثُمَّ يقولُ: انطَلِقوا به إلى آخِرِ الأجَلِ. قال: وإنَّ الكافِرَ إذا خَرَجَت روحُه، قال حَمَّادٌ: وذَكَرَ مِن نَتْنِها، وذَكَرَ لَعنًا، ويقولُ أهلُ السَّماءِ: رُوحٌ خَبيثةٌ جاءَت مِن قِبَلِ الأرضِ. قال: فيُقالُ: انطَلِقوا به إلى آخِرِ الأجَلِ. قال أبو هُرَيرةَ: فرَدَّ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم رَيطةً كانَت عليه على أنفِه هَكَذا."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"ملائكة › أعمال الملائكة","dorar":"Hl3kxQUN"},{"id":"س-04131","fp":"425a8b586175","stateId":647,"easy":"إذا كنت صالحاً ← تقول على سريرك: قدّموني","cause":"إذا وُضِعَ الرَّجُلُ الصَّالحُ على سَريرِه","result":"قال: قَدِّموني قَدِّموني","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 7914","srcLabel":"النسائي","text":["أنَّ أبا هُريرةَ، قال: حين حضَرَه المَوتُ: لا تَضرِبوا عليَّ فُسْطاطًا، ولا تَتْبَعوني بِمِجمَرٍ، وأَسرِعوا بي؛ فإنِّي سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إذا وُضِعَ الرَّجُلُ الصَّالحُ على سَريرِه",1]," ",["قال: قَدِّموني قَدِّموني",2],"، وإذا وُضِعَ الرَّجُلُ السُّوءُ على سَريرِه قال: يا وَيْلَه أين تَذهَبون بي؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (1908) بنحوه، وأحمد (7914) واللفظ له","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"AawKsEuF","merged":2,"otherRefs":["صحيح البخاري 1380 (صحيح)"]},{"id":"س-02724","fp":"3519e37fccd6","stateId":647,"easy":"إذا كانت روحك صالحة ← تتلقاها الملائكة بكفن وحنوط من الجنة","cause":"إذا كانت الرُّوحُ صالِحةً","result":"فإنَّ معهم كَفَنًا مِنَ الجَنَّةِ وحَنُوطًا مِنَ الجَنَّةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"شرح العقيدة السفارينية 447","srcLabel":"شرح العقيدة السفارينية","text":["إذا قُبِضَت [أي: الرُّوحُ] قَبَضَها مَلَكُ الموتِ وعِندَه الملائِكةُ المساعِدونَ له، الذين نَزَلوا من السَّماءِ، ",["إذا كانت الرُّوحُ صالِحةً",1]," ",["فإنَّ معهم كَفَنًا مِنَ الجَنَّةِ وحَنُوطًا مِنَ الجَنَّةِ",2]," فلا يَدَعونَها في يَدِه طَرْفةَ عَينٍ حتَّى يَضَعوها في هذا الكَفَنِ وهذا الحَنُوطِ، ثمَّ يَصعَدونَ بها إلى السَّماءِ ويُشَيِّعُها مِن كُلِّ سَماءٍ مُقَرَّبوها إلى السَّماءِ التي فَوقَها، ويُقالُ: ما هذه الرُّوحُ الطَّيِّبةُ؟ فيقولُ الملائِكةُ: هذه رُوحُ فلانِ بنِ فُلانٍ؛ بأطيَبِ ما يُسَمَّى به في الدُّنيا، حتى تَصِلَ إلى خالِقِها عزَّ وجَلَّ، ثمَّ يقولُ سُبحانَه وتعالى: رُدُّوه إلى الأرضِ فإنِّي منها خَلَقْتُه، وفيها أُعيدُه، ومنها أُخرِجُه تارةً أُخرى، فتُعادُ رُوحُه في جَسَدِه، حتَّى يأتيَه الملَكانِ ويَسألاه، ثمَّ بَعْدَ ذلك تَذهَبُ إلى الجنَّةِ"],"grade":"صحيح","muhaddith":"ثابت","bab":"إيمان › الملائكة","dorar":"limMhXsq"},{"id":"س-04130","fp":"5ed1e1e6514e","stateId":647,"easy":"إذا كنت مؤمناً ← تقول على سريرك: أسرعوا بي","cause":"إنَّ المُؤمِنَ إذا وضِعَ على سَريرِهِ","result":"قال: أسرِعوا بي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"تخريج المسند لشعيب 10493","srcLabel":"النسائي","text":["لمَّا حضَرَ أبا هُرَيرةَ المَوتُ قال: لا تَتبَعوني بمِجمَرٍ، وأسرِعوا بي؛ فإنِّي سمِعتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["إنَّ المُؤمِنَ إذا وضِعَ على سَريرِهِ",1]," ",["قال: أسرِعوا بي",2],"، وإذا وضِعَ الكافِرُ على سَريرِهِ قال: وَيْلاهُ، أين تَذهَبون بي؟"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح لغيره","takhrij":"أخرجه النسائي (1908) بنحوه، وأحمد (10493) واللفظ له","bab":"جنائز وموت › روح الكافر بعد الموت","dorar":"KcWJUc4h"},{"id":"س-04620","fp":"b17fe6cb6491","stateId":647,"easy":"إذا خرجت روحك وأنت مؤمن ← يصلي عليك كل ملك بين السماء والأرض","cause":"حتى إذا خَرَجَتْ رُوحُه","result":"صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"ref":"أحكام الجنائز 198","srcLabel":"أبو داود","text":["خَرَجْنا مع النبيِّ صلَّى اللهُ عليه وسلَّم في جَنازةِ رجلٍ من الأنصارِ ، فانْتَهَيْنا إلى القبرِ ولَمَّا يُلْحَدْ ، فجلس رسولُ اللهِ صلَّى اللهُ عليه وسلم مُسْتَقْبِلَ القِبْلَةِ ، وجَلَسْنَا حَوْلَهُ ، وكأنَّ على رُؤُوسِنَا الطَّيْرَ ، وفي يَدِهِ عودٌ يَنْكُتُ في الأرضِ ، فجعل يَنْظُرُ إلى السماءِ ، ويَنْظُرُ إلى الأرضِ ، وجعل يرفعُ بَصَرَهُ ويَخْفِضُهُ ، ثلاثًا ، فقال : اسْتَعِيذُوا باللهِ من عذابِ القَبْرِ ، مَرَّتَيْنِ ، أو ثلاثًا ، ثم قال : اللهم إني أعوذُ بك من عذابِ القبرِ ثلاثًا ، ثم قال: إنَّ العبدَ المؤمنَ إذا كان في انقِطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَلَ إليه ملائكةٌ من السماءِ ، بِيضُ الوُجُوهِ ، كأنَّ وجوهَهُمُ الشمسُ ، معهم كَفَنٌ من أكفانِ الجنةِ ، وحَنُوطٌ من حَنُوطِ الجنةِ ، حتى يَجْلِسُوا منه مَدَّ البَصَرِ ، ثم يَجِىءُ مَلَكُ الموتِ عليه السلامُ حتى يَجْلِسَ عندَ رأسِهِ فيقولُ : أَيَّتُها النَّفْسُ الطيبةُ وفي رواية : المطمئنةُ ، اخْرُجِي إلى مغفرةٍ من اللهِ ورِضْوانٍ ، قال : فتَخْرُجُ تَسِيلُ كما تَسِيلُ القَطْرَةُ من فِي السِّقَاءِ ، فيأخُذُها ، وفي روايةٍ : ",["حتى إذا خَرَجَتْ رُوحُه",1]," ",["صلَّى عليه كُلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكُلُّ مَلَكٍ في السماءِ ، وفُتِحَتْ له أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أن يُعْرَجَ برُوحِهِ من قِبَلِهِمْ",2]," ، فإذا أخذها لم يَدَعُوها في يَدِهِ طَرْفَةَ عَيْنٍ حتى يأخذوها فيَجْعَلُوها في ذلك الكَفَنِ ، وفي ذلك الحَنُوطِ ، فذلك قولُه تعالى :  تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ  ، ويخرجُ منها كأَطْيَبِ نَفْحَةِ مِسْكٍ وُجِدَتْ على وجهِ الأرضِ ، قال : فيَصْعَدُونَ بها فلا يَمُرُّونَ – يعني – بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الطَّيِّبُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَحْسَنِ أسمائِهِ التي كانوا يُسَمُّونَهُ بها في الدنيا ، حتى يَنْتَهُوا بها إلى السماءِ الدنيا ، فيَسْتَفْتِحُونَ له ، فيُفْتَحُ لهم ، فيُشَيِّعُهُ من كلِّ سماءٍ مُقَرَّبُوها ، إلى السماءِ التي تَلِيها ، حتى يُنْتَهَي به إلى السماءِ السابعةِ ، فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَ عَبْدِي في عِلِّيِّينَ  وَمَا أَدْرَاكَ مَا عِلِّيُّونَ . كِتَابٌ مَرْقُومٌ يَشْهَدُهُ الْمُقَرَّبُونَ  فيُكْتَبُ كتابُه في عِلِّيِّينَ ، ثم يُقَالُ : أَعِيدُوهُ إلى الأرضِ ، فإني وَعَدْتُهُم أني منها خَلَقْتُهُم ، وفيها أُعِيدُهُم ومنها أُخْرِجُهُم تارةً أُخْرَى ، قال : فيُرَدُّ إلى الأرضِ ، و تُعَادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه يَسْمَعُ خَفْقَ نِعالِ أصحابِه إذا وَلَّوْا عنه مُدْبِرِينَ ، فيَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ فيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : رَبِّيَ اللهُ ، فيقولانِ له : ما دِينُكَ ؟ فيقولُ : دِينِيَ الإسلامُ ، فيقولانِ له : ما هذا الرجلُ الذي بُعِثَ فيكم ؟ فيقولُ : هو رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فيقولانِ له : وما [علمُكَ] ؟ فيقولُ : قرأتُ كتابَ اللهِ ، فآمَنْتُ به ، وصَدَّقْتُ ، فيَنْتَهِرُهُ فيقولُ : مَن رَبُّكَ ؟ ما دِينُكَ ؟ مَن نبيُّكَ ؟ وهي آخِرُ فتنةٍ تُعْرَضُ على المؤمنِ ، فذلك حينَ يقولُ اللهُ عَزَّ وجَلَّ :  {يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا} ، فيقولُ : رَبِّيَ اللهُ ، ودِينِيَ الإسلامُ ، ونَبِيِّي مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم ، فيُنَادِي مُنَادٍ في السماءِ : أن صَدَقَ عَبْدِي ، فأَفْرِشُوهُ من الجنةِ ، وأَلْبِسُوهُ من الجنةِ ، وافْتَحُوا له بابًا إلى الجنةِ ، قال : فيَأْتِيهِ من رَوحِها وطِيبِها ، ويُفْسَحُ له في قبرِه مَدَّ بَصَرِهِ ، قال : ويَأْتِيهِ- وفي روايةٍ : يُمَثَّلُ له- رجلٌ حَسَنُ الوجهِ ، حَسَنُ الثيابِ ، طَيِّبُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُرُّكَ ، أَبْشِرِ برِضْوانٍ من اللهِ ، وجَنَّاتٍ فيها نعيمٌ مُقِيمٌ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ له : وأنت فبَشَّرَكَ اللهُ بخيرٍ مَن أنت ؟ فوَجْهُكَ الوجهُ يَجِئُ بالخيرِ ، فيقولُ : أنا عَمَلُكَ الصالِحُ فواللهِ ما عَلِمْتُكَ إلا كنتَ سريعًا في طاعةِ اللهِ ، بطيئًا في معصيةِ اللهِ ، فجزاك اللهُ خيرًا ، ثم يُفْتَحُ له بابٌ من الجنةِ ، وبابٌ من النارِ ، فيُقالُ : هذا مَنْزِلُكَ لو عَصَيْتَ اللهَ ، أَبْدَلَكَ اللهُ به هذا ، فإذا رأى ما في الجنةِ قال : رَبِّ عَجِّلْ قيامَ الساعةِ ، كَيْما أَرْجِعَ إلى أهلي ومالي ، فيُقالُ له : اسْكُنْ ، قال : وإنَّ العبدَ الكافرَ- وفي روايةٍ : الفاجرَ- إذا كان في انقطاعٍ من الدنيا ، وإقبالٍ من الآخرةِ ، نَزَل إليه من السماءِ ملائكةٌ غِلَاظٌ شِدَادٌ ، سُودُ الوجوهِ ، معَهُمُ المُسُوحُ من النارِ ، فيَجْلِسُونَ منه مَدَّ البَصَرِ ، ثم يَجِيءُ مَلَكُ الموتِ حتى يَجْلِسَ عند رأسِهِ ، فيقولُ : أَيَّتُهَا النَّفْسُ الخبيثةُ اخْرُجِي إلى سَخَطٍ من اللهِ وغَضَبٍ ، قال : فتفَرَّقُ في جَسَدِهِ فيَنْتَزِعُها كما يُنْتَزَعُ السَّفُّودُ الكثيرُ الشُّعبِ من الصُّوفِ المَبْلُولِ ، فتَقْطَعُ معها العُرُوقَ والعَصَبَ ، فيَلْعَنُهُ كلُّ مَلَكٍ بينَ السماءِ والأرضِ ، وكلُّ مَلَكِ في السماءِ ، وتُغْلَقُ أبوابُ السماءِ ، ليس من أهلِ بابٍ إلا وهم يَدْعُونَ اللهَ أَلَّا تَعْرُجَ رُوحُهُ من قِبَلِهِمْ ، فيَأْخُذُها ، فإذا أخذها ، لم يَدَعُوها في يَدِهِ طَرْفَةَ عينٍ حتى يَجْعَلُوها في تِلْكِ المُسُوحِ ، ويخرجُ منها كأَنْتَنِ رِيحِ جِيفَةٍ وُجِدَتْ على وجهِ الأرضِ ، فيَصْعَدُونَ بها ، فلا يَمُرُّونَ بها على مَلَأٍ من الملائكةِ إلا قالوا : ما هذا الرُّوحُ الخَبِيثُ ؟ فيقولونَ : فلانُ ابنُ فلانٍ – بأَقْبَحِ أسمائِهِ التي كان يُسَمَّى بها في الدنيا ، حتى يُنْتَهَي به إلى السماءِ الدنيا ، فيُسْتَفْتَحُ له ، فلا يُفْتَحُ له ، ثم قرأ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم  {لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّى يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ}  فيقولُ اللهُ عَزَّ وجَلَّ : اكْتُبُوا كتابَه في سِجِّينَ في الأرضِ السُّفْلَى ، ثم يُقالُ : أَعِيدُوا عَبْدِي إلى الأرضِ فإني وَعَدْتُهُمْ أني منها خَلَقْتُهُمْ ، وفيها أُعِيدُهُمْ ، ومنها أُخْرِجُهُمْ تارةً أُخْرَى ، فتُطْرَحُ رُوحُهُ من السماءِ طَرْحًا حتى تَقَعَ في جَسَدِهِ ثم قرأ :  {وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ}  فتُعادُ رُوحُهُ في جَسَدِهِ ، قال : فإنه لَيَسْمَعُ خَفْقَ نِعالِ أصحابِهِ إذا وَلَّوْا عنه . ويَأْتِيهِ مَلَكانِ شَدِيدَا الانتهارِ ، فَيَنْتَهِرَانِهِ ، ويُجْلِسَانِهِ ، فيَقُولانِ له : مَن ربُّكَ ؟ فيقولُ : هاه هاه لا أَدْرِي ، فيقولانِ له : مادِينُكَ ؟ فيقولُ : ها هاه لا أَدْرِي ، فيقولانِ : فما تَقُولُ في هذا الرجلِ الذي بُعِثَ فيكم ؟ فلا يَهْتَدِي لاسْمِهِ ، فيُقالُ : مُحَمَّدٌ ! فيقولُ : هاه هاه لا أَدْرِي سَمِعْتُ الناسَ يقولونَ ذاك ! قال : فيُقالُ : لا دَرَيْتَ ، ولا تَلَوْتَ ، فيُنادِي مُنَادٍ من السماءِ أن : كَذَبَ ، فأَفْرِشُوا له من النارِ ، وافْتَحُوا له بابًا إلى النارِ ، فيَأْتِيهِ من حَرِّها وسَمُومِها ، ويُضَيَّقُ عليه قَبْرُهُ حتى تَخْتَلِفَ فيه أضلاعُه ، ويَأْتِيهِ وفي روايةٍ : ويُمَثَّلُ له رجلٌ قبيحُ الوجهِ ، قبيحُ الثيابِ ، مُنْتِنُ الرِّيحِ ، فيقولُ : أَبْشِرْ بالذي يَسُوؤُكَ ، هذا يومُكَ الذي كنتَ تُوعَدُ ، فيقولُ : وأنت فَبَشَّرَكَ اللهُ بالشرِّ مَن أنت ؟ فوجهُك الوجهُ يَجِيءُ بالشرِّ ! فيقولُ : أنا عملُكَ الخبيثُ ، فواللهِ ما عَلِمْتُ إلا كنتُ بطيئًا عن طاعةِ اللهِ ، سريعًا إلى معصيةِ اللهِ ، فجزاك الله شرًّا ، ثم يُقَيَّضُ له أَعْمَى أَصَمُّ أَبْكَمُ في يَدِهِ مِرْزَبَّةٌ ! لو ضُرِبَ بها جبلٌ كان ترابًا ، فيَضْرِبُهُ ضَرْبَةً حتى يَصِيرَ بها ترابًا ، ثم يُعِيدُهُ اللهُ كما كان ، فيَضْرِبُهُ ضَرْبَةً أُخْرَى ، فيَصِيحُ صَيْحَةً يَسْمَعُهُ كلُّ شيءٍ إلا الثَّقَلَيْنِ ، ثم يُفْتَحُ له بابٌ من النارِ ، ويُمَهَّدُ من فُرُشِ النارِ ، فيقولُ : رَبِّ لا تُقِمِ الساعةَ ."],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"القسم الأول منه إلى قوله: وكأن على رؤوسنا الطير صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (4753)، وأحمد (18558) باختلاف يسير، والنسائي (2001)، وابن ماجه (1549) مختصراً","bab":"دفن ومقابر › سؤال الملكين وفتنة القبر","dorar":"pUmebMAe"},{"id":"س-05414","fp":"c3538977a705","stateId":647,"easy":"إذا مت مؤمناً ← يسلّم عليك ملك الموت","cause":"مؤمنٍ","result":"يَقبِضُ روحَهُ إلَّا سَلَّمَ عليه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 3383","srcLabel":"ابن أبي شيبة","text":["عنِ البَراءِ بنِ عازِبٍ رَضيَ اللهُ عنه: {تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُ سَلَامٌ} [الأحزاب: 44] قالَ: يومَ يَلْقَوْنَ ملَكَ الموتِ ليس مِن ",["مؤمنٍ",1]," ",["يَقبِضُ روحَهُ إلَّا سَلَّمَ عليه",2],"."],"grade":"صحيح","narrator":"محمد بن مالك","muhaddith":"صحيح الإسناد","takhrij":"أخرجه ابن أبي شيبة (34767)، وابن عدي في ((الكامل)) (5/ 418)، والدينوري في ((المجالسة وجواهر العلم)) (367) جميعا باختلاف يسير.","bab":"رقائق وزهد › الحب للقاء الله","dorar":"kdzsEIET"},{"id":"س-08096","fp":"2ec0d065462d","stateId":647,"easy":"إذا احتضرت وأنت مؤمن ← يأتيك ملك الموت في أحسن صورة وأطيب ريح","cause":"أن المؤمنَ إذا احتضر","result":"أتاه ملكُ الموتِ في أحسنِ صورةٍ وأطيبِه ريحًا فجلس عنده لقبضِ روحِه وأتاه ملكان بحَنوطٍ من الجنةِ وكانا منه على بعد فاستخرج ملَكُ الموتِ روحَه من جسدِه رشحًا فإذا صارت إلى ملكِ الموتِ ابتدرها الملكانِ فأخذاها منه فحنطاها بحنوطٍ من الجنةِ وكفناها بكفنٍ من الجنةِ ثم عرجا به إلى الجنةِ فتفتحُ له أبوابُ السماءِ وتستبشرُ الملائكةُ بها ويقولان لمن هذه الروحُ الطيبةُ التي فتحت لها أبوابُ السماءِ ؟ ويسمى بأحسنِ الأسماءِ التي كان يسمى بها في الدنيا ، فيقالُ هذه روحُ فلانٍ فإذا صعد بها إلى السماءِ شيّعها مقربو كلِّ سماءٍ حتى توضعَ بين يدي اللهِ عند العرشِ فيخرجُ عملُها من عليين فيقولُ اللهُ عز وجل للمقربين اشهدوا أني قد غفرتُ لصاحبِ هذا العملِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[11],"ref":"الروح 1/272","srcLabel":"أبو داود","text":["عن البراءِ بنِ عازبٍ قال كنا في جنازةِ رجلٍ من الأنصارِ ومعنا رسولُ اللهِ صلى اللهُ عليهِ وسلَّمَ فقال ",["أن المؤمنَ إذا احتضر",1]," ",["أتاه ملكُ الموتِ في أحسنِ صورةٍ وأطيبِه ريحًا فجلس عنده لقبضِ روحِه وأتاه ملكان بحَنوطٍ من الجنةِ وكانا منه على بعد فاستخرج ملَكُ الموتِ روحَه من جسدِه رشحًا فإذا صارت إلى ملكِ الموتِ ابتدرها الملكانِ فأخذاها منه فحنطاها بحنوطٍ من الجنةِ وكفناها بكفنٍ من الجنةِ ثم عرجا به إلى الجنةِ فتفتحُ له أبوابُ السماءِ وتستبشرُ الملائكةُ بها ويقولان لمن هذه الروحُ الطيبةُ التي فتحت لها أبوابُ السماءِ ؟ ويسمى بأحسنِ الأسماءِ التي كان يسمى بها في الدنيا ، فيقالُ هذه روحُ فلانٍ فإذا صعد بها إلى السماءِ شيّعها مقربو كلِّ سماءٍ حتى توضعَ بين يدي اللهِ عند العرشِ فيخرجُ عملُها من عليين فيقولُ اللهُ عز وجل للمقربين اشهدوا أني قد غفرتُ لصاحبِ هذا العملِ",2]," ويختمُ كتابَه فيردّ في عليين فيقولُ اللهُ عز وجل ردوا روحَ عبدي إلى الأرضِ فإني وعدتهم أن أردهم فيها ثم قرأ رسولُ اللهِ صلى الله عليه وآله وسلم : { مِنْهَا خَلَقْنَاكُمْ وَفِيهَا نُعِيدُكُمْ وَمِنْهَا نُخْرِجُكُمْ تَارَةً أُخْرَى } فإذا وضع المؤمنُ في قبرِه فتح له بابٌ عند رجليه إلى الجنةِ فيقال له انظرْ إلى ما أعدّ اللهُ لك من الثوابِ ويفتحُ له بابٌ عند رأسِه إلى النارِ فيقالُ له انظرْ ما صرف اللهُ عنك من العذابِ ثم يقالُ له نمْ قريرَ العينِ فليس شيءٌ أحبَّ إليه من قيامِ الساعةِ وقال رسولُ اللهِ صلى الله عليه وآله وسلم إذا وضع المؤمنُ في لحدِه تقولُ له الأرضُ إن كنت لحبيبَا إليّ وأنت على ظهرِي فكيف إذا صرت اليوم في بطني سأريك ما أصنع بك فيفسحُ له في قبرِه مد بصرِه ، وقال رسولُ اللهِ صلى الله عليه وآله وسلم إذا وضع كافرٌ في قبرِه أتاه منكرٌ ونكيرٌ فيجلسانه فيقولان له من ربُّك ؟ فيقول لا أدري ، فيقولان له لا دريت فيضربانه ضربةً فيصيرُ رمادًا ثم يعادُ فيجلسُ ، فيقالُ ما قولك في هذا الرجلِ ؟ فيقولُ أي رجلٍ ؟ فيقولان محمدٌ صلى الله عليه وآله سلم فيقولُ قال الناسُ أنه رسولُ اللهِ صلى الله عليه وآله وسلم فيضربانه ضربةً فيصيرُ رمادًا"],"grade":"صحيح","narrator":"البراء بن عازب","muhaddith":"ثابت مشهور مستفيض صححه جماعة من الحفاظ ولا نعلم أحدا من أئمة الحديث طعن فيه بل رووه في كتبهم وتلقوه بالقبول","takhrij":"أخرجه أبو داود (4753) بنحوه، والنسائي (2001)، وابن ماجه (1549)، مختصرا.","bab":"ملائكة › أعمال الملائكة","dorar":"S6wyj1fv"},{"id":"س-06962","fp":"893a4ba3bb92","stateId":648,"easy":"إذا أحببت لقاء الله ← أحب الله لقاءك","cause":"مَن أحَبَّ لقاءَ اللهِ","result":"أحَبَّ اللهُ لقاءَه","explicit":true,"star":true,"similar":["س-05408","س-05410","س-05411"],"ref":"صحيح مسلم 2685","srcLabel":"مسلم","text":[["مَن أحَبَّ لقاءَ اللهِ ",1],["أحَبَّ اللهُ لقاءَه",2],"، ومَن كَرِهَ لقاءَ اللهِ كَرِهَ اللهُ لقاءَه. قال: فأتَيتُ عائِشةَ، فقُلتُ: يا أُمَّ المُؤمِنينَ، سَمِعتُ أبا هُرَيرةَ يَذكُرُ عن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَديثًا إن كان كَذلك فقد هَلَكنا، فقالت: إنَّ الهالِكَ مَن هَلَكَ بقَولِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم! وما ذاكَ؟ قال: قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: مَن أحَبَّ لقاءَ اللهِ أحَبَّ اللهُ لقاءَه، ومَن كَرِهَ لقاءَ اللهِ كَرِهَ اللهُ لقاءَه، وليسَ مِنَّا أحَدٌ إلَّا وهو يَكرَهُ المَوتَ، فقالت: قد قالهُ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم، وليسَ بالذي تَذهَبُ إليه، ولَكِن إذا شَخَصَ البَصَرُ، وحَشرَجَ الصَّدرُ، واقشَعَرَّ الجِلدُ، وتَشَنَّجَتِ الأصابِعُ، فعِندَ ذلك مَن أحَبَّ لقاءَ اللهِ أحَبَّ اللهُ لقاءَه، ومَن كَرِهَ لقاءَ اللهِ كَرِهَ اللهُ لقاءَه."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2685)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"UyBTScsV","merged":9,"otherRefs":["تخريج المسند لشعيب 25831 (صحيح)","تخريج المسند لشاكر 16/231 (صحيح)","أطراف الغرائب 2/342 (صحيح)","تخريج المسند لشعيب 18283 (حسن)","صحيح النسائي 1837 (صحيح)","صحيح البخاري 6507 (صحيح)","تفسير القرآن العظيم 7/167 (صحيح)","صحيح مسلم 2684 (صحيح)"]},{"id":"س-05477","fp":"765f720dcd96","stateId":648,"easy":"إذا اجتمع في قلبك الرجاء والخوف عند الموت ← يعطيك الله ما ترجو ويؤمنك مما تخاف","cause":"لا يجتَمِعانِ في قَلبِ عَبدٍ في مِثْلِ هذا الموطِنِ","result":"إلَّا أعطاه الذي يرجو وأمَّنَه ممَّا يَخافُ","explicit":true,"otherNeedIds":[6],"ref":"الأحاديث المختارة 1587","srcLabel":"البخاري","text":["«دخل رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم على شابٍّ في الموتِ، فقال له: كيف تجِدُك؟ قال: أرجو اللهَ يا رَسولَ اللهِ وأخافُ ذُنوبي، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لا يجتَمِعانِ في قَلبِ عَبدٍ في مِثْلِ هذا الموطِنِ",1]," ",["إلَّا أعطاه الذي يرجو وأمَّنَه ممَّا يَخافُ»",2],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"رقائق وزهد › الرجاء مع الخوف","dorar":"Gm4RiOOq","merged":2,"otherRefs":["صحيح الترغيب 3383 (صحيح)"]},{"id":"س-05408","fp":"e9545898cc79","stateId":648,"easy":"إذا أحببت لقاء الله ← أحب الله لقاءك","cause":"إذا أحَبَّ العَبدُ لقائي","result":"أحبَبتُ لقاءَه","explicit":true,"repOf":"س-06962","otherNeedIds":[23],"ref":"تخريج المسند لشعيب 9822","text":["قال اللهُ عزَّ وجلَّ: ",["إذا أحَبَّ العَبدُ لقائي",1]," ",["أحبَبتُ لقاءَه",2],"، وإذا كَرِهَ العَبدُ لِقائي كرِهتُ لقاءَه، قال: فقيلَ لأبي هُرَيرةَ: ما منَّا مِن أحدٍ إلَّا وهو يَكرَهُ المَوتَ، ويَفظَعُ به، قال أبو هُرَيرةَ: إنَّه إذا كان ذلك كشَفَ له."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2685)، والنسائي (1834) مطولاً، وأحمد (9822) واللفظ له","bab":"رقائق وزهد › الحب للقاء الله","dorar":"iFBbNpAF","merged":2,"otherRefs":["صحيح النسائي 1834 (صحيح)"]},{"id":"س-05410","fp":"f58fb2c8f097","stateId":648,"easy":"إذا أحببت لقاء الله ← أحب الله لقاءك، وإن كرهته كره لقاءك","cause":"لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ عزَّ وجلَّ","result":"إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ","explicit":true,"repOf":"س-06962","ref":"تخريج المسند لشاكر 16/231","text":[["لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ عزَّ وجلَّ",1]," ",["إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ",2],". فأتَيتُ عائِشةَ، فقُلتُ: لَئِن كان ما ذكَرَ أبو هُرَيرةَ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ حَقًّا، لقد هلَكْنا. فقالت: إنَّما الهالِكُ مَن هلَكَ فيما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وما ذاك؟ قال: قال: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ. قالت: وأنا أشهَدُ أنِّي سمِعتُه يَقولُ ذلك، فهل تَدري لِمَ ذلك؟ إذا حَشرَجَ الصَّدرُ، وطَمَحَ البَصَرُ، واقْشَعَرَّ الجِلدُ، وتشَنَّجَتِ الأصابِعُ، فعِندَ ذلك مَن أحَبَّ لِقاءَ اللهِ، أحَبَّ اللهُ لِقاءَهُ، ومَن أبغَضَ لِقاءَ اللهِ، أبغَضَ اللهُ لِقاءَهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8556) بلفظه، ومسلم (2685)، والنسائي (1834) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الحب للقاء الله","dorar":"5ck8teVC"},{"id":"س-05411","fp":"42d85c212bee","stateId":648,"easy":"إذا أحببت لقاء الله ← أحب الله لقاءك","cause":"لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ","result":"إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ","explicit":true,"repOf":"س-06962","ref":"تخريج المسند لشاكر 16/231","text":["لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ عزَّ وجلَّ إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ. فأتَيتُ عائِشةَ، فقُلتُ: لَئِن كان ما ذكَرَ أبو هُرَيرةَ عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ حَقًّا، لقد هلَكْنا. فقالت: إنَّما الهالِكُ مَن هلَكَ فيما قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، وما ذاك؟ قال: قال: سمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يَقولُ: ",["لا يُحِبُّ رَجُلٌ لِقاءَ اللهِ",1]," ",["إلَّا أحَبَّ اللهُ لِقاءَهُ، ولا أبغَضَ رَجُلٌ لِقاءَ اللهِ إلَّا أبغَضَ اللهُ لِقاءَهُ",2],". قالت: وأنا أشهَدُ أنِّي سمِعتُه يَقولُ ذلك، فهل تَدري لِمَ ذلك؟ إذا حَشرَجَ الصَّدرُ، وطَمَحَ البَصَرُ، واقْشَعَرَّ الجِلدُ، وتشَنَّجَتِ الأصابِعُ، فعِندَ ذلك مَن أحَبَّ لِقاءَ اللهِ، أحَبَّ اللهُ لِقاءَهُ، ومَن أبغَضَ لِقاءَ اللهِ، أبغَضَ اللهُ لِقاءَهُ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (8556) بلفظه، ومسلم (2685)، والنسائي (1834) كلاهما بلفظ مقارب.","bab":"رقائق وزهد › الحب للقاء الله","dorar":"5ck8teVC"},{"id":"س-05415","fp":"e6ccef8857c9","stateId":648,"easy":"إذا وددت أن تخرج روحك للقاء الله ← فالله يحب لقاءك","cause":"ودَّ أنها قد خرجتْ","result":"واللهُ يحبُّ لقاءَه","explicit":true,"otherNeedIds":[23],"ref":"مسند عمر 2/502","srcLabel":"أحمد","text":["إنَّ المؤمنَ حين ينزلُ به الموتُ ويعاينُ ما يعاينُ ",["ودَّ أنها قد خرجتْ",1]," ",["واللهُ يحبُّ لقاءَه",2]," وإنَّ المؤمنَ يُصعَد برُوحهِ إلى السماءِ فتأتيه أرواحُ الْمُؤْمِنينَ فيَستخبرونه عن معارفِهم من أهلِ الأرضِ فإذا قال تركتُ فلانًا في الدُّنيا أعجبَهم ذلك وإذا قال إنَّ فلانًا قد فارق الدُّنيا قالوا ما جيءِ بروحِ ذاك إلينا وقد ذُهِبَ بروحِه إلى أرواحِ أهلِ النارِ وإنَّ المؤمنَ يُجلَسُ في قبرِهِ ويُسألُ مَن ربُّك فيقولُ ربيَ اللهُ ويُقالُ مَنْ نبيُّكَ فيقولُ نبيّ محمدٌ صلَّى اللهُ عليه وسلَّمَ فيُقالُ ما دينُك فيقولُ دينيَ الإسلامُ فيُفتحُ له بابٌ في قبرِهِ فيقالُ انظُرْ إلى مجلسِك نمْ قريرَ العينِ فيبعثُه اللهُ يومَ القيامةِ كأنما كانت رَقدَةً وإذا كان عدوَّ اللهِ ونزل به الموتُ ويُعاينُ ما يعاينُ ودَّ أنها لا تخرجُ أبدًا واللهُ يبغَضُ لقاءَه وإذا أُجلِسَ في قبرِهِ يُقالُ من ربُّك قال لا أدري قال لا دَرَيتَ ويُفتَحُ له بابٌ في قبرِهِ بابٌ من أبوابِ جهنمَ ثم يُضربُ ضربةً يَسمعُها خلقُ اللهِ إلا الثّقَلَينِ ثم يُقالُ نَمْ كما ينامُ المنهوشُ قال قلتُ يا أبا هريرةَ وما المنهوشُ قال نهشَتْهُ الدوابُّ والحيّاتُ ثم يَضيقُ عليه قبرُهُ حتى رأيتُ أبا هريرةَ نصبَ يدَه ثم كفَأها ثم شبَّك حتى تختلفَ أضلاعُهُ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"إسناده صحيح","takhrij":"أخرجه عبدالله بن أحمد في ((السنة)) (1447)، والبزار (9760)، وابن المقرئ في ((المعجم)) (11) باختلاف يسير","bab":"رقائق وزهد › الحب للقاء الله","dorar":"nERNGki9","merged":2,"otherRefs":["شرح الصدور 134 (صحيح)"]},{"id":"س-05536","fp":"9374083228ff","stateId":648,"easy":"إذا آمنت بالنبي ﷺ ← يُحبّب إليك لقاء الله ويُسهّل عليك قضاؤه","cause":"مَنْ آمَنَ بِكَ ، وشَهِدَ إنِّي رسولُكَ","result":"فَحَبِّبْ إليهِ لِقَاءَكَ ، وسَهِّلْ عليهِ قَضَاءَكَ ، أَقْلِلْ لهُ مِنَ الدنيا","explicit":true,"ijtihad":true,"ijtihadWhy":["دعاء أو ذكر لم يُذكر له أثر صريح"],"otherNeedIds":[54],"ref":"صحيح الترغيب 3488","srcLabel":"ابن حبان","text":["اللهم ",["مَنْ آمَنَ بِكَ ، وشَهِدَ إنِّي رسولُكَ",1]," ؛ ",["فَحَبِّبْ إليهِ لِقَاءَكَ ، وسَهِّلْ عليهِ قَضَاءَكَ ، أَقْلِلْ لهُ مِنَ الدنيا",2]," ، ومَنْ لمْ يُؤْمِنْ بِكَ ، ولمْ يَشْهَدْ إنِّي رسولُكَ ؛ فلا تُحَبِّبْ إليهِ لِقَاءَكَ ، ولا تُسَهِّلْ عليهِ قَضَاءَكَ ، وأَكْثِرْ لهُ مِنَ الدنيا ."],"grade":"صحيح","narrator":"فضالة بن عبيد","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان (208) واللفظ له، والطبري في ((مسند ابن عباس)) (485)، والطبراني (18/313) (808) باختلاف يسير.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"GwzSxkRh"}]}