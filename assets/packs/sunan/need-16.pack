{"schema":1,"kind":"sunan-chunk","version":"sunan-b53213585e2f","needId":16,"stateIds":[126,127,128],"items":[{"id":"س-06233","fp":"3c45368b9bc3","stateId":126,"easy":"إذا خرجت في طلب العلم ← تضع لك الملائكة أجنحتها رضاً بما تصنع","cause":"ما مِن خارِجٍ يَخرُجُ مِن بَيْتِه في طَلَبِ العِلمِ","result":"إلَّا وَضَعَتْ له المَلائِكةُ أجْنِحتَها رِضًا بما يَصنَعُ","explicit":true,"star":true,"otherNeedIds":[23],"ref":"الأحاديث المختارة 8 / 32","srcLabel":"متفق عليه","text":["«أتَيْتُ صَفْوانَ بنَ عَسَّالٍ المُرادِيَّ؛ فقالَ: ما جاءَ بك؟ قُلْتُ: جِئْتُ ابْتِغاءَ العِلمِ، قالَ: فإنِّي سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (",["ما مِن خارِجٍ يَخرُجُ مِن بَيْتِه في طَلَبِ العِلمِ",1]," ",["إلَّا وَضَعَتْ له المَلائِكةُ أجْنِحتَها رِضًا بما يَصنَعُ",2],"). قُلْتُ: جِئْتُ أسْأَلُك عن المَسْحِ على الخُفَّينِ، قالَ: نَعمْ، كُنْتُ في الجَيْشِ الَّذي بَعَثَه رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ فأمَرَنا أن نَمسَحَ على الخُفَّينِ إذا نحن أدْخَلْناهما على طُهورٍ ثَلاثًا إذا سافَرْنا، ولَيْلةً إذا أقَمْنَا، ولا نَخْلَعَهما مِن غائِطٍ ولا بَوْلٍ ولا نَوْمٍ، ولا نَخْلَعَهما إلَّا مِن جَنابةٍ، قالَ: وسَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: (إنَّ بالمَغرِبِ بابًا مَفْتوحًا للتَّوْبةِ مَسيرةَ سَبْعينَ سَنَةً لا يُغلَقُ حتَّى تَطلُعَ الشَّمْسُ مِن مَغرِبِها)»."],"grade":"صحيح","narrator":"صفوان بن عسال المرادي","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"سفر › المسح على الخفين في السفر","dorar":"AJf153QC","merged":3,"otherRefs":["فوائد الحنائي الحنائيات 2/1102 (حسن)","الأحاديث المختارة 8 / 45 (صحيح)"]},{"id":"س-06942","fp":"20dd059e954b","stateId":126,"easy":"إذا تعلّمت ← فالعلم بالتعلم","cause":"بالتَّعلُّمِ","result":"إنَّما العلمُ","explicit":true,"star":true,"ref":"تغليق التعليق 2/78","srcLabel":"متفق عليه","text":["يا أيُّها النَّاسُ تعلَّموا ",["إنَّما العلمُ",2]," ",["بالتَّعلُّمِ",1]," والفقهُ بالتَّفقُّهِ ومن يُردِ اللَّهُ بِه خيرًا يفقِّههُ في الدِّينِ"],"grade":"صحيح","narrator":"معاوية بن أبي سفيان","muhaddith":"الجملة الأخيرة منه حديث صحيح مشهور","takhrij":"أخرجه الطبراني (19/395) (929)، والبيهقي في ((المدخل إلى السنن الكبرى)) (352) باختلاف يسير، وقوله: \"ومن يردِ اللَّهُ بِهِ خيرًا يفقِّههُ في الدِّينِ\" أخرجه البخاري (71)، ومسلم (1037)","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"Npy1L0PA","merged":3,"otherRefs":["مختصر المقاصد 190 (صحيح)","مجمع الزوائد 1/133 (حسن)"]},{"id":"س-07047","fp":"f436a330ad21","stateId":126,"easy":"إذا كنت فقيهاً ← فأنت أشد على الشيطان من ألف عابد","cause":"فَقيهٌ واحِدٌ","result":"أشَدُّ على الشَّيْطانِ مِن ألْفِ عابِدٍ","explicit":true,"star":true,"otherNeedIds":[30],"ref":"الأحاديث المختارة 13 / 79","srcLabel":"متفق عليه","text":["«",["فَقيهٌ واحِدٌ",1]," ",["أشَدُّ على الشَّيْطانِ مِن ألْفِ عابِدٍ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"علم › الحث على طلب العلم","dorar":"0lhpt2Do"},{"id":"س-07762","fp":"7e0f0bb844af","stateId":126,"easy":"إذا لم تعلم فقلت «الله أعلم» ← فهو من فقهك","cause":"ومَن لم يَعلَم فليَقُلْ: اللهُ أعلَمُ","result":"فإنَّ مِن فِقهِ الرَّجُلِ","explicit":true,"star":true,"apply":{"k":"say","t":"«الله أعلم»"},"ref":"صحيح مسلم 2798","srcLabel":"البخاري","text":["جاءَ إلى عبدِ اللهِ رَجُلٌ فقال: تَرَكتُ في المَسجِدِ رَجُلًا يُفَسِّرُ القُرآنَ برَأيِه، يُفَسِّرُ هذه الآيةَ: {يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ} قال: يَأتي النَّاسَ يَومَ القيامةِ دُخانٌ، فيَأخُذُ بأنفاسِهم حتَّى يَأخُذَهم منه كَهَيئةِ الزُّكامِ، فقال عبدُ اللهِ: مَن عَلِمَ عِلمًا فليَقُلْ به، ",["ومَن لم يَعلَم فليَقُلْ: اللهُ أعلَمُ",1],"؛ ",["فإنَّ مِن فِقهِ الرَّجُلِ",2]," أن يَقولَ لما لا عِلمَ له به: اللهُ أعلَمُ، إنَّما كان هذا أنَّ قُرَيشًا لَمَّا استَعصَت على النَّبيِّ صلَّى اللهُ عليه وسلَّم، دَعا عليهم بسِنينَ كَسِني يوسُفَ، فأصابَهم قَحطٌ وجَهدٌ، حتَّى جَعَلَ الرَّجُلُ يَنظُرُ إلى السَّماءِ فيَرى بينَه وبينَها كَهَيئةِ الدُّخانِ مِنَ الجَهدِ، وحتَّى أكَلوا العِظامَ، فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم رَجُلٌ فقال: يا رَسولَ اللهِ، استَغفِرِ اللهَ لمُضَرَ؛ فإنَّهم قد هَلَكوا، فقال: لمُضَرَ! إنَّكَ لَجَريءٌ، قال: فدَعا اللهَ لهم، فأنزَلَ اللهُ عَزَّ وجَلَّ: {إنَّا كاشِفو العَذابِ قَليلًا إنَّكُم عائِدونَ} قال: فمُطِروا، فلَمَّا أصابَتهُمُ الرَّفاهيةُ، قال: عادوا إلى ما كانوا عليه، قال: فأنزَلَ اللهُ عَزَّ وجَلَّ: {فارتَقِب يَومَ تَأتي السَّماءُ بدُخانٍ مُبينٍ يَغشى النَّاسَ هذا عَذابٌ أليمٌ} {يَومَ نَبطِشُ البَطشةَ الكُبرى إنَّا مُنتَقِمونَ} قال: يَعني يَومَ بَدرٍ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4774) باختلاف يسير","bab":"قرآن › أسباب النزول","dorar":"y1W3eAC3"},{"id":"س-07774","fp":"48701d6419b2","stateId":126,"easy":"إذا آمنت بمتشابه القرآن وعملت بمحكمه ← تكون من الراسخين في العلم","cause":"الذين آمَنوا بمُتَشابِهِه، وعَمِلوا بمُحكَمِه","result":"الرَّاسِخُونَ فِي الْعِلْمِ","explicit":true,"star":true,"otherNeedIds":[14],"ref":"تخريج مشكل الآثار 2515","srcLabel":"البخاري","text":["إذا رأيْتُموهم فاحْذَروهم، وإذا رأيْتُموهم فاحْذَروهم، ثم نَزَعَ: {فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغَاءَ الْفِتْنَةِ} [آل عمران: 7] إلى قَولِه عزَّ وجلَّ: {إِلَّا اللَّهُ وَ",["الرَّاسِخُونَ فِي الْعِلْمِ",2],"} [آل عمران: 7]، ثم قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: الراسِخونَ في العِلْمِ همُ ",["الذين آمَنوا بمُتَشابِهِه، وعَمِلوا بمُحكَمِه",1],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطحاوي في ((مشكل الآثار)) (2515) واللفظ له، وابن بطة في ((الإبانة الكبرى)) (779) باختلاف يسير، والبخاري (4547) بمعناه.","bab":"قرآن › الاختلاف والمراء في القرآن","dorar":"Yf5JMdKa"},{"id":"س-07323","fp":"cb016d64b1a4","stateId":126,"easy":"إذا ابتغيت العلم والإيمان ← وجدتهما","cause":"فإنَّ العلمَ والإيمانَ مَكانَهما، مَن ابْتَغاهما","result":"وجَدَهما","explicit":true,"otherNeedIds":[15],"ref":"المستدرك على الصحيحين 8661","srcLabel":"مسلم","text":["عن مُعاذِ بنِ جَبلٍ رَضيَ اللهُ عنه، قال: تكونُ فِتنةٌ يَكثُرُ فيها المالُ، ويُفتَحُ فيها القرآنُ حتَّى يَقرَأَه المؤمنُ والمنافقُ، والصَّغيرُ والكبيرُ، والرَّجلُ والمرأةُ، يَقرَؤه الرَّجلُ سِرًّا فلا يُتَّبَعُ عليها، فيَقولُ: واللهِ لَأقْرَأنَّه عَلانيةً، ثمَّ يَقرَؤه عَلانيةً، فلا يُتَّبَعُ عليها، فيَتَّخِذُ مَسجدًا ويَبتدِعُ كَلامًا ليْس في كتابِ اللهِ ولا مِن سُنَّةِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، فإيَّاكم وإيَّاه؛ فإنَّ كلَّ ما ابتَدَعَ ضَلالةٌ. قال: ولَمَّا مَرِض مُعاذُ بنُ جَبلٍ مَرَضَه الَّذي قُبِض فيه كان يُغْشى عليه أحيانًا، ويُفِيقُ أحيانًا، حتَّى غُشِي عليه غَشْيةٌ ظَننَّا أنَّه قدْ قُبِض، ثمَّ أفاقَ وأنا مُقابِلُه أبْكي، فقال: ما يُبْكِيكَ؟ قُلتُ: واللهِ لا أبْكي على دُنْيا كُنتُ أنالُها منكَ، ولا على نَسبٍ بيْني وبيْنكَ، ولكنْ أبْكي على العلمِ والحُكمِ الَّذي أسْمَعُ منكَ يَذهَبُ، قال: فلا تَبْكِ؛ ",["فإنَّ العلمَ والإيمانَ مَكانَهما، مَن ابْتَغاهما",1]," ",["وجَدَهما",2],"، فابْتَغِه حيثُ ابْتَغاهُ إبراهيمُ عليه الصَّلاةُ والسَّلامُ؛ فإنَّه سَألَ اللهَ تعالَى وهو لا يَعلَمُ، وتَلا: {إِنِّي ذَاهِبٌ إِلَى رَبِّي سَيَهْدِينِ} [الصافات: 99]، وابْتَغِه بَعْدي عِندَ أربعةِ نَفرٍ، وإنْ لم تَجِدْه عِندَ واحدٍ منهم، فسَلْ عن النَّاسِ أعيانَه: عبدُ اللهِ بنُ مَسعودٍ، وعبدُ اللهِ بنُ سَلَامٍ، وسَلْمانُ، وعُوَيمرٌ أبو الدَّرداءِ. وإيَّاكَ وزَيْغةَ الحكيمِ وحِكَمَ المنافِقِ قال: قُلتُ: وكيْف لي أنْ أعلَمَ زَيْغةَ الحكيمِ؟ قال: كَلمةُ ضَلالةٍ يُلْقِيها الشَّيطانُ على لِسانِ الرَّجلِ، فلا يَحمِلُها ولا يَتأمَّلُ منه، فإنَّ المنافِقَ قدْ يَقولُ الحقَّ، فخُذِ العلمَ أنَّى جاءك؛ فإنَّ على الحقِّ نُورًا، وإيَّاكَ ومُعضِلاتِ الأُمورِ."],"grade":"صحيح","narrator":"يزيد بن عميرة","muhaddith":"صحيح على شرط مسلم، ولم يخرجاه","takhrij":"أخرجه الفسوي في ((المعرفة والتاريخ)) (2/ 550)، وابن عساكر في ((تاريخه)) (65/ 340) كلاهما باختلاف يسير.","bab":"فتن › فتنة المال","dorar":"Cu7zb5vt","merged":2,"otherRefs":["المستدرك على الصحيحين 338 (صحيح)"]},{"id":"ق-0118","fp":"d18a259c866b","stateId":126,"easy":"التقوى ← تعليم الله لعبده","cause":"التقوى","result":"تعليم الله لعبده","explicit":true,"ref":"سورة البقرة: 282","srcLabel":"القرآن الكريم","quran":{"s":2,"from":282,"to":282,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَى أَجَلٍ مُسَمًّى فَاكْتُبُوهُ وَلْيَكْتُبْ بَيْنَكُمْ كَاتِبٌ بِالْعَدْلِ وَلَا يَأْبَ كَاتِبٌ أَنْ يَكْتُبَ كَمَا عَلَّمَهُ اللَّهُ فَلْيَكْتُبْ وَلْيُمْلِلِ الَّذِي عَلَيْهِ الْحَقُّ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا يَبْخَسْ مِنْهُ شَيْئًا فَإِنْ كَانَ الَّذِي عَلَيْهِ الْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَنْ يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُ بِالْعَدْلِ وَاسْتَشْهِدُوا شَهِيدَيْنِ مِنْ رِجَالِكُمْ فَإِنْ لَمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَامْرَأَتَانِ مِمَّنْ تَرْضَوْنَ مِنَ الشُّهَدَاءِ أَنْ تَضِلَّ إِحْدَاهُمَا فَتُذَكِّرَ إِحْدَاهُمَا الْأُخْرَى وَلَا يَأْبَ الشُّهَدَاءُ إِذَا مَا دُعُوا وَلَا تَسْأَمُوا أَنْ تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَى أَجَلِهِ ذَلِكُمْ أَقْسَطُ عِنْدَ اللَّهِ وَأَقْوَمُ لِلشَّهَادَةِ وَأَدْنَى أَلَّا تَرْتَابُوا إِلَّا أَنْ تَكُونَ تِجَارَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا وَأَشْهِدُوا إِذَا تَبَايَعْتُمْ وَلَا يُضَارَّ كَاتِبٌ وَلَا شَهِيدٌ وَإِنْ تَفْعَلُوا فَإِنَّهُ فُسُوقٌ بِكُمْ وَاتَّقُوا اللَّهَ وَيُعَلِّمُكُمُ اللَّهُ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ (282)","hl":[[1072,1114,1]]}},{"id":"ق-0139","fp":"2262203822eb","stateId":126,"easy":"تعليم الكتاب ودراسته ← الربّانية","cause":"تعليم الكتاب ودراسته","result":"الربّانية","explicit":true,"ref":"سورة آل عمران: 79","srcLabel":"القرآن الكريم","quran":{"s":3,"from":79,"to":79,"text":"مَا كَانَ لِبَشَرٍ أَنْ يُؤْتِيَهُ اللَّهُ الْكِتَابَ وَالْحُكْمَ وَالنُّبُوَّةَ ثُمَّ يَقُولَ لِلنَّاسِ كُونُوا عِبَادًا لِي مِنْ دُونِ اللَّهِ وَلَكِنْ كُونُوا رَبَّانِيِّينَ بِمَا كُنْتُمْ تُعَلِّمُونَ الْكِتَابَ وَبِمَا كُنْتُمْ تَدْرُسُونَ (79)","hl":[[154,244,1]]}},{"id":"ق-0609","fp":"ef66fd657670","stateId":126,"easy":"ترك ملة الكفر واتباع ملة التوحيد ← تعليم الله","cause":"ترك ملة الكفر واتباع ملة التوحيد","result":"تعليم الله","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة يوسف: 37","srcLabel":"القرآن الكريم","quran":{"s":12,"from":37,"to":37,"text":"قَالَ لَا يَأْتِيكُمَا طَعَامٌ تُرْزَقَانِهِ إِلَّا نَبَّأْتُكُمَا بِتَأْوِيلِهِ قَبْلَ أَنْ يَأْتِيَكُمَا ذَلِكُمَا مِمَّا عَلَّمَنِي رَبِّي إِنِّي تَرَكْتُ مِلَّةَ قَوْمٍ لَا يُؤْمِنُونَ بِاللَّهِ وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ (37)","hl":[[107,234,1]]}},{"id":"س-07019","fp":"019cb5d5ab53","stateId":126,"easy":"إذا قيّدت العلم بالكتابة ← حفظته","cause":"بِالكِتابِ","result":"قَيِّدوا العِلْمَ","explicit":true,"ref":"المستدرك على الصحيحين 364","srcLabel":"ابن أبي شيبة","text":["أنَّه سَمِعَ عُمَرَ بنَ الخَطَّابِ يَقولُ: ",["قَيِّدوا العِلْمَ",2]," ",["بِالكِتابِ",1],"."],"grade":"صحيح","narrator":"عبد الملك بن عبدالله بن أبي سفيان","muhaddith":"[ صحيح]","takhrij":"أخرجه ابن أبي شيبة (26427)، والدارمي (514)، والرامهرمزي ((المحدث الفاصل)) (ص: 377) واللفظ لهم","bab":"علم › الحث على طلب العلم","dorar":"0URjUkXA","merged":3,"otherRefs":["المستدرك على الصحيحين 365 (صحيح)","مجمع الزوائد 1/157 (صحيح)"]},{"id":"س-05831","fp":"a1fe932459ad","stateId":126,"easy":"إذا تذاكرت العلم ← بقي، وإلا اندرس","cause":"تَذاكَروا الحَديثَ","result":"فَإنَّكُم إلَّا تَفْعَلوا يَنْدَرِسْ","explicit":true,"ref":"المستدرك على الصحيحين 328","srcLabel":"ابن عبد","text":["قالَ عَليٌّ رَضيَ اللهُ تعالى عنه: ",["تَذاكَروا الحَديثَ",1],"؛ ",["فَإنَّكُم إلَّا تَفْعَلوا يَنْدَرِسْ",2],"."],"grade":"صحيح","narrator":"عبدالله بن بريدة","muhaddith":"[صحيح على شرط الشيخين]","takhrij":"أخرجه ابن عبد البر ((جامع بيان العلم)) (687) واللفظ له، وابن أبي شيبة (26134)، والدارمي (650) بلفظ مقارب","bab":"رقائق وزهد › الوصايا النافعة","dorar":"R3vhJcOB","merged":2,"otherRefs":["المستدرك على الصحيحين 329 (صحيح)"]},{"id":"س-07086","fp":"68f7ff570167","stateId":126,"easy":"إذا تعلمت الفرائض وعلّمتها ← فهي نصف العلم","cause":"تعلَّموا الفرائضَ وعلِّموه الناسَ","result":"فإنه نصفُ العلمِ","explicit":true,"similar":["س-07794"],"ref":"النوافح العطرة 104","srcLabel":"ابن ماجه","text":[["تعلَّموا الفرائضَ وعلِّموه الناسَ",1]," ",["فإنه نصفُ العلمِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مطولاً ابن ماجه (2719)، وابن حبان في ((المجروحين)) (1/293)، والدارقطني (4/67) واللفظ له.","bab":"علم › تعليم الناس وفضل ذلك","dorar":"OrKvFQ2G","merged":2,"otherRefs":["مختصر المقاصد 315 (حسن)"]},{"id":"س-01149","fp":"9a96ace3f44d","stateId":126,"easy":"إذا أدمت الذهاب إلى المسجد ← تصيب آية محكمة أو رحمة أو علماً أو أخاً","cause":"مَنْ أدامَ الاختلافَ إلى المسجدِ","result":"أصابَ آيةً مُحكَمةً ، أوْ رحمةً مُنتظِرَةً ، أوْ عِلمًا مُستطرَفًا ، أوْ كلمةً تَزيدُهُ هُدًى أوْ تَرُدَّهُ عن رَدًى ، أوْ يدَعُ الذنوبَ خشيةً أوْ حياءً","explicit":true,"otherNeedIds":[23],"ref":"البحر الزخار 4/173","srcLabel":"البزار","text":["أتيتُ المدينةَ أزورُ ابنةَ عمٍّ لِي تحتَ الحسَنِ بنِ علِيٍّ فشهِدتُ معهُ صلاةَ الصُّبحِ في مَسجدِ الرسولِ ، وأصبحَ ابنُ الزُّبيرِ قدْ أوْلَمَ ، فأتى رسولُ ابنِ الزبيرِ ، فقال : يا ابنَ رسولِ اللهِ ! إنَّ ابنَ الزُّبيرِ أصبحَ قدْ أوْلَمَ وقدْ أرسلَنِي إليكَ ، فلَمْ يلْتفِتْ إليه ، فطافَ في المسجِدِ فتفرى الخلقَ يدعُوهمْ ، ثُمَّ رجعَ إلى الحسَنِ فقال : يا ابنَ رسولِ اللهِ ! ابنُ الزُّبيرِ قدْ أولَمَ وقدْ أرسلَنِي إليكَ ، فالتفتَ إليَّ فقال : هل طلَعتْ الشمسُ ؟ قِيلَ : لا أحسِبُ إلَّا قدْ طلَعتْ فقال : الحمدُ للهِ الَّذي أطلَعَها من مطلِعِها ثُمَّ قال : سمعتُ أبِي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : مَنْ صلَّى الغَداةَ ثُمَّ قعدَ يذكرُ اللهَ حتى تطلَُع الشمسُ جعلَ اللهُ بينهُ وبينَ النارِ سِتْرًا ، ثُم قال : قومُوا فأجِيبوا ابنَ الزُّبيرِ ، فلَمّا انتهيْنا إلى البابِ تلَقَّاهُ ابنُ الزبيرِ على البابِ ، فقال : يا ابنَ رسولِ اللهِ ! أبطأْتَ عنِّي في هذا اليومِ فقال : أمَا إنِّي قدْ أجبتُكمْ أنِّي صائِمٌ ، ثُمَّ قال : فهاهُنا تُحفةٌ ، فقال الحسَنُ بنُ علِيٍّ : سمعتُ أبِي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : تُحفَةُ الصائِمِ الزَّائِرِ أنْ تُغلَّفَ لِحيتُهُ ، وتُجْمَّرَ ثيابُه وتُذَرَّرَ . وتُحفةُ المرأةِ الصائِمةِ الزائِرَةِ أنْ تُمَشَّطَ رأسُها ، وتُجمَّرَ ثيابُها وتُذرَّرَ ، قال : قُلتُ : يا ابنَ رسولِ اللهِ ! أعِدْ عليَّ الحديثَ : قال : سمعتُ أبي وجدِّي - يعني : النبيَّ صلَّى اللهُ عليه وسلَّمَ - يقولُ : ",["مَنْ أدامَ الاختلافَ إلى المسجدِ ",1],["أصابَ آيةً مُحكَمةً ، أوْ رحمةً مُنتظِرَةً ، أوْ عِلمًا مُستطرَفًا ، أوْ كلمةً تَزيدُهُ هُدًى أوْ تَرُدَّهُ عن رَدًى ، أوْ يدَعُ الذنوبَ خشيةً أوْ حياءً",2]],"grade":"صحيح","narrator":"الحسن بن علي بن أبي طالب","muhaddith":"محفوظ","takhrij":"أخرجه البزار (1335)","bab":"أدعية وأذكار › فضل الذكر","dorar":"hTD6x60n"},{"id":"س-05968","fp":"89a1de5bc046","stateId":126,"easy":"إذا عملت بما تعلم ← ينفعك الله بعلمك","cause":"تَعمَلوا بما تَعلَمون","result":"فلن يَنفَعَكم اللهُ حتَّى","explicit":true,"otherNeedIds":[45],"ref":"فيض القدير 3/ 253","srcLabel":"فيض القدير","text":["عن معاذٍ رَضِيَ اللهُ عنه: تَعَلَّموا ما شِئتُم أن تَعَلَّموا؛ ",["فلن يَنفَعَكم اللهُ حتَّى",2]," ",["تَعمَلوا بما تَعلَمون",1]],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"رقائق وزهد › الوصايا النافعة","dorar":"CNmKwF7L"},{"id":"س-07037","fp":"712cac590b9b","stateId":126,"easy":"إذا تعلمت أربعين حديثاً تفقه بها في دينك ← تكون فقيهاً عالماً","cause":"منْ تعلَّمَ من أمتي أربعينَ حديثًا يفقهُ بها في دِينهِ","result":"كان فقيهًا عالمًا","explicit":true,"otherNeedIds":[41],"ref":"جامع بيان العلم 1/198","srcLabel":"ابن عدي","text":[["منْ تعلَّمَ من أمتي أربعينَ حديثًا يفقهُ بها في دِينهِ",1]," ",["كان فقيهًا عالمًا",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"ليس يروى هذا الحديث عن النبي صلى الله عليه وسلم من وجه ثابت","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (3/42)، وابن الجوزي في ((العلل المتناهية)) (170) باختلاف يسير","bab":"علم › الحث على طلب العلم","dorar":"TCVbFxfT"},{"id":"س-07042","fp":"84fb17fa2664","stateId":126,"easy":"إذا اكتسبت علماً يهديك إلى هدى أو يردك عن ردى ← فهو أفضل كسب","cause":"علمٍ يَهْدي صاحبَهُ إلى هدًى أو يردُّهُ عن ردًى","result":"ما اكتسبَ مُكْتسبٌ مثلَ فضلِ","explicit":true,"otherNeedIds":[41],"ref":"الترغيب والترهيب 1/76","srcLabel":"الطبراني","text":[["ما اكتسبَ مُكْتسبٌ مثلَ فضلِ",2]," ",["علمٍ يَهْدي صاحبَهُ إلى هدًى أو يردُّهُ عن ردًى",1]," وما استقامَ دينُهُ حتَّى يستقيمَ عملُهُ"],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحارث في ((المسند)) (813) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4726) واللفظ له، والبيهقي في ((شعب الإيمان)) (4660) مختصراً بنحوه","bab":"علم › الحث على طلب العلم","dorar":"KmsGizJM"},{"id":"س-07051","fp":"ccd46f64e20e","stateId":126,"easy":"إذا كان علمك في قلبك ← فهو العلم النافع","cause":"فعِلمٌ في القلبِ","result":"فذلك العِلمُ النَّافعُ","explicit":true,"ref":"فيض القدير 4/ 391","srcLabel":"الدارمي","text":["العِلمُ عِلمان: ",["فعِلمٌ في القلبِ",1]," ",["فذلك العِلمُ النَّافعُ",2],"، وعلمٌ على اللِّسانِ فذلك حُجَّةُ اللهِ على ابنِ آدَمَ"],"grade":"صحيح","narrator":"الحسن البصري","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدارمي (376) وابن المبارك في ((الزهد)) (1161)  وابن أبي شيبة (35502) واللفظ لهم","bab":"علم › الحث على طلب العلم","dorar":"P2NJ3j6u"},{"id":"س-07049","fp":"cb53b1065935","stateId":126,"easy":"إذا جهلت فاسأل ← فإنما شفاء العيّ السؤال","cause":"السُّؤالُ","result":"فإنَّما شِفاءُ العِيِّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الروضة الندية 1/60","srcLabel":"أبو داود","text":["خَرَجنا في سَفرٍ فأصابَ رَجُلًا مِنَّا حَجَرٌ فشَجَّه في رَأسِه ثُمَّ احتَلمَ فسَأل أصحابَه هَل تَجِدونَ له رُخصةً في التَّيَمُّمِ؟ فقالوا: ما نَجِدُ لك رُخصةً وأنت تَقدِرُ على الماءِ، فاغتَسَل فماتَ، فلمَّا قَدِمنا على رَسولِ اللهِ صَلَّى اللهُ وسَلَّمَ عليه أخبَرناه بذلك، فقال: \"قَتَلوه قَتلهمُ اللهُ، ألَا سَألوا إذ لم يَعلَموا؛ ",["فإنَّما شِفاءُ العِيِّ",2]," ",["السُّؤالُ",1],"، إنَّما كان يَكفيه أن يَتَيَمَّمَ ويَعصِبَ على جُرحِه ثُمَّ يَمسَحَ عليه ويَغسِلَ سائِرَ جَسَدِه\"."],"grade":"صحيح","narrator":"جابر","muhaddith":"[صحيح]","takhrij":"أخرجه أبو داود (336) واللفظ له، والبيهقي (1075)، والدارقطني (729)","bab":"علم › الحث على طلب العلم","dorar":"DTsWebH6","merged":4,"otherRefs":["الأحاديث المختارة 11 / 214 (صحيح)","رفع الأستار 51 (صحيح)","تحفة المحتاج 1/225 (صحيح)"]},{"id":"س-05449","fp":"05d991aee530","stateId":126,"easy":"إذا عبدت الله ← كفى بك فقهاً","cause":"إذا عبدَ اللهَ","result":"كفى بالمرءِ فقهًا","explicit":true,"ref":"الجامع الصغير 6222","srcLabel":"الطبراني","text":[["كفى بالمرءِ فقهًا",2]," ",["إذا عبدَ اللهَ",1],"، و كفى بالمرءِ جهلًا إذا أعجبَ برأيِهِ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن المتن","takhrij":"أخرجه مطولاً الطبراني (13/619) (14541) واللفظ له، وأبو نعيم في ((حلية الأولياء)) (5/173)، والبيهقي في ((المدخل إلى السنن)) (453) باختلاف يسير","bab":"رقائق وزهد › الخوف من الله","dorar":"imXqvPrA"},{"id":"س-07794","fp":"0028b06537a3","stateId":126,"easy":"إذا تعلمت القرآن والفرائض وعلّمتها الناس ← تحفظ العلم من الضياع","cause":"تَعَلَّمُوا القرآنَ وعلِّمُوهُ الناسَ وتعلَّمُوا الفرائِضَ وعلِّمُوها الناسَ","result":"أوْشَكَ أنْ يَأْتِيَ عَلَى الناسِ زمانٌ يختَصِمُ الرجلانِ في الفريضةِ فلا يَجِدَانِ مَنْ يَقْضِي بَيْنَهُمَا","explicit":true,"repOf":"س-07086","otherNeedIds":[47],"ref":"مجمع الزوائد 4/226","text":[["تَعَلَّمُوا القرآنَ وعلِّمُوهُ الناسَ وتعلَّمُوا الفرائِضَ وعلِّمُوها الناسَ",1]," ",["أوْشَكَ أنْ يَأْتِيَ عَلَى الناسِ زمانٌ يختَصِمُ الرجلانِ في الفريضةِ فلا يَجِدَانِ مَنْ يَقْضِي بَيْنَهُمَا",2]],"grade":"حسن","narrator":"أبو بكرة نفيع بن الحارث","muhaddith":"فيه محمد بن عقبة السدوسي [وفيه] سعيد بن أبي كعب لم أجد من ترجمه وبقية رجاله ثقات","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4075)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"s4JyaeE9"},{"id":"س-00562","fp":"b02dba329f5e","stateId":126,"easy":"إذا تفقهت في الدين فعلمت وعلّمت ← ينفع الله بك كالأرض الطيبة تنبت الكلأ","cause":"مَنْ تَفَقَّهَ فى دينِ اللهِ ونفعه اللهُ بما بعثني اللهُ به ونَفَع به فَعَلِم وعَلَّمَ","result":"أجادِبُ أمسكَتِ الماءَ ، فنفع اللهُ به الناسَ فشرِبوا منها وزرعوا وسَقَوْا","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"تخريج كتاب السنة 903","srcLabel":"متفق عليه","text":["إنَّ مَثَلَ ما بعثني اللهُ به مِنَ الهُدَى والعِلمِ مَثَلُ غَيْثٍ أصاب الأرضَ وكانت منه ",["أجادِبُ أمسكَتِ الماءَ ، فنفع اللهُ به الناسَ فشرِبوا منها وزرعوا وسَقَوْا",2]," وأصاب طائفةً منهم أخرى إنما هي قِيعانٌ لا يُنْبِتُ ولا يُمْسِكُ ولا يُنْبِتُ كَلَأً فذلك مَثَلُ ",["مَنْ تَفَقَّهَ فى دينِ اللهِ ونفعه اللهُ بما بعثني اللهُ به ونَفَع به فَعَلِم وعَلَّمَ",1]," ، ومَثَلُ مَنْ لم يَرْفَعْ بذلك رأسًا ولم يَقبلْ هُدى اللهِ الذي أُرْسِلْتُ به"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه البخاري (79)، ومسلم (2282)، وأحمد (19573)، وابن حبان (3822) واللفظ لهم.","bab":"آداب عامة › ضرب الأمثال","dorar":"RNpo4ySJ"},{"id":"س-00950","fp":"f1574ee03478","stateId":126,"easy":"إذا كنت لا تشبع من العلم وتجمع علم الناس إلى علمك ← فأنت أعلم عباد الله","cause":"عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه","result":"فأيُّ عبادِك أعلَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 6217","srcLabel":"متفق عليه","text":["سأَل موسى ربَّه عن ستِّ خِصالٍ كان يظُنُّ أنَّها له خالصةٌ والسَّابعةُ لم يكُنْ موسى يُحِبُّها قال : يا ربِّ أيُّ عبادِك أتقى ؟ قال الَّذي يذكُرُ ولا يَنسى قال : فأيُّ عبادِك أهدى ؟ قال : الَّذي يتَّبِعُ الهُدى قال : فأيُّ عبادِك أحكَمُ ؟ قال : الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه قال : ",["فأيُّ عبادِك أعلَمُ",2]," ؟ قال : ",["عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه",1]," قال فأيُّ عبادِك أعَزُّ ؟ قال : الَّذي إذا قدَر غفَر قال : فأيُّ عبادِك أغنى ؟ قال : الَّذي يَرضى بما يُؤتَى قال : فأيُّ عبادِك أفقَرُ ؟ قال : صاحبٌ منقوصٌ ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ليس الغِنى عن ظَهْرٍ إنَّما الغِنى غِنى النَّفسِ وإذا أراد اللهُ بعبدٍ خيرًا جعَل غناه في نفسِه وتُقاهُ في قلبِه وإذا أراد اللهُ بعبدٍ شرًّا جعَل فقرَه بيْنَ عينَيْهِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (61/ 134) بلفظه، والبخاري (6446)، ومسلم (1051) كلاهما مختصرا ببعض لفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"BWzqJ8PQ"},{"id":"س-07699","fp":"2bde898d512a","stateId":126,"easy":"إذا تعلمت الآيات علماً وعملاً قبل أن تتجاوزها ← تجمع العلم والعمل (من فعل الصحابة)","cause":"عَشْرَ آياتٍ، فلا يَأخُذونَ في العَشْرِ الأُخرى حتى يَعلَموا ما في هذه مِن العِلْمِ والعَمَلِ","result":"فعَلِمْنا العِلْمَ والعَمَلَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 23482","srcLabel":"أحمد","text":["عن أبي عبدِ الرَّحمنِ قال: حَدَّثَنا مَن كان يُقرِئُنا مِن أصْحابِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، أنَّهم كانوا يَقتَرِئونَ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["عَشْرَ آياتٍ، فلا يَأخُذونَ في العَشْرِ الأُخرى حتى يَعلَموا ما في هذه مِن العِلْمِ والعَمَلِ",1],"، قالوا: ",["فعَلِمْنا العِلْمَ والعَمَلَ",2],"."],"grade":"حسن","narrator":"رجل من الصحابة","muhaddith":"إسناده حسن","takhrij":"أخرجه أحمد (23482) واللفظ له، وابن أبي شيبة (30549)، والطحاوي في ((شرح مشكل الآثار)) (1451)","bab":"قرآن › آداب معلم القرآن ومتعلمه","dorar":"KrcYU84X","merged":2,"otherRefs":["تخريج مشكل الآثار 1452 (حسن)"]},{"id":"س-05983","fp":"68ddfbf99efd","stateId":126,"easy":"إذا اتقيت الله فيما تعلم ← فهي كلمة جامعة تحفظ بها علمك","cause":"اتَّقِ اللهَ فيما تعلمُ","result":"بكلمةٍ تكونُ جِماعًا","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"عارضة الأحوذي 5/348","srcLabel":"الترمذي","text":["قال يزيدُ بنُ سلَمةَ يا رسولَ اللهِ إني سمعتُ منك حديثًا كثيرًا أخافُ أن يُنسيَني أولُه آخرَهُ فحدِّثْني ",["بكلمةٍ تكونُ جِماعًا",2]," قال ",["اتَّقِ اللهَ فيما تعلمُ",1]],"grade":"صحيح","narrator":"يزيد بن سلمة الجعفي","muhaddith":"صحيح المعنى","takhrij":"أخرجه الترمذي (2683)، وهناد في ((الزهد)) (2683)، وابن قانع في ((معجم الصحابة)) (224)، والطبراني (22/ 242/ 633)، واللفظ لهم.","bab":"رقائق وزهد › تقوى الله","dorar":"S14qlH1R"},{"id":"س-00592","fp":"f2f7a0eae208","stateId":127,"easy":"إذا تعاهدت القرآن ← لم يتفلّت منك","cause":"تَعاهَدوا هذا القرآنَ","result":"فإنَّه وَحْشيٌّ، أَشدُّ تَفصِّيًا مِن صُدورِ الرِّجالِ مِنَ الإبلِ مِنْ عُقُلِها","explicit":true,"star":true,"similar":["س-05934"],"ref":"المستدرك على الصحيحين 2058","srcLabel":"مسلم","text":[["تَعاهَدوا هذا القرآنَ",1],"؛ ",["فإنَّه وَحْشيٌّ، أَشدُّ تَفصِّيًا مِن صُدورِ الرِّجالِ مِنَ الإبلِ مِنْ عُقُلِها",2],"، ولا يَقولنَّ أَحدُكُم: نَسيتُ آيةَ كَيتَ وكَيْتَ؛ بل هو نُسِّيَ."],"grade":"صحيح","narrator":"عبدالله","muhaddith":"صحيح الإسناد","takhrij":"أخرجه عبد الرزاق (5967)، والحميدي (91) واللفظ لهما، مسلم (790) باختلاف يسير","bab":"آداب عامة › ضرب الأمثال","dorar":"F8rLSmtJ","merged":3,"otherRefs":["صحيح الجامع 2956 (صحيح)","صحيح مسلم 791 (صحيح)"]},{"id":"س-00598","fp":"f981d916eeb9","stateId":127,"easy":"إذا قمت بالقرآن ليلاً ونهاراً ← حفظته وذكرته","cause":"قامَ صاحِبُ القُرآنِ فقَرَأه باللَّيلِ والنَّهارِ","result":"ذَكَرَه","explicit":true,"star":true,"ref":"صحيح مسلم 789","srcLabel":"البخاري","text":["إنَّما مَثَلُ صاحِبِ القُرآنِ كمَثَلِ الإبِلِ المُعَقَّلةِ، إن عاهَدَ عليها أمسَكَها، وإن أطلَقَها ذَهَبَت. [وفي روايةٍ]: وإذا ",["قامَ صاحِبُ القُرآنِ فقَرَأه باللَّيلِ والنَّهارِ",1]," ",["ذَكَرَه",2],"، وإذا لَم يَقُمْ به نَسيَه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5031) باختلاف يسير ودون الرواية المذكورة","bab":"آداب عامة › ضرب الأمثال","dorar":"KvqlitTc"},{"id":"س-01779","fp":"9465f09f2dd3","stateId":127,"easy":"إذا استذكرت القرآن ← حفظته (فهو أشد تفلّتاً من الإبل)","cause":"استذكروا القرآنَ","result":"لهو أشدُّ تفصِّيًا من صدورِ الرجالِ من النَّعَمِ من عُقُلِها","explicit":true,"star":true,"ref":"تخريج المسند لشاكر 6/27","srcLabel":"متفق عليه","text":["بئسما لأحدِكم أو بئسما لأحدِهم أن يقولَ نسيت آيةَ كِيتَ وكيت بل هو نُسِّيَ ",["استذكروا القرآنَ",1]," فوالذي نفسي بيدِه ",["لهو أشدُّ تفصِّيًا من صدورِ الرجالِ من النَّعَمِ من عُقُلِها",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (5032)، ومسلم (790)، والترمذي (2942)، والنسائي (943)، وأحمد (3960) واللفظ له.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"1OezJtNf"},{"id":"س-05934","fp":"29effb2ec308","stateId":127,"easy":"إذا تعاهدت المصاحف ← لم يتفلّت منك القرآن","cause":"تَعاهَدوا هذه المَصاحِفَ","result":"فلَهو أشَدُّ تَفَصِّيًا مِن صُدورِ الرِّجالِ مِنَ النَّعَمِ مِن عُقُلِه","explicit":true,"repOf":"س-00592","ref":"صحيح مسلم 790","text":[["تَعاهَدوا هذه المَصاحِفَ",1]," -ورُبَّما قال: القُرآنَ- ",["فلَهو أشَدُّ تَفَصِّيًا مِن صُدورِ الرِّجالِ مِنَ النَّعَمِ مِن عُقُلِه",2],". قال: وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: لا يَقُلْ أحَدُكُم: نَسيتُ آيةَ كَيتَ وكَيتَ، بَل هو نُسِّيَ."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5032) باختلاف يسير","bab":"رقائق وزهد › الوصايا النافعة","dorar":"stT95IfF"},{"id":"ق-1278","fp":"665de6ebc265","stateId":127,"easy":"الادّكار بالقرآن ← تيسيره للذكر","cause":"الادّكار بالقرآن","result":"تيسيره للذكر","explicit":true,"star":true,"otherNeedIds":[47],"ref":"سورة القمر: 17","srcLabel":"القرآن الكريم","quran":{"s":54,"from":17,"to":17,"text":"وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ (17)","hl":[[0,63,1]]}},{"id":"س-07788","fp":"51f2b1f5c0e4","stateId":127,"easy":"إذا تعلمت كتاب الله وحفظته ← لم يتفلت منك","cause":"تعَلَّموا كِتابَ اللهِ واقْتَنُوه","result":"لَهو أشَدُّ تَفَلُّتًا مِنَ المَخاضِ مِنَ العُقُلِ","explicit":true,"ref":"تخريج المسند لشعيب 17361","srcLabel":"النسائي","text":["كنَّا جُلوسًا في المَسجِدِ نَقرأُ القُرآنَ، فدخَلَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، فسَلَّمَ علينا، فردَدْنا عليه السلامَ، ثمَّ قال: ",["تعَلَّموا كِتابَ اللهِ واقْتَنُوه",1]," -قال قَبَاثٌ: وحَسِبْتُه قال:- وتَغَنَّوْا به؛ فوالذي نفْسُ محمَّدٍ بيَدِه، ",["لَهو أشَدُّ تَفَلُّتًا مِنَ المَخاضِ مِنَ العُقُلِ",2],"."],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (8049)، وأحمد (17361) واللفظ له","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"A00DiBc8","merged":3,"otherRefs":["صحيح الموارد 1495 (صحيح)","تخريج المسند لشعيب 17394 (صحيح)"]},{"id":"س-07072","fp":"1952907bd9e9","stateId":127,"easy":"إذا قرأت القرآن في أقل من ثلاث ← لا تفقهه","cause":"مَن يقرَؤُه في أقلَّ مِن ثلاثٍ","result":"لا يفقَهُه","explicit":true,"ref":"تخريج المسند لشعيب 6546","srcLabel":"أبو داود","text":["قال: قُلتُ: يا رسولَ اللهِ، في كَمْ أَقرَأُ القرآنَ؟ قال: اقرَأْه في كلِّ شهرٍ، قال: قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: اقرَأْه في خمسٍ وعشرينَ، قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: اقرَأْه في عشرينَ، قال: قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: اقرَأْه في خمسَ عشْرةَ، قال: قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: اقرَأْه في عَشرٍ، قال: قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: اقرَأْه في سَبعٍ، قال: قُلتُ: إنِّي أقوَى على أكثرَ مِن ذلك، قال: ",["لا يفقَهُه",2]," ",["مَن يقرَؤُه في أقلَّ مِن ثلاثٍ",1],"."],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أبو داود (1390)، والترمذي (2949)، والنسائي في ((السنن الكبرى)) (8067)، وابن ماجه (1347) مختصراً، وأحمد (6546) واللفظ له","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"JdSTKPXY","merged":2,"otherRefs":["صحيح الجامع 1157 (صحيح)"]},{"id":"س-07793","fp":"a3fb36f7d6c2","stateId":127,"easy":"إذا ختمت سورة البقرة بآيتيها ← فهما صلاة وقرآن ودعاء","cause":"خَتَمَ سورةَ البَقَرةِ بآيتيْنِ","result":"فإنَّهما صَلاةٌ وقُرْآنٌ ودُعاءٌ","explicit":true,"otherNeedIds":[41],"ref":"تخريج المراسيل لأبي داود 91","srcLabel":"مسلم","text":["إنَّ اللهَ ",["خَتَمَ سورةَ البَقَرةِ بآيتيْنِ",1]," أعْطانيهما من كَنْزِه الذي تحتَ العَرْشِ، فتعلَّموهُنَّ وعَلِّموهُنَّ نِساءَكم وأَبْناءَكم، ",["فإنَّهما صَلاةٌ وقُرْآنٌ ودُعاءٌ",2],"."],"grade":"حسن","narrator":"جبير بن نفير","muhaddith":"رجاله ثقات رجال مسلم وقد وصله الحاكم بذكر أبي ذر","takhrij":"أخرجه أبو عبيد القاسم بن سلام في ((فضائل القرآن)) (ص233)، وأبو داود في ((المراسيل)) (91)، والدارمي (3390)","bab":"قرآن › تعلم القرآن وتعليمه","dorar":"XrhBBjWz"},{"id":"س-00019","fp":"af31ec8e8230","stateId":127,"easy":"إذا صليت ليلة الجمعة أربع ركعات (لحفظ القرآن) ثلاث جمع أو خمساً أو سبعاً ← تحفظه بإذن الله","cause":"صلِّ ليلةَ الجمعةِ أربعَ ركعاتٍ","result":"فافعلْ ذلكَ ثلاثَ جُمَعٍ أو خمسًا أو سبعًا، تحفظُه بإذنِ اللهِ . وما أخطأَ مؤمنًا قَطُّ","explicit":true,"apply":{"k":"count","t":"أربع ركعات · الوقت: يوم الجمعة أو ليلتها"},"ref":"الجامع الصغير 2868","srcLabel":"الترمذي","text":["ألَا أعلمُكَ كلماتٍ ينفعكُ اللهُ بهنَّ، وينفعُ منْ علمتَه ؟ ",["صلِّ ليلةَ الجمعةِ أربعَ ركعاتٍ",1],"، تقرأُ في الركعةِ الأولى بـفاتحةِ الكتابِ و (يس) ، وفي الثانيةِ بفاتحةِ الكتابِ و بـ( حم الدخان )، وفي الثالثةِ بـ (فاتحةِ الكتابِ ) وبـ( الم تنزيل السجدة )، وفي الرابعةِ بفاتحةِ الكتابِ وتباركَ المفصلِ . فإذا فرغتَ من التشهدِ فاحمدِ اللهَ تعالى وأثنِ عليهِ، وصلِّ على النبيينِ، واستغفرْ للمؤمنينَ، ثمَّ قلْ : اللهمَّ ارحمنِي بتركِ المعاصي أبدًا ما أبقيتني، وارحمْني منْ أنْ أتكلَّفَ ما لا يعنيني وارزقْني حسنَ النظرِ فيما يُرضيكَ عنِّي . اللهمَّ بديعَ السمواتِ والأرضِ ذا الجلالِ والإكرامِ والعزةِ التي لا ترامُ، أسألُكَ يا اللهُ يا رحمنُ بجلالِكَ ونورِ وجهكَ، أنْ تُلزِمَ قلبِي حفظَ كتابِكَ كما علمتنِي، وارزقْني أن أتلُوه على النحوِ الذي يرضيكَ عنَّي، وأسألُكَ أنْ تُنَوِّرَ بالكتابِ بصري، وتطلقَ به لسانِي، وتفرجَ به كربِي، وتشرحَ به صدرِي وتستعملَ به بدنِي، وتقويني على ذلكَ وتعينَني عليهِ، فإنَّه لا يعينُني على الخيرِ غيرُك، ولا يوفِّقُ له إلا أنتَ . ",["فافعلْ ذلكَ ثلاثَ جُمَعٍ أو خمسًا أو سبعًا، تحفظُه بإذنِ اللهِ . وما أخطأَ مؤمنًا قَطُّ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3570)، والطبراني (11/367) (12036)، والحاكم (1190) باختلاف يسير","bab":"آداب الدعاء › استجابة الدعاء","dorar":"s5LS2tm6"},{"id":"س-00107","fp":"b0de9dac9946","stateId":127,"easy":"إذا فعلت ذلك ثلاث جمع أو خمساً أو سبعاً ← يُجاب دعاؤك بإذن الله","cause":"تَفعَلُ ذلكَ ثَلاثَ جُمَعٍ، أو خَمسًا، أو سَبعًا","result":"تُجابُ بإذنِ اللهِ؛ فوالَّذي بَعَثَني بالحَقِّ ما أخطَأَ مُؤمِنًا قَطُّ","explicit":true,"otherNeedIds":[28],"ref":"المستدرك على الصحيحين 1207","srcLabel":"الترمذي","text":["أنَّه بيْنَا هو جالِسٌ عِندَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ إذ جاءَه عَلِيُّ بنُ أبي طالِبٍ فقالَ: بأبي أنت وأُمِّي يا رَسولَ اللهِ، تَفَلَّت هذا القُرآنُ من صَدري، فما أجِدُني أقدِرُ عليه، فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: أبا الحَسَنِ، أفلا أُعَلِّمُكَ كَلِماتٍ يَنفَعُكَ اللهُ بِهِنَّ، ويَنفَعُ بِهِنَّ مَن عَلَّمْتَه، ويُثبِّتُ ما تَعَلَّمْتَ في صَدرِكَ؟ قالَ: أجَلْ يا رَسولَ اللهِ، فعَلِّمْني، قالَ: إذا كانتْ لَيلةُ الجُمُعةِ، فإنِ استَطَعتَ أن تَقومَ في ثُلُثِ اللَّيلِ الآخِرِ، فإنَّها ساعةٌ مَشهودةٌ، والدُّعاءُ فيها مُستَجابٌ، وهي قَولُ أخي يَعقوبَ لبَنيهِ: {سَوْفَ أَسْتَغْفِرُ لَكُمْ رَبِّي} [يوسف: 98] حتَّى تَأتِيَ لَيلةُ الجُمُعةِ، فإنْ لم تَستَطِعْ فقُمْ في وَسَطِها، فإنْ لم تَستَطِعْ فقُمْ في أوَّلِها، فصَلِّ أربَعَ رَكَعاتٍ، تَقرَأُ في الرَّكعةِ الأُولى بفاتِحةِ الكِتابِ، وسُورةِ {يس}، وفي الرَّكعةِ الثَّانِيةِ بفاتِحةِ الكِتابِ و{الم (1) تَنْزِيلُ} السَّجدةَ، وفي الرَّكعةِ الثَّالِثةِ بفاتِحةِ الكِتابِ، و{حم} الدُّخَانَ، وفي الرَّكعةِ الرَّابِعةِ بفاتِحةِ الكِتابِ، و{تَبَارَكَ} المُفَصَّلَ، فإذا فَرَغْتَ منَ التَّشَهُّدِ فاحمَدِ اللهَ، وأحسِنِ الثَّناءَ على اللهِ، وصَلِّ عَلَيَّ، وعلى سائرِ النَّبِيِّين وأحسِنْ، واستَغفِرْ لإخوانِكَ الَّذين سَبَقوكَ بالإيمانِ، ثم استَغفِرْ للمُؤمِنين وللمُؤمِناتِ، ثمَّ قُلْ آخِرَ ذلكَ: اللَّهُمَّ ارحَمني بتَركِ المَعاصي أبَدًا ما أبقَيتَني، وارحَمني أن أتكَلَّفَ ما لا يَعنيني، وارزُقني حُسْنَ النَّظَرِ فيما يُرضيكَ عَنِّي، اللَّهُمَّ بَديعَ السَّمواتِ والأرضِ ذا الجَلالِ والإكرامِ والعِزَّةِ الَّتي لا تُرامُ، أسألُكَ يا أَللهُ يا رَحمَنُ بجَلالِكَ، ونورِ وَجهِكَ أن تُلزِمَ قَلبي حِفظَ كِتابِكَ كما عَلَّمتَني، وارزُقني أن أتلُوَه على النَّحوِ الَّذي يُرضيكَ عَنِّي، اللَّهُمَّ بَديعَ السَّمواتِ والأرضِ ذا الجَلالِ والإكرامِ والعِزَّةِ الَّتي لا تُرامُ، أسألُكَ يا أَللهُ يا رَحمَنُ بجَلالِكَ ونورِ وَجهِكَ، أن تُنَوِّرَ بكِتابِكَ بَصَري، وأن تُطلِقَ به لِساني، وأن تُفَرِّجَ به عنْ قَلبي، وأن تَشرَحَ به صَدري، وأن تَشغَلَ به بَدَني، فإنَّه لا يُعينُني على الحَقِّ غَيرُكَ، ولا يُؤتِنِيه إلَّا أنت، ولا حَولَ ولا قُوَّةَ إلَّا باللهِ العَلِيِّ العَظيمِ. أبا الحَسَنِ، ",["تَفعَلُ ذلكَ ثَلاثَ جُمَعٍ، أو خَمسًا، أو سَبعًا",1],"، ",["تُجابُ بإذنِ اللهِ؛ فوالَّذي بَعَثَني بالحَقِّ ما أخطَأَ مُؤمِنًا قَطُّ",2],". قالَ عَبدُ اللهِ بنُ عَبَّاسٍ: فواللهِ ما لَبِثَ عَلِيٌّ إلَّا خَمسًا، أو سَبعًا حتَّى جاءَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ في مِثلِ ذلكَ المَجلِسِ فقالَ: يا رَسولَ اللهِ، إنِّي كُنتُ فيما خَلَا لا أتَعَلَّمُ أربَعَ آياتٍ أو نَحوَهُنَّ، فإذا قَرَأتُهُنَّ يَتفَلَّتْنَ، فأمَّا اليَومَ فأتَعَلَّمُ الأربَعين آيةً ونَحوَها، فإذا قَرَأتُهُنَّ على نَفسِي، فكَأنَّما كِتابُ اللهِ نُصبَ عَينِي، ولقد كُنتُ أسمَعُ الحَديثَ فإذا أرَدتُه تَفَلَّتَ، وأنا اليَومَ أسمَعُ الأحاديثَ فإذا حَدَّثتُ بها لم أخرِم منها حَرفًا؛ فقالَ له رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ عند ذلكَ: مُؤمِنٌ -ورَبِّ الكَعبةِ- أبا الحَسَنِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الترمذي (3570)، والبيهقي في ((الأسماء والصفات)) (673) باختلاف يسير","bab":"آداب الدعاء › الثناء على الله في الدعاء","dorar":"5Onx3CzK"},{"id":"س-01782","fp":"a91391f34c9c","stateId":127,"easy":"إذا تعلمت القرآن وتعاهدته وتغنيت به ← حفظته (فهو أشد تفلتاً من الإبل)","cause":"تعلَّمُوا كتابَ اللهِ وتعاهَدُوهُ وتغَنَّوا بِهِ","result":"لَهُوَ أشَدُّ تفَلُّتًا منَ النَّعَمِ في العُقُلِ","explicit":true,"ref":"مجمع الزوائد 7/172","srcLabel":"النسائي","text":[["تعلَّمُوا كتابَ اللهِ وتعاهَدُوهُ وتغَنَّوا بِهِ",1]," فوَالَّذِي نَفْسِي بيدِهِ ",["لَهُوَ أشَدُّ تفَلُّتًا منَ النَّعَمِ في العُقُلِ",2]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه أحمد (17355) واللفظ له، والنسائي في ((السنن الكبرى)) (8034) باختلاف يسير.","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"8K7rLGlf"},{"id":"س-00596","fp":"2592ec6d7c25","stateId":127,"easy":"إذا تعاهدت القرآن ← أمسكته، وإن تركته ذهب","cause":"إن عاهَدَ عليها","result":"أمسَكَها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح مسلم 789","srcLabel":"البخاري","text":["إنَّما مَثَلُ صاحِبِ القُرآنِ كمَثَلِ الإبِلِ المُعَقَّلةِ، ",["إن عاهَدَ عليها",1]," ",["أمسَكَها",2],"، وإن أطلَقَها ذَهَبَت. [وفي روايةٍ]: وإذا قامَ صاحِبُ القُرآنِ فقَرَأه باللَّيلِ والنَّهارِ ذَكَرَه، وإذا لَم يَقُمْ به نَسيَه."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5031) باختلاف يسير ودون الرواية المذكورة","bab":"آداب عامة › ضرب الأمثال","dorar":"KvqlitTc","merged":6,"otherRefs":["تخريج صحيح ابن حبان 765 (صحيح)","تخريج المسند لشعيب 5923 (صحيح)","تخريج المسند لشعيب 4845 (صحيح)","نتائج الأفكار 3/186 (صحيح)","تخريج المسند لشاكر 7/61 (صحيح)"]},{"id":"س-00589","fp":"230b694e8b68","stateId":127,"easy":"إذا حفظت السبع الطوال ← فأنت حبر (عالم)","cause":"مَن أخَذَ السَّبعَ","result":"فهو حَبرٌ","explicit":true,"ref":"تخريج مشكل الآثار 1377","srcLabel":"إسماعيل","text":[["مَن أخَذَ السَّبعَ",1]," ",["فهو حَبرٌ",2],"، يعني: بذلك السَّبعَ الطُّوَلَ منَ القُرْآنِ."],"grade":"حسن","narrator":"عائشة أم المؤمنين","muhaddith":"إسناده حسن","takhrij":"أخرجه إسماعيل بن جعفر في ((حديثه)) (372)، وأبو عبيد في ((فضائل القرآن)) (ص226)، ومحمد بن نصر المروزي في ((قيام الليل)) كما في ((مختصر قيام الليل)) (ص170) بلفظه.","bab":"آداب عامة › ضرب الأمثال","dorar":"WAljuK2a"},{"id":"س-00551","fp":"256b91856857","stateId":127,"easy":"إذا تعلمت القرآن وقرأته وقمت به ← فمثلك كجراب محشو مسكاً يفوح ريحه","cause":"لمن تعلَّمَهُ فقَرأَهُ وقامَ بِهِ","result":"كمَثلِ جِرابٍ محشوٍّ مسكًا، يفوحُ ريحُهُ على كلِّ مَكانٍ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"otherNeedIds":[41],"ref":"صحيح ابن خزيمة 3/ 39","srcLabel":"الترمذي","text":["بعثَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ بعثًا وَهُم نفرٌ، فدَعاهم رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ قالَ: ماذا معَكَ منَ القرآنِ؟ فاستَقرأَهُم حتَّى مرَّ على رجلٍ منهُم وَهوَ مِن أحدثِهِم سنًّا قالَ: ماذا معَكَ يا فلانُ؟ قالَ: معي كذا وَكَذا، وسورَةُ البقرةِ قالَ: معَكَ سورَةُ البقَرةِ؟ قالَ: نعَم قالَ: اذهَب، فأنتَ أميرُهُم، فقالَ رجلٌ هوَ مِن أشرفِهِم: والَّذي كذا وَكَذا، يا رسولَ اللَّهِ، ما مَنعَني أن أتعلَّمَ القرآنَ إلَّا خشيةَ أن لا أقومَ بِهِ قالَ رسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ: تعلَّمِ القرآنَ فاقرأهُ، وارقُد؛ فإنَّ مَثلَ القُرآنِ ",["لمن تعلَّمَهُ فقَرأَهُ وقامَ بِهِ",1]," ",["كمَثلِ جِرابٍ محشوٍّ مسكًا، يفوحُ ريحُهُ على كلِّ مَكانٍ",2],"، ومن تعلَّمَهُ فرقدَ وَهوَ في جوفِهِ كمَثلِ جرابٍ أوكيَ على مسكٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2876)، والنسائي في ((الكبرى)) (8696)، وابن حبان (2126) بلفظه مطولًا.","bab":"آداب عامة › ضرب الأمثال","dorar":"MohT6osX","merged":2,"otherRefs":["الترغيب والترهيب 2/300 (صحيح)"]},{"id":"س-05568","fp":"3b49ff6cae3c","stateId":128,"easy":"إذا رأيت من أُعطي زهداً في الدنيا وقلة كلام فاقترب منه ← فإنه يُلقّى الحكمة","cause":"إذا رَأيْتُم الرَّجُلَ قد أُعطِيَ زُهْدًا في الدُّنْيا وقِلَّةَ مَنطِقٍ فاقْتَرِبوا مِنه","result":"فإنَّه يُلَقَّى الحِكْمةَ","explicit":true,"star":true,"ref":"الأحكام الوسطى 4/ 278","srcLabel":"البخاري","text":["\"",["إذا رَأيْتُم الرَّجُلَ قد أُعطِيَ زُهْدًا في الدُّنْيا وقِلَّةَ مَنطِقٍ فاقْتَرِبوا مِنه؛ ",1],["فإنَّه يُلَقَّى الحِكْمةَ\"",2],"."],"grade":"صحيح","narrator":"أبو خلاد","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه ابن ماجه (4101)، والبخاري في ((التاريخ الكبير)) (11/ 90)، وابن أبي عاصم في ((الآحاد والمثاني)) (2690)، والطبراني (22/ 392) (975) واللفظ لهم.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"9HebkfYh"},{"id":"ق-0102","fp":"bc9fe2c0ffea","stateId":128,"easy":"إيتاء الحكمة ← خير كثير","cause":"إيتاء الحكمة","result":"خير كثير","explicit":true,"star":true,"ref":"سورة البقرة: 269","srcLabel":"القرآن الكريم","quran":{"s":2,"from":269,"to":269,"text":"يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ وَمَنْ يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ (269)","hl":[[33,134,1]]}},{"id":"ق-0459","fp":"ec481c9633f5","stateId":128,"easy":"تقوى الله ← فرقان وتكفير السيئات ومغفرة","cause":"تقوى الله","result":"فرقان وتكفير السيئات ومغفرة","explicit":true,"star":true,"otherNeedIds":[11],"ref":"سورة الأنفال: 29","srcLabel":"القرآن الكريم","quran":{"s":8,"from":29,"to":29,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ (29)","hl":[[31,169,1]]}},{"id":"ق-0605","fp":"c2ec7e9ff263","stateId":128,"easy":"الإحسان ← الحكم والعلم","cause":"الإحسان","result":"الحكم والعلم","explicit":true,"star":true,"similar":["ق-0914"],"ref":"سورة يوسف: 22","srcLabel":"القرآن الكريم","quran":{"s":12,"from":22,"to":22,"text":"وَلَمَّا بَلَغَ أَشُدَّهُ آتَيْنَاهُ حُكْمًا وَعِلْمًا وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ (22)","hl":[[0,88,1]]}},{"id":"ق-0820","fp":"7b5bada1a801","stateId":128,"easy":"السير في الأرض والاعتبار ← قلوب تعقل وآذان تسمع","cause":"السير في الأرض والاعتبار","result":"قلوب تعقل وآذان تسمع","explicit":true,"ref":"سورة الحج: 46","srcLabel":"القرآن الكريم","quran":{"s":22,"from":46,"to":46,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَتَكُونَ لَهُمْ قُلُوبٌ يَعْقِلُونَ بِهَا أَوْ آذَانٌ يَسْمَعُونَ بِهَا فَإِنَّهَا لَا تَعْمَى الْأَبْصَارُ وَلَكِنْ تَعْمَى الْقُلُوبُ الَّتِي فِي الصُّدُورِ (46)","hl":[[0,75,1]]}},{"id":"ق-0914","fp":"9a7df735d6a8","stateId":128,"easy":"الإحسان ← الحكم والعلم","cause":"الإحسان","result":"الحكم والعلم","explicit":true,"repOf":"ق-0605","ref":"سورة القصص: 14","quran":{"s":28,"from":14,"to":14,"text":"وَلَمَّا بَلَغَ أَشُدَّهُ وَاسْتَوَى آتَيْنَاهُ حُكْمًا وَعِلْمًا وَكَذَلِكَ نَجْزِي الْمُحْسِنِينَ (14)","hl":[[0,99,1]]}},{"id":"ق-1063","fp":"ae708474b28e","stateId":128,"easy":"تدبر القرآن ← البركة والتذكر","cause":"تدبر القرآن","result":"البركة والتذكر","explicit":true,"ref":"سورة ص: 29","srcLabel":"القرآن الكريم","quran":{"s":38,"from":29,"to":29,"text":"كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوا آيَاتِهِ وَلِيَتَذَكَّرَ أُولُو الْأَلْبَابِ (29)","hl":[[0,100,1]]}},{"id":"س-00345","fp":"5178872a4b06","stateId":128,"easy":"إذا صمتّ ← فالصمت حكمة","cause":"الصَّمتُ","result":"حِكمةٌ، وقَليلٌ فاعِلُه","explicit":true,"similar":["س-05819"],"ref":"فيض القدير 4/ 240","srcLabel":"البيهقي","text":[["الصَّمتُ",1]," ",["حِكمةٌ، وقَليلٌ فاعِلُه",2]],"grade":"صحيح","narrator":"أنس","muhaddith":"إسناده صحيح","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (4672 ) وابن عدي في ((الكامل في ضعفاء الرجال)) (6/ 287)، والقضاعي في ((مسند الشهاب)) (240 ) واللفظ لهم","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"HPkVP3Mv"},{"id":"س-04759","fp":"161ee9c4cfd6","stateId":128,"easy":"إذا أخلصت لله أربعين يوماً ← تظهر ينابيع الحكمة من قلبك على لسانك","cause":"مَن أخلَصَ للهِ أربَعينَ يَومًا","result":"ظَهَرَت يَنابيعُ الحِكمةِ مِن قَلبِه على لسانِه","explicit":true,"ref":"فيض القدير 6/ 44","srcLabel":"أبو نعيم","text":[["مَن أخلَصَ للهِ أربَعينَ يَومًا ",1],["ظَهَرَت يَنابيعُ الحِكمةِ مِن قَلبِه على لسانِه",2]],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"هذا الحديث وإن لم يكن صحيح الإسناد فقد صححه الذوق","takhrij":"أخرجه أبو نعيم في ((الحلية)) (5/ 189)، وابن الجوزي في ((الموضوعات)) (1628) واللفظ لهما.","bab":"رقائق وزهد › الإخلاص","dorar":"htPQiJUj"},{"id":"س-05819","fp":"afb0c8475e70","stateId":128,"easy":"إذا صمتّ ← فالصمت حكم","cause":"الصمتُ","result":"حُكمٌ","explicit":true,"repOf":"س-00345","ref":"تخريج العواصم والقواصم 7/ 312","text":[["الصمتُ",1]," ",["حُكمٌ",2],"، وقليلٌ فاعلُه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حديث صحيح","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (5/169)، والبيهقي في ((شعب الإيمان)) (5027).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"XTXZe12V"},{"id":"س-00291","fp":"707a8b97ace9","stateId":128,"easy":"إذا رفقت ← فالرفق رأس الحكمة","cause":"الرِّفقُ","result":"رأسُ الحكمةِ","explicit":true,"ref":"شرح كتاب الشهاب 53","srcLabel":"الخرائطي","text":[["الرِّفقُ",1]," ",["رأسُ الحكمةِ",2],"."],"grade":"حسن","narrator":"جرير بن عبدالله","muhaddith":"إسناده حسن","takhrij":"أخرجه الخرائطي في ((مكارم الأخلاق)) (676 )، والقضاعي في ((مسند الشهاب)) (51 )","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"cvFwaz30"},{"id":"س-05781","fp":"39168aa3b527","stateId":128,"easy":"إذا استكت ← يزيدك السواك فصاحة","cause":"السواكُ","result":"يزيدُ الرجلَ فصاحةً","explicit":true,"ref":"شرح كتاب الشهاب 312","srcLabel":"أبو يعلى","text":[["السواكُ",1]," ",["يزيدُ الرجلَ فصاحةً",2]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"حسن لغيره","takhrij":"أخرجه أبو يعلى في ((المعجم)) (66 )، والعقيلي في ((الضعفاء الكبير)) (3/ 156)، والقضاعي في ((مسند الشهاب)) (232 )","bab":"رقائق وزهد › الوصايا النافعة","dorar":"Hl4JLhoy"},{"id":"س-05970","fp":"122afc5aeb0a","stateId":128,"easy":"إذا رفقت في معيشتك ← فهو من فقهك","cause":"رِفقُه في مَعيشَتِه","result":"مِن فِقهِ الرَّجُلِ","explicit":true,"otherNeedIds":[1],"ref":"فيض القدير 6/ 16","srcLabel":"أحمد","text":[["مِن فِقهِ الرَّجُلِ",2]," ",["رِفقُه في مَعيشَتِه",1]],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده لا بأس به","takhrij":"أخرجه أحمد (21695)، والطبراني في ((الشاميين)) (1482) واللفظ لهما، والبيهقي في ((الشعب)) (6145) باختلاف يسير.","bab":"رقائق وزهد › الوصايا النافعة","dorar":"QssVKdZs"},{"id":"س-07044","fp":"6f04a12b0eb1","stateId":128,"easy":"إذا جمعت العلم والحلم ← فلا شيء أفضل منه","cause":"علمٍ إلى حِلْمٍ","result":"ما جُمِع شيءٌ إلى شيءٍ أفضلُ","explicit":true,"ref":"مجمع الزوائد 1/126","srcLabel":"الطبراني","text":[["ما جُمِع شيءٌ إلى شيءٍ أفضلُ",2]," من ",["علمٍ إلى حِلْمٍ",1]],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"من رواية حفص بن بشر عن حسن بن الحسين بن يزيد العلوي عن أبيه ولم أر من ذكر أحدا منهم","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (4846) بإختلاف يسير وزاد في أوله: والذي نفسي بيده","bab":"علم › الحث على طلب العلم","dorar":"uLWFiOFb"},{"id":"س-00949","fp":"165fddf4948d","stateId":128,"easy":"إذا حكمت للناس كما تحكم لنفسك ← فأنت أحكم عباد الله","cause":"الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه","result":"فأيُّ عبادِك أحكَمُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"ref":"صحيح ابن حبان 6217","srcLabel":"متفق عليه","text":["سأَل موسى ربَّه عن ستِّ خِصالٍ كان يظُنُّ أنَّها له خالصةٌ والسَّابعةُ لم يكُنْ موسى يُحِبُّها قال : يا ربِّ أيُّ عبادِك أتقى ؟ قال الَّذي يذكُرُ ولا يَنسى قال : فأيُّ عبادِك أهدى ؟ قال : الَّذي يتَّبِعُ الهُدى قال : ",["فأيُّ عبادِك أحكَمُ",2]," ؟ قال : ",["الَّذي يحكُمُ للنَّاسِ كما يحكُمُ لنفسِه",1]," قال : فأيُّ عبادِك أعلَمُ ؟ قال : عالمٌ لا يشبَعُ مِن العِلمِ يجمَعُ عِلمَ النَّاسِ إلى عِلمِه قال فأيُّ عبادِك أعَزُّ ؟ قال : الَّذي إذا قدَر غفَر قال : فأيُّ عبادِك أغنى ؟ قال : الَّذي يَرضى بما يُؤتَى قال : فأيُّ عبادِك أفقَرُ ؟ قال : صاحبٌ منقوصٌ ) قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم : ( ليس الغِنى عن ظَهْرٍ إنَّما الغِنى غِنى النَّفسِ وإذا أراد اللهُ بعبدٍ خيرًا جعَل غناه في نفسِه وتُقاهُ في قلبِه وإذا أراد اللهُ بعبدٍ شرًّا جعَل فقرَه بيْنَ عينَيْهِ )"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه ابن عساكر في ((تاريخ دمشق)) (61/ 134) بلفظه، والبخاري (6446)، ومسلم (1051) كلاهما مختصرا ببعض لفظه.","bab":"أدعية وأذكار › فضل الذكر","dorar":"BWzqJ8PQ"},{"id":"س-07506","fp":"ad8422610a0d","stateId":128,"easy":"إذا عقلت عن الله مواعظه فوجل قلبك ← تفوق الخلق منزلة","cause":"ولكِنَّهم عَقَلوا عَنِ اللهِ مَواعِظَه فوجِلَت قُلوبُهم","result":"ففاقوا الخليقةَ بطيبِ المَنزِلةِ وبحُسنِ الدَّرجةِ","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[41],"ref":"أطراف الغرائب 1/104","srcLabel":"أحمد","text":["حديث: \"قال: قد سَبَقَ إلى جَنَّاتِ عَدنٍ قَومٌ [ما كانوا أكثَرَ النَّاسِ صَلاةً ولا صيامًا ولا أعمارًا، ",["ولكِنَّهم عَقَلوا عَنِ اللهِ مَواعِظَه فوجِلَت قُلوبُهم",1]," واطمَأنَّت إليه النُّفوسُ وخَشَعَت مِنهُم الجَوارِحُ، ",["ففاقوا الخليقةَ بطيبِ المَنزِلةِ وبحُسنِ الدَّرجةِ",2]," عندَ النَّاسِ وعندَ اللهِ في الآخِرةِ]\"."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"غريب من حديث عاصم عنه. وتفرد به حبيب بن أبي ثابت عنه وتفرد به الثوري عنه وتفرد به أحمد بن الفضل عن الثوري. ولا أعلم حدث به غير محمد بن عبد النور الخزاز عنه","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"zXH26VVz"}]}