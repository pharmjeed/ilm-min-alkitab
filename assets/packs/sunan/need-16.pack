{"schema":1,"kind":"sunan-chunk","version":"sunan-2420572879fb","needId":16,"stateIds":[158,159,160,161],"items":[{"id":"س-07497","fp":"61bdbdaa4694","stateId":158,"easy":"إذا ثبتّ على دينك وأوذيت ← فإن الله متمّ هذا الأمر","cause":"وما يَصُدُّه ذلك عن دينِه","result":"واللهِ لَيُتِمَّنَّ هذا الأمرَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"star":true,"otherNeedIds":[54],"ref":"صحيح البخاري 3612","srcLabel":"متفق عليه","text":["شَكَونا إلى رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم وهو مُتَوسِّدٌ بُردةً له في ظِلِّ الكَعبةِ، قُلنا له: ألا تَستَنصِرُ لَنا؟ ألا تَدعو اللهَ لَنا؟ قال: كان الرَّجُلُ فيمَن قَبلَكُم يُحفَرُ له في الأرضِ، فيُجعَلُ فيه، فيُجاءُ بالمِنشارِ فيوضَعُ على رَأسِه فيُشَقُّ باثنَتَينِ، ",["وما يَصُدُّه ذلك عن دينِه",1],"، ويُمشَطُ بأمشاطِ الحَديدِ ما دونَ لَحمِه مِن عَظمٍ أو عَصَبٍ، وما يَصُدُّه ذلك عن دينِه، ",["واللهِ لَيُتِمَّنَّ هذا الأمرَ",2],"، حتَّى يَسيرَ الرَّاكِبُ مِن صَنعاءَ إلى حَضرَمَوتَ، لا يَخافُ إلَّا اللهَ، أوِ الذِّئبَ على غَنَمِه، ولَكِنَّكُم تَستَعجِلونَ."],"grade":"صحيح","narrator":"خباب بن الأرت","muhaddith":"[صحيح]","takhrij":"من أفراد البخاري على مسلم","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"8vTjvxfE","merged":4,"otherRefs":["تخريج صحيح ابن حبان 6698 (صحيح)","صحيح البخاري 3852 (صحيح)","تخريج صحيح ابن حبان 2897 (صحيح)"]},{"id":"ق-0092","fp":"ec3c4d4e6ccc","stateId":158,"easy":"الكفر بالطاغوت والإيمان بالله ← الاستمساك بالعروة الوثقى","cause":"الكفر بالطاغوت والإيمان بالله","result":"الاستمساك بالعروة الوثقى","explicit":true,"star":true,"ref":"سورة البقرة: 256","srcLabel":"القرآن الكريم","quran":{"s":2,"from":256,"to":256,"text":"لَا إِكْرَاهَ فِي الدِّينِ قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى لَا انْفِصَامَ لَهَا وَاللَّهُ سَمِيعٌ عَلِيمٌ (256)","hl":[[66,207,1]]}},{"id":"ق-0229","fp":"d7edcd1b6947","stateId":158,"easy":"فعل ما يوعظ به العبد ← خير وأشد تثبيتاً وأجر عظيم وهداية صراط مستقيم","cause":"فعل ما يوعظ به العبد","result":"خير وأشد تثبيتاً وأجر عظيم وهداية صراط مستقيم","explicit":true,"star":true,"otherNeedIds":[45,15],"ref":"سورة النساء: 66–68","srcLabel":"القرآن الكريم","quran":{"s":4,"from":66,"to":68,"text":"وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ اقْتُلُوا أَنْفُسَكُمْ أَوِ اخْرُجُوا مِنْ دِيَارِكُمْ مَا فَعَلُوهُ إِلَّا قَلِيلٌ مِنْهُمْ وَلَوْ أَنَّهُمْ فَعَلُوا مَا يُوعَظُونَ بِهِ لَكَانَ خَيْرًا لَهُمْ وَأَشَدَّ تَثْبِيتًا (66) وَإِذًا لَآتَيْنَاهُمْ مِنْ لَدُنَّا أَجْرًا عَظِيمًا (67) وَلَهَدَيْنَاهُمْ صِرَاطًا مُسْتَقِيمًا (68)","hl":[[133,326,1]]}},{"id":"ق-0604","fp":"06a8d686cc1d","stateId":158,"easy":"تدبر قصص الرسل ← تثبيت الفؤاد","cause":"تدبر قصص الرسل","result":"تثبيت الفؤاد","explicit":true,"star":true,"ref":"سورة هود: 120","srcLabel":"القرآن الكريم","quran":{"s":11,"from":120,"to":120,"text":"وَكُلًّا نَقُصُّ عَلَيْكَ مِنْ أَنْبَاءِ الرُّسُلِ مَا نُثَبِّتُ بِهِ فُؤَادَكَ وَجَاءَكَ فِي هَذِهِ الْحَقُّ وَمَوْعِظَةٌ وَذِكْرَى لِلْمُؤْمِنِينَ (120)","hl":[[0,79,1]]}},{"id":"ق-0646","fp":"2c29b80e37ca","stateId":158,"easy":"الكلمة الطيبة (التوحيد) ← ثبات الأصل ودوام الثمر","cause":"الكلمة الطيبة (التوحيد)","result":"ثبات الأصل ودوام الثمر","explicit":true,"otherNeedIds":[50],"ref":"سورة إبراهيم: 24–25","srcLabel":"القرآن الكريم","quran":{"s":14,"from":24,"to":25,"text":"أَلَمْ تَرَ كَيْفَ ضَرَبَ اللَّهُ مَثَلًا كَلِمَةً طَيِّبَةً كَشَجَرَةٍ طَيِّبَةٍ أَصْلُهَا ثَابِتٌ وَفَرْعُهَا فِي السَّمَاءِ (24) تُؤْتِي أُكُلَهَا كُلَّ حِينٍ بِإِذْنِ رَبِّهَا وَيَضْرِبُ اللَّهُ الْأَمْثَالَ لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ (25)","hl":[[0,248,1]]}},{"id":"ق-0648","fp":"6c2dc28aac99","stateId":158,"easy":"الإيمان ← التثبيت بالقول الثابت في الحياة الدنيا وفي الآخرة","cause":"الإيمان","result":"التثبيت بالقول الثابت في الحياة الدنيا وفي الآخرة","explicit":true,"otherNeedIds":[63],"ref":"سورة إبراهيم: 27","srcLabel":"القرآن الكريم","quran":{"s":14,"from":27,"to":27,"text":"يُثَبِّتُ اللَّهُ الَّذِينَ آمَنُوا بِالْقَوْلِ الثَّابِتِ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ وَيُضِلُّ اللَّهُ الظَّالِمِينَ وَيَفْعَلُ اللَّهُ مَا يَشَاءُ (27)","hl":[[0,101,1]]}},{"id":"ق-0681","fp":"750b3a1fabcb","stateId":158,"easy":"القرآن ← تثبيت المؤمنين وهدى وبشرى","cause":"القرآن","result":"تثبيت المؤمنين وهدى وبشرى","explicit":true,"otherNeedIds":[15,6],"ref":"سورة النحل: 102","srcLabel":"القرآن الكريم","quran":{"s":16,"from":102,"to":102,"text":"قُلْ نَزَّلَهُ رُوحُ الْقُدُسِ مِنْ رَبِّكَ بِالْحَقِّ لِيُثَبِّتَ الَّذِينَ آمَنُوا وَهُدًى وَبُشْرَى لِلْمُسْلِمِينَ (102)","hl":[[0,118,1]]}},{"id":"ق-0975","fp":"8fdff909c749","stateId":158,"easy":"إسلام الوجه لله مع الإحسان ← الاستمساك بالعروة الوثقى","cause":"إسلام الوجه لله مع الإحسان","result":"الاستمساك بالعروة الوثقى","explicit":true,"ref":"سورة لقمان: 22","srcLabel":"القرآن الكريم","quran":{"s":31,"from":22,"to":22,"text":"وَمَنْ يُسْلِمْ وَجْهَهُ إِلَى اللَّهِ وَهُوَ مُحْسِنٌ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَى وَإِلَى اللَّهِ عَاقِبَةُ الْأُمُورِ (22)","hl":[[0,135,1]]}},{"id":"ق-1169","fp":"1da33b501280","stateId":158,"easy":"الاستمساك بالوحي ← الاستقامة على الصراط والشرف","cause":"الاستمساك بالوحي","result":"الاستقامة على الصراط والشرف","explicit":true,"otherNeedIds":[43],"ref":"سورة الزخرف: 43–44","srcLabel":"القرآن الكريم","quran":{"s":43,"from":43,"to":44,"text":"فَاسْتَمْسِكْ بِالَّذِي أُوحِيَ إِلَيْكَ إِنَّكَ عَلَى صِرَاطٍ مُسْتَقِيمٍ (43) وَإِنَّهُ لَذِكْرٌ لَكَ وَلِقَوْمِكَ وَسَوْفَ تُسْأَلُونَ (44)","hl":[[0,116,1]]}},{"id":"س-05771","fp":"b0057d46896b","stateId":158,"easy":"إذا قلت «آمنت بالله» ثم استقمت ← فهو جماع الدين","cause":"قُل: آمَنتُ باللهِ، ثمَّ استَقِمْ","result":"قَولًا لا أسألُ عنه أحَدًا بَعدَك","explicit":true,"apply":{"k":"say","t":"«آمنت بالله»"},"ref":"صحيح مسلم 38","srcLabel":"أحمد","text":["قُلتُ: يا رَسولَ اللهِ، قُلْ لي في الإسلامِ ",["قَولًا لا أسألُ عنه أحَدًا بَعدَك",2],"، وفي حَديثِ أبي أُسامةَ: غَيرَك، قال: ",["قُل: آمَنتُ باللهِ، ثمَّ استَقِمْ",1],"."],"grade":"صحيح","narrator":"سفيان بن عبدالله الثقفي","muhaddith":"[صحيح]","takhrij":"أخرجه أحمد (15416)، وابن حبان (942)، وابن أبي عاصم في ((الآحاد والمثاني)) (1584)، بلفظ: (ثم استقم).","bab":"رقائق وزهد › الوصايا النافعة","dorar":"BPPs4Aqt","merged":3,"otherRefs":["تخريج المسند لشعيب 19431 (صحيح)","تخريج الكشاف 3/230 (صحيح)"]},{"id":"س-07043","fp":"03df97ba6358","stateId":158,"easy":"إذا استقام قلبك ← يستقيم دينك وعملك","cause":"حتَّى يستقيمَ عملُهُ","result":"وما استقامَ دينُهُ","explicit":true,"ref":"الترغيب والترهيب 1/76","srcLabel":"الطبراني","text":["ما اكتسبَ مُكْتسبٌ مثلَ فضلِ علمٍ يَهْدي صاحبَهُ إلى هدًى أو يردُّهُ عن ردًى ",["وما استقامَ دينُهُ",2]," ",["حتَّى يستقيمَ عملُهُ",1]],"grade":"صحيح","narrator":"عمر بن الخطاب","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الحارث في ((المسند)) (813) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (4726) واللفظ له، والبيهقي في ((شعب الإيمان)) (4660) مختصراً بنحوه","bab":"علم › الحث على طلب العلم","dorar":"KmsGizJM"},{"id":"س-01954","fp":"3fd34c010639","stateId":158,"easy":"إذا قلت «ربي الله» ثم استقمت ← فهو أمر تعتصم به","cause":"قُلْ: ربِّيَ اللهُ ثمَّ استقِمْ","result":"بأمرٍ أعتصِمُ به","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«ربي الله»"},"ref":"تخريج صحيح ابن حبان 5702","srcLabel":"الترمذي","text":["قُلْتُ: يا رسولَ اللهِ حدِّثْني ",["بأمرٍ أعتصِمُ به",2]," فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ( ",["قُلْ: ربِّيَ اللهُ ثمَّ استقِمْ",1]," ) قُلْتُ: يا رسولَ اللهِ ما أكثرُ ما تخافُ عليَّ ؟ فأخَذ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم بلسانِ نفسِه ثمَّ قال: ( هذا )"],"grade":"صحيح","narrator":"سفيان بن عبدالله الثقفي","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (2410)، وابن ماجة (3972)، وأحمد (15419)، وابن حبان (5699)، واللفظ لهم.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"zQcFNcZC","merged":2,"otherRefs":["صحيح الترمذي 2410 (صحيح)"]},{"id":"س-07680","fp":"5c691f38f5fb","stateId":158,"easy":"إذا قلت ربنا الله ومت عليها ← فأنت ممن استقام","cause":"فمن مات عليها","result":"فهو ممن استقامَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[62],"ref":"سنن الترمذي 3250","srcLabel":"النسائي","text":["أنَّ رسولَ اللهِ صلَّى اللهُ عليهِ وسلَّمَ قرأ : { إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا } قال : قد قال الناسُ، ثم كفر أكثرُهم، ",["فمن مات عليها",1]," ",["فهو ممن استقامَ",2]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"حسن غريب لا نعرفه إلا من هذا الوجه","takhrij":"أخرجه أبو يعلى (3495) بلفظه، وابن أبي عاصم في ((السنة)) (20)، والنسائي في ((السنن الكبرى)) (11406) كلاهما باختلاف يسير،","bab":"قدر › العمل بالخواتيم","dorar":"gacfPcep"},{"id":"س-05369","fp":"dd0aa82063cb","stateId":159,"easy":"إذا ابتُليت ← يأتيك الصبر من الله على قدر البلاء","cause":"عَلَى قَدْرِ البَلَاءِ","result":"وَإِنَّ الصبْرَ يَأْتِي مِنْ اللهِ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"مجمع الزوائد 4/327","srcLabel":"البخاري","text":["إنَّ المعونَةَ تَأْتِي مِنَ اللهِ عَلَى قَدْرِ المؤُونَةِ ",["وَإِنَّ الصبْرَ يَأْتِي مِنْ اللهِ",2]," ",["عَلَى قَدْرِ البَلَاءِ",1]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"فيه صادق بن عمار قال البخاري لا يتابع على حديثه ، وبقية رجاله رجال الصحيح","takhrij":"أخرجه البزار (8878) واللفظ له، وأخرجه الحارث كما في ((بغية الباحث)) للهيثمي (423)، والبيهقي في ((شعب الإيمان)) (9956) باختلاف يسير","bab":"رقائق وزهد › التوكل واليقين","dorar":"ns5MeHg5","merged":4,"otherRefs":["شرح كتاب الشهاب 211 (حسن)","صحيح الجامع 3001 (صحيح)","صحيح الجامع 1919 (صحيح)"]},{"id":"س-06044","fp":"5a3ebda07817","stateId":159,"easy":"إذا رُزقت الصبر ← فما أُعطيت عطاءً خيراً وأوسع منه","cause":"الصَّبرِ","result":"وما أُعطيَ أحَدٌ عَطاءً خَيرًا وأوسَعَ مِنَ","explicit":true,"star":true,"otherNeedIds":[9],"ref":"صحيح البخاري 1469","srcLabel":"متفق عليه","text":["إنَّ ناسًا مِنَ الأنصارِ سَألوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم فأعطاهم، ثُمَّ سَألوه فأعطاهم، ثُمَّ سَألوه فأعطاهم، حتَّى نَفِدَ ما عِندَه، فقال: ما يَكونُ عِندي مِن خَيرٍ فلَن أدَّخِرَه عَنكُم، ومَن يَستَعفِفْ يُعِفَّه اللهُ، ومَن يَستَغنِ يُغنِه اللهُ، ومَن يَتَصَبَّرْ يُصَبِّرْه اللهُ، ",["وما أُعطيَ أحَدٌ عَطاءً خَيرًا وأوسَعَ مِنَ",2]," ",["الصَّبرِ",1],"."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (1469)، ومسلم (1053)، وأبو داود (1644)، والترمذي (2024) بلفظه.","bab":"رقائق وزهد › فضل الصبر","dorar":"hvINxW3i","merged":3,"otherRefs":["صحيح الترغيب 3396 (صحيح)","السلسلة الصحيحة 448 (صحيح)"]},{"id":"س-06039","fp":"a1aebe5c81c0","stateId":159,"easy":"إذا تصبّرت ← يصبّرك الله","cause":"ومَن يَتَصَبَّرْ","result":"يُصَبِّرْه اللهُ","explicit":true,"star":true,"ref":"صحيح البخاري 6470","srcLabel":"مسلم","text":["أنَّ أُناسًا مِنَ الأنصارِ سَألوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، فلَم يَسألْه أحَدٌ منهم إلَّا أعطاه حتَّى نَفِدَ ما عِندَه، فقال لهم حينَ نَفِدَ كُلُّ شيءٍ أنفَقَ بيَدَيه: ما يَكُنْ عِندي مِن خَيرٍ لا أدَّخِرْه عَنكُم، وإنَّه مَن يَستَعِفَّ يُعِفَّه اللهُ، ",["ومَن يَتَصَبَّرْ",1]," ",["يُصَبِّرْه اللهُ",2],"، ومَن يَستَغنِ يُغنِه اللهُ، ولَن تُعطَوا عَطاءً خَيرًا وأوسَعَ مِنَ الصَّبرِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (1053) باختلاف يسير","bab":"رقائق وزهد › فضل الصبر","dorar":"ilOJ260A","merged":4,"otherRefs":["تخريج المسند لشعيب 11435 (صحيح)","عارضة الأحوذي 4/364 (صحيح)","صحيح البخاري 1469 (صحيح)"]},{"id":"س-07591","fp":"cbe19dada0e3","stateId":159,"easy":"إذا أوذيت فاصبر ← فقد أوذي موسى بأكثر فصبر","cause":"وجْهُ اللهِ","result":"قد أوذيَ بأكثَرَ مِن هذا فصَبَرَ","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[8],"ref":"صحيح مسلم 1062","srcLabel":"البخاري","text":["لَمَّا كان يَومُ حُنَينٍ آثَرَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم ناسًا في القِسمةِ، فأعطى الأقرَعَ بنَ حابِسٍ مِئةً مِنَ الإبِلِ، وأعطى عُيَينةَ مِثلَ ذلك، وأعطى أُناسًا مِن أشرافِ العَرَبِ، وآثَرَهُم يَومَئذٍ في القِسمةِ، فقال رَجُلٌ: واللَّهِ، إنَّ هذه لَقِسمةٌ ما عُدِلَ فيها وما أُريدَ فيها ",["وجْهُ اللهِ",1],"، قال: فقُلتُ: واللَّهِ، لأُخبِرَنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، قال: فأتَيتُه فأخبَرتُه بما قال، قال: فتَغَيَّرَ وجْهُه حتَّى كان كالصِّرفِ، ثُمَّ قال: فمَن يَعدِلُ إن لَم يَعدِلِ اللهُ ورَسولُه؟! قال: ثُمَّ قال: يَرحَمُ اللهُ موسى، ",["قد أوذيَ بأكثَرَ مِن هذا فصَبَرَ",2],". قال: قُلتُ: لا جَرَمَ لا أرفَعُ إليه بَعدَها حَديثًا."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (3150) باختلاف يسير","bab":"فضائل النبي وصفته ودلائل النبوة › صبره","dorar":"ClC2frBV","merged":6,"otherRefs":["تخريج المسند لشعيب 4148 (صحيح)","تخريج المسند لشعيب 4204 (صحيح)","صحيح البخاري 4336 (صحيح)","صحيح البخاري 4335 (صحيح)","صحيح البخاري 6059 (صحيح)"]},{"id":"س-00967","fp":"b4d086efb96b","stateId":159,"easy":"إذا صبرت ← فالصبر ضياء لك","cause":"والصَّبرُ","result":"ضِياءٌ","explicit":true,"otherNeedIds":[5],"ref":"تخريج المسند لشعيب 22909","srcLabel":"مسلم","text":["الطُّهورُ شَطرُ الإيمانِ، فذَكَرَ مِثلَه [أي: حَديثَ: الطُّهورُ شَطرُ الإيمانِ، والحَمدُ لله تملأُ الميزانَ، وسُبحانَ الله والحَمدُ لله واللهُ أكبَرُ تملأُ ما بين السَّماءِ والأرضِ، والصَّلاةُ نورٌ، والصَّدَقةُ بُرهانٌ، ",["والصَّبرُ",1]," ",["ضِياءٌ",2],"، والقُرآنُ حُجَّةٌ لك أو عليك. كلُّ النَّاسِ يغدو؛ فبائِعٌ نَفسَه فمُعتِقُها أو مُوبِقُها]، إلَّا أنَّه قال: الصَّلاةُ بُرهانٌ، والصَّدَقةُ نورٌ."],"grade":"صحيح","narrator":"أبو مالك الأشعري","muhaddith":"صحيح","takhrij":"أخرجه مسلم (223)، والترمذي (3517)، والنسائي (2437)، وأحمد (22909) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"nu8DvRlD","merged":2,"otherRefs":["صحيح الترغيب 189 (صحيح)"]},{"id":"ق-0196","fp":"e1b911c5eeae","stateId":159,"easy":"الصبر والتقوى على الأذى ← من عزم الأمور","cause":"الصبر والتقوى على الأذى","result":"من عزم الأمور","explicit":true,"ref":"سورة آل عمران: 186","srcLabel":"القرآن الكريم","quran":{"s":3,"from":186,"to":186,"text":"لَتُبْلَوُنَّ فِي أَمْوَالِكُمْ وَأَنْفُسِكُمْ وَلَتَسْمَعُنَّ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَمِنَ الَّذِينَ أَشْرَكُوا أَذًى كَثِيرًا وَإِنْ تَصْبِرُوا وَتَتَّقُوا فَإِنَّ ذَلِكَ مِنْ عَزْمِ الْأُمُورِ (186)","hl":[[156,223,1]]}},{"id":"ق-0973","fp":"d3197839947d","stateId":159,"easy":"إقامة الصلاة والأمر بالمعروف والنهي عن المنكر والصبر على المصاب ← من عزم الأمور","cause":"إقامة الصلاة والأمر بالمعروف والنهي عن المنكر والصبر على المصاب","result":"من عزم الأمور","explicit":true,"ref":"سورة لقمان: 17","srcLabel":"القرآن الكريم","quran":{"s":31,"from":17,"to":17,"text":"يَا بُنَيَّ أَقِمِ الصَّلَاةَ وَأْمُرْ بِالْمَعْرُوفِ وَانْهَ عَنِ الْمُنْكَرِ وَاصْبِرْ عَلَى مَا أَصَابَكَ إِنَّ ذَلِكَ مِنْ عَزْمِ الْأُمُورِ (17)","hl":[[0,144,1]]}},{"id":"ق-1162","fp":"a9af7b8f2801","stateId":159,"easy":"الصبر والمغفرة ← من عزم الأمور","cause":"الصبر والمغفرة","result":"من عزم الأمور","explicit":true,"ref":"سورة الشورى: 43","srcLabel":"القرآن الكريم","quran":{"s":42,"from":43,"to":43,"text":"وَلَمَنْ صَبَرَ وَغَفَرَ إِنَّ ذَلِكَ لَمِنْ عَزْمِ الْأُمُورِ (43)","hl":[[0,62,1]]}},{"id":"س-07474","fp":"36d6ec1a52c6","stateId":159,"easy":"إذا اتقيت الله وصبرت ← فإن الله فاتح لك وصانع","cause":"اتَّقوا اللهَ واصْبِروا","result":"فإنَّ اللهَ فاتِحٌ لكُم وصانِعٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[54],"ref":"المستدرك على الصحيحين 5750","srcLabel":"البخاري","text":["أتيْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ وهو مُضطَجِعٌ تحتَ شَجَرةٍ، واضِعٌ يَدَه تحتَ رَأسِه، فقُلْتُ: يا رَسولَ اللهِ، ألَا تَدْعو اللهَ على هؤلاء القَومِ الَّذين قد خَشِينا أنْ يَرُدُّونَنا عنْ دِينِنا، فصرَفَ عَنِّي وَجهَه ثَلاثَ مرَّاتٍ، كلُّ ذلك أقولُ له، فيَصرِفُ وَجهَه عَنِّي، فجلَسَ في الثَّالثةِ فقالَ: أيُّها النَّاسُ، ",["اتَّقوا اللهَ واصْبِروا",1],"، فواللهِ إنْ كانَ الرَّجلُ منَ المُؤمِنينَ قَبلَكم لَيوضَعُ المِنْشارُ على رَأسِه، فيُشَقُّ باثْنَتَينِ وما يَرتَدُّ عنْ دِينِه، اتَّقوا اللهَ؛ ",["فإنَّ اللهَ فاتِحٌ لكُم وصانِعٌ",2],"."],"grade":"صحيح","narrator":"خباب بن الأرت","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الطبراني (4/ 65) (3648) بلفظه، والبخاري (3612) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"P11QRePU"},{"id":"س-01930","fp":"a58cf73c633a","stateId":159,"easy":"إذا صمت ← فالصوم نصف الصبر","cause":"والصِيامُ","result":"نصفُ الصبرِ","explicit":true,"similar":["س-06600","س-01447"],"ref":"الجامع الصغير 5182","srcLabel":"ابن ماجه","text":["الصيامُ نِصْفُ الصبرِ [يعني حديث: لكلّ شيءٍ زكاةٌ وزكاةُ الجسدِ الصومُ ",["والصِيامُ",1]," ",["نصفُ الصبرِ",2],"]"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (1745)، والبيهقي في ((الشعب)) (3300)، والشهاب في ((مسنده)) (229) ثلاثتهم بلفظه.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"0bUs72xS"},{"id":"س-06600","fp":"94f73db18691","stateId":159,"easy":"إذا صمت ← فالصوم ضياء","cause":"والصومُ","result":"ضياءٌ","explicit":true,"repOf":"س-01930","ref":"عارضة الأحوذي 2/145","text":["والصلاةُ نورٌ والصدقةُ برهانٌ ",["والصومُ",1]," ",["ضياءٌ",2]," والقرآنُ حُجَّةٌ لك أو عليك كلُّ الناسِ تغدو فبائعٌ نفسَهُ ومُعتِقُها أو مُوبِقُها"],"grade":"صحيح","muhaddith":"صحيح","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"cHayuiC5"},{"id":"س-01447","fp":"fdb040e18b83","stateId":159,"easy":"إذا صمت ← فالصوم نصف الصبر","cause":"والصَّومُ","result":"نِصفُ الصَّبرِ","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"repOf":"س-01930","ref":"تخريج المسند لشعيب 23160","text":["عن جُرَيٍّ النَّهْديِّ قال: لَقيتُ شَيخًا من بَني سُلَيمٍ بالكُناسةِ فحَدَّثَني، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ عَدَّ خَمسًا في يَدِه، أو في يَدي، قال: التَّسبيحُ نِصفُ الميزانِ، والحَمدُ للهِ يَملَؤه، والتَّكبيرُ يَملَأُ ما بيْنَ السَّماءِ والأرضِ، ",["والصَّومُ",1]," ",["نِصفُ الصَّبرِ",2],"، والطُّهورُ نِصفُ الإيمانِ."],"grade":"صحيح","narrator":"رجل من الصحابة","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3519)، وأحمد (23160) واللفظ له","bab":"وضوء › فضل الوضوء","dorar":"Hn5ERxvd","merged":2,"otherRefs":["تخريج المسند لشعيب 23139 (صحيح)"]},{"id":"س-03131","fp":"e2e42ffc6e58","stateId":159,"easy":"إذا حمدت الله في السراء واحتسبت في الضراء ← يعطيك الله من حلمه وعلمه","cause":"إن أَصابَهم ما يُحِبُّونَ حَمِدوا وشَكَروا، وإن أَصابَهم ما يَكرَهونَ احْتَسَبوا وصَبَروا","result":"أُعْطيهم مِن حِلْمي وعِلْمي","explicit":false,"ijtihad":true,"ijtihadWhy":["وصف أو خبر ليس فيه عمل يترتب عليه أثر صريح"],"otherNeedIds":[18],"ref":"الأحكام الوسطى 4/ 365","srcLabel":"أحمد","text":["\"إنَّ اللهَ قالَ لِعيسى ابنِ مَرْيَمَ: إنِّي باعِثٌ مِن بَعْدِك أُمَّةً ",["إن أَصابَهم ما يُحِبُّونَ حَمِدوا وشَكَروا، وإن أَصابَهم ما يَكرَهونَ احْتَسَبوا وصَبَروا",1],"، ولا حِلْمَ ولا عِلمَ، قالَ: يا رَبِّ، كيف هذا، ولا حِلمَ ولا عِلمَ؟ قالَ: ",["أُعْطيهم مِن حِلْمي وعِلْمي",2],"\"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه أحمد (27545)، والطبراني في ((الأوسط)) (3252)، وأبو نعيم في ((الحلية)) (1/ 227) واللفظ لهم.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"5N9rz0i3"},{"id":"س-05963","fp":"339b6919d4ff","stateId":160,"easy":"إذا تسحّرت ← تقوى على صيام النهار","cause":"بطَعامِ السَّحَرِ","result":"على صِيامِ النَّهارِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 402","srcLabel":"متفق عليه","text":["«اسْتَعينوا ",["بطَعامِ السَّحَرِ",1]," ",["على صِيامِ النَّهارِ",2],"، وبقَيْلولةِ النَّهارِ على قِيامِ اللَّيلِ»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"mtuOhQoo"},{"id":"س-05964","fp":"8836e77a1c0e","stateId":160,"easy":"إذا قِلت (نمت القيلولة) نهاراً ← تقوى على قيام الليل","cause":"وبقَيْلولةِ النَّهارِ","result":"على قِيامِ اللَّيلِ","explicit":true,"star":true,"ref":"الأحاديث المختارة 11 / 402","srcLabel":"متفق عليه","text":["«اسْتَعينوا بطَعامِ السَّحَرِ على صِيامِ النَّهارِ، ",["وبقَيْلولةِ النَّهارِ",1]," ",["على قِيامِ اللَّيلِ",2],"»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"رقائق وزهد › الوصايا النافعة","dorar":"mtuOhQoo"},{"id":"ق-1389","fp":"fc65e5957c1a","stateId":160,"easy":"قيام الليل وترتيل القرآن ← أشدّ وطئاً وأقوم قيلاً (ثبات وقوة)","cause":"قيام الليل وترتيل القرآن","result":"أشدّ وطئاً وأقوم قيلاً (ثبات وقوة)","explicit":true,"apply":{"k":"time","t":"في الليل"},"otherNeedIds":[18],"ref":"سورة المزمل: 2–6","srcLabel":"القرآن الكريم","quran":{"s":73,"from":2,"to":6,"text":"قُمِ اللَّيْلَ إِلَّا قَلِيلًا (2) نِصْفَهُ أَوِ انْقُصْ مِنْهُ قَلِيلًا (3) أَوْ زِدْ عَلَيْهِ وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا (4) إِنَّا سَنُلْقِي عَلَيْكَ قَوْلًا ثَقِيلًا (5) إِنَّ نَاشِئَةَ اللَّيْلِ هِيَ أَشَدُّ وَطْئًا وَأَقْوَمُ قِيلًا (6)","hl":[[0,174,1]]}},{"id":"س-08426","fp":"6ff20a7a4489","stateId":160,"easy":"إذا أردت أن تكون أقوى الناس ← فتوكل على الله","cause":"فلْيَتوكَّلْ على اللهِ","result":"ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ","explicit":true,"ref":"المستدرك على الصحيحين 7916","srcLabel":"عبد بن حميد","text":["عنْ مُحمَّدِ بنِ كعْبٍ القُرَظِيِّ، قالَ: شَهِدْتُ عُمَرَ بنَ عبدِ العزيزِ وهو أميرٌ علينا بالمدينةِ للوَليدِ بنِ عبدِ المَلِكِ، وهو شابٌّ غليظٌ مُمتلِئُ الجِسْمِ، فلَمَّا استُخْلِفَ أتَيتُه بخُناصِرَةَ، فدَخلْتُ عليهِ وقد قاسَى ما قاسَى، فإذا هو قدْ تغيَّرَتْ حالتُهُ عمَّا كان، ثُمَّ ذَكَرَ الحديثَ. \n وزادَ فيهِ: ومَن نظَرَ في كتابِ أخيهِ بغيرِ إذنِهِ، فكأنَّما يَنظُرُ في النَّارِ، ",["ومَن أحَبَّ أنْ يكونَ أقوى النَّاسِ ",2],["فلْيَتوكَّلْ على اللهِ",1],"، ومَن أحَبَّ أنْ يكونَ أكرَمَ النَّاسِ فلْيَتَّقِ اللهَ عزَّ وجلَّ، ومَن أحَبَّ أنْ يكونَ أغْنى النَّاسِ فلْيَكُنْ بما في يَدِ اللهِ أوثَقَ ممَّا في يَدِهِ.\n وقالَ: أفأُنَبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ اللهِ، قالَ: مَن لا يُقيلُ عثْرَةً، ولا يَقبَلُ مَعذرةً، ولا يَغفِرُ ذنْبًا، أفأُنبِّئُكُم بشَرٍّ مِن هذا؟ قالوا: نعَمْ يا رسولَ الله. قالَ: مَن لا يُرجَى خَيرُه، ولا يُؤمَنُ شَرُّه. إنَّ عِيسى ابنَ مريمَ صلَواتُ اللهِ عليه قامَ في بني إسرائيلَ، فقالَ: يا بَني إسرائيلَ، لا تتَكَلَّموا بالحكمةِ عندَ الجاهلِ فتَظْلِموها، ولا تَمْنَعوها أهْلَها فتَظْلِموهُم، ولا تَظْلِموا ظالِمًا، ولا تُكافِئوا ظالِمًا؛ فيَبْطُلَ فضْلُكُم عندَ رَبِّكم، يا بَني إسرائيلَ، الأمْرُ ثَلاثٌ: أمْرٌ تَبيَّنَ غَيُّهُ فاجْتَنِبوه، وأمْرٌ اختُلِفَ فيه فرُدُّوهُ إلى اللهِ عزَّ وجلَّ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه عبد بن حميد ((المنتخب من مسنده)) (675)، ابن أبي أسامة ((مسند الحارث)) (1070)، وأبو طاهر المخلص في ((المخلصيات)) (21) بنحوه","bab":"مناقب وفضائل › فضائل جمع من الصحابة والتابعين","dorar":"phOdyaJA"},{"id":"س-00239","fp":"d1565b9f9d06","stateId":160,"easy":"إذا كظمت غيظك ← غلبت نفسك وشيطانك وشيطان صاحبك وكنت أشد الناس","cause":"رجلٌ كلمَهُ رجلٌ فكظمَ غيظَهُ فغلبَهُ وغلبَ شيطانَهُ وغلبَ شيطانَ صاحبِهِ","result":"أفلا أدلُّكمْ على من هو أشدُّ منه","explicit":true,"otherNeedIds":[8],"ref":"فتح الباري لابن حجر 10/535","srcLabel":"الطبراني","text":["أنَّ النبيَّ صلَّى اللهُ عليْهِ وسلَّمَ مرَّ بقومٍ يَصطرعونَ فقال : ما هذا ؟ قالوا : فلانٌ ما يُصارعُ أحدًا إلا صرعَهُ ، قال : ",["أفلا أدلُّكمْ على من هو أشدُّ منه",2]," ؟ ",["رجلٌ كلمَهُ رجلٌ فكظمَ غيظَهُ فغلبَهُ وغلبَ شيطانَهُ وغلبَ شيطانَ صاحبِهِ",1]],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني في ((مكارم الأخلاق)) (52) واللفظ له، والبزار (7272) باختلاف يسير.","bab":"آداب عامة › الأخلاق الحميدة الحسنة","dorar":"UXZLhkZD","merged":2,"otherRefs":["السلسلة الصحيحة 3295 (حسن)"]},{"id":"س-07715","fp":"9f414d53f5e2","stateId":161,"easy":"إذا وجدت في نفسك وسوسة ← فقل «هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم»","cause":"فقُلْ: هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ والْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","result":"إذا وَجَدْتَ في نَفْسِك شَيئًا","explicit":true,"star":true,"otherNeedIds":[31],"ref":"الأحاديث المختارة 10 / 419","srcLabel":"متفق عليه","text":["سَألْتُ ابنَ عبَّاسٍ فقُلْتُ: «ما شيءٌ أجِدُه في صَدْري؟ قالَ: ما هو؟ قُلْتُ: واللهِ لا أتَكلَّمُ به، قالَ: فقالَ لي: أشيءٌ مِن شَكٍّ؟ قالَ: وضَحِكَ، قالَ: ما نَجا مِن ذلك أحَدٌ، قالَ: حتَّى أَنزَلَ اللهُ عَزَّ وجَلَّ: {فَإِنْ كُنْتَ فِي شَكٍّ مِمَّا أَنْزَلْنَا إِلَيْكَ فَاسْأَلِ الَّذِينَ يَقْرَءُونَ الكِتَابَ مِنْ قَبْلِكَ} الآية، قالَ: فقالَ لي: ",["إذا وَجَدْتَ في نَفْسِك شَيئًا",2]," ",["فقُلْ: {هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ والْبَاطِنُ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ",1],"}»."],"grade":"صحيح","narrator":"أبو زميل","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"قرآن › أسباب النزول","dorar":"dGOesAzJ"},{"id":"س-07829","fp":"df06c2c799cc","stateId":161,"easy":"إذا شككت فاستعذ بالله ← يعيذك من الشك ويخسأ عنك الشيطان (من واقعة)","cause":"فضرب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ صدري","result":"أعاذكَ اللهُ من الشكِّ ، وأخسأَ عنك الشيطانَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[34],"ref":"تفسير الطبري 1/21","srcLabel":"الطبري","text":["دخلتُ المسجدَ ، فصليتُ فقرأتُ النَّحلَ ، ثم جاء رجلٌ آخرُ فقرأها على غيرِ قراءتي ، ثم دخل رجلٌ آخرُ فقرأ خلافَ قراءتِنا ، فدخل نفسي من الشكِّ والتكذيبِ أشدُّ مما كان في الجاهليةِ ، فأخذتُ بأيديَهُما ، فأتيتُ بهما النبيَّ صلَّى اللهُ عليهِ وسلَّمَ ، فقلتُ : يا رسولَ اللهِ ، استقرِئْ هذَين ! فقرأ أحدُهما ، فقال : أصبتَ ! ثم استقرَأَ الآخرَ ، فقال : أصبتَ ! فدخل قلبي أشدُّ مما كان في الجاهليةِ من الشكِّ والتكذيبِ ، ",["فضرب رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ صدري",1]," ، وقال : ",["أعاذكَ اللهُ من الشكِّ ، وأخسأَ عنك الشيطانَ",2]," ، قال إسماعيلُ : ففِضتُّ عرَقًا –ولم يقلْه ابنُ أبي ليلى - قال : فقال : أتاني جبريلُ فقال : اقرإِ القرآنَ على حرفٍ واحدٍ ، فقلت : إنَّ أُمَّتي لا تستطيعُ ذلك ، حتى قال سبعَ مراتٍ ، فقال لي : اقرأْ على سبعةِ أحرُفٍ ، ولك بكل رَدَّةٍ رددتَها مسألةٌ ، قال : فاحتاج إليَّ فيها الخلائقُ ، حتى إبراهيمَ صلَّى اللهُ عليهِ وسلَّمَ"],"grade":"صحيح","narrator":"أبي بن كعب","muhaddith":"ثابت","takhrij":"أخرجه الطبري في ((تفسيره)) (32)، والشاشي في ((مسنده)) (1454)","bab":"قرآن › نزول القرآن","dorar":"Eozkwgdv"},{"id":"س-07224","fp":"1f4a9bf37778","stateId":161,"easy":"إذا كرهت وسوسة الشيطان في قلبك وتعاظمتها ← فذاك صريح الإيمان","cause":"لو خَرَّ مِن السَّماءِ فتخطَفُه الطَّيرُ كان أحَبَّ إليه مِن أنْ يتكلَّمَ","result":"ذاك صريحُ الإيمانِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج صحيح ابن حبان 149","srcLabel":"مسلم","text":["أتَيْتُ سُعَيْرَ بنَ الخِمْسِ أسأَلُه عن حديثِ الوسوسةِ فلَمْ يُحدِّثْني فأدبَرْتُ أبكي ثمَّ لقيني فقال: تَعالَ، حدَّثَنا مُغيرةُ عن إبراهيمَ عن علقمةَ عن عبدِ اللهِ قال: سأَلْنا رسولَ اللهِ صلَّى اللهُ عليه وسلَّم عن الرَّجُلِ يجِدُ الشَّيءَ ",["لو خَرَّ مِن السَّماءِ فتخطَفُه الطَّيرُ كان أحَبَّ إليه مِن أنْ يتكلَّمَ",1]," قال: ( ",["ذاك صريحُ الإيمانِ",2]," )"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه مسلم (133) مختصراً بلفظ: \"تلك محض الإيمان\"","bab":"علم › حسن السؤال ونصح العالم","dorar":"YtmGD3ID","merged":17,"otherRefs":["تخريج كتاب السنة 659 (صحيح)","تخريج كتاب السنة 655 (حسن)","مجمع الزوائد 1/38 (صحيح)","رفع البأس عن حديث النفس 37 (صحيح)","صحيح مسلم 132 (صحيح)","تخريج المسند لشعيب 9694 (صحيح)","صحيح ابن حبان 145 (صحيح)","تخريج المسند لشعيب 9876 (صحيح)","تخريج المسند لشعيب 24752 (صحيح)","تخريج كتاب السنة 654 (صحيح)","شرح البخاري لابن الملقن 33/40 (حسن)","تخريج صحيح ابن حبان 148 (صحيح)","تخريج كتاب السنة 657 (صحيح)","صحيح أبي داود 5111 (صحيح)","صحيح مسلم 133 (صحيح)","تخريج كتاب السنة 656 (حسن)"]}]}