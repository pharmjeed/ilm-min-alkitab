رة الله ورحمته","cause":"التوبة إلى الله واستغفاره","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0015","ref":"سورة المائدة: 73–74","quran":{"s":5,"from":73,"to":74,"text":"لَقَدْ كَفَرَ الَّذِينَ قَالُوا إِنَّ اللَّهَ ثَالِثُ ثَلَاثَةٍ وَمَا مِنْ إِلَهٍ إِلَّا إِلَهٌ وَاحِدٌ وَإِنْ لَمْ يَنْتَهُوا عَمَّا يَقُولُونَ لَيَمَسَّنَّ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ (73) أَفَلَا يَتُوبُونَ إِلَى اللَّهِ وَيَسْتَغْفِرُونَهُ وَاللَّهُ غَفُورٌ رَحِيمٌ (74)","hl":[[207,260,1],[260,285,2]]}},{"id":"ق-0358","fp":"5cb63a1d221d","stateId":100,"easy":"التوبة والإصلاح بعد السوء بجهالة ← مغفرة الله ورحمته","cause":"التوبة والإصلاح بعد السوء بجهالة","result":"مغفرة الله ورحمته","explicit":true,"similar":["ق-0688"],"ref":"سورة الأنعام: 54","srcLabel":"القرآن الكريم","quran":{"s":6,"from":54,"to":54,"text":"وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلَامٌ عَلَيْكُمْ كَتَبَ رَبُّكُمْ عَلَى نَفْسِهِ الرَّحْمَةَ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا بِجَهَالَةٍ ثُمَّ تَابَ مِنْ بَعْدِهِ وَأَصْلَحَ فَأَنَّهُ غَفُورٌ رَحِيمٌ (54)","hl":[[128,205,1],[205,230,2]]}},{"id":"ق-0429","fp":"6523d8788fc0","stateId":100,"easy":"التوبة والإيمان بعد عمل السيئات ← مغفرة الله ورحمته","cause":"التوبة والإيمان بعد عمل السيئات","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة الأعراف: 153","srcLabel":"القرآن الكريم","quran":{"s":7,"from":153,"to":153,"text":"وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ (153)","hl":[[0,74,1],[74,120,2]]}},{"id":"ق-0529","fp":"de3bd9e47395","stateId":100,"easy":"التوبة والصدقة ← قبول الله لهما","cause":"التوبة والصدقة","result":"قبول الله لهما","explicit":true,"otherNeedIds":[51],"ref":"سورة التوبة: 104","srcLabel":"القرآن الكريم","quran":{"s":9,"from":104,"to":104,"text":"أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ وَأَنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ (104)","hl":[[0,18,1],[18,45,2],[45,73,1],[73,83,2],[83,140,1]]}},{"id":"ق-0688","fp":"537629a9b39f","stateId":100,"easy":"التوبة والإصلاح بعد السوء بجهالة ← مغفرة الله ورحمته","cause":"التوبة والإصلاح بعد السوء بجهالة","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0358","ref":"سورة النحل: 119","quran":{"s":16,"from":119,"to":119,"text":"ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا السُّوءَ بِجَهَالَةٍ ثُمَّ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ (119)","hl":[[20,107,1],[107,153,2]]}},{"id":"ق-0704","fp":"c763fb673dcb","stateId":100,"easy":"الصلاح والأوبة إلى الله ← مغفرة الله","cause":"الصلاح والأوبة إلى الله","result":"مغفرة الله","explicit":true,"ref":"سورة الإسراء: 25","srcLabel":"القرآن الكريم","quran":{"s":17,"from":25,"to":25,"text":"رَبُّكُمْ أَعْلَمُ بِمَا فِي نُفُوسِكُمْ إِنْ تَكُونُوا صَالِحِينَ فَإِنَّهُ كَانَ لِلْأَوَّابِينَ غَفُورًا (25)","hl":[[41,67,1],[67,82,2],[82,99,1],[99,107,2]]}},{"id":"ق-0749","fp":"0636508f0b3c","stateId":100,"easy":"التوبة والإيمان والعمل الصالح ← دخول الجنة بلا ظلم","cause":"التوبة والإيمان والعمل الصالح","result":"دخول الجنة بلا ظلم","explicit":true,"otherNeedIds":[67],"ref":"سورة مريم: 60","srcLabel":"القرآن الكريم","quran":{"s":19,"from":60,"to":60,"text":"إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا فَأُولَئِكَ يَدْخُلُونَ الْجَنَّةَ وَلَا يُظْلَمُونَ شَيْئًا (60)","hl":[[0,44,1],[44,104,2]]}},{"id":"ق-0772","fp":"f5b134de006a","stateId":100,"easy":"التوبة والإيمان والعمل الصالح ثم الاهتداء ← مغفرة الله","cause":"التوبة والإيمان والعمل الصالح ثم الاهتداء","result":"مغفرة الله","explicit":true,"ref":"سورة طه: 82","srcLabel":"القرآن الكريم","quran":{"s":20,"from":82,"to":82,"text":"وَإِنِّي لَغَفَّارٌ لِمَنْ تَابَ وَآمَنَ وَعَمِلَ صَالِحًا ثُمَّ اهْتَدَى (82)","hl":[[0,19,2],[19,73,1]]}},{"id":"ق-0777","fp":"802a0bac73cd","stateId":100,"easy":"التوبة بعد المعصية ← الاجتباء والتوبة والهداية","cause":"التوبة بعد المعصية","result":"الاجتباء والتوبة والهداية","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[15],"ref":"سورة طه: 122","srcLabel":"القرآن الكريم","quran":{"s":20,"from":122,"to":122,"text":"ثُمَّ اجْتَبَاهُ رَبُّهُ فَتَابَ عَلَيْهِ وَهَدَى (122)","hl":[[0,49,1]]}},{"id":"ق-0848","fp":"41f356db1772","stateId":100,"easy":"التوبة والإصلاح ← مغفرة الله ورحمته","cause":"التوبة والإصلاح","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0055","ref":"سورة النور: 5","quran":{"s":24,"from":5,"to":5,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (5)","hl":[[7,57,1],[57,88,2]]}},{"id":"ق-0884","fp":"4882d399424b","stateId":100,"easy":"التوبة والعمل الصالح ← متاب مقبول إلى الله","cause":"التوبة والعمل الصالح","result":"متاب مقبول إلى الله","explicit":true,"ref":"سورة الفرقان: 71","srcLabel":"القرآن الكريم","quran":{"s":25,"from":71,"to":71,"text":"وَمَنْ تَابَ وَعَمِلَ صَالِحًا فَإِنَّهُ يَتُوبُ إِلَى اللَّهِ مَتَابًا (71)","hl":[[0,31,1],[31,71,2]]}},{"id":"ق-1060","fp":"dca81e99c094","stateId":100,"easy":"الاستغفار والركوع والإنابة ← المغفرة والزلفى وحسن المآب","cause":"الاستغفار والركوع والإنابة","result":"المغفرة والزلفى وحسن المآب","explicit":true,"otherNeedIds":[26],"ref":"سورة ص: 24–25","srcLabel":"القرآن الكريم","quran":{"s":38,"from":24,"to":25,"text":"قَالَ لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَى نِعَاجِهِ وَإِنَّ كَثِيرًا مِنَ الْخُلَطَاءِ لَيَبْغِي بَعْضُهُمْ عَلَى بَعْضٍ إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَقَلِيلٌ مَا هُمْ وَظَنَّ دَاوُودُ أَنَّمَا فَتَنَّاهُ فَاسْتَغْفَرَ رَبَّهُ وَخَرَّ رَاكِعًا وَأَنَابَ (24) فَغَفَرْنَا لَهُ ذَلِكَ وَإِنَّ لَهُ عِنْدَنَا لَزُلْفَى وَحُسْنَ مَآبٍ (25)","hl":[[197,288,1],[288,359,2]]}},{"id":"ق-1103","fp":"d72aa520f512","stateId":100,"easy":"الإيمان والتوبة واتباع سبيل الله ← استغفار حملة العرش ودعاؤهم بالوقاية والجنة مع الصالحين من الأهل","cause":"الإيمان والتوبة واتباع سبيل الله","result":"استغفار حملة العرش ودعاؤهم بالوقاية والجنة مع الصالحين من الأهل","explicit":true,"otherNeedIds":[66,67,37],"ref":"سورة غافر: 7–9","srcLabel":"القرآن الكريم","quran":{"s":40,"from":7,"to":9,"text":"الَّذِينَ يَحْمِلُونَ الْعَرْشَ وَمَنْ حَوْلَهُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِ وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا رَبَّنَا وَسِعْتَ كُلَّ شَيْءٍ رَحْمَةً وَعِلْمًا فَاغْفِرْ لِلَّذِينَ تَابُوا وَاتَّبَعُوا سَبِيلَكَ وَقِهِمْ عَذَابَ الْجَحِيمِ (7) رَبَّنَا وَأَدْخِلْهُمْ جَنَّاتِ عَدْنٍ الَّتِي وَعَدْتَهُمْ وَمَنْ صَلَحَ مِنْ آبَائِهِمْ وَأَزْوَاجِهِمْ وَذُرِّيَّاتِهِمْ إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ (8) وَقِهِمُ السَّيِّئَاتِ وَمَنْ تَقِ السَّيِّئَاتِ يَوْمَئِذٍ فَقَدْ رَحِمْتَهُ وَذَلِكَ هُوَ الْفَوْزُ الْعَظِيمُ (9)","hl":[[0,99,1],[99,116,2],[116,238,1],[238,548,2]]}},{"id":"ق-1153","fp":"e960e01bf687","stateId":100,"easy":"التوبة ← قبولها والعفو عن السيئات","cause":"التوبة","result":"قبولها والعفو عن السيئات","explicit":true,"ref":"سورة الشورى: 25","srcLabel":"القرآن الكريم","quran":{"s":42,"from":25,"to":25,"text":"وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا تَفْعَلُونَ (25)","hl":[[0,23,2],[23,36,1],[36,79,2]]}},{"id":"ق-1357","fp":"f43f9a4ac587","stateId":100,"easy":"التوبة النصوح ← تكفير السيئات ودخول الجنات والنور يوم القيامة","cause":"التوبة النصوح","result":"تكفير السيئات ودخول الجنات والنور يوم القيامة","explicit":true,"otherNeedIds":[67,65],"ref":"سورة التحريم: 8","srcLabel":"القرآن الكريم","quran":{"s":66,"from":8,"to":8,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا عَسَى رَبُّكُمْ أَنْ يُكَفِّرَ عَنْكُمْ سَيِّئَاتِكُمْ وَيُدْخِلَكُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ يَوْمَ لَا يُخْزِي اللَّهُ النَّبِيَّ وَالَّذِينَ آمَنُوا مَعَهُ نُورُهُمْ يَسْعَى بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا وَاغْفِرْ لَنَا إِنَّكَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ (8)","hl":[[31,71,1],[71,305,2],[305,400,1]]}},{"id":"س-06976","fp":"d7fa8d9d0261","stateId":100,"easy":"إذا استغفرت الله ← يغفر لك","cause":"فاستَغفِروني","result":"أغفِرْ لكم","explicit":true,"repOf":"س-01803","ref":"تخريج المسند لشعيب 21367","text":["يقولُ اللهُ عزَّ وجلَّ: يا عِبادي، كلُّكم مُذنبٌ إلَّا مَن عافَيْتُ، ",["فاستَغفِروني",1]," ",["أغفِرْ لكم",2],"، ومَن علِمَ أنِّي أقدِرُ على المَغفِرةِ، فاستَغفَرَني بقُدْرَتي غفَرْتُ له ولا أُبالي، وكلُّكم ضالٌّ إلَّا مَن هدَيْتُ، فاسْتَهْدوني أَهْدِكم، وكلُّكم فَقيرٌ إلَّا مَن أغنَيْتُ، فاسْأَلوني أُغْنِكم، ولو أنَّ أوَّلَكم وآخِرَكم، وحَيَّكم وميِّتَكم، ورَطْبَكم ويابِسَكم، اجْتَمَعوا على أَشْقى قَلبٍ من قُلوبِ عِبادي، ما نقَصَ في مُلْكي جَناحَ بَعوضةٍ، ولوِ اجْتَمَعوا على أَتْقى قَلبِ عبدٍ من عِبادي، ما زادَ في مُلْكي جَناحَ بَعوضةٍ، ولو أنَّ أوَّلَكم وآخِرَكم، وحَيَّكم وميِّتَكم، ورَطْبَكم ويابِسَكم اجْتَمَعوا فسأَلَني كلُّ سائلٍ منهم ما بلَغَتْ أُمنِيَّتُه، فأَعْطيْتُ كلَّ سائلٍ منهم ما سأَلَ ما نَقَصَني، كما لو أنَّ أحَدَكم مَرَّ بشَفَةِ البَحرِ، فغمَسَ فيه إبرةً، ثُم انتَزَعها، كذلك لا يَنقُصُ من مُلْكي؛ ذلك بأنِّي جَوادٌ ماجدٌ صَمَدٌ، عَطائي كلامٌ، وعَذابي كلامٌ، إذا أرَدْتُ شيئًا فإنَّما أقولُ له: كُنْ، فيكونُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4257)، وأحمد (21367) واللفظ له","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"QBOFJGqb","merged":4,"otherRefs":["تخريج المسند لشعيب 21540 (صحيح)","حلية الأولياء 5/144 (صحيح)","الأسماء والصفات للبيهقي 1/211 (صحيح)"]},{"id":"س-02337","fp":"2efaf8d4b4d3","stateId":100,"easy":"إذا أكثرت التوبة كلما أخطأت ← تكون من خير الخطّائين","cause":"التَّوَّابونَ","result":"وخَيرُ الخَطَّائينَ","explicit":true,"ref":"مجموع الشروح الفقهية. 209/30","srcLabel":"مجموع الشروح الفقهية","text":["كُلُّ بَني آدَمَ خَطَّاءٌ، ",["وخَيرُ الخَطَّائينَ",2]," ",["التَّوَّابونَ",1],"."],"grade":"صحيح","narrator":"أنس","muhaddith":"صحيح","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"cHZWtJ7w","merged":2,"otherRefs":["القائد إلى تصحيح العقائد 27 (حسن)"]},{"id":"س-03459","fp":"e1d3ef703121","stateId":100,"easy":"إذا استغفرت الله ← يغفر لك","cause":"ثم استَغْفَرْتَنِي","result":"غفرتُ لك","explicit":true,"repOf":"س-01803","ref":"هداية الرواة 2276","text":["قال اللهُ – تعالى – يا ابنَ آدمَ ! إنك ما دَعَوْتَنِي ورَجَوْتَنِي ؛ غفرتُ لك ما كان فيك ولا أُبَالِي، يا ابنَ آدمَ ! لو بَلَغَتْ ذنوبُكَ عَنَانَ السماءِ، ",["ثم استَغْفَرْتَنِي",1]," ؛ ",["غفرتُ لك",2]," ولا أُبَالِي، يا ابنَ آدمَ ! إنك لو أَتَيْتَنِي بقُرَابِ الأرضِ خَطَايَا، ثم لَقِيتَنِي لا تُشْرِكُ بي شيئًا ؛ لَأَتَيْتُكَ بقُرَابِها مَغْفِرَةً"],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن بل صحيح","takhrij":"أخرجه الترمذي (3540) واللفظ له، وأحمد (13493) مختصراً بمعناه.","bab":"استغفار › فضل الاستغفار","dorar":"b0r8OsTX","merged":2,"otherRefs":["الأحاديث المختارة 1571 (صحيح)"]},{"id":"س-03968","fp":"97bdbf0ca067","stateId":100,"easy":"إذا استغفرت ← لا تبقى كبيرة (مع الاستغفار)","cause":"معَ استِغفارٍ","result":"لا كبيرةَ","explicit":true,"ref":"الآداب الشرعية 1/153","srcLabel":"الطبري","text":["أنَّ رجلًا قالَ لابنِ عبَّاسٍ : كَم الكبائرُ ، أسَبعٌ هي ؟ قالَ : هيَ إلى سَبعِمائةٍ أقربُ منها إلى سبعٍ غيرَ أنَّهُ ",["لا كبيرةَ",2]," ",["معَ استِغفارٍ",1]," ولا صغيرةَ معَ إصرارٍ"],"grade":"صحيح","narrator":"سعيد بن جبير","muhaddith":"إسناده صحيح","takhrij":"أخرجه الطبري في ((جامع البيان)) (6/ 651)، وابن المنذر في ((التفسير)) (1670)، وابن أبي حاتم في ((التفسير)) (5217) واللفظ لهم جميعا.","bab":"توبة › الحض على التوبة","dorar":"VVQkUQf0","merged":2,"otherRefs":["أصول الفقه لابن مفلح 2/534 (صحيح)"]},{"id":"س-07479","fp":"690c11f194e9","stateId":100,"easy":"إذا استغفرت الله ← لا يزال يغفر لك","cause":"ما استَغْفَروني","result":"لا أزالُ أغفِرُ لهم","explicit":true,"repOf":"س-01803","ref":"المستدرك على الصحيحين 7881","text":["إنَّ الشَّيْطانَ قالَ: وعزَّتِكَ يا ربِّ، لا أبرَحُ أُغوي عِبادَكَ ما دامَتْ أرواحُهُم في أجسادِهِم، فقالَ الرَّبُّ تباركَ وتَعالَى: وعِزَّتي وجَلالِي ",["لا أزالُ أغفِرُ لهم",2]," ",["ما استَغْفَروني",1],"."],"grade":"صحيح","narrator":"أبو سعيد","muhaddith":"صحيح الإسناد","takhrij":"أخرجه أبو يعلى (1399)، والبغوي في ((شرح السنة)) (1293) واللفظ لهما، وأحمد (11244) بنحوه.","bab":"فضائل النبي وصفته ودلائل النبوة › إخبار النبي عن المغيبات","dorar":"dOkTbUuG","merged":2,"otherRefs":["مجمع الزوائد 10/210 (صحيح)"]},{"id":"س-03440","fp":"a6a8d591f687","stateId":100,"easy":"إذا ألممت بذنب ثم تبت واستغفرت ← يغفر الله لك","cause":"فإنَّ العَبدَ إذا ألَمَّ بذَنبٍ، ثم تابَ واستَغْفَرَ","result":"غَفَرَ اللهُ له","explicit":true,"repOf":"س-07061","ref":"تخريج المسند لشعيب 43/315","text":["أنَّ النبيَّ صلَّى اللهُ عليه وسلَّمَ قال لها: \"يا عائِشةُ، إنْ كُنتِ ألْمَمْتِ بذَنبٍ فاستَغْفِري اللهَ؛ ",["فإنَّ العَبدَ إذا ألَمَّ بذَنبٍ، ثم تابَ واستَغْفَرَ",1]," اللهَ عزَّ وجلَّ ",["غَفَرَ اللهُ له\"",2],"."],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"صحيح بهذا السياق، إلا أن سفيان لم يحفظه","takhrij":"أخرجه الحميدي (284)، وابن حبان (624)","bab":"استغفار › فضل الاستغفار","dorar":"QrZkH2hK"},{"id":"س-03985","fp":"068818e177a6","stateId":100,"easy":"إذا تبت من الذنب ← تكون كمن لا ذنب له","cause":"التَّائبُ منَ الذَّنبِ","result":"كمن لا ذنبَ لَهُ","explicit":true,"ref":"فتاوى نور على الدرب لابن باز 17/70","srcLabel":"فتاوى نور على الدرب لابن باز","text":[["التَّائبُ منَ الذَّنبِ",1]," ",["كمن لا ذنبَ لَهُ",2]],"grade":"صحيح","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"hZKqYVWl"},{"id":"س-03991","fp":"c954478e4a34","stateId":100,"easy":"إذا تبت توبة نصوحاً ← تكفّر كل سيئة","cause":"التَّوبةُ النَّصوحُ","result":"تُكفِّرُ كُلَّ سيِّئةٍ","explicit":true,"ref":"المستدرك على الصحيحين 3877","srcLabel":"أحمد","text":["قالَ عبدُ اللهِ بنُ مسعودٍ رَضيَ اللهُ عنه، ",["التَّوبةُ النَّصوحُ",1]," ",["تُكفِّرُ كُلَّ سيِّئةٍ",2],"، وهو في القرآنِ، ثُمَّ قَرَأَ: {يَا أَيُّهَا الَّذِينَ آمَنُوا تُوبُوا إِلَى اللَّهِ تَوْبَةً نَصُوحًا عَسَى رَبُّكُمْ أَنْ يُكَفِّرَ عَنْكُمْ سَيِّئَاتِكُمْ} [التحريم: 8] الآيةَ."],"grade":"صحيح","narrator":"عباية الأسدي","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6741) بلفظه، وابن أبي شيبة (34560)، وأحمد (4264) بنحوه","bab":"توبة › الحض على التوبة","dorar":"kBnUkNQU"},{"id":"س-03993","fp":"80b7825735e8","stateId":100,"easy":"إذا أخطأت فأحببت التوبة فأتيت مكاناً مرتفعاً فدعوت وتبت ← يغفر الله لك ما لم ترجع","cause":"فإذا أخطَأَ خَطيئةً فأحَبَّ أنْ يَتوبَ إلى اللهِ عزَّ وجلَّ، فلْيَأْتِ بُقْعةً رَفيعةً، فلْيَمْدُدْ يدَيْهِ إلى اللهِ عزَّ وجلَّ، ثمَّ يقولُ: اللَّهُمَّ إنِّي أتوبُ إليكَ منها، لا أرجِعُ إليها أبدًا","result":"فإنَّه يَغفِرُ له ما لم يَرجِعْ في عَملِهِ ذلكَ","explicit":true,"ref":"المستدرك على الصحيحين 7882","srcLabel":"الطبراني","text":["كُلُّ شَيْءٍ تكلَّمَ بهِ ابنُ آدَمَ، فإنَّه مكتوبٌ عليهِ، ",["فإذا أخطَأَ خَطيئةً فأحَبَّ أنْ يَتوبَ إلى اللهِ عزَّ وجلَّ، فلْيَأْتِ بُقْعةً رَفيعةً، فلْيَمْدُدْ يدَيْهِ إلى اللهِ عزَّ وجلَّ، ثمَّ يقولُ: اللَّهُمَّ إنِّي أتوبُ إليكَ منها، لا أرجِعُ إليها أبدًا",1],"؛ ",["فإنَّه يَغفِرُ له ما لم يَرجِعْ في عَملِهِ ذلكَ",2],"."],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"صحيح على شرط الشيخين","takhrij":"أخرجه الطبراني في ((الدعاء)) (صـ85)، والبيهقي (20598)، وقوام السنة في ((الترغيب والترهيب)) (784) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"Gg65jSVO"},{"id":"س-04048","fp":"bb82c39be572","stateId":100,"easy":"إذا أذنبت فاستغفر الله ← فالاستغفار دواء الذنوب","cause":"أنْ تَستغفِرَ اللهَ عزَّ وجلَّ","result":"ودَواءُ الذُّنوبِ","explicit":true,"ref":"المستدرك على الصحيحين 7816","srcLabel":"الدولابي","text":["عنْ أنسِ بنِ مالكٍ رَضيَ اللهُ عنه، أنَّ أبا ذَرٍّ الغِفاريَّ بالَ قائمًا، فانتَضَحَ مِن بَوْلِه على ساقَيْهِ وقَدَمَيْه، فقالَ له رَجُلٌ: إنَّه أصابَ مِن بَوْلِكَ قَدَمَيْكَ وساقَيْكَ، فلمْ يَرُدَّ عليه شيئًا حتَّى انْتَهى إلى دارِ قَوْمٍ، فاسْتَوْهَبَهم طَهورًا فأخْرَجوا إليه، فتَوَضَّأَ وغَسَلَ ساقَيْهِ وقَدَمَيْهِ، ثمَّ أقبَلَ على الرَّجُلِ، فقال: ماذا قُلْتَ؟ فقال: أمَّا الآنَ فقَدْ فعَلْتَ، فقال أبو ذَرٍّ رَضيَ اللهُ عنه: هذا دَواءُ هذا، ",["ودَواءُ الذُّنوبِ",2]," ",["أنْ تَستغفِرَ اللهَ عزَّ وجلَّ",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"إسناده صحيح","takhrij":"أخرجه الدولابي في ((الكنى)) (695)","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"mx3VAzPW"},{"id":"س-04021","fp":"c321d5d4739d","stateId":100,"easy":"إذا استغفرت (ولم تُصرّ) ← فأنت غير مُصرّ ولو عدت","cause":"مَنِ استَغفَرَ","result":"ما أَصَرَّ","explicit":true,"ref":"تخريج مسند أبي بكر 122","srcLabel":"أبو داود","text":["«",["ما أَصَرَّ",2]," ",["مَنِ استَغفَرَ",1],"، وإنْ عاد في النَّهارِ سَبعينَ مرَّةً»."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"حسن","takhrij":"أخرجه أبو داود (1514)، والترمذي (3559) باختلاف يسير، وأبو بكر المروزي في ((مسند أبي بكر)) (122) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"k0im2FbZ","merged":2,"otherRefs":["تخريج مسند أبي بكر 121 (حسن)"]},{"id":"س-01101","fp":"dc089c97bbab","stateId":100,"easy":"إذا استغفرت الله ← يُغفر لك","cause":"ومَن استغفرَ اللهَ","result":"غُفِرَ لهُ","explicit":true,"repOf":"س-01803","ref":"سنن الترمذي 3470","text":["قولوا : سبحانَ اللهِ ، وبحمدِهِ ، مائةَ مرَّةٍ ، مَن قالَها مرَّةً كُتِبَتْ لهُ عشرًا ، ومَن قالها عشرًا كُتِبَتْ لهُ مائةً ، ومَن قالها مائةً كُتِبَتْ لهُ ألفًا ، ومَن زادَ زادَهُ اللهُ ، ",["ومَن استغفرَ اللهَ ",1],["غُفِرَ لهُ",2]],"grade":"حسن","narrator":"عبدالله بن عمر","muhaddith":"حسن غريب","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9987) باختلاف يسير، والطبراني في ((المعجم الأوسط)) (2921)، والبيهقي (18073) باختلاف يسير مطولاً","bab":"أدعية وأذكار › فضل الذكر","dorar":"dOVtJg0J"},{"id":"س-03939","fp":"b043b9ea7356","stateId":100,"easy":"إذا عملت سوءاً أو ظلمت نفسك ثم استغفرت الله ← تجد الله غفوراً رحيماً","cause":"مَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ","result":"يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","explicit":true,"repOf":"س-08381","ref":"فتح الباري لابن حجر 11/272","text":["أتاني آتٍ من ربِّي فقالَ: ",["مَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ",1]," ",["يَجِدِ اللَّهَ غَفُورًا رَحِيمًا",2]," فقلتُ: يا رسولَ اللَّهِ وإن زنى وإن سرَقَ قالَ: نعَم ثمَّ ثلَّثتُ فقالَ: على رُغمِ أنفِ عويمرٍ فردَّدَها قالَ: فأنا رأيتُ أبا الدَّرداءِ يضربُ أنفَهُ بإصبعِهِ"],"grade":"حسن","narrator":"أبو الدرداء","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو يعلى كما في ((إتحاف الخيرة المهرة)) للبوصيري (6/199)","bab":"تفسير آيات › سورة النساء","dorar":"GawtaOqJ"},{"id":"س-04017","fp":"3cc231783840","stateId":100,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك","cause":"بقَومٍ لهم ذُنوبٌ","result":"يَغفِرُها لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح مسلم 2748","text":["لَو أنَّكُم لم تَكُنْ لَكُم ذُنوبٌ يَغفِرُها اللهُ لَكُم، لَجاءَ اللهُ ",["بقَومٍ لهم ذُنوبٌ",1]," ",["يَغفِرُها لهم",2],"."],"grade":"صحيح","narrator":"أبو أيوب الأنصاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"توبة › الحض على التوبة","dorar":"MpTnTYBI","merged":2,"otherRefs":["المستدرك على الصحيحين 7831 (صحيح)"]},{"id":"س-03973","fp":"bf8605c36a51","stateId":100,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك، فالله يحب أن يغفر","cause":"يُذْنِبونَ","result":"ليغفِرَ لهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح الجامع 5301","text":["لو لم تُذنِبوا لجاءَ اللهَ تعالى بقومٍ ",["يُذْنِبونَ",1]," ، ",["ليغفِرَ لهم",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه أحمد (2623) واللفظ له، والبزار (5299)، وابن عدي في ((الكامل في الضعفاء)) (7/205) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"3RHcJTPG","merged":2,"otherRefs":["الجامع الصغير 6238 (حسن)"]},{"id":"س-08211","fp":"713ed8ca615b","stateId":100,"easy":"إذا أذنبت فاستغفرت ← يغفر الله لك، ولو لم تذنبوا لجاء بقوم يذنبون فيغفر لهم","cause":"كي يُذنِبوا","result":"فيغفرَ لَهُم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-07061","ref":"صحيح الترمذي 2526","text":["قُلنا يا رسولَ اللَّهِ : ما لَنا إذا كنَّا عندَكَ رقَّت قلوبُنا ، وزَهِدنا في الدُّنيا ، وَكُنَّا من أَهْلِ الآخرةِ ، فإذا خَرجنا من عِندِكَ فآنَسنا أَهالينا ، وشَمِمنا أولادَنا أنكَرنا أنفسَنا فقالَ رسولُ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ : لو أنَّكم تَكونونَ إذا خرجتُمْ من عندي كنتُمْ على حالِكُم ذلِكَ لزارتْكمُ الملائِكَةُ في بيوتِكُم ، ولو لم تُذنِبوا لجاءَ اللَّهُ بخَلقٍ جديدٍ ",["كي يُذنِبوا",1]," ",["فيغفرَ لَهُم",2]," قالَ : قلتُ يا رسولَ اللَّهِ ممَّ خُلِقَ الخلقُ ؟ قالَ : منَ الماءِ ، قلتُ : الجنَّةُ ما بناؤُها ؟ قالَ : لبِنةٌ من فضَّةٍ ولبنةٌ من ذَهَبٍ ، وملاطُها المسكُ الأذفرُ ، وحصباؤُها اللُّؤلؤُ والياقوتُ ، وتُربتُها الزَّعفرانُ مَن دخلَها ينعَمُ ولا يبأسُ ، ويخلدُ ولا يموتُ ، لا تبلَى ثيابُهُم ، ولا يفنى شَبابُهُم ثمَّ قالَ : ثلاثٌ لا تُرَدُّ دعوتُهُم ، الإمامُ العادلُ ، والصَّائمُ حينَ يُفطرُ ، ودعوةُ المظلومِ يرفعُها فوقَ الغمامِ ، وتُفتَّحُ لَها أبوابُ السَّماءِ ، ويقولُ الرَّبُّ تبارك وتعالى : وعزَّتي لأنصرنَّكِ ولو بعدَ حينٍ ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح دون قوله مم خلق الخلق","takhrij":"أخرجه الترمذي (2526)، وأحمد (8043) باختلاف يسير.","bab":"ملائكة › أعمال الملائكة","dorar":"UXjjPkwr","merged":2,"otherRefs":["علل الدارقطني 2258 (صحيح)"]},{"id":"س-04008","fp":"7ca405cf13f2","stateId":100,"easy":"إذا تاب الناس ← تاب الله عليهم","cause":"فإنْ تابوا","result":"تابَ اللهُ عليهم","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"المستدرك على الصحيحين 8772","srcLabel":"نعيم","text":["لنْ تَبلُغوا بخيرٍ ما اسْتَغنى أهلُ بَدْوِكم عن أهلِ حَضرِكم، قال: ولَتَسُوقَنَّهم السِّنينُ والسِّناتُ حتَّى يَكونوا معكم في الدِّيارِ، ولا تَمْنَعوا منهم لكَثرةِ مَن يَسْتَنُّ عليكم، قال: يَقولون: طالَما جُعْنا وشَبِعْتم، وطالَما شَقِينا ونَعِمتُم، فواسُونا اليومَ، ولَنَسْتصْعِبَنَّ بكم الأرضَ، حتَّى يَغبِطَ أهلُ حَضرِكم مِن استصعابِ الأرضِ. قال: ولَتَمِيلَنَّ بكم الأرضُ مَيْلةً، يَهلِكُ منها مَن هَلَك، ويَبْقى مَن بَقِي حتَّى تَعْنُوا الرِّقابُ، ثمَّ تَهدَأُ بكم الأرضُ بعْدَ ذلكَ حتَّى يَندَمَ المُعتِقون، قال: ثمَّ تَميلُ بكم الأرضُ مِن بعدِ ذلكَ مَيلةً أُخرى، فيَهلِكُ فيها مَن هَلَكَ، ويَبْقى مَن بَقِي، فيَقولُون: ربَّنا نُعتِقُ، ربَّنا نُعتِقُ، فيُكذِّبُهم اللهُ: كذَبْتُم كذَبْتُم، أنا أُعتِقُ. قال: ولَيُبْتَلَينَّ أُخْرياتُ هذه الأُمَّةِ بالرَّجفِ؛ ",["فإنْ تابوا",1]," ",["تابَ اللهُ عليهم",2],"، قال: وإنْ عادوا أعاد اللهُ عليهم بالرَّجفِ والقذْفِ والخسْفِ والمسْخِ والصَّواعقِ، فإذا قِيل: هَلَك النَّاسُ، هَلَك النَّاسُ، هَلَك النَّاسُ، فقدْ هَلَكوا، ولنْ يُعذِّبَ اللهُ تعالَى أُمَّةً حتَّى يَعذِرَ، قالوا: وما عُذرُها؟ قال: يَعترِفون بالذُّنوبِ ولا يَتوبون، ولَتَطْمَئنَّ بالقلوبِ بما فِيها مِن بِرِّها وفُجورِها كما تَطْمَئنُّ الشَّجرةُ بما فيها، حتَّى لا يَستطيعَ مُحسِنٌ أنْ يَزدادَ إحسانًا، ولا يَستطيعَ مُسِيءٌ استعتابًا، وذلك بأنَّ اللهَ عزَّ وجلَّ قال: {كَلَّا بَلْ رَانَ عَلَى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ} [المطففين:14]"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"صحيح الإسناد، ولم يخرجاه","takhrij":"أخرجه نعيم بن حماد في ((الفتن)) (685) ببعض لفظه.","bab":"توبة › الحض على التوبة","dorar":"unIdEOfM"},{"id":"ق-0536","fp":"9b1ce45a36d8","stateId":100,"easy":"الصدق واليقين بأن لا ملجأ من الله إلا إليه عند الضيق ← توبة الله","cause":"الصدق واليقين بأن لا ملجأ من الله إلا إليه عند الضيق","result":"توبة الله","explicit":true,"star":true,"otherNeedIds":[4],"ref":"سورة التوبة: 118","srcLabel":"القرآن الكريم","quran":{"s":9,"from":118,"to":118,"text":"وَعَلَى الثَّلَاثَةِ الَّذِينَ خُلِّفُوا حَتَّى إِذَا ضَاقَتْ عَلَيْهِمُ الْأَرْضُ بِمَا رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ أَنْفُسُهُمْ وَظَنُّوا أَنْ لَا مَلْجَأَ مِنَ اللَّهِ إِلَّا إِلَيْهِ ثُمَّ تَابَ عَلَيْهِمْ لِيَتُوبُوا إِنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ (118)","hl":[[0,189,1],[189,223,2],[223,265,1]]}},{"id":"س-03946","fp":"8c8da2cbf1c0","stateId":101,"easy":"إذا اعترفت بذنبك ثم تبت ← يتوب الله عليك","cause":"فإنَّ العَبْدَ إذَا اعْتَرَفَ بذَنْبٍ، ثُمَّ تَابَ","result":"تَابَ اللَّهُ عليه قالَتْ: فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، مَقالَتَهُ قَلَصَ دَمْعِي حتَّى ما أُحِسُّ منه","explicit":true,"similar":["س-04601"],"ref":"تفسير القرطبي 15/161","srcLabel":"متفق عليه","text":["حديثُ الإفكِ الطويلِ في قصةِ عائشةَ رضوانُ اللهِ عليها [يعني حديث: كانَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ إذَا أَرَادَ أَنْ يَخْرُجَ سَفَرًا، أَقْرَعَ بيْنَ نِسَائِهِ، فأيَّتُهُنَّ خَرَجَ سَهْمُهَا خَرَجَ بهَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ معهُ . قالَتْ عَائِشَةُ: فأقْرَعَ بيْنَنَا في غَزْوَةٍ غَزَاهَا، فَخَرَجَ فِيهَا سَهْمِي، فَخَرَجْتُ مع رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، وَذلكَ بَعْدَ ما أُنْزِلَ الحِجَابُ، فأنَا أُحْمَلُ في هَوْدَجِي، وَأُنْزَلُ فيه مَسِيرَنَا حتَّى إذَا فَرَغَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ مِن غَزْوِهِ، وَقَفَلَ، وَدَنَوْنَا مِنَ المَدِينَةِ، آذَنَ لَيْلَةً بالرَّحِيلِ فَقُمْتُ حِينَ آذَنُوا بالرَّحِيلِ، فَمَشيتُ حتَّى جَاوَزْتُ الجَيْشَ، فَلَمَّا قَضَيْتُ مِن شَأْنِي أَقْبَلْتُ إلى الرَّحْلِ، فَلَمَسْتُ صَدْرِي فَإِذَا عِقْدِي مِن جَزْعِ ظَفَارِ قَدِ انْقَطَعَ، فَرَجَعْتُ فَالْتَمَسْتُ عِقْدِي فَحَبَسَنِي ابْتِغَاؤُهُ وَأَقْبَلَ الرَّهْطُ الَّذِينَ كَانُوا يَرْحَلُونَ لي فَحَمَلُوا هَوْدَجِي فَرَحَلُوهُ علَى بَعِيرِيَ الذي كُنْتُ أَرْكَبُ وَهُمْ يَحْسِبُونَ أَنِّي فِيهِ . قالَتْ: وَكَانَتِ النِّسَاءُ إذْ ذَاكَ خِفَافًا، لَمْ يُهَبَّلْنَ وَلَمْ يَغْشَهُنَّ اللَّحْمُ، إنَّما يَأْكُلْنَ العُلْقَةَ مِنَ الطَّعَامِ، فَلَمْ يَسْتَنْكِرِ القَوْمُ ثِقَلَ الهَوْدَجِ حِينَ رَحَلُوهُ وَرَفَعُوهُ، وَكُنْتُ جَارِيَةً حَدِيثَةَ السِّنِّ، فَبَعَثُوا الجَمَلَ وَسَارُوا، وَوَجَدْتُ عِقْدِي بَعْدَ ما اسْتَمَرَّ الجَيْشُ، فَجِئْتُ مَنَازِلَهُمْ وَليسَ بهَا دَاعٍ وَلَا مُجِيبٌ، فَتَيَمَّمْتُ مَنْزِلِي الذي كُنْتُ فِيهِ، وَظَنَنْتُ أنَّ القَوْمَ سَيَفْقِدُونِي فَيَرْجِعُونَ إلَيَّ، فَبيْنَا أَنَا جَالِسَةٌ في مَنْزِلِي غَلَبَتْنِي عَيْنِي فَنِمْتُ، وَكانَ صَفْوَانُ بنُ المُعَطَّلِ السُّلَمِيُّ ثُمَّ الذَّكْوَانِيُّ قدْ عَرَّسَ مِن وَرَاءِ الجَيْشِ فَادَّلَجَ، فأصْبَحَ عِنْدَ مَنْزِلِي فَرَأَى سَوَادَ إنْسَانٍ نَائِمٍ، فأتَانِي فَعَرَفَنِي حِينَ رَآنِي، وَقَدْ كانَ يَرَانِي قَبْلَ أَنْ يُضْرَبَ الحِجَابُ عَلَيَّ، فَاسْتَيْقَظْتُ باسْتِرْجَاعِهِ حِينَ عَرَفَنِي، فَخَمَّرْتُ وَجْهِي بجِلْبَابِي، وَوَاللَّهِ ما يُكَلِّمُنِي كَلِمَةً وَلَا سَمِعْتُ منه كَلِمَةً غيرَ اسْتِرْجَاعِهِ، حتَّى أَنَاخَ رَاحِلَتَهُ، فَوَطِئَ علَى يَدِهَا فَرَكِبْتُهَا، فَانْطَلَقَ يَقُودُ بيَ الرَّاحِلَةَ، حتَّى أَتَيْنَا الجَيْشَ، بَعْدَ ما نَزَلُوا مُوغِرِينَ في نَحْرِ الظَّهِيرَةِ، فَهَلَكَ مَن هَلَكَ في شَأْنِي، وَكانَ الذي تَوَلَّى كِبْرَهُ عبدُ اللهِ بنُ أُبَيٍّ ابنُ سَلُولَ، فَقَدِمْنَا المَدِينَةَ فَاشْتَكَيْتُ، حِينَ قَدِمْنَا المَدِينَةَ شَهْرًا، وَالنَّاسُ يُفِيضُونَ في قَوْلِ أَهْلِ الإفْكِ، وَلَا أَشْعُرُ بشيءٍ مِن ذلكَ، وَهو يَرِيبُنِي في وَجَعِي أَنِّي لا أَعْرِفُ مِن رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ اللُّطْفَ، الذي كُنْتُ أَرَى منه حِينَ أَشْتَكِي، إنَّما يَدْخُلُ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ فيُسَلِّمُ، ثُمَّ يقولُ: كيفَ تِيكُمْ؟ فَذَاكَ يَرِيبُنِي، وَلَا أَشْعُرُ بالشَّرِّ، حتَّى خَرَجْتُ بَعْدَ ما نَقَهْتُ وَخَرَجَتْ مَعِي أُمُّ مِسْطَحٍ قِبَلَ المَنَاصِعِ، وَهو مُتَبَرَّزُنَا، وَلَا نَخْرُجُ إلَّا لَيْلًا إلى لَيْلٍ وَذلكَ قَبْلَ أَنْ نَتَّخِذَ الكُنُفَ قَرِيبًا مِن بُيُوتِنَا، وَأَمْرُنَا أَمْرُ العَرَبِ الأُوَلِ في التَّنَزُّهِ، وَكُنَّا نَتَأَذَّى بالكُنُفِ أَنْ نَتَّخِذَهَا عِنْدَ بُيُوتِنَا، فَانْطَلَقْتُ أَنَا وَأُمُّ مِسْطَحٍ، وَهي بنْتُ أَبِي رُهْمِ بنِ المُطَّلِبِ بنِ عبدِ مَنَافٍ، وَأُمُّهَا ابْنَةُ صَخْرِ بنِ عَامِرٍ، خَالَةُ أَبِي بَكْرٍ الصِّدِّيقِ، وَابنُهَا مِسْطَحُ بنُ أُثَاثَةَ بنِ عَبَّادِ بنِ المُطَّلِبِ، فأقْبَلْتُ أَنَا وَبِنْتُ أَبِي رُهْمٍ قِبَلَ بَيْتِي، حِينَ فَرَغْنَا مِن شَأْنِنَا، فَعَثَرَتْ أُمُّ مِسْطَحٍ في مِرْطِهَا، فَقالَتْ: تَعِسَ مِسْطَحٌ فَقُلتُ لَهَا: بئْسَ ما قُلْتِ، أَتَسُبِّينَ رَجُلًا قدْ شَهِدَ بَدْرًا، قالَتْ: أَيْ هَنْتَاهْ، أَوْ لَمْ تَسْمَعِي ما قالَ؟ قُلتُ: وَمَاذَا قالَ؟ قالَتْ: فأخْبَرَتْنِي بقَوْلِ أَهْلِ الإفْكِ فَازْدَدْتُ مَرَضًا إلى مَرَضِي، فَلَمَّا رَجَعْتُ إلى بَيْتِي، فَدَخَلَ عَلَيَّ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَسَلَّمَ، ثُمَّ قالَ: كيفَ تِيكُمْ؟ قُلتُ: أَتَأْذَنُ لي أَنْ آتِيَ أَبَوَيَّ؟ قالَتْ: وَأَنَا حِينَئِذٍ أُرِيدُ أَنْ أَتَيَقَّنَ الخَبَرَ مِن قِبَلِهِمَا، فأذِنَ لي رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَجِئْتُ أَبَوَيَّ فَقُلتُ لِأُمِّي: يا أُمَّتَاهْ ما يَتَحَدَّثُ النَّاسُ؟ فَقالَتْ: يا بُنَيَّةُ هَوِّنِي عَلَيْكِ فَوَاللَّهِ لَقَلَّما كَانَتِ امْرَأَةٌ قَطُّ وَضِيئَةٌ عِنْدَ رَجُلٍ يُحِبُّهَا، وَلَهَا ضَرَائِرُ، إلَّا كَثَّرْنَ عَلَيْهَا، قالَتْ قُلتُ: سُبْحَانَ اللهِ وَقَدْ تَحَدَّثَ النَّاسُ بهذا؟ قالَتْ: فَبَكَيْتُ تِلكَ اللَّيْلَةَ حتَّى أَصْبَحْتُ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ، ثُمَّ أَصْبَحْتُ أَبْكِي، وَدَعَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ عَلِيَّ بنَ أَبِي طَالِبٍ وَأُسَامَةَ بنَ زَيْدٍ حِينَ اسْتَلْبَثَ الوَحْيُ، يَسْتَشِيرُهُما في فِرَاقِ أَهْلِهِ، قالَتْ فأمَّا أُسَامَةُ بنُ زَيْدٍ فأشَارَ علَى رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ بالَّذِي يَعْلَمُ مِن بَرَاءَةِ أَهْلِهِ، وَبِالَّذِي يَعْلَمُ في نَفْسِهِ لهمْ مِنَ الوُدِّ، فَقالَ: يا رَسُولَ اللهِ، هُمْ أَهْلُكَ وَلَا نَعْلَمُ إلَّا خَيْرًا، وَأَمَّا عَلِيُّ بنُ أَبِي طَالِبٍ، فَقالَ: لَمْ يُضَيِّقِ اللَّهُ عَلَيْكَ وَالنِّسَاءُ سِوَاهَا كَثِيرٌ، وإنْ تَسْأَلِ الجَارِيَةَ تَصْدُقْكَ، قالَتْ: فَدَعَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ بَرِيرَةَ فَقالَ: أَيْ بَرِيرَةُ هلْ رَأَيْتِ مِن شيءٍ يَرِيبُكِ مِن عَائِشَةَ؟ قالَتْ له بَرِيرَةُ: وَالَّذِي بَعَثَكَ بالحَقِّ إنْ رَأَيْتُ عَلَيْهَا أَمْرًا قَطُّ أَغْمِصُهُ عَلَيْهَا، أَكْثَرَ مِن أنَّهَا جَارِيَةٌ حَدِيثَةُ السِّنِّ، تَنَامُ عن عَجِينِ أَهْلِهَا، فَتَأْتي الدَّاجِنُ فَتَأْكُلُهُ، قالَتْ: فَقَامَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ علَى المِنْبَرِ، فَاسْتَعْذَرَ مِن عبدِ اللهِ بنِ أُبَيٍّ ابْنِ سَلُولَ، قالَتْ: فَقالَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ وَهو علَى المِنْبَرِ: يا مَعْشَرَ المُسْلِمِينَ مَن يَعْذِرُنِي مِن رَجُلٍ قدْ بَلَغَ أَذَاهُ في أَهْلِ بَيْتي فَوَاللَّهِ ما عَلِمْتُ علَى أَهْلِي إلَّا خَيْرًا، وَلقَدْ ذَكَرُوا رَجُلًا ما عَلِمْتُ عليه إلَّا خَيْرًا، وَما كانَ يَدْخُلُ علَى أَهْلِي إلَّا مَعِي فَقَامَ سَعْدُ بنُ مُعَاذٍ الأنْصَارِيُّ، فَقالَ: أَنَا أَعْذِرُكَ منه، يا رَسُولَ اللهِ، إنْ كانَ مِنَ الأوْسِ ضَرَبْنَا عُنُقَهُ وإنْ كانَ مِن إخْوَانِنَا الخَزْرَجِ أَمَرْتَنَا فَفَعَلْنَا أَمْرَكَ، قالَتْ: فَقَامَ سَعْدُ بنُ عُبَادَةَ وَهو سَيِّدُ الخَزْرَجِ، وَكانَ رَجُلًا صَالِحًا، وَلَكِنِ اجْتَهَلَتْهُ الحَمِيَّةُ، فَقالَ لِسَعْدِ بنِ مُعَاذٍ: كَذَبْتَ لَعَمْرُ اللهِ لا تَقْتُلُهُ، وَلَا تَقْدِرُ علَى قَتْلِهِ فَقَامَ أُسَيْدُ بنُ حُضَيْرٍ، وَهو ابنُ عَمِّ سَعْدِ بنِ مُعَاذٍ، فَقالَ لِسَعْدِ بنِ عُبَادَةَ: كَذَبْتَ لَعَمْرُ اللهِ لَنَقْتُلَنَّهُ فإنَّكَ مُنَافِقٌ تُجَادِلُ عَنِ المُنَافِقِينَ فَثَارَ الحَيَّانِ الأوْسُ وَالْخَزْرَجُ حتَّى هَمُّوا أَنْ يَقْتَتِلُوا وَرَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، قَائِمٌ علَى المِنْبَرِ، فَلَمْ يَزَلْ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ يُخَفِّضُهُمْ حتَّى سَكَتُوا وَسَكَتَ، قالَتْ: وَبَكَيْتُ يَومِي ذلكَ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ، ثُمَّ بَكَيْتُ لَيْلَتي المُقْبِلَةَ لا يَرْقَأُ لي دَمْعٌ وَلَا أَكْتَحِلُ بنَوْمٍ وَأَبَوَايَ يَظُنَّانِ أنَّ البُكَاءَ فَالِقٌ كَبِدِي، فَبيْنَما هُما جَالِسَانِ عِندِي وَأَنَا أَبْكِي اسْتَأْذَنَتْ عَلَيَّ امْرَأَةٌ مِنَ الأنْصَارِ، فأذِنْتُ لَهَا فَجَلَسَتْ تَبْكِي، قالَتْ: فَبيْنَا نَحْنُ علَى ذلكَ دَخَلَ عَلَيْنَا رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَسَلَّمَ، ثُمَّ جَلَسَ، قالَتْ: وَلَمْ يَجْلِسْ عِندِي مُنْذُ قيلَ لي ما قيلَ، وَقَدْ لَبِثَ شَهْرًا لا يُوحَى إلَيْهِ في شَأْنِي بشيءٍ، قالَتْ: فَتَشَهَّدَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ حِينَ جَلَسَ، ثُمَّ قالَ: أَمَّا بَعْدُ يا عَائِشَةُ، فإنَّه قدْ بَلَغَنِي عَنْكِ كَذَا وَكَذَا، فإنْ كُنْتِ بَرِيئَةً، فَسَيُبَرِّئُكِ اللَّهُ وإنْ كُنْتِ أَلْمَمْتِ بذَنْبٍ فَاسْتَغْفِرِي اللَّهَ وَتُوبِي إلَيْهِ، ",["فإنَّ العَبْدَ إذَا اعْتَرَفَ بذَنْبٍ، ثُمَّ تَابَ",1]," ",["تَابَ اللَّهُ عليه قالَتْ: فَلَمَّا قَضَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، مَقالَتَهُ قَلَصَ دَمْعِي حتَّى ما أُحِسُّ منه",2]," قَطْرَةً، فَقُلتُ لأَبِي: أَجِبْ عَنِّي رَسُولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فِيما قالَ فَقالَ: وَاللَّهِ ما أَدْرِي ما أَقُولُ لِرَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ فَقُلتُ لِأُمِّي: أَجِيبِي عَنِّي رَسُولَ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقالَتْ: وَاللَّهِ ما أَدْرِي ما أَقُولُ لِرَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَقُلتُ وَأَنَا جَارِيَةٌ حَدِيثَةُ السِّنِّ لا أَقْرَأُ كَثِيرًا مِنَ القُرْآنِ إنِّي وَاللَّهِ لقَدْ عَرَفْتُ أنَّكُمْ قدْ سَمِعْتُمْ بهذا حتَّى اسْتَقَرَّ في نُفُوسِكُمْ وَصَدَّقْتُمْ به، فإنْ قُلتُ لَكُمْ إنِّي بَرِيئَةٌ وَاللَّهُ يَعْلَمُ أَنِّي بَرِيئَةٌ لا تُصَدِّقُونِي بذلكَ، وَلَئِنِ اعْتَرَفْتُ لَكُمْ بأَمْرٍ وَاللَّهُ يَعْلَمُ أَنِّي بَرِيئَةٌ لَتُصَدِّقُونَنِي وإنِّي، وَاللَّهِ ما أَجِدُ لي وَلَكُمْ مَثَلًا إلَّا كما قالَ أَبُو يُوسُفَ {فَصَبْرٌ جَمِيلٌ وَاللَّهُ المُسْتَعَانُ علَى ما تَصِفُونَ} . قالَتْ: ثُمَّ تَحَوَّلْتُ فَاضْطَجَعْتُ علَى فِرَاشِي، قالَتْ: وَأَنَا، وَاللَّهِ حِينَئِذٍ أَعْلَمُ أَنِّي بَرِيئَةٌ وَأنَّ اللَّهَ مُبَرِّئِي ببَرَاءَتِي، وَلَكِنْ، وَاللَّهِ ما كُنْتُ أَظُنُّ أَنْ يُنْزَلَ في شَأْنِي وَحْيٌ يُتْلَى، وَلَشَأْنِي كانَ أَحْقَرَ في نَفْسِي مِن أَنْ يَتَكَلَّمَ اللَّهُ عَزَّ وَجَلَّ فِيَّ بأَمْرٍ يُتْلَى، وَلَكِنِّي كُنْتُ أَرْجُو أَنْ يَرَى رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ في النَّوْمِ رُؤْيَا يُبَرِّئُنِي اللَّهُ بهَا، قالَتْ: فَوَاللَّهِ ما رَامَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ مَجْلِسَهُ، وَلَا خَرَجَ مِن أَهْلِ البَيْتِ أَحَدٌ حتَّى أَنْزَلَ اللَّهُ عَزَّ وَجَلَّ علَى نَبِيِّهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، فأخَذَهُ ما كانَ يَأْخُذُهُ مِنَ البُرَحَاءِ عِنْدَ الوَحْيِ، حتَّى إنَّه لَيَتَحَدَّرُ منه مِثْلُ الجُمَانِ مِنَ العَرَقِ، في اليَومِ الشَّاتِ، مِن ثِقَلِ القَوْلِ الذي أُنْزِلَ عليه، قالَتْ: فَلَمَّا سُرِّيَ عن رَسُولِ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ، وَهو يَضْحَكُ، فَكانَ أَوَّلَ كَلِمَةٍ تَكَلَّمَ بهَا أَنْ قالَ: أَبْشِرِي يا عَائِشَةُ أَمَّا اللَّهُ فقَدْ بَرَّأَكِ فَقالَتْ لي أُمِّي: قُومِي إلَيْهِ، فَقُلتُ: وَاللَّهِ لا أَقُومُ إلَيْهِ، وَلَا أَحْمَدُ إلَّا اللَّهَ، هو الذي أَنْزَلَ بَرَاءَتِي، قالَتْ: فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ: {إنَّ الَّذِينَ جَاؤُوا بالإِفْكِ عُصْبَةٌ مِنكُم} عَشْرَ آيَاتٍ فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ هَؤُلَاءِ الآيَاتِ بَرَاءَتِي، قالَتْ: فَقالَ أَبُو بَكْرٍ وَكانَ يُنْفِقُ علَى مِسْطَحٍ لِقَرَابَتِهِ منه وَفَقْرِهِ: وَاللَّهِ لا أُنْفِقُ عليه شيئًا أَبَدًا بَعْدَ الذي قالَ لِعَائِشَةَ فأنْزَلَ اللَّهُ عَزَّ وَجَلَّ: {وَلَا يَأْتَلِ أُولو الفَضْلِ مِنكُم وَالسَّعَةِ أَنْ يُؤْتُوا أُولِي القُرْبَى} إلى قَوْلِهِ: {أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللَّهُ لَكُمْ} . قالَ حِبَّانُ بنُ مُوسَى: قالَ عبدُ اللهِ بنُ المُبَارَكِ: هذِه أَرْجَى آيَةٍ في كِتَابِ اللَّهِ . فَقالَ أَبُو بَكْرٍ: وَاللَّهِ إنِّي لأُحِبُّ أَنْ يَغْفِرَ اللَّهُ لِي، فَرَجَعَ إلى مِسْطَحٍ النَّفَقَةَ الَّتي كانَ يُنْفِقُ عليه، وَقالَ: لا أَنْزِعُهَا منه أَبَدًا . قالَتْ عَائِشَةُ: وَكانَ رَسُولُ اللهِ صَلَّى اللَّهُ عليه وَسَلَّمَ سَأَلَ زَيْنَبَ بنْتَ جَحْشٍ، زَوْجَ النبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ عن أَمْرِي ما عَلِمْتِ؟ أَوْ ما رَأَيْتِ؟ فَقالَتْ: يا رَسُولَ اللهِ، أَحْمِي سَمْعِي وَبَصَرِي، وَاللَّهِ ما عَلِمْتُ إلَّا خَيْرًا . قالَتْ عَائِشَةُ: وَهي الَّتي كَانَتْ تُسَامِينِي مِن أَزْوَاجِ النبيِّ صَلَّى اللَّهُ عليه وَسَلَّمَ، فَعَصَمَهَا اللَّهُ بالوَرَعِ، وَطَفِقَتْ أُخْتُهَا حَمْنَةُ بنْتُ جَحْشٍ تُحَارِبُ لَهَا، فَهَلَكَتْ فِيمَن هَلَكَ . قالَ الزُّهْرِيُّ: فَهذا ما انْتَهَى إلَيْنَا مِن أَمْرِ هَؤُلَاءِ الرَّهْطِ . وقالَ في حَديثِ يُونُسَ: احْتَمَلَتْهُ الحَمِيَّةُ .]"],"grade":"صحيح","narrator":"[عائشة أم المؤمنين]","muhaddith":"صحيح مشهور","takhrij":"أخرجه البخاري (2518)، ومسلم (2770) والطبري في ((تفسيره)) (17/ 197) جميعهم بطوله  .","bab":"تفسير آيات › سورة النور","dorar":"HNxlBrLI","merged":2,"otherRefs":["اللطائف من دقائق المعارف 183 (صحيح)"]},{"id":"ق-0527","fp":"0ba937c2b973","stateId":101,"easy":"الاعتراف بالذنب ← عسى الله أن يتوب عليهم","cause":"الاعتراف بالذنب","result":"عسى الله أن يتوب عليهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"سورة التوبة: 102","srcLabel":"القرآن الكريم","quran":{"s":9,"from":102,"to":102,"text":"وَآخَرُونَ اعْتَرَفُوا بِذُنُوبِهِمْ خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا عَسَى اللَّهُ أَنْ يَتُوبَ عَلَيْهِمْ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (102)","hl":[[0,80,1],[80,117,2],[117,147,1]]}},{"id":"س-01981","fp":"78a83eb92e80","stateId":101,"easy":"إذا ندمت على ذنبك ← فالندم توبة","cause":"النَّدمُ","result":"تَوبةٌ","explicit":true,"ref":"تخريج المسند لشعيب 3568","srcLabel":"ابن ماجه","text":["عن عبدِ اللهِ بنِ مَعقِلِ بنِ مُقَرِّنٍ قال: دخَلْتُ مع أبي على عبدِ اللهِ بنِ مَسعودٍ، فقال: أنتَ سمِعْتَ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: \"",["النَّدمُ",1]," ",["تَوبةٌ",2],"\"؟ قال: نعمْ، وقال مرَّةً: سمِعْتُه يقولُ: \"النَّدمُ تَوبةٌ\"."],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه ابن ماجه (4252)، وأحمد (3568)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"JacHHtOo","merged":5,"otherRefs":["تخريج المسند لشعيب 4124 (صحيح)","صحيح ابن حبان 613 (صحيح)","المستدرك على الصحيحين 7823 (صحيح)","الأحاديث المختارة 2089 (صحيح)"]},{"id":"س-03455","fp":"9608e174076c","stateId":101,"easy":"إذا ألممت بذنب فاستغفري الله وتوبي ← فالتوبة الندم والاستغفار","cause":"فاستغفِري اللهَ","result":"فإنَّ التَّوبةَ مِنَ الذَّنبِ النَّدامةُ والاستغفارُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 10/201","srcLabel":"متفق عليه","text":["قال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم يا عائشةُ إنْ كنتِ ألمَمْتِ بذنبٍ ",["فاستغفِري اللهَ",1]," ",["فإنَّ التَّوبةَ مِنَ الذَّنبِ النَّدامةُ والاستغفارُ",2]],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح غير محمد بن يزيد الواسطي وهو ثقة","takhrij":"أخرجه أحمد (26279)، واللفظ له، والبخاري (4670)، باختلاف يسير، ومسلم (2770)، مطولا.","bab":"استغفار › فضل الاستغفار","dorar":"qDXSwZsQ"},{"id":"س-07730","fp":"0e0b0db127a3","stateId":101,"easy":"إذا ألممت بذنب فتوبي إلى الله واستغفريه ← يتوب الله عليك","cause":"فتوبي إلى اللهِ واستَغْفِريه","result":"إنَّما أنتِ مِن بناتِ آدمَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"مجمع الزوائد 9/235","srcLabel":"متفق عليه","text":["كان النَّبيُّ صلَّى اللهُ عليه وسلَّم إذا أراد أن يُسافِرَ أقرَع بينَ نسائِه فأيَّتُهنَّ خرَج سهمُها خرَج بها معه فخرَج سهمُ عائشةَ في غزوةِ النَّبيِّ صلَّى اللهُ عليه وسلَّم بني المُصْطَلِقِ مِن خُزاعةَ فلمَّا انصرَف رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فكان قريبًا مِنَ المدينةِ وكانت عائشةُ جُوَيريَةً حديثةَ السِّنِّ قليلةَ اللَّحمِ خفيفةً وكانت تلزَمُ خِدرَها فإذا أراد النَّاسُ الرَّحيلَ ذهَبَتْ ثمَّ رجَعَتْ فدخَلَتْ مِحَفَّتَها فيُرَحَّلُ بعيرُها ثمَّ تُحْمَلُ مِحَفَّتُها فتوضَعُ على البَعيرِ فكان أوَّلَ ما قال فيها المنافقون وغيرُهم ممَّنِ اشترَك في أمرِ عائشةَ إنَّها خرجَتْ تتوضَّأُ حينَ دنَوا مِنَ المدينةِ فانسَلَّ مِن عُنُقِها عِقْدٌ لها مِن جَزْعِ أظْفَارٍ فارتحَل رسولُ اللهِ صلَّى اللهُ عليه وسلَّم والنَّاسُ وهي في بُغاءِ العِقدِ ولم تعلَمْ برحيلِهم فشدُّوا على بعيرِها المِحَفَّةَ وهم يُرَوْنَ أنَّها فيها كما كانت تكونُ فرجَعَتْ عائشةُ إلى منزلِها فلم تجِدْ في العَسْكَرِ أحدًا فغلَبَتْها عيناها وكان صَفْوانُ بنُ المُعَطَّلِ السُّلَمِيُّ صاحبُ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم تخلَّف تلك اللَّيلةَ عَنِ العَسْكَرِ حتَّى أصبَح قالت فمرَّ بي فرآني فاسترجَع وأعظَمَ مكاني حينَ رآني وقد كنْتُ أعرِفُه ويعرِفُني قبلَ أن يُضرَبَ علينا الحِجابُ قالت فسألني عن أمري فستَرْتُ وجهي عنه بجِلْبابي وأخبَرْتُه بأمري فقرَّب بعيرَه فوَطِئَ على ذِراعِه فولَّاني قفاه حتَّى رَكِبْتُ وسوَّيْتُ ثيابي ثمَّ بعَثَه فأقبَل يسيرُ بي حتَّى دخَلْنا المدينةَ نِصفَ النَّهارِ أو نحوَه فهنالك قال فيَّ وفيه مَن قال مِن أهلِ الإفكِ وأنا لا أعلَمُ شيئًا مِن ذلك ولا ممَّا يخوضُ النَّاسُ فيه مِن أمري وكنْتُ تلك اللَّياليَ شاكيةً وكان أوَّلَ ما أنكَرْتُ مِن أمرِ النَّبيِّ صلَّى اللهُ عليه وسلَّم أنَّه كان يعودُني قبلَ ذلك إذا مرِضْتُ وكان تلك اللَّياليَ لا يدخُلُ عليَّ ولا يعودُني إلَّا أنَّه كان يقولُ وهو مارٌّ كيف تِيكُمْ فيسألُ عنِّي أهلَ البيتِ فلمَّا بلَغ النَّبيَّ صلَّى اللهُ عليه وسلَّم ما أكثَرَ النَّاسُ فيه مِن أمري غمَّه ذلك وقد شكَوْتُ قَبلَ ذلك إلى أمِّي ما رأيْتُ مِنَ النَّبيِّ صلَّى اللهُ عليه وسلَّم مِن الجَفْوةِ فقالت لي يا بُنَيَّةُ اصبِري فواللهِ ما كانتِ امرأةٌ حَسْناءُ لها ضرائرُ إلَّا رمَيْنها قالت فوجَدْتُ حِسًّا تلك اللَّيلةَ الَّتي بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم مِن صُبحِها إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ يستشيرُهما في أمري وكنَّا ذلك الزَّمانَ ليس لنا كُنُفٌ نذهَبُ فيها إنَّما كنَّا نذهَبُ كما يذهَبُ العربُ ليلًا إلى ليلٍ فقلْتُ لأمِّ مِسْطَحِ بنِ أُثاثةَ خُذي الإداوةَ فامْلَئيها ماءً فاذهَبي بها إلى المَناصِعِ وكانت هي وابنُها مِسْطَحٌ بينَهما وبينَ أبي بكرٍ قَرابةٌ وكان أبو بكرٍ يُنفِقُ عليهما فكانا يكونان عندَه ومع أهلِه فأخَذَتِ الإداوةَ وخرَجَتْ نحوَ المَناصِعِ فعثَرَتْ أمُّ مِسْطَحٍ فقالت تعِسَ مِسْطَحٌ فقلْتُ بئسَ ما قلْتِ قالت ثمَّ مشَيْنا فعثَرَتْ أيضًا فقالت تعِسَ مِسْطَحٌ فقلْتُ لها بئسَ ما قلْتِ لصاحبِ النَّبيِّ صلَّى اللهُ عليه وسلَّم وصاحبِ بَدْرٍ فقالت إنَّكِ لَغافلةٌ عمَّا فيه النَّاسُ مِن أمرِك فقلْتُ أجَلْ فما ذاك فقالت إنَّ مِسْطَحًا وفلانًا وفُلانةً فيمن استَزَلَّهُمُ الشَّيطانُ مِنَ المنافقين يجتمِعون في بيتِ عبدِ اللهِ بنِ أُبَيِّ بنِ سَلولٍ أخي بني الحارثِ بنِ الخزرجِ يتحدَّثون عنكِ وعن صَفْوانَ بنِ المُعَطَّلِ يَرْمونكِ به قالت فذهَب عنِّي ما كنْتُ أجِدُ مِنَ الغائطِ فرَجَعْتُ على يدَيَّ فلمَّا أصبَحْنا مِن تلك اللَّيلةِ بعَث النَّبيُّ صلَّى اللهُ عليه وسلَّم إلى عليِّ بنِ أبي طالبٍ وأسامةَ بنِ زيدٍ فأخبرَهما بما قيل فيَّ واستشارَهما في أمري فقال أسامةُ واللهِ يا رسولَ اللهِ ما علِمْنا على أهلِك سوءًا وقال عليٌّ له يا رسولَ اللهِ ما أكثَرَ النِّساءَ وإنْ أرَدْتَ أن تعلَمَ الخبرَ فتوعَّدِ الجاريةَ يعني بَريرةَ فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم لعليٍّ فشأنُك بالخادمِ فسَأَلَها عليٌّ عنِّي فلم تُخْبِرْه والحمدُ للهِ إلَّا بخيرٍ قالت واللهِ ما عَلِمْتُ على عائشةَ سوءًا إلَّا أنَّها جُوَيريَةٌ تُصبِحُ عن عجينِ أهلِها فتدخُلُ الشَّاةُ الدَّاجِنُ فتأكُلُ مِنَ العجينِ قالت ثمَّ خرَج النَّبيُّ صلَّى اللهُ عليه وسلَّم حينَ سمِعَ ما قالت بَريرةُ لِعَليٍّ إلى النَّاسِ فلمَّا اجتمَعوا إليه قال يا معشرَ المسلمين مَن لي مِن رجالٍ يُؤذونَني في أهلي فما علِمْتُ على أهلي سوءًا ويَرْمون رجُلًا مِن أصحابي ما علِمْتُ عليه سوءًا ولا خرَجْتُ مَخْرجًا إلَّا خرَج معي فيه قال سعدُ بنُ معاذٍ الأنصاريُّ الأشْهَلِيُّ مِنَ الأوسِ يا رسولَ اللهِ إنْ كان ذلك مِن أحَدٍ مِنَ الأوسِ كَفَيْنَاكَهُ وإنْ كان مِنَ الخزرجِ أمَرْتَنا فيه بأمرِك وقام سعدُ بنُ عُبادةَ الأنصاريُّ ثمَّ الخَزْرَجِيُّ فقال لسعدِ بنِ معاذٍ كذَبْتَ واللهِ وهذا الباطلُ فقام أُسَيدُ بنُ حُضَيرٍ الأنصاريُّ ثمَّ الأشْهَلِيُّ ورجالٌ مِنَ الفريقين فاستبُّوا وتنازَعوا حتَّى كاد أن يعظُمَ الأمرُ بينَهم فدخَل النَّبيُّ صلَّى اللهُ عليه وسلَّم بيتي وبعَث إلى أبويَّ فأتَياه فحمِد اللهَ وأثنى عليه بما هو أهلُه ثمَّ قال لي يا عائشةُ ",["إنَّما أنتِ مِن بناتِ آدمَ",2]," فإنْ كنْتِ أخطأْتِ ",["فتوبي إلى اللهِ واستَغْفِريه",1]," فقلْتُ لأبي أجِبْ عنِّي رسولُ اللهِ صلَّى اللهُ عليه وسلَّم فقال لا أفعَلُ هو نبيُّ اللهِ والوحيُ يأتيه فقلْتُ لأمِّي أجيبي عنِّي رسولَ اللهِ صلَّى اللهُ عليه وسلَّم فقالت لي كما قال أبي فقلْتُ واللهِ لئن أقْرَرْتُ على نفسي بباطلٍ لتُصَدِّقُنَّني ولئن برَّأْتُ نفسي واللهُ يعلَمُ أنِّي بريئةٌ لتُكَذِّبُنَّني فما أجِدُ لي ولكم مَثَلًا إلَّا قولَ أبي يوسفَ { فَصَبْرٌ جَمِيلٌ وَاللهُ المُسْتَعانُ عَلَى مَا تَصِفُونَ } ونَسيتُ اسمَ يعقوبَ لِما بي مِنَ الحُزنِ والبُكاءِ واحتراقِ الجوفِ فتغشَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ما كان يتغشَّاه مِنَ الوحيِ ثمَّ سُرِّيَ عنه فمسَح وجهَه بيدِه ثمَّ قال أبْشِري يا عائشةُ قد أنزَل اللهُ عزَّ وجلَّ براءتَك فقالت عائشةُ واللهِ ما كنْتُ أظُنُّ أن ينزِلَ القرآنُ في أمري ولكنِّي كنْتُ أرجو لِما يعلَمُ اللهُ مِن براءتي أن يرى النَّبيُّ صلَّى اللهُ عليه وسلَّم في أمري رؤيا فيُبَرِّئَني اللهُ بها عندَ نبيِّه صلَّى اللهُ عليه وسلَّم فقال لي أبوايَ عندَ ذلك قومي فقبِّلي رأسَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّم فقلْتُ واللهِ لا أفعَلُ بحمدِ اللهِ لا بحَمْدِكم قال وكان أبو بكرٍ يُنفِقُ على مِسْطَحٍ وأمِّه فلمَّا رماني حلَف أبو بكرٍ أن لا ينفَعَه بشيءٍ أبدًا قال فلمَّا تلا رسولُ اللهِ صلَّى اللهُ عليه وسلَّم { وَلْيَعْفُوا وَلْيَصْفَحُوا أَلَا تُحِبُّونَ أَنْ يَغْفِرَ اللهُ لَكُمْ } بكى أبو بكرٍ قال بلى يا ربِّ وأعاد النَّفقةَ على مِسْطَحٍ وأمِّه قالت وقعَد صَفْوانُ بنُ المُعَطَّلِ لحسَّانَ بنِ ثابتٍ بالسَّيفِ فضرَبه ضربةً فقال صَفْوانُ لحسَّانَ حينَ ضرَبَه تَلَقَّ ذُبَابَ السَّيْفِ عَنْكَ فَإِنَّنِي ... غُلَامٌ إِذَا هُوجِيتُ لَسْتُ بِشَاعِرِ\nوَلَكِنَّنِي أَحْمِي حِمَايَ وأَنْتَقِمْ ... مِنَ الْبَاهِتِ الرَّامِي الْبُرَاةِ الطَّوَاهِرِ. ثمَّ صاح حسَّانُ فاستغاث النَّاسُ على صَفْوانَ فلمَّا جاء النَّاسُ فرَّ صَفْوانُ فجاء حسَّانُ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم فاستَعْداه على صَفْوانَ في ضَرْبتِه إيَّاه فسألَه النَّبيُّ صلَّى اللهُ عليه وسلَّم أن يهَبَ له ضربةَ صَفْوانَ إيَّاه فوهَبها للنَّبيِّ صلَّى اللهُ عليه وسلَّم فعاوَضَه النَّبيُّ صلَّى اللهُ عليه وسلَّم حائطًا مِن نخلٍ عظيمٍ وجاريةٍ روميَّةٍ ويُقالُ قِبطيَّةٌ تُدعى سِيرينَ فولَدَتْ لحسَّانَ ابنَه عبدَ الرَّحمنِ الشَّاعرَ قال أبو أُوَيسٍ أخبَرَني بذلك حُسَينُ بنُ عبدِ اللهِ بنِ عُبيدِ اللهِ بنِ عبَّاسٍ عَن عِكرمةَ عنِ ابنِ عبَّاسٍ قالت عائشةُ ثمَّ باع حسَّانُ ذلك الحائطَ مِن معاويةَ بنِ أبي سفيانَ في ولايتِه بمالٍ عظيمٍ قالت عائشةُ رضِيَ اللهُ عنها وبلَغَني واللهِ أعلمُ أنَّ الَّذي قال اللهُ فيه { والَّذِي تَوَلَّى كِبْرَهُ مِنْهُمْ لَهُ عَذَابٌ عَظِيمٌ } أنَّه عبدُ اللهِ بنُ أُبَيِّ بنِ سَلولٍ أحدُ بني الحارثِ بن ِالخزرجِ قالت عائشةُ فقيل في أصحابِ الإفكِ الأشعارُ وقال أبو بكرٍ في مِسْطَحٍ في رَمْيِه عائشةَ فكان يُدعى عَوفًا يَا عَوْفُ وَيْحَكَ هَلَّا قُلْتَ عَارِفَةً ... مِنَ الْكَلَامِ وَلَمْ تَبْغِي بِهِ طَمَعَا\nفَأَدْرَكَتْكَ حُمَيَّا مَعْشَرٍ أُنُفٍ ... فَلَمْ يَكُنْ قَاطِعًا يَا عَوْفُ مَنْ قَطَعَا\nهَلَّا حَرِبْتَ مِنَ الْأَقْوَامِ إِذْ حَسَدُوا ... فَلَا تَقُولُ وَإِنْ عَادَيْتَهُمْ قَذَعَا\nلَمَّا رَمَيْتَ حَصَانًا غَيْرَ مُقْرِفَةٍ ... أَمِينَةَ الْجَيْبِ لَمْ نَعْلَمْ لَهَا خَضَعَا\nفِيمَنْ رَمَاهَا وَكُنْتُمْ مَعْشَرًا أُفُكًا ... فِي سَيِّئِ الْقَوْلِ مِنْ لَفْظِ الْخَنَا شَرَعَا\nفَأَنْزَلَ اللَّهُ عُذْرًا فِي بَرَاءَتِهَا ... وَبَيْنَ عَوْفٍ وَبَيْنَ اللَّهِ مَا صَنَعَا\nفَإِنْ أَعِشْ أَجْزِ عَوْفًا فِي مَقَالَتِهِ ... سُوءَ الْجَزَاءِ بِمَا أَلْفَيْتُهُ تَبَعَا. وقالَت أمُّ سعدِ بنِ معاذٍ في الَّذين رمَوا عائشةَ مِنَ الشِّعرِ تَشْهَدُ الْأَوْسُ كُلُّهَا وَفَتَاهَا ... بِحِقْدٍ وَذَلِكَ مَعْلُومُ\nنِسَاءُ الْخَزْرَجِيِّينَ يَشْهَدْنَ ... وَالْخُمَاسِيُّ مِنْ نَسْلِهَا وَالْعَظِيمُ\nأَنَّ بِنْتَ الصِّدِّيقِ كَانَتْ حَصَانًا ... عَفَّةَ الْجَيْبِ دِينُهَا مُسْتَقِيمُ\nتَتَّقِي اللَّهَ فِي الْمَغِيبِ عَلَيْهَا ... نِعْمَةُ اللَّهِ سِرُّهَا مَا يَرِيمُ\nخَيْرُ هَدْيِ النِّسَاءِ حَالًا وَنَفْسًا ... وَأَبًا لِلْعُلَا نَمَاهَا كَرِيمُ\nلِلْمَوَالِي إِذَا رَمَوهَا بِإِفْكٍ ... أَخَذَتْهُمْ مَقَامِعٌ وَجَحِيمُ\nلَيْتَ مَنْ كَانَ قَدْ قَفَاهَا بِسُوءٍ ... فِي حُطَامٍ حَتَّى يَبُولَ اللَّئِيمُ\nوَعَوَانٍ مِنَ الْحُرُوبِ تَلَظَّى ... ثَغْسًا قُوتُهَا عَقَارٌ صَرِيمُ\nلَيْتَ سَعْدًا وَمَنْ رَمَاهَا بِسُوءٍ ... فِي كَظَاظٍ حَتَّى يَتُوبَ الظَّلُومُ.\nوقال حسَّانُ وهو يُبَرِّئُ عائشةَ - رَضِيَ اللَّهُ عنها - فيما قيل فيها، ويعتذِرُ إليها:\nحَصَانٌ رَزَانٌ مَا تُزَنُّ بِرِيبَةٍ ... وَتُصْبِحُ غَرْثَى مِنْ لُحُومِ الْغَوَافِلِ\nخَلِيلَةُ خَيْرِ النَّاسِ دِينًا وَمَنْصِبًا ... نَبِيِّ الْهُدَى وَالْمَكْرُمَاتِ الْفَوَاضِلِ\nعَقِيلَةُ حَيٍّ مِنْ لُؤَيِّ بْنِ غَالِبٍ ... كِرَامِ الْمَسَاعِي مَجْدُهَا غَيْرُ زَائِلِ\nمُهَذَّبَةٌ قَدْ طَيَّبَ اللَّهُ خِيَمَهَا ... وَطَهَّرَهَا مِنْ كُلٍّ سُوءٍ وَبَاطِلِ\nفَإِنْ كَانَ مَا قَدْ جَاءَ عَنِّي قُلْتُهُ ... فَلَا رَفَعَتْ صَوْتِي إِلَىَّ أَنَامِلِي\nوَإِنَّ الَّذِي قَدْ قِيلَ لَيْسَ بِلَائِطٍ ... بِكِ الدَّهْرَ بَلْ قَوْلُ امْرِئٍ غَيْرِ هَائِلِ\nوَكَيْفَ وَوُدِّي مَا حَيِيتُ وَنُصْرَتِي ... لِآلِ رَسُولِ اللَّهِ زَيْنِ الْمَحَافِلِ\nلَهُ رَتْبٌ عَالٍ عَلَى النَّاسِ فَضْلُهَا ... تَقَاصَرُ عَنْهَا سَوْرَةُ الْمُتَطَاوِلِ.قال أبو يونسَ وحدَّثَني أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم أمَر بالَّذين رمَوا عائشةَ فجُلِدوا الحدَّ ثمانين وقال حسَّانُ بنُ ثابتٍ في الشِّعرِ حين جُلِدوا لَقَدْ ذَاقَ عَبْدُ اللَّهِ مَا كَانَ أَهْلَهُ ... وَحَمْنَةُ إِذْ قَالُوا هَجِيرًا وَمِسْطَحُ\nتَعَاطَوْا بِرَجْمِ الْغَيْبِ زَوْجَ نَبِيِّهِمْ ... وَسَخْطَةَ ذِي الْعَرْشِ الْكَرِيمِ فَأَنْزَحُوا\nفَآذَوْا رَسُولَ اللَّهِ فِيهَا وَعَمَّمُوا ... مَخَازِيَ سُوءٍ حَلَّلُوهَا وَفُضِّحُوا"],"grade":"صحيح","narrator":"عائشة أم المؤمنين","muhaddith":"رجاله رجال الصحيح إلا أن بعض هذا يخالف ما في الصحيح","takhrij":"أخرجه الطبراني (23/111) (151) واللفظ له، وأخرجه البخاري (4141)، ومسلم (2770) بلفظ مقارب","bab":"قرآن › أسباب النزول","dorar":"IoBb5HZx"},{"id":"س-03451","fp":"057e597d16a1","stateId":101,"easy":"إذا ندمت على ذنبك صادقاً ← يغفر الله لك قبل أن تستغفره","cause":"ما عَلِمَ اللهُ مِن عبْدٍ نَدامةً على ذنْبٍ","result":"إلَّا غفَرَ لهُ قبْلَ أنْ يَستَغْفِرَه منْه","explicit":true,"ref":"المستدرك على الصحيحين 7855","srcLabel":"الحاكم","text":[["ما عَلِمَ اللهُ مِن عبْدٍ نَدامةً على ذنْبٍ",1]," ",["إلَّا غفَرَ لهُ قبْلَ أنْ يَستَغْفِرَه منْه",2],"."],"grade":"صحيح","narrator":"عائشة","muhaddith":"صحيح الإسناد","bab":"استغفار › فضل الاستغفار","dorar":"t0dBMWIL","merged":2,"otherRefs":["النوافح العطرة 313 (صحيح)"]},{"id":"س-03452","fp":"83ec7219471e","stateId":101,"easy":"إذا عملت ذنباً ثم استغفرت خلال ساعات ← لا يكتبه الملك عليك","cause":"ما مِن مُسلِمٍ يَعمَلُ ذنْبًا","result":"إلَّا وقَفَ الملَكُ المُوَكَّلُ بإحصاءِ ذُنوبِه ثَلاثَ ساعاتٍ؛ فإنِ استغفَرَ اللهَ مِن ذنْبِه ذلكَ في شَيءٍ مِن تلكَ الساعاتِ، لم يُوقِفْه عليهِ، ولم يُعذَّبْ يومَ القِيامةِ","explicit":true,"ref":"المستدرك على الصحيحين 7884","srcLabel":"الحاكم","text":[["ما مِن مُسلِمٍ يَعمَلُ ذنْبًا",1]," ",["إلَّا وقَفَ الملَكُ المُوَكَّلُ بإحصاءِ ذُنوبِه ثَلاثَ ساعاتٍ؛ فإنِ استغفَرَ اللهَ مِن ذنْبِه ذلكَ في شَيءٍ مِن تلكَ الساعاتِ، لم يُوقِفْه عليهِ، ولم يُعذَّبْ يومَ القِيامةِ",2],"."],"grade":"صحيح","narrator":"أم عصمة العوصية","muhaddith":"صحيح الإسناد","bab":"استغفار › فضل الاستغفار","dorar":"dGutninJ","merged":2,"otherRefs":["الجامع الصغير 8084 (صحيح)"]},{"id":"س-05451","fp":"a884d0bba137","stateId":101,"easy":"إذا ندمت على معصية وتركتها قبل أن تقع فيها ← يغفر الله لك","cause":"فندِم ذو الكِفلِ وقام مِن غيرِ أنْ يكونَ منه شيءٌ","result":"فلمَّا أصبَح وجَدوا على بابِه مكتوبًا: إنَّ اللهَ قد غفَر لك","explicit":true,"ref":"صحيح ابن حبان 387","srcLabel":"الترمذي","text":["سمِعْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّم أكثرَ مِن عشرينَ مرَّةً يقولُ: ( كان ذو الكفلِ مِن بني إسرائيلَ لا يتورَّعُ مِن شيءٍ فهوي امرأةً فراوَدها على نفسِها وأعطاها ستِّينَ دينارًا فلمَّا جلَس منها بكت وأُرعِدت فقال لها: ما لكِ ؟ فقالت: إنِّي واللهِ لم أعمَلْ هذا العملَ قطُّ وما عمِلْتُه إلَّا مِن حاجةٍ قال: ",["فندِم ذو الكِفلِ وقام مِن غيرِ أنْ يكونَ منه شيءٌ",1]," فأدرَكه الموتُ مِن ليلتِه ",["فلمَّا أصبَح وجَدوا على بابِه مكتوبًا: إنَّ اللهَ قد غفَر لك",2]," )"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه الترمذي (2496)، وأحمد (4747) باختلاف يسير","bab":"رقائق وزهد › الخوف من الله","dorar":"exyhTiCY"},{"id":"س-03469","fp":"a49c8d00171e","stateId":101,"easy":"إذا عملت سيئة ثم استغفرت منها ← لا تُكتب عليك، وإلا كُتبت واحدة","cause":"فإنِ استَغفرَ اللهَ مِنها","result":"لَم يَكتُبْ عليه شَيئًا، وإن لَم يَستَغفِرْ كَتَبَ عليه سيِّئةً واحِدةً","explicit":true,"ref":"فيض القدير 4/ 190","srcLabel":"الطبراني","text":["صاحِبُ اليَمينِ أميرٌ على صاحِبِ الشِّمالِ، فإذا عَمِلَ العَبدُ حَسَنةً كَتَبَها بعَشرِ أمثالِها، وإذا عَمِلَ سيِّئةً فأرادَ صاحِبُ الشِّمالِ أن يَكتُبَها قال صاحِبُ اليَمينِ: أمسِكْ، فيُمسِكُ سِتَّ ساعاتٍ، ",["فإنِ استَغفرَ اللهَ مِنها ",1],["لَم يَكتُبْ عليه شَيئًا، وإن لَم يَستَغفِرْ كَتَبَ عليه سيِّئةً واحِدةً",2]],"grade":"حسن","narrator":"أبو أمامة","muhaddith":"جيد","takhrij":"أخرجه الطبراني في ((الشاميين)) (468)، والبيهقي في ((الشعب)) (6648)، وابن شاهين في ((فضائل الأعمال)) (182) باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"YCON0g7H"},{"id":"س-03497","fp":"d7bb5eba1525","stateId":101,"easy":"إذا ندمت ← فالندم كفارة الذنب","cause":"الندامةُ","result":"كفارةُ الذنبِ","explicit":true,"ref":"الجامع الصغير 6238","srcLabel":"أحمد","text":[["كفارةُ الذنبِ",2]," ",["الندامةُ",1],"، و لوْ لمْ تُذْنِبُوا لأتَى اللهُ بقومٍ يُذنِبُونَ ليغفرَ لهمْ"],"grade":"حسن","narrator":"عبدالله بن عباس","muhaddith":"حسن","takhrij":"أخرجه أحمد (2623) واللفظ له، والطبراني (12/172) (12795) مختصراً، وابن عدي في ((الكامل في الضعفاء)) (7/205) باختلاف يسير","bab":"استغفار › مكفرات الذنوب","dorar":"kgxe332l"},{"id":"س-03983","fp":"d63424ffd00e","stateId":101,"easy":"إذا أخطأت أو أذنبت ثم ندمت ← فندمك كفارته","cause":"من أخطأَ خطيئةً أو أذنبَ ذنبًا ثُمَّ ندِمَ","result":"فَهوَ كفَّارتُه","explicit":true,"ref":"الجامع الصغير 8341","srcLabel":"الطبراني","text":[["من أخطأَ خطيئةً أو أذنبَ ذنبًا ثُمَّ ندِمَ ",1],["فَهوَ كفَّارتُه",2]],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"حسن","takhrij":"أخرجه ابن عدي في ((الكامل في الضعفاء)) (4/14)، والبيهقي في ((شعب الإيمان)) (7033) واللفظ لهما، وأخرجه الطبراني (10/274) (10537) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"TYvNsYlZ"},{"id":"س-04601","fp":"fc7164765fdb","stateId":101,"easy":"إذا اعترفت بذنبك وتبت ← يقبل الله توبتك (من قصة)","cause":"لا تَرجُموه وارجُموني، أنا الذي فعَلتُ بها، فاعتَرَف","result":"قد تابَ إلى اللهِ تَوبةً لو تابَها أهلُ المَدينةِ لقُبِلَ مِنهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-03946","otherNeedIds":[51],"ref":"معرفة السنن والآثار 17285","text":["في قِصَّةِ المَرأةِ التي وقَعَ عليها رَجُلٌ في سَوادِ الصُّبحِ، وهيَ تَعَمَدُ إلى المَسجِدِ، ثُمَّ فرَّ، وأُخِذَ مَنِ استَغاثَت به، فلَمَّا أُمِرَ به قامَ صاحِبُها الذي وقَعَ عليها، فقال: ",["لا تَرجُموه وارجُموني، أنا الذي فعَلتُ بها، فاعتَرَف",1],"، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم للمَرأةِ: أمَّا أنتِ فقد غُفِرَ لكِ، وقال للرَّجُلِ الذي أُخِذَ قَولًا حَسَنًا، فقيلَ له: ارجُمِ الذي اعتَرَف، فقال: لا، إنَّه ",["قد تابَ إلى اللهِ تَوبةً لو تابَها أهلُ المَدينةِ لقُبِلَ مِنهم",2],"، فأرسَلَهم"],"grade":"حسن","narrator":"وائل بن حجر","muhaddith":"إسناده حسن","bab":"حدود › من أقر بالحد","dorar":"u77Z5N43"},{"id":"س-08153","fp":"f8bbaac4a5a4","stateId":101,"easy":"إذا أخطأت فندمت واستغفرت قبل ست ساعات ← لا تُكتب عليك السيئة","cause":"فإن ندِم و استغفر اللهَ منها","result":"ألقاها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"صحيح الجامع 2097","srcLabel":"الطبراني","text":["إنَّ صاحبَ الشمالِ ليرفعُ القلمَ ستّ ساعاتٍ عن العبدِ المسلمِ المخطىءِ ، ",["فإن ندِم و استغفر اللهَ منها",1]," ",["ألقاها",2]," ، وإلا كُتِبَتْ واحدةٌ"],"grade":"حسن","narrator":"أبو أمامة الباهلي","muhaddith":"حسن","takhrij":"أخرجه الطبراني (8/217) (7765)، وأبو نعيم في ((حلية الأولياء)) (6/124)، والبيهقي في ((شعب الإيمان)) (7051) باختلاف يسير","bab":"ملائكة › أعمال الملائكة","dorar":"gySjziQg"},{"id":"س-03468","fp":"384089b3c965","stateId":102,"easy":"إذا أذنبت فتوضأت فأحسنت وصليت ركعتين واستغفرت ← يغفر الله لك","cause":"ليسَ مِن عَبدٍ يُذنِبُ ذَنبًا فيَقومُ فيَتَوضَّأُ فيُحسِنُ الوُضوءَ ثُمَّ يُصَلِّي رَكعَتَينِ، ثُمَّ يَستَغفِرُ اللَّهَ","result":"إلَّا غَفرَ اللهُ له","explicit":true,"apply":{"k":"count","t":"ركعتين · الوقت: بعد الوضوء"},"similar":["س-03461","س-03246","س-03447","س-03926","س-03448"],"ref":"الأربعون البلدانية 53","srcLabel":"أبو داود","text":["عن أسماءَ بنِ الحَكَمِ الفزاريِّ، قال: سَمِعتُ عليَّ بنَ أبي طالبٍ رَضِيَ الله عنه يَقولُ: كُنتُ إذا سَمِعتُ مِن رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم حَديثًا نَفعني اللهُ مِنه بما شاءَ أن يَنفعَني مِنه، وإذا حَدَّثَني غَيرُه استَحلفتُه، فإذا حَلَف لي صَدَّقتُه؛ فحَدَّثَني أبو بَكرٍ الصِّدِّيقُ رَضِيَ اللهُ عنه، وصَدَقَ أبو بَكرٍ رَضِيَ اللهُ عنه، قال: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: ",["ليسَ مِن عَبدٍ يُذنِبُ ذَنبًا فيَقومُ فيَتَوضَّأُ فيُحسِنُ الوُضوءَ ثُمَّ يُصَلِّي رَكعَتَينِ، ثُمَّ يَستَغفِرُ اللَّهَ",1],"، ",["إلَّا غَفرَ اللهُ له",2]],"grade":"صحيح","narrator":"أبو بكر","muhaddith":"محفوظ.","takhrij":"أخرجه النسائي في ((الكبرى)) (10175) واللفظ له، وأبو داود (1521) ، والترمذي (406) بنحوه.","bab":"استغفار › فضل الاستغفار","dorar":"vKdksWWB","merged":14,"otherRefs":["مجموع فتاوى ابن باز 28/441 (صحيح)","صحيح ابن حبان 623 (صحيح)","تخريج مشكل الآثار 6048 (حسن)","تخريج مشكل الآثار 6047 (حسن)","الأحاديث المختارة 9 (صحيح)","مجموع فتاوى ابن باز 25/165 (صحيح)","تخريج المسند لشعيب 48 (صحيح)","تخريج العواصم والقواصم 1/ 284 (صحيح)","تخريج مسند أبي بكر 9 (صحيح)","تخريج مشكل الآثار 6039 (حسن)","تخريج مشكل الآثار 6043 (حسن)","السلسلة الصحيحة 7/1179 (صحيح)","تخريج شرح السنة 1015 (حسن)"]},{"id":"س-03461","fp":"5b413a0db166","stateId":102,"easy":"إذا أذنبت فأحسنت الطهور وصليت ركعتين واستغفرت ← يغفر الله لك","cause":"ما مِن عبدٍ يذنبُ ذنبًا، فيُحسنُ الطُّهورَ، ثمَّ يقومُ فيُصلِّي رَكْعتينِ، ثمَّ يستغفِرُ اللَّهَ","result":"إلَّا غفرَ اللَّهُ لَهُ، ثمَّ قرأَ هذِهِ الآيةَ: وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ إلى آخرِ الآيةِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"صحيح أبي داود 1521","text":["عن أسماءَ بنِ الحَكَمِ الفزازي ، قالَ: سَمِعْتُ عليًّا رضيَ اللَّهُ عنهُ يقولُ: كنتُ رجلًا إذا سَمِعْتُ من رسولِ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ حديثًا نفعَني اللَّهُ منهُ بما شاءَ أن ينفعَني، وإذا حدَّثَني أحدٌ من أصحابِهِ استَحلفتُهُ، فإذا حلَفَ لي صدَّقتُهُ، قالَ: وحدَّثَني أبو بَكْرٍ وصدقَ أبو بَكْرٍ رضيَ اللَّهُ عنهُ، أنَّهُ قالَ: سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ علَيهِ وسلَّمَ يقولُ: ",["ما مِن عبدٍ يذنبُ ذنبًا، فيُحسنُ الطُّهورَ، ثمَّ يقومُ فيُصلِّي رَكْعتينِ، ثمَّ يستغفِرُ اللَّهَ،",1]," ",["إلَّا غفرَ اللَّهُ لَهُ، ثمَّ قرأَ هذِهِ الآيةَ:  وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ  إلى آخرِ الآيةِ",2]],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"صحيح","takhrij":"أخرجه أبو داود (1521)، وأحمد (56)، واللفظ لهما، والترمذي (406)، والنسائي في ((السنن الكبرى)) (10178)، باختلاف يسير.","bab":"استغفار › فضل الاستغفار","dorar":"sQqXwrY7","merged":2,"otherRefs":["تخريج المسند لشاكر 1/46 (صحيح)"]},{"id":"س-03246","fp":"9b1ddaa662b2","stateId":102,"easy":"إذا أذنبت ثم أحسنت الوضوء وصليت ركعتين واستغفرت الله ← يغفر الله لك","cause":"ما من مسلمٍ يذنبُ ذنبًا فيتوضأُ ويحسِنُ الوضوءَ ثمَّ يصلِّي رَكعتينِ ويستغفرُ اللَّهَ","result":"إلَّا غَفَرَ لَه ، وقرأَ هذِه الآيةَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"الاستقامة 2/184","text":[["ما من مسلمٍ يذنبُ ذنبًا فيتوضأُ ويحسِنُ الوضوءَ ثمَّ يصلِّي رَكعتينِ ويستغفرُ اللَّهَ",1]," ",["إلَّا غَفَرَ لَه ، وقرأَ هذِه الآيةَ ",2],"{ وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ }"],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"محفوظ في السنن","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (2) بنحوه، والبزار (6) باختلاف يسير","bab":"استغفار › أسباب المغفرة","dorar":"lM9oRpCm"},{"id":"س-03447","fp":"001dec50465b","stateId":102,"easy":"إذا أذنبت ثم توضأت فأحسنت وصليت واستغفرت ← يغفر الله لك","cause":"ما مِن رجُلٍ يُذنِبُ ذَنْبًا، فيَتوضَّأُ، فأَحسَنَ الوُضوءَ، ثمَّ صَلَّى واستَغفَرَ اللهَ مِنهُ","result":"إلَّا غَفَر اللهُ لهُ","explicit":true,"apply":{"k":"time","t":"بعد الوضوء"},"repOf":"س-03468","ref":"تخريج مسند أبي بكر 11","text":["سمِعتُ عليًّا رضيَ اللهُ عنه يقولُ: كنتُ امرَأً إذا سمِعتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حديثًا نفَعَني اللهُ بما شاء أنْ يَنفَعَني، وإذا حدَّثَني عنهُ أحدٌ مِن أَصحابِه استَحلَفْتُه، فإذا حلَف لي صَدَّقْتُه، وحلَفَ لي أبو بَكرٍ -وصدَقَ أبو بَكرٍ- أنَّه سمِع النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: «",["ما مِن رجُلٍ يُذنِبُ ذَنْبًا، فيَتوضَّأُ، فأَحسَنَ الوُضوءَ، ثمَّ صَلَّى واستَغفَرَ اللهَ مِنهُ،",1]," ",["إلَّا غَفَر اللهُ لهُ»",2],". قال: ثمَّ تلَا: {وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفِرُوا لِذُنُوبِهِمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (47) باختلاف يسير، والمروزي في ((مسند أبي بكر الصديق)) (11) واللفظ له","bab":"استغفار › فضل الاستغفار","dorar":"yB1PLhX0"},{"id":"س-03926","fp":"5fe3a4facdbc","stateId":102,"easy":"إذا أذنبت فتوضأت وصليت ركعتين واستغفرت ← يُغفر لك","cause":"ما مِن مسلمٍ يُذنِبُ ذنبًا، ثمَّ يَتوضَّأُ فيُصلِّي ركعتينِ، ثمَّ يَستغفِرُ اللهَ لذلك الذنبِ","result":"إلَّا غُفِر له، وقرَأَ هاتينِ الآيتينِ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"تخريج المسند لشعيب 47","text":["قال عليٌّ رضِي اللهُ عنه: كنتُ إذا سَمِعتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ شيئًا، نفَعَني اللهُ بما شاء أنْ ينفَعَني منه، وحدَّثَني أبو بَكْرٍ -وصدَقَ أبو بَكْرٍ- قال: قال رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["ما مِن مسلمٍ يُذنِبُ ذنبًا، ثمَّ يَتوضَّأُ فيُصلِّي ركعتينِ، ثمَّ يَستغفِرُ اللهَ لذلك الذنبِ،",1]," ",["إلَّا غُفِر له، وقرَأَ هاتينِ الآيتينِ: ",2],"{وَمَنْ يَعْمَلْ سُوءًا أوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَحِيمًا} [النساء: 110]، {وَالَّذِينَ إذَا فَعَلُوا فَاحِشَةً أوْ ظَلَمُوا أنْفُسَهُمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"أبو بكر الصديق","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (1521)، والترمذي (406)، والنسائي في ((السنن الكبرى)) (11078)، وابن ماجه (1395)، وأحمد (47) واللفظ له","bab":"تفسير آيات › سورة النساء","dorar":"TPxwKVBk"},{"id":"س-03448","fp":"3ec2223b3bc8","stateId":102,"easy":"إذا أذنبت فتطهرت وصليت ركعتين واستغفرت ← يُغفر لك","cause":"ما من عبدٍ أصابَ ذَنبًا فتَطهَّرَ، فأحسَنَ الطُّهورَ، وصلَّى رَكعتَيْنِ، واستَغفَرَ اللهَ تَعالى","result":"إلَّا غُفِرَ له، ثُم قرَأَ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"repOf":"س-03468","ref":"تخريج مشكل الآثار 6045","text":["[عن] علي رضي الله عنه يقول: كُنْتُ إذا سمِعْتُ من رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثًا يَنفَعُني اللهُ بما شاءَ أنْ يَنفَعَني به منه، فإذا حدَّثَني بعضُ أصحابِه استَحلَفْتُه، وصدَّقْتُه، وإنَّه حدَّثَني أبو بَكرٍ، وصدَقَ أبو بَكرٍ، قال: سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["ما من عبدٍ أصابَ ذَنبًا فتَطهَّرَ، فأحسَنَ الطُّهورَ، وصلَّى رَكعتَيْنِ، واستَغفَرَ اللهَ تَعالى",1]," ",["إلَّا غُفِرَ له، ثُم قرَأَ: ",2],"{أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ} [هود: 114]."],"grade":"حسن","narrator":"أبو بكر الصديق","muhaddith":"إسناده قوي","takhrij":"أخرجه الطحاوي في ((شرح مشكل الآثار)) (6045) بلفظه، وأبو داود (1521)، والترمذي (406)، وابن ماجه (1395)، وأحمد (56) جميعا بلفظ مقارب.","bab":"استغفار › فضل الاستغفار","dorar":"fu2vsTOQ"},{"id":"س-04050","fp":"f3e92257db01","stateId":102,"easy":"إذا أذنبت فصلِّ ← فإن الحسنات يذهبن السيئات","cause":"صَلِّ أرْبَعَ رَكَعاتٍ","result":"إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-06599","س-07766","س-07151","س-07709"],"ref":"الأحاديث المختارة 11 / 160","srcLabel":"مسلم","text":["«كانَ رَجُلٌ مِن أصْحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يَهْوى امْرَأةً، وكانَ ذاتَ يَوْمٍ جالِسًا عِنْدَ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ فاسْتَأْذَنَه في حاجةٍ، فأَذِنَ له، فخَرَجَ في يَوْمٍ مَطيرٍ فإذا هو بامْرَأةٍ على غَديرٍ تَغسِلُ، فلمَّا رآها جَلَسَ مِنها مَجلِسَ الرَّجُلِ مِن امْرَأتِه، ثُمَّ حَرَّكَ ذَكَرَه، فإذا هو مِثلُ الهُدْبةِ، فقامَ نادِمًا فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فذَكَرَ ذلك له، فقالَ له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["صَلِّ أرْبَعَ رَكَعاتٍ",1],"، فأَنزَلَ اللهُ: {وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وزُلَفًا مِنَ اللَّيْلِ ",["إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ",2]," ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ}»."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"له شاهد في صحيح مسلم من حديث الأسود وعلقمة عن ابن مسعود، ومن حديث أبي أمامة الباهلي، بنحوه.","bab":"توبة › قوله تعالى إن الحسنات يذهبن السيئات","dorar":"ar39nBMc","merged":2,"otherRefs":["مجمع الزوائد 7/41 (صحيح)"]},{"id":"س-06599","fp":"ee8578fab7ec","stateId":102,"easy":"إذا أذنبت فأقم الصلاة ← فإن الحسنات يذهبن السيئات","cause":"أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ","result":"إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"سنن الترمذي 3115","text":["أَتَتْنِي امرأةٌ تَبْتَاعُ تَمْرًا ، فقلتُ : إنَّ في البيتِ تَمْرًا أَطْيَبَ منه ، فدَخَلَتْ مَعِيَ في البيتِ ، فأَهْوَيْتُ إليها ، فقَبَّلْتُها ، فأَتَيْتُ أبا بكرٍ ، فذَكَرْتُ ذلك له ؟ قال : اسْتُرْ على نَفْسِكَ وتُبْ ، ولا تُخْبِرْ أحدًا ، فلم أَصْبِرْ ، فأَتَيْتُ عمرَ ، فذَكَرْتُ ذلك له ؟ فقال اسْتُرْ على نَفْسِكَ وتُبْ ، ولا تُخْبِرْ أحدًا ، فلم أَصْبِرْ ، فأَتَيْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم ، فذَكَرْتُ له ؟ فقال : أَخَلَفْتَ غازيًا في سبيلِ اللهِ في أهلِه بمِثْلِ هذا ، حتى تَمَنَّى أنه لم يَكُنْ أَسْلَمَ إلا تلك الساعةَ ، حتى ظَنَّ أنه من أهلِ النارِ . قال : وأَطْرَقَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم طويلًا حتى أُوحِيَ إليه :  وَ",["أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ",1]," ",["إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ",2]," ذَلِكَ ذِكْرَى لِلذَّاكِرِينَ .  قال أَبُو الْيَسَرِ : فأَتَيْتُهُ ، فقرأها عَلَيَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّم ، فقال أصحابُه : يا رسولَ اللهِ ، أَلِهَذَا خاصَّةً أم للناسِ عامَّةً ؟ قال : بل للناسِ عامَّةً"],"grade":"صحيح","narrator":"أبو اليسر كعب بن عمرو","muhaddith":"حسن صحيح","takhrij":"أخرجه الترمذي (3115)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Plnthd8L","merged":8,"otherRefs":["صحيح ابن حبان 1728 (صحيح)","صحيح مسلم 2763 (صحيح)","صحيح ابن ماجه 1155 (صحيح)","تخريج المسند لشعيب 4290 (صحيح)","ذخيرة الحفاظ 2/643 (صحيح)","تخريج المسند لشعيب 22112 (صحيح)"]},{"id":"س-07766","fp":"76458f6dd856","stateId":102,"easy":"إذا أذنبت فأقم الصلاة ← فإن الحسنات يذهبن السيئات، وهي للناس عامة","cause":"وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ...} إلى قولِه: {لِلذَّاكِرِينَ","result":"بل هي للناسِ عامةً","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"تخريج المسند لشعيب 2430","text":["أنَّ امرأةً مُغيبًا أتَتْ رجُلًا تشتري منه شيئًا، فقال: ادخُلي الدَّوْلَجَ حتى أُعطِيَكِ، فدخَلتْ، فقَبَّلَها وغمَزَها، فقالَتْ: وَيْحكَ؛ إنِّي مُغيبٌ، فترَكَها، وندِمَ على ما كان منه، فأتى عمرَ، فأخبَرَه بالذي صنَع، فقال: وَيْحَكَ، فلعلَّها مُغيبٌ، قال: فإنَّها مُغيبٌ، قال: فائتِ أبا بكرٍ، فاسأَلْه فأتى أبا بكرٍ، فأخبَرَه، فقال أبو بكرٍ: وَيْحَكَ؛ لعلَّها مُغيبٌ، قال: فإنَّها مُغيبٌ، قال: فائتِ النبيَّ صلَّى اللهُ عليه وسلَّمَ فأخبِرْه، فأتى النبيَّ صلَّى اللهُ عليه وسلَّمَ فأخبَرَه، فقال النبيُّ صلَّى اللهُ عليه وسلَّمَ: لعلَّها مُغيبٌ قال: فإنَّها مُغيبٌ، فسكَتَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، ونزَلَ القرآنُ: {",["وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ...} إلى قولِه: {لِلذَّاكِرِينَ",1],"} [هود: 114] ، قال: فقال الرجُلُ: يا رسولَ اللهِ، أهي فيَّ خاصةً، أو في الناسِ عامةً؟ قال: فقال عمرُ: لا، ولا نُعْمةَ عينٍ لَكَ، ",["بل هي للناسِ عامةً",2],"، قال: فضحِكَ النبيُّ صلَّى اللهُ عليه وسلَّمَ وقال: صدَقَ عمرُ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح لغيره","takhrij":"أخرجه أحمد (2430) واللفظ له، والطبراني (12/215) (12931)، وابن عدي في ((الكامل في الضعفاء)) (5/199)","bab":"قرآن › أسباب النزول","dorar":"oL6yb3Cc","merged":2,"otherRefs":["تخريج المسند لشعيب 2206 (صحيح)"]},{"id":"س-07151","fp":"6ca5641c2fe9","stateId":102,"easy":"إذا أذنبت فتوضأ وصلِّ ← فإن الحسنات يذهبن السيئات","cause":"تَوضَّأْ، وصَلِّ","result":"فأنزَلَ اللهُ تعالَى: وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"تخريج سير أعلام النبلاء 7/378","text":["جاء رجُلٌ، فقالَ: يا رسولَ اللهِ! رجُلٌ لَقِيَ امرأةً، فصنَعَ بها ما يَصنَعُ الرجُلُ بامرأتِه؛ إلا أنَّه لم يُجامِعْها.\nقال: ",["فأنزَلَ اللهُ تعالَى: {وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ",2],"..} [هود: 114] الآيةَ. فقال له: ",["تَوضَّأْ، وصَلِّ",1],". قلتُ: يا رسولَ اللهِ! هذا له خاصَّةً، أو للناسِ عامَّةً؟ قال: للناسِ -أو للمُسلِمينَ- عامَّةً."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه الترمذي (3113)، وأحمد (22112)، والدارقطني في ((سننه)) (483) باختلاف يسير.","bab":"علم › حسن السؤال ونصح العالم","dorar":"aQg6sKPv"},{"id":"س-07709","fp":"db4b9338491b","stateId":102,"easy":"إذا أذنبت فتوضأ وضوءاً حسناً ثم صلِّ ← فإن الحسنات يذهبن السيئات","cause":"تَوَضَّأْ وُضوءًا حَسَنًا ثُمَّ قُمْ فَصَلِّ","result":"أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04050","ref":"المستدرك على الصحيحين 476","text":["أنَّه كان قاعِدًا عندَ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ، فجاءَهُ رَجُلٌ، فقالَ: يا رسولَ اللهِ، ما تَقولُ في رَجُلٍ أَصابَ مِنِ امْرأةٍ لا تَحِلُّ له، فلَمْ يَدَعْ شَيْئًا يُصيبُهُ الرَّجُلُ مِنِ امْرأَتِهِ إلَّا وقد أَصابَهُ مِنها إلَّا أنَّه لمْ يُجامِعْها؟ فقالَ: «",["تَوَضَّأْ وُضوءًا حَسَنًا ثُمَّ قُمْ فَصَلِّ",1],"». قالَ: وأنزلَ اللهُ عزَّ وجلَّ: {",["أَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ",2],"} [هود: 114] الآيةَ، قالَ: فقالَ: هي لي خاصَّةً أَمْ لِلمُسلِمينَ عامَّةً؟ قالَ: «بلْ هي لِلْمُسْلِمينَ عامَّةً»."],"grade":"صحيح","narrator":"معاذ بن جبل","muhaddith":"صحيح","takhrij":"أخرجه أحمد (22112)، والطبراني (20/ 136) (351)، وأبو نعيم في ((الحلية)) (3/ 165) بلفظ قريب.","bab":"قرآن › أسباب النزول","dorar":"yVEav39k"},{"id":"س-03454","fp":"6c9851540584","stateId":103,"easy":"إذا أذنبت فقلت «اللهم اغفر لي ذنبي» (وتكرر ذلك صادقاً) ← يقول الله: قد غفرت لك","cause":"أذنَبَ عَبدٌ ذَنبًا، فقال: اللَّهمَّ اغفِرْ لي ذَنبي","result":"اعمَلْ ما شِئتَ فقد غَفَرتُ لَكَ","explicit":true,"star":true,"apply":{"k":"say","t":"«اللهم اغفر لي ذنبي»"},"similar":["س-03442"],"ref":"صحيح مسلم 2758","srcLabel":"البخاري","text":["عَنِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فيما يَحكي عن رَبِّه عَزَّ وجَلَّ، قال: ",["أذنَبَ عَبدٌ ذَنبًا، فقال: اللَّهمَّ اغفِرْ لي ذَنبي",1],"، فقال تَبارَكَ وتَعالى: أذنَبَ عَبدي ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ثُمَّ عادَ فأذنَبَ، فقال: أي رَبِّ اغفِرْ لي ذَنبي، فقال تَبارَكَ وتَعالى: عَبدي أذنَبَ ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ثُمَّ عادَ فأذنَبَ، فقال: أي رَبِّ اغفِرْ لي ذَنبي، فقال تَبارَكَ وتَعالى: أذنَبَ عَبدي ذَنبًا، فعَلِمَ أنَّ له رَبًّا يَغفِرُ الذَّنبَ، ويَأخُذُ بالذَّنبِ، ",["اعمَلْ ما شِئتَ فقد غَفَرتُ لَكَ",2],"، قال عبدُ الأعلى: لا أدري أقال في الثَّالِثةِ أوِ الرَّابِعةِ: اعمَلْ ما شِئتَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7507) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"g3g2Cr2h","merged":4,"otherRefs":["تخريج صحيح ابن حبان 625 (صحيح)","المستدرك على الصحيحين 7817 (صحيح)","تخريج صحيح ابن حبان 622 (صحيح)"]},{"id":"س-06983","fp":"1abfbcc6bbd7","stateId":103,"easy":"إذا قلت «سبحانك إني ظلمت نفسي فاغفر لي» ← يقول الله: علم عبدي أن له رباً يغفر الذنوب","cause":"سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي","result":"عَلِمَ عَبْدي أنَّ له رَبًّا يَغفِرُ الذُّنوبَ","explicit":true,"apply":{"k":"say","t":"«سبحانك إني ظلمت نفسي فاغفر لي»"},"otherNeedIds":[23],"ref":"الأحاديث المختارة 676","srcLabel":"البخاري","text":["«رَأيْتُ علِيًّا أُتِيَ بدابَّةٍ فوَضَعَ رِجْلَه في الرِّكابِ، فقالَ: بِسْمِ اللهِ، فلمَّا اسْتَوى عليها قالَ: الحَمْدُ للهِ، ثُمَّ قالَ: {سُبْحانَ الَّذِي سَخَّرَ لَنَا هَذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ * وَإِنَّا إِلَى رَبِّنَا لَمُنْقَلِبُونَ} ثُمَّ كَبَّرَ ثَلاثًا، ثُمَّ قالَ: لا إلهَ إلَّا أنت ",["سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي",1],"؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنت، ثُمَّ اسْتَضْحَكَ، فقُلْتُ: مِمَّ اسْتَضْحَكْتَ؟ فقالَ: إنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قالَ مِثلَ ما قُلْتُ ثُمَّ اسْتَضْحَكَ، فقُلْتُ: مِمَّ اسْتَضْحَكْتَ يا رَسولَ اللهِ؟ قالَ: يَعجَبُ رَبُّنا جَلَّ وعَزَّ مِن قَوْلِ عَبْدِه: سُبْحانَك إنِّي ظَلَمْتُ نَفْسي فاغْفِرْ لي؛ إنَّه لا يَغفِرُ الذُّنوبَ إلَّا أنت. قالَ: ",["عَلِمَ عَبْدي أنَّ له رَبًّا يَغفِرُ الذُّنوبَ",2],"»."],"grade":"صحيح","narrator":"علي بن أبي طالب","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"gc5COypR","merged":2,"otherRefs":["تخريج المسند لشاكر 2/234 (صحيح)"]},{"id":"س-03442","fp":"aa0c7d16ac34","stateId":103,"easy":"إذا أذنبت فقلت «ربّ أذنبت فاغفر لي» ← يقول الله: غفرت لعبدي","cause":"فقال: رَبِّ أذنَبتُ -ورُبَّما قال: أصَبتُ- فاغفِرْ لي","result":"غَفَرتُ لعَبدي","explicit":true,"apply":{"k":"say","t":"«ربّ أذنبت فاغفر لي»"},"repOf":"س-03454","ref":"صحيح البخاري 7507","text":["إنَّ عَبدًا أصابَ ذَنبًا -ورُبَّما قال: أذنَبَ ذَنبًا- ",["فقال: رَبِّ أذنَبتُ -ورُبَّما قال: أصَبتُ- فاغفِرْ لي",1],"، فقال رَبُّه: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ ",["غَفَرتُ لعَبدي",2],"، ثُمَّ مَكَثَ ما شاءَ اللهُ، ثُمَّ أصابَ ذَنبًا، أو أذنَبَ ذَنبًا، فقال: رَبِّ أذنَبتُ -أو أصَبتُ- آخَرَ، فاغفِرْه، فقال: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ غَفَرتُ لعَبدي، ثُمَّ مَكَثَ ما شاءَ اللهُ، ثُمَّ أذنَبَ ذَنبًا، ورُبَّما قال: أصابَ ذَنبًا، قال: قال: رَبِّ أصَبتُ -أو قال أذنَبتُ- آخَرَ، فاغفِرْه لي، فقال: أعَلِمَ عَبدي أنَّ له رَبًّا يَغفِرُ الذَّنبَ ويَأخُذُ به؟ غَفَرتُ لعَبدي، ثَلاثًا، فليَعمَلْ ما شاءَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (2758) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"lBPrgPzp","merged":2,"otherRefs":["تخريج المسند لشعيب 9256 (صحيح)"]},{"id":"س-06824","fp":"16028e07d968","stateId":103,"easy":"إذا استغفرت في وقت النزول الإلهي ← يغفر الله لك","cause":"ألَا مُستغفرٌ فيستغفرُنِي","result":"فأغفِرَ لهُ","explicit":true,"similar":["س-00001","س-02770"],"otherNeedIds":[29,35],"ref":"البحر الزخار 10/18","srcLabel":"الطبراني","text":["إنَّ اللهَ تباركَ وتعالَى ينزِلُ في ثَلاثِ ساعاتٍ بَقينَ من اللَّيلِ ، فيُفتحُ الذِّكرَ السَّاعةَ الأُولَى الَّذي لَم يرَهُ أحدٌ غيرُه ، فيَمحُو اللهُ ما يشاءُ ويُثبتُ ما يشاءُ ، ثمَّ ينزلُ السَّاعةَ الثَّانيةَ إلى جنَّةِ عدنٍ ، وهيَ الَّتي لَم يرَهَا غيرَه ، ولم تخطُرَ على قَلبِ بشرٍ ، لا يُسكنُهَا معهُ من بنِي آدمَ غيرَ ثلاثةٍ : النبيِّينَ والصِّدِّيقينَ والشُّهداءِ ، ثمَّ يقولُ : طُوبَى لمَن دخلَكِ ، ثمَّ ينزلُ في الساعةِ الثَّالثةِ إلى سماءِ الدُّنيا ، فيقولُ : ",["ألَا مُستغفرٌ فيستغفرُنِي",1]," ",["فأغفِرَ لهُ",2]," ! ألَا مِن سائلٍ يسألُنِي فأعطِيَهُ ! ألا من داعٍ يدعُوني فأُجِيبَه ! حتَّى تكونَ صَلاةُ الفجرِ ، وكذلك يقولُ اللهُ عزَّ وجلَّ : ?وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا? قال : تَشهدُه ملائكةُ اللَّيلِ والنَّهارِ"],"grade":"صحيح","narrator":"أبو الدرداء","muhaddith":"محفوظ","takhrij":"أخرجه ابن خزيمة في ((التوحيد)) (46)، والعقيلي في ((الضعفاء الكبير)) (2/93)، والطبراني في ((المعجم الأوسط)) (8635) بنحوه","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"RscjYhUL","merged":17,"otherRefs":["تخريج المسند لشعيب 10756 (صحيح)","تخريج المسند لشعيب 10544 (صحيح)","تخريج المسند لشعيب 4268 (صحيح)","شرح ابن ماجه لمغلطاي 2/511 (صحيح)","تخريج المسند لشعيب 11295 (صحيح)","صحيح الجامع 1917 (صحيح)","فتاوى نور على الدرب لابن باز 10/164 (صحيح)","تخريج صحيح ابن حبان 921 (صحيح)","تحفة المحتاج 1/425 (صحيح)","تخريج المسند لشعيب 9591 (صحيح)","تخريج كتاب السنة 502 (صحيح)","مختصر الصواعق المرسلة 444 (صحيح)","تخريج كتاب السنة 499 (صحيح)","صحيح مسلم 758 (صحيح)","تلخيص العلل المتناهية 27 (صحيح)","معارج القبول 296/1 (حسن)"]},{"id":"ق-0010","fp":"97cd7d0a3c14","stateId":103,"easy":"التوبة بكلمات الاستغفار ← توبة الله على العبد","cause":"التوبة بكلمات الاستغفار","result":"توبة الله على العبد","explicit":true,"ref":"سورة البقرة: 37","srcLabel":"القرآن الكريم","quran":{"s":2,"from":37,"to":37,"text":"فَتَلَقَّى آدَمُ مِنْ رَبِّهِ كَلِمَاتٍ فَتَابَ عَلَيْهِ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ (37)","hl":[[0,40,1],[40,56,2],[56,92,1]]}},{"id":"ق-0016","fp":"d552e7be3a18","stateId":103,"easy":"الاستغفار (قول حطة) والدخول سجّداً ← مغفرة الخطايا وزيادة المحسنين","cause":"الاستغفار (قول حطة) والدخول سجّداً","result":"مغفرة الخطايا وزيادة المحسنين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["ق-0433"],"otherNeedIds":[45],"ref":"سورة البقرة: 58","srcLabel":"القرآن الكريم","quran":{"s":2,"from":58,"to":58,"text":"وَإِذْ قُلْنَا ادْخُلُوا هَذِهِ الْقَرْيَةَ فَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ رَغَدًا وَادْخُلُوا الْبَابَ سُجَّدًا وَقُولُوا حِطَّةٌ نَغْفِرْ لَكُمْ خَطَايَاكُمْ وَسَنَزِيدُ الْمُحْسِنِينَ (58)","hl":[[85,133,1],[133,188,2]]}},{"id":"ق-0433","fp":"124d5869b560","stateId":103,"easy":"قول حطة والدخول سجّداً ← مغفرة الخطيئات وزيادة المحسنين","cause":"قول حطة والدخول سجّداً","result":"مغفرة الخطيئات وزيادة المحسنين","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"ق-0016","otherNeedIds":[45],"ref":"سورة الأعراف: 161","quran":{"s":7,"from":161,"to":161,"text":"وَإِذْ قِيلَ لَهُمُ اسْكُنُوا هَذِهِ الْقَرْيَةَ وَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ وَقُولُوا حِطَّةٌ وَادْخُلُوا الْبَابَ سُجَّدًا نَغْفِرْ لَكُمْ خَطِيئَاتِكُمْ سَنَزِيدُ الْمُحْسِنِينَ (161)","hl":[[82,130,1],[130,185,2]]}},{"id":"ق-0915","fp":"7b07cea51bfd","stateId":103,"easy":"الاعتراف بالذنب والاستغفار ← المغفرة","cause":"الاعتراف بالذنب والاستغفار","result":"المغفرة","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"ref":"سورة القصص: 16","srcLabel":"القرآن الكريم","quran":{"s":28,"from":16,"to":16,"text":"قَالَ رَبِّ إِنِّي ظَلَمْتُ نَفْسِي فَاغْفِرْ لِي فَغَفَرَ لَهُ إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ (16)","hl":[[0,50,1],[50,63,2]]}},{"id":"ق-1393","fp":"d11a37e1d847","stateId":103,"easy":"الاستغفار ← مغفرة الله ورحمته","cause":"الاستغفار","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة المزمل: 20","srcLabel":"القرآن الكريم","quran":{"s":73,"from":20,"to":20,"text":"إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَى مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَى وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا وَاسْتَغْفِرُوا اللَّهَ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (20)","hl":[[624,648,1],[648,677,2]]}},{"id":"س-00001","fp":"1bf1125a68e3","stateId":103,"easy":"إذا استغفرت أو تبت في وقت النزول الإلهي ← يُغفر لك ويُتاب عليك","cause":"هل مِن مُستغفرٍ","result":"يُغفَرُ لهُ هَل من تائبٍ يُتابُ عليهِ","explicit":true,"repOf":"س-06824","ref":"الزواجر عن اقتراف الكبائر 1/198","text":["إذا كانَ أوَّلُ ليلةٍ مِن شهرِ رمضانَ فُتِحَت أبوابُ الجِنانِ فلَم يُغلَق منها بابٌ واحدٌ الشَّهرَ كلَّهُ ، وغُلِّقَت أبوابُ النَّارِ فلم يُفتَح منها بابٌ واحدٌ الشَّهرَ كلَّهُ وغُلَّت عُتاةُ الجنِّ وَنادَى مُنادٍ منَ السَّماءِ كلَّ ليلةٍ إلى انفِجارِ الصُّبحِ يا باغيَ الخَيرِ تَمِّم وأبشِر ويا باغيَ الشَّرِّ أقصِر وأبصِر ",["هل مِن مُستغفرٍ",1]," ",["يُغفَرُ لهُ هَل من تائبٍ يُتابُ عليهِ",2]," هل من داعٍ يُستَجابُ لهُ هل مِن سائلٍ يُعطَى سؤلَهُ وللَّهِ عزَّ وجلَّ عندَ كلِّ فطرٍ مِن شهرِ رمضانَ كلَّ لَيلةٍ عتقاءُ منَ النَّارِ ستُّونَ ألفًا فإذا كانَ يومُ الفطرِ أعتقَ اللَّهُ مثلَ ما أعتقَ في جميعِ الشَّهرِ ثَلاثينَ مرَّةً ستِّينَ ألفًا"],"grade":"صحيح","muhaddith":"صحيح أو حسن","bab":"آداب الدعاء › استجابة الدعاء","dorar":"sHjgh6Tp","merged":3,"otherRefs":["المتجر الرابح 142 (حسن)","تخريج كتاب السنة 513 (صحيح)"]},{"id":"س-00859","fp":"35dfab110d6e","stateId":103,"easy":"إذا قلت «أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه» ثلاثاً ← تُغفر ذنوبك","cause":"مَنْ قال : أستغفرُ اللهَ الذي لا إلهُ إلَّا هو الحيُّ القيومُ و أتوبُ إليهِ ، ثلاثًا","result":"غُفِرَتْ لهُ ذنوبُهُ ، و إن كان فارًا مِنَ الزحفِ","explicit":true,"apply":{"k":"say","t":"«أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه»"},"ref":"السلسلة الصحيحة 2727","srcLabel":"السلسلة الصحيحة","text":[["مَنْ قال : أستغفرُ اللهَ الذي لا إلهُ إلَّا هو الحيُّ القيومُ و أتوبُ إليهِ ، ثلاثًا ، ",1],["غُفِرَتْ لهُ ذنوبُهُ ، و إن كان فارًا مِنَ الزحفِ",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود وزيد مولى رسول الله وأبو بكر الصديق وأبو سعيد الخدري وأنس بن مالك والبراء بن عازب","muhaddith":"صحيح","bab":"أدعية وأذكار › فضل التهليل والتسبيح والدعاء","dorar":"48OdleHQ"},{"id":"س-02770","fp":"6b7699723df2","stateId":103,"easy":"إذا استغفرت في وقت النزول الإلهي آخر الليل ← يغفر الله لك","cause":"هل من مستغفِرٍ","result":"فأغفرَ لَه","explicit":true,"apply":{"k":"time","t":"في الليل"},"repOf":"س-06824","ref":"شرح البخاري لابن الملقن 22/551","text":["ثلاثُ ساعاتٍ يبقَينَ منَ اللَّيلِ يفتحُ اللَّهُ عزَّ وجلَّ الذِّكرَ الَّذي لم يرَه أحدٌ غيرُه فيمحُو ما شاء ويُثبتُ ثمَّ في السَّاعةِ الثَّانيةِ ينزلُ إلى عَدْنٍ فيقولُ طوبى لمن دخلَكِ ثمَّ ينزلُ في السَّاعةِ الثَّالثةِ إلى السَّماءِ الدُّنيا بملائكةٍ فيقولُ ",["هل من مستغفِرٍ",1]," ",["فأغفرَ لَه",2]," هَل من داعٍ فأُجيبُهُ حتَّى يصلَّى الفجرُ وذلِكَ قولُه { وَقُرْآنَ الْفَجْرِ إِنَّ قُرْآنَ الْفَجْرِ كَانَ مَشْهُودًا} يقول يشهدُهُ اللَّهُ وملائكتُهُ وملائكةُ الليلِ وملائِكةُ النَّهارِ."],"grade":"صحيح","muhaddith":"روى الحاكم نحوه على شرط الشيخين عن أبي هريرة رضي الله عنه وأبي سعيد مرفوعاً","bab":"إيمان › الملائكة","dorar":"dUCLAyKW"},{"id":"س-03118","fp":"916697231b45","stateId":103,"easy":"إذا قلت «أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه» ← يُغفر لك ولو كنت فررت من الزحف","cause":"مَن قال: أَستغفِرُ اللهَ الذي لا إلهَ إلَّا هو الحيُّ القيومُ وأتوبُ إليه","result":"غُفِر له وإنْ كان فَرَّ مِن الزَّحفِ","explicit":true,"apply":{"k":"say","t":"«أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه»"},"ref":"تخريج سنن أبي داود 1517","srcLabel":"أبو داود","text":["سَمِعتُ أَبي يُحدِّثُنيه عن جدِّي أنَّه سَمِع النَّبيَّ صلَّى اللهُ عليه وسلَّمَ يقولُ: ",["مَن قال: أَستغفِرُ اللهَ الذي لا إلهَ إلَّا هو الحيُّ القيومُ وأتوبُ إليه، ",1],["غُفِر له وإنْ كان فَرَّ مِن الزَّحفِ",2],"."],"grade":"صحيح","narrator":"زيد بن حارثة مولى رسول الله صلى الله عليه وسلم","muhaddith":"صحيح لغيره","takhrij":"أخرجه الترمذي (3577)، وأبو داود (1517)، وابن سعد في ((الطبقات الكبرى)) (7/ 66) بلفظه.","bab":"إيمان › توحيد الأسماء والصفات","dorar":"L0RfFw8a"},{"id":"س-03441","fp":"0308a5c7fe30","stateId":103,"easy":"إذا ساء لسانك على أهلك فأكثر من الاستغفار ← (علاج نبوي)","cause":"أين أنتَ من الاستِغْفارِ","result":"كان في لِساني ذَرَبٌ على أهْلي","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[37],"ref":"تخريج المسند لشعيب 23340","srcLabel":"النسائي","text":[["كان في لِساني ذَرَبٌ على أهْلي",2]," لم أعْدُه إلى غَيرِه، فذَكَرتُ ذلك لِلنَّبيِّ صلَّى اللهُ عليه وسلَّمَ قال: ",["أين أنتَ من الاستِغْفارِ",1]," يا حُذَيفةُ، إنِّي لَأستغفِرُ اللهَ كُلَّ يَومٍ مِئَةَ مَرَّةٍ، وأتوبُ إليه. قال: فذَكَرتُه لأبي بُرْدةَ بنِ أبي موسى فحَدَّثَني، عن أبي موسى، أنَّ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قال: إنِّي لَأستَغفِرُ اللهَ كُلَّ يَومٍ ولَيْلةٍ مِئَةَ مَرَّةٍ، وأتوبُ إليه."],"grade":"صحيح","narrator":"حذيفة بن اليمان","muhaddith":"صحيح لغيره دون قصة ذرابة اللسان","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (10287)، وابن ماجه (3817)، وأحمد (23340) واللفظ له","bab":"استغفار › فضل الاستغفار","dorar":"keiBfcv1","merged":6,"otherRefs":["تخريج المسند لشعيب 23371 (صحيح)","الأمالي المطلقة 252 (حسن)","المستدرك على الصحيحين 3752 (صحيح)","تخريج المسند لشعيب 23421 (صحيح)","تخريج المسند لشعيب 23362 (صحيح)"]},{"id":"س-03934","fp":"1c3be169d527","stateId":103,"easy":"إذا أذنبت فقرأت الآيتين واستغفرت الله ← يغفر لك","cause":"ما أذنب عبدٌ ذنبًا فقرأَهما واستغفرَ اللهَ","result":"إلا غَفَرَ لَهُ","explicit":true,"ref":"مجمع الزوائد 7/14","srcLabel":"الطبراني","text":["عنِ ابنِ مسعودِ رَضِيَ اللهُ عنه قال إنَّ في كتابِ اللهِ لَآيَتَيْنِ ",["ما أذنب عبدٌ ذنبًا فقرأَهما واستغفرَ اللهَ",1]," ",["إلا غَفَرَ لَهُ",2],"   وَالَّذِينَ إِذَا فَعَلُواْ فَاحِشَةً أَوْ ظَلَمُواْ أَنْفُسَهُمْ ذَكَرُواْ اللَّهَ فَاسْتَغْفَرُواْ لِذُنُوبِهِمْ وَمَن يَغْفِرُ الذُّنُوبَ إِلاَّ اللَّهُ   وَمَن يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ثُمَّ يَسْتَغْفِرِ اللَّهَ يَجِدِ اللَّهَ غَفُورًا رَّحِيمًا"],"grade":"صحيح","narrator":"محمد بن سيرين","muhaddith":"رجاله رجال الصحيح","takhrij":"أخرجه الطبراني في ((المعجم الكبير)) (9/ 212) (9035) واللفظ له، وابن أبي الدنيا في ((التوبة)) (20)، والبيهقي في ((شعب الإيمان)) (6743) بنحوه.","bab":"تفسير آيات › سورة النساء","dorar":"tQiiqGpj"},{"id":"س-06972","fp":"70bb9dee3a7b","stateId":103,"easy":"إذا استغفرت في جوف الليل ← يغفر الله لك إلا الشرك والبغي","cause":"في جوفِ اللَّيلِ","result":"فيغفِرُ إلَّا ما كان من الشِّركِ والبَغيِ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"apply":{"k":"time","t":"في الليل"},"ref":"التمهيد 4/15","srcLabel":"مسلم","text":["عن عمرِو بنِ عَبْسةَ قال : أتيتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم وهو بعُكاظٍ قلتُ من معك على هذا الأمرِ ؟ قال : حُرٌّ وعبدٌ ومعه أبو بكرٍ وبلالٌ ثمَّ قال : فارجِعْ حتَّى يمكِّنَ اللهُ لرسولِه قال فأتيتُه بعدُ فقلتُ يا رسولَ اللهِ - جعلني اللهُ فداك - شيئَّا تَعلمُه وأجهلُه لا يضُرُّك وينفعُني اللهُ به ، هل من ساعةٍ أفضلُ من ساعةٍ ؟ وهل من ساعةٍ لا يُصلَّى فيها ؟ قال لقد سألتني عن شيءٍ ما سألني عنه أحدٌ ، إنَّ اللهَ تبارك وتعالَى ينزِلُ ",["في جوفِ اللَّيلِ",1]," ",["فيغفِرُ إلَّا ما كان من الشِّركِ والبَغيِ",2]," والصَّلاةُ مشهودةٌ ، فصَلِّ حتَّى تطلُعَ الشَّمسُ فإذا طلعت فأقصِرْ فإنَّها تطلُعُ على قرْنِ شيطانٍ وهي صلاةُ الكفَّارِ حتَّى ترتفعَ فإذا استقلَّت الشَّمسُ فصَلِّ ، فإنَّ الصَّلاةِ مشهودةٌ محضورةٌ حتَّى يعتدِلَ النَّهارُ فإذا اعتدل النَّهارُ فأقصِرْ عن الصَّلاةِ فإنَّها ساعةٌ تُسجَرُ فيها جهنَّمُ حتَّى يفيءَ الفيْءُ فإذا أفاء الفيْءُ فصَلِّ فإنَّ الصَّلاةَ محضورةٌ مشهودةٌ حتَّى تدنوَ الشَّمسُ للغروبِ فإذا تدلَّت فاقصِر عن الصَّلاةِ فإنَّها تغيبُ على قرْنِ شيطانٍ وهي صلاةُ الكفَّارِ"],"grade":"صحيح","narrator":"عمرو بن عبسة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (832) ، وأبو داوود (1277) ، وابن خزيمة في ((صحيحه)) (260) ، والحاكم في ((مستدركه)) (584) جميعا بمعناه مطولا .","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"qFFA6fOq"},{"id":"س-06966","fp":"813c553fa714","stateId":103,"easy":"إذا استغفرت ← يغفر الله لك إلا البغي والمكس","cause":"لمن يستغفرُ","result":"إنَّ اللهَ تعالَى يدنو من خلقِه فيغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"الترغيب والترهيب 2/28","srcLabel":"الطبراني","text":[["إنَّ اللهَ تعالَى يدنو من خلقِه فيغفرُ",2]," ",["لمن يستغفرُ",1]," إلا لبغِّيٍّ بفرجهِا أو عشَّارٍ"],"grade":"صحيح","narrator":"عثمان بن أبي العاص الثقفي","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه الطبراني (9/ 54) (8371) واللفظ له، وابن عدي في ((الكامل في الضعفاء)) (ص104)، وابن قانع في ((معجم الصحابة)) (2/ 388) كلاهما باختلاف يسير.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"WCtsG8vl"},{"id":"س-03436","fp":"79a3d898b358","stateId":104,"easy":"إذا علمت أن الله قادر على مغفرتك فاستغفرته ← يغفر لك ولا يبالي","cause":"فمَن علم منكم أنني ذو قدرةٍ على المغفرةِ فاستغفرَني","result":"غفرتُ له ولا أُباِلِي","explicit":true,"star":true,"ref":"هداية الرواة 2/453","srcLabel":"مسلم","text":["يقولُ اللهُ تعالَى : يا عبادِي ! كلُّكم ضالٌّ إلا مَن هديتُ ؛ فسَلوني الهدَى أهدِكم ، وكلُّكم فقراءُ إلا من أغنيتُ ؛ فسلوني الرزقَ أرزقُكم ، وكلُّكم مذنبٌ إلا من عافيتُ ؛ ",["فمَن علم منكم أنني ذو قدرةٍ على المغفرةِ فاستغفرَني",1]," ؛ ",["غفرتُ له ولا أُباِلِي",2]," ، ولو أن أولَكم وآخرَكم وحيَّكم وميِّتَكم ورطبَكم ويابسَكم اجتمعوا على أتقَى قلبِ عبدٍ من عبادِي ؛ ما زاد ذلك من ملكِي جناحَ بعوضةٍ ، ولو أن أولَكم وآخرَكم وحيَّكم وميِّتَكم ورطْبَكم ويابسَكم اجتمعوا على أشقَى قلبِ عبدٍ من عبادي ؛ ما نقصَ ذلك من ملكِي جناحَ بعوضةٍ ، ولو أن أولَكم وآخرَكم وحيَّكم وميتَكم ورطْبَكم ويابسَكم اجتمعوا في صعيدٍ واحدٍ ، فسأل كلُّ إنسانٍ منكم ما بلغت أمنيتُه ، فأعطيتُ كلَّ سائلٍ منكم ما سأل ؛ ما نقصَ ذلك من ملكي إلا كما لو أن أحدَكم مرَّ بالبحرِ ، فغمس فيه إبرةً ثم رفعها ، ذلك بأني جوادٌ ماجدٌ أفعلُ ما أريدُ ، عطائي كلامٌ ، وعذابي كلامٌ ، إنما أمري لشيءٍ – إذا أردتُه أن أقولَ له : كنْ ، فيكونُ"],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"أصله في مسلم","takhrij":"أخرجه الترمذي (2495)، وابن ماجه (4257)، وأحمد (21367) باختلاف يسير","bab":"استغفار › فضل الاستغفار","dorar":"OV8RfHWy","merged":4,"otherRefs":["تخريج المسند لشعيب 21540 (صحيح)","المستدرك على الصحيحين 7885 (صحيح)","الأسماء والصفات للبيهقي 1/211 (صحيح)"]},{"id":"س-01802","fp":"db72ab92dbf5","stateId":104,"easy":"إذا أخطأت حتى ملأت خطاياك ما بين السماء والأرض ثم استغفرت ← يغفر الله لك","cause":"لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ","result":"لغَفَر لكم","explicit":true,"star":true,"ref":"الأحاديث المختارة 1544","srcLabel":"البخاري","text":["«دخَلْتُ على أنَسِ بنِ مالِكٍ قال: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: والذي نفسي بيَدِه -أو والذي نَفْسُ مُحَمَّدٍ بيَدِه- ",["لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ",1]," ",["لغَفَر لكم",2],"، والذي نَفْسُ مُحَمَّد بيَدِه -أو والذي نفسي بيَدِه لو لم تُخِطئوا لجاء اللهُ بقومٍ يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ فيَغفِرُ لهم»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"cMqHprTP","merged":2,"otherRefs":["تخريج شرح السنة 1295 (صحيح)"]},{"id":"س-07750","fp":"48ad8da052dc","stateId":104,"easy":"إذا تركت الشرك والقتل والزنا وتبت وعملت صالحاً ← يبدّل الله سيئاتك حسنات","cause":"وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آَخَرَ","result":"فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ","explicit":true,"ref":"صحيح النسائي 4014","srcLabel":"متفق عليه","text":["أنَّ قومًا كانوا قتلوا فأكثروا ، وزنَوْا فأكثروا ، وانتهكوا ، فأتَوُا النَّبيَّ صلَّى اللهُ عليه وسلَّم ، قالوا : يا محمَّدُ ! إنَّ الَّذي تقولُ وتدعو إليه لحسنٌ ! لو تُخبِرُنا أنَّ لما عمِلنا كفَّارةً ؟ فأنزل اللهُ عزَّ وجلَّ  ",["وَالَّذِينَ لَا يَدْعُونَ مَعَ اللَّهِ إِلَهًا آَخَرَ",1],"  ، إلى :  ",["فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ",2],"  ، قال : يُبدِّلُ اللهُ شِركَهم إيمانًا ، وزناهم إحصانًا . ونزلت  قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ  . الآيةُ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح [لغيره]","takhrij":"أخرجه النسائي (4003) واللفظ له، ومسلم (122) بنحوه، وأصله عند البخاري (3855)","bab":"قرآن › أسباب النزول","dorar":"zT5O4Lxk"},{"id":"س-08124","fp":"203b0b8ebf8b","stateId":104,"easy":"إذا خرجت تائباً صادقاً ولو مت في الطريق ← تقبضك ملائكة الرحمة","cause":"إنَّه خرَجَ تائبًا","result":"فقَبَضَتْهُ ملائكةُ الرَّحمةِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[62],"ref":"السلسلة الصحيحة 2640","srcLabel":"متفق عليه","text":["إنَّ عبدًا قتَلَ تسعةً وتسعينَ نفْسًا، ثمَّ عَرَضَتْ له التَّوبةُ، فسأل عن أعلَمِ أهلِ الأرضِ، فدُلَّ على رجُلٍ -وفي روايةٍ: راهبٍ-، فأتاهُ، فقال: إنِّي قتلْتُ تسعةً وتسعينَ نفْسًا، فهل لي مِن توبةٍ؟ قال: بَعدَ قتْلِ تسعةٍ وتسعينَ نفْسًا؟! قال: فانتَضَى سيفَهُ فقَتَلَهُ به، فأكمَلَ به مِئةً، ثمَّ عَرَضَتْ له التَّوبةُ، فسأل عن أعلَمِ أهلِ الأرضِ، فدُلَّ على رجُلٍ [عالِمٍ]، فأتاهُ، فقال: إنِّي قتَلْتُ مِئةَ نفْسٍ، فهل لي مِن توبةٍ؟ فقال: ومَن يَحولُ بينَكَ وبينَ التَّوبةِ؟ اخرُجْ مِنَ القريةِ الخبيثةِ التي أنتَ فيها إلى القريةِ الصَّالحةِ؛ قريةِ كذا وكذا؛ [فإنَّ بها أُناسًا يَعْبُدونَ اللهَ]، فاعبُدْ ربَّكَ [معهم] فيها، [ولا تَرجِعْ إلى أرضِكَ؛ فإنَّها أرضُ سوءٍ]، قال: فخرَجَ إلى القريةِ الصَّالحةِ، فعرَضَ له أَجَلُهُ في [بعضِ] الطَّريقِ، [فناءَ بصَدْرِهِ نَحْوَها]، قال: فاختَصَمَتْ فيه ملائكةُ الرَّحمةِ وملائكةُ العذابِ، قال: فقال إبليسُ: أنا أَوْلَى بهِ؛ إنَّه لم يَعصِني ساعةً قَطُّ، قال: فقالتْ ملائكةُ الرَّحمةِ: ",["إنَّه خرَجَ تائبًا",1]," مُقْبِلًا بقلبِهِ إلى اللهِ، وقالتْ ملائكةُ العذابِ: إنَّه لم يعمَلْ خيرًا قَطُّ]، فبعَثَ اللهُ عزَّ وجلَّ مَلَكًا [في صورةِ آدَميٍّ]، فاختصَموا إليه، قال: فقال: انظُروا أيُّ القَرْيَتَيْنِ كانتْ أَقرَبَ إليه فأَلْحِقوهُ بأهلِها، [فأوحى اللهُ إلى هذهِ أنْ تَقَرَّبي، وأوحى إلى هذهِ أنْ تَباعَدي]، [فقاسوهُ، فوجدوهُ أدنَى إلى الأرضِ التي أرادَ [بشِبْرٍ]؛ ",["فقَبَضَتْهُ ملائكةُ الرَّحمةِ",2],"] [فغُفِرَ له]، قال الحَسَنُ: لمَّا عرَفَ الموتَ احتَفَزَ بنفْسِه، وفي روايةٍ: ناءَ بصَدْرِهِ؛ فقرَّبَ اللهُ عزَّ وجلَّ منه القريةَ الصَّالحةَ، وباعَدَ منه القريةَ الخبيثةَ؛ فألحَقوهُ بأهلِ القريةِ الصَّالحةِ."],"grade":"صحيح","narrator":"أبو سعيد الخدري","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه ابن ماجه (2622)، وأحمد (11154) باختلاف يسير، وأخرجه البخاري (3470) مختصراً بلفظ مقارب، ومسلم (2766) بلفظ مقارب","bab":"ملائكة › أعمال الملائكة","dorar":"j4qLNkrx","merged":8,"otherRefs":["تخريج المسند لشعيب 11687 (صحيح)","إتحاف الخيرة المهرة 7/411 (صحيح)","صحيح مسلم 2766 (صحيح)","صحيح الجامع 4459 (صحيح)","مجمع الزوائد 10/214 (صحيح)","الترغيب والترهيب 4/123 (صحيح)"]},{"id":"س-04014","fp":"9bf75098bbf2","stateId":104,"easy":"إذا تبت ← يتوب الله عليك","cause":"ومَن تابَ","result":"تابَ اللهُ عليهِ","explicit":true,"similar":["س-04013"],"ref":"المطالب العالية 4/61","srcLabel":"إسحاق","text":["عنِ ابنِ مسعودٍ رَضِيَ اللهُ عنه، قال: قتَلَ رجُلٌ تسعةً وتسعينَ نفْسًا، ثمَّ أراد التَّوبةَ؛ فأتى راهبًا بأرضٍ (عَرِيَّةٍ)، فقال: يا راهبُ، قتلْتُ تسعةً وتسعينَ نفْسًا، فهل لي مِن تَوبةٍ؟ قال: لا، قال: لا جَرَمَ، واللهِ لأُكْمِلَنَّهُم بكَ مِئةً، ثمَّ أتى راهبًا آخَرَ، قال: إنِّي قتلْتُ تسعةً وتسعينَ نفْسًا، وكمَّلْتُهم مِئةً براهبٍ، فهل مِن تَوبةٍ؟ فقال: لقدْ أسرَفْتَ على نفْسِكَ، وركِبْتَ عظيمًا، ",["ومَن تابَ",1]," ",["تابَ اللهُ عليهِ",2],"، قال: فنَبَذَ السَّيفَ، وقال: واللهِ، لَأَخْدُمَنَّكَ حتَّى يُفَرِّقَ بينَنا الموتُ، قال: وعاهَدَهُ ألَّا يَعصيَهُ، قال: فجاءَهُ قومٌ سَفْرٌ أوْ مُسْنِتونَ، وكان يتطَبَّبُ، فقال الرجُلُ: [هل] تأمُرُني بشيْءٍ؟ قال: اذهَبْ فاسجُرِ التَّنُّورَ، قال: فذهَبَ فسَجَرَهُ حتَّى حَمِيَ، فقال: قد حَمِيَ، فما تأمُرُني؟ قال: اذهَبْ فقَعْ فيه، قال: فذهَبَ فوقَعَ فيه، ثمَّ اذَّكَّرَ الرَّاهبُ، فقام وقام مَن معه، فإذا هو في التَّنُّورِ يَرْشَحُ عَرَقًا لم تَضُرَّهُ النَّارُ، فقال الرَّاهبُ: قد علِمْتُ أنَّ تَوبَتَكَ قد قُبِلَتْ، فلَأَخْدُمَنَّكَ أبدًا حتَّى تُفارِقَني، قال ابنُ مسعودٍ رَضِيَ اللهُ عنه: وكانوا بَنو إسرائيلَ إذا أذنَبَ أحدُهم أصبَحَ وقد كُتِبَ كَفَّارةُ ذنبِهِ على أُسْكُفَّةِ بابِهِ، ففَضَّلَكُمُ اللهُ عليهم، فأُمِرْتم بالاستِغفارِ، فتستغفِرونَ اللهَ تعالى، قال: ولقد أعطى هذهِ الأُمَّةَ آيةً ما أُحِبُّ أنَّ لهم بها الدُّنيا وما فيها: {وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ} [آل عمران: 135]."],"grade":"صحيح","narrator":"شقيق بن سلمة","muhaddith":"إسناده صحيح","takhrij":"أخرجه إسحاق بن راهويه كما في ((المطالب العالية)) لابن حجر (3465) بلفظه.","bab":"توبة › الحض على التوبة","dorar":"kO1LMXZ0","merged":23,"otherRefs":["مصباح الزجاجة 4/244 (صحيح)","المستدرك على الصحيحين 7862 (صحيح)","سنن الترمذي 3793 (صحيح)","مجمع الزوائد 7/144 (حسن)","صحيح البخاري 6439 (صحيح)","صحيح الموارد 2105 (صحيح)","الصحيح المسند 345 (صحيح)","صحيح البخاري 6437 (صحيح)","تخريج الإحياء للعراقي 3/293 (صحيح)","صحيح مسلم 1049 (صحيح)","تخريج المسند لشعيب 9007 (صحيح)","السلسلة الصحيحة 2910 (صحيح)","صحيح البخاري 6438 (صحيح)","تخريج المسند لشعيب 13587 (صحيح)","السلسلة الصحيحة 1639 (صحيح)","المستدرك على الصحيحين 2929 (صحيح)","تخريج المسند لشعيب 21111 (صحيح)","صحيح مسلم 1048 (صحيح)","تخريج المسند لشعيب 13873 (صحيح)","السلسلة الصحيحة 2907 (صحيح)","تخريج المسند لشعيب 24276 (صحيح)","تخريج مشكل الآثار 5/ 277 (صحيح)"]},{"id":"ق-0883","fp":"1e5a4240a83a","stateId":104,"easy":"التوبة والإيمان والعمل الصالح ← تبديل السيئات حسنات","cause":"التوبة والإيمان والعمل الصالح","result":"تبديل السيئات حسنات","explicit":true,"ref":"سورة الفرقان: 70","srcLabel":"القرآن الكريم","quran":{"s":25,"from":70,"to":70,"text":"إِلَّا مَنْ تَابَ وَآمَنَ وَعَمِلَ عَمَلًا صَالِحًا فَأُولَئِكَ يُبَدِّلُ اللَّهُ سَيِّئَاتِهِمْ حَسَنَاتٍ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا (70)","hl":[[0,52,1],[52,106,2],[106,140,1]]}},{"id":"ق-0899","fp":"e4b8cdae99ae","stateId":104,"easy":"تبديل الحسن بعد السوء (التوبة) ← مغفرة الله ورحمته","cause":"تبديل الحسن بعد السوء (التوبة)","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة النمل: 11","srcLabel":"القرآن الكريم","quran":{"s":27,"from":11,"to":11,"text":"إِلَّا مَنْ ظَلَمَ ثُمَّ بَدَّلَ حُسْنًا بَعْدَ سُوءٍ فَإِنِّي غَفُورٌ رَحِيمٌ (11)","hl":[[0,54,1],[54,78,2]]}},{"id":"ق-1094","fp":"6fecfdd65bb9","stateId":104,"easy":"ترك القنوط والإنابة إلى الله والإسلام له ← مغفرة الذنوب جميعاً","cause":"ترك القنوط والإنابة إلى الله والإسلام له","result":"مغفرة الذنوب جميعاً","explicit":true,"ref":"سورة الزمر: 53–54","srcLabel":"القرآن الكريم","quran":{"s":39,"from":53,"to":54,"text":"قُلْ يَا عِبَادِيَ الَّذِينَ أَسْرَفُوا عَلَى أَنْفُسِهِمْ لَا تَقْنَطُوا مِنْ رَحْمَةِ اللَّهِ إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ (53) وَأَنِيبُوا إِلَى رَبِّكُمْ وَأَسْلِمُوا لَهُ مِنْ قَبْلِ أَنْ يَأْتِيَكُمُ الْعَذَابُ ثُمَّ لَا تُنْصَرُونَ (54)","hl":[[0,96,1],[96,138,2],[138,287,1]]}},{"id":"س-03959","fp":"dce713f57a2a","stateId":104,"easy":"إذا أخطأت حتى بلغت خطاياك السماء ثم تبت ← يتوب الله عليك","cause":"لَوْ أَخْطَأْتُمْ حتى تَبْلُغَ السَّماءَ ، ثُمَّ تُبْتُمْ","result":"لتابَ اللهُ عليكُمْ","explicit":true,"ref":"صحيح الترغيب 3138","srcLabel":"ابن ماجه","text":[["لَوْ أَخْطَأْتُمْ حتى تَبْلُغَ السَّماءَ ، ثُمَّ تُبْتُمْ",1]," ، ",["لتابَ اللهُ عليكُمْ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"حسن صحيح","takhrij":"أخرجه ابن ماجه (4248) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"4LQ0utTl"},{"id":"س-04013","fp":"613ee906a330","stateId":104,"easy":"إذا تبت ← فعسى الله أن يتوب عليك","cause":"كلُّ تائبٍ","result":"عسى اللهُ أنْ يتوبَ عليه","explicit":true,"repOf":"س-04014","ref":"تفسير الطبري 3/2/377","text":[["كلُّ تائبٍ",1]," ",["عسى اللهُ أنْ يتوبَ عليه",2],"."],"grade":"صحيح","muhaddith":"ثابت","bab":"توبة › الحض على التوبة","dorar":"KJSNQbNt"},{"id":"س-04025","fp":"eeb60306ed32","stateId":104,"easy":"إذا تبت توبة صادقة ← تسع توبتك ولو قُسمت على سبعين","cause":"لقد تابت توبةً","result":"لو قُسِمت توبتُها بينَ سبعينَ رجلًا مِن أهلِ المدينةِ لوسِعتْهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04600"],"otherNeedIds":[51],"ref":"تخريج صحيح ابن حبان 4442","srcLabel":"ابن حبان","text":["جاءتِ امرأةٌ إلى نبيِّ اللهِ صلَّى اللهُ عليه وسلَّم فقالت: قد أحدَثْتُ، وهي حُبْلى، فأمَرها نبيُّ اللهِ صلَّى اللهُ عليه وسلَّم أنْ تذهَبَ حتَّى تضَعَ ما في بطنِها فلمَّا وضَعتْ جاءت فأمَرها أنْ تذهَبَ فتُرضِعَه حتَّى تفطِمَه ففعَلتْ ثمَّ جاءت فأمَرها أنْ تدفَعَ ولدَها إلى أُناسٍ ففعَلتْ ثمَّ جاءت فسأَلها: ( إلى مَن دفَعْتِ ) فأخبَرتْ أنَّها دفَعتْه إلى فلانٍ فأمَرها أنْ تأخُذَه وتدفَعَه إلى آلِ فلانٍ ناسٍ مِن الأنصارِ ثمَّ إنَّها جاءت فأمَرها أنْ تشُدَّ عليها ثيابَها ثمَّ إنَّه أمَر بها فرُجِمتْ ثمَّ إنَّه كفَّنها وصلَّى عليها ثمَّ دفَنها فقال النَّاسُ: رجَمها ثمَّ كفَّنها وصلَّى عليها ثمَّ دفَنها ! فبلغ النَّبيَّ صلَّى اللهُ عليه وسلَّم ما يقولُ النَّاسُ فقال: ( ",["لقد تابت توبةً",1]," ",["لو قُسِمت توبتُها بينَ سبعينَ رجلًا مِن أهلِ المدينةِ لوسِعتْهم",2]," )"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"صحيح","takhrij":"لم أقف عليه إلا عند ابن حبان في الصحيح","bab":"توبة › تبشير التائب بالغفران","dorar":"HfbYLa85","merged":6,"otherRefs":["الاستذكار 6/478 (صحيح)","سفر السعادة 140 (صحيح)","تخريج مشكل الآثار 428 (صحيح)","تخريج صحيح ابن حبان 4403 (صحيح)","تهذيب التهذيب 12/249 (صحيح)"]},{"id":"س-03312","fp":"52e93e7e8135","stateId":104,"easy":"إذا فعلت الخيرات وتركت السيئات بعد ذنوب كثيرة ← يبدّلها الله لك حسنات","cause":"تَفعلُ الخيراتِ وتترُكَ السَّيِّئاتِ","result":"فيَّجعلُهنَّ اللَّهُ لَكَ حسَناتٍ كُلَّهُنَّ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"الأمالي المطلقة 144","srcLabel":"الطبراني","text":["عَن أبي طويلٍ شَطَبٍ المَمدودِ رضيَ اللَّهُ تعالى عنهُ أنَّهُ أتى النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ أرأيتَ رجلًا عملَ الذُّنوبَ كلَّها فلم يترُكْ منها شيئًا وَهوَ مع ذلِكَ لم يترُكْ حاجَّةً ولا داجَّةً إلَّا أتاها فَهَل لذلِكَ من توبةٍ قالَ أليسَ قد أسلَمتَ قالَ أمَّا أَنا فأشهَدُ أن لا إلَهَ إلَّا اللَّهَ وحدَهُ لا شريكَ لَهُ وأنَّ محمَّدًا رسولُ اللَّهِ قالَ نعَم ",["تَفعلُ الخيراتِ وتترُكَ السَّيِّئاتِ",1]," ",["فيَّجعلُهنَّ اللَّهُ لَكَ حسَناتٍ كُلَّهُنَّ",2]," قالَ وغدَراتي وفجَراتي قالَ نعَم قالَ اللَّهُ أَكْبرُ فما زالَ يُكَبِّرُ حتَّى توارَى"],"grade":"صحيح","narrator":"شطب الممدود أبو الطويل","muhaddith":"حسن صحيح غريب","takhrij":"أخرجه ابن أبي عاصم في ((الآحاد والمثاني)) (2718)، والبغوي في ((معجم الصحابة)) (1713)، والطبراني (7/ 314) (7235) جميعهم بلفظه.","bab":"استغفار › أسباب المغفرة","dorar":"dMjqqfMG"},{"id":"س-03952","fp":"fb5b56b059e1","stateId":104,"easy":"إذا اعترفت بذنبك وفعلت ما أُمرت ← يغفر الله لك (من قصة بني إسرائيل)","cause":"فاعتَرَفوا بها، وفعَلوا ما أُمِروا","result":"وغفَرَ اللهُ للقاتِلِ والمقتولِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"إتحاف الخيرة المهرة 6/234","srcLabel":"النسائي","text":["سألْتُ عبدَ اللهِ بنَ عبَّاسٍ رضِيَ اللهُ عنهما عن قولِ اللهِ عَزَّ وجَلَّ لموسى صَلَّى اللهُ عليه وسلَّمَ: {وَفَتَنَّاكَ فُتُونًا} [طه: 40]، فسألْتُه عن الفُتونِ؟ فقال: استأنِفِ النَّهارَ يا ابنَ جُبيرٍ؛ فإنَّ لها حديثًا طويلًا.\nقال: فغدوْتُ على ابنِ عبَّاسٍ لأنتجِزَ ما وَعَدني مِن حديثِ الفُتونِ، فقال: تذاكَرَ فِرعونُ وجُلساؤُه ما كان اللهُ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ مِن أنْ يجعَلَ في ذُرِّيتَه أنبياءَ ومُلوكًا؛ فقال بعضُهم: إنَّ بني إسرائيلَ لينتظِرونَ ذلك ما يشُكُّون فيه، وقد كانوا يظنُّونَ أنَّه يُوسفُ بنُ يعقوبَ عليهما الصَّلاةُ والسَّلامُ، فلمَّا هلَكَ قالوا: ليس هكذا كان، إنَّ اللهَ عَزَّ وجَلَّ وعَدَ إبراهيمَ صَلَّى اللهُ عليه وسلَّمَ. قال فِرعونُ: فكيف تَرَونَ؟ فائْتَمَروا، واجتمَعوا أمْرَهم على أنْ يبعَثَ رِجالًا بالشِّفارِ، يَطُوفون في بني إسرائيلَ، فلا يَجِدون مولودًا ذكَرًا إلَّا ذَبَحوه، ففَعَلوا ذلك، فلمَّا أنْ رَأَوا أنَّ الكبارَ في بني إسرائيلَ يموتونَ بآجالِهم، والصِّغارَ يُذْبَحونَ، قالوا: أتوشِكونَ أنْ تُفْنوا بني إسرائيلَ، فتَصيروا إلى أنْ تُباشِروا مِن الأعمالِ والخدمةِ الَّتي كانوا يَكْفُونكم؟ فاقْتُلوا عامًا كلَّ مولودٍ ذكرٍ، فيقِلَّ نَباتُهم، ودَعُوا عامًا، فلا تَقْتلوا منهم أحدًا، فيشِبَّ الصِّغارُ مكانَ مَن يموتُ مِن الكبارِ، فإنَّهم لنْ يَكْثروا بمَن تَسْتحيون، فتخافوا مُكاثرتَهم إياكم، ولنْ يَفْنَوا بمَن تقتُلونَ، فتحتاجونَ إليهم، فأجْمَعوا أمْرَهم على ذلك، فحمَلَت أُمُّ موسى بهارونَ عليهما السَّلامُ العامَ الَّذي لا يُذْبَحُ فيه الغِلمانُ، فولدَتْه عَلانيةً، فلمَّا كان مِن قابلٍ حمَلَتْ بمُوسى عليه السَّلامُ، فوقَعَ في قلْبِها مِن الهَمِّ والحزنِ. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ، ما دخَلَ عليه في دهو بَطْنِ أُمِّه ممَّا يُرادُ به، فأوحَى اللهُ تعالى إليها: {وَلَا تَخَافِي وَلَا تَحْزَنِي إِنَّا رَادُّوهُ إِلَيْكِ وَجَاعِلُوهُ مِنَ الْمُرْسَلِينَ} [القصص: 7]، وأمَرَها أنْ إذا ولَدَتْ أنْ تجعَلَه في تابوتٍ، ثمَّ تُلْقِيه في اليمِّ، فلمَّا ولَدَت فعَلَت ذلك به، فألْقَته في اليمِّ، فلمَّا توارى عنها ابنُها أتاها الشَّيطانُ، فقالت في نفْسِها: ما فعَلْتُ بابني؟! لو ذُبِحَ لبِثَ عندي فرأيْتُه وكفَّنْتُه، كان أحَبَّ إليَّ مِن أنْ أُلْقِيَه بيدي إلى دوابِّ البحرِ وحِيتانِه، وانتهى الماءُ به حتَّى أرفَأَ به عند فُرْضَةُ مُسْتَقى جواري امرأةِ فِرعونَ، فلمَّا رأيْنَه أخذْنَه، فهمَمْنَ أنْ يفتحْنَ التَّابوتَ، فقالت بعضُهنَّ: إنَّ في هذا مالًا، وإنَّا إنْ فتحْناه لم تُصدِّقْنا امرأةُ الملِكِ بما وجَدْنا فيه، فحمَلْنَه بهيئةٍ لم يُحرِّكْنَ منه شيئًا، دفعْنَه إليها، فلمَّا فتحَتْه رأتْ فيه غُلامًا، فأُلْقِيَ عليه منها محبَّةٌ لم تُلْقَ مثْلُها على البشَرِ قطُّ، وأصبَحَ فُؤَادُ أُمِّ موسى فارغًا مِن ذِكْرِ كلِّ شَيءٍ إلَّا مِن ذِكْرِ مُوسى عليه السَّلامُ، فلمَّا سمِعَ الذَّابِحونَ بأمْرِه أقبلوا بشِفارِهم إلى امرأةِ فرعونَ ليذبَحُوه -وذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت للذَّبَّاحينَ: أقِرُّوه؛ فإنَّ هذا الواحدَ لا يَزيدُ في بني إسرائيلَ حتَّى آتِيَ فِرعونَ فأسْتَوْهِبَه منه، فإنْ وهَبَه لي كنْتُم قد أحسنْتُم وأجمَلْتُم، وإنْ أمَرَ بذبْحِه لم أَلُمْكم، فأتَتْ به فرعونَ، فقالت: قُرَّةُ عينٍ لي ولك، قال فِرعونُ: يكونُ لك، فأمَّا لي فلا حاجةَ لي في ذلك. قال رسولُ اللهِ صَلَّى اللهُ عليه وسلَّمَ: والَّذي أحلِفُ به، لو أقَرَّ فِرعونُ بأنْ يكونَ له قُرَّةَ عينٍ كما أقَرَّت امرأتُه، لهداهُ اللهُ به كما هدى به امرأتَه، ولكنَّ اللهَ حرَمَه ذلك.\nفأرسَلَتْ إلى مَن حولَها، مِن كلِّ امرأةٍ لها لبنٌ، تختارُ لها ظِئرًا، فجعَلَ كلَّما أخذَتْه امرأةٌ منهنَّ، فترُضِعُه، لم يَقْبَلْ ثَدْيَها، حتَّى أشفَقَت عليه امرأةُ فِرعونَ أنْ يَمتنِعَ مِن اللَّبنِ فيموتَ، فأحْزَنَها ذلك، فأمرَتْ به، فأُخْرِجَ إلى السُّوقِ وتجمَّعَ النَّاسُ، تَرْجو أنْ تجِدَ له ظِئرًا يأخُذُ منها، فلم يَقْبَلْ، وأصبَحَتْ أُمُّ موسى والهةً، فقالت لأُخْتِه: قُصِّيه -يعني: أثَرَهُ- واطْلُبِيه، هل تسمعينَ له ذِكْرًا؟ أحيٌّ ابْني أمْ قد أكلَتْه الدَّوابُّ؟ ونسِيَت ما كان اللهُ عَزَّ وجَلَّ وعَدَها فيه، فبَصُرتْ به أختُه عن جُنُبٍ وهم لا يَشعُرونَ، والجُنُبُ: أنْ يبصِرَ الإنسانُ إلى الشَّيءِ البعيدِ وهو إلى جَنْبِه لا يشعُرُ به، فقالت مِن الفرحِ حين أعياهم الظُّؤارتُ: أنا {أَدُلُّكُمْ عَلَى أَهْلِ بَيْتٍ يَكْفُلُونَهُ لَكُمْ وَهُمْ لَهُ نَاصِحُونَ} [القصص: 12]، فأخَذُوها فقالوا: ما يُدريك ما نُصْحُهم له؟ هل يعرِفونَه؟ حتَّى شكُّوا في ذلك -فذلك مِن الفُتونِ يا ابنَ جُبيرٍ- فقالت: نصيحَتُهم له وشفقَتُهم عليه رغبةً في صِهر الـمَلِك، ورجاءَ مَنفعتِه، فأرْسَلوها، فانطلَقَتْ إلى أُمِّها فأخبرتْها الخبرَ، فجاءتْ أُمُّه، فلمَّا وضعَتْه في حِجْرِها، نزَا إلى ثَدْيِها، فمَصَّه حتَّى امتلَأَ جَنباهُ رِيًّا، وانطلَقَ البشيرُ إلى امرأةِ فرعونَ: أنْ قد وجَدْنا لابْنِك، فأرسَلَتْ إليها، فأُوتِيتْ بها وبه، فلمَّا رأت ما يصنَعُ، قالت لها: امْكُثي عندي؛ تُرْضِعي ابني هذا، فإنِّي لم أحجِبْه شيئًا قطُّ، فقالت أُمُّ مُوسى: لا أستطيعُ أنْ أدَعَ بيتي وولدي، فيَضيعَ، فإنْ طابتْ نفْسُك أنْ تُعْطِيَنه، فأذهَبَ به إلى مَنْزلي، فيكونَ معي لا آلوهُ خيرًا، فعلْتُ، وإلَّا فإنِّي غيرُ تاركةٍ بيتي وولدي، وذكَرَت أُمُّ مُوسى عليه السَّلامُ ما كان اللهُ عَزَّ وجَلَّ وعَدَها، فتعاسَرَت على امرأةِ فرعونَ، وأيقنَتْ بأنَّ اللهَ عَزَّ وجَلَّ يُنْجِزُ موعودَه، فرجَعَتْ إلى بيتِها بابنِها مِن يومِها، فأنبَتَه اللهُ نباتًا حسنًا، وحفِظَه لِمَا قد قَضى فيه، فلم يزَلْ بنو إسرائيلَ وهم في ناحيةِ القريةِ مُمْتنعينَ يَمْتنعونَ به مِن السُّخرةِ ما كان فيهم.\nفلمَّا تَرعرَعَ قالت امرأةُ فرعونَ لأُمِّ مُوسى: أريدُ أنْ تُرِيني ابني، فوعَدَتْها يومًا تُرِيها فيه إيَّاه، فقالتِ امرأةُ فِرعونَ لخُزَّانِها، وظُؤورتِها، وقَهارِمَتِها: لا يَبْقينَّ أحدٌ منكم إلَّا استقبَلَ ابني اليومَ بهَديَّةٍ وكَرامةٍ؛ لِأَرى ذلك فيه، وأنا باعثةٌ أمينًا يُحْصِي ما يصنَعُ كلُّ إنسانٍ منكم، فلم تَزَلِ الهدايا والكرامةُ والنِّحلةُ، تَستقبِلُه مِن حينِ خرَجَ مِن بيتِ أُمِّه إلى أنْ دخَلَ على امرأةِ فرعونَ، فلمَّا دخَلَ عليها بجَّلَتْه، وأكرمَتْه، وفرِحَت به، وأعجَبَها، ونحَلَت أُمَّه؛ لحُسْنِ أثَرِه، ثمَّ قالت: لآتيَنَّ به فِرعونَ، فليَنْحَلَنَّه، وليُكْرِمَنَّه، فلمَّا دخَلَتْ به عليه، جعَلَه في حِجْرِه، فتناوَلَ مُوسى لِحيةَ فرعونَ، فمَدَّها إلى الأرضِ، فقال الغواةُ مِن أعداءِ اللهِ لفرعونَ: ألَا ترى إلى ما وعَدَ اللهُ عَزَّ وجَلَّ إبراهيمَ نَبِيَّه عليه السَّلامُ أنَّه يرِثُك، ويَعْلوك، ويصرَعُك، فأرسَلَ إلى الذَّبَّاحينَ، وذلك مِن الفُتونِ يا ابنَ جُبيرٍ، بعدَ كلِّ بلاءٍ ابتُلِيَ به، أو أُرِيدَ به فُتونًا.\nفجاءت امرأةُ فِرعونَ تَسْعى إلى فرعونَ، فقالت: ما بدا لك في هذا الغلامِ الَّذي وهَبْتَه لي؟ قال: ألَا تَرَيْنَه يزعُمُ أنَّه يصرَعُني ويَعْلوني؟ قالت: اجْعَلْ بيني وبينك أمرًا تعرِفُ فيه الحقَّ؛ ائْتِ بجَمْرتينِ ولُؤلؤتَينِ، فقَرِّبْهما إليه، فإنْ بطَش باللُّؤلؤتَينِ واجتنَبَ الجَمْرتينِ، عرَفْتَ أنَّه يعقِلُ، وإنْ تَناوَلَ الجَمْرتَينِ ولم يُرِدِ اللُّؤلؤتَينِ، علِمْتَ أنَّ أحدًا لا يُؤثِرُ الجَمرتينِ على اللُّؤلؤتينَ وهو يعقِلُ، فقُرِّبَ ذلك إليه، فتناوَلَ الجَمرتَينِ، فانْتَزَعوهما مِن يَدِه، وخافت أنْ يحرِقَا يدَيْه، فقالت المرأةُ: ألَا ترى؟! فصرَفَه اللهُ عنه بعدما كان قد هَمَّ به، وكان الله عَزَّ وجَلَّ بالغًا فيه أمْرَه.\nفلمَّا بلَغَ أشُدَّه وصار مِن الرِّجالِ، لم يكُنْ أحدٌ مِن آلِ فِرعونَ يخلُصُ إلى أحدٍ مِن بني إسرائيلَ معه بظُلمٍ، ولا يخرُجُ حتَّى امْتَنعوا كلَّ الامتناعِ.\nفبينما مُوسى عليه السَّلامُ يَمْشي في ناحيةِ المدينةِ، إذ هو برجُلينِ يَقْتتلانِ؛ أحدُهما فرعونيٌّ، والآخرُ إسرائيليٌّ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فغضِبَ مُوسى عليه السَّلامُ غضبًا شديدًا؛ لأنَّه تناوَلَ وهو يعلَمُ منزلةَ مُوسى عليه السَّلامُ مِن بَني إسرائيلَ، وحِفْظَه لهم، لا يعلَمُ النَّاسُ إلَّا إنَّما ذلك مِن الرَّضاعِ إلَّا أُمُّ مُوسى، إلَّا أنْ يكونَ اللهُ عَزَّ وجَلَّ أَطْلَعَ مُوسى عليه السَّلامُ مِن ذلك على ما لم يُطْلِعْ عليه غيرَه. فوكَزَ مُوسى عليه السَّلامُ الفرعونيَّ، فقتَلَه، وليس يراهما أحدٌ إلَّا اللهُ عَزَّ وجَلَّ، فقال مُوسى عليه السَّلامُ حين قتَلَ الرَّجلَ: هذا مِن عمَلِ الشَّيطانِ؛ إنَّه عدُوٌّ مُضِلٌّ مُبينٌ، ثمَّ قال: {رَبِّ إِنِّي ظَلَمْتُ}، إلى قولِه: {إِنَّهُ هُوَ الْغَفُورُ الرَّحِيمُ} [القصص: 16].\n{فَأَصْبَحَ فِي الْمَدِينَةِ خَائِفًا يَتَرَقَّبُ} [القصص: 18] الأخبارَ، فأُتِيَ فِرعونُ فقيلَ: إنَّ بني إسرائيلَ قد قتَلَتْ رجُلًا مِن آلِ فرعونَ، فخُذْ لنا بحَقِّنا، ولا تُرخِّصْ لهم، فقال: ابْغُوني قاتِلَه ومَن شهِدَ عليه؛ فإنَّ الملِكَ وإنْ كان صَفْوُه مع قومِه، لا يستقيمُ له أنْ يُقِيدَ بغيرِ بيِّنةٍ، ولا ثَبَتٍ، فانْظُروا في عِلْمِ ذلك آخُذْ لكم بحَقِّكم، فبينا هم يَطوفونَ لا يَجِدونَ شيئًا، إذا موسى عليه السَّلامُ قد رأى في الغدِ ذلك الإسرائيليَّ يقتُلُ رجُلًا مِن آلِ فرعونَ آخرَ، فاستغاثَه الإسرائيليُّ على الفرعونيِّ، فصادَفَ مُوسى عليه السَّلامُ قد ندِمَ على ما كان منه، فكَرِهَ الَّذي رأى، فغضِبَ الإسرائيليُّ وهو يُريدُ أنْ يبطِشَ بالفرعونيِّ، فقال للإسرائيليِّ -لِمَا فعَلَ أمسِ واليومَ-: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} [القصص: 18]. فنظَرَ الإسرائيليُّ إلى مُوسى عليه السَّلامُ بعدما قال له ما قال، فإذا هو غضبانُ كغضَبِه بالأمسِ الَّذي قتَلَ به الفرعونيَّ، فخاف أنْ يكونَ بعدما قال له: {إِنَّكَ لَغَوِيٌّ مُبِينٌ} إيَّاه أراد، ولم يكُنْ أراده، إنَّما أراد الفرعونيَّ، فخاف الإسرائيليُّ، فحاجَزَ الفرعونيَّ، فقال: {يَا مُوسَى أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]؟ وإنَّما قال ذلك؛ مخافةَ أنْ يكون إيَّاهُ أراد مُوسى عليه السَّلامُ أنْ يقتُلَه، فتنازَعَا. فانطلَقَ الفرعونيُّ إلى قومِه، فأخبَرَهم بما سمِعَ مِن الإسرائيليِّ مِن الخبرِ حين يقولُ: {أَتُرِيدُ أَنْ تَقْتُلَنِي كَمَا قَتَلْتَ نَفْسًا بِالْأَمْسِ} [القصص: 19]، فأرسَلَ فرعونُ الذَّبَّاحينَ ليقتُلوا موسى عليه السَّلامُ، فأخَذَ رُسلُ فرعونَ الطَّريقَ الأعظمَ يَمْشون على هَيئتِهم يطلُبونَ مُوسى عليه السَّلامُ، وهم لا يخافونَ أنْ يفوتَهم، فجاء رجُلٌ مِن شِيعَةِ مُوسى عليه السَّلامُ مِن أَقْصى المدينةِ، فاختصَرَ طريقًا قريبًا حتَّى سبَقَهم إلى موسى عليه السَّلامُ فأخْبَرَه. فذلك مِن الفُتونِ يا ابنَ جُبيرٍ.\nفخرَجَ مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ مدينَ لم يلْقَ بلاءً قبلَ ذلك، وليس له علمٌ بالطَّريقِ إلَّا حُسْنَ الظَّنِّ بربِّه عَزَّ وجَلَّ، فإنَّه قال: {عَسَى رَبِّي أَنْ يَهْدِيَنِي سَوَاءَ السَّبِيلِ} [القصص: 22].\n{وَلَمَّا وَرَدَ مَاءَ مَدْيَنَ وَجَدَ عَلَيْهِ أُمَّةً مِنَ النَّاسِ يَسْقُونَ} إلى {تَذُودَانِ} [القصص: 23]، يعني بذلك: حابستَينِ غنَمَهما، فقال لهما: ما خطْبُكما مُعتزلتَينِ لا تَسْقيانِ مع النَّاسِ؟ قالتا: ليس لنا قُوَّةٌ نُزاحِمُ القومَ، وإنَّما ننتظِرُ فُضولَ حياضِهم، فسقى لهما، فجعَلَ يغرِفُ بالدَّلْوِ ماءً كثيرًا، حتَّى كانتا أوَّلَ الرِّعاءِ فراغًا، فانصرَفَتا بغنَمِهما إلى أبيهما، وانصرَفَ موسى عليه السَّلامُ، فاستظَلَّ بشجرةٍ، وقال: {رَبِّ إِنِّي لِمَا أَنْزَلْتَ إِلَيَّ مِنْ خَيْرٍ فَقِيرٌ} [القصص: 24]، فاستنكَرَ أبوهما سُرعةَ صُدورِهما بغنَمِهما حُفَّلًا بطانًا، فقال: إنَّ لكما اليومَ لشأنًا، فأخبَرَتَاه بما صنَعَ موسى عليه السَّلامُ، فأمَرَ إحداهما أنْ تَدْعُوَه له، فأتَتْ موسى عليه السَّلامُ فدَعَتْه، فلمَّا كلَّمَه قال: {لَا تَخَفْ نَجَوْتَ مِنَ الْقَوْمِ الظَّالِمِينَ} [القصص: 25]، ليس لفِرعونَ ولا لقومِه علينا سُلطانٌ، ولسْنا في مَمْلكتِه.\nقال: فقالت إحداهما: {يَا أَبَتِ اسْتَأْجِرْهُ إِنَّ خَيْرَ مَنِ اسْتَأْجَرْتَ الْقَوِيُّ الْأَمِينُ} [القصص: 26]، فاحتمَلَتْه الغَيرةُ على أنْ قال: وما يُدريكِ ما قُوَّتُه؟ وما أمانَتُه؟ قالت: أمَّا قُوَّتُه: فما رأيْتُ في الدَّلوِ حين سَقى لنا، لم أرَ رجُلًا قطُّ في ذلك المَسْقى أقوى منه، وأمَّا أمانَتُه: فإنَّه نظَرَ إليَّ حين أقبلْتُ إليه وشَخَصْتُ له، فلمَّا علِمَ إنِّي امرأةٌ، صوَّبَ رأْسَه لم يرفَعْه، ولم ينظُرْ إليَّ حتَّى بلَّغْتُه رِسالتَك، ثمَّ قال لي: امشِي خلفي، وانْعَتي لي الطَّريقَ، لم يفعَلْ هذا إلَّا وهو أمينٌ، فسُرِّيَ عن أبيها وصدَّقَها، وظَنَّ به الَّذي قالت له.\nفقال له: هل لك {أَنْ أُنْكِحَكَ إِحْدَى ابْنَتَيَّ هَاتَيْنِ}، إلى قوله: {مِنَ الصَّالِحِينَ} [القصص: 27]، ففعَلَ، فكانت على نَبِيِّ اللهِ موسى عليه السَّلامُ ثمانيَ سنينَ واجبةً، وكانت سنتانِ عِدَةً منه، فقَضَى اللهُ عَزَّ وجَلَّ عنه عِدَتَه فأتمَّها عشْرًا.\nقال سَعيدٌ: فلَقِيَني رجُلٌ مِن أهلِ النَّصرانيَّةِ مِن عُلمائِهم، فقال: هلْ تَدْري أيَّ الأجلينِ قضى مُوسى عليه السَّلامُ؟ قلْتُ: لا، وأنا يومئذٍ لا أدري، فلقِيتُ ابنَ عبَّاسٍ، فذكَرْتُ ذلك له، فقال: أمَا علِمْتَ أنَّ ثمانيًا كانت على نبيِّ اللهِ عليه السَّلامُ واجبةً، لم يكُنْ نبيُّ اللهِ ليَنْقُصَ منها شيئًا، وتعلَمُ أنَّ اللهَ عَزَّ وجَلَّ كان قاضيًا عن مُوسى عليه السَّلامُ عِدَتَه الَّتي وعَدَ، فإنَّه قضى عشْرَ سنينَ. فلقِيتُ النَّصرانيَّ، فأخبَرْتُه بذلك، فقال: الَّذي سألْتَه فأخبَرَك أعلَمُ منك بذلك؟ قلْتُ: أجلْ، وأَولى.\nفلمَّا سار مُوسى عليه السَّلامُ بأهلِه كان مِن أمْرِ النَّارِ ما قَصَّ اللهُ عليك في القُرآنِ، وأمْرِ العصا ويَدِه، فشكا إلى ربِّه عَزَّ وجَلَّ ما يتخوَّفُ مِن آلِ فرعونَ في القتيلِ، وعُقدةَ لسانِه، فآتاهُ اللهُ عَزَّ وجَلَّ سُؤْلَه، وحَلَّ عُقدةً مِن لسانِه، وأوحى اللهُ عَزَّ وجَلَّ إلى هارونَ عليه السَّلامُ، وأمَرَه أنْ يلقاهُ، واندفَعَ مُوسى عليه السَّلامُ بعصاهُ، حتَّى لقِيَ هارونَ عليه السَّلامُ، وانطلَقَا جميعًا إلى فرعونَ، فأقاما حِينًا على بابِه لا يُؤْذَنُ لهما، فقالا: إنَّا رسولَا ربِّك، قال: فمَن ربُّكما يا موسى؟ فأخبراهُ بالَّذي قَصَّ اللهُ عَزَّ وجَلَّ عليك في القُرآنِ، قال: فما تُريدانِ؟ وذكَّرَه القتيلَ، واعتذَرَ بما قد سمِعْتَ، وقال: أريدُ أنْ تُؤمِنَ باللهِ، وأنْ تُرْسِلَ معي بني إسرائيلَ، فأبى عليه، وقال: ائتِ بآيةٍ إنْ كنْتَ مِن الصَّادقينَ، فألقى عصاه فإذا هي حيَّةٌ عظيمةٌ، فازعةٌ، فاغرةٌ فاها، مُسرعةٌ إلى فرعونَ، فلمَّا رآها فِرعونُ قاصدةً إليه خافها، فاقتحَمَ عن سَريرِه، واستغاثَ بمُوسى عليه السَّلامُ أنْ يكُفَّها عنه، ففعَلَ، ثمَّ أخرَجَ يَدَه مِن جَيْبِه، فرآها بيضاءَ مِن غيرِ سُوءٍ، يعني: مِن غيرِ برَصٍ، فرَدَّها، فعادت إلى لونِها الأوَّلِ.\nفاستشارَ الملَأَ حولَه فيما رأى، فقالوا له: {هَذَانِ لَسَاحِرَانِ يُرِيدَانِ أَنْ يُخْرِجَاكُمْ مِنْ أَرْضِكُمْ} [طه: 63] الآيةَ، والمُثْلى: مُلْكُهم الَّذي هم فيه والعيشُ. فأَبَوا على مُوسى عليه السَّلامُ أنْ يُعْطُوه شيئًا ممَّا طلَبَ، وقالوا له: اجمَعْ لهما السَّحرةَ؛ فإنَّهم بأرضِك كثيرٌ، حتَّى نغلِبَ سِحْرَهما، وأرسَلَ في المدائنِ، فحُشِرَ له كلُّ ساحرٍ مُتعالمٍ، فلمَّا أَتَوا على فرعونَ، قالوا: ما يعمَلُ هذا السَّاحرُ؟ قالوا: يعمَلُ الحيَّاتِ، قالوا: فلا واللهِ ما أحدٌ في الأرضِ يعمَلُ السِّحرَ والحيَّاتِ والحبالَ والعِصِيَّ الَّذي نعمَلُ، فما أجْرُنا إنْ نحن غلَبْنا؟ قال لهم: أنتم أقاربي وخاصَّتي، وأنا صانعٌ إليكم كلَّ شَيءٍ أحببتم، فتَواعَدوا يومَ الزِّينةِ وأنْ يُحْشَرَ النَّاسُ ضُحًى.\nقال سعيدٌ: فحدَّثني ابنُ عبَّاسٍ: أنَّ يومَ الزِّينةِ اليومُ الَّذي أظهَرَ اللهُ عَزَّ وجَلَّ فيه مُوسى عليه السَّلامُ على فِرعونَ والسَّحرةِ هو يومُ عاشوراءَ.\nفلمَّا اجتمعوا في صَعيدٍ، قال النَّاسُ بعضُهم لبعضٍ: انطَلِقوا، فنتخبَّرْ هذا الأمْرَ، {لَعَلَّنَا نَتَّبِعُ السَّحَرَةَ إِنْ كَانُوا هُمُ الْغَالِبِينَ} [الشعراء: 40]، يعنون مُوسى وهارونَ عليهما السَّلامُ؛ استهزاءً بهما، فقالوا: يا موسى -لِقُدْرتِهم في أنفُسِهم بسِحْرِهم- إمَّا أنْ تُلْقِيَ، وإمَّا أنْ نكونَ نحن المُلْقينَ، قال: بل ألْقُوا. {فَأَلْقَوْا حِبَالَهُمْ وَعِصِيَّهُمْ وَقَالُوا بِعِزَّةِ فِرْعَوْنَ إِنَّا لَنَحْنُ الْغَالِبُونَ} [الشعراء: 44]، فرأى مُوسى عليه السَّلامُ مِن سِحْرِهم ما أوجَسَ في نفْسِه خِيفةً، فأوحى اللهُ عَزَّ وجَلَّ إليه: أنْ ألْقِ عصاك، فلمَّا ألقاها، صارت ثُعبانًا عظيمًا فاغرةً فاها، فجُعِلَتِ العِصِيُّ بدَعوةِ مُوسي عليه السَّلامُ تلتبِسُ بالحبالِ، حتَّى صارتْ جُرُزًا إلى الثُّعبانِ تَدخُل فيه، حتَّى ما أبقَتْ عصًا ولا حبلًا إلَّا ابتلعَتْه. فلمَّا عرَفَ السَّحرةُ ذلك، قالوا: لو كان هذا سِحرٌ لم يَبلُغْ مِن سِحرِنا كلَّ هذا، ولكنَّه أمْرٌ مِن اللهِ، آمنَّا باللهِ ربِّنا وما جاء به مُوسى عليه السَّلامُ، ونتوبُ إلى اللهِ عَزَّ وجَلَّ ممَّا كنَّا عليه. وكسَرَ اللهُ ظهْرَ فِرعونَ في ذلك الموطنِ وأشياعِه، وأظهَرَ الحقَّ، وبطَلَ ما كانوا يعمَلونَ، فغُلِبوا هنالك وانقَلَبوا صاغِرينَ. وامرأةُ فِرعونَ بارزةٌ مُتبذِّلَةٌ تَدْعو بالنَّصرِ لمُوسى عليه السَّلامُ على فِرعونَ، فمَن رآها مِن آلِ فرعونَ ظَنَّ أنَّها إنَّما تبذَّلَتْ للشفقةِ على فِرعونَ وأشياعِه، وإنَّما كان حُزْنُها وهمُّها لمُوسى عليه السَّلامُ. فلمَّا طال مُكْثُ مُوسى عليه السَّلامُ لمواعيدِ فِرعونَ الكاذبةِ، كلَّما جاءه بآيةٍ وعَدَه عندها أنْ يُرْسِلَ معه بني إسرائيلَ، فإذا مضَتْ أخلَفَ موعِدَه، وقال: هل يستطيعُ ربُّك أنْ يصنَعَ غيرَ هذا؟ فأرسَلَ اللهُ عليه وعلى قومِه الطُّوفانَ، والجرادَ، والقُمَّلَ، والضَّفادعَ، آياتٍ مُفصَّلاتٍ، كلُّ ذلك يَشْكو إلى موسى عليه السَّلامُ، ويطلُبُ إليه أنْ يكُفَّها عنه، ويُواثِقُه على أنْ يُرسِلَ معه بني إسرائيلَ، فإذا كَفَّ ذلك عنه، أخلَفَ موعِدَه ونكَثَ عهدَه. فأُمِرَ موسى عليه السَّلامُ بالخُروجِ بقومِه، فخرَجَ بهم ليلًا، فلمَّا أصبَحَ فرعونُ ورأى أنَّهم قد مَضَوا، أرسَلَ في المدائنِ حاشرينَ، فتبِعَهم بجُنودٍ عظيمةٍ كثيرةٍ، وأوحى اللهُ عَزَّ وجَلَّ إلى البحرِ: أنْ إذا ضرَبَك مُوسى بعصاهُ، فانفرِقْ له اثنتَيْ عشْرةَ فِرقةً، حتَّى يجوزَ موسى عليه السَّلامُ ومَن معه، ثمَّ الْتَئَمَ على مَن بقِيَ بعدُ مِن فرعونَ وأشياعِه، فنسِيَ مُوسى عليه السَّلامُ أنْ يضرِبَ البحرَ بالعصا، فانْتَهى إلى البحرِ وله قصيفٌ؛ مخافةَ أنْ يَضرِبَه موسى عليه السَّلامُ، وهو غافِلٌ، فيصيرَ عاصيًا اللهَ عَزَّ وجَلَّ. فلمَّا تراءى الجَمْعانِ وتقارَبَا، قال أصحابُ موسى: إنَّا لمُدْرَكونَ، افعَلْ ما أمرَكَ به ربُّك عَزَّ وجَلَّ؛ فإنَّك لم تكذِبْ ولم تُكْذَبْ، فقال: وعَدَني ربِّي عَزَّ وجَلَّ إذا أتيْتُ البحرَ، انفرَقَ لي اثنتيْ عشْرةَ فِرقةً حتَّى أُجاوزَه، ثمَّ ذكَرَ بعدَ ذلك العصا، فضرَبَ البحرَ بعصاه حين دنا أوائلُ جُندِ فرعونَ مِن أواخرِ جُندِ مُوسى عليه السَّلامُ، فانفرَقَ البحرُ كما أمَرَه اللهُ عَزَّ وجَلَّ، وكما وُعِدَ مُوسى عليه السَّلامُ، فلمَّا أنْ جاوَزَ موسى عليه السَّلامُ وأصحابُه البحرَ، ودخَلَ فِرعونُ وأصحابُه، الْتَقى عليهم البحرُ كما أُمِرَ. فلمَّا جاوَزَ مُوسى عليه السَّلامُ البحرَ، قال أصحابُه: إنَّا نخافُ ألَّا يكونَ فِرعونُ قد غرِقَ، فلا نُؤمِنُ بهلاكِه، فدعا ربَّه عَزَّ وجَلَّ، فأخرَجَه له ببدنه حتَّى استيْقَنوا بهلاكِه.\nثمَّ مَرُّوا بعدَ ذلك {عَلَى قَوْمٍ يَعْكُفُونَ عَلَى أَصْنَامٍ لَهُمْ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَهًا كَمَا لَهُمْ آلِهَةٌ} [الأعراف: 138]، إلى {وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ} [الأعراف: 139]، قد رأيتُمْ مِن العِبَرِ، وسمِعْتُم ما يَكْفيكم، ومَضَى. فأنزَلَهم مُوسى عليه السَّلامُ منزلًا، ثمَّ قال لهم: أطيعوا هارونَ عليه السَّلامُ؛ فإنِّي قد استخلفْتُه عليكم، وإنِّي ذاهبٌ إلى ربِّي عَزَّ وجَلَّ، وأجَّلَهم ثلاثينَ يومًا أنْ يَرجِعَ إليهم فيها، فلمَّا أتى ربَّه وأراد أنْ يُكلِّمَه ثلاثينَ يومًا، وقد صامهنَّ: ليلَهنَّ ونهارَهنَّ، وكرِهَ أنْ يُكلِّمَ ربَّه عَزَّ وجَلَّ ورِيحُ فَمِه رِيحُ فَمِ الصَّائمِ، فتناوَلَ مُوسى عليه السَّلامُ مِن نباتِ الأرضِ شيئًا فمضَغَه، فقال له ربُّه عَزَّ وجَلَّ حين لقاه: لِمَ أفطرْتَ؟ -وهو أعلَمُ بالَّذي كان- قال: يا ربِّ، إنِّي كرِهْتُ أنْ أُكلِّمَك إلَّا وفَمِي طيِّبُ الرِّيحِ، قال: أوما علِمْتَ يا مُوسى أنْ رِيحَ فَمِ الصَّائمِ أطيبُ عندي مِن رِيحِ المِسْكِ؟ ارجِعْ حتَّى تصومَ عشْرًا ثمَّ ائْتِني، ففعَلَ مُوسى عليه السَّلامُ ما أُمِرَ به.\nفلمَّا رأى قومُ مُوسى عليه السَّلامُ أنَّه لم يرجِعْ إليهم للأجَلِ ساءَهم ذلك، وكان هارونُ عليه السَّلامُ قد خطَبَهم، فقال لهم: خرجْتُم مِن مِصْرَ ولقومِ فرعونَ عندي عواري وودائعُ، ولكم فيهم مثلُ ذلك، وأنا أرى أنْ تحتَسِبوا ما لكم عندهم، ولا أحلَّ لكم وديعةً اسْتُودِعْتُمُوها، ولا عاريَّةً، ولسنا برادِّين إليهم شيئًا مِن ذلك، ولا مُمْسِكيه لأنفُسِنا، فحفَرَ حفيرًا، وأمَرَ كلَّ قومٍ عليهم شَيءٌ مِن ذلك؛ مِن متاعٍ أو حِليةٍ أنْ يَقْذِفوه في ذلك الحفيرِ، ثمَّ أوقَدَ عليه النَّارَ، فأحرَقَه، فقال: لا يكونُ لنا، ولا لهم.\nوكان السَّامريُّ رجلًا مِن قومٍ يَعْبُدون البقرَ جيرانٍ لهم، ولم يكُنْ مِن بني إسرائيلَ، فاحتملَ مع مُوسى عليه السَّلامُ وبني إسرائيلَ حين احْتملوا، فقُضِيَ له أنْ رأى أثرًا، فأخَذَ منه بقبْضَتِه، فمَرَّ بهارونَ، فقال له هارونُ عليه السَّلامُ: يا سامريُّ، ألَا تُلْقي ما في يدَيْك؟ وهو قابضٌ عليه لا يَراه أحدٌ طوالَ ذلك، فقال: هذه قبْضةٌ مِن أثرِ الرَّسولِ الَّذي جاوَزَ بكم البحرَ، ولا أُلْقيها لشَيءٍ إلَّا أنْ تَدْعُوَ اللهَ إذا ألقيْتُها أنْ تكونَ ما أُرِيدُ، فألْقاها، ودعا اللهَ هارونُ عليه السَّلامُ، فقال: أريدُ أنْ يكونَ عِجْلًا، واجتمَعَ ما كان في الحُفرةِ مِن متاعٍ له، أو حِلْيةٍ، أو نحاسٍ، أو حديدٍ، فصار عِجْلًا أجوفَ ليس فيه رُوحٌ، له خُوارٌ.\nقال ابنُ عبَّاسٍ: لا واللهِ ما كان له صوتٌ قطُّ، إنَّما كانت الرِّيحُ تدخُلُ مِن دُبُرِه وتخرُجُ مِن فَمِه، فكان ذلك الصَّوتُ مِن ذلك.\nفتفرَّقَ بنو إسرائيلَ فِرَقًا؛ فقالت فِرقةٌ: يا سامريُّ، ما هذا فأنت أعلَمُ به؟ قال: هذا ربُّكم عَزَّ وجَلَّ، ولكنَّ مُوسى عليه السَّلامُ أضَلَّ الطَّريقَ. وقالت فِرقةٌ: لا نُكذِّب بهذا حتَّى يرجِعَ إلينا مُوسى، فإنْ كان ربَّنا لم نكُنْ ضيَّعْناه وعجَزْنا فيه حِينَ رأيْناه، وإنْ لم يكُنْ ربَّنا، فإنَّا نتَّبِعُ قولَ مُوسى عليه السَّلامُ. وقالت فِرقةٌ: هذا عمَلُ الشَّيطانِ، وليس بربِّنا، ولا نُؤْمِنُ، ولا نُصدِّقُ.\nوأُشْرِبَ فِرقةٌ في قُلوبِهم التَّصديقَ بما قال السَّامريُّ في العجلِ، وأعْلَنوا التَّكذيبَ، فقال لهم هارونُ عليه السَّلامُ: {يَا قَوْمِ إِنَّمَا فُتِنْتُمْ بِهِ} [طه: 90]، وإنَّ ربَّكم ليس هكذا، قالوا: فما بالُ مُوسى عليه السَّلامُ؛ وعَدَنا ثلاثينَ يومًا ثمَّ أخلَفَنا، فهذه أربعونَ قد مَضَت؟! فقال سُفهاؤُهم: أخطَأَ ربَّه، فهو يطلُبُه ويتبَعُه. فلمَّا كلَّمَ اللهُ عَزَّ وجَلَّ مُوسى عليه السَّلامُ وقال له ما قال، أخبَرَه بما لقِيَ قومُه بعده. {فَرَجَعَ مُوسَى إِلَى قَوْمِهِ غَضْبَانَ أَسِفًا} [طه: 86]، وقال لهم ما سمِعْتُم في القُرآنِ وأخَذَ برأْسِ أخِيه، وألْقى الألواحَ مِن الغضَبِ، ثمَّ عذَرَ أخاه بعُذْرِه، واستغفَرَ له، وانصرَفَ إلى السَّامريِّ، فقال له: ما حمَلَك على ما صنعْتَ؟ قال: قبَضْتُ قبضةً مِن أثرِ الرَّسولِ وفطِنْتُ لها، وعُمِّيَت عليكم، فقَذفْتُها؛ وكذلك سوَّلَت لي نَفْسي.\nقال: {اذْهَبْ فَإِنَّ لَكَ فِي الْحَيَاةِ أَنْ تَقُولَ لَا مِسَاسَ وَإِنَّ لَكَ مَوْعِدًا لَنْ تُخْلَفَهُ وَانْظُرْ إِلَى إِلَهِكَ} إلى قولِه: {نَسْفًا} [طه: 97]، ولو كان إلهًا لم يُخْلَصْ إلى ذلك منه. فاستيقَنَ بنو إسرائيلَ بالفتنةِ، واغْتَبَطَ الَّذين كان رأيُهم فيه مثلَ رأيِ هارونَ عليه السَّلامُ، فقالوا بجماعتِهم لمُوسى عليه السَّلامُ: سَلْ لنا ربَّك عَزَّ وجَلَّ أنْ يفتَحَ لنا بابَ توبةٍ نصنَعُها؛ فيُكَفِّرَ عنَّا ما عمِلْنا، فاختارَ موسى عليه السَّلامُ قومَه سبعينَ رجُلًا لذلك -لا يأْلُو الخيرَ- خيارَ بني إسرائيلَ، ومَن لم يُشْرِكْ في العجلِ. فانطلَقَ بهم ليسأَلَ لهم التَّوبةَ، فرجَفَتْ بهم الأرضُ، فاستحيا نبيُّ اللهِ صَلَّى اللهُ عليه وسلَّمَ من قومِه ووفْدِه حين فُعِلَ بهم ما فُعِلَ، فقال: {رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا} [الأعراف: 155]، وفيهم مَن قد كان اللهُ عَزَّ وجَلَّ اطَّلَعَ على ما أُشْرِبَ قلبُه من حُبِّ العجلِ وإيمانِه به؛ فلذلك رجَفَت بهم الأرضُ.\nفقال: {وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ} [الأعراف: 156] إلى: {فِي التَّوْرَاةِ وَالْإِنْجِيلِ} [الأعراف: 157]، فقال: رَبِّ سألْتُك التَّوبةَ لقومي، فقلْتَ: إنَّ رحمتي كتبْتُها لقومٍ غيرِ قومي، فليتَكَ أخَّرْتَني حين تُخْرِجُني حيًّا في أُمَّةِ ذلك الرَّجلِ المرحومةِ، فقال اللهُ له: إنَّ توبتَهم أنْ يقتُلَ كلُّ رجُلٍ منهم مَن لقِيَ مِن والدٍ أو ولدٍ، فيقتُلَه بالسَّيفِ لا يُبَالي مَن قتَلَ في ذلك الموطنِ، وتاب أولئك الَّذين كان خفِيَ على موسى وهارونَ عليهما السلام ما اطَّلَعُ اللهُ عليهم من ذُنوبِهم، ",["فاعتَرَفوا بها، وفعَلوا ما أُمِروا",1],"، ",["وغفَرَ اللهُ للقاتِلِ والمقتولِ",2],". ثمَّ سار بهم مُوسى عليه السَّلامُ مُتوجِّهًا نحوَ الأرضِ المُقدَّسةِ، وأخَذَ الألواحَ بعدما سكَتَ عنه الغضبُ، وأمَرَهم بالَّذي أُمِرَ به أنْ يُبَلِّغَهم من الوظائفِ، فثقُلَ ذلك عليهم، وأبَوا أنْ يُقِرُّوا بها، فنتَقَ اللهُ عليهم الجبلَ كأنَّه ظُلَّةٌ، ودنا منهم حتَّى خافوا أنْ يقَعَ عليهم، فأخَذُوا الكتابَ بأيمانِهم وهم يَصْغُون ينظُرونَ إلى الجبلِ والأرضِ، والكتابُ بأيديهم وهم يَنظُرونَ إلى الجبلِ؛ مخافةَ أنْ يقَعَ عليهم، ثمَّ مَضَوا إلى الأرضِ المُقدَّسةِ، فوَجَدوا مدينةَ قومٍ جبَّارينَ خَلْقُهم مُنْكرٌ، وذكَرَ من ثِمارِهم أمرًا عجَبًا من عِظَمِها، فقالوا: يا موسى، إنَّ فيها قومًا جبَّارينَ لا طاقةَ لنا بهم، ولا ندخُلُها ما داموا فيها، فإنْ يَخْرجوا منها فإنَّا داخِلونَ، قال رجُلانِ من الَّذين يَخافونَ مِن الجبَّارينَ: آمنَّا بمُوسى عليه السَّلامُ، فخرَجَا إليه، فقالا: نحنُ أعلَمُ بقومِنا، إنْ كنتُمْ إنَّما تَخافونَ ما رأيتُمْ من أجسامِهم وعدَدِهم، فإنَّهم لا قُلوبَ لهم، ولا مَنعةَ عندهم، فادْخُلوا عليهم البابَ، فإذا دخلْتُموه فإنَّكم غالِبونَ. ويقولُ أناسٌ: إنَّهما من قومِ مُوسى عليه السَّلامُ. وزعَمَ سعيدُ بنُ جُبيرٍ أنَّهما من الجبَّارينَ آمَنَا بمُوسى، بقولِه: {مِنَ الَّذِينَ يَخَافُونَ} [المائدة: 23]: إنَّما عَنى بذلك: مِن الَّذين يَخافونَ بني إسرائيلَ.\n{قَالُوا يَا مُوسَى إِنَّا لَنْ نَدْخُلَهَا أَبَدًا مَا دَامُوا فِيهَا فَاذْهَبْ أَنْتَ وَرَبُّكَ فَقَاتِلَا إِنَّا هَاهُنَا قَاعِدُونَ} [المائدة: 24]، فأغْضَبوا مُوسَى عليه السَّلامُ، فدعا عليهم، وسمَّاهم فاسقينَ، ولم يدْعُ عليهم قبلَ ذلك؛ لِمَا رأى منهم من المعصيةِ وإساءتِهم حتَّى كان يومئذٍ، فاستجابَ اللهُ عَزَّ وجَلَّ له، فسمَّاهم كما سمَّاهم مُوسى عليه السَّلامُ فاسقينَ، فحرَّمَها عليهم أربعينَ سَنةً يَتِيهون في الأرضِ؛ يُصْبِحون كلَّ يومٍ، فيَسِيرونَ ليس لهم قرارٌ، ثمَّ ظلَّلَ عليهم الغمامَ في التِّيهِ، وأنزَلَ عليهم المَنَّ والسَّلوى، وجعَلَ لهم ثيابًا لا تَبْلى، ولا تتَّسِخُ، وجعَلَ بين ظَهرِهم حَجرًا مُربَّعًا، وأمَرَ مُوسى عليه السَّلامُ فضرَبَه بعصاهُ، فانفجَرَ منه اثنتا عشْرةَ عينًا، في كلِّ ناحيةٍ ثلاثةُ أعينٍ، وأعلَمَ كلَّ سِبْطٍ عينَهم الَّتي يَشْربون منها، فلا يَرْتحِلونَ من مَنزلٍ إلَّا وجدوا ذلك الحجرَ منهم بالمكانِ الَّذي كان منه أمسِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (11263)، وأبو يعلى (2618)، والطحاوي في ((شرح مشكل الآثار)) (66) بنحوه.","bab":"تفسير آيات › سورة طه","dorar":"n97bkyvU"},{"id":"س-04026","fp":"e1af0e9a3ed9","stateId":104,"easy":"إذا أذنبت حتى بلغت ذنوبك عنان السماء ثم استغفرت الله ← يغفر لك ولا يبالي","cause":"إنَّكَ إنْ تُذنِبْ حتى يَبلُغَ ذَنبُكَ عَنانَ السماءِ، ثُم تَستَغفِرْني","result":"أغفِرْ لكَ ولا أُبالي","explicit":true,"ref":"تخريج المسند لشعيب 21472","srcLabel":"أحمد","text":["عنِ النَّبيِّ صلَّى اللهُ عليه وسلَّمَ يَرْويهِ عن رَبِّه، قال: ابنَ آدَمَ، إنَّكَ ما دَعَوْتَني، ورَجَوْتَني غَفَرْتُ لكَ على ما كان فيكَ، ابنَ آدَمَ، إنْ تَلْقَني بقُرابِ الأرضِ خَطايا لَقيتُكَ بقُرابِها مَغفِرةً، بعدَ ألَّا تُشرِكَ بي شيئًا، ابنَ آدَمَ، ",["إنَّكَ إنْ تُذنِبْ حتى يَبلُغَ ذَنبُكَ عَنانَ السماءِ، ثُم تَستَغفِرْني ",1],["أغفِرْ لكَ ولا أُبالي",2],"."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"حسن","takhrij":"أخرجه أحمد (21472) واللفظ له، والدارمي (2788)، والبزار (3988)","bab":"توبة › تبشير التائب بالغفران","dorar":"tO3SI8Jh"},{"id":"س-04600","fp":"2ea1952662df","stateId":104,"easy":"إذا تبت توبة صادقة ← تسع توبتك أمة (من قصة ماعز)","cause":"فوضَعَ يَدَه في يَدِه، ثُمَّ قال: اقتُلْني بالحِجارةِ","result":"لقد تابَ تَوبةً لو قُسِمَت بينَ أُمَّةٍ لَوسِعَتْهم","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04025","otherNeedIds":[51],"ref":"صحيح مسلم 1695","text":["جاءَ ماعِزُ بنُ مالِكٍ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال: ويحَكَ! ارجِعْ فاستَغفِرِ اللَّهَ وتُبْ إليه، قال: فرَجَعَ غيرَ بَعيدٍ، ثُمَّ جاءَ، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ويحَكَ! ارجِعْ فاستَغفِرِ اللَّهَ وتُبْ إليه، قال: فرَجَعَ غيرَ بَعيدٍ، ثُمَّ جاءَ، فقال: يا رَسولَ اللهِ، طَهِّرْني، فقال النَّبيُّ صلَّى اللهُ عليه وسلَّم مِثلَ ذلك، حتَّى إذا كانَتِ الرَّابِعةُ قال له رَسولُ اللهِ: فيمَ أُطَهِّرُكَ؟ فقال: مِنَ الزِّنى، فسَألَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أبِه جُنونٌ؟ فأُخبِرَ أنَّه ليس بمَجنونٍ، فقال: أشَرِبَ خَمرًا؟ فقامَ رَجُلٌ فاستَنكَهَه، فلَم يَجِدْ منه ريحَ خَمرٍ، قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أزَنَيتَ؟ فقال: نَعَم، فأمَرَ به فرُجِمَ، فكان النَّاسُ فيه فِرقَتَينِ؛ قائِلٌ يقولُ: لقد هَلَكَ؛ لقد أحاطَت به خَطيئَتُه، وقائِلٌ يقولُ: ما تَوبةٌ أفضَلَ مِن تَوبةِ ماعِزٍ؛ أنَّه جاءَ إلى النَّبيِّ صلَّى اللهُ عليه وسلَّم ",["فوضَعَ يَدَه في يَدِه، ثُمَّ قال: اقتُلْني بالحِجارةِ",1],"، قال: فلَبِثوا بذلك يَومَينِ أو ثَلاثةً، ثُمَّ جاءَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم وهم جُلوسٌ، فسَلَّمَ ثُمَّ جَلَسَ، فقال: استَغفِروا لماعِزِ بنِ مالِكٍ، قال: فقالوا: غَفَرَ اللهُ لماعِزِ بنِ مالِكٍ، قال: فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["لقد تابَ تَوبةً لو قُسِمَت بينَ أُمَّةٍ لَوسِعَتْهم",2],"! قال: ثُمَّ جاءَتْه امرَأةٌ مِن غامِدٍ مِنَ الأزدِ، فقالت: يا رَسولَ اللهِ، طَهِّرْني، فقال: ويحَكِ! ارجِعي فاستَغفِري اللَّهَ وتوبي إليه، فقالت: أراكَ تُريدُ أن تُرَدِّدَني كما رَدَّدتَ ماعِزَ بنَ مالِكٍ، قال: وما ذاكِ؟ قالت: إنَّها حُبلى مِنَ الزِّنا، فقال: آنتِ؟ قالت: نَعَم، فقال لَها: حتَّى تَضَعي ما في بَطنِكِ، قال: فكَفَلَها رَجُلٌ مِنَ الأنصارِ حتَّى وضَعَت، قال: فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّم، فقال: قد وضَعَتِ الغامِديَّةُ، فقال: إذَنْ لا نَرجُمُها ونَدَعُ ولَدَها صَغيرًا ليس له مَن يُرضِعُه، فقامَ رَجُلٌ مِنَ الأنصارِ، فقال: إليَّ رَضاعُه يا نَبيَّ اللهِ، قال: فرَجَمَها."],"grade":"صحيح","narrator":"بريدة بن الحصيب الأسلمي","muhaddith":"[صحيح]","takhrij":"أخرجه أبو عوانة في ((المستخرج)) (6732) واللفظ له، والبيهقي في ((الصغير)) (2535) باختلاف يسير، والنسائي في ((الكبرى)) (7125) بلفظه دون قصة الغامدية.","bab":"حدود › من أقر بالحد","dorar":"sL8GdORo"},{"id":"س-07705","fp":"abfd2dce1dd1","stateId":104,"easy":"إذا ارتددت ثم رجعت تائباً ← يقبل الله توبتك (من واقعة)","cause":"فبعَثَ بها قومُه","result":"فرجَعَ تائبًا، فقبِلَ النبيُّ صلَّى اللهُ عليه وسلَّمَ ذلك منه","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 2218","srcLabel":"النسائي","text":["أنَّ رجلًا من الأنصارِ ارتَدَّ عن الإسلامِ، ولحِقَ بالمشركينَ، فأنزَلَ اللهُ تعالى: {كَيْفَ يَهْدِي اللهُ قَوْمًا كَفَرُوا بَعْدَ إِيمَانِهِمْ...} [آل عمران: 86] إلى آخِرِ الآيةِ، ",["فبعَثَ بها قومُه",1],"، ",["فرجَعَ تائبًا، فقبِلَ النبيُّ صلَّى اللهُ عليه وسلَّمَ ذلك منه",2],"، وخلَّى عنه."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه النسائي (11065)، وأحمد (2218) واللفظ له","bab":"قرآن › أسباب النزول","dorar":"9HULEn8v"},{"id":"س-04045","fp":"1991496308ed","stateId":104,"easy":"إذا تبت وتركت أرض المعصية إلى أرض الصالحين ← يغفر الله لك ولو كثرت ذنوبك","cause":"فتوجَّهَ إليهم","result":"فغُفُِرَ لَهُ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-04163"],"ref":"الزواجر عن اقتراف الكبائر 2/238","srcLabel":"الزواجر عن اقتراف الكبائر","text":["أنَّ رجلًا أسرفَ على نفسِهِ فلقيَ رجلًا فقالَ إنَّ الآخرَ قتلَ تسعًا وتسعينَ نفسًا كلَّهم ظُلمًا فَهل تجدُ لي من توبةٍ قالَ لا فقتلَهُ وأتى آخرَ فقالَ إنَّ الآخرَ قتلَ مائةَ نفسٍ كلَّها ظلمًا فَهل تجدُ لي من توبةٍ فقالَ إن حدَّثتُك أنَّ اللَّهَ لا يتوبُ على من تابَ كذبتُك هَهنا قومٌ يتعبَّدونَ فأتِهم تعبُدِ اللَّهَ معَهم ",["فتوجَّهَ إليهم",1]," فماتَ على ذلِكَ فاختَصمت ملائِكةُ الرَّحمةِ وملائِكةُ العذابِ فبعثَ اللَّهُ إليهم ملَكًا فقالَ قيسوا ما بينَ المَكانينِ فأيُّهم كانَ أقربَ فَهوَ منهم فوجدوهُ أقربَ إلى ديرِ التَّوَّابينَ بأنملةٍ ",["فغُفُِرَ لَهُ",2]],"grade":"حسن","muhaddith":"إسناده جيد","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"tpJo2oGe"},{"id":"س-04163","fp":"a3fa08451e22","stateId":104,"easy":"إذا تبت وانتقلت إلى أرض الصالحين ← يغفر الله لك","cause":"فانطَلَق إليهِم","result":"فغفَر اللهُ له","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-04045","ref":"إتحاف الخيرة المهرة 7/411","text":["إنَّ رجلًا ممن كان قَبلَكم  لَقي رجلًا عالمًا أو عابدًا  فقال:  إن الآخرَ قتَل تسعةً وتِسعينَ نفسًا كلُّها يقتلُها ظلمًا  فهل تجِدُ له مِن توبةٍ ؟ قال:  لئِنْ قلتُ لكَ:  إنَّ اللهَ لا يتوبُ على مَن تاب قد كذَبتُ  هاهُنا ديرٌ فيه قومٌ يتعبَّدونَ  فائتِهِم فاعبُدِ اللهَ معهم  لعلَّ اللهَ يتوبُ عليكَ  ",["فانطَلَق إليهِم",1],"  فمات قبلَ أن يأتيَهم  فاختَصَم فيه ملائكةُ العذابِ وملائكةُ الرحمةِ  فبعَث اللهُ ملَكًا أن قيسوا ما بين المكانينِ  فأيُّهما كان أقربَ فهم منه  فقاسوه  فوجَدوه أقربَ إلى ديرِ التوابينَ بأنملةٍ  ",["فغفَر اللهُ له",2]],"grade":"حسن","narrator":"معاوية بن أبي سفيان","muhaddith":"إسناده جيد","takhrij":"أخرجه أبو يعلى (7361) واللفظ له، ، والطبراني في ((المعجم الكبير)) (19/ 369) (867)، وابن أبي عاصم في ((الديات)) (صـ55) بنحوه.","bab":"جنائز وموت › لقاء الله والمبادرة بالعمل الصالح","dorar":"XoqdNPIg"},{"id":"س-03980","fp":"8a0b0521625b","stateId":104,"easy":"إذا أذنبت ذنباً بينك وبين الله ← فهو الذي يُرجى أن يغفره","cause":"فذنبُ العبدِ بينه و بينَ اللهِ عزَّ و جلَّ","result":"و أما الذي يُغفرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"similar":["س-03987","س-08047"],"ref":"الجامع الصغير 4320","srcLabel":"ابن حبان","text":["ذنبٌ لا يغفرُ،  وذنبٌ لا يتركُ،  و ذنبٌ يغفرُ،  فأما الذي لا يغفرُ : فالشركُ باللهِ،  ",["و أما الذي يُغفرُ",2]," ",["فذنبُ العبدِ بينه و بينَ اللهِ عزَّ و جلَّ",1],"،  و أما الذي لا يُتركُ : فظلمُ العبادِ بعضُهمِ بعضًا"],"grade":"صحيح","narrator":"سلمان الفارسي","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((الصغير)) (102)، وابن حبان في ((المجروحين)) (2/ 452)، والخطيب في ((تاريخ بغداد)) (5/ 547) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"aeocCyIX"},{"id":"س-03987","fp":"ffaf08784fe2","stateId":104,"easy":"إذا أذنبت فيما بينك وبين ربك ← فهو الذنب الذي يُغفر","cause":"فعَمَلُكَ بينَكَ وبينَ ربِّكَ","result":"وأمَّا الذنْبُ الذى يُغْفَرُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03980","ref":"الجامع الصغير 4321","text":["ذنبٌ يُغْفَرُ ، وذنبٌ لا يُغْفَرُ ، وذنبٌ يُجَازَى بِهِ ، فأمَّا الذنبُ الذي لَا يُغْفَرُ : فالشِّرْكُ باللهِ ، ",["وأمَّا الذنْبُ الذى يُغْفَرُ",2]," : ",["فعَمَلُكَ بينَكَ وبينَ ربِّكَ",1]," ، وأمَّا الذنْبُ الذي يُجَازَى بِهِ : فظلْمُكَ أخاكَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه الطبراني في ((المعجم الأوسط)) (7595) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"s3XdCCjy"},{"id":"س-03996","fp":"bed34bbd66c1","stateId":104,"easy":"إذا تبت بعد إقامة الحد عليك ← يتوب الله عليك","cause":"وإن تابَ","result":"اسْتَشْلاها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[66],"ref":"الأحكام الوسطى 4/ 98","srcLabel":"عبد الرزاق","text":["أنَّ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ قَطَعَ رَجُلًا، ثُمَّ أمَرَ به فحُسِمَ، ثُمَّ قالَ: \"تُبْ إلى اللهِ\"، قالَ: أَتوبُ إلى اللهِ، فقالَ النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: \"إذا قُطِعَتْ يَدُه وَقَعَتْ في النَّارِ، فإن عادَ تَبِعَها، ",["وإن تابَ",1]," ",["اسْتَشْلاها",2],"\".\nقالَ عَبْدُ الرَّزَّاقِ: يقولُ: اسْتَرْجَعَها."],"grade":"صحيح","narrator":"ابن المنكدر","muhaddith":"سكت عنه [وقالَ في المقدمة: وإن لم تكن فيه علة كانَ سكوتي عنه دليلا على صحته]","takhrij":"أخرجه عبد الرزاق (13585) واللفظ له","bab":"توبة › الحض على التوبة","dorar":"b6AtCVgU"},{"id":"س-04043","fp":"f9128b144fdf","stateId":104,"easy":"إذا وقعت في الذنب فعجّل بالتوبة ← يتوب الله عليك","cause":"لعلَّه أنْ يتوبَ","result":"فيتوبَ اللهُ عزَّ وجَلَّ عليه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"ref":"تخريج سنن أبي داود 4419","srcLabel":"أبو داود","text":["كان ماعزُ بنُ مالكٍ يتيمًا في حَجْرِ أبي، فأصاب جاريةً من الحيِّ، فقال له أبي: ائْتِ رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فأخبِرْه بما صنَعتَ، لعلَّه يستغفِرُ لك، وإنَّما يريدُ بذلك رجاءَ أنْ يكونَ له مخرجًا، قال: فأتاه فقال: يا رسولَ اللهِ، إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ، فأعرَضَ عنه، فعاد فقال: يا رسولَ اللهِ:  إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ، فأعرَضَ عنه، فعاد فقال: يا رسولَ اللهِ،  إنِّي زنَيتُ فأقِمْ عليَّ كتابَ اللهِ؛ حتى قالَها أربعَ مِرارٍ، قال صلَّى اللهُ عليه وسلَّمَ: إنَّك قد قُلتَها أربعَ مراتٍ، فبمن؟ قال: بفلانةَ، فقال: هل ضاجَعْتَها؟ قال: نعَمْ، قال: هل باشَرْتَها؟ قال: نعَمْ، قال: هل جامَعْتَها؟ قال: نعَمْ، قال: فأمَرَ به أنْ يُرجَمَ، فأُخرِجَ به إلى الحَرَّةِ، فلمَّا رُجِم، فوجَدَ مَسَّ الحِجارةِ، فجزِعَ، فخرَجَ يشتَدُّ، فلقِيَه عبدُ اللهِ بنُ أُنَيسٍ، وقد عجَزَ أصحابُه، فنزَعَ له بوظيفِ بعيرٍ، فرماه به، فقتَلَه، ثم أتى النبيَّ صلَّى اللهُ عليه وسلَّمَ، فذكَرَ ذلك له، فقال: هلا ترَكتُموه، ",["لعلَّه أنْ يتوبَ",1]," ",["فيتوبَ اللهُ عزَّ وجَلَّ عليه",2],"."],"grade":"صحيح","narrator":"نعيم بن هزال الأسلمي","muhaddith":"صحيح لغيره","takhrij":"أخرجه أبو داود (4419) بلفظه، وأحمد (21890) باختلاف يسير، والنسائي في ((السنن الكبرى)) (7234) مختصرا.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"LsKyqcIj"},{"id":"س-08047","fp":"ca5065371ca8","stateId":104,"easy":"إذا ظلمت نفسك فيما بينك وبين ربك ← فهو الظلم الذي يُرجى أن يغفره الله","cause":"فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم","result":"وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03980","ref":"البعث والنشور 292","text":["«الظُّلمُ ثَلاثةٌ: فظُلمٌ لا يَغفِرُه اللهُ عَزَّ وجَلَّ، وظُلمٌ يَغفِرُه، وظُلمٌ لا يَترُكُه اللهُ عَزَّ وجَلَّ؛ فأمَّا الظُّلمُ الذي لا يَغفِرُه اللهُ فالشِّركُ، قال اللهُ عَزَّ وجَلَّ: {إِنَّ الشِّرْكَ لَظُلْمٌ عَظِيمٌ}، ",["وأمَّا الظُّلمُ الذي يَغفِرُه اللهُ",2]," ",["فظُلمُ العِبادِ أنفُسَهم فيما بَينَهم وبَينَ رَبِّهم",1],"، وأمَّا الظُّلمُ الذي لا يَترُكُه فظُلمُ العِبادِ بَعضِهم بَعضًا، حتَّى يدينَ بَعضُهم مِن بَعضٍ»."],"grade":"حسن","narrator":"أنس بن مالك","muhaddith":"إسناده غير قوي.","bab":"مظالم › تحريم الظلم","dorar":"eiFC1szY","merged":2,"otherRefs":["البعث والنشور 393 (حسن)"]},{"id":"س-02275","fp":"04f2b12abca9","stateId":104,"easy":"إذا أذنبت ذنباً كبيراً فبرّ خالتك (أو أمك) ← فلك به توبة","cause":"فبِرَّها","result":"أذْنَبتُ ذَنْبًا كَبيرًا، فهل لي تَوبَةٌ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"star":true,"similar":["س-04019"],"otherNeedIds":[37],"ref":"تخريج المسند لشعيب 4624","srcLabel":"أحمد","text":["أتَى رسولَ اللهِ صلَّى اللهُ عليه وسلَّم رَجُلٌ، فقال: يا رسولَ اللهِ، إنِّي ",["أذْنَبتُ ذَنْبًا كَبيرًا، فهل لي تَوبَةٌ",2],"؟ فقال له رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ألكَ والِدانِ؟ قال: لا، قال: فلكَ خالَةٌ؟، قال: نَعَمْ، فقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: ",["فبِرَّها",1]," إذًا."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (4624)، وابن حبان (435)، والحاكم (7261)","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"9Por8RFq","merged":2,"otherRefs":["هداية الرواة 4863 (صحيح)"]},{"id":"س-04019","fp":"259d3bfd25d2","stateId":104,"easy":"إذا أذنبت ذنباً عظيماً فبرّ خالتك ← فلك به توبة","cause":"فهل لك من خالةٍ قال نعم قال فبِرَّها","result":"إنِّي أذنبتُ ذنبًا عظيمًا فهل لي من توبةٍ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02275","otherNeedIds":[37],"ref":"الترغيب والترهيب 3/298","text":["أتَى النَّبيَّ صلَّى اللهُ عليه وسلَّم رجلٌ فقال ",["إنِّي أذنبتُ ذنبًا عظيمًا فهل لي من توبةٍ",2]," فقال هل لك أمٌّ قال لا قال ",["فهل لك من خالةٍ قال نعم قال فبِرَّها",1]],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (4624) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"Piewse10"},{"id":"س-03979","fp":"07b187a701f3","stateId":104,"easy":"إذا أذنبت فعلمت أن لك رباً يغفر ويعاقب ← كان حقاً على الله أن يغفر لك","cause":"منْ أذنبَ ذنبًا، فعلمَ أنَّ لهُ ربًّا، إنْ شاءَ","result":"أنْ يغفرَ لهُ غفرَ لهُ، و إنْ شاءَ أنْ يعذبَهُ عذبَهُ، كانَ حقًّا على اللهِ أنْ يغفرَ لهُ","explicit":true,"ref":"الجامع الصغير 8361","srcLabel":"ابن حبان","text":[["منْ أذنبَ ذنبًا،  فعلمَ أنَّ لهُ ربًّا،  إنْ شاءَ ",1],["أنْ يغفرَ لهُ غفرَ لهُ،  و إنْ شاءَ أنْ يعذبَهُ عذبَهُ،  كانَ حقًّا على اللهِ أنْ يغفرَ لهُ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"صحيح","takhrij":"أخرجه ابن حبان في ((الثقات)) (7/ 20)، والطبراني في ((المعجم الأوسط)) (1676) والحاكم (7609) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"xs3oIuxA"},{"id":"س-03476","fp":"f7eecd4700f1","stateId":104,"easy":"إذا سترك الله في الدنيا (وأنت مؤمن) ← يغفر لك ذنوبك يوم القيامة","cause":"يُدْني المُؤمِنَ منه","result":"قد ستَرْتُها عليكَ مِن النَّاسِ وإنِّي أغفِرُها لكَ اليومَ","explicit":true,"star":true,"otherNeedIds":[42],"ref":"صحيح ابن حبان 7356","srcLabel":"متفق عليه","text":["بَيْنَما أنا آخِذٌ بيدِ ابنِ عُمَرَ إذ جاءه رجُلٌ فقال : كيف سمِعْتَ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ في النَّجوى يومَ القيامةِ ؟ فقال : سمِعْتُ رسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ : ( إنَّ اللهَ ",["يُدْني المُؤمِنَ منه",1]," يومَ القيامةِ حتَّى يضَعَ كَنَفَه عليه فيستُرُه مِن النَّاسِ فيقولُ : أتعرِفُ ذَنْبَ كذا وكذا ؟ فيقولُ : نَعم يا ربِّ فيقولُ : أتعرِفُ ذَنْبَ كذا وكذا ؟ فيقولُ : نَعم يا ربِّ حتَّى إذا قرَّره بذُنوبِه وظنَّ في نفسِه أنَّه قد استوجَب قال : ",["قد ستَرْتُها عليكَ مِن النَّاسِ وإنِّي أغفِرُها لكَ اليومَ",2]," ويُعطَى كتابَ حسَناتِه وأمَّا الكفَّارُ والمُنافِقونَ فيقولُ الأشهادُ : {هَؤُلَاءِ الَّذِينَ كَذَبُوا عَلَى رَبِّهِمْ أَلَا لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ} [هود: 18]"],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (2441)، ومسلم (2768) باختلاف يسير","bab":"استغفار › مغفرة الله تعالى للذنوب العظام وسعة رحمته","dorar":"xh4zXOwJ","merged":3,"otherRefs":["تفسير سورة النساء 2/495 (صحيح)","تخريج صحيح ابن حبان 7355 (صحيح)"]},{"id":"س-03158","fp":"dd2fd1ed4aed","stateId":104,"easy":"إذا عملت سيئة ← تُكتب واحدة مثلها أو يغفرها الله","cause":"ومَن جاءَ بالسَّيِّئةِ","result":"فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ","explicit":true,"star":true,"ref":"صحيح مسلم 2687","srcLabel":"متفق عليه","text":["يقولُ اللهُ عَزَّ وجَلَّ: مَن جاءَ بالحَسَنةِ فله عَشرُ أمثالِها وأزيدُ، ",["ومَن جاءَ بالسَّيِّئةِ",1]," ",["فجَزاؤُه سَيِّئةٌ مِثلُها أو أغفِرُ",2],"، ومَن تَقَرَّبَ مِنِّي شِبرًا تَقَرَّبتُ منه ذِراعًا، ومَن تَقَرَّبَ مِنِّي ذِراعًا تَقَرَّبتُ منه باعًا، ومَن أتاني يَمشي أتَيتُه هَرولةً، ومَن لَقيَني بقُرابِ الأرضِ خَطيئةً لا يُشرِكُ بي شيئًا لَقيتُه بمِثلِها مَغفِرةً. وفي روايةٍ: فله عَشرُ أمثالِها، أو أزيدُ."],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"إيمان › توحيد الأسماء والصفات","dorar":"D1po7pkJ"},{"id":"س-07590","fp":"87468ae759aa","stateId":104,"easy":"إذا كنت من أهل الكبائر من الأمة ← ترجو شفاعة النبي ﷺ","cause":"لأهلِ الكَبائِرِ مِن أُمَّتي","result":"إنَّ شَفاعَتي","explicit":true,"ijtihad":true,"ijtihadWhy":["خاص بالنبي ﷺ أو الأنبياء، وتعديته إلينا اجتهاد"],"otherNeedIds":[65],"ref":"البعث والنشور 398","srcLabel":"الترمذي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم تَلا قَولَ اللهِ عَزَّ وجَلَّ {وَلَا يَشْفَعُونَ إِلَّا لِمَنِ ارْتَضَى وَهُمْ مِنْ خَشْيَتِهِ مُشْفِقُونَ} فقال صلَّى اللهُ عليه وسلَّم: «",["إنَّ شَفاعَتي",2]," ",["لأهلِ الكَبائِرِ مِن أُمَّتي",1],"»"],"grade":"صحيح","narrator":"جابر بن عبد الله","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (3487) بلفظه، والترمذي (2436)، وابن ماجه (4310) مختصرا.","bab":"فضائل النبي وصفته ودلائل النبوة › شفقته على أمته","dorar":"HmlBKDga"},{"id":"س-03972","fp":"2852ced2eeb6","stateId":105,"easy":"إذا تبت قبل أن تطلع الشمس من مغربها ← يتوب الله عليك","cause":"مَنْ تابَ قبلَ أنْ تطْلُعَ الشمسُ مِنْ مَغْرِبِها","result":"تابَ اللهُ عليْهِ","explicit":true,"similar":["س-01563"],"ref":"صحيح الجامع 6133","srcLabel":"مسلم","text":[["مَنْ تابَ قبلَ أنْ تطْلُعَ الشمسُ مِنْ مَغْرِبِها ، ",1],["تابَ اللهُ عليْهِ",2]],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه مسلم (2703)","bab":"توبة › الحض على التوبة","dorar":"XjgBd9LQ"},{"id":"ق-0207","fp":"bb962cf0d14f","stateId":105,"easy":"التوبة من قريب بعد السوء بجهالة ← توبة الله عليهم","cause":"التوبة من قريب بعد السوء بجهالة","result":"توبة الله عليهم","explicit":true,"ref":"سورة النساء: 17","srcLabel":"القرآن الكريم","quran":{"s":4,"from":17,"to":17,"text":"إِنَّمَا التَّوْبَةُ عَلَى اللَّهِ لِلَّذِينَ يَعْمَلُونَ السُّوءَ بِجَهَالَةٍ ثُمَّ يَتُوبُونَ مِنْ قَرِيبٍ فَأُولَئِكَ يَتُوبُ اللَّهُ عَلَيْهِمْ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا (17)","hl":[[35,109,1],[109,147,2],[147,181,1]]}},{"id":"س-04012","fp":"ab44264dd875","stateId":105,"easy":"إذا تبت قبل موتك ولو بنصف يوم ← يقبل الله توبتك","cause":"توبةَ العبدِ","result":"إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بنصفِ يومٍ","explicit":true,"similar":["س-04004"],"ref":"عمدة التفسير 1/475","srcLabel":"أحمد","text":["اجتمعَ أربعةٌ من أصحابِ النَّبيِّ صلَّى اللَّهُ عليهِ وسلَّمَ ، فقالَ أحدُهُم سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ إنَّ اللَّهَ يقبلُ ",["توبةَ العبدِ",1]," قبلَ أن يموتَ بيومٍ ، فقالَ الآخرُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ ",["إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بنصفِ يومٍ ،",2]," فقالَ الثَّالثُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقول إنَّ اللَّهَ يقبلُ توبةَ العبدِ قبلَ أن يموتَ بضحوةَ ، قالَ الرَّابعُ : أنتَ سمِعتَ هذا من رسولِ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ ؟ قالَ : نعم . قالَ : وأَنا سَمِعْتُ رسولَ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ يقولُ إنَّ اللَّهَ يقبلُ توبةَ العبدِ ما لم يُغَرْغِرْ بنفسِهِ"],"grade":"صحيح","narrator":"أربعة من أصحاب النبي صلى الله عليه وسلم","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (15499)، وابن أبي الدنيا في ((التوبة)) (150)، والثعلبي في ((التفسير)) (10/ 139) بلفظه.","bab":"توبة › الحض على التوبة","dorar":"9M71Svu0","merged":5,"otherRefs":["المستدرك على الصحيحين 7868 (صحيح)","عمدة التفسير 1/476 (صحيح)","فتح الباري لابن حجر 11/360 (صحيح)","الأحاديث المختارة 13 / 150 (صحيح)"]},{"id":"س-04016","fp":"4a4437efb588","stateId":105,"easy":"إذا تبت ← فالتوبة مقبولة حتى تطلع الشمس من المغرب","cause":"التَّوبةُ","result":"ولا تزالُ التَّوبةُ مقبولةً حتَّى تطلُعَ الشَّمسُ منَ المغرِبِ","explicit":true,"similar":["س-03971"],"ref":"تخريج المسند لشاكر 3/133","srcLabel":"النسائي","text":["لا تنقَطعُ الهِجرةُ ما دامَ العدوُّ يقاتلُ فقالَ مُعاويةُ ، وعبدُ الرَّحمنِ بنُ عوفٍ ، وعبدُ اللَّهِ بنُ عمرو بنِ العاصِ : إنَّ النَّبيَّ صلَّى اللَّهُ عليهِ وسلَّمَ ، قالَ : إنَّ الهجرةَ خَصلتانِ : إحداهما أن تَهْجرَ السَّيِّئاتِ ، والأخرى أن تُهاجرَ إلى اللَّهِ ورسولِهِ . ولا تنقطعُ الهجرةُ ما تُقُبِّلَتِ ",["التَّوبةُ",1]," ، ",["ولا تزالُ التَّوبةُ مقبولةً حتَّى تطلُعَ الشَّمسُ منَ المغرِبِ",2]," ، فإذا طلعَت طُبِعَ على كلِّ قَلبٍ بما فيهِ ، وَكُفيَ النَّاسُ العَملَ"],"grade":"صحيح","narrator":"عبدالله بن وقدان ابن السعدي","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1671)، وابن عساكر في ((تاريخ دمشق)) (31/ 306) بلفظهأخرجه النسائي في ((السنن الكبرى)) (7748) باختلاف يسير.","bab":"توبة › الحض على التوبة","dorar":"aKzBrJNi","merged":3,"otherRefs":["تفسير الطبري 3/2/377 (صحيح)","تخريج مشكل الآثار 2634 (صحيح)"]},{"id":"س-04001","fp":"b1dd01592473","stateId":105,"easy":"إذا تبت إلى الله قبل أن تبلغ روحك الحلقوم ← يقبل الله منك","cause":"مَنْ تابَ إلى اللهِ قبلَ أنْ يُغَرْغِرَ","result":"قَبِلَ اللهُ مِنْهُ","explicit":true,"otherNeedIds":[51],"ref":"صحيح الجامع 6132","srcLabel":"صحيح الجامع","text":[["مَنْ تابَ إلى اللهِ قبلَ أنْ يُغَرْغِرَ ، ",1],["قَبِلَ اللهُ مِنْهُ",2]],"grade":"صحيح","narrator":"رجل وعبدالله بن عمر","muhaddith":"صحيح","bab":"توبة › الحض على التوبة","dorar":"qf0O4Dl4"},{"id":"س-03971","fp":"6d3a5966b6e3","stateId":105,"easy":"إذا تبت ← فباب التوبة واسع مفتوح حتى تطلع الشمس من مغربها","cause":"للتوبةِ","result":"بابًا عرضُ ما بين مِصراعَيه ما بين المشرقِ و المغربِ لا يُغلَقُ حتى تطلعَ الشمسُ من مغربِها","explicit":true,"repOf":"س-04016","ref":"صحيح الجامع 2177","text":["إنَّ ",["للتوبةِ",1]," ",["بابًا عرضُ ما بين مِصراعَيه ما بين المشرقِ و المغربِ لا يُغلَقُ حتى تطلعَ الشمسُ من مغربِها",2]],"grade":"حسن","narrator":"صفوان بن عسال","muhaddith":"حسن","takhrij":"أخرجه الترمذي (3536)، والنسائي في ((السنن الكبرى)) (11114)، والطبراني (8/ 65)، (7383) جميعهم مطولا.","bab":"توبة › الحض على التوبة","dorar":"mBG9CCsM","merged":2,"otherRefs":["صحيح الجامع 4191 (حسن)"]},{"id":"س-04004","fp":"1f9c9042be20","stateId":105,"easy":"إذا تبت إلى الله ولو قبل موتك بيوم ← تُقبل توبتك","cause":"لو أذنَب كلَّ ذنبٍ ثمَّ تاب إلى اللهِ قَبلَ موتِه بيومٍ","result":"قُبِلَ منه","explicit":true,"repOf":"س-04012","ref":"مجمع الزوائد 10/201","text":["عن عبدِ اللهِ بنِ سَلَامٍ قال لا أُحَدِّثُكم إلَّا عن نبيٍّ مُرْسَلٍ أو كِتابٍ مُنْزَلٍ إنَّ عبدًا ",["لو أذنَب كلَّ ذنبٍ ثمَّ تاب إلى اللهِ قَبلَ موتِه بيومٍ",1]," ",["قُبِلَ منه",2]],"grade":"حسن","narrator":"[خرشة بن الحر]","muhaddith":"رجاله ثقات","takhrij":"أخرجه الطبراني (جـ 13، 14 (ص: 48)) (14978) واللفظ له، والضبي في ((الدعاء)) (143) بنحوه.","bab":"توبة › الحض على التوبة","dorar":"qimsj1vp"},{"id":"س-04020","fp":"8d0862a993da","stateId":105,"easy":"إذا تبت قبل موتك ولو بيوم ← يُتاب عليك","cause":"مَن تاب قبلَ مَوتِه عامًا","result":"تيبَ عليه، ومَن تاب قبلَ مَوتِه بشهرٍ؛ تيبَ عليه، حتى قال: يومًا، حتى قال: ساعةً، حتى قال: فُوَاقًا","explicit":true,"ref":"تخريج المسند لشعيب 6920","srcLabel":"أحمد","text":["يقولُ: ",["مَن تاب قبلَ مَوتِه عامًا",1],"؛ ",["تيبَ عليه، ومَن تاب قبلَ مَوتِه بشهرٍ؛ تيبَ عليه، حتى قال: يومًا، حتى قال: ساعةً، حتى قال: فُوَاقًا",2],"، قال: قال الرَّجُلُ: أرأَيْتَ إن كان مُشركًا أسلَمَ؟ قال: إنَّما أحدِّثُكم كما سمِعْتُ مِن رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ يقولُ."],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"حسن لغيره","takhrij":"أخرجه أحمد (6920) واللفظ له، والطيالسي (2398)، والحاكم (7664) باختلاف يسير","bab":"توبة › الحض على التوبة","dorar":"xsLmBbYA"},{"id":"س-01563","fp":"26019b06ea09","stateId":105,"easy":"إذا تبت قبل طلوع الشمس من مغربها ← يقبل الله توبتك","cause":"للتوبة","result":"إنَّ من قبل المغرب لبابا مسيرة عرضه أربعون عاما أو سبعون سنة فتحه الله عزَّ وجلَّ للتوبة يوم خلق السماوات والأرض فلا يغلقه حتَّى يطلع الشمس منه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"repOf":"س-03972","ref":"الترغيب والترهيب 4/118","text":[["إنَّ من قبل المغرب لبابا مسيرة عرضه أربعون عاما أو سبعون سنة فتحه الله عزَّ وجلَّ للتوبة يوم خلق السماوات والأرض فلا يغلقه حتَّى يطلع الشمس منه",2]],"grade":"صحيح","narrator":"صفوان بن عسال","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (6674) بلفظه، والحميدي (905)، وأبو نعيم في ((حلية الأولياء)) (7/ 308) كلاهما مطولا.","bab":"أشراط الساعة › أمارات الساعة وأشراطها","dorar":"MFEet3bO","merged":2,"otherRefs":["تخريج سير أعلام النبلاء 15/8 (حسن)"]},{"id":"س-03982","fp":"66b31eb53cd0","stateId":105,"easy":"إذا تبت قبل طلوع الشمس من مغربها ← فباب التوبة مفتوح لك","cause":"للتَّوبةِ","result":"للجنَّةِ ثمانيةُ أبوابٍ سبعَةٌ مُغْلَقةٌ وبابٌ مَفتوحٌ للتَّوبةِ حتَّى تطلعَ الشَّمسُ من نحوِه","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[67],"ref":"الجامع الصغير 7320","srcLabel":"الحاكم","text":[["للجنَّةِ ثمانيةُ أبوابٍ سبعَةٌ مُغْلَقةٌ وبابٌ مَفتوحٌ للتَّوبةِ حتَّى تطلعَ الشَّمسُ من نحوِه",2]],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"صحيح","takhrij":"أخرجه الحاكم (7671)، وأبو يعلى (5012)، والطبراني في ((المعجم الكبير)) (10/ 206) (10479) واللفظ لهم.","bab":"توبة › الحض على التوبة","dorar":"8W3qaije"},{"id":"س-05129","fp":"c445366bc0e9","stateId":106,"easy":"إذا أحسنت في الإسلام ← لا تؤاخذ بما عملت في الجاهلية","cause":"مَن أحسَن في الإسلامِ","result":"لمْ يُؤاخَذْ بما عمِل في الجاهليَّةِ","explicit":true,"star":true,"ref":"تخريج مشكل الآثار 506","srcLabel":"متفق عليه","text":["قال النَّاسُ: يا رسولَ اللهِ، ثمَّ ذكَر مِثْلَهُ سَواءً. [يعني حديثَ: قال رجُلٌ: يا رسولَ اللهِ، أيُؤاخَذُ أحَدُنا بما عمِل في الجاهليَّةِ؟ فقال: ",["مَن أحسَن في الإسلامِ",1]," ",["لمْ يُؤاخَذْ بما عمِل في الجاهليَّةِ",2],"، ومَن أساء في الإسلامِ أُخِذَ بالأَوَّلِ والآخِرِ.]"],"grade":"صحيح","narrator":"عبدالله بن مسعود","muhaddith":"إسناده صحيح","takhrij":"أخرجه البخاري (6921)، ومسلم (120) باختلاف يسير","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"NJJzACMW","merged":4,"otherRefs":["تخريج المسند لشعيب 4408 (صحيح)","تخريج المسند لشاكر 5/213 (صحيح)","صحيح مسلم 120 (صحيح)"]},{"id":"س-03976","fp":"3623f22cdec7","stateId":106,"easy":"إذا أسلمت ← يهدم الإسلام ما كان قبله","cause":"أما عَلِمْتَ أنَّ الإسْلامَ","result":"يَهْدِمُ ما كانَ قَبْلَهُ","explicit":true,"similar":["س-04040","س-04042"],"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":["التوبةُ تجُبُّ ما قبلَها [يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: ",["أما عَلِمْتَ أنَّ الإسْلامَ ",1],["يَهْدِمُ ما كانَ قَبْلَهُ",2],"؟ وأنَّ الهِجْرَةَ تَهْدِمُ ما كانَ قَبْلَها؟ وأنَّ الحَجَّ يَهْدِمُ ما كانَ قَبْلَهُ؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI"},{"id":"ق-0069","fp":"66050dd71ef7","stateId":106,"easy":"الانتهاء عن العدوان والكفر ← مغفرة الله ورحمته","cause":"الانتهاء عن العدوان والكفر","result":"مغفرة الله ورحمته","explicit":true,"ref":"سورة البقرة: 192","srcLabel":"القرآن الكريم","quran":{"s":2,"from":192,"to":192,"text":"فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (192)","hl":[[0,18,1],[18,49,2]]}},{"id":"ق-0463","fp":"7513ea64975c","stateId":106,"easy":"الانتهاء عن الكفر ← مغفرة ما قد سلف","cause":"الانتهاء عن الكفر","result":"مغفرة ما قد سلف","explicit":true,"ref":"سورة الأنفال: 38","srcLabel":"القرآن الكريم","quran":{"s":8,"from":38,"to":38,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ (38)","hl":[[25,41,1],[41,72,2],[72,73,1]]}},{"id":"س-04040","fp":"c49639d42145","stateId":106,"easy":"إذا أسلمت ← يمحو الإسلام ما قبله","cause":"الإسلامُ","result":"يجبُّ ما قَبلَهُ","explicit":true,"repOf":"س-03976","ref":"إرواء الغليل 1280","text":[["الإسلامُ ",1],["يجبُّ ما قَبلَهُ ",2],"[يعني حديث: لمَّا أَلْقى اللهُ عزَّ وجلَّ في قَلْبي الإسلامَ، قال: أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ليُبايعَني، فبسَطَ يَدَه إليَّ، فقُلْتُ: لا أُبايعُكَ يا رسولَ اللهِ حتى تَغفِرَ لي ما تقَدَّمَ من ذَنْبي، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمرُو، أمَا علِمْتَ أنَّ الهِجرةَ تَجُبُّ ما قَبلَها منَ الذنوبِ، يا عَمرُو، أمَا علِمْتَ أنَّ الإسلامَ يَجُبُّ ما كان قَبلَه منَ الذنوبِ.]"],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17812)، والطحاوي في ((شرح مشكل الآثار)) (507) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (4993) واللفظ له.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"kHG0XXKn","merged":3,"otherRefs":["صحيح الجامع 2777 (صحيح)","تخريج المسند لشعيب 17813 (حسن)"]},{"id":"س-04042","fp":"dd28b643ff03","stateId":106,"easy":"إذا أسلمت ← يمحو الإسلام ما قبله من الذنوب","cause":"أمَا علِمْتَ أنَّ الإسلامَ","result":"يَجُبُّ ما كان قَبلَه منَ الذنوبِ","explicit":true,"repOf":"س-03976","ref":"إرواء الغليل 1280","text":["الإسلامُ يجبُّ ما قَبلَهُ [يعني حديث: لمَّا أَلْقى اللهُ عزَّ وجلَّ في قَلْبي الإسلامَ، قال: أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ليُبايعَني، فبسَطَ يَدَه إليَّ، فقُلْتُ: لا أُبايعُكَ يا رسولَ اللهِ حتى تَغفِرَ لي ما تقَدَّمَ من ذَنْبي، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمرُو، أمَا علِمْتَ أنَّ الهِجرةَ تَجُبُّ ما قَبلَها منَ الذنوبِ، يا عَمرُو، ",["أمَا علِمْتَ أنَّ الإسلامَ ",1],["يَجُبُّ ما كان قَبلَه منَ الذنوبِ",2],".]"],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17812)، والطحاوي في ((شرح مشكل الآثار)) (507) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (4993) واللفظ له.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"kHG0XXKn"},{"id":"س-02385","fp":"fb2848acd3ea","stateId":106,"easy":"إذا شهدت أن لا إله إلا الله ← تُغفر لك غدراتك وفجراتك","cause":"تَشهَدُ أنْ لا إلهَ إلَّا اللهُ","result":"غُفِرَ لك غَدَراتُك وفَجَراتُك","explicit":true,"ref":"مجمع الزوائد 1/37","srcLabel":"أحمد","text":["أقْبَلَ شَيخٌ يَدَّعِمُ على عَصًا حتى قام بين يَدَيِ النَّبيِّ صلَّى اللهُ عليه وسلَّم، فقال: يا نَبيَّ اللهِ، إنَّ لي غَدَراتٍ وفَجَراتٍ، فهل يُغفَرُ لي؟ قال: أليس ",["تَشهَدُ أنْ لا إلهَ إلَّا اللهُ",1],"، قال: نَعَمْ، وأشهَدُ أنَّ مُحمَّدًا رسولُ اللهِ، فقال: فقد ",["غُفِرَ لك غَدَراتُك وفَجَراتُك",2],"."],"grade":"حسن","narrator":"عمرو بن عبسة","muhaddith":"رجاله موثقون إلا أنه من رواية مكحول عن عمرو بن عبسة فلا أدري أسمع منه أم لا","takhrij":"أخرجه أحمد (19451)، والطبراني في ((مسند الشاميين)) (3500) باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"zjWg9lPi"},{"id":"س-02463","fp":"3252fab263f7","stateId":106,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← تأتي على ذنوبك (تمحوها)","cause":"أليسَ تشهدُ أن لا إلهَ إلَّا اللَّهَ وأنَّ مُحمَّد رسولُ اللَّهِ","result":"فإنَّ ذلِكَ يأتي على ذلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"similar":["س-02466","س-02412"],"ref":"الأمالي المطلقة 143","srcLabel":"الطبراني","text":["عن أنسِ بنِ مالِكٍ رضيَ اللَّهُ تعالى عنهُ قالَ جاءَ رجلٌ إلى رَسولُ اللَّهِ صلَّى اللَّهُ عليهِ وسلَّمَ فقالَ ما ترَكْتُ من حاجَّةٍ ولا داجَّةٍ إلَّا أتيتُ قالَ ",["أليسَ تشهدُ أن لا إلهَ إلَّا اللَّهَ وأنَّ مُحمَّد رسولُ اللَّهِ",1]," ؟ قالَها ثلاثَ مراتٍ قالَ نعَم قالَ ",["فإنَّ ذلِكَ يأتي على ذلِكَ",2]],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"حسن صحيح غريب وله شاهد","takhrij":"أخرجه أبو يعلى (3433) بلفظه، والبزار (6887)، والطبراني في ((المعجم الأوسط)) (7077) كلاهما باختلاف يسير.","bab":"إسلام › فضل الشهادتين","dorar":"pfqVaiun"},{"id":"س-02466","fp":"1c0dd716cefb","stateId":106,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← تمحو ما قبلها من الذنوب","cause":"تشْهَدُ أن لا إلَهَ إلَّا اللَّهُ وأنِّي رسولُ اللَّهِ","result":"فإنَّ هذا يأبَى على ذلِكَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"repOf":"س-02463","ref":"البحر الزخار 13/299","text":["أنَّ رجلًا قال: يا رسولَ اللَّهِ ما ترَكتُ من حاجَّةٍ ولا داجَّةٍ فقالَ رسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّم: ",["تشْهَدُ أن لا إلَهَ إلَّا اللَّهُ وأنِّي رسولُ اللَّهِ",1]," قالَ: بلى قالَ ",["فإنَّ هذا يأبَى على ذلِكَ",2]],"grade":"صحيح","narrator":"أنس","muhaddith":"لا نعلم روى مستور بن عباد، عن ثابت، عن أنس إلا هذا الحديث","takhrij":"أخرجه أبو يعلى (3433)، والطبراني في ((الأوسط)) (7077)، والبيهقي في ((الشعب)) (6684) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"ZIXNg8OF"},{"id":"س-04055","fp":"a7fe4ad90472","stateId":106,"easy":"إذا أسلمت بعد ذنوب الجاهلية ← عفا الله عما سلف","cause":"وَأدْتُ في الجاهليَّةِ","result":"عَفا اللهُ عمَّا سلَفَ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"ref":"تخريج المسند لشعيب 21339","srcLabel":"النسائي","text":["أتَيْتُ أبا ذَرٍّ، فلم أجِدْه، ورَأيْتُ المرأةَ فسأَلْتُها، فقالت: هو ذاك في ضَيْعةٍ له، فجاءَ يَقودُ، أو يَسوقُ بَعيرَيْنِ، قاطرًا أحَدَهما في عَجُزِ صاحِبِه، في عُنُقِ كلِّ واحدٍ منهما قِربةٌ، فوضَعَ القِربَتيْنِ، قُلْتُ: يا أبا ذَرٍّ، ما كان منَ الناسِ أحَدٌ أحَبَّ إليَّ أنْ أَلْقاهُ منكَ، ولا أبغَضَ أنْ أَلْقاهُ منكَ، قال: للهِ أبوكَ، وما يَجمَعُ هذا؟ قال: قُلْتُ: إنِّي كُنْتُ ",["وَأدْتُ في الجاهليَّةِ",1],"، وكُنْتُ أَرْجو في لِقائِكَ أنْ تُخبِرَني أنَّ لي تَوبةً ومَخرَجًا، وكُنْتُ أَخْشى في لِقائِكَ أنْ تُخبِرَني أنَّه لا تَوبةَ لي، فقال: أفي الجاهليَّةِ؟ قُلْتُ: نَعَمْ، فقال: ",["عَفا اللهُ عمَّا سلَفَ",2],"، ثُم عاجَ برأسِه إلى المرأةِ، فأمَرَ لي بطَعامٍ، فالتَوَتْ عليه، ثُم أمَرَها فالتَوَتْ عليه، حتى ارتَفَعَتْ أصواتُهما، قال: إيهًا، دَعينا عنكِ؛ فإنَّكُنَّ لن تَعْدُونَ ما قال لنا فيكُنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ، قُلْتُ: وما قال لكم فيهِنَّ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ؟ قال: المرأةُ ضِلَعٌ، فإنْ تَذهَبْ تُقَوِّمُها تَكسِرْها، وإنْ تَدَعْها ففيها أَوَدٌ وبُلْغةٌ، فوَلَّتْ فجاءَتْ بثَريدةٍ كأنَّها قَطاةٌ، فقال: كُلْ ولا أَهولَنَّكَ، إنِّي صائمٌ، ثُم قامَ يُصلِّي، فجعَلَ يُهذِّبُ الركوعَ ويُخفِّفُه، ورَأيْتُه يَتَحرَّى أنْ أشبَعَ أو أُقارِبَ، ثُم جاءَ فوضَعَ يَدَه معي، فقُلْتُ: إنَّا للهِ وإنَّا إليه راجِعونَ، فقال: ما لكَ؟ فقُلْتُ: مَن كُنْتُ أَخْشى منَ الناسِ أنْ يَكذِبَني، فما كُنْتُ أَخْشى أنْ تَكذِبَني، قال: للهِ أبوكَ، إنْ كذَبْتُكَ كَذْبةً منذ لَقيتَني، فقال: ألم تُخبِرْني أنَّكَ صائمٌ، ثُم أراكَ تأكُلُ؟ قال: بَلى، إنِّي صُمْتُ ثلاثةَ أيامٍ من هذا الشهْرِ، فوجَبَ لي أجْرُه، وحَلَّ لي الطعامُ معكَ."],"grade":"حسن","narrator":"أبو ذر الغفاري","muhaddith":"رجاله ثقات","takhrij":"أخرجه النسائي في ((السنن الكبرى)) (9152) المرفوع منه، وأحمد (21339) واللفظ له","bab":"توبة › ما يقبل فيه التوبة وما لا يقبل","dorar":"pfpPzGmr"},{"id":"س-02412","fp":"50a649c764de","stateId":106,"easy":"إذا شهدت أن لا إله إلا الله وأن محمداً رسول الله ← يُسقط الله ما كان قبلها","cause":"لا يَأْتيه أحَدٌ يَشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ","result":"إلَّا قبِلَ ذلك، وأسقَطَ ما كانَ قبلَ ذلك","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"repOf":"س-02463","ref":"المستدرك على الصحيحين 6638","text":["عنِ الحجَّاجِ بنِ ذي الرُّقَيْبةِ بنِ عَبدِ الرَّحمَنِ بنِ كَعبِ بنِ زُهَيرِ بنِ أبي سُلْمى المُزَنيِّ، عنْ أبيهِ، عنْ جدِّه، قالَ: خرَجَ كَعبٌ وبُجَيرٌ ابْنا زُهَيرٍ حتَّى أتَيا أبرَقَ العزَّافِ، فقالَ بُجَيرٌ لكَعبٍ: اثبُتْ في عجَلِ هذا المكانِ حتَّى آتيَ هذا الرَّجلَ، يَعني رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فأسمَعَ ما يَقولُ، فثبَتَ كَعبٌ وخرَجَ بُجَيرٌ، فجاءَ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ فعرَضَ عليه الإسْلامَ، فأسلَمَ، فبلَغَ ذلك كَعبًا، فقالَ:\n ألَا أبْلِغا عَنِّي بُجَيرًا رِسالةً ... على أيِّ شَيءٍ وَيحَ غَيرِكَ دلَّكَا\n على خُلُقٍ لم تُلفِ أمًّا ولا أبًا ... عليه ولم تُدرِكْ عليه أخًا لَكَا \n سَقَاكَ أبو بَكرٍ بكأسٍ رَوِيَّةٍ ... وأنْهَلَكَ المَأْمونُ منها وعَلَّكَا\n فلمَّا بلغَتِ الأبْياتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ أهدَرَ دمَه، فقالَ: مَن لَقِيَ كَعبًا فلْيَقتُلْه، فكتَبَ بذلك بُجَيرٌ إلى أخيه يَذكُرُ له أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ قد أهدَرَ دمَه، ويقولُ له: النَّجاءَ وما أراكَ تَنفَلِتُ، ثمَّ كتَبَ إليه بعدَ ذلك: اعلَمْ أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ ",["لا يَأْتيه أحَدٌ يَشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّ مُحمَّدًا رَسولُ اللهِ",1]," ",["إلَّا قبِلَ ذلك، وأسقَطَ ما كانَ قبلَ ذلك",2],"، فإذا جاءَكَ كِتابي هذا فأسلِمْ وأقبِلْ، فأسلَمَ كَعبٌ وقالَ القَصيدةَ الَّتي يَمدَحُ فيها رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ أقبَلَ حتَّى أناخَ راحِلَتَه ببابِ مَسجِدِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ، ثمَّ دخَلَ المَسجِدَ ورَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ معَ أصْحابِه مَكانَ المائدةِ منَ القَومِ مُتَحلِّقونَ معَه حَلْقةً دونَ حَلْقةٍ، يَلتفِتُ إلى هؤلاء مرَّةً، فيُحدِّثُهم، وإلى هؤلاء مرَّةً فيُحدِّثُهم، قالَ كَعبٌ: فأنَخْتُ راحِلَتي ببابِ المَسجِدِ، فعرَفْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ بالصِّفةِ، فتَخطَّيْتُ حتَّى جلَسْتُ إليه، فأسلَمْتُ، فقُلْتُ: أشهَدُ أنْ لا إلَهَ إلَّا اللهُ، وأنَّكَ رَسولُ اللهِ، الأمانَ يا رَسولَ اللهِ، قالَ: ومَن أنتَ؟ قُلْتُ: أنا كَعبُ بنُ زُهَيرٍ، قالَ: الَّذي تَقولُ، ثمَّ التَفَتَ إلى أبي بَكرٍ، فقالَ: كيف قالَ يا أبا بَكرٍ؟ فأنشَدَه أبو بَكرٍ:\n سَقاكَ أبو بَكرٍ بكأسٍ رَويَّةٍ ... وأنْهلَكَ المأمونُ منها وعلَّكَا\n قالَ: يا رَسولَ اللهِ، ما قُلْتُ هكذا، قالَ: وكيف قُلْتَ؟ قالَ: إنَّما قُلْتُ:\n سَقاكَ أبو بَكرٍ بكأْسٍ رَويَّةٍ ... وأنْهلَكَ المأْمورُ منها وعلَّكَا\n فقالَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: مأمورٌ واللهِ ثمَّ أنشَدَه القَصيدةَ كلَّها حتَّى أتَى على آخِرِها وأمْلاها على الحجَّاجِ بنِ ذي الرُّقَيْبةِ حتَّى أتَى على آخِرِها، وهي هذه القَصيدةُ:\n بانَتْ سُعادٌ فَقَلْبي اليَومَ مَتْبولُ ... مُتيَّمٌ عندَها لم يُفْدَ مَغْلولُ\n وما سَعادُ غَداةَ البَيْنِ إذْ رَحَلوا ... إلَّا أغَنُّ غَضيضُ الطَّرفِ مَكْحولُ\n تَجْلو عَوارِضَ ذي ظَلْمٍ إذا ابتسَمَتْ ... كأنَّها مُنهَلٌ بالكأْسِ مَعْلولُ\n سحَّ السُّقاةُ عليه ماءَ مَحْنيةٍ ... مِن ماءِ أبطَحَ أمْسَى وهو مَشْمولُ\n تَنْفي الرِّياحُ القَذى عنه وأفْرَطَه ... مِن صَوبِ عاديةٍ بِيضٍ يَعالِيلُ\n سَقْيًا لَهَا خُلَّةٌ لَوْ أَنَّهَا صَدَقَتْ ... مَوْعُودَهَا وَلَوْ أَنَّ النُّصْحَ مَقْبُولُ\n لَكِنَّهَا خُلَّةٌ قَدْ سِيطَ مِنْ دَمِهَا ... فَجْعٌ وَوَلْعٌ وَإِخْلَافٌ وَتَبْدِيلُ\n فَمَا تَدُومُ عَلَى حَالٍ تَكُونُ بِهَا ... كَمَا تَلَوَّنَ فِي أَثْوَابِهَا الغُولُ\n ولَا تَمَسَّكُ بِالوَصْلِ الَّذِي زَعَمَتْ ... إلَّا كَمَا يُمْسِكُ المَاءَ الغَرَابِيلُ\n كَانَتْ مَوَاعِيدُ عُرْقُوبٍ لَهَا مَثَلًا ... وَمَا مَوَاعِيدُهَا إلَّا الأَبَاطِيلُ\n فَلَا يَغُرَّنَّكَ مَا مَنَّتْ وَمَا وَعَدَتْ ... إلَّا الأَمَانِيَّ وَالأَحْلَامَ تَضْلِيلُ\n أَمْسَتْ سُعَادُ بِأَرْضٍ مَا يُبَلِّغُهَا ... إلَّا الْعِتَاقُ النَّجِيبَاتُ الْمَرَاسِيلُ\n وَلَنْ يُبَلِّغَهَا إِلَّا عُذَافِرةٌ ... فِيهَا عَلَى الأَيْنِ إِرْقَالٌ وَتَبْغِيلُ\n مِنْ كُلِّ نَضَّاخةِ الذَّفْرَى إِذَا عَرِقَتْ ... عُرْضَتُهَا طَامِسُ الأَعْلَامِ مَجْهُولُ\n يَمْشِي القُرَادُ عَلَيهَا ثُمَّ يُزْلِقُهُ ... عنْهَا اللَّبَانُ وَأقْرَابٌ زَهَالِيلُ\n عَيْرَانةٌ قُذِفَتْ بِالنَّحْضِ عَنْ عُرُضٍ ... وَمِرْفَقٍ عَنْ ضُلُوعِ الزُّورِ مَفْتُولُ\n كَأَنَّ مَا فَاتَ عَيْنَيْهَا وَمَذْبَحَهَا ... مِنْ خَطْمِهَا وَمِنَ اللَّحْيَيْنِ بِرْطِيلُ\n تُمِرُّ مِثْلَ عَسِيبِ النَّحْلِ ذَا خُصَلٍ ... بغَارِبٍ لم تُخوِّنْهُ الأَحَالِيلُ\n قَنْوَاءُ فِي حَرَّتَيْهَا لِلبَصِيرِ بِهَا ... عِتْقٌ مُبِينٌ وَفِي الْخَدَّيْنِ تَسْهِيلُ\n تَخْدي عَلَى يَسَرَاتٍ وَهْيَ لَاهِيةٌ ... ذَاوَبِلٌ وَقْعُوهُنَّ الأَرْضَ تَحْلِيلُ\n حَرْفٌ أَبُوهَا أَخُوهَا مِنْ مُهَجَّنَةٍ ... وَعَمُّهَا خَالُهَا قَوْدَاءُ شَمْلِيلُ\n سُمرُ العُجَايَاتِ يَتْرُكْنَ الْحَصَا زِيمًا ... مَا إِنْ يَقيهِنَّ حَدَّ الْأُكْمِ تَنْعِيلُ\n يَوْمًا تَظَلُّ حِدَابُ الأَرْضِ تَرفَعُهَا ... مِنَ اللَّوَامِعِ تَخْلِيطٌ وَتَزْيِيلُ\n كَأنَّ أَوْبَ يَدَيْهَا بَعْدَمَا نَجَدَتْ ... وَقَدْ تَلَفَّعَ بِالقُورِ العَسَاقِيلُ\n أَوْبُ يَدَيْ ثاكِلٍ شَمْطَاءَ مُعْوِلةً ... قَامَتْ تُجَاوِبُهَا شُمْطٌ مَثَاكِيلُ\n نُوَاحةٌ رَخْوةُ الضَّبْعَيْنِ لَيسَ لَهَا ... لَمَّا نَعَى بَكْرَهَا النَّاعُونَ مَعْقُولُ\n تَسْعَى الوُشَاةُ بدَفَّيْهَا وَقِيلِهِمُ ... بأنَّكَ يَا ابْنَ أَبِي سُلْمَى لَمَقْتُولُ\n خَلُّوا طَرِيقَ يَدَيْهَا لَا أَبَا لَكُمُ ... فَكُلُّ مَا قَدَّرَ الرَّحْمَنُ مَفْعُولُ\n كُلُّ ابْنِ أُنْثَى وَإِنْ طَالَتْ سَلَامَتُهُ ... يَوْمًا عَلَى آلَةٍ حَدْبَاءَ مَحْمُولُ\n أُنْبِئْتُ أَنَّ رَسُولَ اللهِ أَوْعَدَنِي ... وَالْعَفْوُ عِنْدَ رَسُولِ اللهِ مَأْمُولُ\n فَقَدْ أَتَيْتُ رَسُولَ اللهِ مُعْتَذِرًا ... وَالْعُذْرُ عِنْدَ رَسُولِ اللهِ مَقْبُولُ\n مَهْلًا رَسُولَ الَّذِي أَعْطَاكَ نَافِلَةَ ... الْقُرْآنِ فِيه مَوَاعِيظٌ وَتَفْصِيلُ\n لَا تَأْخُذَنِّي بِأَقْوَالِ الوُشَاةِ وَلَمْ ... أُجْرِمْ وَلَوْ كَثُرَتْ عَنِّي الأقَاوِيلُ\n لَقَدْ أَقُومُ مَقَامًا لَوْ يَقُومُ لَهُ ... أَرَى وَأَسمَعُ مَا لَوْ يَسْمَعُ الْفِيلُ\n لَظَلَّ يُرْعَدُ إِلَّا أَنْ يَكُونَ لَهُ ... عِنْدَ الرَّسُولِ بِإِذْنِ اللهِ تَنْوِيلُ\n حَتَّى وَضَعْتُ يَمِينِي لَا أُنَازِعُهُ ... فِي كَفٍّ ذِي نَقِمَاتٍ قَوْلُهُ الْقِيلُ\n فَكَانَ أَخْوَفَ عِنْدِي إِذْ أُكَلِّمُهُ ... إِذْ قِيلَ إِنَّكَ مَنْسُوبٌ وَمَسْؤُولُ\n مِنْ خَادِرٍ شَبَّكَ الأنْيَابَ طَاعَ لَهُ ... بِبَطْنِ عَثَّرَ غِيلٌ دُونَهُ غِيلُ\n يَغْدُو فَيُلْحِمُ ضِرْغَامَيْنِ عِنْدَهُمَا ... لَحْمٌ مِنَ الْقَوْمِ مَنْثُورٌ خَرَادِيلُ\n مِنْهُ تَظَلُّ حَمِيرُ الْوَحْشِ ضَامِرَةً ... وَلَا تَمشَّى بِوَادِيهِ الأرَاجِيلُ\n وَلَا يَزَالُ بِوَادِيهِ أَخُو ثِقَةٍ ... مُطَرَّحُ الْبَزِّ وَالدِّرْسَانِ مَأْكُولُ\n إِنَّ الرَّسُولَ لَنُورٌ يُسْتَضَاءُ بِهِ ... وَصَارِمٌ مِنْ سُيُوفِ اللهِ مَسْلُولُ\n فِي فِتْيَةٍ مِنْ قُرَيْشٍ قَالَ قَائِلُهُمْ ... بِبَطْنِ مَكَّةَ لَمَّا أَسْلَمُوا زُولُوا\n زَالُوا فَمَا زَالَ أنْكاسٌ وَلَا كُشُفٌ ... عِنْدَ اللِّقَاءِ وَلَا مِيلٌ مَعَازِيلُ\n شُمُّ الْعَرَانِينِ أَبْطَالٌ لِباسُهُمُ ... مِنْ نَسْجِ دَاوُدَ فِي الهَيْجَا سَرَابِيلُ\n بِيضٌ سَوَابِغُ قَدْ شُكَّتْ لَهَا حَلَقٌ ... كَأَنَّهَا حَلَقُ الْقَفْعَاءِ مَجْدُولُ\n يَمْشُونَ مَشْيَ الْجِمَالِ البُزْلِ يَعْصِمُهُم ... ضَرْبٌ إِذَا عَرَّدَ السُّودُ التَّنَابِيلُ\n لَا يَفْرَحُونَ إِذَا نَالَتْ رِمَاحُهُمُ ... قَوْمًا وَلَيْسوا مَجَازِيعًا إِذَا نِيلُوا\n مَا يَقَعُ الطَّعْنُ إِلَّا فِي نُحُورِهُمُ ... وَمَا لَهُمْ عَنْ حِيَاضِ الْمَوْتِ تَهْلِيلُ"],"grade":"صحيح","narrator":"ذي الرقيبة بن عبد الرحمن بن كعب بن زهير بن أبي سلمى","muhaddith":"[صحيح]","takhrij":"أخرجه البيهقي (21182)، وابن أبي عاصم في ((الآحاد والمثاني)) (2706) بنحوه.","bab":"إسلام › فضل الشهادتين","dorar":"SX1HCfCK"},{"id":"س-02434","fp":"233905be87f3","stateId":106,"easy":"إذا أدركت الإسلام بعد ذنب كبير ← يغفر الله لك","cause":"أنْ تُدركَ الوائدةُ الإسلامَ","result":"فيغفرُ اللهُ لها","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"التمهيد 18/119","srcLabel":"أحمد","text":["أتيتُ النبيَّ صلَّى اللهُ عليهِ وسلَّمَ أنا وأخي فقلنا يا رسولَ اللهِ إنَّ أُمنا ماتتْ في الجاهليةِ وكانتْ تُقري الضيفَ وتصلُ الرحمَ وتفعلُ وتفعلُ فهلْ يَنفعُها مِنْ عملِها ذلكَ شيءٌ قال لا قال فقلْنا إنَّ أُمنا ولدتْ أختًا لنا في الجاهليةِ لمْ تبلغْ الحنثَ فهلْ ذلكَ نافعُ أختَنا فقال رسولُ اللهِ صلَّى اللهُ عليهِ وسلَّمَ أرأيتمُ الوائدةَ والموؤدةَ فإنَّهما في النارِ إلا ",["أنْ تُدركَ الوائدةُ الإسلامَ",1]," ",["فيغفرُ اللهُ لها",2]],"grade":"صحيح","narrator":"سلمة بن يزيد الجعفي","muhaddith":"صحيح من جهة الإسناد","takhrij":"أخرجه أحمد (15965)","bab":"إسلام › فضل الشهادتين","dorar":"fEak09qd"},{"id":"س-03975","fp":"0bf41b5f8458","stateId":106,"easy":"إذا تبت ← تمحو التوبة ما قبلها","cause":"التوبةُ","result":"تجُبُّ ما قبلَها","explicit":true,"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":[["التوبةُ ",1],["تجُبُّ ما قبلَها ",2],"[يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: أما عَلِمْتَ أنَّ الإسْلامَ يَهْدِمُ ما كانَ قَبْلَهُ؟ وأنَّ الهِجْرَةَ تَهْدِمُ ما كانَ قَبْلَها؟ وأنَّ الحَجَّ يَهْدِمُ ما كانَ قَبْلَهُ؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI"},{"id":"س-03978","fp":"30507b00577c","stateId":106,"easy":"إذا حججت ← يهدم الحج ما كان قبله","cause":"وأنَّ الحَجَّ","result":"يَهْدِمُ ما كانَ قَبْلَهُ","explicit":true,"star":true,"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":["التوبةُ تجُبُّ ما قبلَها [يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: أما عَلِمْتَ أنَّ الإسْلامَ يَهْدِمُ ما كانَ قَبْلَهُ؟ وأنَّ الهِجْرَةَ تَهْدِمُ ما كانَ قَبْلَها؟ ",["وأنَّ الحَجَّ",1]," ",["يَهْدِمُ ما كانَ قَبْلَهُ",2],"؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI"},{"id":"س-03977","fp":"7345fc342869","stateId":106,"easy":"إذا هاجرت ← تهدم الهجرة ما كان قبلها","cause":"وأنَّ الهِجْرَةَ","result":"تَهْدِمُ ما كانَ قَبْلَها","explicit":true,"star":true,"similar":["س-04041"],"ref":"مجموع فتاوى ابن باز 297/6","srcLabel":"مسلم","text":["التوبةُ تجُبُّ ما قبلَها [يعني حديث: حَضَرْنا عَمْرَو بنَ العاصِ، وهو في سِياقَةِ المَوْتِ، يَبَكِي طَوِيلًا، وحَوَّلَ وجْهَهُ إلى الجِدارِ، فَجَعَلَ ابنُهُ يقولُ: يا أبَتاهُ، أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ أما بَشَّرَكَ رَسولُ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ بكَذا؟ قالَ: فأقْبَلَ بوَجْهِهِ، فقالَ: إنَّ أفْضَلَ ما نُعِدُّ شَهادَةُ أنْ لا إلَهَ إلَّا اللَّهُ، وأنَّ مُحَمَّدًا رَسولُ اللهِ، إنِّي قدْ كُنْتُ علَى أطْباقٍ ثَلاثٍ، لقَدْ رَأَيْتُنِي وما أحَدٌ أشَدَّ بُغْضًا لِرَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ مِنِّي، ولا أحَبَّ إلَيَّ أنْ أكُونَ قَدِ اسْتَمْكَنْتُ منه، فَقَتَلْتُهُ، فلوْ مُتُّ علَى تِلكَ الحالِ لَكُنْتُ مِن أهْلِ النَّارِ، فَلَمَّا جَعَلَ اللَّهُ الإسْلامَ في قَلْبِي أتَيْتُ النبيَّ صَلَّى اللَّهُ عليه وسلَّمَ، فَقُلتُ: ابْسُطْ يَمِينَكَ فَلأُبايِعْكَ، فَبَسَطَ يَمِينَهُ، قالَ: فَقَبَضْتُ يَدِي، قالَ: ما لكَ يا عَمْرُو؟ قالَ: قُلتُ: أرَدْتُ أنْ أشْتَرِطَ، قالَ: تَشْتَرِطُ بماذا؟ قُلتُ: أنْ يُغْفَرَ لِي، قالَ: أما عَلِمْتَ أنَّ الإسْلامَ يَهْدِمُ ما كانَ قَبْلَهُ؟ ",["وأنَّ الهِجْرَةَ",1]," ",["تَهْدِمُ ما كانَ قَبْلَها",2],"؟ وأنَّ الحَجَّ يَهْدِمُ ما كانَ قَبْلَهُ؟ وما كانَ أحَدٌ أحَبَّ إلَيَّ مِن رَسولِ اللهِ صَلَّى اللَّهُ عليه وسلَّمَ، ولا أجَلَّ في عَيْنِي منه، وما كُنْتُ أُطِيقُ أنْ أمْلأَ عَيْنَيَّ منه إجْلالًا له، ولو سُئِلْتُ أنْ أصِفَهُ ما أطَقْتُ؛ لأَنِّي لَمْ أكُنْ أمْلأُ عَيْنَيَّ منه، ولو مُتُّ علَى تِلكَ الحالِ لَرَجَوْتُ أنْ أكُونَ مِن أهْلِ الجَنَّةِ، ثُمَّ ولِينا أشْياءَ ما أدْرِي ما حالِي فيها، فإذا أنا مُتُّ فلا تَصْحَبْنِي نائِحَةٌ، ولا نارٌ، فإذا دَفَنْتُمُونِي فَشُنُّوا عَلَيَّ التُّرابَ شَنًّا، ثُمَّ أقِيمُوا حَوْلَ قَبْرِي قَدْرَ ما تُنْحَرُ جَزُورٌ ويُقْسَمُ لَحْمُها، حتَّى أسْتَأْنِسَ بكُمْ، وأَنْظُرَ ماذا أُراجِعُ به رُسُلَ رَبِّي.]"],"grade":"صحيح","narrator":"[عمرو بن العاص]","muhaddith":"صحيح","takhrij":"أخرجه مسلم (121)، وأحمد (17827)، وابن أبي خيثمة في ((تاريخه-السفر الثاني)) (2642) بنحوه تامًا.","bab":"توبة › الحض على التوبة","dorar":"ytm0uPWI","merged":2,"otherRefs":["تخريج المسند لشعيب 17813 (حسن)"]},{"id":"س-04041","fp":"16e7b822076d","stateId":106,"easy":"إذا هاجرت ← تمحو الهجرة ما قبلها من الذنوب","cause":"أمَا علِمْتَ أنَّ الهِجرةَ","result":"تَجُبُّ ما قَبلَها منَ الذنوبِ","explicit":true,"repOf":"س-03977","ref":"إرواء الغليل 1280","text":["الإسلامُ يجبُّ ما قَبلَهُ [يعني حديث: لمَّا أَلْقى اللهُ عزَّ وجلَّ في قَلْبي الإسلامَ، قال: أتَيْتُ النَّبيَّ صلَّى اللهُ عليه وسلَّمَ ليُبايعَني، فبسَطَ يَدَه إليَّ، فقُلْتُ: لا أُبايعُكَ يا رسولَ اللهِ حتى تَغفِرَ لي ما تقَدَّمَ من ذَنْبي، قال: فقال لي رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يا عَمرُو، ",["أمَا علِمْتَ أنَّ الهِجرةَ ",1],["تَجُبُّ ما قَبلَها منَ الذنوبِ",2],"، يا عَمرُو، أمَا علِمْتَ أنَّ الإسلامَ يَجُبُّ ما كان قَبلَه منَ الذنوبِ.]"],"grade":"صحيح","narrator":"عمرو بن العاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (17812)، والطحاوي في ((شرح مشكل الآثار)) (507) باختلاف يسير، وأبو نعيم في ((معرفة الصحابة)) (4993) واللفظ له.","bab":"توبة › سقوط الذنوب بالاستغفار والتوبة","dorar":"kHG0XXKn"},{"id":"س-01365","fp":"5e7242bb580a","stateId":107,"easy":"إذا تبت من السيئة ← تُمحى عنك","cause":"فإنْ تاب منها","result":"فامحوها عنه","explicit":true,"ref":"صحيح ابن حبان 381","srcLabel":"متفق عليه","text":["إذا همَّ عبدي بسيِّئةٍ فلم يعمَلْها فاكتُبوها له حسنةً فإنْ عمِلها فاكتُبوها له سيِّئةً ",["فإنْ تاب منها",1]," ",["فامحوها عنه",2]," وإذا همَّ عبدي بحسنةٍ فلم يعمَلْها فاكتُبوها له حسنةً فإنْ عمِلها فاكتُبوها له بعشَرةِ أمثالِها إلى سبعِمئةِ ضِعْفٍ"],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"أخرجه في صحيحه","takhrij":"أخرجه البخاري (7501)، ومسلم (128) بمعناه","bab":"نية › النية في العبادات","dorar":"X0fEzP4v"},{"id":"س-05759","fp":"a68b95e5847b","stateId":107,"easy":"إذا أردت سيئة فتركتها لله ← تُكتب لك حسنة","cause":"إذا أرادَ عَبدي أن يَعمَلَ سَيِّئةً فلا تَكتُبوها عليه حتَّى يَعمَلَها، فإن عَمِلَها فاكتُبوها بمِثلِها، وإن تَرَكَها مِن أجلي","result":"فاكتُبوها له حَسَنةً","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح البخاري 7501","srcLabel":"متفق عليه","text":["يقولُ اللهُ: ",["إذا أرادَ عَبدي أن يَعمَلَ سَيِّئةً فلا تَكتُبوها عليه حتَّى يَعمَلَها، فإن عَمِلَها فاكتُبوها بمِثلِها، وإن تَرَكَها مِن أجلي",1]," ",["فاكتُبوها له حَسَنةً",2],"، وإذا أرادَ أن يَعمَلَ حَسَنةً فلَم يَعمَلْها فاكتُبوها له حَسَنةً، فإن عَمِلَها فاكتُبوها له بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (7501)، ومسلم (128)","bab":"رقائق وزهد › النية","dorar":"Xip7zc21"},{"id":"س-01096","fp":"b9fa7db45ee6","stateId":107,"easy":"إذا هممت بسيئة فمنعتك منها هيبة الله ← تُكتب لك حسنة","cause":"وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي","result":"كَتَبْتُها لكَ حَسنةً","explicit":true,"star":true,"similar":["س-06880"],"otherNeedIds":[45],"ref":"المستدرك على الصحيحين 7833","srcLabel":"مسلم","text":["قالَ رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: يقولُ اللهُ عزَّ وجلَّ: ابنَ آدمَ، إنْ دَنَوْتَ مِنِّي شِبرًا دَنَوْتُ منكَ ذِراعًا، وإنْ دَنَوتَ مِنِّي ذِراعًا دَنوْتُ منكَ باعًا، ابنَ آدَمَ، إنْ حَدَّثْتَ نفْسَكَ بحَسَنةٍ فلَمْ تعْمَلْها كتَبْتُها لكَ حَسنةً، وإنْ عمِلْتَها كَتَبْتُها لكَ عشْرًا، ",["وإنْ هَمَمْتَ بسَيِّئةٍ فحَجَزَكَ عنْها هَيْبَتي",1]," ",["كَتَبْتُها لكَ حَسنةً",2],"، وإنْ عَمِلْتَها كتَبْتُها سيِّئةً واحدةً."],"grade":"صحيح","narrator":"أبو ذر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه مسلم (2687)، وابن ماجه (3821)، والبزار (3988)، والطبراني في ((المعجم الأوسط)) (1714) باختلاف يسير.","bab":"أدعية وأذكار › فضل الذكر","dorar":"c1RSotrC"},{"id":"س-07617","fp":"4970d0587568","stateId":107,"easy":"إذا هممت بسيئة فلم تعملها ← لا يُكتب عليك شيء","cause":"ومَن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها","result":"لَم تُكتَبْ شيئًا","explicit":true,"ref":"صحيح مسلم 162","srcLabel":"النسائي","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم قال: أُتيتُ بالبُراقِ، وهو دابَّةٌ أبيَضُ طَويلٌ فوقَ الحِمارِ، ودونَ البَغلِ، يَضَعُ حافِرَه عِندَ مُنتَهى طَرْفِه، قال: فرَكِبتُه حتَّى أتَيتُ بَيتَ المَقدِسِ، قال: فرَبَطتُه بالحَلقةِ التي يَربِطُ به الأنبياءُ، قال: ثُمَّ دَخَلتُ المَسجِدَ، فصَلَّيتُ فيه رَكعَتَينِ، ثُمَّ خَرَجتُ فجاءَني جِبريلُ عليه السَّلامُ بإناءٍ مِن خَمرٍ، وإناءٍ مِن لَبَنٍ، فاختَرتُ اللَّبَنَ، فقال جِبريلُ صلَّى اللهُ عليه وسلَّم: اختَرتَ الفِطرةَ، ثُمَّ عُرِجَ بنا إلى السَّماءِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بآدَمَ، فرَحَّبَ بي، ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الثَّانيةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بابنَيِ الخالةِ عيسى ابنِ مَريَمَ، ويَحيى بنِ زَكَريَّا، صَلَواتُ اللهِ عليهما، فرَحَّبا ودَعَوا لي بخَيرٍ، ثُمَّ عَرَجَ بي إلى السَّماءِ الثَّالِثةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَنَ أنتَ؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بيوسُفَ صلَّى اللهُ عليه وسلَّم، إذا هو قد أُعطيَ شَطرَ الحُسنِ، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ الرَّابِعةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قال: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإدريسَ، فرَحَّبَ ودَعا لي بخَيرٍ، قال اللهُ عزَّ وجلَّ: {ورَفَعناه مَكانًا عَليًّا} [مريم: 57]، ثُمَّ عُرِجَ بنا إلى السَّماءِ الخامِسةِ، فاستَفتَحَ جِبريلُ، قيلَ: مَن هذا؟ فقال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بهارونَ صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّادِسةِ، فاستَفتَحَ جِبريلُ عليه السَّلامُ، قيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لَنا، فإذا أنا بموسى صلَّى اللهُ عليه وسلَّم، فرَحَّبَ ودَعا لي بخَيرٍ، ثُمَّ عُرِجَ بنا إلى السَّماءِ السَّابِعةِ، فاستَفتَحَ جِبريلُ، فقيلَ: مَن هذا؟ قال: جِبريلُ، قيلَ: ومَن معك؟ قال: مُحَمَّدٌ صلَّى اللهُ عليه وسلَّم، قيلَ: وقد بُعِثَ إليه؟ قال: قد بُعِثَ إليه، ففُتِحَ لنا فإذا أنا بإبراهيمَ صلَّى اللهُ عليه وسلَّم مُسنِدًا ظَهرَه إلى البَيتِ المَعمورِ، وإذا هو يَدخُلُه كُلَّ يَومٍ سَبعونَ ألفَ مَلَكٍ لا يَعودونَ إليه، ثُمَّ ذَهَبَ بي إلى السِّدرةِ المُنتَهى، وإذا ورَقُها كَآذانِ الفيَلةِ، وإذا ثَمَرُها كالقِلالِ، قال: فلَمَّا غَشيَها مِن أمرِ اللهِ ما غَشيَ تَغَيَّرَت، فما أحَدٌ مِن خَلقِ اللهِ يَستَطيعُ أن يَنعَتَها مِن حُسنِها، فأوحى اللهُ إلَيَّ ما أوحى، ففَرَضَ عليَّ خَمسينَ صَلاةً في كُلِّ يَومٍ ولَيلةٍ، فنَزَلتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فقال: ما فرَضَ رَبُّك على أُمَّتِك؟ قُلتُ: خَمسينَ صَلاةً، قال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ؛ فإنَّ أُمَّتَك لا يُطيقونَ ذلك، فإنِّي قد بَلَوتُ بَني إسرائيلَ وخَبَرتُهم، قال: فرَجَعتُ إلى رَبِّي، فقُلتُ: يا رَبِّ، خَفِّفْ على أُمَّتي، فحَطَّ عَنِّي خَمسًا، فرَجَعتُ إلى موسى، فقُلتُ: حَطَّ عَنِّي خَمسًا، قال: إنَّ أُمَّتَك لا يُطيقونَ ذلك، فارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، قال: فلَم أزَلْ أرجِعُ بينَ رَبِّي تَبارَك وتَعالى وبينَ موسى عليه السَّلامُ، حتَّى قال: يا مُحَمَّدُ، إنَّهنَّ خَمسُ صَلَواتٍ كُلَّ يَومٍ ولَيلةٍ، لكُلِّ صَلاةٍ عَشرٌ، فذلك خَمسونَ صَلاةً، ومَن هَمَّ بحَسَنةٍ فلَم يَعمَلْها كُتِبَت له حَسَنةً، فإن عَمِلَها كُتِبَت له عَشرًا، ",["ومَن هَمَّ بسَيِّئةٍ فلَم يَعمَلْها",1]," ",["لَم تُكتَبْ شيئًا",2],"، فإن عَمِلَها كُتِبَت سَيِّئةً واحِدةً، قال: فنَزَلتُ حتَّى انتَهَيتُ إلى موسى صلَّى اللهُ عليه وسلَّم، فأخبَرتُه، فقال: ارجِعْ إلى رَبِّك فاسألْه التَّخفيفَ، فقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: فقُلتُ: قد رَجَعتُ إلى رَبِّي حتَّى استَحيَيتُ منه."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه أبو محمد البغوي في ((شرح السنة)) (3753) بلفظه، والنسائي (450) بنحوه مطولا، وأبو يعلى (3375) مختصرا ببعض لفظه،","bab":"فضائل النبي وصفته ودلائل النبوة › معجزات النبي","dorar":"jwUaVu3q","merged":3,"otherRefs":["تخريج المسند لشعيب 7196 (صحيح)","عمدة التفسير 1/846 (صحيح)"]},{"id":"س-06880","fp":"44e3c66c46a8","stateId":107,"easy":"إذا هممت بسيئة فلم تعملها ← تُكتب لك حسنة","cause":"ومن همَّ بسيِّئةٍ فلم يعملْها","result":"كُتِبتْ له حسنةً","explicit":true,"repOf":"س-01096","otherNeedIds":[45],"ref":"حلية الأولياء 2/349","text":["عن النَّبيِّ صلَّى اللهُ عليه وسلَّم فيما يروي عن ربِّه عزَّ وجلَّ ، قال : إنَّ ربَّكم تعالَى رحيمٌ ؛ من همَّ بحسنةٍ فلم يعملْها كُتِبتْ له حسنةً ، فإن عمِلها كُتِبتْ له عشرَ أمثالِها ، إلى سبعِمائةِ ضعفٍ إلى أضعافٍ كثيرةٍ ، ",["ومن همَّ بسيِّئةٍ فلم يعملْها",1]," ",["كُتِبتْ له حسنةً",2]," ، فإن عمِلها كُتِبتْ عليه واحدةً أو يمحوها ، ولا يهلِكُ على اللهِ عزَّ وجلَّ إلَّا هالكٌ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","takhrij":"أخرجه ابن أبي الدنيا في ((التوبة)) (26)، والطبراني (12/ 161) (12760) واللفظ لهما.","bab":"عقيدة › إثبات صفات الله تعالى","dorar":"CxNQv4ZM"},{"id":"س-05457","fp":"96525b6f4fc7","stateId":107,"easy":"إذا تركت الحرام خوفاً من الله بعد قدرتك عليه ← يغفر الله لك (من قصة الكفل)","cause":"اذهَبِي والدَّنانيرُ لَكِ، قالَ: ثُمَّ قالَ: واللهِ لا يَعصِي الكِفْلُ ربَّهُ أبدًا","result":"قدْ غُفِرَ للكِفْلِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"otherNeedIds":[20],"ref":"المستدرك على الصحيحين 7860","srcLabel":"الترمذي","text":["لَقدْ سَمِعْتُ مِن فِي رَسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ حَديثًا، لو لمْ أسمَعْهُ إلَّا مرَّةً أو مرَّتَيْنِ -حتَّى عَدَّ سَبْعًا- ولكِنِّي سمِعْتُه أكثرَ مِن ذلكَ، قالَ: كان الكِفْلُ مِن بَني إسرائيلَ لا يَتوَرَّعُ عنْ ذنْبٍ عمِلَه، فأتَتْهُ امرأةً فأعطاها سِتِّينَ دِينارًا على أنْ يَطَأَها، فلَمَّا قَعَدَ منها مَقْعَدَ الرُّجلِ مِن امرأتِهِ أَرْعَدَتْ فبَكَتْ، فقالَ: ما يُبكِيكِ، أكْرَهتُكِ؟ قالتْ: لا، ولكنْ هذا عمَلٌ لم أعمَلْهُ قَطُّ، وإنَّما حَمَلني عليه الحاجةُ، قالَ: فتَفعلِينَ هذا ولَمْ تَفْعليهِ قَطُّ؟! قالَ: ثمَّ نزَلَ، فقالَ: ",["اذهَبِي والدَّنانيرُ لَكِ، قالَ: ثُمَّ قالَ: واللهِ لا يَعصِي الكِفْلُ ربَّهُ أبدًا",1],"، فماتَ مِن لَيلتِه، وأصبحَ مَكتوبًا على بابِهِ: ",["قدْ غُفِرَ للكِفْلِ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2496)، والبزار (5388) كلاهما بلفظه، وأحمد (4747) باختلاف يسير.","bab":"رقائق وزهد › الخوف من الله","dorar":"we47xhMK","merged":2,"otherRefs":["الترغيب والترهيب 4/207 (صحيح)"]},{"id":"س-07728","fp":"7275e840f95f","stateId":107,"easy":"إذا قلت «سمعنا وأطعنا غفرانك ربنا» ← يخفف الله عنك (نُسخت المؤاخذة بحديث النفس)","cause":"قالوا: سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ، فلَمَّا اقتَرَأها","result":"فلَمَّا فعَلوا ذلك نَسَخَها اللهُ تَعالى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«سمعنا وأطعنا غفرانك ربنا»"},"otherNeedIds":[29],"ref":"صحيح مسلم 125","srcLabel":"مسلم","text":["لَمَّا نَزَلَت على رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم {للَّهِ ما في السَّماواتِ وما في الأرضِ وإن تُبدوا ما في أنفُسِكُم أو تُخفوه يُحاسِبكُم به اللهُ فيَغفِرُ لمَن يَشاءُ ويُعَذِّبُ مَن يَشاءُ والله على كُلِّ شيءٍ قديرٌ} [البقرة: 284]، قال: فاشتَدَّ ذلك على أصحابِ رَسولِ اللهِ صلَّى اللهُ عليه وسلَّم، فأتَوا رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم ثُمَّ بَرَكوا على الرُّكَبِ، فقالوا: أي رَسولَ اللهِ، كُلِّفنا مِنَ الأعمالِ ما نُطيقُ، الصَّلاةَ والصِّيامَ والجِهادَ والصَّدَقةَ، وقد أُنزِلَت عليك هذه الآيةُ ولا نُطيقُها، قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: أتُريدونَ أن تَقولوا كما قال أهلُ الكِتابَينِ مِن قَبلِكُم: سَمِعنا وعَصَينا؟ بَل قولوا: سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ، ",["قالوا: سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ، فلَمَّا اقتَرَأها",1]," القَومُ ذَلَّت بها ألسِنَتُهم، فأنزَلَ اللهُ في إثرِها: {آمَنَ الرَّسولُ بما أُنزِلَ إليه مِن رَبِّه والمُؤمِنونَ كُلٌّ آمَنَ باللهِ ومَلائِكَتِه وكُتُبِه ورُسُلِه لا نُفَرِّقُ بينَ أحَدٍ مِن رُسُلِه وقالوا سَمِعنا وأطَعنا غُفرانَك رَبَّنا وإلَيك المَصيرُ} [البقرة: 285]، ",["فلَمَّا فعَلوا ذلك نَسَخَها اللهُ تَعالى",2],"، فأنزَلَ اللهُ عزَّ وجلَّ: {لا يُكَلِّفُ اللهُ نَفسًا إلَّا وُسعَها لها ما كَسَبَت وعليها ما اكتَسَبَت رَبَّنا لا تُؤاخِذنا إن نَسينا أو أخطَأنا} [البقرة: 286] قال: نَعَم {رَبَّنا ولا تَحمِل علينا إصرًا كما حَمَلتَه على الذينَ مِن قَبلِنا} قال: نَعَم {رَبَّنا ولا تُحَمِّلنا ما لا طاقةَ لنا بهِ} قال: نَعَم {واعفُ عَنَّا واغفِرْ لنا وارحَمنا أنتَ مَولانا فانصُرنا على القَومِ الكافِرينَ} قال: نَعَم."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (125)","bab":"قرآن › أسباب النزول","dorar":"y4sV2OZk"},{"id":"س-07722","fp":"a1939dc45dd1","stateId":107,"easy":"إذا قلت «سمعنا وأطعنا» واستسلمت لأمر الله ← يتجاوز الله لك عن حديث النفس","cause":"قولوا: سمِعنا وأطَعنا","result":"فتجَوَّزَ لهم عن حَديثِ النَّفْسِ","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«سمعنا وأطعنا»"},"ref":"تخريج المسند لشعيب 3070","srcLabel":"أحمد","text":["دخلتُ على ابنِ عبَّاسٍ، فقُلتُ: يا أبا عبَّاسٍ، كنتُ عندَ ابنِ عُمَرَ، فقرَأَ هذه الآيَةَ فبكى. قال: أَيَّةُ آيَةٍ؟ قُلتُ: {إِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ} [البقرة: 284]. قال ابنُ عبَّاسٍ: إنَّ هذه الآيَةَ حين أُنزِلَت، غَمَّت أَصحابَ رسولِ اللهِ صلَّى اللهُ عليه وسلَّمَ غَمًّا شَديدًا، وغاظَتهم غَيظًا شَديدًا، يَعني، وقالوا: يا رسولَ اللهِ، هلَكنا، إنْ كنا نُؤاخَذُ بما تكلَّمنا، وبما نَعمَلُ، فأمَّا قُلوبُنا فليست بأَيدينا. فقال لهم رسولُ اللهِ صلَّى اللهُ عليه وسلَّمَ: ",["قولوا: سمِعنا وأطَعنا",1],". قالوا: سمِعنا وأطَعنا، قال: فنسَخَتْها هذه الآيَةُ: {آمَنَ الرَّسُولُ بِمَا أُنزِلَ إلَيهِ مِن رَبِّهِ والْمُؤْمِنُونَ} [البقرة: 285] إلى {لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ} [البقرة: 286]، ",["فتجَوَّزَ لهم عن حَديثِ النَّفْسِ",2],"، وأُخِذوا بالأَعمالِ."],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح على شرط الشيخين","takhrij":"أخرجه أحمد (3070) واللفظ له، وعبدالرزاق في ((التفسير)) (374)، والطبري في ((التفسير)) (6461)","bab":"قرآن › أسباب النزول","dorar":"SNGjeXGo"},{"id":"س-04031","fp":"320adb103fb0","stateId":107,"easy":"إذا حدّثت نفسك بسيئة ← يغفرها الله ما لم تعملها","cause":"وإذا تَحَدَّثَ بأن يَعمَلَ سَيِّئةً","result":"فأنا أغفِرُها له ما لَم يَعمَلْها","explicit":true,"ref":"صحيح مسلم 129","srcLabel":"متفق عليه","text":["قال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قال اللهُ عزَّ وجلَّ: إذا تَحَدَّثَ عَبدي بأن يَعمَلَ حَسَنةً فأنا أكتُبُها له حَسَنةً ما لَم يَعمَلْ، فإذا عَمِلَها فأنا أكتُبُها بعَشرِ أمثالِها، ",["وإذا تَحَدَّثَ بأن يَعمَلَ سَيِّئةً",1]," ",["فأنا أغفِرُها له ما لَم يَعمَلْها",2],"، فإذا عَمِلَها فأنا أكتُبُها له بمِثلِها. وقال رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم: قالتِ الملائِكةُ: رَبِّ، ذاك عَبدُك يُريدُ أن يَعمَلَ سَيِّئةً، وهو أبصَرُ به، فقال: ارقُبوه فإن عَمِلَها فاكتُبوها له بمِثلِها، وإن تَرَكَها فاكتُبوها له حَسَنةً، إنَّما تَرَكَها مِن جَرَّايَ. وقال رسولُ اللهِ صلَّى اللهُ عليه وسلَّم: إذا أحسَنَ أحَدُكُم إسلامَه، فكُلُّ حَسَنةٍ يَعمَلُها تُكتَبُ بعَشرِ أمثالِها إلى سَبعِ مِئةِ ضِعفٍ، وكُلُّ سَيِّئةٍ يَعمَلُها تُكتَبُ بمِثلِها حتَّى يَلقى اللهَ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (42)، ومسلم (129).","bab":"توبة › سعة رحمة الله تعالى وأنها سبقت غضبه","dorar":"2jngWHp5"},{"id":"س-06313","fp":"a2c03ec0c5bf","stateId":108,"easy":"إذا حلفت باللات (أو بغير الله) سهواً ← فقل «لا إله إلا الله» كفارة","cause":"فليَقُلْ: لا إلَهَ إلَّا اللهُ","result":"مَن حَلَفَ مِنكُم فقال في حَلِفِه: باللَّاتِ","explicit":true,"star":true,"ref":"صحيح مسلم 1647","srcLabel":"متفق عليه","text":[["مَن حَلَفَ مِنكُم فقال في حَلِفِه: باللَّاتِ",2],"، ",["فليَقُلْ: لا إلَهَ إلَّا اللهُ",1],"، ومَن قال لصاحِبِه: تَعالَ أُقامِرْك، فليَتَصَدَّقْ. [وفي روايةٍ]: فليَتَصَدَّقْ بشيءٍ. وفي حَديثِ الأوزاعيِّ: مَن حَلَفَ باللَّاتِ والعُزَّى."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4860)، ومسلم (1647).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Y0whuWoU"},{"id":"س-01230","fp":"b6eada388f37","stateId":108,"easy":"إذا حلفت بغير الله فقل «لا إله إلا الله» واتفل عن شمالك وتعوّذ ← يُكفّر ذلك","cause":"قُلْ: لا إلهَ إلَّا اللهُ وَحدَهُ، ثَلاثًا، واتفُلْ عن شِمالِكَ ثَلاثًا، وتعَوَّذْ باللهِ مِنَ الشَّيطانِ، ولا تَعُدْ","result":"وإنِّي حَلَفتُ باللَّاتِ والعُزَّى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا إله إلا الله»"},"similar":["س-02595"],"ref":"تخريج المسند لشاكر 3/103","srcLabel":"النسائي","text":["عن سَعدِ بنِ أبي وَقَّاصٍ أنَّه حَلَفَ باللَّاتِ والعُزَّى، فقال له أصحابُهُ: قد قُلتَ هُجْرًا. فأتى النَّبيَّ صلَّى اللهُ عليه وسلَّمَ فقال: إنَّ العَهدَ كان حَديثًا، ",["وإنِّي حَلَفتُ باللَّاتِ والعُزَّى",2],". فقال له النَّبيُّ صلَّى اللهُ عليه وسلَّمَ: ",["قُلْ: لا إلهَ إلَّا اللهُ وَحدَهُ، ثَلاثًا، واتفُلْ عن شِمالِكَ ثَلاثًا، وتعَوَّذْ باللهِ مِنَ الشَّيطانِ، ولا تَعُدْ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (1622)، والنسائي (3777) بلفظه، وابن حبان (4365) باختلاف يسير.","bab":"أدعية وأذكار › فضل لا إله إلا الله","dorar":"3ePmZCEF","merged":6,"otherRefs":["تخريج سنن أبي داود 5/151 (صحيح)","الأحاديث المختارة 1060 (صحيح)","الصحيح المسند 369 (صحيح)","البحر الزخار 3/341 (صحيح)","تخريج مشكل الآثار 832 (صحيح)"]},{"id":"س-02595","fp":"6e32e31e21d4","stateId":108,"easy":"إذا حلفت باللات والعزى (بغير الله) فقل «لا إله إلا الله وحده...» ← يُكفّر ذلك","cause":"قل : لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ثلاثَ مراتٍ وتعوَّذْ باللهِ من الشيطانِ ثلاثَ مراتٍ وانفُثْ عن شمالِك ثلاثَ مراتٍ ولا تَعُدْ لهُ","result":"حلفتُ باللاتِ والعُزَّى","explicit":true,"ijtihad":true,"ijtihadWhy":["واقعة أو قصة بعينها، وجعلها سنّة عامة اجتهاد"],"apply":{"k":"say","t":"«لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له»"},"repOf":"س-01230","ref":"المحلى 8/51","text":[["حلفتُ باللاتِ والعُزَّى",2]," فقال لي أصحابُ رسولِ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ بئس ما قلتَ إئتِ رسولَ اللهِ صلَّى اللهُ عليْهِ وسلَّمَ فأخبِرْهُ فإنَّا لا نراك إلا قد كفرتَ فلقيتُه فأخبرتُه فقال لي : ",["قل : لا إلهَ إلَّا اللهُ وحدَه لا شريكَ له ثلاثَ مراتٍ وتعوَّذْ باللهِ من الشيطانِ ثلاثَ مراتٍ وانفُثْ عن شمالِك ثلاثَ مراتٍ ولا تَعُدْ لهُ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"احتج به ، وقال في المقدمة: (لم نحتج إلا بخبر صحيح من رواية الثقات مسند)","takhrij":"أخرجه النسائي في ((الكبرى)) (4699) واللفظ له، وابن ماجه (2097)، وأحمد (1590) بنحوه","bab":"إيمان › أعمال تنافي الإيمان","dorar":"QWuTjtFL"},{"id":"س-03774","fp":"1b037f1fec04","stateId":108,"easy":"إذا ردّتك الطيرة عن حاجتك فقل «اللهم لا خير إلا خيرك...» ← يكون كفارة لذلك","cause":"أن يَقولَ أحدُهُم اللَّهمَّ لا خَيرَ إلَّا خيرُكَ","result":"ما كفَّارةُ ذلِكَ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة لا تُفهم إلا بسياقها (سؤال أو جواب أو عبارة مبتورة)"],"apply":{"k":"say","t":"«اللَّهمَّ لا خَيرَ إلَّا خيرُكَ ولا طيرَ إلَّا طيرُكَ ولا إلَهَ غَيرُك»"},"otherNeedIds":[31],"ref":"تخريج المسند لشاكر 12/10","srcLabel":"أحمد","text":["من ردَّتهُ الطِّيَرةُ مِن حاجةٍ فقد أشرَكَ قالوا يا رسولَ اللَّهِ ",["ما كفَّارةُ ذلِكَ",2]," قالَ ",["أن يَقولَ أحدُهُم اللَّهمَّ لا خَيرَ إلَّا خيرُكَ",1]," ولا طيرَ إلَّا طيرُكَ ولا إلَهَ غَيرُكَ"],"grade":"صحيح","narrator":"عبدالله بن عمرو","muhaddith":"إسناده صحيح","takhrij":"أخرجه أحمد (7045) واللفظ له، والطبراني (14/35) (14622)","bab":"الكفر والشرك › ذم الشرك وما ورد فيه من العقوبة","dorar":"c4gxT93I"},{"id":"س-03948","fp":"105980444704","stateId":108,"easy":"إذا نسيت صلاة ← فصلّها إذا ذكرتها، ولا كفارة لها غير ذلك","cause":"مَن نَسيَ صَلاةً فليُصَلِّ إذا ذَكَرَها","result":"لا كَفَّارةَ لَها إلَّا ذلك","explicit":true,"ref":"صحيح البخاري 597","srcLabel":"متفق عليه","text":[["مَن نَسيَ صَلاةً فليُصَلِّ إذا ذَكَرَها",1],"، ",["لا كَفَّارةَ لَها إلَّا ذلك",2]," {وأقِمِ الصَّلاةَ لذِكري} [طه: 14]. قال موسى: قال هَمَّامٌ: سَمِعتُه يقولُ: بَعدُ: وأقِمِ الصَّلاةَ للذِّكْرى."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (597)، ومسلم (684)","bab":"تفسير آيات › سورة طه","dorar":"NNCrx3cP"},{"id":"س-06605","fp":"d612b06cbc80","stateId":108,"easy":"إذا صليت ركعتين (بعد الخصام) ← تكون كفارة لكل ملاحاة (مخاصمة)","cause":"رَكْعَتَانِ","result":"تَكْفيرُ كلِّ لِحاءٍ","explicit":true,"apply":{"k":"count","t":"ركعتين"},"ref":"السلسلة الصحيحة 1789","srcLabel":"ابن الأعرابي","text":[["تَكْفيرُ كلِّ لِحاءٍ",2]," ",["رَكْعَتَانِ",1]],"grade":"حسن","narrator":"أبو هريرة","muhaddith":"إسناده حسن رجاله ثقات","takhrij":"أخرجه ابن الأعرابي في ((معجمه)) (1811)، وتمام في ((فوائده)) (939)، والديلمي في ((الفردوس)) (2387)","bab":"صلاة › فضل الصلوات والمحافظة عليها","dorar":"Bl5SiGTw"},{"id":"س-06314","fp":"ce8cf5e46f96","stateId":108,"easy":"إذا قلت لصاحبك «تعال أقامرك» ← فتصدّق كفارة لقولك","cause":"فليَتَصَدَّقْ","result":"مَن قال لصاحِبِه: تَعالَ أُقامِرْك","explicit":true,"star":true,"apply":{"k":"say","t":"«تعال أقامرك»"},"ref":"صحيح مسلم 1647","srcLabel":"متفق عليه","text":["مَن حَلَفَ مِنكُم فقال في حَلِفِه: باللَّاتِ، فليَقُلْ: لا إلَهَ إلَّا اللهُ، و",["مَن قال لصاحِبِه: تَعالَ أُقامِرْك",2],"، ",["فليَتَصَدَّقْ",1],". [وفي روايةٍ]: فليَتَصَدَّقْ بشيءٍ. وفي حَديثِ الأوزاعيِّ: مَن حَلَفَ باللَّاتِ والعُزَّى."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (4860)، ومسلم (1647).","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"Y0whuWoU","merged":2,"otherRefs":["تخريج مشكل الآثار 3298 (صحيح)"]},{"id":"س-06335","fp":"071b2c61003d","stateId":108,"easy":"إذا كنت تاجراً يحضر تجارتك الحلف واللغو ← فاخلطها بالصدقة","cause":"فشُوبوه بالصَّدَقةِ","result":"يَحضُرُه الحَلِفُ والكَذِبُ","explicit":true,"star":true,"ref":"تخريج سنن أبي داود 3327","srcLabel":"أبو داود","text":["بمَعناه [أيْ بمَعنى حَديثِ: قال: كُنَّا في عَهدِ رَسولِ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ نُسمَّى السَّماسِرةَ، فمَرَّ بنا رَسولُ اللَّهِ صلَّى اللَّهُ عليه وسلَّمَ فسَمَّانا باسمٍ هو أحسَنُ منه، فقال: يا مَعشَرَ التُّجَّارِ، إنَّ البَيعَ يَحضُرُه اللَّغوُ والحَلِفُ، ",["فشُوبوه بالصَّدَقةِ",1],"]، قال: ",["يَحضُرُه الحَلِفُ والكَذِبُ",2],". وقال عَبدُ اللهِ الزُّهريُّ: اللَّغوُ والكَذِبُ."],"grade":"صحيح","narrator":"قيس بن أبي غرزة","muhaddith":"إسناده صحيح","takhrij":"أخرجه أبو داود (3327)، والنسائي (3797) كلاهما بلفظه، والترمذي (1208) بنحوه مطولا.","bab":"صدقة › فضل الصدقة والحث عليها","dorar":"N2G96lUg","merged":14,"otherRefs":["تخريج المسند لشعيب 18467 (صحيح)","صحيح النسائي 3809 (صحيح)","شرح البخاري لابن الملقن 14/182 (صحيح)","صحيح الترمذي 1208 (صحيح)","صحيح النسائي 3806 (صحيح)","تخريج المسند لشعيب 16134 (صحيح)","تخريج المسند لشعيب 16137 (صحيح)","تخريج المسند لشعيب 16138 (صحيح)","تخريج مشكل الآثار 2080 (صحيح)","المستدرك على الصحيحين 2170 (صحيح)","صحيح النسائي 3807 (صحيح)","صحيح النسائي 4475 (صحيح)","تخريج المسند لشعيب 16136 (صحيح)"]},{"id":"س-05288","fp":"1eef3aa7e136","stateId":108,"easy":"إذا أتيت امرأتك في حيضها ← فتصدّق بدينار كفارة","cause":"فليَتَصَدَّقْ بدينارٍ","result":"مَن أتى امرَأتَه في حَيضِها","explicit":true,"ref":"فيض القدير 6/ 25","srcLabel":"فيض القدير","text":[["مَن أتى امرَأتَه في حَيضِها",2]," ",["فليَتَصَدَّقْ بدينارٍ",1],"، ومَن أتاها وقد أدبَرَ الدَّمُ عَنها ولَم تَغتَسِلْ فنِصفُ دينارٍ"],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ksWnDbZV"},{"id":"س-05289","fp":"0eeb7833bca2","stateId":108,"easy":"إذا أتيتها وقد انقطع الدم ولم تغتسل ← فتصدّق بنصف دينار","cause":"فنِصفُ دينارٍ","result":"ومَن أتاها وقد أدبَرَ الدَّمُ عَنها ولَم تَغتَسِلْ","explicit":true,"ref":"فيض القدير 6/ 25","srcLabel":"فيض القدير","text":["مَن أتى امرَأتَه في حَيضِها فليَتَصَدَّقْ بدينارٍ، ",["ومَن أتاها وقد أدبَرَ الدَّمُ عَنها ولَم تَغتَسِلْ",2]," ",["فنِصفُ دينارٍ",1]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"صحيح","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"ksWnDbZV"},{"id":"س-02042","fp":"16420348e771","stateId":108,"easy":"إذا خالط تجارتك اللغو والكذب فشُبها بالصدقة ← تكفّرها","cause":"فشُوبوها بالصَّدقةِ","result":"إنَّ هذه السُّوقَ يُخالِطُها اللَّغوُ والكذبُ","explicit":false,"ijtihad":true,"ijtihadWhy":["النتيجة مفهومة ضمناً لا منطوقة"],"ref":"صحيح النسائي 3808","srcLabel":"أبو داود","text":[["إنَّ هذه السُّوقَ يُخالِطُها اللَّغوُ والكذبُ",2]," ، ",["فشُوبوها بالصَّدقةِ",1]],"grade":"صحيح","narrator":"قيس بن أبي غرزة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (3799) بلفظه، وأبو داود (3326)، والترمذي (1208) كلاهما بنحوه مطولا.","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"AbOGFWIb"},{"id":"س-06781","fp":"a67094e4fc54","stateId":108,"easy":"إذا ضربت مملوكك حداً لم يأته أو لطمته ← فكفارته أن تعتقه","cause":"أن يُعتِقَه","result":"مَن ضَرَبَ غُلامًا له حَدًّا لم يَأتِه، أو لَطَمَه؛ فإنَّ كَفَّارَتَه","explicit":true,"star":true,"ref":"صحيح مسلم 1657","srcLabel":"متفق عليه","text":["عن زاذانَ، أنَّ ابنَ عُمَرَ دَعا بغُلامٍ له فرَأى بظَهرِه أثَرًا، فقال له: أوجَعتُكَ؟ قال: لا، قال: فأنتَ عَتيقٌ، قال: ثُمَّ أخَذَ شيئًا مِنَ الأرضِ، فقال: ما لي فيه مِنَ الأجرِ ما يَزِنُ هذا، إنِّي سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: ",["مَن ضَرَبَ غُلامًا له حَدًّا لم يَأتِه، أو لَطَمَه؛ فإنَّ كَفَّارَتَه",2]," ",["أن يُعتِقَه",1],". [وفي روايةٍ]: أمَّا حَديثُ ابنِ مَهديٍّ، فذَكَرَ فيه حَدًّا لم يَأتِه. وفي حَديثِ وكيعٍ: مَن لَطَمَ عَبدَه، ولم يَذكُرِ الحَدَّ."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"[صحيح]","takhrij":"من أفراد مسلم على البخاري","bab":"عتق وولاء › الإحسان إلى العبيد","dorar":"f0jSG27I","merged":7,"otherRefs":["تفسير القرطبي 6/315 (صحيح)","الإعراب عن الحيرة والالتباس 2/514 (صحيح)","صحيح الترغيب 2278 (صحيح)","تخريج المسند لشعيب 5266 (صحيح)","صحيح الأدب المفرد 133 (صحيح)","تخريج المسند لشعيب 5267 (صحيح)"]},{"id":"س-07205","fp":"56a91ecf7a3d","stateId":108,"easy":"إذا بصقت في المسجد ← فكفارتها أن تدفنها","cause":"دَفنُها","result":"وكَفَّارَتُها","explicit":true,"star":true,"otherNeedIds":[45],"ref":"صحيح مسلم 552","srcLabel":"البخاري","text":["سَألتُ قَتادةَ عَنِ التَّفلِ في المَسجِدِ، فقال: سَمِعتُ أنَسَ بنَ مالِكٍ يقولُ: سَمِعتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ: التَّفلُ في المَسجِدِ خَطيئةٌ، ",["وكَفَّارَتُها",2]," ",["دَفنُها",1],"."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"[صحيح]","takhrij":"أخرجه ابن الجعد في ((مسنده)) (937)، وابن شبة في ((تاريخ المدينة)) (1/ 25) كلاهما بلفظه، والبخاري (415)، وأبو داود (474) كلاهما بلفظ مقارب .","bab":"علم › حسن السؤال ونصح العالم","dorar":"tWtanb4E","merged":8,"otherRefs":["صحيح ابن خزيمة 2/ 457 (صحيح)","تخريج المسند لشعيب 13948 (صحيح)","تخريج المسند لشعيب 12891 (صحيح)","تخريج سنن أبي داود 476 (صحيح)","صحيح الجامع 2885 (حسن)","صحيح الترغيب 287 (صحيح)","إرشاد الساري 1/421 (حسن)"]},{"id":"س-03552","fp":"00349748f4cf","stateId":108,"easy":"إذا حلفت على قطيعة رحم أو معصية فحنثت (ولم تفعلها) ← فذلك كفارة لك","cause":"مَن حلفَ بيَمينٍ علَى قطيعةِ رحِمٍ أو مَعصيةٍ فحنَثَ","result":"فذلِكَ كفَّارةٌ لَهُ","explicit":true,"ref":"السلسلة الصحيحة 5/441","srcLabel":"ابن حبان","text":[["مَن حلفَ بيَمينٍ علَى قطيعةِ رحِمٍ أو مَعصيةٍ فحنَثَ",1]," ",["فذلِكَ كفَّارةٌ لَهُ",2]],"grade":"صحيح","narrator":"عبدالله بن عباس","muhaddith":"إسناده صحيح","takhrij":"أخرجه ابن حبان (4344) بنحوه، والطحاوي في ((شرح مشكل الآثار)) (664)، وأبو طاهر المخلص في ((المخلصيات)) (283) باختلاف يسير.","bab":"استغفار › مكفرات الذنوب","dorar":"QQaPO2pa"}]}