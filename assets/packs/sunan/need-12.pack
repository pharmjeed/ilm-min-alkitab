{"schema":1,"kind":"sunan-chunk","version":"sunan-98a69b4361e7","needId":12,"stateIds":[100,101,102,103,104,105,106,107,108],"items":[{"id":"س-01803","fp":"d8034051adf0","stateId":100,"easy":"إذا أخطأت ثم استغفرت الله ← يغفر لك","cause":"يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ","result":"فيَغفِرُ لهم","explicit":true,"star":true,"similar":["س-06976","س-03459","س-07479","س-01101"],"ref":"الأحاديث المختارة 1544","srcLabel":"البخاري","text":["«دخَلْتُ على أنَسِ بنِ مالِكٍ قال: سَمِعْتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يَقولُ: والذي نفسي بيَدِه -أو والذي نَفْسُ مُحَمَّدٍ بيَدِه- لو أخطَأْتُم حتَّى تملأَ خطاياكم ما بَيْنَ السَّماءِ والأرضِ، ثُمَّ استغفَرْتُم اللهَ لغَفَر لكم، والذي نَفْسُ مُحَمَّد بيَدِه -أو والذي نفسي بيَدِه لو لم تُخِطئوا لجاء اللهُ بقومٍ ",["يُخطِئون، ثُمَّ يَستَغفِرونَ اللهَ",1]," ",["فيَغفِرُ لهم",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"أيمان › كيف كانت يمين رسول الله صلى الله عليه وسلم","dorar":"cMqHprTP","merged":5,"otherRefs":["تخريج شرح السنة 1295 (صحيح)","صحيح الجامع 5243 (صحيح)","صحيح مسلم 2749 (صحيح)","صحيح الجامع 5329 (صحيح)"]},{"id":"س-03137","fp":"bd723a80654c","stateId":100,"easy":"إذا أذنبت بالليل فتبت بالنهار (والعكس) ← يبسط الله يده ليتوب عليك","cause":"ليتوبَ بالنَّهارِ","result":"واضعٌ يدَه لِمُسيءِ اللَّيلِ","explicit":true,"star":true,"ref":"تخريج صحيح ابن حبان 266","srcLabel":"متفق عليه","text":["إنَّ اللهَ لا ينامُ ولا ينبغي له أنْ ينامَ يخفِضُ القِسطَ ويرفَعُه يُرفَعُ إليه عملُ النَّهارِ قبْلَ اللَّيلِ وعمَلُ اللَّيلِ قبْلَ النَّهارِ حجابُه النُّورُ لو كُشِف طبَقُها أحرَق سُبُحاتُ وجهِه كلَّ شيءٍ أدرَكه بصرُه ",["واضعٌ يدَه لِمُسيءِ اللَّيلِ",2]," ",["ليتوبَ بالنَّهارِ",1]," ولِمُسيءِ النَّهارِ ليتوبَ باللَّيلِ حتَّى تطلُعَ الشَّمسُ مِن مغربِها"],"grade":"صحيح","narrator":"أبو موسى الأشعري","muhaddith":"إسناده صحيح على شرط البخاري","takhrij":"أخرجه مسلم (179) باختلاف يسير دون قوله: \"واضع يده ...\"","bab":"إيمان › توحيد الأسماء والصفات","dorar":"dKHdWH3P","merged":3,"otherRefs":["تخريج كتاب السنة 615 (صحيح)","صحيح مسلم 2759 (صحيح)"]},{"id":"س-03463","fp":"de15e8071ffb","stateId":100,"easy":"إذا أُلهمت الاستغفار ← لا تُحرم المغفرة","cause":"ومَن أُلهِمَ الاستِغفارَ","result":"لم يُحرَمِ المغفِرةَ","explicit":true,"ref":"الأحاديث المختارة 1814","srcLabel":"البخاري","text":["«مَن أُلهِمَ خَمسةً لم يُحرَمْ خَمسةً: من أُلهِمَ الدُّعاءَ لم يُحرَمِ الإجابةَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَقَالَ رَبُّكُم ادْعُونِي أَسْتَجِبْ لَكُمْ} ومَن أُلهِمَ التَّوبةَ لم يُحرَمِ القَبولَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ}، ومَن أُلهِمَ الشُّكرَ لم يُحرَمِ الزِّيادةَ؛ لأنَّ اللهَ تعالى يَقولُ: {لَئِنْ شَكَرْتُمْ لَأَزِيدَنَّكُمْ}، ",["ومَن أُلهِمَ الاستِغفارَ ",1],["لم يُحرَمِ المغفِرةَ",2],"؛ لأنَّ اللهَ يَقولُ: {اسْتَغْفِرُوا رَبَّكُمْ إِنَّهُ كَانَ غَفَّارًا}، ومن أُلهِمَ النَّفَقةَ لم يُحرَمِ الخَلَفَ؛ لأنَّ اللهَ تعالى يَقولُ: {وَمَا أَنْفَقْتُمْ مِنْ شَيْءٍ فَهُوَ يُخْلِفُهُ}»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومُسلِم]","bab":"استغفار › فضل الاستغفار","dorar":"NfsF3PxX"},{"id":"س-03466","fp":"254caee6d646","stateId":100,"easy":"إذا اعتذرت إلى الله ← يعذرك","cause":"ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ","result":"عَذَرَه","explicit":true,"ref":"الأحاديث المختارة 2751","srcLabel":"متفق عليه","text":["«مَن كَفَّ غَضَبَه كَفَّ اللهُ عنه عَذابَه، ومَن خَزَنَ لِسانَه سَتَرَ اللهُ عَزَّ وجَلَّ عَوْرتَه، ",["ومَن اعْتَذَرَ إلى اللهِ عَزَّ وجَلَّ",1]," ",["عَذَرَه",2],"»."],"grade":"صحيح","narrator":"أنس بن مالك","muhaddith":"أورده في المختارة وقال [هذه أحاديث اخترتها مما ليس في البخاري ومسلم]","bab":"استغفار › فضل الاستغفار","dorar":"sfCSIGM2"},{"id":"س-07061","fp":"6c82ad4134eb","stateId":100,"easy":"إذا أذنبت ثم استغفرت وتبت ← يُغفر لك ويُتاب عليك","cause":"ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ","result":"يُغْفَرُ لهُ، ويُتابُ عليه","explicit":true,"similar":["س-03440","س-04017","س-03973","س-08211"],"ref":"المستدرك على الصحيحين 196","srcLabel":"البخاري","text":["أنَّ رَجُلًا أَتَى رسولَ اللهِ صلَّى اللهُ عليه وسلَّمَ، فقالَ: يا رسولَ اللهِ، أَحَدُنا يُذْنِبُ، قالَ: «يُكْتَبُ عليه». قالَ: ",["ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ",1],"، قالَ: «",["يُغْفَرُ لهُ، ويُتابُ عليه».",2]," قالَ: فيَعودُ فيُذْنِبُ، قالَ: «يُكْتَبُ عليه»، قالَ: ثُمَّ يَسْتغْفِرُ مِنهُ ويَتوبُ، قالَ: «يُغْفَرُ لهُ، ويُتابُ عليه»، قالَ: فَيعودُ فَيُذْنبُ، قالَ: «يُكْتبُ عليه»، قالَ: ثُمَّ يَسْتَغْفِرُ مِنهُ ويَتوبُ، قالَ: «يُغْفَرُ لهُ، ويُتابُ عليه، ولا يَمَلُّ اللهُ حتَّى تَمَلُّوا»."],"grade":"صحيح","narrator":"عقبة بن عامر الجهني","muhaddith":"صحيح على شرط البخاري","takhrij":"أخرجه الروياني (173)، والطبراني في ((الأوسط)) (8689)، والبيهقي في ((شعب الإيمان)) (6695) جميعهم بلفظه.","bab":"علم › السؤال للانتفاع وإن كثر","dorar":"6WZa7LqV"},{"id":"س-08381","fp":"543bb911d39d","stateId":100,"easy":"إذا عملت سوءاً ثم استغفرت الله ← تجد الله غفوراً رحيماً","cause":"ثُمَّ يَسْتَغْفِرِ اللَّهَ","result":"يَجِدِ اللَّهَ غَفُورًا رَحِيمًا","explicit":true,"similar":["س-03939"],"ref":"المستدرك على الصحيحين 3236","srcLabel":"الطبراني","text":["عنْ عبدِ اللهِ بنِ مسعودٍ رَضيَ اللهُ عنه قالَ: إنَّ في سورةِ النِّساءِ لخمسُ آياتٍ ما يَسُرُّني أنَّ لي بها الدُّنيا وما فيها: {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَإِنْ تَكُ حَسَنَةً يُضَاعِفْهَا وَيُؤْتِ مِن لَدُنْهُ أَجْرًا عَظِيمًا} [النساء: 40]، {إِنْ تَجْتَنِبُوا كَبَائِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَنُدْخِلْكُمْ مُدْخَلًا كَرِيمًا} [النساء: 31]، {إِنَّ اللَّهَ لَا يَغْفِرُ أَنْ يُشْرَكَ بِهِ وَيَغْفِرُ مَا دُونَ ذَلِكَ لِمَنْ يَشَاءُ} [النساء: 48]، {وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاؤُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُوا اللَّهَ تَوَّابًا رَحِيمًا} [النساء: 64]، {وَمَنْ يَعْمَلْ سُوءًا أَوْ يَظْلِمْ نَفْسَهُ ",["ثُمَّ يَسْتَغْفِرِ اللَّهَ",1]," ",["يَجِدِ اللَّهَ غَفُورًا رَحِيمًا",2],"} [النساء: 110]. قالَ عبدُ اللهِ: ما يسُرُّني أنَّ لي بها الدُّنيا وما فيها."],"grade":"صحيح","narrator":"عبد الرحمن بن عبدالله بن مسعود","muhaddith":"[إسناده صحيح إن كان عبد الرحمن سمع من أبيه فقد اختلف في ذلك]","takhrij":"أخرجه الطبراني (9069) (9/  220)، واللالكائي في ((شرح أصول الاعتقاد)) (2000)، والبيهقي في ((شعب الإيمان)) (2202) بنحوه","bab":"مناقب وفضائل › فضائل أصحاب النبي صلى الله عليه وسلم","dorar":"6kfGWkBb","merged":9,"otherRefs":["تخريج شرح السنة 1015 (حسن)","العجاب في بيان الأسباب 1/352 (حسن)","مجمع الزوائد 7/14 (صحيح)","إتحاف الخيرة المهرة 6/198 (صحيح)","تخريج المسند لشعيب 47 (صحيح)","عمدة التفسير 1/571 (صحيح)"]},{"id":"ق-0015","fp":"b5339180a2c9","stateId":100,"easy":"التوبة إلى الله ← توبة الله ورحمته","cause":"التوبة إلى الله","result":"توبة الله ورحمته","explicit":true,"similar":["ق-0327"],"ref":"سورة البقرة: 54","srcLabel":"القرآن الكريم","quran":{"s":2,"from":54,"to":54,"text":"وَإِذْ قَالَ مُوسَى لِقَوْمِهِ يَا قَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَى بَارِئِكُمْ فَاقْتُلُوا أَنْفُسَكُمْ ذَلِكُمْ خَيْرٌ لَكُمْ عِنْدَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ (54)","hl":[[102,197,1],[197,251,2]]}},{"id":"ق-0055","fp":"c4302e950254","stateId":100,"easy":"التوبة والإصلاح والبيان ← توبة الله ورحمته","cause":"التوبة والإصلاح والبيان","result":"توبة الله ورحمته","explicit":true,"similar":["ق-0142","ق-0848"],"ref":"سورة البقرة: 160","srcLabel":"القرآن الكريم","quran":{"s":2,"from":160,"to":160,"text":"إِلَّا الَّذِينَ تَابُوا وَأَصْلَحُوا وَبَيَّنُوا فَأُولَئِكَ أَتُوبُ عَلَيْهِمْ وَأَنَا التَّوَّابُ الرَّحِيمُ (160)","hl":[[7,50,1],[50,111,2]]}},{"id":"ق-0110","fp":"413dfb8e5769","stateId":100,"easy":"الانتهاء عن الربا بعد الموعظة ← العفو عمّا سلف","cause":"الانتهاء عن الربا بعد الموعظة","result":"العفو عمّا سلف","explicit":true,"ref":"سورة البقرة: 275","srcLabel":"القرآن الكريم","quran":{"s":2,"from":275,"to":275,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ذَلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَى فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ وَمَنْ عَادَ فَأُولَئِكَ أَصْحَابُ النَّارِ هُمْ فِيهَا خَالِدُونَ (275)","hl":[[225,275,1],[275,292,2],[292,317,1]]}},{"id":"ق-0142","fp":"95572d89f7c3","stateId":100,"easy":"التوبة والإصلاح ← مغفرة الله ورحمته","cause":"التوبة والإصلاح","result":"مغفرة الله ورحمته","explicit":true,"repOf":"ق-0055","ref":"سورة آل عمران: 89","quran":{"s":3,"from":89,"to":89,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ (89)","hl":[[7,57,1],[57,88,2]]}},{"id":"ق-0164","fp":"3926aa7918b2","stateId":100,"easy":"ذكر الله والاستغفار بعد الفاحشة وظلم النفس وترك الإصرار ← مغفرة من الله وجنات ونعم أجر العاملين","cause":"ذكر الله والاستغفار بعد الفاحشة وظلم النفس وترك الإصرار","result":"مغفرة من الله وجنات ونعم أجر العاملين","explicit":true,"otherNeedIds":[67],"ref":"سورة آل عمران: 135–136","srcLabel":"القرآن الكريم","quran":{"s":3,"from":135,"to":136,"text":"وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلَّا اللَّهُ وَلَمْ يُصِرُّوا عَلَى مَا فَعَلُوا وَهُمْ يَعْلَمُونَ (135) أُولَئِكَ جَزَاؤُهُمْ مَغْفِرَةٌ مِنْ رَبِّهِمْ وَجَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَنِعْمَ أَجْرُ الْعَامِلِينَ (136)","hl":[[0,214,1],[214,356,2]]}},{"id":"ق-0227","fp":"88c7af29f114","stateId":100,"easy":"المجيء إلى الرسول واستغفار الله بعد ظلم النفس ← وجدان الله تواباً رحيماً","cause":"المجيء إلى الرسول واستغفار الله بعد ظلم النفس","result":"وجدان الله تواباً رحيماً","explicit":true,"similar":["ق-0244"],"ref":"سورة النساء: 64","srcLabel":"القرآن الكريم","quran":{"s":4,"from":64,"to":64,"text":"وَمَا أَرْسَلْنَا مِنْ رَسُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ اللَّهِ وَلَوْ أَنَّهُمْ إِذْ ظَلَمُوا أَنْفُسَهُمْ جَاءُوكَ فَاسْتَغْفَرُوا اللَّهَ وَاسْتَغْفَرَ لَهُمُ الرَّسُولُ لَوَجَدُو