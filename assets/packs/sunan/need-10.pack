{"schema":1,"kind":"sunan-chunk","version":"sunan-c56d7b8d0f22","needId":10,"stateIds":[58,59,60,61,62],"items":[{"id":"س-04089","fp":"0d4faedadce6","stateId":58,"easy":"إذا لم تقم من الليل ← تصبح خبيث النفس كسلان","cause":"وإلَّا","result":"أصبَحَ خَبيثَ النَّفسِ كَسلانَ","explicit":true,"star":true,"otherNeedIds":[34],"ref":"صحيح البخاري 3269","srcLabel":"مسلم","text":["أنَّ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم، قال: يَعقِدُ الشَّيطانُ على قافيةِ رَأسِ أحَدِكُم إذا هو نامَ ثَلاثَ عُقدٍ، يَضرِبُ كُلَّ عُقدةٍ مَكانَها: عليك لَيلٌ طَويلٌ فارقُدْ، فإنِ استَيقَظَ فذَكَرَ اللهَ انحَلَّت عُقدةٌ، فإن تَوضَّأ انحَلَّت عُقدةٌ، فإن صَلَّى انحَلَّت عُقدُه كُلُّها، فأصبَحَ نَشيطًا طَيِّبَ النَّفسِ، ",["وإلَّا",1]," ",["أصبَحَ خَبيثَ النَّفسِ كَسلانَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه مسلم (776) باختلاف يسير","bab":"جن › صفة إبليس وجنوده","dorar":"Vqe3YouH","merged":3,"otherRefs":["صحيح مسلم 776 (صحيح)","صحيح ابن ماجه 1102 (صحيح)"]},{"id":"س-00898","fp":"521be59e7f94","stateId":58,"easy":"إذا أصبحت ولم تذكر الله ← تصبح ثقيلاً كسلان لم تصب خيراً","cause":"وإن أصبحَ ولم يذكرِ اللَّهَ","result":"أصبحَ وعقدُهُ عليهِ ، وأصبحَ ثقيلًا كَسلانًا لم يصب خيرًا","explicit":true,"otherNeedIds":[34,69],"ref":"صحيح الموارد 147","srcLabel":"أحمد","text":["ما مِن مسلمٍ ذَكَرٍ ولا أنثى يَنامُ إلَّا وعليهِ جريرٌ معقودٌ ، [ فإنِ استيقظَ فذَكَرَ اللَّهَ انحلَّت عقدةٌ ] ، وإن هوَ توضَّأَ ثمَّ قامَ إلى الصَّلاةِ ؛ أصبحَ نشيطًا قد أصابَ خيرًا وقدِ انحلَّت عقَدُهُ كلُّها ، ",["وإن أصبحَ ولم يذكرِ اللَّهَ",1]," ",["أصبحَ وعقدُهُ عليهِ ، وأصبحَ ثقيلًا كَسلانًا لم يصب خيرًا",2]],"grade":"صحيح","narrator":"جابر بن عبدالله","muhaddith":"صحيح","takhrij":"أخرجه أحمد (14387)، وأبو يعلى (2298)، وابن حبان (2556) واللفظ له","bab":"أدعية وأذكار › فضل الذكر","dorar":"xUYwZb0N","merged":3,"otherRefs":["صحيح الترغيب 648 (صحيح)","مجمع الزوائد 2/264 (صحيح)"]},{"id":"س-01125","fp":"7fac74fedd60","stateId":58,"easy":"إذا نمت ولم تذكر الله ولم تتوضأ ولم تصلِّ ← تصبح خبيث النفس كسلان","cause":"وإلَّا","result":"أصبَح خبيثَ النَّفْسِ كَسْلانَ","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[34],"ref":"صحيح النسائي 1606","srcLabel":"النسائي","text":["إذا نام أحَدُكم عقَد الشَّيطانُ على رأسِه ثلاثَ عُقَدٍ، يضرِبُ على كلِّ عُقْدةٍ ليلًا طويلًا، أي: ارقُدْ، فإنِ استيقَظ فذكَر اللهَ، انحلَّتْ عُقْدةً، فإن توضَّأ انحلَّتْ عقدةٌ أخرى، فإن صلَّى انحلَّتِ العُقَدُ كلُّها، فيُصبِحُ طيِّبَ النَّفْسِ نشيطًا، ",["وإلَّا",1]," ",["أصبَح خبيثَ النَّفْسِ كَسْلانَ",2],"."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"صحيح","takhrij":"أخرجه النسائي (1607)","bab":"أدعية وأذكار › فضل الذكر","dorar":"MtTQDM53"},{"id":"ق-0174","fp":"db96af7ba160","stateId":59,"easy":"الشرك بالله ← إلقاء الرعب في القلوب ومأواهم النار","cause":"الشرك بالله","result":"إلقاء الرعب في القلوب ومأواهم النار","explicit":true,"star":true,"otherNeedIds":[69],"ref":"سورة آل عمران: 151","srcLabel":"القرآن الكريم","quran":{"s":3,"from":151,"to":151,"text":"سَنُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ بِمَا أَشْرَكُوا بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَمَأْوَاهُمُ النَّارُ وَبِئْسَ مَثْوَى الظَّالِمِينَ (151)","hl":[[0,166,1]]}},{"id":"ق-0375","fp":"d340f626e03b","stateId":59,"easy":"عدم الإيمان ← ضيق الصدر والحرج والرجس","cause":"عدم الإيمان","result":"ضيق الصدر والحرج والرجس","explicit":true,"otherNeedIds":[21],"ref":"سورة الأنعام: 125","srcLabel":"القرآن الكريم","quran":{"s":6,"from":125,"to":125,"text":"فَمَنْ يُرِدِ اللَّهُ أَنْ يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ وَمَنْ يُرِدْ أَنْ يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ كَذَلِكَ يَجْعَلُ اللَّهُ الرِّجْسَ عَلَى الَّذِينَ لَا يُؤْمِنُونَ (125)","hl":[[70,238,1]]}},{"id":"ق-0779","fp":"167303421b4d","stateId":59,"easy":"الإعراض عن ذكر الله ← معيشة ضنك والحشر أعمى ونسيان الله له","cause":"الإعراض عن ذكر الله","result":"معيشة ضنك والحشر أعمى ونسيان الله له","explicit":true,"otherNeedIds":[3,69],"ref":"سورة طه: 124–126","srcLabel":"القرآن الكريم","quran":{"s":20,"from":124,"to":126,"text":"وَمَنْ أَعْرَضَ عَنْ ذِكْرِي فَإِنَّ لَهُ مَعِيشَةً ضَنْكًا وَنَحْشُرُهُ يَوْمَ الْقِيَامَةِ أَعْمَى (124) قَالَ رَبِّ لِمَ حَشَرْتَنِي أَعْمَى وَقَدْ كُنْتُ بَصِيرًا (125) قَالَ كَذَلِكَ أَتَتْكَ آيَاتُنَا فَنَسِيتَهَا وَكَذَلِكَ الْيَوْمَ تُنْسَى (126)","hl":[[0,248,1]]}},{"id":"س-05599","fp":"dfdd3f0c38f2","stateId":60,"easy":"إذا تشعّبت بك الهموم (غير الآخرة) ← لا يبالي الله في أي أودية الدنيا هلكت","cause":"ومَن تَشاعَبَتْ به الهُمومُ","result":"لم يُبالِ اللهُ في أيِّ أوديةِ الدُّنيا هَلَكَ","explicit":true,"star":true,"otherNeedIds":[57],"ref":"المستدرك على الصحيحين 8147","srcLabel":"البيهقي","text":["مَن جعَلَ الهُمومَ هَمًّا واحدًا، كَفاهُ اللهُ ما هَمَّهُ مِن أمْرِ الدُّنيا والآخرةِ، ",["ومَن تَشاعَبَتْ به الهُمومُ، ",1],["لم يُبالِ اللهُ في أيِّ أوديةِ الدُّنيا هَلَكَ",2],"."],"grade":"صحيح","narrator":"عبدالله بن عمر","muhaddith":"صحيح الإسناد","takhrij":"أخرجه البيهقي في ((شعب الإيمان)) (9857) بلفظه، وابن أبي عاصم في ((الزهد)) (166) بلفظ مقارب.","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"12DQQ4Fm"},{"id":"س-05617","fp":"63cc560a97de","stateId":60,"easy":"إذا كان الفقر في قلبك ← لا يغنيك ما كثر لك من الدنيا","cause":"ومَن كان الفقرُ في قلبِه","result":"فلا يُغْنِيهِ ما أُكْثِرَ له في الدنيا ، وإنما يَضُرُّ نَفْسَه شُحُّها","explicit":true,"star":true,"ref":"صحيح الجامع 7816","srcLabel":"النسائي","text":["يا أبا ذَرٍّ ! أَتَرَى أنَّ كثرةَ المالِ هو الغِنَى ؟ إنما الغِنَى غِنَى القلبِ ، والفقرُ فقرُ القلبِ ، مَن كان الغِنَى في قلبِه ، فلا يَضُرُّه ما لَقِيَ من الدنيا ، ",["ومَن كان الفقرُ في قلبِه ، ",1],["فلا يُغْنِيهِ ما أُكْثِرَ له في الدنيا ، وإنما يَضُرُّ نَفْسَه شُحُّها",2]],"grade":"صحيح","narrator":"أبو ذر الغفاري","muhaddith":"صحيح","takhrij":"أخرجه النسائي في ((السنن الكبرى)) كما في ((تحفة الأشراف)) للمزي (9/157)، وابن حبان (685)، والطبراني (2/154) (1643) باختلاف يسير","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"CDrZRPvv"},{"id":"س-05348","fp":"9056c8f94169","stateId":60,"easy":"إذا أكثرت الهم ← فالهم نصف الهرم","cause":"والهمُّ","result":"نصفُ الهرَمِ","explicit":true,"ref":"شرح كتاب الشهاب 45","srcLabel":"القضاعي","text":["التدبيرُ نصفُ العيشِ والتودُّدُ نصفُ العقلِ ",["والهمُّ",1]," ",["نصفُ الهرَمِ",2]," وقلةُ العيالِ أحدُ اليسارَينِ"],"grade":"حسن","narrator":"علي بن أبي طالب","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في((مسند الشهاب)) (32 )","bab":"رقائق وزهد › التوكل واليقين","dorar":"ZQDhnE8o"},{"id":"س-05588","fp":"bef3bde90cd4","stateId":60,"easy":"إذا رغبت في الدنيا ← يكثر همّك وحزنك","cause":"والرغبةُ فيها","result":"تكثرُ الهمَّ والحزنَ","explicit":true,"ref":"شرح كتاب الشهاب 428","srcLabel":"القضاعي","text":["الزهدُ في الدنيا يريحُ القلبَ والبدنَ ",["والرغبةُ فيها",1]," ",["تكثرُ الهمَّ والحزنَ",2]," والبطالةُ تقسِّي القلبَ"],"grade":"حسن","narrator":"عبدالله بن عمرو","muhaddith":"إسناده حسن","takhrij":"أخرجه القضاعي في ((مسند الشهاب)) (278 )","bab":"رقائق وزهد › الزهد في الدنيا","dorar":"Jxm2JwlN"},{"id":"س-06019","fp":"5368ff4b9a15","stateId":60,"easy":"إذا أُشربت حبّ الدنيا ← ابتُليت بشقاء لا ينفد، وحرص لا يبلغ غناه، وأمل لا ينتهي","cause":"من أُشرِب حبَّ الدُّنيا","result":"الْتاط منها بثلاثٍ : شقاءٍ لا ينفَدُ عناه ، وحِرصٍ لا يبلغُ غناه ، وأملٍ لا يبلُغُ منتهاه","explicit":true,"ref":"الترغيب والترهيب 4/160","srcLabel":"الطبراني","text":[["من أُشرِب حبَّ الدُّنيا",1]," ",["الْتاط منها بثلاثٍ : شقاءٍ لا ينفَدُ عناه ، وحِرصٍ لا يبلغُ غناه ، وأملٍ لا يبلُغُ منتهاه",2]," فالدُّنيا طالبةٌ ومطلوبةٌ ، فمن طلب الدُّنيا طلبته الآخرةُ حتَّى يُدركَه الموتُ فيأخذَه ، ومن طلب الآخرةَ طلبته الدُّنيا حتَّى يستوفيَ منها رزقَه"],"grade":"حسن","narrator":"عبدالله بن مسعود","muhaddith":"إسناده حسن","takhrij":"أخرجه الطبراني (10/201) (10328)، وأبو نعيم في ((حلية الأولياء)) (8/120)، والقضاعي في ((مسند الشهاب)) (541)","bab":"رقائق وزهد › ذم حب الدنيا","dorar":"TSdUq0FC"},{"id":"س-01287","fp":"881d708049a4","stateId":61,"easy":"إذا كانت زوجتك سيئة لا تأمنها، ومركبك ودارك سيئين ← فذلك من الشقاء","cause":"المرأةُ تَراها فتَسُوءُك، وتَحمِلُ لسانَها عليك، وإن غِبْتَ عليها لم تأمَنْها على نفسِها ومالِك، والدَّابَّةُ تكونُ قَطُوفًا، فإن ضرَبْتَها أتعَبَتْك، وإن ترَكْتَها لم تُلحِقْك بأصحابِك، والدَّارُ تكونُ ضيِّقةً قليلةَ المَرافِقِ","result":"ومِن الشَّقاءِ","explicit":true,"star":true,"otherNeedIds":[44],"ref":"التنوير شرح الجامع الصغير 5/207","srcLabel":"الحاكم","text":["ثلاثةٌ مِن السَّعادةِ، وثلاثةٌ مِن الشَّقاءِ؛ فمِن السَّعادةِ: المرأةُ الصَّالحةُ، تَراها فتُعجِبُك، وتَغِيبُ عنها فتأمَنُها على نفسِها ومالِكَ، والدَّابَّةُ تكونُ وَطِيئةً، تُلحِقُك بأصحابِك، والدَّارُ تكونُ واسعةً كثيرةَ المَرافِقِ. ",["ومِن الشَّقاءِ",2],": ",["المرأةُ تَراها فتَسُوءُك، وتَحمِلُ لسانَها عليك، وإن غِبْتَ عليها لم تأمَنْها على نفسِها ومالِك، والدَّابَّةُ تكونُ قَطُوفًا، فإن ضرَبْتَها أتعَبَتْك، وإن ترَكْتَها لم تُلحِقْك بأصحابِك، والدَّارُ تكونُ ضيِّقةً قليلةَ المَرافِقِ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"قال الحاكم: تفرد بن محمد بن سعد عن أبيه فإن كان حفظه فعلى شرطهما وتعقبه الذهبي فقال محمد قال أبو حاتم: صدوق يغلط، وقال يعقوب بن شيبة: ثقة، قلت: لا يعقب على الحاكم وقد قيده بالشرطية","takhrij":"أخرجه الحاكم (2864)، وابن المنذر في ((الأوسط)) (7123) بلفظه.","bab":"نكاح › الحث على التزويج","dorar":"4JXDfLnD"},{"id":"س-01955","fp":"4c764c31fc32","stateId":61,"easy":"إذا ابتُليت بامرأة سوء ومسكن سوء ومركب سوء ← فهو من شقاء ابن آدم","cause":"المَرأةُ السُّوءُ، والمَسكَنُ السُّوءُ، والمَركَبُ السُّوءُ","result":"ومِن شِقْوةِ ابنِ آدَمَ","explicit":true,"ref":"تخريج المسند لشعيب 1445","srcLabel":"أحمد","text":["مِن سَعادةِ ابنِ آدَمَ ثَلاثةٌ، ",["ومِن شِقْوةِ ابنِ آدَمَ",2]," ثَلاثةٌ، مِن سَعادةِ ابنِ آدَمَ المَرأةُ الصَّالِحةُ، والمَسكَنُ الصَّالِحُ، والمَركَبُ الصَّالِحُ، ومِن شِقْوةِ ابنِ آدَمَ: ",["المَرأةُ السُّوءُ، والمَسكَنُ السُّوءُ، والمَركَبُ السُّوءُ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1445) واللفظ له، والطيالسي (207) باختلاف يسير، والبزار (4/9) مختصراً","bab":"إحسان › الحث على الأعمال الصالحة","dorar":"T4fx5DPE"},{"id":"س-01342","fp":"ae91d34a505d","stateId":61,"easy":"إذا ابتُليت بإمام لا يشكر ولا يغفر، وجار سوء، وامرأة سوء ← فهي من المصائب الكبرى","cause":"إمامٌ إن أحسنتَ لم يشكُرْ وإن أسأْتَ لم يغفِرْ وجارُ سوْءٍ إن رأَى خيرًا دفنه وإن رأَى شرًّا أذاعه، و امرَأةٌ إن حَضَرْتَ آذَتْك، وإنْ غِبتَ عنها خانَتْك","result":"ثَلاثٌ من الفَواقِرِ","explicit":true,"ref":"الإفصاح عن أحاديث النكاح 166","srcLabel":"الطبراني","text":[["ثَلاثٌ من الفَواقِرِ",2]," [",["إمامٌ إن أحسنتَ لم يشكُرْ وإن أسأْتَ لم يغفِرْ وجارُ سوْءٍ إن رأَى خيرًا دفنه وإن رأَى شرًّا أذاعه، و] امرَأةٌ إن حَضَرْتَ آذَتْك، وإنْ غِبتَ عنها خانَتْك",1]],"grade":"حسن","narrator":"فضالة بن عبيد","muhaddith":"إسناده حسن","takhrij":"أخرجه أبو نعيم الأصبهاني في ((تاريخ أصبهان)) (1/ 253) بلفظه تاما، والطبراني (18/ 318)، (824) باختلاف يسير.","bab":"نكاح › عشرة النساء","dorar":"6QJQ5D7D"},{"id":"س-05230","fp":"ff286c10f5e6","stateId":61,"easy":"إذا تركت الاستخارة وسخطت بعد القضاء ← فذلك من شقائك","cause":"تركُهُ الاستخارةَ وسخطُهُ بعدَ القَضاءِ","result":"ومِن شقاءِ المرءِ","explicit":true,"star":true,"similar":["س-08067"],"ref":"الترغيب والترهيب 1/330","srcLabel":"الترمذي","text":["مِن سعادةِ المرءِ استِخارتُهُ ربَّهُ ورضاهُ بما قَضى ، ",["ومِن شقاءِ المرءِ",2]," ",["تركُهُ الاستخارةَ وسخطُهُ بعدَ القَضاءِ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"[إسناده صحيح أو حسن أو ما قاربهما]","takhrij":"أخرجه أحمد (1444)، والحكيم الترمذي في ((نوادر الأصول)) (736)، والحاكم (1927) جميعهم باختلاف يسير.","bab":"رقائق وزهد › الترهيب من مساوئ الأعمال","dorar":"meN9503p"},{"id":"س-08067","fp":"7630f59003f9","stateId":61,"easy":"إذا تركت استخارة الله ← فذلك من شقائك","cause":"تَركُه استخارةَ اللهِ","result":"ومِن شِقْوةِ ابنِ آدَمَ","explicit":true,"repOf":"س-05230","otherNeedIds":[57],"ref":"المستدرك على الصحيحين 1927","text":["مِن سعادةِ ابنِ آدمَ؛ استِخارَتُه إلى اللهِ، ",["ومِن شِقْوةِ ابنِ آدَمَ",2],"؛ ",["تَركُه استخارةَ اللهِ",1],"."],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح الإسناد","takhrij":"أخرجه الترمذي (2151)، واحمد (1444) بلفظه.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"u2AtvUZJ"},{"id":"س-08060","fp":"c6ea10682764","stateId":61,"easy":"إذا تركت الاستخارة وسخطت بما قضى الله ← فهو من شقاوتك","cause":"تركُهُ استخارةَ اللهِ، و منْ شقاوةِ ابنِ آدمِ سخطُه بما قضى اللهُ لهُ","result":"ومنْ شَقَاوةِ ابنِ آدمَ","explicit":true,"ref":"الجامع الصغير 8233","srcLabel":"أحمد","text":["منْ سعادةِ ابنِ آدمَ استخارتُهُ اللهَ،  و منْ سعادةِ ابنِ آدمَ رضاهُ بما قضَى اللهُ ",["ومنْ شَقَاوةِ ابنِ آدمَ",2]," ",["تركُهُ استخارةَ اللهِ،  و منْ شقاوةِ ابنِ آدمِ سخطُه بما قضى اللهُ لهُ",1]],"grade":"صحيح","narrator":"سعد بن أبي وقاص","muhaddith":"صحيح","takhrij":"أخرجه أحمد (1444)، والحاكم (1903)، والبزار (1097) باختلاف يسير.","bab":"مظالم › شؤم المعصية وبركة الطاعة","dorar":"9y7jfN90"},{"id":"ق-1442","fp":"bd6fb50e2aba","stateId":62,"easy":"البخل والاستغناء والتكذيب بالحسنى ← التيسير للعسرى ولا يغني المال إذا تردّى","cause":"البخل والاستغناء والتكذيب بالحسنى","result":"التيسير للعسرى ولا يغني المال إذا تردّى","explicit":true,"star":true,"otherNeedIds":[3,57],"ref":"سورة الليل: 8–11","srcLabel":"القرآن الكريم","quran":{"s":92,"from":8,"to":11,"text":"وَأَمَّا مَنْ بَخِلَ وَاسْتَغْنَى (8) وَكَذَّبَ بِالْحُسْنَى (9) فَسَنُيَسِّرُهُ لِلْعُسْرَى (10) وَمَا يُغْنِي عَنْهُ مَالُهُ إِذَا تَرَدَّى (11)","hl":[[0,141,1]]}},{"id":"س-00486","fp":"dbb89e605c6f","stateId":62,"easy":"إذا أكثرت الأصحاب (بلا تمييز) ← يكثر عليك الغرماء","cause":"إذا كثر الأخلَّاءُ","result":"كثرُ الغرماءُ","explicit":true,"ref":"صحيح الأدب المفرد 657","srcLabel":"البخاري (الأدب المفرد)","text":["عن عمروِ بنِ العاصِ قال ",["إذا كثر الأخلَّاءُ",1]," ",["كثرُ الغرماءُ",2]," . قلت لموسى : وما الغُرَماءُ ؟ قال : الحقوقُ"],"grade":"صحيح","muhaddith":"إسناده صحيح","bab":"آداب عامة › المباحات من الأفعال والأقوال","dorar":"CqPJPz4N"},{"id":"س-00629","fp":"e6311c97898a","stateId":62,"easy":"إذا بخلت ← ينقبض صدرك وتضيق نفسك (مثَل البخيل والمتصدق)","cause":"وجَعَلَ البَخيلُ كُلَّما هَمَّ بصَدَقةٍ","result":"قَلَصَت، وأخَذَت كُلُّ حَلقةٍ بمَكانِها","explicit":false,"ijtihad":true,"ijtihadWhy":["تشبيه أو مثَل، والسنّة مستنبطة منه"],"ref":"صحيح البخاري 5797","srcLabel":"متفق عليه","text":["ضَرَبَ رَسولُ اللهِ صلَّى اللهُ عليه وسلَّم مَثَلَ البَخيلِ والمُتَصَدِّقِ كَمَثَلِ رَجُلَينِ عليهما جُبَّتانِ مِن حَديدٍ، قدِ اضطُرَّت أيديهما إلى ثُديِّهما وتَراقيهما، فجَعَلَ المُتَصَدِّقُ كُلَّما تَصَدَّقَ بصَدَقةٍ انبَسَطَت عنه، حتَّى تَغشى أنامِلَه وتَعفوَ أثَرَه، ",["وجَعَلَ البَخيلُ كُلَّما هَمَّ بصَدَقةٍ",1]," ",["قَلَصَت، وأخَذَت كُلُّ حَلقةٍ بمَكانِها",2],"، قال أبو هُرَيرةَ: فأنا رَأيتُ رَسولَ اللهِ صلَّى اللهُ عليه وسلَّم يقولُ بإصبَعِه هَكَذا في جَيبِه، فلو رَأيتَه يوسِّعُها ولا تَتَوسَّعُ! تابَعَه ابنُ طاوُسٍ، عن أبيه، وأبو الزِّنادِ، عَنِ الأعرَجِ: في الجُبَّتَينِ، وقال حَنظَلةُ: سَمِعتُ طاوُسًا: سَمِعتُ أبا هُرَيرةَ، يقولُ: جُبَّتانِ، وقال جَعفَرُ بنُ حَيَّانَ، عَنِ الأعرَجِ: جُبَّتانِ."],"grade":"صحيح","narrator":"أبو هريرة","muhaddith":"[صحيح]","takhrij":"أخرجه البخاري (5797) واللفظ له، ومسلم (1021)","bab":"آداب عامة › ضرب الأمثال","dorar":"znbOnuwT","merged":10,"otherRefs":["صحيح البخاري 2917 (صحيح)","صحيح ابن حبان 3313 (صحيح)","تخريج صحيح ابن حبان 3332 (صحيح)","تخريج المسند لشعيب 7483 (صحيح)","صحيح ابن خزيمة 4/ 162 (صحيح)","صحيح الجامع 5826 (صحيح)","صحيح مسلم 1021 (صحيح)","صحيح الترغيب 870 (صحيح)","معجم الشيوخ 1/445 (صحيح)"]},{"id":"س-07842","fp":"9db5491c52bc","stateId":62,"easy":"إذا استدنت بلا حاجة ← تخيف نفسك بعد أمنها","cause":"الدَّينُ","result":"لا تُخيفوا الأنفُسَ بعدَ أمنِها","explicit":false,"ijtihad":true,"ijtihadWhy":["السبب مجتزأ لا يُفهم وحده"],"otherNeedIds":[2],"ref":"الأحكام الشرعية الصغرى 693","srcLabel":"أحمد","text":["إنَّ رسولَ اللَّهِ صلى اللَّه عليه وسلم قال : ",["لا تُخيفوا الأنفُسَ بعدَ أمنِها",2]," قالوا : يا رسولَ اللَّهِ ! وما ذاكَ ؟ قال : ",["الدَّينُ",1]],"grade":"صحيح","narrator":"عقبة بن عامر","muhaddith":"[أشار في المقدمة أنه صحيح الإسناد]","takhrij":"أخرجه البيهقي (11285) واللفظ له، وأخرجه أحمد (17320)، والطبراني (17/328) (906) باختلاف يسير","bab":"قرض › الترهيب من الدين","dorar":"0Ax4UfLh"}]}