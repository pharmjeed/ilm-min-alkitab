{
  "expo": {
    "name": "علم من الكتاب",
    "slug": "ilm-min-alkitab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ilmminalkitab",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0D1F1F",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pharmjeed.ilmminalkitab"
    },
    "android": {
      "package": "com.pharmjeed.ilmminalkitab",
      "adaptiveIcon": {
        "backgroundColor": "#0D1F1F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "lang": "ar",
      "name": "علم من الكتاب",
      "themeColor": "#0D1F1F",
      "backgroundColor": "#0D1F1F",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1F1F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0D1F1F",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true,
          "supportedLocales": {
            "ios": [
              "ar"
            ],
            "android": [
              "ar"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D4A449"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
